2026-03-12 20:41:41 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68a5b6b1000000001d02a613', 'type': 'video', 'title': '📚开学倒计时，数学学习你规划好了吗？', 'desc': '暑假余额不足⏳，身边不少妈妈已经开始悄悄焦虑了……尤其是数学——孩子没兴趣、听不懂、跟不上的“老大难”又来了😮\u200d💨。\n\t\n新学期要想真正轻松学数学，真的不能只靠刷题和硬背。\n关键是激发兴趣＋用对方法！\n\t\n最近专门为5-12岁孩子设计的——“Mathplore新加坡数学”秋季班开始招募了🏅，研究了一下课程设置，有被戳中！\n\t\n✨亮点给大家整理出来了：\n2-6人小班直播课，每个孩子都能被关注到👀\n中/英文双轨教学，语言灵活选，适合国际思维培养🌍\n一周2节课，每节40-50分钟，节奏友好不费娃⏰\n老师严格筛选5年+以上经验，靠谱省心👩🏫\n真正用动画+游戏融入教学，孩子愿意主动学🎮📊\n\t\n更绝的是他们的服务——\n✔一对一定制学习计划，不盲目不跟风\n✔居然配5位老师全程伴学？！答疑、跟踪、反馈全包了\n✔坚持“测-学-练-反馈”闭环，实打实看到进步📈\n\t\n👉 现在秋季班正在招生，5-12 岁，数学不好的孩子赶紧冲！\n毕竟 “提前规划”，比 “开学鸡飞狗跳” 香太多～\n\t\n👉 现在戳\ufeff@Mathplore国际数学咨询 ，还能get价值1888的试听礼包~\n名额有限，先到先得\n——\n活动时间：即日起至2026年12月31日\n👩面向海外18+家长人群\n\ufeff#数学思维[话题]# \ufeff #数学网课[话题]# \ufeff  \ufeff#小学数学怎么学[话题]# \ufeff  \ufeff#数学[话题]#   \ufeff#小学数学思维训练[话题]# \ufeff  \ufeff#小学数学学习方法[话题]# \ufeff  \ufeff#Mathplore[话题]# \ufeff  \ufeff#Mathplore新加坡数学[话题]#', 'video_url': 'http://sns-video-qc.xhscdn.com/stream/1/110/259/01e8a5b66ab76bb90103700398c751b7f2_259.mp4?sign=9854474949bafc6d67b0ece8301cc40a&t=69b751c5', 'time': 1755690674000, 'last_update_time': 1767663553000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '249', 'collected_count': '111', 'comment_count': '27', 'share_count': '16', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122041/9eecc628fbf12aa0f405d065eb7d7a34/spectrum/1040g34o31ldgpf11kq105odiop740t80hglg6o0!nd_dft_wlteh_webp_3', 'tag_list': '数学思维,数学网课,小学数学怎么学,数学,小学数学思维训练,小学数学学习方法,Mathplore,Mathplore新加坡数学', 'last_modify_ts': 1773319301769, 'note_url': 'https://www.xiaohongshu.com/explore/68a5b6b1000000001d02a613?xsec_token=AB-solYPOg_sI-r2Itrl52tki1GOsjbWd3katw44L_Q-U=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB-solYPOg_sI-r2Itrl52tki1GOsjbWd3katw44L_Q-U='}
