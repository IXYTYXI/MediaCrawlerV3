2026-03-12 22:45:29 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67ee398c000000001d0205cc', 'type': 'normal', 'title': '你想让孩子跟着一对一逆袭高中学霸吗❓', 'desc': '😭😭😭谁懂娃数学不好的痛苦啊！\n上课听不懂，下课做不会，陷入死循环...➰\n而且随着年级增加，高中知识点越来越难，后面一步一步就都跟不上了🥲💢\n不过别急‼数学基础差也是也是有补救方法的🔥\n这个掌门一对一网课真的要让所有人都知道👏🏻\n-\n🈶清北等名师主讲主讲老师经过5层筛选，经验丰富，确保学习有效果\n🈶科学教学体系课前、中、后讲次闭环，多维度发展\n🈶双师陪跑伴学主讲授课传业，二讲在线课后1V1答疑解惑，定期测试+动态调整\n🈶智能课堂诊断大数据定位薄弱点，更好地查漏补缺，点对点进行学习巩固\n-\n🙋♀现在点击【立即咨询】还可0元领取试听课！！！\n🉐1 对 1 专业辅导➕定制专属计划➕学习资料\n-\n📝报名要求：32岁以上家长\n📆截止日期：即日起-2025年12月31日\n\ufeff#数学[话题]#\ufeff \ufeff#高中数学怎么学[话题]#\ufeff \ufeff#学习日常[话题]#\ufeff \ufeff#掌门1对1[话题]#\ufeff \ufeff#掌门[话题]#\ufeff \ufeff#掌门一对一[话题]#\ufeff \ufeff#网课推荐[话题]#\ufeff', 'video_url': '', 'time': 1743672722000, 'last_update_time': 1743665549000, 'user_id': '649e933900000000140344d9', 'nickname': '掌门1对1特训营', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/65e0143c21adbc000145da44.jpg', 'liked_count': '', 'collected_count': '1', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122245/1dd5e88de2efdeb680e7258da0f041d7/spectrum/1040g0k031fqanjrdgc005p4uicsl6h6pg9pt5l0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122245/67512894db07fe7b3bbafbc9f75f441a/spectrum/1040g34o31fqanmj10e0g5p4uicsl6h6pn8lms4g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122245/9b509f7efbb7d242a324f677e18c238e/spectrum/1040g34o31fqannukni005p4uicsl6h6pt40ja6g!nd_dft_wlteh_webp_3', 'tag_list': '数学,高中数学怎么学,学习日常,掌门1对1,掌门,掌门一对一,网课推荐', 'last_modify_ts': 1773326729627, 'note_url': 'https://www.xiaohongshu.com/explore/67ee398c000000001d0205cc?xsec_token=AB-rWozlZMoyXAhIs5WZdLef3G-f1lj7HVbSlEgKUY6oI=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB-rWozlZMoyXAhIs5WZdLef3G-f1lj7HVbSlEgKUY6oI='}
