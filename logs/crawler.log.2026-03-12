2026-03-12 21:10:07 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68397591000000001101cbd7', 'type': 'video', 'title': '思维训练三步法，专治孩子数学不开窍❗', 'desc': '孩子数学太伤神了，好不容易教会一道题，换个形式又不会了。\n明明花了大把时间精力，成绩却总是上不去，咱当家长的，看在眼里，急在心里😣！\n\t\n也有不少妈妈找到了正确的路子，比如这位妈妈\ufeff@育婴师妈咪Siyu\ufeff\n选择了Mathplore新加坡数学，它的 CPA 教学法简直是数学学习的 “神器”！\n\t\n1️⃣ C-Concrete 实物化教学\n用积木、糖果等实物演示，让孩子亲手操作理解数学概念\n👉 Mathplore课堂把抽象变具体\n\t\n2️⃣ P-Pictorial 图形化思考\n通过画图、建模把问题可视化\n👉 Mathplore特色：动画加游戏，趣味十足\n\t\n3️⃣ A-Abstract 抽象化运用\n最后过渡到数字和公式，真正举一反三\n👉 Mathplore效果：学完就能灵活运用，同类题型全搞定\n\t\n🔥现在咨询即可0元get价值1888元的数学学习大礼包哦\n名额有限，先到先得～\n——\n活动时间：即日起至2025年12月31日\n面向海外18+家长人群\n\ufeff\ufeff#新加坡数学[话题]#\ufeff \xa0\ufeff#数学思维[话题]#\ufeff \xa0\xa0\ufeff#数学网课[话题]#\ufeff \xa0\ufeff#小学数学怎么学[话题]#\ufeff \xa0\xa0\ufeff#幼小衔接数学[话题]#\ufeff \xa0\xa0\ufeff#小学数学思维训练[话题]#\ufeff \xa0\xa0\ufeff#小学数学学习方法[话题]#\ufeff \xa0\ufeff#Mathplore[话题]#\ufeff \xa0\xa0\ufeff#Mathplore新加坡数学[话题]#\ufeff', 'video_url': 'http://sns-video-qc.xhscdn.com/stream/79/110/259/01e839754c7937570103700397207404d0_259.mp4?sign=55760a73153fd60456ce56a095f9e582&t=69b7586f', 'time': 1748596113000, 'last_update_time': 1748596113000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '3', 'collected_count': '1', 'comment_count': '2', 'share_count': '2', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122110/1488b4a7fbae62ea59c1e891c7a7c969/spectrum/1040g34o31i3pqcs4mm005odiop740t80ubjke1o!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学,数学思维,数学网课,小学数学怎么学,幼小衔接数学,小学数学思维训练,小学数学学习方法,Mathplore,Mathplore新加坡数学', 'last_modify_ts': 1773321007392, 'note_url': 'https://www.xiaohongshu.com/explore/68397591000000001101cbd7?xsec_token=AB0g3976cXjNme1HZWBddwR8TxhnA8lC7lnblB62PO6w4=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB0g3976cXjNme1HZWBddwR8TxhnA8lC7lnblB62PO6w4='}
