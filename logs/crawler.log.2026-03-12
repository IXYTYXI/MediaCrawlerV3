2026-03-12 23:48:56 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67adbb75000000002a0030fb', 'type': 'video', 'title': '一对一拯救数学偏科生🔢你就是下一个黑马', 'desc': '孩子死磕数学、熬夜刷题\n成绩却不尽人意？🥹\n❗盲目努力，只会让别人领先一步\n😱高中数学，真的就一直是孩子进步的绊脚石吗\n❌公式记忆模糊，应用迷茫\n❌选择题靠猜，大题硬套公式\n❌错题反复，进步无望\n\t\n🙅数学学习，讲究方式方法\n家长们别再让孩子盲目刷题了！\n推荐这个掌门一对一网课✔\n🈶清北名师1v1，直击数学薄弱，传授解题秘籍\n🈶学情报告定制，精准分析，规划学习路径\n🈶互动课堂，激发思考，告别走神\n🈶课后1v1答疑，及时解决疑惑，查漏补缺\n🈶阶段性测评，反馈学情，调整策略\n\t\n💪掌门一对一，陪孩子数学逆风翻盘！\n现在点击【立即咨询】0元领取1V1体验课！\n🉐专业辅导+定制计划+学习资料\n活动截止时间：2025年12月31日\n\ufeff#掌门[话题]#\ufeff \ufeff#掌门1对1[话题]#\ufeff \ufeff#掌门一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#网课推荐[话题]#\ufeff \ufeff#学习方法[话题]#\ufeff \ufeff#学习规划[话题]#\ufeff \ufeff#家长必看[话题]#\ufeff', 'video_url': 'http://sns-video-bd.xhscdn.com/stream/79/110/259/01e7adbb75472c1a0103700394fea53681_259.mp4', 'time': 1739456941000, 'last_update_time': 1739438966000, 'user_id': '649e933900000000140344d9', 'nickname': '掌门1对1特训营', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/65e0143c21adbc000145da44.jpg', 'liked_count': '1058', 'collected_count': '739', 'comment_count': '7', 'share_count': '84', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122348/44c6b12124a1ede8e64761b53da475e3/spectrum/1040g0k031drbaq5g0c005p4uicsl6h6piq9dl8g!nd_dft_wlteh_webp_3', 'tag_list': '掌门,掌门1对1,掌门一对一,网课,网课推荐,学习方法,学习规划,家长必看', 'last_modify_ts': 1773330536061, 'note_url': 'https://www.xiaohongshu.com/explore/67adbb75000000002a0030fb?xsec_token=ABHovMcPy92uSCL2q0I0MBwQiUqyxI0AEGbQKUIs5_g34=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABHovMcPy92uSCL2q0I0MBwQiUqyxI0AEGbQKUIs5_g34='}
