2026-03-12 20:52:13 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6880ba9700000000120314da', 'type': 'normal', 'title': '65%校内+35%竞赛！新加坡数学7阶体系太强了', 'desc': '之前每天辅导作业都要心梗🤯\n讲10遍还是听不懂\n吼完孩子又后悔…\n直到遇见【Mathplore新加坡数学】\n现在娃居然主动要学习‼\n\t\n💎为什么我疯狂安利这个课？\n\t\n🌈【动画+游戏直播课】根本不像上课！\n▫动画把数学题变闯关游戏\n▫孩子抢着答老师发的互动题\n▫6人小班直播PK超有氛围\n\t\n🧠【CPA教学法yyds】\n用积木/图形讲抽象概念\n引导孩子主动思考和举一反三\n娃突然开窍："原来数学这么简单！"\n\t\n📈【7阶体系超能打】\n65%校内+35%拓展和竞赛\n从课内巩固到竞赛全包揽\n分为7个等级，从学前到六年级都有对应的课程\n\t\n👩🏫【老师真的会读心术！】\n▪国内外名校毕业\n▪5年+的教学经验\n▪一眼看出娃卡在哪一步\n\t\n⚠重要提醒：现在报课有福利‼\n\t\n真心建议数学头疼的宝妈试听看看\n\t\n👉 现在戳 \ufeff@Mathplore国际数学咨询\ufeff ，即可get价值1888的试听礼包~\n名额有限，先到先得\n——\n活动时间：即日起至2028年12月31日\n\ufeff#数学思维[话题]#\ufeff   \ufeff#数学网课[话题]#\ufeff   \ufeff#小学数学怎么学[话题]#\ufeff   \ufeff#幼小衔接数学[话题]#\ufeff  \ufeff#小学数学思维训练[话题]#\ufeff \ufeff#小学数学学习方法[话题]#\ufeff   \ufeff#Mathplore[话题]#\ufeff  \ufeff#Mathplore新加坡数学[话题]#\ufeff\ufeff', 'video_url': '', 'time': 1753266839000, 'last_update_time': 1769053226000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '123', 'collected_count': '108', 'comment_count': '19', 'share_count': '17', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122052/a6ed259e1429c5b66b45405fff824db3/spectrum/1040g0k031rkjhglai2105odiop740t80207fql0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122052/fb2b662af41f6248830833f8f4e5dc95/spectrum/1040g0k031kbv99soig005odiop740t80b41hapg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122052/ddf55987ddc5db112201925f3c066637/spectrum/1040g0k031k9cvg4jj6105odiop740t80uho12eg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122052/06274de8c6a8c76b27f3c47a0fd81606/spectrum/1040g0k031k9cvg4jj6005odiop740t800csmuh0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122052/c0de38e9943a0e850f1f4553d9820d41/spectrum/1040g0k031rkkhp94i2005odiop740t803khmao8!nd_dft_wlteh_we