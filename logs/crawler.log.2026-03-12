2026-03-12 23:09:15 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67d3dd73000000001c00aebb', 'type': 'normal', 'title': '学渣逆袭！靠1对1网课垫底冲前3️⃣', 'desc': '家有中等生的家长，😡是不是老觉得憋屈？\n💔不上不下的，看着好像还挺稳，其实心里急得不行\n💔课后做作业，一知半解\n💔各种办法都试过了，刷题、熬夜学习✍️，就是没啥效果\n难道咱中等生就只能一直在这原地打转😵，没办法逆袭？\n别灰心，掌门就是中等生逆袭的好助手！\n🌈专属分析诊断，精准找到问题\n掌门专门给每个中等生做分析诊断。🔍一套精心设计的综合测试，各个学科的重点知识、常考题型都包含在内，从咱基础知识掌握得咋样🎯，到解题思路灵不灵光，全方位给评估一遍\n🌈清北等名师，教学实力有保障\n掌门师资优秀，大多从清北等名校毕业👩\u200d🎓。专业知识那叫一个扎实，上物理课的时候，老师会拿生活里汽车启动、刹车，速度怎么变等这些例子🚙，弄懂复杂物理概念\n🌈个性学习规划，量身打造学习路\n根据分析诊断结果，给每个中等生量身定制学习规划📚。老师会按照学习特点、知识掌握程度，还有学习目标，弄出一套只学习方案。☀️每天该学啥、练啥，都整理清楚\n-\n现在点击⬇【立即咨询】还能0元领取👉🏻1V1体验课~\n🉐1对1专业辅导+定制专属计划+学习资料\n感兴趣的家长们千万别错过！！！\n·\n报名要求：32岁以上家长\n截止时间：即日起-25年12月31日\n#掌门 #掌门一对一 #学习方法 #学习规划 #家长必看 #高中学习', 'video_url': '', 'time': 1741938035000, 'last_update_time': 1741938036000, 'user_id': '649e933900000000140344d9', 'nickname': '掌门1对1特训营', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/65e0143c21adbc000145da44.jpg', 'liked_count': '2', 'collected_count': '2', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122309/eedcb669f969a73bfe8c4f6470d04bec/spectrum/1040g0k031f0j0m0o5u005p4uicsl6h6pnfdh96o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122309/e9353f7fa14d84d57b54333740545b4b/spectrum/1040g0k031f0j0m0o5u0g5p4uicsl6h6pd9ppsto!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122309/070899d488e6f3634807c7a9e9c1030e/spectrum/1040g0k031f0j0m0o5u105p4uicsl6h6pccdvv28!nd_dft_wlteh_webp_3', 'tag_list': '', 'last_modify_ts': 1773328155549, 'note_url': 'https://www.xiaohongshu.com/explore/67d3dd73000000001c00aebb?xsec_token=ABfE9UjVrUoElAYygFzUKJeAd-clX4d2x_66mlCJKxAV4=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABfE9UjVrUoElAYygFzUKJeAd-clX4d2x_66mlCJKxAV4='}
