2026-03-12 16:14:50 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69b1293b000000001b01d7e3', 'type': 'video', 'title': '告别语文的苦💢一对一打通“读写经脉”', 'desc': '🙇\u200d♀️家有高中生的家长看过来，你家孩子的语文学习是不是也这样\n💔阅读好像懂了，主旨抓不住，答题踩不到点\n💔作文万年二类文，不是跑题就是语言干巴巴，素材背了一堆却用不上\n💔别人做题又快又准，自家娃不仅慢，还越学越没信心\n·\n♥️语文学习，光靠刷题背模板，都是治标不治本\n✅想让孩子从根源上开窍，真心建议试试这个让娃从“怕语文”变成“爱语文”的神器——【掌门1对1高中语文线上网课】👇\n·\n✨课前精准诊断，拒绝无效努力\n课前先给娃做一次深度学情扫描，清北背景的老师1对1拆解，精准定位孩子薄弱环节\n到底是读不懂文章逻辑？还是不会组织答题语言？或者是作文立意太浅？找到问题根源\n·\n✨打通“读写”任督二脉，培养底层能力\n掌门老师不讲死记硬背的模板，而是教“方法论”\n🔸阅读方面：手把手带孩子拆解文章结构，教孩子看懂作者意图和深层逻辑，而不是停留在表面意思\n🔸写作方面：教孩子如何把阅读中积累的素材，转化成有深度、有逻辑的议论文，实现“以读促写，以写深读”的良性循环\n·\n✨1V1量身定制，全程陪伴不脱节\n掌门是真正的1对1直播课，老师全程只盯着咱家娃，根据孩子的学习风格、薄弱点和学校进度，定制专属学习方案\n而且专属学习群里随时答疑，绝不让问题过夜，慢慢帮孩子把自信心找回来\n·\n🎯趁着新学期刚开始，赶紧给孩子安排上，让掌门帮娃打通读写“任督二脉”，阅读写作双突破！\n·\n📢想让孩子体验一下语文开窍的感觉吗\n点击下方⬇️【立即咨询】0元领取一节1对1试听体验课\n🎁还送专属学情诊断报告+高中语文高频考点资料包\n🔍报名要求：仅面向32岁以上家长\n📅截止时间：即日起——2026年12月31日\n·\n#掌门[话题]#  #掌门一对一[话题]#  #掌门1对1[话题]#  #高中[话题]#  #语文[话题]#  #语文作文[话题]#  #高中作文[话题]#  #作文[话题]#  #作文范文[话题]#  #网课[话题]#', 'video_url': 'http://sns-video-hs.xhscdn.com/stream/1/110/259/01e9b12937c5ab08010370039cdc099fe8_259.mp4', 'time': 1773218108000, 'last_update_time': 1773218108000, 'user_id': '669f40a3000000001e00b482', 'nickname': '掌门1对1逆袭', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6729d05045dcad0001e0ab91.jpg', 'liked_count': '1', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '安徽', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603121614/74e09fc17b4d429b8a33b6eb41aa341e/spectrum/1040g34o31timgd1q5a0g5pkv82hnhd42mrcmsqo!nd_dft_wlteh_webp_3', 'tag_list': '掌门,掌门一对一,掌门1对1,高中,语文,语文作文,高中作文,作文,作文范文,网课', 'last_modify_ts': 1773303290981, 'note_url': 'https://www.xiaohongshu.com/explore/69b1293b000000001b01d7e3?xsec_token=ABhfDeuCEAlFJZLSYMUHqXFFVc04vxwrbgSa4IzQ9_5rY=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABhfDeuCEAlFJZLSYMUHqXFFVc04vxwrbgSa4IzQ9_5rY='}
