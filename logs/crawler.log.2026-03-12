2026-03-12 21:13:22 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '682d43ad0000000012005db7', 'type': 'normal', 'title': '小满\xa0|\xa0万物小得盈满，人生最好是小满', 'desc': '✨今日小满，夏意渐浓，一切都刚刚好✨\n\t\n小满，是二十四节气中最有哲理的节气——\n🌾“满”但不是“太满”，是麦粒渐熟未熟，是雨水丰盈未溢。\n🌱“盈”但不是“过盈”，是人生最好的状态，知足且上进，温柔且坚定。\n\t\n——\n🌿小满养生，宜清补忌贪凉\n✅\xa0吃“苦”尝鲜：苦瓜、莲子、莴笋，清热解暑。\n✅\xa0午间小憩：顺应阳气旺盛，养心静神。\n✅\xa0轻运动：散步、瑜伽，让身体微微出汗，不耗过度。\n\t\n“你心中的‘小满’是什么样子？”\n\ufeff#小满[话题]#\ufeff \ufeff#24节气之小满[话题]#\ufeff \ufeff#Mathplore[话题]#\ufeff \ufeff#Mathplore新加坡数学[话题]#\ufeff', 'video_url': '', 'time': 1747796909000, 'last_update_time': 1747796910000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122113/ce0e03bff510a5d68e080c9c457ed327/spectrum/1040g34o31hnsn980340g5odiop740t80em2ccog!nd_dft_wlteh_webp_3', 'tag_list': '小满,24节气之小满,Mathplore,Mathplore新加坡数学', 'last_modify_ts': 1773321202440, 'note_url': 'https://www.xiaohongshu.com/explore/682d43ad0000000012005db7?xsec_token=ABg1DjjFt-fvRBI3Hie2g3qm3WJ5EE4Ps2BQxny7eG8QU=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABg1DjjFt-fvRBI3Hie2g3qm3WJ5EE4Ps2BQxny7eG8QU='}
