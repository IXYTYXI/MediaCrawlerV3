2026-03-12 22:37:18 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67f8c37b000000000903980a', 'type': 'normal', 'title': '挑战10天搞定高中数学！跟着一对一太爽啦❗', 'desc': '到底谁家孩子能轻轻松松拿下高中数学啊😭\n真的太让人发愁了😫\n记不完的公式、定理❌越来越难的函数题❌越学越让人觉得逆袭无望\n-\n家长们别着急啦！数学基础不好也是有补救方法的🔑\n真心建议带娃来试一试👉掌门一对一网课，从三角函数到导数问题，10天带孩子拿捏数学\n·\n✅专属学情分析：一来就先进行模拟测试，找出孩子数学学习中的薄弱点，然后针对性地定制学习方案\n✅强大师资力量：掌门老师都来自清北等名校，经过了层层筛选，有着丰富的教学经验，能根据孩子情况灵活调整教学方案\n✅直播互动课堂：全程采用直播模式授课，老师和孩子一对一、面对面，能随时观察孩子的学习状态，抛出互动问题，引导孩子思考，拒绝跑神\n✅实时答疑服务：掌门老师24h在线，孩子不管是课上有知识点没消化，还是课后作业有问题，都能随时来问\n✅阶段测评报告：定期会对孩子学习情况进行考察，生成专属报告，再根据报告调整教学方向，查缺补漏\n-\n现在点击⬇【立即咨询】还能0元领取👉🏻1V1体验课~\n🉐1对1专业辅导+定制专属计划+学习资料\n感兴趣的家长们千万别错过！！！\n·\n报名要求：32岁以上家长\n截止时间：即日起-25年12月31日\n\ufeff#掌门[话题]#\ufeff \ufeff#掌门一对一[话题]#\ufeff \ufeff#学习方法[话题]#\ufeff \ufeff#学习规划[话题]#\ufeff \ufeff#高一[话题]#\ufeff \ufeff#高二[话题]#\ufeff \ufeff#高三[话题]#\ufeff \ufeff#家长必看[话题]#\ufeff \ufeff#高中数学[话题]#\ufeff \ufeff#数学冲刺[话题]#\ufeff', 'video_url': '', 'time': 1744356219000, 'last_update_time': 1744961287000, 'user_id': '649e933900000000140344d9', 'nickname': '掌门1对1特训营', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/65e0143c21adbc000145da44.jpg', 'liked_count': '12', 'collected_count': '2', 'comment_count': '', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122237/26cd708836496cb060aeb06ba317ab39/spectrum/1040g0k031g4k39ibh8005p4uicsl6h6plf0b3d8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122237/c9e402b0b627a45771c8c98041208e9a/spectrum/1040g0k031g4k39ibh80g5p4uicsl6h6p31catl0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122237/10d3ba24dcd6ade3ec1d2363005eda06/spectrum/1040g0k031g4k39ibh8105p4uicsl6h6pb131vk0!nd_dft_wlteh_webp_3', 'tag_list': '掌门,掌门一对一,学习方法,学习规划,高一,高二,高三,家长必看,高中数学,数学冲刺', 'last_modify_ts': 1773326238619, 'note_url': 'https://www.xiaohongshu.com/explore/67f8c37b000000000903980a?xsec_token=ABiIZnTZTO8lvonarz8LubaDMFL1A0Y52ITSWeSAmWKuA=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token'