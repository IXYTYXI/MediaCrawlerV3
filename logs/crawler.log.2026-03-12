2026-03-12 16:23:02 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69b12d89000000001b016659', 'type': 'normal', 'title': '高考冲刺选高途1v1网课，名师全程盯学', 'desc': '家有高考生的家长，谁不是在焦虑中硬扛😭\n高考倒计时越来越近，孩子刷题没方向、考点摸不透，错题反复错\n报大班跟不上，小机构老师不专业\n钱花了分没涨，家长急到睡不着，又帮不上半点忙！\n\t\n✅ 还好挖到高途高考1v1全程陪跑网课，真正负责到高考出分，把专业和安心焊在身上！\n\t\n💥 高途高考1v1｜陪跑到出分\n从基础到冲刺，从答疑到反馈，全程兜底，陪孩子熬到最后一刻，不负每一份努力！\n\t\n✅ 严选名师｜持证上岗，学历可查\n高途多轮严选名师，全员持证上岗、学历可查，多年高考教龄，深耕命题规律，更懂高考生学习痛点和提分方法。\n\t\n✅ 名师1v1直播精讲｜从头带学\n从头精讲，深度解析高考考点，拆解重难点，不跳步、不敷衍，基础弱也能跟上。\n\t\n✅ 1v1因材施教｜定制专属方案\n结合孩子具体学情，1v1定制课程，各科自研大招模型拆解考点，针对性补弱，不搞一刀切。\n\t\n✅ 24小时答疑｜疑问不过夜\n深夜刷题、复盘有疑问，秒响应、讲透为止；定期组织家长会，反馈学习详情，家长随时了解进度。\n\t\n高考最后阶段，不用再焦虑、不用再踩坑，把专业的事交给专业的人，陪孩子全力以赴，迎战高考✨\n\t\n📣 赶紧点击左下角【立即咨询】领取1v1试学名额\n📍 活动范围：仅面向32岁以上家长\n🌈 活动时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #高考冲刺[话题]# #高考逆袭[话题]# #网课[话题]# #二轮复习[话题]#', 'video_url': '', 'time': 1773219209000, 'last_update_time': 1773219210000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '河北', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603121623/26950dbef41213cb60024bb80d48c4cc/spectrum/1040g0k031tin106f6i005oakffv0j2cookng57o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603121623/a22c8075cf6503d69ca842caee060656/spectrum/1040g0k031tin106f6i0g5oakffv0j2co2jojhvo!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,高考冲刺,高考逆袭,网课,二轮复习', 'last_modify_ts': 1773303782592, 'note_url': 'https://www.xiaohongshu.com/explore/69b12d89000000001b016659?xsec_token=ABhfDeuCEAlFJZLSYMUHqXFMJZZCKsT5JbIrNgzfF6n8A=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABhfDeuCEAlFJZLSYMUHqXFMJZZCKsT5JbIrNgzfF6n8A='}
