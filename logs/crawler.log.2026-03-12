2026-03-12 20:14:00 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69154d34000000000d036716', 'type': 'normal', 'title': '50万家庭选择！小学数学2-6小班试听免费', 'desc': '😫还在愁小学孩子的数学咋办？\n是不是一想到孩子数学就头疼😫\n孩子平时很努力，可就是没有方法\n只会死记硬背，拼命刷题\n直到找到靠谱的新加坡数学2-6人小班直播课-【Mathplore】@Mathplore国际数学咨询\n.\n🌟老师来自全球名校，懂教学更懂娃\n✔️100%获得教学资质认证，360°考核评价后上岗\n✔️5年+教学经验，平均上课时长2000+h\n✔️全职严选，专业知识扎实可靠\n👉小学娃学数学，高效又对味！\n.\n🌟科学课程｜5-12岁全阶段覆盖，系统练数学思维\n✅校内夯实・思维拓展・竞赛衔接・逻辑培养\n✅零基础也能循序渐进，测-学-练-反馈完整闭环\n✅贴合孩子思维敏感期，兼顾基础与拔高需求\n.\n🌟教材体系｜科学分层+CPA建模，能力稳步提升\n📚七阶分层教学——G0-G6精准适配不同年龄段\n📚CPA教学法——具象实物→形象图形→抽象公式\n📚基础+拓展+思维，数学素养全面进阶\n.\n🌟趣味课堂｜2-6人小班互动，高效学不枯燥\n🎯动画课件+游戏PK+情景建模\n🎯高频互动练，点燃数学学习兴趣\n✅短时高频（40-50分钟/节），适配孩子专注力\n.\n🌟贴心服务｜五对一陪伴，学习全程有跟进\n💡五师一体精细化服务，全程贴心护航\n💡每课反馈+课堂回放，复习无忧\n💡个性化调整教学，适配不同基础\n.\n我们是万千家庭信赖的数学思维培养选择，担心不适合？\n现在【0元试听】，孩子感兴趣再决定，轻松开启数学开窍之旅～\n.\n👇点击左下角【立即咨询】\n享\u200b价值1888元数学学习大礼包🎁\n⏰时间：即日起-2026年12月31日\n👦🏻报名人群：面向海外18+用户\u200b\n👇现在点击【立即咨询】，限量0元试学名额，还有隐藏福利\u200b\n#数学思维[话题]# #Mathplore[话题]# #数学网课[话题]# #让孩子爱上数学[话题]# #数学启蒙[话题]# #数学学习[话题]# #学习规划[话题]# #小学数学[话题]# #小学数学学习方法[话题]# #小学数学思维训练[话题]#', 'video_url': '', 'time': 1763003700000, 'last_update_time': 1763003701000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '4', 'collected_count': '1', 'comment_count': '3', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122014/501ed1ccc07bdf052f225c6dda2ef84d/spectrum/1040g0k031oqfrkq3gu005odiop740t80200vj5g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122014/4cb0223d81f3f40a1fedaa2a95042967/spectrum/1040g0k031oqfrkq3gu0g5odiop740t80bcvp0uo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122014/0471dbd6b6a0c769966321eac1519141/spectrum/1040g0k031oqfrkq3gu105odiop740t80hlaef5g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122014/c5ddfd35ab7651d4767699cbd9c8c417/spectrum/1040g0k031oqfrkq3gu1g5odiop740t80u2sci