2026-03-12 16:22:54 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69b12dbc0000000023038a65', 'type': 'normal', 'title': '高中坚持跟1v1网课学，1个月脱胎换骨', 'desc': '家有高中生家长集合⚠️\n孩子偏科提分难，报课怕踩坑、送机构费时间😭\n这门1v1网课在家就能学，时间灵活，官方机构太安心！\n每次2h，真人1v1带学，基础补弱到冲刺拔高，全程兜底冲前三\n\t\n💥 拒绝敷衍带学，主打负责+高效提分，每2h都有实打实收获，稳步逆袭！\n✅ 在家学习+时间灵活｜解放家长\n每次2h在家学，不用接送省时间；自由约课，贴合孩子节奏，不耽误校内课。\n\t\n✅ 6轮严选师资｜专业有保障\n6轮严选985/名校师资，高考高分、经验足，懂考点、会提分，专业水准拉满。\n\t\n✅ 课前检测+1v1定制｜精准补弱\n学前检测找薄弱，结合冲前三目标，定制专属方案，不盲目、针对性发力。\n\t\n✅ 24小时随时答疑｜疑问不过夜\n课后刷题、复盘有疑问，24h秒响应，不堆积问题，学的踏实高效。\n\t\n✅ 高频互动+边讲边练｜当场吃透\n1v1高频互动防跑神，边讲边练趁热打铁，当场吃透知识点和解题技巧。\n\t\n✅ 阶段复盘+家长旁听｜全程透明\n定期阶段复盘，优化方案；家长可旁听，孩子进度、状态一目了然。\n\t\n📌 找1v1，负责+专业最重要！这门课在家2h、灵活约课、严选师资，帮孩子少走弯路。\n\t\n📣 赶紧点击左下角【立即咨询】领取1v1试学名额\n📍 活动范围：仅面向32岁以上家长\n🌈 活动时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #高中数学怎么学[话题]# #高中学习方法[话题]# #高效学习[话题]# #线上课[话题]# #学霸养成[话题]#', 'video_url': '', 'time': 1773219260000, 'last_update_time': 1773219260000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '河北', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603121622/9637d733aff51c394a36a15ebbd449ad/spectrum/1040g34o31tin1pjbmi105oakffv0j2cofjrvpgg!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,高中数学怎么学,高中学习方法,高效学习,线上课,学霸养成', 'last_modify_ts': 1773303774055, 'note_url': 'https://www.xiaohongshu.com/explore/69b12dbc0000000023038a65?xsec_token=ABhfDeuCEAlFJZLSYMUHqXFD1anTsVmzB2XRl6Ou4GDY0=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABhfDeuCEAlFJZLSYMUHqXFD1anTsVmzB2XRl6Ou4GDY0='}
