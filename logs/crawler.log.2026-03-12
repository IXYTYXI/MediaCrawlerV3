2026-03-12 22:13:06 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69b28acf000000001d011ec5', 'type': 'normal', 'title': '数学差不用愁😜1v1陪跑负责到前三‼️', 'desc': '众所周知，数学 “差生” 是个超扎心的标签⬇️\n高中数学常年垫底，上课听天书、公式记不住，刷题全靠蒙😶🌫️\n直到遇到掌门一对一的数学老师，才发现数学学习是真的有捷径！\n\t\n为什么说掌门一对一辅导有捷径？\n🟡课前：1v1深度学情分析测出知识短板，根据学习习惯和性格精准适配数学名师，\n量身定制上课内容，循序渐进讲知识点❌拒绝跟不上节奏，公式、定理反复吃透再往下学！\n🟡课中：名师和孩子面对面直播授课，全程在线互动，时刻关注孩子听课状态，随机提问测专注度；\n家长可旁听，不打扰孩子上课，还能实时监督课堂情况😼\n🟡课后：定制专属数学课后作业，班主任全程督学打卡+及时反馈完成情况；课后免费答疑不打烊，还能给孩子 “开小灶”，下晚自习遇难题也能随时问\n🟡 科学测评，锁定薄弱环节\n依托清北师资团队，先通过科学测评快速找到孩子的数学薄弱点，定制专属提升路径，学习目标清晰不绕路，再也不用盲目刷题！\n\t\n不管孩子是基础薄弱想补分，还是想冲刺高分，都能找到专属的数学方案！\n🎁现在点击【立即咨询】就能领取0元试听福利✨\n⚠️报名要求：32岁以上家长\n⏰截止时间：即日起——2026年12月31日\n·\n#数学[话题]#   #学习规划[话题]#   #掌门一对一[话题]#   #家长必读[话题]#   #学习方法[话题]#   #逆袭[话题]#   #考试[话题]#   #高中生[话题]#', 'video_url': '', 'time': 1773308623000, 'last_update_time': 1773308623000, 'user_id': '649e933900000000140344d9', 'nickname': '掌门1对1特训营', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/65e0143c21adbc000145da44.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '上海', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122213/f81658ace7ebe668eb0097859abaa777/spectrum/1040g34o31tk1jpi2mk2g5p4uicsl6h6pird7dg8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122213/4ade2ab95481a5eb00229863b50da9e9/spectrum/1040g34o31tk1jpi2mk1g5p4uicsl6h6pn0e3fd8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122213/8d70d089343f67590246d96259aaf49a/spectrum/1040g34o31tk1jpi2mk205p4uicsl6h6pd4goovg!nd_dft_wlteh_webp_3', 'tag_list': '数学,学习规划,掌门一对一,家长必读,学习方法,逆袭,考试,高中生', 'last_modify_ts': 1773324786914, 'note_url': 'https://www.xiaohongshu.com/explore/69b28acf000000001d011ec5?xsec_token=ABUh-RDxu7HOA7GzVU1ZMuDgBXjqZTThDVZMYVhXT0B6g=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABUh-RDxu7HOA7GzVU1ZMuDgBXjqZTThDVZMYVhXT0B6g='}
