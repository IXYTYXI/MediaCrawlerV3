2026-03-12 18:14:45 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '66dab6620000000012013b00', 'type': 'normal', 'title': '新加坡数学免费体验课招募中！限5-12岁', 'desc': 'Spark Math开学季活动来喽🔥\n⚠️限时招募100名5-12岁孩子0元体验课程\n点击图片下方⬇️【立即领取】即可获得包括\n🎈 1节在线思维直播课\n🎈 12节数独趣味课\n🎈 小学速算巧算训练营课\n-\n为什么选择Spark Math⁉️\n我们以火爆全球的新加坡教学法为基础💪\n采用CPA建模法为核心的教学模式🆘\n通过图形、模型去帮助娃✔️\n👉理清复杂文字间的逻辑关系、分析t目中的数量关系\n将原本抽象复杂的内容变得更加直观形象💯\n在这种教学模式下，娃就能轻松的get到精髓🆘\n同时还不会像传统学习那样感到枯燥无趣🎊\n-\n除此以外，我们还拥有\n✅ 9大方式激发学习兴趣\n✅ 12种解题大招，锻炼MATH思维能力\n✅ UDSCSE六步教学法，攻克MATH难关\n✅ 联合专业老师进行授课讲解\n✅ 分阶教学，循序渐进培养综合实力\n感兴趣的家长赶快点击图片下方⬇【立即领取】来免费体验吧\n⏰ 截止时间：2024年12月31日\n*课程面向海外人群\n#新加坡数学[话题]#\xa0\xa0#新加坡数学网课[话题]#\xa0\xa0#新加坡数学建模[话题]#\xa0\xa0#新加坡数学补习[话题]#\xa0\xa0#新加坡数学竞赛[话题]#\xa0\xa0#新加坡数学应用题[话题]#\xa0\xa0#新加坡数学思维[话题]#\xa0\xa0#新加坡数学课[话题]#\xa0\xa0#新加坡数学教材[话题]#\xa0\xa0#新加坡数学课程[话题]#\xa0\xa0#新加坡数学老师[话题]#\xa0\xa0#新加坡数学英文[话题]#\xa0\xa0#新加坡数学cpa[话题]#\xa0\xa0#sparkmath新加坡数学[话题]#\xa0\xa0#小学数学[话题]#\xa0\xa0#数学思维[话题]#\xa0\xa0#开学季[话题]#', 'video_url': '', 'time': 1725613314000, 'last_update_time': 1725609570000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '7', 'collected_count': '4', 'comment_count': '8', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603121814/bc41cd8a33307aaddcc8d660b47222f4/spectrum/1040g34o317d8uak00q0g5olhcu8lbcmacfjtjmo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603121814/a2a843aad8a86bcd9a1579ab70109294/spectrum/1040g34o317d8ud9bjk0g5olhcu8lbcmak94n5q0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603121814/caf7782846ed297a6ea2c0d09dfff931/spectrum/1040g0k0317d8uet20o005olhcu8lbcma036nl2o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603121814/de70227a79900faf0b5681f77619fba0/spectrum/1040g0k0317d8ug9m0m005olhcu8lbcmarivj2bg!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学,新加坡数学网课,新加坡数学建模,新加坡数学补习,新加坡数学竞赛,新加坡数学应用题,