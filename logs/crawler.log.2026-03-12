2026-03-12 22:11:39 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69b28b40000000001d025051', 'type': 'normal', 'title': '拒绝不进反退，1对1网课带你决赛超车', 'desc': '寒假一过，高考就近在眼前了，你家的学习进度咋样了？\n别等到三模结束才着急忙慌的想着有没有什么邪路\n现在就抓紧，跟着名师后面一对一盯着学，精准提升现在还来得及👍\n\t\n✅ 掌门 1V1，高三复习全程闭环破局\n🔹 课前：根据孩子的学习情况、性格、习惯搭配专属老师，确保按时听课，提前做好预习准备\n🔹 课中：伴学老师随时解答疑问，课后练习及时督促，知识点逐点梳理、错题精讲，不留学习死角\n🔹 课后：定期反馈学情进展，整理专属错题集，每季度做试卷分析，精准抓薄弱点，还能换老师适配学习进度\n\t\n✅ 全维度服务，江苏高三冲刺有方向\n学情分析 + 查漏补缺 + 备考冲刺规划 + 知识点梳理 + 专属沟通群 + 海量真题库，从基础夯实到高考冲刺，每一步都有人托举！\n\t\n🙋♀现在点击下方⬇【立即咨询】就能0元领取👉🏻1V1体验课~\n🈶1对1专业辅导➕定制专属计划➕学习资料\n·\n报名要求：32岁以上家长\n截止时间：2026年12月31日\n#数学[话题]#   #学习方法[话题]#   #一对一[话题]#   #逆袭[话题]#   #家长必看[话题]#   #二模[话题]#   #高考[话题]#   #网课[话题]#   #高三[话题]#', 'video_url': '', 'time': 1773315960000, 'last_update_time': 1773308737000, 'user_id': '649e933900000000140344d9', 'nickname': '掌门1对1特训营', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/65e0143c21adbc000145da44.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '上海', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122211/006f4bf6d7944b32715a413d06ec6cb4/spectrum/1040g34o31tk1n8cj6o1g5p4uicsl6h6pa60cr98!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122211/5bf02353d95f6a4baf232ade82368dd6/spectrum/1040g34o31tk1n8cj6o205p4uicsl6h6pmmamp7o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122211/237da5309eb867e96f0ab260858e3bbd/spectrum/1040g34o31tk1n8cj6o2g5p4uicsl6h6pold47c0!nd_dft_wlteh_webp_3', 'tag_list': '数学,学习方法,一对一,逆袭,家长必看,二模,高考,网课,高三', 'last_modify_ts': 1773324699006, 'note_url': 'https://www.xiaohongshu.com/explore/69b28b40000000001d025051?xsec_token=ABUh-RDxu7HOA7GzVU1ZMuDkOxuagrCAqxeAXwpYRGCBU=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABUh-RDxu7HOA7GzVU1ZMuDkOxuagrCAqxeAXwpYRGCBU='}
