2026-03-12 20:37:25 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68b8149e000000001d03940a', 'type': 'video', 'title': '🌟打破地域限制，优质教育直达家门！', 'desc': '在小城带娃，最戳心的莫过于 “想给娃好教育，却没好资源”\n—— 尤其数学这科，找个懂启蒙、会引导的老师难上加难，报个线下班要跨大半个城，来回折腾小半天，娃累家长也累，效果还不一定好😮\u200d💨\n\t\n直到刷到这位宝妈的视频，瞬间被戳中！\n她跟很多家长一样，在教育资源匮乏的地方，最后靠 Mathplore 的新加坡数学直播课解了燃眉之急！听听她怎么说的👇\n\t\n@曲奇妈妈 ：\n家乡小城虽然环境优美，但教育资源实在有限，数学是曲奇的薄弱科目，我一度挺发愁。\n幸好我给娃安排了新加坡数学，采用国际公认的新加坡CPA教学法，通过建模思维，将数学问题“可视化”“简单化”，激发孩子学习内驱力；提升观察、分析、猜想、归纳、应用五大核心素养；培养孩子数学思维和兴趣。\n学了一段时间效果很惊喜。孩子数学学不好，大多是方法没找对！早点给孩子安排上新加坡数学，孩子就能早点上一个大台阶！\n\t\n👉 现在戳\ufeff@Mathplore国际数学咨询 ，还能get价值1888的试听礼包~\n名额有限，先到先得\n——\n活动时间：即日起至2025年12月31日\n👩面向海外18+家长人群\n\ufeff#数学思维[话题]# \ufeff  \ufeff#数学网课[话题]# \ufeff  \ufeff#小学数学怎么学[话题]# \ufeff  \ufeff#数学[话题]# #让孩子赢在起跑线上[话题]#   \ufeff#小学数学思维训练[话题]# \ufeff  \ufeff#小学数学学习方法[话题]# \ufeff  \ufeff#Mathplore[话题]# \ufeff  \ufeff#Mathplore新加坡数学\u200b[话题]#', 'video_url': 'http://sns-video-qc.xhscdn.com/stream/1/110/259/01e8b814650716a401037003990f1147cd_259.mp4?sign=918ffa2bc7ac3556b973730777b2a9db&t=69b750c5', 'time': 1756894366000, 'last_update_time': 1756894366000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '3', 'collected_count': '1', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122037/017f065f62071c3e7e92e71e6c7e8d4e/spectrum/1040g0k031lvenqf352005odiop740t808jvleho!nd_dft_wlteh_webp_3', 'tag_list': '数学思维,数学网课,小学数学怎么学,数学,让孩子赢在起跑线上,小学数学思维训练,小学数学学习方法,Mathplore,Mathplore新加坡数学\u200b', 'last_modify_ts': 1773319045067, 'note_url': 'https://www.xiaohongshu.com/explore/68b8149e000000001d03940a?xsec_token=AB2E-32kXgkO3_BlIHfF9vGdHJyHLGr_4yjp5n5ozbOZE=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB2E-32kXgkO3_BlIHfF9vGdHJyHLGr_4yjp5n5ozbOZE='}
