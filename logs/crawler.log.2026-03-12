2026-03-12 23:09:49 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67d3dccc000000001b038b29', 'type': 'normal', 'title': '海淀妈妈们都在看的语文逆袭课！太火了🔥', 'desc': '孩子人文素养没培养好，问题真不少😟！\n‼️与人交流时，表达含糊，很难清楚地说出自己的想法\n‼️写作像挤牙膏🪥\n‼️思考问题缺乏灵活性和创新性✨\n看到孩子这样，🔥家长们怎能不着急？\n别担心，掌门有妙招，帮孩子轻松培养人文素养\n🎈趣味互动课堂，激发兴趣\n掌门打造趣味互动课堂，让孩子瞬间爱上学习。🍁在学习传统文化时，演绎古代诗词中的场景，学习历史人物故事，分组讨论人物的品质和行为。这种充满趣味的互动方式，让孩子们积极参与🙌\n🎈写作技巧，文采提升\n传授实用写作技巧，帮助孩子提升写作水平✍️。从如何审题立意，到巧妙运用修辞手法、积累好词好句，老师都一一耐心指导\n🎈思维框架，拓展思路\n培养良好的思维框架对提升人文素养至关重要♻️。掌门的老师帮助孩子搭建思维框架，学会有条理地思考。在学习语文课文时，老师引导孩子分析文章结构，从整体到局部，理解作者写作思路💭\n🎈作文批改，精准修正\n认真批改孩作文，💡从语法错误到语句通顺度，从内容完整性到思想深度💖，全面细致地指出问题，并给出针对性建议\n-\n现在点击⬇【立即咨询】还能0元领取👉🏻1V1体验课~\n🉐1对1专业辅导+定制专属计划+学习资料\n感兴趣的家长们千万别错过！！！\n·\n报名要求：32岁以上家长\n截止时间：即日起-25年12月31日\n#掌门 #掌门一对一 #学习方法 #学习规划 #家长必看 #人文素养', 'video_url': '', 'time': 1741937868000, 'last_update_time': 1741937868000, 'user_id': '649e933900000000140344d9', 'nickname': '掌门1对1特训营', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/65e0143c21adbc000145da44.jpg', 'liked_count': '15', 'collected_count': '1', 'comment_count': '', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122309/1459c7b658e0c572bd7871db0989b2c8/spectrum/1040g34o31f0it2pgms0g5p4uicsl6h6ppidchho!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122309/34799f1ad624b623bfa8e161b64e87a4/spectrum/1040g0k031f0iti066m005p4uicsl6h6p2b11f4o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122309/920ca16883251b4e7de56073724c182e/spectrum/1040g0k031f0iti066m0g5p4uicsl6h6p2mp5c90!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122309/b83db8c46743a462a34ebfdf339c937f/spectrum/1040g0k031f0iti066m105p4uicsl6h6pmnclk0g!nd_dft_wlteh_webp_3', 'tag_list': '', 'last_modify_ts': 1773328189624, 'note_url': 'https://www.xiaohongshu.com/explore/67d3dccc000000001b038b29?xsec_token=ABfE9UjVrUoElAYygFzUKJeLprEIWmt2lP0P_P2wLSgeo=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABfE9UjVrUoElAYygFzUKJeLprEIWmt2lP0P_P2wLSgeo='}
