2026-03-12 21:40:54 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67b70191000000000900c70c', 'type': 'video', 'title': '喜报！VIPtutor\xa0西安分公司盛大开业啦~', 'desc': 'VIPtutor\xa0发展速度简直开挂！前脚成都第二分中心刚开业，这不，2025\xa0年\xa02\xa0月\xa018\xa0日，西安分公司又火热登场🔥\n\t\n这一家家分公司的相继落成，如同快速跳动的脉搏，清晰地展现出\xa0VIPtutor\xa0强劲的发展动力与迅猛的发展态势。\n\t\nVIPtutor\xa0全球总部位于中国香港，北美区总部在美国特拉华州多佛市，中国区总部设在成都，在新加坡、重庆设有分公司，如今西安分公司也盛大开业，目前已在全球200多个国家和地区服务超过50万名学员！能取得今天的成就，得益于各位家长的支持。\n\t\n这次西安分公司的开业，也标志着\xa0VIPtutor\xa0迈向新的里程碑！未来，我们将继续深耕教育，让优质资源触手可及，陪伴更多孩子成长与蜕变！\n\t\n🌈\xa0期待与你一起，开启教育的美好新篇章！\n\ufeff\ufeff#新加坡数学[话题]#\ufeff \ufeff#数学思维[话题]#\ufeff \ufeff#数学网课[话题]#\ufeff \ufeff#Mathplore[话题]#\ufeff \ufeff#Mathplore新加坡数学[话题]#\ufeff \ufeff#分公司[话题]#\ufeff \ufeff#开业大吉[话题]#\ufeff', 'video_url': 'http://sns-video-qc.xhscdn.com/stream/1/110/259/01e7b70124562178010370039522dec3bc_259.mp4?sign=9d948b92606f3efa82919aa6bef40e33&t=69b75fa6', 'time': 1740046737000, 'last_update_time': 1740046738000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122140/dc3e0a3bbcbd65f77f82110e3a90fccc/spectrum/1040g0k031e4d5roth6005odiop740t80tkilu4o!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学,数学思维,数学网课,Mathplore,Mathplore新加坡数学,分公司,开业大吉', 'last_modify_ts': 1773322854656, 'note_url': 'https://www.xiaohongshu.com/explore/67b70191000000000900c70c?xsec_token=ABxpV2NWw3R5pFFSvYe1Lv55BEYpn6HN5Nbf1a6SW_8eM=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABxpV2NWw3R5pFFSvYe1Lv55BEYpn6HN5Nbf1a6SW_8eM='}
