2026-03-12 15:53:06 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69b23ace0000000022033887', 'type': 'normal', 'title': '中国人不骗中国人，既便宜又靠谱太香了❗️', 'desc': '很多家长都有这种体验👇\n学习班报了，课上听得懂，一下课就没人管，学完没效果、没进步\n😭  平行线数学思维，真正不一样的地方在这里👇\n✨ 主讲稳定·体系完整   多年一线教学经验名师带队，不拼凑、不临时换人 围绕数理思维长期搭建，一步一步稳提升\n✨ 学习全程有人跟·闭环不脱节   学前：测评+精准定位 学中：引导+实时互动 学后：答疑+闭环反馈 每一步都有专人负责，孩子不学废\n✅ 清北名师带队，帮娃练透思维、轻松逆袭！\n✅ 单课时低至15 元，性价比直接拉满～\n✅ 师资硬核不踩雷    清北名师真人直播，拒绝录播凑数！ 擅长把抽象知识点拆得通俗好懂，孩子一听就抓住核心逻辑🧠\n✅ 价格亲民超划算   对比线下动辄几千的课，这里一年只要 1440 元， 低至15元/课时，名校老师带学浅奥思维，性价比吊打同类💰\n✅ 课程适配性超强 专为 1–8年级设计，从数感启蒙到浅奥逻辑全覆盖， 想夯实校内、或冲拓展拔高的孩子，都能精准适配📖\n👥 仅面向家长报名\n🔥 现在，给孩子一次「思维开窍」的机会\n👇🏻 点击【立即咨询】，测测孩子的数学思维在哪一关！\n#数理思维[话题]#    #小学奥数[话题]#    孩子学习  #思维训练[话题]#    #数理学习[话题]#    辅导班  #家长必读[话题]#    #浅奥思维[话题]#    #小学数理[话题]#    #趣味数理[话题]#', 'video_url': '', 'time': 1773288143000, 'last_update_time': 1773288143000, 'user_id': '642ba9780000000012011a80', 'nickname': '平行线名师大课堂', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/f0238b56-4bdd-3597-adf3-db36cfdcf315', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603121553/65269424cd7284eee98c67e233315831/spectrum/1040g34o31tjnn2chmo105p1bl5s4i6k00q2hh58!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603121553/8754342a80ecb8f9264c37296a049ae1/spectrum/1040g34o31tjnn41qmo105p1bl5s4i6k0vnfhnf0!nd_dft_wlteh_webp_3', 'tag_list': '数理思维,小学奥数,思维训练,数理学习,家长必读,浅奥思维,小学数理,趣味数理', 'last_modify_ts': 1773301986706, 'note_url': 'https://www.xiaohongshu.com/explore/69b23ace0000000022033887?xsec_token=ABUh-RDxu7HOA7GzVU1ZMuDgEsfG-UaD47DmKVjOw7zCI=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABUh-RDxu7HOA7GzVU1ZMuDgEsfG-UaD47DmKVjOw7zCI='}
