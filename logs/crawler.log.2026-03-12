2026-03-12 20:22:55 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6901f354000000000300e82b', 'type': 'normal', 'title': '别再无效刷题了！用思维学数学才是正解✅', 'desc': '🌟姐妹们，给娃选数学班真的是个技术活！🤯\n\t\n选太简单，怕孩子"吃不饱"；选太难，又怕娃直接摆烂😩\n大班课里孩子全程当"小透明"，老师讲的知识点要么跟不上，要么早就会了...\n课后练习还枯燥得不行，娃学数学的热情一点点被磨没……💔\n\t\n直到遇到Mathplore新加坡数学，才发现"数学班该有的样子"它全有！✨\n\t\n🎯【真正的小班直播课】\n2-6人精品小班，不是那种"伪小班"！👥\n老师能关注到每个孩子的思维过程👀\n实时互动，随时提问，告别"不敢问"的尴尬\n\t\n💡【独特的教学模式】\nCPA教学法，让孩子从具体到抽象自然过渡📊\n每节课仅40-50分钟，符合孩子注意力规律⏰\n每个等级1000+次练习机会，但不是机械重复🔁\n\t\n👩🏫【超强师资配置】\n5轮筛选 + 360°考核 + 5年教学经验✅\n中英双语自由选择，一课双学🌍\n5位老师服务1个孩子，全程伴学👨👩👧👦\n\t\n最心动的是他们的课程安排📚：\n学前：198个知识点 + 1000+次练习\n一年级：234个知识点 + 1000+次练习\n...\n五年级：360个知识点 + 1450+次练习\n真正实现"螺旋式上升"的知识构建！📈\n\t\n如果你也想让孩子：\n✔建立完整的数学思维体系\n✔真正理解而不只是死记硬背\n✔在趣味中提升数学能力\n\t\n👉 现在戳\ufeff@Mathplore国际数学咨询 ，即可领取试听礼包，现在正值双十一活动，福利多的~\n名额有限，先到先得\n——\n活动时间：即日起至2025年12月31日\n👩面向海外18+家长人群\n\ufeff#数学思维[话题]# \ufeff  \ufeff#数学网课[话题]# \ufeff  \ufeff#小学数学怎么学[话题]# \ufeff  \ufeff#数学[话题]#   \ufeff#小学数学思维训练[话题]# \ufeff  \ufeff#小学数学学习方法[话题]#  #Mathplore[话题]# \ufeff  \ufeff#Mathplore新加坡数学[话题]# #双十一[话题]#', 'video_url': '', 'time': 1761735508000, 'last_update_time': 1761735508000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '16', 'collected_count': '9', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122022/2bee1242b10583a57094d206e1770cc0/spectrum/1040g34o31o7j56pkl2505odiop740t80t5krk98!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122022/d200d3f1620fdc5d39933f8beab23d07/spectrum/1040g0k031o7j693vks105odiop740t80cgtur18!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122022/09623efe6c47f017764f4c9534645761/spectrum/1040g34o31o7j56pkl2605odiop740t807p3r0b8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122022/6d43b4154f1efdc74d81acaa1ad497ff/spectrum/1040g34o31o7j56pkl26g5odiop740t80fidn1qo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122022/ab9b2e9afd1acb2db52577bca29c2d87/spectrum/1040g34o31o7j56pkl2705odiop740t80ulbh200!nd_dft_wlteh_webp_3', 'tag_list': '数学思维,数学网课,小学数学怎么学,数学,小学数学思维训练,小学数学学习方法,Mathplore,Mathplore新加坡数学,双十一', 'last_modify_ts': 1773318175481, 'note_url': 'https://www.xiaohongshu.com/explore/6901f354000000000300e82b?xsec_token=ABwXLwdedpc8yZyDYdLuPkdMwOs_U45vPURinjXzjvgqs=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABwXLwdedpc8yZyDYdLuPkdMwOs_U45vPURinjXzjvgqs='}
