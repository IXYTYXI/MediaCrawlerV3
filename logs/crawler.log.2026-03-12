2026-03-12 18:22:06 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '66866ef7000000001c026a37', 'type': 'normal', 'title': 'Spark Math活动还有❗赶快上车❗❗', 'desc': '之前错过大促活动的家长，这次别纠结了。\n9月开学季的chao级活动来啦，赶快把福利拿下\n让娃在开学也比同龄人快一步❗\n\t\n⏰适合年级：K2-P6（幼儿园中班到6年级）\n🎁教授语言：全英文/中英双语/纯中文班\n📚课程内容：80%校内基础+20%竞赛拓展\n🎓讲授新加坡本土数学课，为孩子搭建完整的数学知识体系。（详细内容可私📩）\n\t\n活动时间：即日起至2025年12月31日\n#新加坡数学CPA教学法[话题]#\xa0\xa0#新加坡数学网课[话题]#\xa0\xa0#新加坡数学[话题]#\xa0\xa0#开学季[话题]# #开学季好物[话题]# #新加坡数学补习[话题]# #小学数学怎么学[话题]# #袋鼠数学竞赛[话题]# \xa0\xa0#sparkmath[话题]#\xa0\xa0#sparkmath种草官[话题]#', 'video_url': '', 'time': 1720086263000, 'last_update_time': 1724657577000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '9', 'collected_count': '4', 'comment_count': '22', 'share_count': '4', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603121822/086d4c86dff4e889aff0a47a2f30726e/spectrum/1040g34o314qsgf160o0g5olhcu8lbcmab9v5h2g!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学CPA教学法,新加坡数学网课,新加坡数学,开学季,开学季好物,新加坡数学补习,小学数学怎么学,袋鼠数学竞赛,sparkmath,sparkmath种草官', 'last_modify_ts': 1773310926005, 'note_url': 'https://www.xiaohongshu.com/explore/66866ef7000000001c026a37?xsec_token=ABfsJ9o-n0xpYpJEoPtqRMU1sM51_UQqeNiXkVt2wkT7w=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABfsJ9o-n0xpYpJEoPtqRMU1sM51_UQqeNiXkVt2wkT7w='}
