2026-03-12 15:42:08 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69b13633000000001600bd1d', 'type': 'video', 'title': 'Mathplore新加坡数学 全英课堂解国际竞赛题', 'desc': 'AMC8、SASMO、UKMT……这些题用中文讲都难，\n为什么Mathplore新加坡数学敢用全英文授课？\n因为我们知道：\n真正的障碍不是语言，而是缺乏思维脚手架。\n在课堂上，老师用建模图、关键词锚定和分步提问，\n把“John has twice as many marbles…”变成可画、可推、可说的逻辑链。\n孩子边听边画，边说边想——\n最后脱口而出：“So the answer is 12!”\n让全球竞赛题，成为孩子的日常思考。\n#新加坡数学[话题]# #Mathplore[话题]# #AMC8[话题]# #袋鼠数学国际竞赛[话题]# #数学思维[话题]# #小学数学[话题]# #开窍[话题]#', 'video_url': 'http://sns-video-hs.xhscdn.com/stream/79/110/259/01e9b135d5280bc1010370039cdc3cb811_259.mp4', 'time': 1773221427000, 'last_update_time': 1773221427000, 'user_id': '66c854d2000000001d022cac', 'nickname': 'Mathplore数学开窍', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31djmkng2h66g5pm8aj97cb5cr77jngg', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '四川', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603121542/fefa007f188de186e7c39561bbe037bb/spectrum/1040g0k031tio203n6q005pm8aj97cb5cg92upog!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学,Mathplore,AMC8,袋鼠数学国际竞赛,数学思维,小学数学,开窍', 'last_modify_ts': 1773301328584, 'note_url': 'https://www.xiaohongshu.com/explore/69b13633000000001600bd1d?xsec_token=ABhfDeuCEAlFJZLSYMUHqXFMNMU6yonVghzHp4IhzgyS8=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABhfDeuCEAlFJZLSYMUHqXFMNMU6yonVghzHp4IhzgyS8='}
