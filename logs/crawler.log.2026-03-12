2026-03-12 20:05:46 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '691eea66000000000d037187', 'type': 'video', 'title': '别让孩子输在数学起跑线上！这个方法真管用', 'desc': '为什么新加坡孩子数学全球top？\n答案就是：CPA教学法！\n\t\n现在Mathplore把原版课程带来啦！\n什么是真正的数学思维培养？\n不是刷题！是建立底层逻辑！\n\t\nMathplore的课程亮点：\n🌈 生活化教学：用生活实际等场景学数学\n🌈 游戏化设计：每节课都是闯关冒险\n🌈 小班直播：新加坡名师实时互动指导\n\t\n特别适合：\n✅ 对数学没兴趣的孩子\n✅ 只会死记硬背公式\n✅ 应用题理解困难\n\t\nMathplore新加坡数学小班直播课，致力于提升小学数学思维：\n✅课程分为：G0—G6，7 个阶段，涵盖校内数学重难点巩固+课外拓展竞赛培优，对标国际数学竞赛AMC8和袋鼠数学体系！\n✅教学方法：CPA 教学法，从具象化到形象化再到抽象化，一步步引导孩子构建数学思维模型\n✅优质师资：国内外名校毕业师资，80%+为理工科或教育类硕士及以上学历，平均5年+数学教学经验\n✅上课时长：一周2节，40-50分钟/节\n✅上课形式：在线直播课，2-6人精品小班\n\t\n👉 现在戳\ufeff@Mathplore国际数学咨询  ，还可0元领取价值1888元的试听礼包~\n名额有限，先到先得\n——活动时间：即日起至2026年12月31日\n👩面向海外18+家长人群\n\ufeff#数学思维[话题]#  \ufeff  \ufeff#数学网课[话题]#  \ufeff  \ufeff#小学数学怎么学[话题]#  \ufeff  \ufeff#数学[话题]#    \ufeff#小学数学思维训练[话题]#  \ufeff  \ufeff#小学数学学习方法[话题]#   #Mathplore[话题]#  \ufeff  \ufeff#Mathplore新加坡数学[话题]#', 'video_url': 'http://sns-video-qc.xhscdn.com/stream/79/110/259/01e91ee9b6643cb0010370039aa0c3e35d_259.mp4?sign=e98642f020b2c99884bd2d96e2e9502c&t=69b74959', 'time': 1763633766000, 'last_update_time': 1763633767000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '4', 'collected_count': '4', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122005/b588e56e9a0a116bf3e24aba8591bbce/spectrum/1040g34o31p3s9rvg28105odiop740t80v02a6g8!nd_dft_wlteh_webp_3', 'tag_list': '数学思维,数学网课,小学数学怎么学,数学,小学数学思维训练,小学数学学习方法,Mathplore,Mathplore新加坡数学', 'last_modify_ts': 1773317146021, 'note_url': 'https://www.xiaohongshu.com/explore/691eea66000000000d037187?xsec_token=ABlIcKqbPRFIuCbCI7arfI2GdrwJgcMnxfFP1HUqF8Ie4=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABlIcKqbPRFIuCbCI7arfI2GdrwJgcMnxfFP1HUqF8Ie4='}
