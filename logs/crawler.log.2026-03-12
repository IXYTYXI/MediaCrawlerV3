2026-03-12 21:20:31 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '680b4c3b000000000b02e8fa', 'type': 'normal', 'title': '辅导数学到崩溃！这课治好了我的高血压！', 'desc': '原来数学开窍真的有捷径！！\n辅导孩子写作业气到冒烟的宝妈，快把 Mathplore 新加坡数学焊死在收藏夹里！\n\t\n✨ CPA 教学法简直是数学救星！把抽象概念变成能摸能玩的小道具，再过渡到图形、符号，孩子学乘法像搭积木一样简单，再也不用掰着手指算半天！\n\t\n🌐 双语教学直接赢在起跑线！全英文数学课堂沉浸式磨耳朵，不仅解题思路清晰了，连数学专业词汇都张口就来，妥妥的 “别人家的孩子”！\n\t\n👥 2-6 人小班直播太懂家长了！不用怕孩子上课摸鱼，老师全程紧盯，互动提问一个不落，课后还有专属学习报告，进步看得见！\n\t\n✅2-6人小班授课\n✅英文、中文班灵活选择\n✅课前、课后多种练习方式\n✅课件精美、提升专注力\n✅对标国际数学竞赛AMC8和袋鼠数学体系\n\t\n正在被数学 “折磨” 的宝妈闭眼冲！数学成绩逆袭指日可待！💪\n\t\n🔥现在咨询即可0元get价值1888元的数学学习大礼包哦\n名额有限，先到先得～\n——\n活动时间：即日起至2025年12月31日\n面向海外18+家长人群\n\ufeff#新加坡数学[话题]#\ufeff \xa0\ufeff#数学思维[话题]#\ufeff \xa0\xa0\ufeff#数学网课[话题]#\ufeff \xa0\xa0\ufeff#小学数学怎么学[话题]#\ufeff \xa0\xa0\ufeff#幼小衔接数学[话题]#\ufeff \xa0\ufeff#小学数学思维训练[话题]#\ufeff \xa0\xa0\ufeff#小学数学学习方法[话题]#\ufeff \xa0\ufeff#Mathplore[话题]#\ufeff \xa0\ufeff#Mathplore新加坡数学[话题]#\ufeff \ufeff', 'video_url': '', 'time': 1745570875000, 'last_update_time': 1745570876000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '1', 'collected_count': '3', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122120/7355cf10bdbd45f567825c6abb4f2352/spectrum/1040g34o31gmn8lkt34005odiop740t8069fjlf0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122120/3a6634df59f591fe2775c6db98043501/spectrum/1040g34o31gmn8lkt340g5odiop740t809qfbrm0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122120/2ffce1fbed9f733928a29659337f5f07/spectrum/1040g34o31gmn8lkt34105odiop740t805l7k7ug!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122120/641acd86aac1a80334a5e03682927932/spectrum/1040g34o31gmn8lkt341g5odiop740t80a5k9fc0!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学,数学思维,数学网课,小学数学怎么学,幼小衔接数学,小学数学思维训练,小学数学学习方法,Mathplore,Mathplore新加坡数学', 'last_modify_ts'