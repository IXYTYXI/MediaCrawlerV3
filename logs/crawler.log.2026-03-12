2026-03-12 20:45:20 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '689c7ac4000000001d036d93', 'type': 'video', 'title': '新加坡数学拯救五年级数学渣娃❗思维起飞', 'desc': '小学阶段，不少家长都在为娃的数学学习犯愁：题目稍复杂就卡壳，逻辑思路总理不清，看着孩子对着习题直挠头，当妈的急在心里却没辙。\n而今天要和大家分享的这位家长，就曾遇到过这样的困扰 —— 她家五年级的小豆包一度在数学学习上倍感吃力，直到遇上了 Mathplore 新加坡数学课程，情况才悄然发生了改变。\n究竟这套课程是如何用 CPA 教学法帮孩子打通思路，甚至让娃主动爱上刷题的？\n一起来看看叭~@一只金奶油（孕期版）\n\t\n👉 现在戳\ufeff@Mathplore国际数学咨询 ，即可get价值1888的试听礼包~\n名额有限，先到先得\n——\n活动时间：即日起至2025年12月31日\n👩面向海外18+家长人群\n\ufeff#数学思维[话题]#  \ufeff#数学网课[话题]# \ufeff\ufeff#小学数学怎么学[话题]# \ufeff #小学数学思维训练[话题]# \ufeff  \ufeff#小学数学学习方法[话题]# \ufeff#Mathplore[话题]# \ufeff\ufeff#Mathplore新加坡数学[话题]# \ufeff', 'video_url': 'http://sns-video-qc.xhscdn.com/stream/1/110/259/01e89c7a4fb760f60103700398a3404335_259.mp4?sign=c9df1bf1d117f6f4d5c59be904aec92c&t=69b752a0', 'time': 1755085508000, 'last_update_time': 1758877823000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '5', 'collected_count': '2', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122045/fba368700d9a3090fa6ea1128ade0d67/spectrum/1040g34o31l4g5sj0jq105odiop740t804i7eb9g!nd_dft_wlteh_webp_3', 'tag_list': '数学思维,数学网课,小学数学怎么学,小学数学思维训练,小学数学学习方法,Mathplore,Mathplore新加坡数学', 'last_modify_ts': 1773319520320, 'note_url': 'https://www.xiaohongshu.com/explore/689c7ac4000000001d036d93?xsec_token=AB4RjnwYCGMKVHJYJi6BHHOsPwdwSjEJyVvRJzca6KEK8=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB4RjnwYCGMKVHJYJi6BHHOsPwdwSjEJyVvRJzca6KEK8='}
