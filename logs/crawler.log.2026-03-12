2026-03-12 20:22:34 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69048024000000000301ebc9', 'type': 'video', 'title': '普娃家长进，新加坡数学助孩子赢在起点！', 'desc': '🎯🌟 幼小衔接至六年级的家长们，想让孩子在班级自信领跑吗？\n快来体验mathplore新加坡数学的魅力！\n\t\n📖🌈 国际主流CPA教学法，以建模思维为核心，从游戏与故事切入，让数学概念一目了然！画图解题，逻辑推理，一举攻克！✍️🧠\n\t\n📚 六步闭环教学，掌握一法，通解百题，关键阶段基础全夯实，激活思维，后劲十足！\n\t\nMathplore新加坡数学小班直播课：\n重点培养小学数学思维，紧跟校内重难点知识，同时拓展到竞赛相关的知识，对标国际数学竞赛AMC8和袋鼠数学体系！\n一周两节课，高频互动课堂，采用动画游戏，趣味教学，每两分钟和孩子互动一次，让孩子玩中学，学中玩！培养孩子对数学的兴趣，让孩子用积极的态度学数学！\n\t\n👉2-6人小班直播授课\n👉英文班、中文班灵活选择\n👉思维、校内、竞赛一步到位\n👉课件精美，提升孩子专注力，让孩子爱上学习-\n\t\n👉 现在戳\ufeff@Mathplore国际数学咨询，即可领取试听礼包~\n名额有限，先到先得\n——活动时间：即日起至2025年12月31日\n👩面向海外18+家长人群\n\ufeff#数学思维[话题]# \ufeff  \ufeff#数学网课[话题]# \ufeff  \ufeff#小学数学怎么学[话题]# \ufeff  \ufeff#数学[话题]#   \ufeff#小学数学思维训练[话题]# \ufeff  \ufeff#小学数学学习方法[话题]#  #Mathplore[话题]# \ufeff  \ufeff#Mathplore新加坡数学[话题]#', 'video_url': 'http://sns-video-qc.xhscdn.com/stream/1/110/259/01e9047fbc2560d6010370039a3994eed6_259.mp4?sign=62c9d2fec5e34830a16c498d3d4f449b&t=69b74d49', 'time': 1761902628000, 'last_update_time': 1761902629000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '2', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122022/cfbc06986a22f5bb8a5c93df3c894728/spectrum/1040g0k031oa2sa6qkq005odiop740t809tjjsno!nd_dft_wlteh_webp_3', 'tag_list': '数学思维,数学网课,小学数学怎么学,数学,小学数学思维训练,小学数学学习方法,Mathplore,Mathplore新加坡数学', 'last_modify_ts': 1773318154002, 'note_url': 'https://www.xiaohongshu.com/explore/69048024000000000301ebc9?xsec_token=ABbyFZ52LMDznmgtjkdjh34QjIXiU5gpGzYrQe6MErdH0=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABbyFZ52LMDznmgtjkdjh34QjIXiU5gpGzYrQe6MErdH0='}
