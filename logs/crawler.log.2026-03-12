2026-03-12 20:23:45 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68ff3fbe000000000303bdab', 'type': 'video', 'title': '💥数学怕掉队？这位妈妈的选择太明智了！', 'desc': '都说三年级数学是道坎，从背公式直接跳复杂应用题，娃懵家长急😣\u200b\n直到刷到这位妈妈 @高能麻麻莎莎姐 的分享，才发现原来数学可以这样学！\u200b\n👉不需要题海战术，不用扎堆补习班，靠新加坡数学的 CPA 建模思维，就能让娃轻松拿下数学双优✨\u200b\n\t\n原来新加坡数学的核心，是把抽象难题 “画出来”！\nMathplore 的课堂上，老师带着娃用画图拆解知识点，像姐姐学的图形简拼，从审题划重点到用排除法解题，一步步引导自主思考📐\u200b\n中英双语授课可选，英文班还能和外国小朋友互动，精品小班直播让每个娃都被关注👩🏫\u200b\n\t\n最惊喜的是姐姐的变化！从死记硬背到会观察、会分析，甚至能帮妈妈解决生活里的数学问题，这才是真的学透了💯\u200b\n感谢这位妈妈真诚分享娃的学习日常～毕竟数学光靠校内基础不够，早拓展拔高才能轻松应对考试竞赛！\u200b\n想让娃数学开窍的家长千万别错过🎁\n\t\n👉 现在戳\ufeff@Mathplore国际数学咨询 ，即可领取试听大礼包~\n名额有限，先到先得\n——\n活动时间：即日起至2025年12月31日\n👩面向海外18+家长人群\n\ufeff#数学思维[话题]# \ufeff  \ufeff#数学网课[话题]# \ufeff  \ufeff#小学数学怎么学[话题]# \ufeff  \ufeff#数学[话题]#   \ufeff#小学数学思维训练[话题]# \ufeff  \ufeff#小学数学学习方法[话题]#  #Mathplore[话题]# \ufeff  \ufeff#Mathplore新加坡数学[话题]#', 'video_url': 'http://sns-video-qc.xhscdn.com/stream/1/110/259/01e8ff3db3257e74010370039a2511b47f_259.mp4?sign=544b813ea2abd979bb1edc68fb5c57c4&t=69b74d91', 'time': 1761558462000, 'last_update_time': 1761558463000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '20', 'collected_count': '2', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122023/64553371a17a9a77b6be6491081f80ec/spectrum/1040g0k031o4ug4vt50005odiop740t80il8cfo0!nd_dft_wlteh_webp_3', 'tag_list': '数学思维,数学网课,小学数学怎么学,数学,小学数学思维训练,小学数学学习方法,Mathplore,Mathplore新加坡数学', 'last_modify_ts': 1773318225785, 'note_url': 'https://www.xiaohongshu.com/explore/68ff3fbe000000000303bdab?xsec_token=ABbAn__buv-kjt5jX7Y4g7N32eewqAMez6hOAGDP2JRv0=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABbAn__buv-kjt5jX7Y4g7N32eewqAMez6hOAGDP2JRv0='}
