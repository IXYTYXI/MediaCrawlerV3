2026-03-12 18:05:17 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69b28026000000002603d49d', 'type': 'normal', 'title': '新加坡数学直播课夯爆了❗娃的思维轻松开窍', 'desc': '-\n之前娃学数学像“渡劫”\n做题磨磨蹭蹭，遇到稍微绕一点的题就摆烂\n错题改了又错，真的快被磨没耐心了…\n直到被其他妈妈安利了【sparkmath新加坡数学】\n才算真正解放老母亲，娃居然主动喊着要上数学课\n.\n◼CPA教学法\n不硬塞公式，真正打通数学底层逻辑\n.\n◼小班教学太贴心\n每班≤8人，老师全程盯梢不敷衍\n.\n💛 全流程伴学太省心\n课后作业有老师批改，错题会详细讲解，娃遇到不懂的，随时问随时有回应\n.\n💛游戏化设计拉满，娃爱上数学不费力\n没有枯燥的题海战术，课件全是趣味动画+闯关游戏\n.\n如果你家娃也5-12岁，一提数学就抵触、做题没思路\n还在死记硬背刷题，真的可以试试sparkmath～\n不用逼娃、不用费妈，让娃在轻松的氛围里吃透数学\n-\n🔥 重点来啦！\n点击下方/左下角【立即咨询】限时领0元试听大礼包\n✔️1节在线数学直播课\n✔️1v1名师专属定制学情规划\n✔️3422元228课时试听礼包\n名额有限，先到先得，错过真的亏大了～\n——\n活动时间：即日起-2027年12月31日\n*本内容为教育规划，面向家长群体\n#sparkmath[话题]# #新加坡数学[话题]# #数学思维[话题]# #小学数学思维训练[话题]# #小学数学[话题]# #数学启蒙[话题]# #数感启蒙[话题]#', 'video_url': '', 'time': 1773305894000, 'last_update_time': 1773305894000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603121805/378b96aead2f081c481d2b25932b196f/spectrum/1040g0k031tk0boq3no005olhcu8lbcma27skrto!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603121805/fbdd7944655124a404eef4f19fb922c5/spectrum/1040g0k031tk0boq3no0g5olhcu8lbcma6534ss0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603121805/392883ebb09d993280c2be622f4c8a8e/spectrum/1040g0k031tk0boq3no105olhcu8lbcmajn4t7oo!nd_dft_wlteh_webp_3', 'tag_list': 'sparkmath,新加坡数学,数学思维,小学数学思维训练,小学数学,数学启蒙,数感启蒙', 'last_modify_ts': 1773309917030, 'note_url': 'https://www.xiaohongshu.com/explore/69b28026000000002603d49d?xsec_token=ABUh-RDxu7HOA7GzVU1ZMuDjYt8nC5dLGlkMkqgg5gkHg=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABUh-RDxu7HOA7GzVU1ZMuDjYt8nC5dLGlkMkqgg5gkHg='}
