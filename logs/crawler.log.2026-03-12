2026-03-12 20:16:52 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '690dc577000000000303a9f1', 'type': 'video', 'title': '数学难度升级？妈妈用这招，孩子思路秒开窍', 'desc': '数学年级越高，题型越难，数学题稍微转几个弯，孩子就卡壳了？🤯\n死记硬背没用，疯狂刷题无效——问题可能出在思维模式上！\n\t\n来看看宝妈@427800672和她家七七的“逆袭”故事！当孩子被思维题难住时，她选择了Mathplore新加坡数学，结果惊喜地发现：\n\t\n🧠 “建模法”让数学“看得见”\n比如用三根木棍学三角形性质，通过图形动态演示，孩子自己就能总结规律，彻底理解！\n\t\n📚 新加坡原版教材+小班互动\n采用新加坡广受欢迎的教材，<6人小班，孩子抢着发言，在互动中越学越自信！\n\t\n💡 40分钟=思维升级+兴趣激发\n不比刷题时间长，效果却天差地别！孩子不仅做题更快，更爱上了动脑的过程。\n\t\n🌍 中英双语可选\n无缝衔接国内大纲，还能选择英文授课，为未来竞赛与发展打下基础。\n\t\n“平均一节课不到百元，这性价比真的香！”——感谢@427800672的真心分享！🎁\n\t\n👉 现在戳\ufeff@Mathplore国际数学咨询 ，还可0元领取价值1888元的试听礼包~\n名额有限，先到先得\n——\n活动时间：即日起至2025年12月31日\n👩面向海外18+家长人群\n\ufeff#数学思维[话题]# \ufeff  \ufeff#数学网课[话题]# \ufeff  \ufeff#小学数学怎么学[话题]# \ufeff  \ufeff#数学[话题]#   \ufeff#小学数学思维训练[话题]# \ufeff  \ufeff#小学数学学习方法[话题]#  #Mathplore[话题]# \ufeff  \ufeff#Mathplore新加坡数学[话题]#', 'video_url': 'http://sns-video-qc.xhscdn.com/stream/1/110/259/01e90dc5373467e6010370039a5dcc1dd5_259.mp4?sign=1ede2bd0df71a5407b54083f246d1001&t=69b74bf4', 'time': 1762510200000, 'last_update_time': 1762510200000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '5', 'collected_count': '1', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122016/c135b3d29910e3daffd934ab652a6fb2/spectrum/1040g34o31oj4iost4u105odiop740t80054c4d0!nd_dft_wlteh_webp_3', 'tag_list': '数学思维,数学网课,小学数学怎么学,数学,小学数学思维训练,小学数学学习方法,Mathplore,Mathplore新加坡数学', 'last_modify_ts': 1773317812588, 'note_url': 'https://www.xiaohongshu.com/explore/690dc577000000000303a9f1?xsec_token=ABT8mygdiqCayVlco2FuOw_f4f3IFugkXBAWNpOEuvSOs=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABT8mygdiqCayVlco2FuOw_f4f3IFugkXBAWNpOEuvSOs='}
