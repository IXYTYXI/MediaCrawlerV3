2026-03-12 20:06:00 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '691ee8ac000000001b0253cf', 'type': 'video', 'title': '孩子数学不开窍？找到这个方法后，直接躺赢', 'desc': '是谁说普娃就不能逆袭成数学小达人？🤔\n这篇来自我们Mathplore宝妈的走心分享，直接戳中所有家长的痛点！！\n\t\n她说，告别无效刷题，打开数学思维才是关键！🎯\n看着宝贝从“畏难”到“主动”，从“迷糊”到“开窍”，成绩一路飙升，连表达都更自信了！这就是我们新加坡CPA教学法的魔力所在～✨\n\t\n🌟 可视化数学，把抽象变直观，孩子秒懂！\n🌟 2-6人精英小班，每个宝贝都是课堂主角，互动率100%！\n🌟 中英双语浸润，对标国际竞赛，基础与拔高两手抓！\n🌟 趣味课堂激励，宝贝抢着学，妈妈超省心！\n\t\n感谢宝妈@图图妈咪育儿堂 的真诚分享！💖\n\t\n👉 现在戳\ufeff@Mathplore国际数学咨询  ，还可0元领取价值1888元的试听礼包~\n名额有限，先到先得——\n活动时间：即日起至2026年12月31日\n👩面向海外18+家长人群\n\ufeff#数学思维[话题]#  \ufeff  \ufeff#数学网课[话题]#  \ufeff  \ufeff#小学数学怎么学[话题]#  \ufeff  \ufeff#数学[话题]#    \ufeff#小学数学思维训练[话题]#  \ufeff  \ufeff#小学数学学习方法[话题]#   #Mathplore[话题]#  \ufeff  \ufeff#Mathplore新加坡数学[话题]#', 'video_url': 'http://sns-video-qc.xhscdn.com/stream/79/110/259/01e91ee88d2662b3010370039aa0bd7b34_259.mp4?sign=c6db3916f974b0690caac23702817bec&t=69b74968', 'time': 1763633324000, 'last_update_time': 1763633360000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122006/f7987fd3528cbb91e49abf1bd82cced8/spectrum/1040g0k031p3s47cn24005odiop740t80s8bt230!nd_dft_wlteh_webp_3', 'tag_list': '数学思维,数学网课,小学数学怎么学,数学,小学数学思维训练,小学数学学习方法,Mathplore,Mathplore新加坡数学', 'last_modify_ts': 1773317160796, 'note_url': 'https://www.xiaohongshu.com/explore/691ee8ac000000001b0253cf?xsec_token=ABlIcKqbPRFIuCbCI7arfI2DQNBXW8o9QqmqwVluxgeCQ=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABlIcKqbPRFIuCbCI7arfI2DQNBXW8o9QqmqwVluxgeCQ='}
