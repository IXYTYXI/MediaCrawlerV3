2026-03-12 20:23:30 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68ff46600000000003010d51', 'type': 'video', 'title': '挖到宝藏数学思维提升课程！普娃家长别错过', 'desc': '北上广的普娃家长集合！🙋\u200d♀️\n是不是经常感慨：娃学数学全靠死记硬背？应用题读三遍还是懵的？\n别急！我终于挖到一款让\u200b\u200b数学不开窍\u200b\u200b的娃逆袭的宝藏课——\u200b\u200bMathplore新加坡数学\u200b\u200b！\n\t\n🌟 \u200b\u200b为什么说它是"宝藏"？\n\u200b\u200b1️⃣ \u200b\u200b正宗新加坡CPA教学法\u200b\u200b用游戏、画图\u200b\u200b玩着学\u200b\u200b，娃一眼看懂数学逻辑独创"模型图"解法，\u200b\u200b小学数学\u200b\u200b应用题轻松拆解！娃自己就能画图讲题，真正吃透思路！\n\t\n2️⃣ \u200b\u200b游戏化课堂太会上头\u200b\u200b动画+实时互动，娃学得停不下来🎮1V1老师引导思考，\u200b\u200b专治"一听就会，一做就废"\u200b\u200b\n\t\n3️⃣ \u200b\u200b普娃亲测好用我家娃从"抗拒数学"到主动当小老师，逻辑思维开挂！\n\t\n🧠Mathplore新加坡数学小班直播课，致力于提升小学数学思维：\n\t\n✅课程分为：G0—G6，7 个阶段，涵盖校内数学重难点巩固+课外拓展竞赛培优，对标国际数学竞赛AMC8和袋鼠数学体系！\n\t\n✅教学方法：CPA 教学法，从具象化到形象化再到抽象化，一步步引导孩子构建数学思维模型\n\t\n✅优质师资：国内外名校毕业师资，80%+为理工科或教育类硕士及以上学历，平均5年+数学教学经验\n\t\n✅上课时长：一周2节，40-50分钟/节\n\t\n✅上课形式：在线直播课，2-6人精品小班不管是给孩子数学思维提升，还是助力提升数学成绩，都超合适！\n\t\n👉 现在戳\ufeff@Mathplore国际数学咨询，即可领取试听大礼包~\n名额有限，先到先得\n——活动时间：即日起至2025年12月31日\n👩面向海外18+家长人群\ufeff\n#数学思维[话题]# \ufeff  \ufeff#数学网课[话题]# \ufeff  \ufeff#小学数学怎么学[话题]# \ufeff  \ufeff#数学[话题]#   \ufeff#小学数学思维训练[话题]# \ufeff  \ufeff#小学数学学习方法[话题]#  #Mathplore[话题]# \ufeff  \ufeff#Mathplore新加坡数学[话题]#', 'video_url': 'http://sns-video-qc.xhscdn.com/stream/1/110/259/01e8ff45d125664e010370039a252b4041_259.mp4?sign=d02bffc2021b41445a9e07709a8a5ab2&t=69b74d82', 'time': 1761560160000, 'last_update_time': 1761560160000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '16', 'collected_count': '3', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122023/fe995a5f576554ec7351d3e2f167cc75/spectrum/1040g34o31o4vimkd4u1g5odiop740t80fkc5uv0!nd_dft_wlteh_webp_3', 'tag_list': '数学思维,数学网课,小学数学怎么学,数学,小学数学思维训练,小学数学学习方法,Mathplore,Mathplore新加坡数学', 'last_modify_ts':