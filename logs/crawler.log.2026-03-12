2026-03-12 16:00:23 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69b126e10000000015039149', 'type': 'video', 'title': '新学期物理补弱，一对一冲刺前排超稳💯', 'desc': '😥家长们，这是不是你家孩子的现状\n物理大题直接空着📄，不知道从哪下手😵，步骤分都拿不到💔\n实验题原理搞不懂🔬，仪器读数总出错📊，每次考试丢分重灾区😭\n压轴题看答案能懂📖，自己一做就卡壳🤯，解题思路一团乱麻📉\n周末去线下补习班来回奔波🚗，累得孩子到家倒头就睡😴，哪还有精力消化知识😩\n-\n💪是时候换个方式攻克物理难关了！\n【掌门一对一高中物理网课】🔥，清北等名校毕业老师1v1手把手教解题思维🚀\n📊专属学情诊断，先摸清孩子物理卡点🔍，是大题没思路还是实验题丢分，生成个性化报告📋，哪里不会补哪里🎯\n👨🏫清北等名校毕业老师1v1露脸授课，讲透物理模型💡，力学电学综合题、实验探究题专项突破，让孩子见一题会一类✅\n🛡️专属督学全程陪伴，课后答疑批改不过夜🌙，错题当天清📝，计划动态调📈，物理成绩稳步提升👀\n🏠在家就能上课，省去奔波时间⏰，孩子精力充沛⚡，专注攻克物理难题，家长省心又轻松😌\n-\n现在点击左下角↙️↙️【直播间】0️⃣元领取掌门1V1体验课\n🉐1对1专业辅导+定制专属计划+学习资料\n感兴趣的家长赶紧冲！！！🚀\n-\n🔻报名要求：32岁以上家长\n🔻截止时间： 即日起-2026年12月31日\n#掌门[话题]#  #掌门一对一[话题]#  #学习规划[话题]#  #高三[话题]#  #高二[话题]#  #高一[话题]#  #高中物理[话题]#', 'video_url': 'http://sns-video-hs.xhscdn.com/stream/79/110/259/01e9b126c351003f010370039cdc00c883_259.mp4', 'time': 1773226866000, 'last_update_time': 1773217505000, 'user_id': '649a70220000000010036bfc', 'nickname': '掌门1对1学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31pumqmjhls005p4qe0h46qvs49pjit8', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '上海', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603121600/34088411dc8f13251e8b6e510980bdad/spectrum/1040g34o31tim740m58105p4qe0h46qvsgqohuc0!nd_dft_wlteh_webp_3', 'tag_list': '掌门,掌门一对一,学习规划,高三,高二,高一,高中物理', 'last_modify_ts': 1773302423233, 'note_url': 'https://www.xiaohongshu.com/explore/69b126e10000000015039149?xsec_token=ABhfDeuCEAlFJZLSYMUHqXFP1g3Kt1KB-n6eTvvOh3VoM=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABhfDeuCEAlFJZLSYMUHqXFP1g3Kt1KB-n6eTvvOh3VoM='}
