2026-03-12 23:50:30 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67ac6d36000000002901e79e', 'type': 'normal', 'title': '数学基础差❓一对一网课带你月考逆风翻盘❗', 'desc': '高中数学长期垫底，纯纯数学渣❓\n逢考必败，想补不知道从哪里补❓\n不会举一反三，看到题目就是“一根筋”❓\n...\n数学差生们的救星来了‼️\n掌门一对一网课手把手带你从公式定理都记不住的学渣👉各种解法都信手拈来的学霸\n让你在月考轻松逆风翻盘🔥\n·\n👇来自上过课的同学的反馈👇\n“掌门的高中1🆚1网课是面对面直播授课的💥，上课的感觉和线下真的是没啥区别！\n都是清北级别的老师教学，在上课途中和课后会顺着网线来cue你互动，🎯Q你打卡，Q你回答问题，想摆烂都不行‼\n一对一小班课，互动性超强，上课效率简直拉满！课程内容超级有针对性，不像网上那些录播课、大班课，花了时间还看不到效果！❌”\n·\n👏掌门一对一网课在学习之前还会有摸底测试环节，根据测试情况分析出你的薄弱环节，进行针对性的辅导提升📈\n❤️❤️这样的网课真的想不心动都难！\n·\n现在点击⬇【立即咨询】还能0元领取👉🏻1V1体验课~\n🉐1对1专业辅导+定制专属计划+学习资料\n感兴趣的家长们千万别错过！！！\n·\n报名要求：32岁以上家长\n截止时间：即日起-25年12月31日\n\ufeff#数学[话题]#\ufeff \ufeff#高中数学怎么学[话题]#\ufeff \ufeff#高中学习方法[话题]#\ufeff \ufeff#掌门一对一[话题]#\ufeff \ufeff#一对一网课[话题]#\ufeff \ufeff#高中数学题型与技巧[话题]#\ufeff \ufeff#掌门[话题]#\ufeff \ufeff#掌门1对1[话题]#\ufeff', 'video_url': '', 'time': 1739359208000, 'last_update_time': 1739353398000, 'user_id': '649e933900000000140344d9', 'nickname': '掌门1对1特训营', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/65e0143c21adbc000145da44.jpg', 'liked_count': '', 'collected_count': '1', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122350/60e3f2d0e3a11e5f5c11445f0e3a5c23/spectrum/1040g34o31dq2gs1qh60g5p4uicsl6h6pdgv6bh0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122350/0910378a6a6b2330dd16c50198da0a52/spectrum/1040g34o31dq2gtrqg8005p4uicsl6h6par7ctt0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122350/9fc94e12cfc9c499302569ce21c81b1f/spectrum/1040g34o31dq2gv5uh20g5p4uicsl6h6p7cn508g!nd_dft_wlteh_webp_3', 'tag_list': '数学,高中数学怎么学,高中学习方法,掌门一对一,一对一网课,高中数学题型与技巧,掌门,掌门1对1', 'last_modify_ts': 1773330630202, 'note_url': 'https://www.xiaohongshu.com/explore/67ac6d36000000002901e79e?xsec_token=AB-X1txasjph9cOAvJEgAU1apCJzIjM2wFx1a04cHQatc=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB-X1txasjph9cOAvJEgAU1apCJzIjM2wFx1a04cHQatc='}
