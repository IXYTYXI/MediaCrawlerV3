2026-03-12 19:32:12 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69491b4c000000001b031eb4', 'type': 'video', 'title': '在家即学❗30天轻松提升数学思维', 'desc': '别再让孩子独自面对数学难题了。公式记不住、题型一变就卡壳、刷题无效还越学越没信心——这或许不是孩子不够努力，而是方法需要改变。\n来看看@新生长-向光而行   怎么让孩子轻松拿下数学的👇\n\t\n为什么选择 Mathplore 新加坡数学？\n\t\n🔹 经典 CPA 教学法，告别死记硬背\n从具体实物到图形建模，再到抽象符号，帮助孩子一步步构建数学逻辑，真正理解而不只是记住。\n\t\n🔹 动画交互 + 实时反馈，学习不再枯燥\n游戏化任务与课堂互动设计，搭配老师即时指导，让孩子主动投入、专注提升。\n\t\n🔹 科学分级体系，匹配每个成长阶段\n7个阶梯课程覆盖幼小衔接至小学高阶，无论基础巩固还是思维拓展，都能找到适合的路径。\n\t\n🔹 线上小班直播，灵活高效省心力\n一周两节，每节40-50分钟，免去奔波，利用碎片时间系统提升，家长随时了解进度。\n\t\n🔹 名师全程跟进，学习形成闭环\n老师均经过严格筛选，提供从规划到反馈的全流程支持，确保孩子学得会、记得牢、能运用。\n\t\n数学不只是刷题，更是一种可培养的思维习惯。用对方法，在家也能轻松打开数学之门。\n\t\n👉 点击左下角【立即咨询】即可0元领取价值1888元的试听大礼包哦~\n\t\n📆 活动时间：即日起至2026年12月31日\n👩\u200d👧 面向海外18岁以上家长\n\t\n#新加坡数学[话题]#  #Mathplore新加坡数学[话题]#  #数学启蒙[话题]#  #数学从这里开始[话题]#  #小学数学[话题]#  #数学思维[话题]#   #Mathplore[话题]#  #思维训练[话题]#  #小学数学思维训练[话题]#', 'video_url': 'http://sns-video-qc.xhscdn.com/stream/79/110/259/01e9491afd21f2e0010370039b4592f69e_259.mp4?sign=280c1a31cb09667c3b39b5241f7ec1ba&t=69b7417c', 'time': 1766398796000, 'last_update_time': 1766398796000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603121932/a14622665383905c83b81d6ba46c0d49/spectrum/1040g34o31qd2qdh5gm0g5odiop740t80uhtanbo!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学,Mathplore新加坡数学,数学启蒙,数学从这里开始,小学数学,数学思维,Mathplore,思维训练,小学数学思维训练', 'last_modify_ts': 1773315132870, 'note_url': 'https://www.xiaohongshu.com/explore/69491b4c000000001b031eb4?xsec_token=AB5vu2THcX1JN6SrbkuFdhe0B4krm6On2kQxBGdx5htSk=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB5vu2THcX1JN6SrbkuFdhe0B4krm6On2kQxBGdx5htSk='}
