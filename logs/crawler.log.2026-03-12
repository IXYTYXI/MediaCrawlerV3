2026-03-12 18:18:30 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '66b5f667000000001e01c8e8', 'type': 'normal', 'title': '仅学1️⃣年新加坡Math，甩飞同龄人两条街', 'desc': '不会数形结合前：数xue好难😭孩子一学就会，一做就废\n会了数形结合后：就这？！😎小小Math，轻松拿捏❗️❗️❗️\n相信我，仅学1️⃣年新加坡Math，孩子就能甩飞同龄人两条街🤩\n\t\n超🔥的Spark Math～省钱省妈省时间～\n让娃吃透思维逻辑，数学越学越有乐趣❗❗\n👩\u200d🎓采用在线小班直播课，同时提供中英、双语、全中文三种班型\n👩\u200d🎓教学采用主流的CPA教学理念，以计算为基础穿插几何、逻辑推理和应用\n👩\u200d🎓采用大量游戏化交互方式，结合UDSCSE六步教学法，攻克数学难关\n👩\u200d🎓课后大量的学具和练习题，让娃玩中学\n\t\n🔥Spark Math新加坡数学秋季班正式上线，助力孩子思维提升！\n✅好平台+好内容+好教师+好教法+好服务\n这样的课程怎能不爱❓#\n🕑活动时间：即日起至2024.12.31\n*👦课程面向海外5-12岁学员家长 更多高效的思维课程！\n#新加坡数学网课[话题]#\xa0\xa0#新加坡数学[话题]#\xa0\xa0#新加坡数学建模[话题]#\xa0\xa0#新加坡数学补习[话题]#\xa0\xa0#新加坡数学竞赛[话题]#\xa0\xa0#新加坡数学应用题[话题]#\xa0\xa0#新加坡数学思维[话题]#\xa0\xa0#新加坡数学课[话题]#\xa0\xa0#新加坡数学CPA教学法[话题]#\xa0\xa0#小学数学[话题]#\xa0\xa0#数形结合[话题]#\xa0\xa0#数学思维[话题]#\n#新加坡数学课程[话题]#\xa0\xa0#新加坡数学老师[话题]#\xa0\xa0#新加坡数学教材[话题]#\xa0\xa0#新加坡数学cpa[话题]#\xa0\xa0#sparkmath新加坡数学[话题]#', 'video_url': '', 'time': 1723201127000, 'last_update_time': 1723201127000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '2', 'collected_count': '', 'comment_count': '', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603121818/9de9d767630029c8aeffe00ba86095e1/spectrum/1040g34o3169cbf1kgm0g5olhcu8lbcmavnkpjr0!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学网课,新加坡数学,新加坡数学建模,新加坡数学补习,新加坡数学竞赛,新加坡数学应用题,新加坡数学思维,新加坡数学课,新加坡数学CPA教学法,小学数学,数形结合,数学思维,新加坡数学课程,新加坡数学老师,新加坡数学教材,新加坡数学cpa,sparkmath新加坡数学', 'last_modify_ts': 1773310710929, 'note_url': 'https://www.xiaohongshu.com/explore/66b5f667000000001e01c8e8?xsec_token=ABdUewH2PjCr5r5kDprTQsazNj_6VFSijsjbnDFWa-anM=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABdUewH2PjCr5r5kDprTQsazNj_6VFSijsjbnDFWa-anM='}
