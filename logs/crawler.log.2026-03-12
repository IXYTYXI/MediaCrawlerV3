2026-03-12 23:42:10 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67b44fe3000000000e0055e4', 'type': 'video', 'title': '中等生破局必看‼️这网课开启高中逆袭路', 'desc': '你家娃是不是\n🌑通宵学习，每天刷题，\n🙂\u200d↕️自己也没少努力琢磨\n❌但是成绩却一直不上不下，原地踏步。感觉自己的努力好像毫无意义，越来越迷茫。\n-\n‼️其实中等生与尖子生的差距是仅仅是一步之遥。这一步正是需要家长们的帮助🙆\u200d♂️\n1️⃣首先要回归课本。课本上的知识点弄懂弄透。\n2️⃣要以自己为主，找准自己的薄弱点。\n3️⃣要举一反三，错题整理不能流于表面。\n这些可不能只靠孩子自己闷头努力，需要老师👩\u200d🏫来做好引导和指导工作。\n-\n📣📣📣家长们真心建议，来试试掌门一对一专业辅导\n🈶有课前专属学情诊断\n专业测评分析，精准定位基础漏洞。\n🈶清北名师在线一对一直播课\n课上以课本为主，以考试为导向。教学考一体化，帮孩子迎头赶上\n🈶课后督学复盘\n助教课后随时督学，帮你复盘，有疑问随时解答。\n-\n💕感兴趣的家长赶紧点击视频下方【立即咨询】0元领取线上试听课~\n🙋\u200d♀️报名要求：仅面向32岁以上家长\n⏰截止时间：即日起-2025.12.31\n\ufeff#掌门一对一[话题]#\ufeff \ufeff#学习日常[话题]#\ufeff \ufeff#在家学习的日常[话题]#\ufeff \ufeff#准高中生[话题]#\ufeff \ufeff#高中网课[话题]#\ufeff \ufeff#高中学习方法[话题]#\ufeff \ufeff#高中物理怎么学[话题]#\ufeff \ufeff#掌门[话题]#\ufeff \ufeff#掌门1对1[话题]#\ufeff', 'video_url': 'http://sns-video-bd.xhscdn.com/stream/1/110/259/01e7b44fe448d3b001037003951858f181_259.mp4', 'time': 1739883690000, 'last_update_time': 1739870180000, 'user_id': '649e933900000000140344d9', 'nickname': '掌门1对1特训营', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/65e0143c21adbc000145da44.jpg', 'liked_count': '2', 'collected_count': '', 'comment_count': '', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122342/3f8e3ed503d96db384ca83e0a9eb2562/spectrum/1040g34o31e1oujq8ge0g5p4uicsl6h6pc6envi0!nd_dft_wlteh_webp_3', 'tag_list': '掌门一对一,学习日常,在家学习的日常,准高中生,高中网课,高中学习方法,高中物理怎么学,掌门,掌门1对1', 'last_modify_ts': 1773330130505, 'note_url': 'https://www.xiaohongshu.com/explore/67b44fe3000000000e0055e4?xsec_token=ABdAFPvVP3LWawDTeA9wg71Qt_rN68PqjzDDq7jn3RVrA=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABdAFPvVP3LWawDTeA9wg71Qt_rN68PqjzDDq7jn3RVrA='}
