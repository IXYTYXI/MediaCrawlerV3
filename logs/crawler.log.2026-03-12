2026-03-12 20:11:31 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6916e659000000001b022090', 'type': 'video', 'title': '2-6人小班课，老师带着娃‘画’明白数学！', 'desc': '被桐桐妈妈@会带娃的桐妈 的真实分享暖到啦～\n✨ 终于有人说透孩子计算依赖手指的核心问题！\n\t\n其实就像儿童发展指南里面强调的，数概念从来不是死记硬背，而是要在实物操作中慢慢建构～\n这正是 Mathplore 新加坡数学 CPA 教学法的核心呀：\n\t\n把抽象数字变成孩子能摸、能数的具象实物（C 阶段）\n再过渡到直观图形（P 阶段）\n最后自然衔接纯数字抽象思维（A 阶段）\n一步一步帮宝贝实现 “心中有数”，脱离手指也能算得又快又准～\n\t\n除了科学的体系，我们的课堂也充满惊喜：\n✅ 2-6人小班直播，老师关注每个孩子的思考过程\n✅ 情景化+游戏化教学，让孩子主动觉得“数学好玩”\n✅ 国际化学习氛围，和全球小伙伴一起碰撞思维\n\t\n👉 现在戳\ufeff@Mathplore国际数学咨询 ，还可0元领取价值1888元的试听礼包~\n名额有限，先到先得\n——\n活动时间：即日起至2026年12月31日\n👩面向海外18+家长人群\n\ufeff#数学思维[话题]# \ufeff  \ufeff#数学网课[话题]# \ufeff  \ufeff#小学数学怎么学[话题]# \ufeff  \ufeff#数学[话题]#   \ufeff#小学数学思维训练[话题]# \ufeff  \ufeff#小学数学学习方法[话题]#  #Mathplore[话题]# \ufeff  \ufeff#Mathplore新加坡数学[话题]#', 'video_url': 'http://sns-video-qc.xhscdn.com/stream/79/110/259/01e916e6182754c4010370039a817471bb_259.mp4?sign=9fd7e18172f40990a32cabfa743b5a3e&t=69b74ab3', 'time': 1763108441000, 'last_update_time': 1763108441000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '15', 'collected_count': '7', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122011/8bdc424d7a7eec40a847d5cdc957f75c/spectrum/1040g34o31os1q40mh0005odiop740t80m43hpi8!nd_dft_wlteh_webp_3', 'tag_list': '数学思维,数学网课,小学数学怎么学,数学,小学数学思维训练,小学数学学习方法,Mathplore,Mathplore新加坡数学', 'last_modify_ts': 1773317491579, 'note_url': 'https://www.xiaohongshu.com/explore/6916e659000000001b022090?xsec_token=ABnl_iAECGyaBf014R_v5m4L8osEfp-bleCM63dpZZJkY=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABnl_iAECGyaBf014R_v5m4L8osEfp-bleCM63dpZZJkY='}
