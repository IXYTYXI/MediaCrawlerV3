2026-03-12 15:51:42 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69b2679e000000002303bb0f', 'type': 'normal', 'title': '平行线这波福利👍春季仅需120/月，冲前1%', 'desc': '120/月平行线春季数学思维真人直播课开课啦！\n给孩子选数学思维课，总怕“钱花冤枉”？性价比低、师资一般、学完没效果，反而消磨孩子兴趣，这是很多家长的顾虑。 选对课，是让每一分投入都见效——性价比够高，师资够硬，才能帮孩子夯实基础、领跑新学期。\n\t\n💰 超高性价比\n一年 96 节真人直播课，仅需 1440 元\n单课时 15 元，月均只要 120 元\n比线下便宜近一半，亲民价上优质课\n\t\n👨\u200d🏫 17 年品牌・硬核师资\n平行线 17 年深耕数理思维\n清北名师全程直播，拒绝录播\n课后 1V1 答疑，难点当场解决\n\t\n📊 科学分层・精准适配\n1-8阶按基础分班\n基础弱能补牢，学得好能拔高\n不陪跑、不浪费课堂时间\n\t\n🧠 练真思维・不盲目刷题\n重思路、讲方法，做到学一道通一类\n直播互动 + 伴学跟踪，家长省心\n孩子轻松举一反三\n👇点击【立即咨询】解锁详情\n用高性价比，让孩子跟着清北名师实现数学突破\n⏰ 活动截止：2026 年 12 月 31 日\n仅面向成人家长\n#数学思维[话题]#    #数学启蒙[话题]#    #思维训练[话题]#    #学霸养成[话题]#    #数感启蒙[话题]#   #线上课[话题]#    #平行线根源[话题]#    #平行线根源数学[话题]#     #平行线教育[话题]#  #新学期[话题]#', 'video_url': '', 'time': 1773299614000, 'last_update_time': 1773299615000, 'user_id': '642ba9780000000012011a80', 'nickname': '平行线名师大课堂', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/f0238b56-4bdd-3597-adf3-db36cfdcf315', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603121551/be5db42587fd65d4aa3b732c2a96450a/spectrum/1040g0k031tjt85pk6o005p1bl5s4i6k0e38lqp0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603121551/dab4360100867d0914e37ab47027fc9d/spectrum/1040g34o31tjt8729mk105p1bl5s4i6k0210c4g8!nd_dft_wlteh_webp_3', 'tag_list': '数学思维,数学启蒙,思维训练,学霸养成,数感启蒙,线上课,平行线根源,平行线根源数学,平行线教育,新学期', 'last_modify_ts': 1773301902803, 'note_url': 'https://www.xiaohongshu.com/explore/69b2679e000000002303bb0f?xsec_token=ABUh-RDxu7HOA7GzVU1ZMuDup2gqDg8Hxer9eGri-j-EQ=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABUh-RDxu7HOA7GzVU1ZMuDup2gqDg8Hxer9eGri-j-EQ='}
