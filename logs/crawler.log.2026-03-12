2026-03-12 18:21:14 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6696498c00000000250073cf', 'type': 'normal', 'title': '听劝‼上完这个课，ACM 8易如反掌👌', 'desc': '🙋海淀区妈妈已经开始卷到数学竞赛啦\n其中不得不提ACM 8!\n👉美国数学思维活动AMC是一项面向🌍中学生的数学活动，由美国数学协会MAA主办，目前每年全球超过6000所学校的30万名同学参赛。\n🌈AMC8竞赛是含金量、认可度都非常高的一种😘\n也是很多国际学校学生必打的数学竞赛🏆\n❗距离2025年AMC 8考试还有半年，如何备赛成为了家长们的担心。\n-\n💥Spark Math特设AMC8系统课程🎉\n深入解析近十年的真题，帮助孩子解锁优异成绩！\n-\n来💥Spark Math用新加坡数学迎战AMC8竞赛\n现在点击下方⬇ 【立即领取】即可免费获得Spark Math竞赛试听课~\n✅ 9大方式激发学习兴趣\n✅ 12种解题大招，锻炼math思维能力\n✅ UDSCSE六步教学法，攻克math难关\n✅ 联合专业老师进行授课讲解\n✅ 分阶教学，循序渐进培养综合实力\n-\n点击下方⬇ 【立即领取】就可以免费体验哦\n⏰ 活动时间：即日起—2024年12月31日\n*课程面向海外人群（18岁以上）\n#新加坡数学CPA教学法[话题]#\xa0\xa0#新加坡数学网课[话题]#\xa0\xa0#新加坡数学[话题]#\xa0\xa0#新加坡数学建模[话题]#\xa0\xa0#amc美国数学竞赛[话题]#\xa0\xa0#amc8[话题]#\xa0\xa0#amc8美国数学竞赛[话题]#\xa0\xa0#国际数学竞赛[话题]#\xa0\xa0#国际数学竞赛培训[话题]#\xa0\xa0#海淀妈妈[话题]#\xa0\xa0#上海三公[话题]#\xa0\xa0#学霸[话题]#\xa0\xa0#学霸秘籍[话题]#', 'video_url': '', 'time': 1721125260000, 'last_update_time': 1721197426000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '1', 'collected_count': '6', 'comment_count': '9', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603121821/fe984716126e30c612b74d70511a99d4/1040g2sg315bh48u7h4705olhcu8lbcmanru0nm8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603121821/237a7d8c59fb0ec81c6e450a577643f5/1040g2sg315bh48u7h47g5olhcu8lbcmatc9pkvo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603121821/76e8906bf1f086a7cb6ac5ef73210695/1040g2sg315bh48u7h4805olhcu8lbcma977r5ao!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学CPA教学法,新加坡数学网课,新加坡数学,新加坡数学建模,amc美国数学竞赛,amc8,amc8美国数学竞赛,国际数学竞赛,国际数学竞赛培训,海淀妈妈,上海三公,学霸,学霸秘籍', 'last_modify_ts': 1773310874667, 'note_url': 'https://www.xiaohongshu.com/explore/6696498c00000000250073cf?xsec_token=ABjJ2MqIXkI_HRAmDrKEbdTNYmRRBb9DTP25tJ1pdXYrM=&xsec_source=pc_search', 'source_k