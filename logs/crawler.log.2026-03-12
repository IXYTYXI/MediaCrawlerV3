2026-03-12 23:03:37 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67d8e5be000000000703520e', 'type': 'normal', 'title': '挑战一个月英语130+，就靠这个高中1V1！', 'desc': '还在为高中英语发愁的同学们赶紧看过来！！\n·\n🥲无论你是英语基础薄弱，单词都认不全的高一新生\n🥲还是语法一知半解，考试总在及格线徘徊的高二学生\n🥲亦或是拼命刷题，却始终难以突破130的高三党\n只要你想提升英语成绩，高中英语1V1课程都可为你私人量身定制~\n·\n🖐️掌门高中1V1⤵️⤵️\n\t\n📍专属学情分析，发现问题所在\n课前进行专业摸底测试，并分析最近一次试卷，深入了解孩子当前英语水平，精准分析薄弱点，进行针对性的学习！\n\t\n📍1v1定制方案，打破知识壁垒\n据此定制专属学习方案📄，结合孩子们的学习习惯和时间安排，❌不把时间浪费在做无用功上。\n\t\n📍名师面对面教学，精准化解难题\n清北等名师一对一授课，给孩子系统梳理英语知识，及时解答各种知识遗漏，全面提升孩子听说读写的能力！\n\t\n📍随时答疑解惑，家长省心不费力\n课下有任何问题都可以询问掌门老师👩🏻🏫，老师会及时给娃答疑解惑，不留知识死角！\n·\n🔔现在点击⬇️【立即咨询】还能有1V1体验课~\n🉐1对1专业辅导+定制专属计划+学习资料\n感兴趣的家长们赶紧冲！！！\n·\n🔍报名要求：32岁以上家长\n⏰截止时间： 即日起-25年12月31日\n\ufeff#掌门[话题]#\ufeff \ufeff#掌门一对一[话题]#\ufeff \ufeff#掌门1对1[话题]#\ufeff \ufeff#英语[话题]#\ufeff \ufeff#学渣逆袭指南[话题]#\ufeff \ufeff#高中英语[话题]#\ufeff', 'video_url': '', 'time': 1742267838000, 'last_update_time': 1742267839000, 'user_id': '649e933900000000140344d9', 'nickname': '掌门1对1特训营', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/65e0143c21adbc000145da44.jpg', 'liked_count': '12', 'collected_count': '12', 'comment_count': '', 'share_count': '6', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122303/a78894620391d29120f95c7b645dad5a/spectrum/1040g0k031f5g7tnamm005p4uicsl6h6pgaivq70!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122303/38638cfbc1093f473a8d6ed17275024b/spectrum/1040g0k031f5g7v1d6s005p4uicsl6h6pen8tml8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122303/95c27cd02cf3d7a3631a68a4072a6f89/spectrum/1040g0k031f5g802s5s005p4uicsl6h6p2rmt5io!nd_dft_wlteh_webp_3', 'tag_list': '掌门,掌门一对一,掌门1对1,英语,学渣逆袭指南,高中英语', 'last_modify_ts': 1773327817921, 'note_url': 'https://www.xiaohongshu.com/explore/67d8e5be000000000703520e?xsec_token=ABKbZV8kXIje8DTM5SKwKv_RSm35ErQt-ardIP0uzT_rs=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABKbZV8kXIje8DTM5SKwKv_RSm35ErQt-ardIP0uzT_rs='}
