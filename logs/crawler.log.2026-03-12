2026-03-12 15:47:56 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '695e09c6000000001a0206e0', 'type': 'video', 'title': '一次30r｜清北名师带学，数学思维飞跃提升', 'desc': '还在为孩子数理思维不开窍发愁？\n方法不对，努力白费！平行线根源全年直bo课，帮孩子打通任督二脉！\n\t\n🌟 为什么选择我们？\n✅ 内容优质，18年线下教学沉淀，转化线上精华课程，用录播ke的价💰，打造线下ke的服务\n✅ 师资强大，清北名师+jing赛金牌教练，带过无数牛娃\n✅ 方法独特，根源教学法，注重思维培养而非套路记忆\n✅ 服务完善，365天答疑+阶段测评+专属班主任陪伴\n\t\n📈 学习效果保障：\n👉 基础薄弱孩子，准确率提升，基础理解牢固\n👉 中等水平孩子，学会举一反三，应用题不再怕\n👉 优秀孩子，拓展思维深度，为竞赛打基础\n👍通过平行线“建模思维”和“shu形结合”训练，让孩子学会分析题目本质\n掌握一类的通用解法。见到新类型能迅速找到思路，从“被动刷题”变为“主动思考”\n\t\n💰 超高性价比：全年仅1440元，低至15元/小时，🆓 免费试听2节正课，不满意全tui\n适合L1-L8学生，分层教学，因材施教\n📌 限时福利：前100名报名赠《数学思维启蒙宝典》\n点击↙️【立即咨询】领【清北名师公开课+学习资料】\n让孩子数学学习少走弯路！\n#数学思维突破[话题]#    #清北名师[话题]#  #分层教学[话题]#  #小阶数学思维[话题]#  #家长智慧选择[话题]#', 'video_url': 'http://sns-video-hs.xhscdn.com/stream/1/110/259/01e95e09c761876d010370039b975642c0_259.mp4', 'time': 1767776761000, 'last_update_time': 1772677737000, 'user_id': '642a3b7f000000001102347e', 'nickname': '平行线根源在线数学', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31lto8ekklmq05p1a7dvkcd3utccduk0', 'liked_count': '1', 'collected_count': '1', 'comment_count': '1', 'share_count': '', 'ip_location': '河南', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603121547/d8d39d2afc25c3536da09688e7723bdb/spectrum/1040g34o31r1gqlm2n0105p1a7dvkcd3ud7ev560!nd_dft_wlteh_webp_3', 'tag_list': '数学思维突破,清北名师,分层教学,小阶数学思维,家长智慧选择', 'last_modify_ts': 1773301676553, 'note_url': 'https://www.xiaohongshu.com/explore/695e09c6000000001a0206e0?xsec_token=ABHxl80fF46jxrr9Z4d0dqqYnsCGEfVOmpBgx2M7qFlm0=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABHxl80fF46jxrr9Z4d0dqqYnsCGEfVOmpBgx2M7qFlm0='}
