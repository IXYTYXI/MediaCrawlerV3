2026-03-12 18:16:17 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '66cc34e9000000001d039bfe', 'type': 'video', 'title': '还不了解新加坡数学的家长真的吃大亏❗', 'desc': '很多家长对新加坡数学很感兴趣🧩\n想让孩子学习，但是自己完全不了解\n不用担心，这次给大家整理了详细的知识点供了解\n·\n👉什么是新加坡数学❓\n👉为什么要选择新加坡数学❓\n新加坡数学是特殊的CPA教学法，它是一种在新加坡发展起来并被广泛使用的数学教育方法，\n强调的就是思维模式，比如逻辑思维、推理思维、判断能力\n而新加坡数学最重要的教育核心就是“CPA”教学法\n·\n想要给娃学习新加坡数学的，现在点击视频下方⬇ 【立即领取】即可免费获得Spark Math试听课~\n✅ 9大方式激发学习兴趣\n✅ 12种解题大招，锻炼数学思维能力\n✅ UDSCSE六步教学法，攻克数学难关\n✅ 联合专业老师进行授课讲解\n✅ 分阶教学，循序渐进培养综合实力\n-\n试听大礼包包括\n🎈 1节在线思维直播课\n🎈 12节数独趣味课\n🎈 小学速算巧算训练营课\n\t\n现在点击视频下方⬇ 【立即领取】就可以免费体验哦\n⏰ 截止时间：即日起—2024年12月31日\n*课程面向海外人群（18岁以上）\n#新加坡数学[话题]#\xa0\xa0#新加坡数学网课[话题]#\xa0\xa0#新加坡数学建模[话题]#\xa0\xa0#新加坡数学补习[话题]#\xa0\xa0#新加坡数学竞赛[话题]#\xa0\xa0#新加坡数学应用题[话题]#\xa0\xa0#新加坡数学思维[话题]#\xa0\xa0#新加坡数学课[话题]#\xa0\xa0#新加坡数学课程[话题]#\xa0\xa0#新加坡数学老师[话题]#\xa0\xa0#新加坡数学教材[话题]#\xa0\xa0#新加坡数学cpa[话题]#\xa0\xa0#新加坡数学英文[话题]#\xa0\xa0#sparkmath新加坡数学[话题]#\xa0\xa0#小学数学[话题]#\xa0\xa0#小学数学怎么学[话题]#\xa0\xa0#思维[话题]#\xa0\xa0#开学季[话题]#', 'video_url': 'http://sns-video-hs.xhscdn.com/stream/110/259/01e6cc34516e15ab01037103918dafdfb7_259.mp4', 'time': 1724664302000, 'last_update_time': 1724658922000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '19', 'collected_count': '2', 'comment_count': '', 'share_count': '3', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603121816/600a217312cfe5cab9c3d952a2cbee2e/spectrum/1040g34o316v3kf7a0q0g5olhcu8lbcma15g0g9g!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学,新加坡数学网课,新加坡数学建模,新加坡数学补习,新加坡数学竞赛,新加坡数学应用题,新加坡数学思维,新加坡数学课,新加坡数学课程,新加坡数学老师,新加坡数学教材,新加坡数学cpa,新加坡数学英文,sparkmath新加坡数学,小学数学,小学数学怎么学,思维,开学季', 'last_modify_ts': 1773310577986, 'note_url': 'https://www.xiaohongshu.com/explore/66cc34e9000000001d039bfe?xsec_token=ABC9mfoRVUSmIaAmdu-ymv-wLY6xM65Vv36IcWpYiAQ7A=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABC9mfoRVU