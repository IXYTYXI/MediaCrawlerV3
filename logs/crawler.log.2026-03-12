2026-03-12 21:31:50 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67dbe4d0000000000b015980', 'type': 'video', 'title': '打工人救星！Mathplore省心不费妈', 'desc': '双职工家庭如何同时兼顾工作和孩子学习，来看看这位妈妈是怎么做到的\ufeff@家有两鹅子\ufeff\n————\n虽然是双职工家庭，但是也想抓住幼儿数学思维启蒙的黄金塑造期给孩子启蒙，没有时间教孩子就交给专业的人，我给孩子报名的是Mathplore新加坡数学，教学氛围感孩子很喜欢，轻松就可以把数学搞懂！\n为什么这么多家长选择Mathplore?\n🌍内容体系强大，核心教研团队有平均13年的一线数学教研经验，深谙不同年龄的孩子的认知特点和吸收水平\n🌍跨度范围广，从幼儿园能一直用到小学，内容匹配幼升小-小学数学重难点，超省妈\n🌍采用CPA教学法：从具象到形象到抽象，让娃在具象的生活物品中，理解数的概念和运算\n🌍上课氛围好，孩子一上课就投入，在课后的表达输出环节可以和班上其他几位小朋友一起讨论，学得更扎实，再也不怕遗忘啦！\n————\n课程模式：\n✅2-6人小班授课\n✅英文、中文班灵活选择\n✅课前、课后多种练习方式\n✅课件精美、提升专注力\n✅对标国际数学竞赛AMC8和袋鼠数学体系\n————\n🔥现在咨询即可0元get价值1888元的数学学习大礼包哦\n名额有限，先到先得～\n——\n活动时间：即日起至2025年12月31日\n面向海外18+家长人群\n\ufeff\ufeff#新加坡数学[话题]#\ufeff \xa0\ufeff#数学思维[话题]#\ufeff \xa0\ufeff#数学网课[话题]#\ufeff \xa0\ufeff#小学数学怎么学[话题]#\ufeff \xa0\ufeff#幼小衔接数学[话题]#\ufeff \xa0\ufeff#小学数学思维训练[话题]#\ufeff \xa0\ufeff#小学数学学习方法[话题]#\ufeff \xa0\ufeff#Mathplore[话题]#\ufeff \xa0\ufeff#Mathplore新加坡数学[话题]#\ufeff', 'video_url': 'http://sns-video-qc.xhscdn.com/stream/79/110/259/01e7dbe4991e999f0103700395b2f7030f_259.mp4?sign=6983b8e58829c3ec280f7ed3698e9001&t=69b75d86', 'time': 1742464208000, 'last_update_time': 1742464209000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '3', 'collected_count': '1', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122131/c37cb54a61fb3e8afa5bd7b5b6a3b5b1/spectrum/1040g34o31f8dt3jrmm0g5odiop740t8004sa2m8!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学,数学思维,数学网课,小学数学怎么学,幼小衔接数学,小学数学思维训练,小学数学学习方法,Mathplore,Mathplore新加坡数学', 'last_modify_ts': 1773322310544, 'note_url': 'https://www.xiaohongshu.com/explore/67dbe4d0000000000b015980?xsec_token=ABB64WWINI97p_2zwb5Zn227tnsTyu79XjdLe38nBAv2o=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABB64WWINI97p_2zwb5Zn227tnsTyu79Xjd