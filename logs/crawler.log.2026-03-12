2026-03-12 20:45:42 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6899d974000000000403de55', 'type': 'normal', 'title': '在 Mathplore 学一个学期要花多少钱？', 'desc': '暑假快结束了，不少家长开始操心新学期的学习了！\n最近好多家长问：在 Mathplore 学一个学期新加坡数学要花多少钱？课程值不值？今天就来给大家说清楚～\n\t\n💰 一学期要花多少钱？\n📅 课程安排：一周2次课，每次40-50分钟\n💵 单节课价：低至¥80+（报课越多越优惠！）\n📉 对比线下班：省下接送时间+额外补习费，性价比直接拉满！\n\t\n🎯 这钱花得值吗？\n✔ CPA教学法：从实物→图形→抽象，娃再不说“听不懂”！\n✔ 65%基础+35%拓展：普娃也能跟上，奥数娃更有挑战！\n✔ 2-6人小班直播：互动强，老师盯得紧，拒绝划水！\n✔ 五师服务：从课前-课中-课后，全程“托管式”学习！\n✔G0-G6共七个等级，精准匹配，每一分钱都花在刀刃上！\n\t\n早报早占位～ 想让孩子在新学期领跑，不妨来了解下，性价比真的超预期！\n\t\n👉 现在戳\ufeff\ufeff@Mathplore国际数学咨询\ufeff ，即可get价值1888的试听礼包~\n名额有限，先到先得\n——\n活动时间：即日起至2025年12月31日\n👩面向海外18+家长人群\n\ufeff\ufeff#数学思维[话题]#\ufeff   \ufeff\ufeff#数学网课[话题]#\ufeff \ufeff  \ufeff\ufeff#小学数学怎么学[话题]#\ufeff \ufeff  \ufeff\ufeff#数学学习[话题]#\ufeff \ufeff  \ufeff\ufeff#小学数学思维训练[话题]#\ufeff   \ufeff\ufeff#小学数学学习方法[话题]#\ufeff \ufeff  \ufeff\ufeff#Mathplore[话题]#\ufeff \ufeff  \ufeff\ufeff#Mathplore新加坡数学[话题]#\ufeff', 'video_url': '', 'time': 1754913140000, 'last_update_time': 1754913140000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '13', 'collected_count': '15', 'comment_count': '3', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122045/b3141de35e917cbb9cc8a3a15b72f40f/spectrum/1040g0k031l1u06pij6005odiop740t80nbv1ha0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122045/e694070925b27c3cdf26e410e5fec9d0/spectrum/1040g0k031l1u06pij6105odiop740t80fj151l8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122045/086d8f112bc49673c056bb02dadca1d6/spectrum/1040g0k031l1u06pij60g5odiop740t80oc2slkg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122045/cdffa3eadec06fec0d20031443e501ce/spectrum/1040g0k031l1u06pij61g5odiop740t80f2dgvpo!nd_dft_wlteh_webp_3', 'tag_list': '数学思维,数学网课,小学数学怎么学,数学学习,小学数学思维训练,小学数学学习方法,Mathplore,Mathplore新加坡数学', 'last_modify_ts': 1773319542051, 'note_url': 'https://www.xiaohongshu.com/explore/6899d974000000000403de55?xsec_token=ABb2L9cPy3-LSMjbp0rnf2QgT7qQyg0Em_pGwW_yiPoHg=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABb2L9cPy3-LSMjbp0rnf2QgT7qQyg0Em_pGwW_yiPoHg='}
