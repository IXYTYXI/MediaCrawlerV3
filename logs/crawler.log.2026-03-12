2026-03-12 21:04:04 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '684d4c700000000012000079', 'type': 'normal', 'title': '父亲节｜岁月无声，父爱如山\u200b', 'desc': '💙父亲节只是六月中的一天\u200b\n💙而父亲的爱却是岁岁年年\u200b\n\t\n⛰力量有很多种，爸爸的肩膀就是最坚实的那一种\u200b\n他或许不善言辞，却用布满老茧的双手为我们撑起一片天\u200b\n风吹日晒压弯了他的脊梁，却为我们铺就了平坦的成长之路\u200b\n\t\n小时候总嫌他沉默寡言太严肃🚶♂️\u200b\n长大后才懂得，他的每一次沉默都是深思熟虑的守护\u200b\n\t\n祝全天下的爸爸\u200b\n🎉父亲节快乐！\u200b\n愿您们被岁月温柔以待🌞\u200b\n永远身强体健，笑容爽朗\n\ufeff#父亲节[话题]#\ufeff \ufeff#父亲节快乐[话题]#\ufeff \ufeff#Mathplore[话题]#\ufeff \ufeff#数学思维[话题]#\ufeff \ufeff#Mathplore新加坡数学[话题]#\ufeff', 'video_url': '', 'time': 1749945694000, 'last_update_time': 1749896305000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122104/453fff9324e26e327a0af319b1225f6e/spectrum/1040g34o31in5p1eago105odiop740t80aal1pu0!nd_dft_wlteh_webp_3', 'tag_list': '父亲节,父亲节快乐,Mathplore,数学思维,Mathplore新加坡数学', 'last_modify_ts': 1773320644980, 'note_url': 'https://www.xiaohongshu.com/explore/684d4c700000000012000079?xsec_token=ABvZJ6vMqY74u_7etuhDURZyP_p6RuaunlDiZ6km5-dE4=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABvZJ6vMqY74u_7etuhDURZyP_p6RuaunlDiZ6km5-dE4='}
