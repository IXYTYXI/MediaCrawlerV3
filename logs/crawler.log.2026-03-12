2026-03-12 23:17:57 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67c966800000000009038cde', 'type': 'normal', 'title': '30天逆袭学霸❓这个小班课太牛了❗❗❗', 'desc': '救命😭家长们，你家孩子是不是也是这样学数学的？\n做题速度慢，总说题目太难没法学❌\n表面上在努力刷题，成绩却毫无起色❌\n只热衷于做简单的题，看见难一点的题目就想放弃❌\n家长们心里是直叹气😮💨😮💨😮💨\n-\n🙋♂不想让孩子的数学拖后腿，那一定要有合理的学习规划+正确的学习方法！\n如果家长们不知如何规划，也没时间盯着孩子学习\n那不妨试试【掌门小班课】\n-\n✅课前：授课老师会先给孩子进行摸底测试📈，然后根据孩子薄弱点、校内学习进度、最近一次考试试卷分析，制定专属上课内容，确保孩子听得懂、能掌握💪\n.\n✅课中：老师、孩子面对面沟通，互动性强，随机提问，还能提高孩子的注意力，能跟上老师的节奏\n（有的孩子上课不愿意发言、不敢举手🙋♀️，在掌门也能得到锻炼！）\n.\n✅课后：制定专属课后作业，检验学习成果，班主任老师盯过程和结果，反馈授课老师，老师再根据结果看到孩子知识掌握情况，形成健康循环🔄\n.\n👏有任何问题，随时都能向掌门老师提问，老师会耐心解答，直到孩子完全理解为止。再也不用担心问题越积越多，学习进度被拖后腿啦~😍\n·\n现在点击⬇【立即咨询】还能0️⃣元领取👉🏻1节试听课~\n🉐名师学情诊断服务+专属学习资料包\n感兴趣的家长赶紧冲！！！\n-\n⏰活动时间：即日起—2025年12月31日\n报名要求：32岁以上家长\n\ufeff#掌门[话题]#\ufeff \ufeff#掌门一对一[话题]#\ufeff \ufeff#掌门1对1[话题]#\ufeff \ufeff#线下辅导[话题]#\ufeff \ufeff#学习方法[话题]#\ufeff \ufeff#学习规划[话题]#\ufeff \ufeff#家长必看[话题]#\ufeff \ufeff#数学[话题]#\ufeff', 'video_url': '', 'time': 1741255808000, 'last_update_time': 1741252224000, 'user_id': '649e933900000000140344d9', 'nickname': '掌门1对1特训营', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/65e0143c21adbc000145da44.jpg', 'liked_count': '', 'collected_count': '2', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122317/22a5ee2034c438ab75224c0f68629ada/spectrum/1040g34o31embslp54q0g5p4uicsl6h6p9r9cg0g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122317/f78170b38e381821ba67447e00ac0b82/spectrum/1040g34o31embsmud500g5p4uicsl6h6p1ho8d30!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122317/9689e8aca6a19be5df4f5f4edde34e7d/spectrum/1040g0k031embsnsf4s005p4uicsl6h6prqqp3po!nd_dft_wlteh_webp_3', 'tag_list': '掌门,掌门一对一,掌门1对1,线下辅导,学习方法,学习规划,家长必看,数学', 'last_modify_ts': 1773328677694, 'note_url': 'https://www.xiaohongshu.com/explore/67c966800000000009038cde?xsec_token=ABJHueObcaoOC7YMYko0rxbIp2HomMRk9nvw0UAsp4XEs=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABJHueObcaoOC7YMYko0rxbIp2HomMRk9nvw0UAsp4XEs='}
