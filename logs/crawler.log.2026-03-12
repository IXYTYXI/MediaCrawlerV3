2026-03-12 20:18:29 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '690b24fb0000000003035dae', 'type': 'video', 'title': '刷题无效？1节课唤醒数学脑！', 'desc': '⚡学霸家族秘而不宣的「思维觉醒术」：\n🔞mathplore用CPA建模，直接重构数学认知！\n✅ 把「间隔问题」拆成「线段分配」实战\n✅ 让「几何难题」变成「积木搭建」挑战\n\t\n🌟真实开窍现场：\n“以前见题就懵的娃\n现在抢着说：让我用模型破它！”\n「期中考试被老师请上台讲题」Mathplore新加坡数学小班直播课：\n重点培养小学数学思维，紧跟校内重难点知识，同时拓展到竞赛相关的知识，对标国际数学竞赛AMC8和袋鼠数学体系！\n\t\n一周两节课，高频互动课堂，采用动画游戏，趣味教学，每两分钟和孩子互动一次，让孩子玩中学，学中玩！培养孩子对数学的兴趣，让孩子用积极的态度学数学！\n\t\n👉2-6人小班直播授课\n👉英文班、中文班灵活选择\n👉思维、校内、竞赛一步到位\n👉课件精美，提升孩子专注力，让孩子爱上学习\n\t\n👉 现在戳\ufeff@Mathplore国际数学咨询 ，还可0元领取价值1888元的试听礼包~\n名额有限，先到先得\n——活动时间：即日起至2025年12月31日\n👩面向海外18+家长人群\n\ufeff#数学思维[话题]# \ufeff  \ufeff#数学网课[话题]# \ufeff  \ufeff#小学数学怎么学[话题]# \ufeff  \ufeff#数学[话题]#   \ufeff#小学数学思维训练[话题]# \ufeff  \ufeff#小学数学学习方法[话题]#  #Mathplore[话题]# \ufeff  \ufeff#Mathplore新加坡数学[话题]#', 'video_url': 'http://sns-video-qc.xhscdn.com/stream/79/110/259/01e90b249d2762a1010370039a5388b86e_259.mp4?sign=f73cb11b93748e7c57a80e45503ce4d1&t=69b74c55', 'time': 1762338043000, 'last_update_time': 1762338044000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '5', 'collected_count': '5', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122018/be733bda95434d94d6a39c93d13efa5e/spectrum/1040g0k031ogig87aks005odiop740t80o1sddjg!nd_dft_wlteh_webp_3', 'tag_list': '数学思维,数学网课,小学数学怎么学,数学,小学数学思维训练,小学数学学习方法,Mathplore,Mathplore新加坡数学', 'last_modify_ts': 1773317909568, 'note_url': 'https://www.xiaohongshu.com/explore/690b24fb0000000003035dae?xsec_token=ABfnyfPNalT-a9b2DpMF8fpOYyCsauWQrzXU1EBf3yulE=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABfnyfPNalT-a9b2DpMF8fpOYyCsauWQrzXU1EBf3yulE='}
