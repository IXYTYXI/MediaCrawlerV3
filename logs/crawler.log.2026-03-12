2026-03-12 22:40:45 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67f63933000000001d02c8c4', 'type': 'normal', 'title': '一对一30天冲刺高中数学！', 'desc': '家长们，进入7阶之后，孩子的数学是不是一落千丈？😭\n❌有理数无理数搅得孩子晕头转向\n💔每次考试面对题目完全不知从何下手，成绩始终在原地踏步\n……\n为什么孩子在数学上花费了不少的时间和精力，可一点成效都没有？说到底还是方法没用对‼️\n👏听小编的，直接跟着【掌门一对一线上网课学】\n.\n清北等名师一对一辅导，能深入洞察孩子学习上的漏洞，带娃查漏补缺，教娃学习方法，让娃数学轻松逆袭🚀\n.\n✅专属学情诊断分析：学前会通过摸底测试和试卷分析一阵见血的诊断出孩子的薄弱环节，让孩子学习不迷茫。\n.\n✅ 个性化学习规划：根据每个孩子独特的学习风格和进度，量身定制学习计划，精准打击薄弱环节，拒绝盲目刷题。\n.\n✅ 清北师资天团：清北等名校老师直播授课，不仅知识渊博，还擅长把复杂的知识点讲得简单易懂，同时传授超实用的考试技巧。\n.\n✅ 全程贴心陪伴：课前摸底测试，了解孩子学习状况；课中耐心引导，激发孩子学习兴趣；课后督促作业，及时讲解错题，定期检测学习效果，动态调整学习方案。\n-\n🙋♀️现在点击👇️【立即咨询】即可获🉐0元体验课~\n还🈶1v1专业辅导+定制专属计划+学习资料\n超值活动千万别错过~\n-\n报名要求：32岁以上家长\n截止时间：即日起-25年12月31日\n\t\n\ufeff#数学[话题]#\ufeff \ufeff#学习方法[话题]#\ufeff \ufeff#掌门[话题]#\ufeff \ufeff#逆袭[话题]#\ufeff \ufeff#掌门1对1[话题]#\ufeff \ufeff#掌门一对一[话题]#\ufeff \ufeff#家长必看[话题]#\ufeff \ufeff#数学思维[话题]#\ufeff \ufeff#数学公式[话题]#\ufeff \ufeff#网课[话题]#\ufeff', 'video_url': '', 'time': 1744193344000, 'last_update_time': 1744705912000, 'user_id': '649e933900000000140344d9', 'nickname': '掌门1对1特训营', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/65e0143c21adbc000145da44.jpg', 'liked_count': '', 'collected_count': '1', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122240/09c80f4197103289c5fe4a6c1bc24342/1040g2sg31g9qra3qi6005p4uicsl6h6pgf77ifg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122240/547a36040ded5789ad0d0e17bbae2a07/spectrum/1040g0k031g24mdtlne005p4uicsl6h6pup9pr1o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122240/be0ff7acfe18c383b4c9de7cf1e05f7b/spectrum/1040g34o31g24mf7h7k0g5p4uicsl6h6pdflcpho!nd_dft_wlteh_webp_3', 'tag_list': '数学,学习方法,掌门,逆袭,掌门1对1,掌门一对一,家长必看,数学思维,数学公式,网课', 'last_modify_ts': 1773326445350, 'note_url': 'https://www.xiaohongshu.com/explore/67f63933000000001d02c8c4?xsec_token=ABOXdVW4pfaKZx7zSiOF5EjuWj_BDmgk_0kbi4YMCAu9w=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABOXdVW4pfaKZx7zSiOF5EjuWj_BDmgk_0kbi4YMCAu9w='}
