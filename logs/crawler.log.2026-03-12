2026-03-12 19:31:11 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '694a6c70000000000d03bb2a', 'type': 'video', 'title': '不瞎说❗这样学数学，孩子早就进步了', 'desc': '总感觉孩子学数学费劲？辅导班没少报，网课也试了很多，可孩子就是提不起劲，成绩卡在原地。\n\t\n作为家长，其实更应帮孩子找到根本原因——对症下药，进步才能真实可见。\n\t\n📊 数学学习常见三个坎：\n▸ 方法不对，反复刷题却不见效\n▸ 缺乏体系，知识点零散难串联\n▸ 理解困难，抽象内容无法联系实际\n\t\n这样帮孩子，会更有效：\n把专业的事交给对的人——Mathplore新加坡数学，专为5–12岁孩子设计，不仅能扎实基础，更能打开思维格局，衔接校内与拓展内容。\n\t\n✨ 为什么它值得选：\n· 7个科学进阶等级，匹配孩子真实学习节奏\n· 小班直播互动，关注每个孩子的思考过程\n· 内容融合国际标准，拓宽数学视野\n· 五师一体全程伴学，让进步持续发生\n\t\n🎁 限时家长专享：现在点击左下角【立即咨询】，即可免费领取价值1888元的数学启航资源包（含一节真人名师直播课哦~\n\t\n⏰ 活动时间：即日起-2026年12月31日\n*仅面向18+海外家长群体\n\t\n\ufeff#Mathplore新加坡数学[话题]# \ufeff \ufeff#新加坡数学[话题]# \ufeff \ufeff#小学数学[话题]# \ufeff \ufeff#数学思维[话题]# \ufeff \ufeff#mathplore[话题]# \ufeff \ufeff#小学数学思维训练[话题]# \ufeff\ufeff#数学开窍[话题]# #数学逆袭[话题]#', 'video_url': 'http://sns-video-qc.xhscdn.com/stream/1/110/259/01e94a6c521f86f8010370039b4ab7aa91_259.mp4?sign=b123bdfc8ac6525c6e7d4c2ecb5dd2a8&t=69b7413f', 'time': 1766485104000, 'last_update_time': 1766485104000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '4', 'collected_count': '2', 'comment_count': '1', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603121931/ca0170f4f692e1be18018825922ff07a/spectrum/1040g34o31qebvckumu105odiop740t80ghsl6g0!nd_dft_wlteh_webp_3', 'tag_list': 'Mathplore新加坡数学,新加坡数学,小学数学,数学思维,mathplore,小学数学思维训练,数学开窍,数学逆袭', 'last_modify_ts': 1773315071063, 'note_url': 'https://www.xiaohongshu.com/explore/694a6c70000000000d03bb2a?xsec_token=ABHyWT8RYUg0EhHib-enuDBVKuoUxyMMBMEjFx_3KaXlk=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABHyWT8RYUg0EhHib-enuDBVKuoUxyMMBMEjFx_3KaXlk='}
