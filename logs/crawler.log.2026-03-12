2026-03-12 19:48:43 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69315c9d000000000d03a336', 'type': 'video', 'title': '数学领跑同龄人一大截，她的秘诀原来是…', 'desc': '宸宸中班就拿下 100 以内加减，现在二年级浅奥题轻松拿捏\n选择 Mathplore 新加坡数学真的选对了 ——\n\t\n✅ CPA 教学法太绝了！从实物演示懂行和列，到画线段图建模，应用题再也不用死磕文字，画个图就秒理清数量关系，数学思维直接活起来～\n\t\n✅ 权威教材背书！对标新加坡 92 所小学在用的经典教材，国内国际校、双语校都指定用，知识点讲得细还注重探索，娃学得扎实又灵活～\n\t\n✅ 小班制 + 贴心服务！老师能照顾到每个娃，宸宸从不敢发言到主动举手，班主任定期反馈，作业还有详细解析，家长省心又放心～\n\t\n现在宸宸讲题比妈妈还清楚，会想、会算、还会检查，这数学能力直接拉满，小学根本不用愁！👍\n\t\n特别感谢这位宝妈的真诚分享～ 👉 @小柒柒\n\t\n如果你家娃也在数学启蒙路上，想培养建模思维、让娃主动爱学，不妨试试 Mathplore 新加坡数学，说不定下一个 “数学小达人” 就是你家娃～\n\t\n👉 现在戳\ufeff@Mathplore国际数学咨询  ，即可0元领取价值1888元的试听礼包~\n名额有限，先到先得——\n活动时间：即日起至2026年12月31日\n👩面向海外18+家长人群\n\ufeff#数学思维[话题]#  \ufeff  \ufeff#数学网课[话题]#  \ufeff  \ufeff#小学数学怎么学[话题]#  \ufeff  \ufeff#数学[话题]#    \ufeff#小学数学思维训练[话题]#  \ufeff  \ufeff#小学数学学习方法[话题]#   #Mathplore[话题]#  \ufeff  \ufeff#Mathplore新加坡数学[话题]#', 'video_url': 'http://sns-video-qc.xhscdn.com/stream/79/110/259/01e9315c3e611b53010370039ae8d26300_259.mp4?sign=0116a1ffa4561eb612bec6ea6972167d&t=69b7455b', 'time': 1764842654000, 'last_update_time': 1764843181000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '4', 'collected_count': '1', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603121948/4f01159e82252ad58fb2ba263a0beef8/spectrum/1040g34o31plsp4mm40105odiop740t805o1i1sg!nd_dft_wlteh_webp_3', 'tag_list': '数学思维,数学网课,小学数学怎么学,数学,小学数学思维训练,小学数学学习方法,Mathplore,Mathplore新加坡数学', 'last_modify_ts': 1773316123615, 'note_url': 'https://www.xiaohongshu.com/explore/69315c9d000000000d03a336?xsec_token=AB9yzwbc1xfj6GUe_m99MX50sfY2AqKvzKMY9ZVh3vt3s=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB9yzwbc1xfj6GUe_m99MX50sfY2AqKvzKMY9ZVh3vt3s='}
