2026-03-12 23:10:04 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67d16c020000000003029ed3', 'type': 'normal', 'title': '15天数学惊人逆袭！这个小班课封神！', 'desc': '❓公式记得倒背如流，一到解题就不知所措 ❓\n解题模型和方法学了一大筐，可考试题目稍有变动就头脑空白 ❓\n拼命刷题刷到身心俱疲，成绩却依旧纹丝不动😩\n还在为孩子高中数学焦虑的家长赶紧给娃码住👉【掌门小班课】‼\n15天⏰，带娃数学逆袭开挂💪🏻\n-\n👩🏫👨🏫有清北等名师授课，哪里不会给娃补哪里，无论是基础薄弱，还是难题突破，都能轻松引领孩子攻克，助力孩子成长为学霸💪\n.\n📝有专属学情诊断分析，学前会通过摸底测试和试卷分析，一阵见血的诊断出孩子的薄弱环节，让孩子学习不迷茫。\n.\n👏还会根据孩子学习情况制定个性化学习方案，进行针对性的提升，让孩子的每一份努力都用对方向，学习效果翻倍！\n.\n🌈不仅如此，老师还会对孩子的学习效果进行定期评估，实时反馈孩子的进步与不足。根据反馈信息，迅速调整教学策略，确保教学始终与孩子的学习需求相契合。\n.\n📢而且会制定备考规划，帮家长梳理学考信息，提供全面详细规划指导，让娃学习更高效📊\n-\n现在点击⬇【立即咨询】还能0️⃣元领取👉🏻1节试听课~\n🉐名师学情诊断服务+专属学习资料包\n感兴趣的家长赶紧冲！！！\n-\n⏰活动时间：即日起—2025年12月31日\n报名要求：32岁以上家长\n🏫校区地址：\n🔻徐汇校区：上海市徐汇区田林路105号 303、305 室\n🔻莘庄校区：上海市七莘路50号（乾锦创意园）7号楼1楼部分区域\n🔻金桥校区：上海市浦东新区金高路1296弄151号2层2036、2037单元\n🔻大华校区：上海市宝山区大华路81号美隆大厦205B 206室\n🔻五角场校区：上海市杨浦区政学路51号弘源创新大厦2号楼4层05单元\n🔻控江校区：上海市杨浦区本溪路181号同和凤凰园2楼\n🔻大柏树校区：上海市虹口区江湾镇街道汶水东路351号B楼205室（1876 老站创意园）\n\t\n\ufeff#掌道[话题]#\ufeff \ufeff#学习方法[话题]#\ufeff \ufeff#学习规划[话题]#\ufeff \ufeff#家长必看[话题]#\ufeff \ufeff#数学公式[话题]#\ufeff \ufeff#数学[话题]#\ufeff \ufeff#学渣逆袭指南[话题]#\ufeff \ufeff#学渣逆袭[话题]#\ufeff', 'video_url': '', 'time': 1741777922000, 'last_update_time': 1741777923000, 'user_id': '649e933900000000140344d9', 'nickname': '掌门1对1特训营', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/65e0143c21adbc000145da44.jpg', 'liked_count': '28', 'collected_count': '17', 'comment_count': '', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122310/ac8275a200cb3ffa4d7e31217cd7518e/spectrum/1040g34o31eu6kr4d607g5p4uicsl6h6pi9lhego!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122310/5bfb30022399e730f590e0162ae0ce2a/spectrum/1040g34o31eu6ks8uls0g5p4uicsl6h6prtvf1p0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122310/f396812e01e04e25c536348728d76a01/spectrum/1040g34o31eu6kt46m00g5p4uicsl6h6pdetnid0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122310/38c8b29ab36a1ed67c96bcdd6f71fe77/spectrum/1040g34o31eu6ktummq0g5p4uicsl6h6pk6fh3o0!nd_dft_wlteh_webp_3', 'tag_list': '掌道,学习方法,学习规划,家长必看,数学公式,数学,学渣逆袭指南,学渣逆袭', 'last_modify_ts': 1773328204190, 'note_url': 'https://www.xiaohongshu.com/explore/67d16c020000000003029ed3?xsec_token=ABvHdrJ5gU4EC-5sOBCYWfedBjEaE-JVil9j8eLeaJ4Ts=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABvHdrJ5gU4EC-5sOBCYWfedBjEaE-JVil9j8eLeaJ4Ts='}
