2026-03-12 23:24:59 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67c15bb70000000029018fcf', 'type': 'normal', 'title': '🔥孩子文学素养提升秘籍，家长必看！', 'desc': '家人们，你们是不是也有过这样的困惑👇\n想培养孩子的文学素养，却不知道从何下手\n现在新课标出台，对孩子文学素养的要求大幅提高📈\n‼阅读量要增加，对经典作品的理解要更深入\n‼写作不仅要语句通顺，还得有创意、有深度\n这就像是给家长和孩子都出了一道更难的题，压力一下子就上来了。\n不过别担心，今天就给大家分享在【掌门】加强孩子文学素养的干货方法，亲测有效！\n🔥大量阅读经典作品\n✅给孩子制定阅读计划，每周安排固定的阅读时间，比如每天晚上睡前半小时。从经典的儿童文学作品开始，像《小王子》《夏洛的网》📚，这些作品语言优美，情节引人入胜。\n✅阅读时，让孩子做好读书笔记，记录下喜欢的句子、段落，写下自己的感悟🍁，读完一本书后，和孩子一起讨论书中的人物、主题，引导孩子思考作品传达的价值观✍\n🔥创意写作训练\n鼓励孩子写日记。一开始不用在意文采，只要能真实表达就好。定期布置创意写作任务，🦊比如编写一个童话故事，设定特定的场景和角色，让孩子发挥想象力🧠，写完后，修改从语法错误到语句通顺度，再到内容的丰富性逐步提升🆙\n有为孩子文学素养烦恼的家长们，现在点击左下角【立即咨询】，即可0💰领取试听课哦！\n·\n报名要求：32岁以上家长\n截止时间：即日起-25年12月31日\n新学期计划 #新学期来了[话题]# #掌门[话题]# #掌门一对一[话题]#  #学习方法[话题]# #学习规划[话题]# #家长必看[话题]# #阅读习惯培养[话题]# #作文[话题]# #阅读分享[话题]# #小学语文[话题]#', 'video_url': '', 'time': 1740725175000, 'last_update_time': 1740725175000, 'user_id': '649e933900000000140344d9', 'nickname': '掌门1对1特训营', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/65e0143c21adbc000145da44.jpg', 'liked_count': '', 'collected_count': '1', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122324/6a82d03f0a43e1b18e351748581fdad9/notes_pre_post/1040g3k031eegho83h62g5p4uicsl6h6p69gip38!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122324/142acda7680fa4c1cd70d9769738100c/notes_pre_post/1040g3k031eegho83h6305p4uicsl6h6pnjncmb0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122324/b885a7e2adcfdde47e86223528740c56/notes_pre_post/1040g3k031eegho83h63g5p4uicsl6h6pc5mrhpo!nd_dft_wlteh_webp_3', 'tag_list': '新学期来了,掌门,掌门一对一,学习方法,学习规划,家长必看,阅读习惯培养,作文,阅读分享,小学语文', 'last_modify_ts': 1773329099761, 'note_url': 'https://www.xiaohongshu.com/explore/67c15bb70000000029018fcf?xsec_token=ABLeX5BDDV-ZMDYDxR-3nA0IK2Ud1nqKm911PHPriKek0=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABLeX5BDDV-ZMDYDxR-3nA0IK2Ud1nqKm911PHPriKek0='}
