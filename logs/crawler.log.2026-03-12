2026-03-12 23:27:49 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67c02630000000000b015790', 'type': 'normal', 'title': '每天2h搞定数学❗️真想向每个家长安利掌门', 'desc': '👋家长们都是过来人，都知道高中数学是怎样高难度的存在🥲各种几何图形掺杂各种函数计算，每次考试看到就像是一团乱麻，剪不断理还乱〰️\n👉这难度可想而知孩子学数学的痛苦，家长焦虑孩子数学上不去又帮不上忙，不如让孩子少受点折磨\n.\n尽早找【掌门一对一】老师1v1辅导，数学学得更轻松，家长也能更省心❤️\n.\n✅掌门➕数学=🟰课前摸清数学问题所在➕一对一制定学习计划➕1对1课堂讲解数学难题➕课后定制专属习题巩固➕课后快速答疑解惑\n✅数学从打基础到巩固进步，形成完整学习闭环，数学难题、典型题统统一网打尽⤵️\n.\n【掌门一对一】主打的就是全方位守护孩子数学🥰\n👉每天放学花个1-2小时给数学筑基，比一个劲压力孩子盲目刷题、对完答案还是不会强多了❓\n👉掌门的老师不仅带孩子重新梳理数学各个知识点脉络，还可以一对一带孩子从经典题型中找到解题技巧，🔍发现数学学习窍门\n.\n🙌掌门从课前到课后，1v1拯救数学困难户\n🥇摸底测试，探查基础\n入学进行数学摸底测试，1对1老师✊把握孩子的数学水平，根据更多孩子最近的作业、考试详细分析学情\n.\n🥇制定专属进步方案\n根据孩子的学情分析报告，针对性制定学习方案，带孩子从基础阶段学习亏空开始弥补，再根据孩掌握情况灵活变动方案📚\n.\n🥇1对1课堂教学\n清北老师根据学习规划，课上一对一带孩子打好数学底子，用解题技巧🤌突破薄弱的做题环节，用框架强化基础知识\n.\n🥇课后定时巩固\n根据课堂所学制定专属作业，巩固所学重点题型、知识点等，根据批改结果，孩子不懂的问题👩🏻\u200d🏫老师快速解答\n.\n每个孩子都是潜力股，家长不带孩子试试怎么知道孩子注定不是学数学的料呢❗️\n现在点击👇【立即咨询】即可0元试听1v1网课〰️\n🉐1v1辅导➕1v1学习规划➕学习资料\n.\n报名要求：32岁以上家长\n截止时间：即日起——25年12月31日\n\ufeff#掌门[话题]#\ufeff\xa0\ufeff#掌门1对1[话题]#\ufeff\xa0\ufeff#掌门一对一[话题]#\ufeff\xa0\ufeff#网课[话题]#\ufeff\xa0\ufeff#网课推荐[话题]#\ufeff\xa0\ufeff#学习方法[话题]#\ufeff\xa0\ufeff#学习规划[话题]#\ufeff\xa0\ufeff#家长必看[话题]#\ufeff\ufeff', 'video_url': '', 'time': 1740670204000, 'last_update_time': 1740983383000, 'user_id': '649e933900000000140344d9', 'nickname': '掌门1对1特训营', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/65e0143c21adbc000145da44.jpg', 'liked_count': '4', 'collected_count': '1', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603122327/fd1ca42aadf50271a3565621a13ceaaa/spectrum/1040g34o31eibpsos0c0g5p4uicsl6h6p66coc50!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122327/f0b79dd57bf5ed471e13a2eb12b137c2/spectrum/1040g0k031edarvc2g8005p4uicsl6h6p6mq7930!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603122327/e087f7bfe844b3d6aa09998e32b7bfdc/spectrum/1040g34o31edas168h20g5p4uicsl6h6psoi1b1o!nd_dft_wlteh_webp_3', 'tag_list': '掌门,掌门1对1,掌门一对一,网课,网课推荐,学习方法,学习规划,家长必看', 'last_modify_ts': 1773329269278, 'note_url': 'https://www.xiaohongshu.com/explore/67c02630000000000b015790?xsec_token=ABQNb5X1NjebWDP-yUDxbg8QRhglBMp7i8gZY5FeN9VSs=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABQNb5X1NjebWDP-yUDxbg8QRhglBMp7i8gZY5FeN9VSs='}
