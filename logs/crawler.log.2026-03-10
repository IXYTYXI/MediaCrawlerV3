2026-03-10 20:05:14 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '66f4d0aa000000001b020228', 'type': 'normal', 'title': 'AMC8百遍不如SparkMath一遍！', 'desc': '现在很多家长都知道，牛娃要从娃娃抓起❗\nAMC8花了好几w，发现孩子啥也没学会😑\n简直就是浪费孩子的时间，还耽误了学习⏰\n不要盲目跟风，不了解AMC8就开始瞎给孩子做规划❗\n·\n不知道如何给娃规划AMC8的家长，不妨加入Spark Math的竞赛班\n🔸4-6人小班直播课\n🔸同时提供中英、双语、全中文三种班型\n🔸教学采用主流的CPA教学理念，以计算为基础穿插几何、逻辑推理和应用\n🔸课后大量的学具和练习题，让娃玩中学\n·\n现在点击图片下方⬇ 【立即领取】即可免费获得Spark Math试听课~\n✅ 9大方式激发学习兴趣\n✅ 12种解题大招，锻炼math思维能力\n✅ UDSCSE六步教学法，攻克math难关\n✅ 联合专业老师进行授课讲解\n✅ 分阶教学，循序渐进培养综合实力\n-\n试听大礼包包括\n🎈 1节在线思维直播课\n🎈 12节数独趣味课\n🎈 小学速算巧算训练营课\n\t\n现在点击图片下方⬇ 【立即领取】就可以免费体验哦\n⏰ 截止时间：2024年12月31日\n*课程面向海外人群（18岁以上）\n#新加坡数学[话题]#\xa0\xa0#新加坡数学网课[话题]#\xa0\xa0#新加坡数学建模[话题]#\xa0\xa0#新加坡数学补习[话题]#\xa0\xa0#新加坡数学竞赛[话题]#\xa0\xa0#新加坡数学应用题[话题]#\xa0\xa0#新加坡数学思维[话题]#\xa0\xa0#新加坡数学课程[话题]#\xa0\xa0#amc[话题]#\xa0\xa0#amc8[话题]#\xa0\xa0#amc美国数学竞赛[话题]#\xa0\xa0#amc8美国数学竞赛[话题]#\xa0\xa0#amc8竞赛[话题]#\xa0\xa0#amc8资料[话题]#\xa0\xa0#amc8培训[话题]#\xa0\xa0#amc8真题[话题]#', 'video_url': '', 'time': 1727341804000, 'last_update_time': 1727320235000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '10', 'collected_count': '7', 'comment_count': '', 'share_count': '5', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102005/810e7808d896ba8f531f338abdc651c3/spectrum/1040g34o3186oldvfgs0g5olhcu8lbcmap0unnbg!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学,新加坡数学网课,新加坡数学建模,新加坡数学补习,新加坡数学竞赛,新加坡数学应用题,新加坡数学思维,新加坡数学课程,amc,amc8,amc美国数学竞赛,amc8美国数学竞赛,amc8竞赛,amc8资料,amc8培训,amc8真题', 'last_modify_ts': 1773144314956, 'note_url': 'https://www.xiaohongshu.com/explore/66f4d0aa000000001b020228?xsec_token=ABQ-9BS6d6LoFiP4c2AEWIF9_-yxMwYXR22m9Q7ojax1Y=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABQ-9BS6d6LoFiP4c2AEWIF9_-yxMwYXR22m9Q7ojax1Y='}
