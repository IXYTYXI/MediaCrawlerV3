2026-03-10 23:30:27 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68537ccc0000000013011e0c', 'type': 'normal', 'title': '🤔高途高中1v1补一个暑假要花多少钱', 'desc': '升入高中学习节奏快到飞起！\n暑假没衔接好，开学直接跟不上！\n✅ 这时候，选对高效学习方式太重要！\n不少家长把目光投向了高途1v1，今天就来给大家扒一扒高途1v1的价格及优势\n-\n💰 价格：300+/课时，虽然价格有点小贵！但是高途作为大品牌，师资有保障，教学体系成熟，课程内容都是教研团队精心打磨的，把知识断层部分梳理得很清晰。\n从教学效果和服务质量综合看，高途的性价比还是挺高的。\n🧑\u200d🏫 师资团队：多轮严选师资，全部都是持证上岗，不满意可换\n🙋 学习模式：名师在线1v1直播互动，提前掌握新知识\n🥳 家长省心：在家就可以享受优质的教育资源，还可随时了解学习进度\n📣 贴心服务：课后强化训练+实时答疑解惑，一站式学习，每节课都收获🈵🈵\n-\n↙️ 现在点击左下角【立即咨询】领取1v1试听名额\n🙋 报名要求：32岁以上家长\n\ufeff#高途[话题]#\ufeff\xa0\ufeff#一对一[话题]#\ufeff\xa0\ufeff#网课[话题]#\ufeff\xa0\ufeff#暑假[话题]#\ufeff\ufeff#高中生[话题]#\ufeff \ufeff#高中网课[话题]#\ufeff \ufeff#暑假逆袭[话题]#\ufeff \ufeff', 'video_url': '', 'time': 1750301901000, 'last_update_time': 1750498006000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '33', 'collected_count': '7', 'comment_count': '4', 'share_count': '4', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102330/70e369a9092c958c1693ceccc71ca60b/spectrum/1040g0k031it76f00gm005oakffv0j2cosjsdts8!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,暑假,高中生,高中网课,暑假逆袭', 'last_modify_ts': 1773156627679, 'note_url': 'https://www.xiaohongshu.com/explore/68537ccc0000000013011e0c?xsec_token=ABRHJLVPtugc366G_ZjpButAZ2gBP9COjC-I5yHXhCLt4=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABRHJLVPtugc366G_ZjpButAZ2gBP9COjC-I5yHXhCLt4='}
