2026-03-10 23:03:38 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6902c9ca000000000301966b', 'type': 'normal', 'title': '值爆❗️双11高途1v1至高立减2100', 'desc': '❌ 孩子高中偏科、基础弱，想报1v1又怕超预算？\n✅ 别纠结！高途高中1v1双11大促来了，限时抢购至高立减 2100 元\n🎉 名校名师带学 + 全程督学，花更少钱给娃抢优质辅导，这波错过真得等一年！\n\t\n🔥 【担心大促 “买亏”“买错”？这门课给足保障，让你放心囤】\n▫️ 优惠限时但服务不缩水：双11报名和平时享受的服务完全一样，名师1v1直播、24小时答疑、阶段反馈一个不少，不会因为便宜就 “减配”；\n▫️ 闭环服务盯到出分，提芬有谱，不是 “上完课就不管”！从 “测基础→定计划→直播学→督作业→给反馈”，每一步都有人盯；\n▫️ 热门名师档期紧，手慢无：双11报名的家长多，数学、英语等热门科目的名师档期很快就满，想选到心仪的老师，一定要早点抢名额！\n\t\n👇 想给娃抢优质辅导的家长，赶紧行动吧～\n↙️ 【立即咨询】领取专属1v1试学名额吧～\n🔍 报名要求：32岁以上家长\n⏰ 截止时间：即日起 - 25年11月11日\n#高途[话题]# #一对一[话题]# #网课[话题]# #高中网课[话题]# #课程辅导[话题]# #高途线上[话题]# #双十一[话题]# #双11[话题]# #双11折扣[话题]#', 'video_url': '', 'time': 1761790410000, 'last_update_time': 1761790411000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '1', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102303/92f0381ffd0d360155c0248a1808c1b5/spectrum/1040g34o31o8db4osks305oakffv0j2cov2dqvvo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102303/a57bd36551e57cdffcc94e4b61f962f7/spectrum/1040g34o31o8db4osks3g5oakffv0j2cofr8280o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102303/c2e5ebd5f4004574a00bb404b9a1f8a8/spectrum/1040g34o31o8db4osks405oakffv0j2co6i2sh88!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,高中网课,课程辅导,高途线上,双十一,双11,双11折扣', 'last_modify_ts': 1773155018035, 'note_url': 'https://www.xiaohongshu.com/explore/6902c9ca000000000301966b?xsec_token=ABzYgeNv2ViiljoHSVdSMrZVJPGhAxpFemfxZZzNydGFs=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABzYgeNv2ViiljoHSVdSMrZVJPGhAxpFemfxZZzNydGFs='}
