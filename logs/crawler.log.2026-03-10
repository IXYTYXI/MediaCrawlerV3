2026-03-10 22:57:54 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '692519bc000000000d03be48', 'type': 'normal', 'title': '期末稳芬冲高途1v1网课❗️真的超省心', 'desc': '😭 期末越来越近，孩子数学、物理还在及格线徘徊？\n😭 想提芬却找不到方向，普通网课又没针对性？\n👍 试试高途高中1v1网课！从学前检测到定制方案，再到名师全程带学，家长不用盯也能放心！\n\t\n👉 稳芬第一步：精准定位不盲目\n▫️ 学前检测揪薄弱 先做全科 / 单科检测，不浪费时间在已掌握的内容上；\n▫️ 1v1定制提芬方案 老师根据检测结果，结合期末考纲，定制专属计划 ；\n\t\n👉 名师带学+全程辅导，稳芬有底气\n▫️ 严选持证名师 多轮筛选的持证老师，直播带学边讲边练，知识点当场消化；\n▫️ 课后跟练1v1辅导，针对性批改作业，24小时随时答疑；\n\t\n👉 灵活选老师+试学，家长不踩坑\n▫️ 担心老师风格不匹配？如果上课后觉得不合适，随时能换，不用委屈将就；\n▫️ 先试听再决定，感受老师的讲课节奏、辅导方式，家长不用怕 “花冤枉钱”；\n\t\n期末时间紧，别让孩子在 “低效复习” 上浪费时间！\n↙️ 感兴趣的家长赶紧点击左下方【立即咨询】领取1v1试学名额～\n🔍 报名要求：32岁以上家长\n⏰ 截止时间：即日起-26年12月31日\n#高途[话题]# #高中网课[话题]# #一对一[话题]# #网课[话题]# #一轮复习[话题]# #期末冲刺[话题]# #线上课[话题]# #期末逆袭[话题]#', 'video_url': '', 'time': 1764118140000, 'last_update_time': 1764039101000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '2', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102257/83e3ae8d8147dd02f567ab4c8d31a796/spectrum/1040g34o31p9tjjvdi4105oakffv0j2cosc0he58!nd_dft_wlteh_webp_3', 'tag_list': '高途,高中网课,一对一,网课,一轮复习,期末冲刺,线上课,期末逆袭', 'last_modify_ts': 1773154674127, 'note_url': 'https://www.xiaohongshu.com/explore/692519bc000000000d03be48?xsec_token=ABCno0QiLioCS8fy-YMr1sfjzAUdPkLL7Ni0qE45UoroQ=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABCno0QiLioCS8fy-YMr1sfjzAUdPkLL7Ni0qE45UoroQ='}
