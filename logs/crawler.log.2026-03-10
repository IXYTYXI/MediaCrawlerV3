2026-03-10 17:56:18 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '676400c5000000000800e45f', 'type': 'video', 'title': '六年级超前自学，每天咋安排？', 'desc': '6年级普娃，放学后如何安排时间超前自学？这期视频详细讲一下具体流程，每天只花1小时，高效不费妈！#数学超前学[话题]# #小学数学[话题]# #提前学[话题]# #超前学习[话题]#', 'video_url': 'http://sns-video-hw.xhscdn.com/stream/110/259/01e763ffe72c0f580103700393dea570f9_259.mp4', 'time': 1734607045000, 'last_update_time': 1734607046000, 'user_id': '67288ad9000000001d02c712', 'nickname': '禹妈爱学习', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31aukr3me7g005pp8hbcndhoita547q8', 'liked_count': '782', 'collected_count': '1074', 'comment_count': '49', 'share_count': '253', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603101748/534e01ca082775564b4772be5b8b13cc/1040g00831bjbai2bgk7g5pp8hbcndhoi62i9f00!nd_dft_wlteh_webp_3', 'tag_list': '数学超前学,小学数学,提前学,超前学习', 'last_modify_ts': 1773136578193, 'note_url': 'https://www.xiaohongshu.com/explore/676400c5000000000800e45f?xsec_token=ABZ-_xo9gCxQw2dk288uG_HpiUMZcgoNselv5UeJM_h7c=&xsec_source=pc_search', 'source_keyword': '数学超前学', 'xsec_token': 'ABZ-_xo9gCxQw2dk288uG_HpiUMZcgoNselv5UeJM_h7c='}
