2026-03-10 17:57:00 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6936822b000000001e0306f7', 'type': 'normal', 'title': '数学超前学怎么规划，怎么学（2小学阶段）', 'desc': '数学超前学习小学阶段目标是搭建基本知识结构，方法是逐字逐句阅读1-6年级课本，或使用总复习教辅。常见问题包括家长观念、坚持方法和自主学习培养。建议尽早完成小升初衔接，避免校内成绩提升不明显。#鸡娃必备[话题]# #让孩子爱上数学[话题]# #学霸养成[话题]# #', 'video_url': '', 'time': 1765179947000, 'last_update_time': 1765179947000, 'user_id': '57ed56e65e87e7283a7e695e', 'nickname': '小梦', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31h4t8tekjo0048nnh2becqau6egajng', 'liked_count': '277', 'collected_count': '463', 'comment_count': '49', 'share_count': '68', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603101751/3e509625d8b965175d427fb80bca5ba3/1040g2sg31pqsr3l9527048nnh2becqaunj3cpeg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101751/2622500e97e079435ff35945c3fbb4a1/1040g2sg31pqsr3l9527g48nnh2becqauu4f5gh8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101751/40898d8229dd8a5e68c33b5c0851ad44/1040g2sg31pqsr3l9528g48nnh2becqaueju7mp0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101751/43739886b4c5e48b7b2f2dbd0ebd41cc/1040g2sg31pqsr3l9528048nnh2becqaui3htod0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101751/34b09b523e7ecd5478538e2c35399cd9/1040g2sg31pqsr3l9529048nnh2becqauejd81ho!nd_dft_wlteh_webp_3', 'tag_list': '鸡娃必备,让孩子爱上数学,学霸养成', 'last_modify_ts': 1773136620437, 'note_url': 'https://www.xiaohongshu.com/explore/6936822b000000001e0306f7?xsec_token=ABFgEnIUTVfspQTto7Nab8KDIxDlCl2F_B6_4oV_T-R6U=&xsec_source=pc_search', 'source_keyword': '数学超前学', 'xsec_token': 'ABFgEnIUTVfspQTto7Nab8KDIxDlCl2F_B6_4oV_T-R6U='}
