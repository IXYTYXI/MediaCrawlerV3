2026-03-10 22:18:58 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69afd6350000000022038548', 'type': 'normal', 'title': '语文老师在线捞人👉新学期1v1逆袭前排', 'desc': '😭 文言实词记不牢、🤯 现代文阅读没思路、😨 作文立意浅、语句干，越学越没底气……\n别慌！【掌门一对一高中语文网课】来救场，专业主讲 1V1 带学，带娃轻松逆袭～\n·\n✅ 学前：1v1 定制每日学习清单，今天专攻诗歌鉴赏答题模板，明天突破作文素材与结构\n✅ 学中：1 对 1 直播带学，边讲高频考点边练真题，阅读大题手把手教踩分，确保学完能套用\n✅ 学后：老师逐题批改作业，针对错题深挖失分点，随时答疑扫清疑问，不让困惑拖慢提升节奏\n✅ 进度、内容、难度全按需求调：\n基础弱就先抓默写、病句、基础题保分，能力强就攻阅读、作文冲高分\n✅ 再也不用迁就集体节奏，每一分钟都用在语文提升关键处，冲刺更高效！\n·\n📢 现在点击下方⬇【立即咨询】，还能 0⃣元领取👉🏻1V1 体验课～\n🉐：1 对 1 专业辅导➕定制专属学习计划➕语文学习资料\n感兴趣的家长别错过！赶紧冲！！！\n·\n🔍 报名要求：32 岁以上家长\n⏰ 截止时间：即日起 - 2026 年 12 月 31 日\n#掌门一对一[话题]#  #语文文言文[话题]#  #掌门1对1[话题]#  #高中语文[话题]#  #语文学习[话题]#  #一对一[话题]#  #语文[话题]#  #网课[话题]#  #语文老师[话题]#', 'video_url': '', 'time': 1773134941000, 'last_update_time': 1773131317000, 'user_id': '636b58ff000000001f01a10d', 'nickname': '掌门1对1规划', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/65e00d1bd52bf10001bb9cdb.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '湖北', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102218/87fd59fc62ee8ccf0c05fe9d2c09cddf/spectrum/1040g34o31thd3jddle105orbb3vnr88d48np1ng!nd_dft_wlteh_webp_3', 'tag_list': '掌门一对一,语文文言文,掌门1对1,高中语文,语文学习,一对一,语文,网课,语文老师', 'last_modify_ts': 1773152338662, 'note_url': 'https://www.xiaohongshu.com/explore/69afd6350000000022038548?xsec_token=AB9mya0G5gRV6vHe5UesXJL9rP6LJCmtDmWr65T5KAYmM=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB9mya0G5gRV6vHe5UesXJL9rP6LJCmtDmWr65T5KAYmM='}
