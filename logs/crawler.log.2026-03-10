2026-03-10 21:36:51 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69aaa499000000001a02b0cc', 'type': 'normal', 'title': '🔥跟着平行线学浅奥，数学思维直接打通！', 'desc': '😭学浅奥就懵，题型一变就卡壳，只会死记硬背套公式，稍微灵活点的题就全❌；\n😭🏫内知识和拓展衔接不上，越学越没信心，家长辅导也无从下手；\n😭报过不少课，要么太贵要么不贴合，孩子越学越抵触，成绩原地踏步\n想帮孩子打好数xue基础的家庭看过来！🙋\n\t\n【平行线根源1-8年级】，深耕数学思维教学多年，专注帮孩子打通底层逻辑，拒绝死记硬背！\n💪我们的优势：\n💪不搞机械式刷题，用根源教学法，让孩子理解概念源头和解题逻辑，真正培养数学思维\n💪双师全程伴学，主讲老师都是清北、985/211毕业，资历公开透明，还有督学老师全程跟进，定期测评反馈，家长不用再全程盯\n💪内容支持1年无限次回看，哪里没听懂反复看，帮孩子节省更多时间\n\t\n📌分层匹配，大家都能跟得上\n▫️笃学班：校内30%+课外70%，夯实基础，搭建思维模型，培养好习惯！\n▫️睿学班：校内10%+课外90%，深挖重难点，专攻方法技巧，拓展提升强化优势\n▫️创新班：课外100%，冲刺拔高，挑战更高难度，拓展思维边界\n\t\n📈 学前专业学力测评，直接匹配对应班型，省事儿又高效！\n现在私【年级】领专属规划+试听详情+限时优惠\n📅 活动截止：2026年12月31日\n#平行线数学[话题]#  #浅奥学习[话题]#  #小学数学思维[话题]#  #数学启蒙[话题]#  #数学老师[话题]#  #数学笔记[话题]#  #学数学原来这么简单[话题]#  #好课在线[话题]#', 'video_url': '', 'time': 1772876101000, 'last_update_time': 1772790938000, 'user_id': '642a3b7f000000001102347e', 'nickname': '平行线根源在线数学', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31lto8ekklmq05p1a7dvkcd3utccduk0', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '1', 'ip_location': '河南', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102136/45a42adcfaca0056d9de732838da9438/spectrum/1040g34o31tcam4a56e305p1a7dvkcd3up0g95lo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102136/56233b3418b6b34c8471d029eb8bf839/spectrum/1040g34o31tcam4a56e3g5p1a7dvkcd3utdhb240!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102136/0aace08ea47af29c9def76e0efd6963b/spectrum/1040g34o31tcam4a56e405p1a7dvkcd3umol9u70!nd_dft_wlteh_webp_3', 'tag_list': '平行线数学,浅奥学习,小学数学思维,数学启蒙,数学老师,数学笔记,学数学原来这么简单,好课在线', 'last_modify_ts': 1773149811358, 'note_url': 'https://www.xiaohongshu.com/explore/69aaa499000000001a02b0cc?xsec_token=ABEY8sU4xINMp3qbyKnY2hi9VVt_Psp6LhtjLunz4nhcw=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABEY8sU4xINMp3qbyKnY2hi9VVt_Psp6LhtjLunz4nhcw='}
