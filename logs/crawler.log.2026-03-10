2026-03-10 21:01:38 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69afede9000000001d012a82', 'type': 'video', 'title': '小阶娃数学别死磕❗新学期拉开差距就靠它', 'desc': '别再逼娃死磕数学刷题了💢 越刷越抵触，算数慢、应用题卡壳，思维压根打不开，新学期想拔尖根本没指望，老母亲天天愁到头大！\n\t\n聪明妈妈@面包女孩（孕期）  早就选对方法，Mathplore新加坡数学，一周2节趣味课，轻松激活娃的数学思维，新学期悄悄甩开同龄人💯\n\t\n✅ 四大核心亮点，精准拿捏娃数学痛点\n\t\n- 2-6人精品小班直播\n课堂人数少，互动频次拉满，老师全程紧盯每个孩子，走神、跟不上全不存在，学习效率直接翻倍。\n\t\n- 新加坡CPA教学法\n拒绝死记硬背套公式，把抽象数学知识可视化，复杂难题画图秒懂，帮娃从根源理清解题逻辑。\n\t\n- 资深优质师资带队\n老师平均5年+教龄，吃透低龄娃学习特点，讲课通俗好理解，专业度拉满还懂引导。\n\t\n- 全流程闭环教学\n从课上精讲知识，到课后巩固运用，步步扎实不脱节，让娃不光学会，更能学透会用。\n\t\n✨ 细节拉满，家长闭眼入不踩雷\n\t\n- 趣味游戏课件，数学知识藏进趣味场景，娃主动爱学，不用家长催着上课\n\t\n- 65%校内重难点+35%思维拓展，兼顾校内基础与能力拔高，校内校外两手抓\n\t\n- 中/英双班型同价，数英同步提升，一节课收获双倍效果，性价比直接拉满\n\t\n- G0-G6科学分层教学，精准适配5-12岁娃，不管基础好坏都能找到合适班次\n\t\n- 一课一练+定期测评，学习进步清晰可见，不用盲目学，提升效果看得见\n\t\n小阶娃学数学，找对方法远比死磕刷题重要！抓住新学期关键期，靠思维课轻松领跑，再也不用为数学发愁📈\n\t\n🔥 点击左下角↙【立即咨询】，0元领取1888元试听礼包，名额有限，先到先得！\n\t\n⏰ 活动时间：即日起至2028年12月31日\n*面向海外18+家长人群\n\t\n#新加坡数学[话题]#  #Mathplore[话题]#  #数学思维[话题]#  #让孩子爱上数学[话题]#  #小学数学[话题]#  #培养学习兴趣[话题]#  #数学[话题]#  #小学数学怎么学[话题]#  #开窍[话题]#  #小学数学怎么学[话题]#', 'video_url': 'http://sns-video-al.xhscdn.com/stream/79/110/259/01e9afedcb5127f2010370039cd73a7c7b_259.mp4', 'time': 1773141061000, 'last_update_time': 1773137385000, 'user_id': '5ff43d2b0000000001001995', 'nickname': 'Mathplore线上数学', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/640f03dce33a6ed3c5116b3d.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102101/0e726b4c503a7eb77007d595ffe4022d/spectrum/1040g0k031thfvoemle005nvk7klg86cl8lung08!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学,Mathplore,数学思维,让孩子爱上数学,小学数学,培养学习兴趣,数学,小学数学怎么学,开窍,小学数学怎么学', 'last_modify_ts': 1773147698384, 'note_url': 'https://www.xiaohongshu.com/explore/69afede9000000001d012a82?xsec_token=AB9mya0G5gRV6vHe5UesXJL33OCXhdpXynp8pYBfqHKJs=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB9mya0G5gRV6vHe