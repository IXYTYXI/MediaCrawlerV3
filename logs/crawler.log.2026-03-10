2026-03-10 23:21:59 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6878a1e9000000002203f005', 'type': 'normal', 'title': '1v1带学10天，高中物理开学领跑', 'desc': '❌ 物理公式记不住？受力分析总画错？\n⚠️ 暑假别再硬啃课本了！高途1v1带学每天2小时，10 天精准攻克高中物理新知识；\n👉 从力学基础到电磁初步，名师用 “生活场景拆解法” 把抽象概念讲透\n✅ 课后配专属练习 + 错题复盘，学完忘不了，轻松当领跑者！\n\t\n🔥 【跟高途1v1高效学习】\n👉 每天2h黄金时段，10天吃透物理新知识\n不用熬夜刷题，每天抽出2小时高效突击：提前适应开学重难点，避免学新忘旧；\n👉 时间灵活，在家就能学\n1v1上课时间超灵活，随时根据孩子的时间安排调整，不用接送家长更省心；\n👉 专属班班，全程严管盯学\n课前预习，课中有任何走神的迹象，老师会立刻调整教学方式，课后跟盯学习效果！\n👉 专属班班，全程严管盯学\n1v1针对性定位孩子的薄弱点，才能真正补到位，让每一分钱都花在刀刃上！\n\t\n别等开学被物理难住才着急！这个暑假跟着1v1名师学透新知识，开学当 “学霸”。\n🎁 点击【立即咨询】即可领取1v1专属试学名额\n⏰ 活动时间：即日起-26年12月31日\n🙋 报名要求：仅面向32岁以上家长\n\ufeff#高途[话题]#\ufeff \ufeff#高中[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#高中物理[话题]#\ufeff', 'video_url': '', 'time': 1752793801000, 'last_update_time': 1752736233000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '1', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102321/c7315409afb926f610dca4a447c83450/spectrum/1040g0k031k1fvfgk2g005oakffv0j2coer2hgio!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102321/e0eda77f670653399132586864753e19/spectrum/1040g0k031k1fvfgk2g0g5oakffv0j2cor5g5n90!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102321/7cf00146393907f5ecf584bd362ee050/spectrum/1040g0k031k1fvfgk2g105oakffv0j2cold5v128!nd_dft_wlteh_webp_3', 'tag_list': '高途,高中,一对一,网课,高中物理', 'last_modify_ts': 1773156119129, 'note_url': 'https://www.xiaohongshu.com/explore/6878a1e9000000002203f005?xsec_token=AB8CR3kcsUfNMvn-S4wwqefW1mJOhFRy7raebPrxUAjp4=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB8CR3kcsUfNMvn-S4wwqefW1mJOhFRy7raebPrxUAjp4='}
