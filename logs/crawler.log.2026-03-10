2026-03-10 22:47:25 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '697351e2000000002202e448', 'type': 'normal', 'title': '有没有想体验高途1v1高中数学网课的？', 'desc': '🤔 有没有家长想趁寒假给娃补高中数学的？\n✅ 每天2小时，全程1v1带学，目标直指前3️⃣\n🧑\u200d🏫 高途全名师护航，从基础补到冲刺，严管督学+精准提分，寒假逆袭数学短板就靠它～\n\t\n✅ 全名师1v1直播！风格任选可更换\n💯 所有讲师都是严选名校毕业学霸，持证上岗，教学功底扎实又懂高中数学考点套路；\n💯 各种风格老师任你选！不满意随时换，直到找到适配的那一个，学习积极性拉满～\n\t\n✅ 课前-课中-课后！全流程1v1督学\n💯 1v1基础检测+定制计划，学之前先充分摸底，量身定制专属学习计划；\n💯 1v1直播互动+边学边练，讲完知识点立刻配套练习，趁热打铁巩固吸收；\n💯 课后：24h答疑+全程督学，主讲老师保姆式陪伴，24小时在线秒响应，疑问不隔夜；\n\t\n每天2小时，高途名师1v1全程带学，从基础到冲刺层层拔高！\n感兴趣的家长点击【立即咨询】获取专属基础检测和1v1试听资格～\n📝 报名要求：仅面向32岁以上家长\n📆 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #高中数学怎么学[话题]# #高考数学[话题]# #高中数学[话题]# #网课[话题]##寒假[话题]#', 'video_url': '', 'time': 1769165282000, 'last_update_time': 1769165350000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '1', 'comment_count': '5', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102247/08889314b1921b7beb1b70bf6d5cb0ef/spectrum/1040g34o31rm9v662i4305oakffv0j2co4q550qo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102247/94753c2bd6fc25a64a0a588123aed9c4/spectrum/1040g34o31rm9v662i43g5oakffv0j2co5mjc2v8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102247/65f359b13f9f70b7cfc70c1096218199/spectrum/1040g34o31rm9v662i4405oakffv0j2coj2hin7g!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,高中数学怎么学,高考数学,高中数学,网课,寒假', 'last_modify_ts': 1773154045166, 'note_url': 'https://www.xiaohongshu.com/explore/697351e2000000002202e448?xsec_token=ABAMvHMgwEIWkL4U1rB_4n0gPY2OKLIwE6EhfddFxxq9Y=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABAMvHMgwEIWkL4U1rB_4n0gPY2OKLIwE6EhfddFxxq9Y='}
