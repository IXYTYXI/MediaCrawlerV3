2026-03-10 21:27:46 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69afe71a000000001503b79c', 'type': 'normal', 'title': '被Mathplore思维课圈粉了！孩子越学越上头', 'desc': '以前一直佛系带娃，觉得小学数学没必要“鸡娃”\n以为大家都一样，放学就是玩，直到发现娃跟不上，才慌了\n报班、刷题齐上阵，娃却越来越抵触...\n-------------\n学霸妈妈一句话点醒我：不是逼他学，是要让他愿意学\n随即入手学霸同款：Mathplore新加坡数学，直接爱上了！\n-------------\n比起枯燥灌输，Mathplore很懂怎么抓娃注意力✊\n🤩课件色彩丰富，动画情节有趣\n孩子全程跟着游戏互动、点击屏幕回答问题\n积极性特别高，40分钟居然全程专注❗\n\t\n老师也是真的懂小孩、会引导🎤\n用生活常见的案例，讲解抽象难懂的数学问题\n✨通过提问检验孩子对概念的掌握程度\n耐心又有亲和力，原来内向的娃也敢主动抢答了🔮\n\t\n💡不用死记硬背，课程坚持用CPA教学法\n把文字变成图像，把数字变成模型🎨\n孩子一眼就懂其中的数理逻辑\n原本抽象的概念，😎画图后也能豁然开朗\n\t\n本来还担心跟不上或太简单🤭\n后来发现Mathplore是根据孩子基础分层教学的\n📚内容既衔接了校内，又适当拓展竞赛思维\n进度比校内快半学期，孩子跳一跳就够得着\n\t\n遇到课上讲过的题，孩子三两下就解出来了\n学习特别有成就感🤭🤭\n自信心上来了，越学越上头🎉\n\t\n而且一周上2节课，不用风雨无阻的接送\n到点打开平板就能和老师、小伙伴见面\n我还能瞄一眼娃的学习状态，简直太省心了！\n-------------------\n如果你家也有个觉得数学枯燥、或者怎么教都“不开窍”的娃，真心建议去试听一下~\n👉点击【立即咨询】0元领取试听课\n活动时间：即日起至2030年12月31日\n* 仅面向海外18+家长\n#新加坡数学[话题]# #Mathplore[话题]# #开窍[话题]# #数学网课[话题]# #数学思维[话题]# #小学数学[话题]# #儿童逻辑思维[话题]# #小学数学怎么学[话题]#', 'video_url': '', 'time': 1773135643000, 'last_update_time': 1773135643000, 'user_id': '66c854d2000000001d022cac', 'nickname': 'Mathplore数学开窍', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31djmkng2h66g5pm8aj97cb5cr77jngg', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '四川', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102127/3e0687b7f930cdff26cfca39e6301b94/spectrum/1040g0k031thf3hth5a005pm8aj97cb5caikru4o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102127/38311846c3e5b44c50a19f28f932385b/spectrum/1040g0k031thf3hth5a1g5pm8aj97cb5cbbmk5v0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102127/34a0c46d1e66ee6fc87d335005ee7fbd/spectrum/1040g0k031thf3hth5a105pm8aj97cb5ce7himuo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102127/4594815d482e7b3dfdd79ceeef039a03/spectrum/1040g0k031thf3hth5a205pm8aj97cb5cnda1r0o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102127/68d18d6f0a9452b2dbbe13a5eeb355cc/spectrum/1040g0k031thf3hth5a2g5pm8aj97cb5ckbo1jug!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学,Mathplore,开窍,数学网课,数学思维,小学数学,儿童逻辑思维,小学数学怎么学', 'last_modify_ts': 1773149266672, 'note_url': 'https://www.xiaohongshu.com/explore/69afe71a000000001503b79c?xsec_token=AB9mya0G5gRV6vHe5UesXJL9FkaJSA4HcDYVKUcP51ND8=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB9mya0G5gRV6vHe5UesXJL9FkaJSA4HcDYVKUcP51ND8='}
