2026-03-10 22:47:35 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '697351b4000000000a02dee0', 'type': 'normal', 'title': '真心爽爆了‼️高三闷声拿高分的感觉🤫', 'desc': '⚠️ 家有高三家长集合！\n🎉 在家上高途1v1网课复习，闷声发力拿下高分的感觉，真的太爽了！\n🎉 不用挤线下机构、不用迁就大班节奏，持证名师专属带学\n🎉 全科速提+薄弱补漏双管齐下，高考重难点逐个突破，复习效率直接拉满～\n\t\n👉 严选持证名师！按需挑选可试听\n🌟 高途讲师全是持证上岗，经多轮严选的名校毕业学霸，不仅功底扎实，更懂高考命题规律和提分套路\n🌟 支持先试听再决定，不满意随时更换老师，不管是擅长统筹的、专攻薄弱学科的，还是精通解题大招的，都能挑到适配自己的风格，复习更对味、更高效！\n\t\n👉 高考大招模型！告别题海内卷\n🌟 根据你的具体学情1v1定制课程，用大招模型拆解高考考点，不讲废话、直击核心，教你解1道通1类，达到10题顶50题的复习效果，复习效率翻倍！\n\t\n👉 全程陪伴+24h答疑！家长放心\n🌟 名师1v1直播讲考点：全程直播带学，精准覆盖高考重难点，实时互动答疑；\n🌟 7*24h答疑兜底：课前、课中、课后全程在线，深夜刷题遇难点随时问；\n🌟 定期家长会反馈：主动同步学习详情，家长不用追着问，随时掌握复习进度；\n\t\n高三这一年，选对复习方式比盲目努力更重要！\n想试听1v1的家长，点击【立即咨询】获取专属复习规划和试听资格～\n📝 报名要求：仅面向32岁以上家长\n📆 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #高考逆袭[话题]# #高考冲刺[话题]# #高中学习方法[话题]# #高效学习[话题]# #课程辅导[话题]# #二轮复习[话题]#', 'video_url': '', 'time': 1769165236000, 'last_update_time': 1769165236000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '2', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102247/92e34386eab5f1b524352213d455eafb/spectrum/1040g34o31rm9u1pt26305oakffv0j2con3daoh8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102247/45cd69386cb692c964fdda7401e336d3/spectrum/1040g34o31rm9u1pt263g5oakffv0j2cog4g2hdg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102247/db7592fe40929ade289250f8199a4937/spectrum/1040g34o31rm9u1pt26405oakffv0j2cojpmjmpg!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,高考逆袭,高考冲刺,高中学习方法,高效学习,课程辅导,二轮复习', 'last_modify_ts': 1773154055066, 'note_url': 'https://www.xiaohongshu.com/explore/697351b4000000000a02dee0?xsec_token=ABAMvHMgwEIWkL4U1rB_4n0s5MWaSUDG2krV-rF2p8rjs=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABAMvHMgwEIWkL4U1rB_4n0s5MWaSUDG2krV-rF2p8rjs='}
