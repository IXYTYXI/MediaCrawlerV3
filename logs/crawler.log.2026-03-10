2026-03-10 23:52:38 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67d63be4000000001b03ce49', 'type': 'normal', 'title': '一对一定制辅导❗️只为冲刺重点高中重点班', 'desc': '⚠️ 百天冲刺，无论是学生还是家长都时刻努力不敢放松\n所以一个能够补齐薄弱，稳稳备考的课程\n真的能够帮助节省太多精力👏\n-\n高途初阶线上一对一，帮助全力备考冲刺🔥\n✅ 名师辅导，快速理清学习脉络\n✅ 做题有道，轻松掌握解题思维\n✅ 引导教学，攻破薄弱知识点\n✅ 敢签约，贴心1v1服务保障\n-\n【我们有高效闭环的学习体系，不怕学不会】\n🎉 1v1课前测评，制作专属备考课件，专项加强，备考效率\n🎉 1v1直播实时互动，传授各个题型底层逻辑和答题思路👍突破瓶颈期\n🎉 一课一练+定期阶段性测试，实时检验学习成果，针对性查漏补缺\n-\n赶紧让🧑\u200d🎓跟着高途一对一高效备考吧\n点击左下角【立即咨询】即可加入课程\n报名要求：32岁以上家长\n截止时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff', 'video_url': '', 'time': 1742108462000, 'last_update_time': 1742093285000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '2', 'comment_count': '2', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102352/06b2f257d0bb6a774088634c145809e0/spectrum/1040g0k031f2t133fms005oakffv0j2cok1rirag!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102352/efc1a079fd776b3eb26517f988f37d54/spectrum/1040g0k031f2t133fms0g5oakffv0j2co10oeed8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102352/045e5562790b147b3367f60af1affa8c/spectrum/1040g0k031f2t133fms105oakffv0j2coje8mk7g!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课', 'last_modify_ts': 1773157958918, 'note_url': 'https://www.xiaohongshu.com/explore/67d63be4000000001b03ce49?xsec_token=ABoJrgVW_2Bo-8ZI74peuSYa5OK0i9LUrLVUmQHB2-Buk=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABoJrgVW_2Bo-8ZI74peuSYa5OK0i9LUrLVUmQHB2-Buk='}
