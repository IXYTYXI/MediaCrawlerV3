2026-03-10 23:41:26 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '681ab85a000000002202d288', 'type': 'normal', 'title': '🔥高一开始1对1辅导，助力冲刺双一流！', 'desc': '✖️ 初到高断层大：高一掉队，高二高三再难追上！\n✖️ 弱科越拖越垮：数学/物理一旦崩盘，高三补救要花3倍时间！\n✖️ 学校大班课=吃大锅饭：老师顾不到你，漏洞越积越多！\n💡 高途1对1抢跑计划：从源头杜绝偏科，重本线提前布局！\n✅【高途1v1告别无效学习】\n👉 不用跑线下，在家随时随地都能学\n👉 严选名校毕业持证真名师，搭配独家解题大招，提升学习效率\n👉 同步课内分层教学，针对重难点，全面提升和巩固重点模块\n👉 知识点提炼，精力集中在不懂的部分\n跟高途1v1选择正确的学习方法，针对基础和重点有选择的学习，稳步提升👊\n-\n🙋 现在点击⬇【立即咨询】抢先领取👉🏻试听课名额~定制专属学习计划\n🌈名额有限，先到先得！\n报名要求：32岁以上家长\n截止时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff\xa0\ufeff#一对一[话题]#\ufeff\xa0\ufeff#高中[话题]#\ufeff\xa0\ufeff#网课[话题]#\ufeff\ufeff', 'video_url': '', 'time': 1746581594000, 'last_update_time': 1746586184000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '', 'comment_count': '', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102341/33db14298c7094bde2569043908790e7/spectrum/1040g0k031h5rdnmfk2505oakffv0j2co7ccera0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102341/bf146670d705e05075b9306f54399ddb/spectrum/1040g34o31h5p7bdajc205oakffv0j2cosm97bho!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102341/a42f17679f4b06885c86fca526089823/spectrum/1040g34o31h5p7bdajc2g5oakffv0j2cob56qi40!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中,网课', 'last_modify_ts': 1773157286680, 'note_url': 'https://www.xiaohongshu.com/explore/681ab85a000000002202d288?xsec_token=ABvCvu4VdZPq1kCumVVAhSgb-lYRT8JO_DfypOMXVlzTI=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABvCvu4VdZPq1kCumVVAhSgb-lYRT8JO_DfypOMXVlzTI='}
