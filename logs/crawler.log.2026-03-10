2026-03-10 23:01:44 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '690959e40000000004011569', 'type': 'normal', 'title': '高中1v1选高途！1人1班带学超负责', 'desc': '给高中孩子选网课最怕啥👇\n❓怕 “没人管”“学无效”“遇不到好老师”\n👍 强烈推荐高途高中1v1，超级超级负责\n✅ 从定制专属计划到名师全程陪跑，再到督学盯到底\n🙋 连家长反馈都安排得明明白白，孩子学起来有方向，家长也能彻底放心\n\t\n🔥 【高途1v1将 “提芬” 落到实处】\n▫️ 1人1班定制：定制精确到每节课目标的专属计划，靶向提芬；\n▫️ 5轮严选名师：主讲名校背景、持证上岗、5轮筛选，不满意可更换；\n▫️ 24小时答疑：每日规划学习任务，随时答疑，进度一目了然；\n▫️ 动态调整计划：每阶段测试后，灵活调整学习安排，补足短板；\n▫️ 定期家校沟通：详细反馈学习情况与提分方向，并解答家长疑问；\n\t\n👉 在家学也能 “轻松超车”，灵活又高效\n▫️ 时间灵活：不用来回跑，不会耽误作业或兴趣班；\n▫️ 学习专注：1v1直播课，互动感比线下班还好；\n▫️ 资源省心：不用自己找资料，省出时间多练题；\n\t\n给娃选网课，选 “负责的” 才管用！跟着高途稳稳学习不费力～\n↙️ 赶紧点击【立即咨询】领取专属报名优惠～\n🔍 报名要求：32岁以上家长\n⏰ 截止时间：即日起 - 26年12月31日\n#高途[话题]# #一对一[话题]# #网课[话题]# #高中网课[话题]# #高考冲刺[话题]# #弯道超车[话题]# #学习更高效[话题]# #高中学习方法[话题]# #课程辅导[话题]#', 'video_url': '', 'time': 1762303320000, 'last_update_time': 1762220517000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '4', 'collected_count': '1', 'comment_count': '1', 'share_count': '2', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102301/ade4560f191ad3af1fc0def5cd52bf0e/spectrum/1040g34o31oeqe8iqkq005oakffv0j2co4599hao!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102301/50af8c6bb8fd2e66f769d1f4aa36ba6c/spectrum/1040g34o31oeqe8iqkq0g5oakffv0j2coqf0690g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102301/665ccc4696ca90737202a887ff235ff9/spectrum/1040g34o31oeqe8iqkq105oakffv0j2co73810f8!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,高中网课,高考冲刺,弯道超车,学习更高效,高中学习方法,课程辅导', 'last_modify_ts': 1773154904378, 'note_url': 'https://www.xiaohongshu.com/explore/690959e40000000004011569?xsec_token=ABVZjzth5WhMonHV-4_d5FiObpscZloQo7DlGNwp04v24=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABVZjzth5WhMonHV-4_d5FiObpscZloQo7DlGNwp04v24='}
