2026-03-10 23:10:36 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68cbd560000000000e00d436', 'type': 'normal', 'title': '终于‼️找到了靠谱的高中一对一', 'desc': '很多高中家长的心声：为选1v1，前前后后试听了好多家机构，不是🧑\u200d🏫不专业，就是没人监督，最后全退了！\n直到试了高途官方高中1v1，才终于找到 “靠谱的感觉”—— 虽有点小贵，但从规划到出芬全程负责，这次终于不用再折腾了！\n\t\n👉 高途1v1：贵有贵的道理，负责到每一步，全程不甩锅：\n▫️ 专属规划，不盲目赶进度：先做学情诊断，知道娃哪门薄弱，直接定制专属计划——每节目标清晰，不做无用功；\n▫️ 名师+班班 “双管齐下”：没懂就反复讲，直到点头；专属班班更负责，作业批改24小时随时答疑，比家长还细心；\n▫️ 负责到底，不半途而废：大kao之后🧑\u200d🏫会分析 “错在哪里”，真正 “一管到底”。\n\t\n想给高中生找靠谱一对一的家长赶紧行动起来吧～\n↙️ 点击【立即咨询】即可领取1v1试听体验\n🙋 报名要求：32岁以上家长\n⏰ 报名时间：即日起 - 2026年12月31日\n#高途[话题]# #高中[话题]# #高中网课[话题]# #高中生[话题]# #一对一[话题]# #学霸养成[话题]# #学习经验[话题]# #学习规划[话题]# #高效学习[话题]#', 'video_url': '', 'time': 1758188896000, 'last_update_time': 1760146853000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '', 'comment_count': '2', 'share_count': '2', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102310/dff799e5f3544a922e80bc74510e06c2/spectrum/1040g0k031n5kkbhtks005oakffv0j2co6ee8iq8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102310/0b70eee55d81bf8ee364f2c03f0222f5/spectrum/1040g34o31mio0lmlkq205oakffv0j2co94sb81g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102310/cf7c2b662a2ff6fe05ced7e8d1e21d50/spectrum/1040g34o31mio0lmlkq2g5oakffv0j2coe2ftfhg!nd_dft_wlteh_webp_3', 'tag_list': '高途,高中,高中网课,高中生,一对一,学霸养成,学习经验,学习规划,高效学习', 'last_modify_ts': 1773155436538, 'note_url': 'https://www.xiaohongshu.com/explore/68cbd560000000000e00d436?xsec_token=AB9sTCtm4Daj6bt08gAFf3LE9vDAJhqIaCVOftIqljwMI=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB9sTCtm4Daj6bt08gAFf3LE9vDAJhqIaCVOftIqljwMI='}
