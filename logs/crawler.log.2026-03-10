2026-03-10 23:04:03 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6902c8f10000000003023503', 'type': 'normal', 'title': '高中物理冲高芬❗️选1v1辅导超省心', 'desc': '😮\u200d💨 总愁孩子物理：公式记不住、受力分析懵\n🤔 大题写不出，考试徘徊在 60 分，怎么补都没效果\n🤩 建议各位家长一定要给孩子试试高途1v1线上辅导！\n不是靠刷题 “死磕”，而是靠精准定制、全程盯学，学物理终于不费劲了！\n\t\n✅ 高途高中1v1网课，每一步都帮孩子 “稳扎稳打”：\n▫️ 1v1定制到 “每天怎么学”：\n先测薄弱点，再定制每天的具体任务，孩子跟着走就行，不用花时间想 “今天该学啥”，效率直接拉满；\n\t\n▫️ 1v1直播带学\n边学边练不脱节，老师互动不单向讲，还会让孩子当场练题，确保学完就能用，不会似懂非懂；\n\t\n▫️ 专属班班督学\n每天提醒 “该上课啦”，作业提交后，班班会逐题批改，还会24小时答疑，不让疑问堆到第二天；\n\t\n▫️ 一整套学习方案 + 课后巩固\n学前学后+ 错题复盘”，形成完整学习链，帮孩子把知识点吃透，避免 “学了就忘”；\n物理基础弱、做题没思路、想冲高分没方法，一定要试试高途1v1线上辅导\n\t\n↙️ 【立即咨询】领取专属1v1试学名额吧～\n🔍 报名要求：32岁以上家长\n⏰ 截止时间：即日起 - 26年12月31日\n#高途[话题]# #一对一[话题]# #网课[话题]# #高中物理[话题]# #高考物理[话题]# #高中网课[话题]# #学物理原来这么简单[话题]# #高效学习[话题]#', 'video_url': '', 'time': 1761790193000, 'last_update_time': 1761790193000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '2', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102304/189a2b58860982b0988bd9e8a56118f1/spectrum/1040g0k031o8d7q5v4u005oakffv0j2colh7egv0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102304/156ba42375c542e6c00d37672528f7f9/spectrum/1040g0k031o8d7q5v4u0g5oakffv0j2cojj83uh0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102304/2dcf3c73ad752ab64b05ca6c4a48ff31/spectrum/1040g0k031o8d7q5v4u105oakffv0j2cona37890!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,高中物理,高考物理,高中网课,学物理原来这么简单,高效学习', 'last_modify_ts': 1773155043445, 'note_url': 'https://www.xiaohongshu.com/explore/6902c8f10000000003023503?xsec_token=ABzYgeNv2ViiljoHSVdSMrZd_35n55yW2tM02gH0-YCMc=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABzYgeNv2ViiljoHSVdSMrZd_35n55yW2tM02gH0-YCMc='}
