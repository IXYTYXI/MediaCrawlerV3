2026-03-10 23:24:31 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '686f1992000000001d00c045', 'type': 'normal', 'title': '高中暑假名师1v1带学！让你学完忘不了', 'desc': '🤔 还在愁暑假来回跑补习班？\n🧑\u200d🏫 高途高中1v1网课直接把 “双一流名师” 请回家\n👉 课前精准摸底、课中互动到走神都难、课后盯着巩固，学完一个暑假，知识点想忘都忘不了，这波真的赢麻了！\n\t\n✅ “躺着学” 还比线下高效？这服务绝了\n▫️ 不用顶着大太阳赶补习班，在家就能上名师课；\n▫️ 课中随时开麦提问：老师，这道解析几何步骤再讲一遍；\n▫️ 课后作业直接线上交、24小时有学习问题随时问！\n\t\n✅ “私人定制” 学习方案，精准到每道错题\n▫️ 根据测试结果调计划，薄弱点追着补，绝不做无用功！\n\t\n✅ “双一流名师天团”，把考点讲成 “洗脑包”\n▫️ 这些老师都是4% 通过率筛出来的狠人，讲课风格太严肃？随时换老师！\n\t\n✔️ 家长彻底躺平：不用陪写作业、不用盯背诵，每周看学习报告就行！\n赶紧点击左下角【立即咨询】领取1v1试学名额吧～\n活动时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#高中[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#暑假[话题]#\ufeff', 'video_url': '', 'time': 1752111506000, 'last_update_time': 1752111507000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '3', 'collected_count': '5', 'comment_count': '1', 'share_count': '2', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102324/dc7d2c5e0ec6b81e90acdcbf49b1eab8/spectrum/1040g0k031jo63539jq005oakffv0j2coi35nukg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102324/2656891c9c6fd8e52e5547e162ea6742/spectrum/1040g0k031jo63539jq0g5oakffv0j2cofr4jqd0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102324/9d9a34ed180de53737757e19f218e462/spectrum/1040g0k031jo63539jq105oakffv0j2cod45od08!nd_dft_wlteh_webp_3', 'tag_list': '高途,高中,一对一,网课,暑假', 'last_modify_ts': 1773156271219, 'note_url': 'https://www.xiaohongshu.com/explore/686f1992000000001d00c045?xsec_token=ABqJmkmJAf0neNFA-MkLd2HP5u6QAJZ5keIK7r8QFDYLY=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABqJmkmJAf0neNFA-MkLd2HP5u6QAJZ5keIK7r8QFDYLY='}
