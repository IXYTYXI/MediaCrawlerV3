2026-03-10 23:20:42 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68834cd000000000220324e4', 'type': 'normal', 'title': '冠军同款1v1网课，双师陪跑到出分', 'desc': '连跳水队都在上的高中1v1网课，到底藏着什么过人之处？—— 原来靠的是 “双师全程陪跑”：双一流名师带练解题大招，督学老师盯紧每步进度，从基础薄弱到解题开挂，难怪尖子生都把它当成 “冲刺神器”！\n\t\n中国国家跳水队官方合作伙伴——高途\n🈶 闭环式学习体系\n入学后拥有专属成长档案记录学习；专业测试诊断分析，精准学习；全程督促伴学，避免跑神，学一整节课；专属一对一沟通群，及时沟通了解❗️\n.\n🈶 多轮严选名校学科翘楚1v1直播教学\n主讲拥有丰富的教学经验，知识点高度凝练，内容深入浅出，课后随时解答困惑，助力孩子扫清知识盲区👍\n.\n🈶 打破时间空间局限\n不用来回奔波，随时随地都能学，让孩子不用出家门，就能享受优质教育资源📚\n-\n现在点击左下角【立即咨询】还可以领取1v1试听名额\n💬 报名要求：仅面向32岁以上家长\n⏰ 截止时间：即日起至25年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#和冠军做同学[话题]#\ufeff \ufeff#冠军在高途[话题]#\ufeff \ufeff#高中网课[话题]#\ufeff', 'video_url': '', 'time': 1753443303000, 'last_update_time': 1753435344000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102320/60e825d30feecc67fe1e5f7847f17ddb/spectrum/1040g0k031kbt8gq4k8705oakffv0j2co0pm92d8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102320/af91ca257a6db5d1fc9ad141d8debb93/spectrum/1040g0k031kbt8gq4k87g5oakffv0j2co7r1cj9o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102320/aaa90ba2b440df6c8514778ae78374de/spectrum/1040g0k031kbt8gq4k8805oakffv0j2cop532490!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,和冠军做同学,冠军在高途,高中网课', 'last_modify_ts': 1773156042165, 'note_url': 'https://www.xiaohongshu.com/explore/68834cd000000000220324e4?xsec_token=ABv4ctUCPbF-xvXHlefxtvkMdzCVpqom201vLkbuSlfDU=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABv4ctUCPbF-xvXHlefxtvkMdzCVpqom201vLkbuSlfDU='}
