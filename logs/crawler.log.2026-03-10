2026-03-10 17:58:00 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69328dcd000000001e0201d8', 'type': 'video', 'title': '五年级数学满分秘籍：三个方法➕一个工具', 'desc': '别羡慕数学学得好是有天赋的娃专属！小学阶段数学优秀，关键在方法和工具，普娃照做也能行！\n\t\n🌸超前学：寒暑假提前过课本内容，开学后听课效率高、写作业丝滑。用作业帮的新功能动态演示难点，辅导更轻松！\n🌸刷错题：只预习还不够，作业帮可拍照收集错题，生成电子错题本并一键组卷，打印后带孩子反复练，彻底解决薄弱点。\n🌸回归课本：小学大部分考题源自课本例题，学完一节就让孩子重做课本练习，用作业帮“扫码搜书”看解析，省时省力。\n\t\n选对方法和工具，学习就能事半功倍。试试这三招，再体验作业帮升级的新功能，帮孩子轻松学数学！\n#AI学习用作业帮[话题]# #作业帮数学[话题]# #作业帮app[话题]# #学习方法[话题]# #高效学习[话题]# #学习工具[话题]# #学习技巧[话题]# #数学思维[话题]# #学习方法很重要[话题]#', 'video_url': 'http://sns-video-hw.xhscdn.com/stream/1/110/259/01e9328cdb1b3f39010370039aed7b9570_259.mp4', 'time': 1764922111000, 'last_update_time': 1764920782000, 'user_id': '5ac7d0604eacab797beeb99f', 'nickname': 'Grace妈妈的育儿笔记', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31a2h19de7c0g4a4b7p861ecv93oksu8', 'liked_count': '203', 'collected_count': '122', 'comment_count': '51', 'share_count': '44', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603101753/855713c1508d5ceecf433bcbb6979024/1040g00831pn1saufkm004a4b7p861ecvmeje6q0!nd_dft_wlteh_webp_3', 'tag_list': 'AI学习用作业帮,作业帮数学,作业帮app,学习方法,高效学习,学习工具,学习技巧,数学思维,学习方法很重要', 'last_modify_ts': 1773136680623, 'note_url': 'https://www.xiaohongshu.com/explore/69328dcd000000001e0201d8?xsec_token=ABS2bx5-RRN2K-jB7vSv4p4XMhH_YWPDLVTggiZYV8X5Y=&xsec_source=pc_search', 'source_keyword': '数学超前学', 'xsec_token': 'ABS2bx5-RRN2K-jB7vSv4p4XMhH_YWPDLVTggiZYV8X5Y='}
