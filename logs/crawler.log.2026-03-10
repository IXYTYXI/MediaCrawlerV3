2026-03-10 23:17:19 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6896ae67000000002501ad3f', 'type': 'normal', 'title': '真的能出芬！高三1v1复习全程陪跑', 'desc': '⚠️ 家有高三生的家长，是不是每天都在焦虑？\n❌ 关键的一轮复习即将开始，却完全找不到学习状态\n❌ 翻开孩子的错题本，上次讲过的知识点又错了\n❌ 想到距离高考只剩不到 300 天，整夜整夜睡不着觉…\n✅ 别慌！高途高中1v1网课带着高三全程陪跑计划来了！负责到出芬，这波真的稳了！\n\t\n🔥 【跟着一对一精准高效复习】\n👉 全科系统复习方案，专项查漏补缺：老师带着1v1梳理知识点，搭建完整的知识框架！\n👉 双一流主讲，带你吃透高kao重难点：每节课都是满满的干货，比闷头刷题效率高10 倍！\n👉 ke后还有专属班班答疑，作业精细批改，不会的题随时问，必kao内容统统拿下！\n\t\n⚠️ 赶紧抓住这波机会，跟着名师抢跑高三，开学直接惊艳！\n点击左下角【立即咨询】领取1v1试学名额\n活动时间：即日起-26年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#高中[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#高三复习[话题]#\ufeff \ufeff#学习日常[话题]#\ufeff', 'video_url': '', 'time': 1754731562000, 'last_update_time': 1754705512000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '54', 'collected_count': '10', 'comment_count': '2', 'share_count': '5', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102317/340d69aaf56e70dfbd1709e9f1fa44fe/spectrum/1040g34o31kur0el1j6005oakffv0j2co0ilkq5o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102317/35dba82b8798f5c52ab4ffb3ac51be6e/spectrum/1040g34o31kur0el1j60g5oakffv0j2co9t9p4oo!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中,网课,高三复习,学习日常', 'last_modify_ts': 1773155839376, 'note_url': 'https://www.xiaohongshu.com/explore/6896ae67000000002501ad3f?xsec_token=ABnmatSxT3DMU9caN1Wt0dSgK7zG-vK1O4xEDT9OdFpvc=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABnmatSxT3DMU9caN1Wt0dSgK7zG-vK1O4xEDT9OdFpvc='}
