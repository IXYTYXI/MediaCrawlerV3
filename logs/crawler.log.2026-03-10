2026-03-10 16:05:24 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '66e6459b000000002603f06f', 'type': 'normal', 'title': '五年级超前自学：五下《学霸》刷完啦！', 'desc': '开学后时间相对紧张，但超前学路线坚定走👏\n从四下暑假才开始放小奥超前自学校内战略📄\n目前自学教材配合刷学霸练习册完成了五下✅\n数学的终极取胜方法：一定是降维打击👊🏻\n学期内知识除了作业之外回家不再复习了\n时间挤出来往前学，校内目前掌握很轻松\n五下分数的加减法和拓展思维都比较灵活\n推进缓慢却也算比较扎实啦，预备六上了\n接下去六年级上下两册按板块系统学习👏                             计划五年级暑假顺利衔接七年级数学～\n📚语文\n语文不超前校内但重视阅读和积累\n校内语文依旧保持优秀的成绩水平\n初中文言文：背完《核舟记》前2段\n《巴黎圣母院》慢慢看着～\n这也是我初一读完的书，我特别喜欢💕\n✍🏻英语\n每天至少背默10个单词，语法多轮式掌握\n💻编程\n今天考完蓝桥杯python等考3级\n冲明年省赛一吧，加油👏小哥哥\n💪运动\n每周游泳🏊羽毛球🏸跳绳\n10周岁3个月身高：150cm\n今年的目标是再长📈三公分\n每天羊奶驼奶牛奶🥛鸡蛋🍳\n开学后老母亲学了花样早餐🥣\n陪着娃快乐健康智慧成长🀄️\n#超前学[话题]# #小学数学怎么学[话题]# #提前学[话题]# #五年级数学[话题]# #六年级数学[话题]# #学习日常[话题]# #小学数学学习[话题]# #初中数学[话题]# #小升初[话题]#', 'video_url': '', 'time': 1726367131000, 'last_update_time': 1726367252000, 'user_id': '58ac059250c4b415f11d1b19', 'nickname': '吴比乐同学', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31oaaem5hmm00496d432p46op0cgu0ao', 'liked_count': '805', 'collected_count': '820', 'comment_count': '326', 'share_count': '95', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603101556/6cbefe6cf7729804ec3af21ef9ae36be/1040g2sg317oi7kf7k470496d432p46opvq81ap0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101556/6f877d853c48bbe329529f2170bf55a1/1040g2sg317oi7kf7k47g496d432p46opl2kmas0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101556/1b80c0b0aefc066e60e325069df702d1/1040g2sg317oi7kf7k480496d432p46opj27jnro!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101556/4fab14048327e53c042b3da73ec52cc2/1040g2sg317oi7kf7k48g496d432p46op4pru6do!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101556/b8133c69782a5a390cdde254d3dd701e/1040g2sg317oi7kf7k490496d432p46oprge602o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101556/b67fb19d5ff951cffca9e51c8864e6e0/1040g2sg317oi7kf7k49g496d432p46opudimv88!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101556/89a9a61c2b9bfc38f44324274fc306ce/1040g2sg317oi7kf7k4a0496d432p46opjgisp4g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101556/7f618aea95385aaebb6a59eccede9301/1040g2sg317oi7kf7k4ag496d432p46op7oa3500!nd_dft_wlteh_webp_3', 'tag_list': '超前学,小学数学怎么学,提前学,五年级数学,六年级数学,学习日常,小学数学学习,初中数学,小升初', 'last_modify_ts': 1773129924066, 'note_url': 'https://www.xiaohongshu.com/explore/66e6459b000000002603f06f?xsec_token=ABybklzSJzi-F38eYa0RI7uMkhm0N9JAG59kbVzgjNDsU=&xsec_source=pc_search', 'source_keyword': '数学超前学', 'xsec_token': 'ABybklzSJzi-F38eYa0RI7uMkhm0N9JAG59kbVzgjNDsU='}
