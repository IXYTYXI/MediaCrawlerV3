2026-03-10 20:47:20 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69aa93fe000000001d01088a', 'type': 'normal', 'title': '换成sparkmath后，小学数理直接开挂了‼️', 'desc': '🤯 花了2w冤枉💰，砍掉了无数死记硬背的刷题班\n终于找到sparkmath（火花新加坡数学）！\n-\n🥳 【专治“不开窍”，CPA建模法太香了】\n5-12岁的孩子，还在大脑发育，你硬塞公式他根本听不懂！\nsparkmath最绝的就是它的CPA（具象-形象-抽象）教学法\n不用列方程，瞬间就能看出逻辑关系！这才是真正的降维打击！\n🥳 【拒绝录播走神，真人小班太省妈】\n大班课或者录播课，孩子三分钟就能神游天外\nsparkmath新加坡数学是真人小班直播！\n老师精准关注，娃的小动作看的一清二楚，随时点名互动，专注力拉满！\n🥳 【不盲目超前，紧扣校内还能拔高思维】\n很多思维课学了半天，校内考试还是拉胯\nsparkmath完美融合了国内的教学大纲，80%校内基础+20%思维拔高\n不仅补足了校内的短板，还顺带把逻辑思维给出来了！\n-\n找到对的方法，普娃也能一路开挂 🎁\n真心建议大家先去试听！点击下方【立即咨询】\n➡️ 0元领1节真人直播试听课！ 让孩子亲自感受一下，就知道这课到底有多神！\n⏰ 活动时间：即日起-2027年12月31日\n👩🏻\u200d💻 适合5-12岁青少儿，面向家长群体，名额有限！\n#sparkmath新加坡数学[话题]# #sparkmath[话题]# #新加坡数学[话题]# #新加坡数学网课[话题]# #新加坡数学直播课[话题]# #新加坡数学一年级[话题]# #新加坡数学价格表[话题]# #新加坡数学启蒙[话题]# #小学数学网课[话题]# #新加坡数学线上课价格[话题]#', 'video_url': '', 'time': 1772786686000, 'last_update_time': 1772786686000, 'user_id': '61b2fc7e000000001000f059', 'nickname': 'Spark Math线上课程', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4aeb79ls6g5odivhv41s2pgohmd30', 'liked_count': '2', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102047/556f54fb92f7fafcfa02dd07f83f2dc0/spectrum/1040g0k031tc8mt7b56005odivhv41s2piktomfo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102047/01e622d1ca482187985c6d2ba660e16f/spectrum/1040g0k031tc8n3fjl6005odivhv41s2plv8ck08!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102047/bf293f28b301e96e19d30302a221a0d3/spectrum/1040g0k031tc8n52856005odivhv41s2p4ifuga0!nd_dft_wlteh_webp_3', 'tag_list': 'sparkmath新加坡数学,sparkmath,新加坡数学,新加坡数学网课,新加坡数学直播课,新加坡数学一年级,新加坡数学价格表,新加坡数学启蒙,小学数学网课,新加坡数学线上课价格', 'last_modify_ts': 1773146840907, 'note_url': 'https://www.xiaohongshu.com/explore/69aa93fe000000001d01088a?xsec_token=ABEY8sU4xINMp3qbyKnY2hi8xj9nCahusqhYCaHQAIIA0=&xsec_source=pc_search', 'source_keyword': '', 'xs