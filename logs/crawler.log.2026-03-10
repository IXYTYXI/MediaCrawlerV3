2026-03-10 22:45:05 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6985ac74000000001a036b55', 'type': 'normal', 'title': '高三高考备战必看！高途1v1陪跑网课封神', 'desc': '😭 备战高考的日子里，谁没踩过复习的坑？\n刷题刷到麻木却不见提分，考点杂乱分不清重点\n遇到难点没人及时点拨，报了网课要么师资掺水\n要么课程不适配，眼看高考越来越近，越复习越慌...\n\t\n✅ 别慌！给所有备战高考的高三学员，安利这款高途1v1陪跑网课，不管你是基础薄弱想补漏、中等水平想拔高，还是尖子生想冲刺巅峰，全程适配，彻底告别无效复习！\n\t\n### 👉 6轮严选持证名师！拒绝伪名师坑\n📍 高三1v1讲师，全程经过6轮严苛筛选，持证上岗\n📍 名校毕业学霸加持，不是随便凑数的兼职老师\n📍 吃透高考命题规律，懂考点、会技巧、能共情\n\t\n### 👉 高考大招模型！告别题海内卷，高效提分\n📍 精准定制课程：适配所有备战高考的学员\n📍 大招拆解考点：大招模型拆解高考核心考点，效率翻倍\n📍 覆盖重难点：精准对接高考考纲，全程聚焦高考重难点\n\t\n### 👉 24h全程陪跑！家长省心，学员安心\n📍 7*24h答疑解惑：随时提问、秒响应，疑问不隔夜\n📍 全程陪伴督学：专人盯预习、盯听课、盯复习\n📍 定期家长会反馈：主动同步学习详情、知识漏洞、家校配合\n\t\n高途高三复习1v1陪跑网课，帮你少走弯路、高效提分，稳稳迎战高考！\n点击【立即咨询】获取专属学情检测和1v1试学名额吧～\n📝 报名要求：仅面向32岁以上家长\n📆 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #高考冲刺[话题]# #高考复习[话题]# #二轮复习[话题]# #高考逆袭[话题]# #陪跑[话题]#', 'video_url': '', 'time': 1770368116000, 'last_update_time': 1770368117000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102245/8a084ffa6be25b57bdd62e93dbcd28bf/spectrum/1040g0k031s87get2la005oakffv0j2co08iimi8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102245/b6abfc77854d1504d25544d37d798ac5/spectrum/1040g0k031s87get2la0g5oakffv0j2codsu9acg!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,高考冲刺,高考复习,二轮复习,高考逆袭,陪跑', 'last_modify_ts': 1773153905029, 'note_url': 'https://www.xiaohongshu.com/explore/6985ac74000000001a036b55?xsec_token=ABzaatJlt5nlUnF3m8mEHx3rG5CgYG2E78xo2PG7WDyBw=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABzaatJlt5nlUnF3m8mEHx3rG5CgYG2E78xo2PG7WDyBw='}
