2026-03-10 23:43:54 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '680994f5000000001d009b84', 'type': 'normal', 'title': '暑假1v1严管盯学，名师在线“连环催”！', 'desc': '你家🧑\u200d🎓是不是每到寒暑假就是这种状态：\n👉🏻 “假努力”成常态：每天坐书桌前10小时，实际有效学习不到1小时\n👉🏻 “孤军奋战”效率低：自学没方向，错题越积越多，不会的永远不会\n👉🏻 “滑坡”现象：两个月不学倒退30%，开学直接被碾压\n👉🏻 家长监督崩溃：又要上班又要管学习，血压天天飙升\n\t\n🎯 高途1v1解决方案——把优质资源搬回家\n✔ 985/211名师专属带学——不是录播课！真人直播连麦，随时提问随时解答\n✔ 专属班班陪伴——学前提醒、上课提醒，课后作业、答疑\n✔ 一对一定制详细学习排程——精确到每日计划，杜绝“磨洋工”\n✔ 阶段家长会——家长随时了解学习情况，省心省力✌️\n\t\n感兴趣的家长赶紧点击左下角【立即咨询】定制专属暑假课程吧\n*本课程为家庭教育规划课，内容仅面向家长\n📆 活动时间：即日起-2025年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#盯学[话题]#\ufeff \ufeff#暑假[话题]#\ufeff \ufeff#自律学习[话题]#\ufeff', 'video_url': '', 'time': 1745552041000, 'last_update_time': 1745458421000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '16', 'collected_count': '5', 'comment_count': '1', 'share_count': '3', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102343/1aa69a13d3cbe703f4843209e511c5ba/spectrum/1040g0k031gl1ktm7j8005oakffv0j2co047d8o8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102343/81beeaa6faf205e4d3ffcc0257582549/spectrum/1040g0k031gl1ktm7j80g5oakffv0j2cojt7l6q0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102343/2de8307763f253e3b3cbbb6bbbd2b93c/spectrum/1040g0k031gl1ktm7j8105oakffv0j2coboka3co!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,盯学,暑假,自律学习', 'last_modify_ts': 1773157434461, 'note_url': 'https://www.xiaohongshu.com/explore/680994f5000000001d009b84?xsec_token=ABuTeg-y02O_coiO5uIALyNrP-u19zx6EfaFmVH8ih7Oo=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABuTeg-y02O_coiO5uIALyNrP-u19zx6EfaFmVH8ih7Oo='}
