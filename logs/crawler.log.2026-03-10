2026-03-10 21:43:53 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69afb9fe0000000022022357', 'type': 'normal', 'title': '平行线数学思维春季拔高班！限时15/课时啦', 'desc': '平行线浅奥春季班开课啦！\n快来试试平行线 下学期轻松逆袭！低至15元/课时，120/月\n⛄️新学期来平行线的孩子，悄悄变了样\n✔ 思路清晰了，会主动画图、拆解题目\n✔ 专注力提升，能坚持完成90-120分钟ke堂\n✔ 不再依赖家长讲题，遇到不会的会自己先琢磨\n✔题目换个题型也不慌了，举一反三的能力到位了\n🥰在平行线上课有多省心？\n🌟课程干货拉满，不搞虚的！\n✅紧扣新ke标，基础+浅奥拓展\n👉🏻不用怕学的内容跟校内脱节！老师讲的知识点全是ke本的重难点，还会延伸浅奥内容做拓展，慢慢培养理科思维，为以后L1-L8的学习打基础\n✅不教死答案，只练“活思维”！\n👉🏻平行线不教答案，而是带着孩子用不同模型解同一道题，练的是解题迁移力和思维灵活性，遇到新题也能举一反三，不再慌\n✅节奏超友好，学习休息两不误！\n👉🏻每周一次，每次2节课，，每节课90-120分钟，既不让知识点断档，又不会给孩子堆压力，多余时间还能玩能休息\n🔥新学期，给孩子一次“开窍”的机会\n👇🏻点击【立即咨询】测测孩子的数学思维在哪一关\n仅面向32岁家长\n\t\n#平行线教育[话题]#   #数学思维[话题]#   #数学素养[话题]#     #平行线1440年课[话题]#   #家长必看[话题]#  #浅奥思维[话题]#   #奥数思维[话题]#', 'video_url': '', 'time': 1773124094000, 'last_update_time': 1773124094000, 'user_id': '642ba9780000000012011a80', 'nickname': '平行线名师大课堂', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/f0238b56-4bdd-3597-adf3-db36cfdcf315', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102143/b2b1aa2a221313c0d23e0dba865224d0/spectrum/1040g0k031th8kikh5a005p1bl5s4i6k0lro6070!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102143/420bad34fed55c66ade90180a5c7d88b/spectrum/1040g0k031th8kk6el6005p1bl5s4i6k0gh9fdvo!nd_dft_wlteh_webp_3', 'tag_list': '平行线教育,数学思维,数学素养,平行线1440年课,家长必看,浅奥思维,奥数思维', 'last_modify_ts': 1773150233232, 'note_url': 'https://www.xiaohongshu.com/explore/69afb9fe0000000022022357?xsec_token=AB9mya0G5gRV6vHe5UesXJL1rz3vXL7a4ei5AUHwClGlo=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB9mya0G5gRV6vHe5UesXJL1rz3vXL7a4ei5AUHwClGlo='}
