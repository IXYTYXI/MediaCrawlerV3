2026-03-10 23:10:01 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68cbd5f00000000013008cc2', 'type': 'normal', 'title': '跟着高途高中1v1！课内同步学超省心', 'desc': '新学期刚开始，不少高中家长就慌了👇\n▫️ 跟不上学习节奏，越落越多，新学期刚过半就掉队\n▫️ 没规划，学啥全靠 “碰”，全科进度全乱套\n▫️ 没人监督学了等于白学，作业敷衍了事......\n✅ 其实不用愁，高途1v1同步学来救场——定制每日计划、2v1监督伴学、因材施教！\n\t\n🔥 全程高频互动：杜绝走神分心，知识当场消化，强制专注学习\n🔥 边讲边练结合：知识点不落地等于白学，高途让每节都 “学练闭环”！\n🔥 个性化学习方案：基础再薄弱也能追，一步一个脚印稳步提升\n🔥 专属班班督学：全流程控细节，学习弱项实时同步家长\n🔥 系统化学习方案：拆解学习节点，告别盲目刷ti，学习有方向\n\t\n高途1v1定制计划、监督伴学，稳稳走好新学期每一步～\n↙️ 点击【立即咨询】即可领取1v1试听体验\n🙋 报名要求：32岁以上家长\n⏰ 报名时间：即日起 - 2026年12月31日\n#高途[话题]# #高中[话题]# #高中网课[话题]# #一对一[话题]# #课程辅导[话题]# #提高学生学习兴趣[话题]# #学习更高效[话题]# #高效学习[话题]# #学习进步从这里开始[话题]#', 'video_url': '', 'time': 1758242881000, 'last_update_time': 1759890159000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '3', 'collected_count': '2', 'comment_count': '', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102310/691286c4c823e97b6a24a9e3d825d21b/spectrum/1040g34o31n5rdg7sl0105oakffv0j2cohqrdn1g!nd_dft_wlteh_webp_3', 'tag_list': '高途,高中,高中网课,一对一,课程辅导,提高学生学习兴趣,学习更高效,高效学习,学习进步从这里开始', 'last_modify_ts': 1773155401731, 'note_url': 'https://www.xiaohongshu.com/explore/68cbd5f00000000013008cc2?xsec_token=AB9sTCtm4Daj6bt08gAFf3LO0WE_mESl76Gbqny-wb6mY=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB9sTCtm4Daj6bt08gAFf3LO0WE_mESl76Gbqny-wb6mY='}
