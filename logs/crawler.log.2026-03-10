2026-03-10 21:12:40 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69ab9f820000000015039c06', 'type': 'video', 'title': '三年级普娃别愁，新加坡数学来拯救👊', 'desc': '家有三年级普娃，数学跟不上、做题没思路、越学越抵触？\n\t\n💥别慌！Mathplore新加坡数学思维，专为5-12岁孩子量身打造，精准适配三年级孩子的认知节奏，帮娃轻松突破数学瓶颈，越学越自信！\n\t\n👉一周仅需两次课，不用费妈，就能让娃的数学能力稳步飙升～\n\t\nMathplore自创G0-G6七阶课程体系，贴合孩子认知发展规律，尤其适配各阶段普娃的学习痛点\n\t\n🚀 新加坡数学王牌优势，专为普娃量身定制\n✅ 2-6人小班直播：名师面对面授课，实时答疑解惑，每个孩子都能被关注，问题不堆积、不过夜\n\t\n✅ CPA教学法\n从具象到抽象，循序渐进培养孩子的逻辑思维和解题能力，让孩子学会主动思考\n\t\n✅ 趣味化教学\n融入动画和游戏化设计，打破数学枯燥感，让普娃主动爱上数学，告别“畏难情绪”\n\t\n✅ 专业师资团队\n名校毕业，深谙小阶数学难点，更懂孩子的学习心理，因材施教更高效\n\t\n✅ 中/英授课语言可选\n让孩子在提升数学思维的同时，同步锻炼英语能力\n\t\n🔥 专属福利来袭，助力普娃逆袭\n\t\n现在点击咨询，即可0元领取价值1888元的数学学习大礼包！\n\t\n⏰活动时间：即日起至2028年12月31日\n*面向18＋海外家长群体\n\t\n#Mathplore新加坡数学[话题]#  #Mathplore[话题]#  #新加坡数学[话题]#  #数学思维[话题]#  #小学数学[话题]#  #数学学习[话题]#  #学习规划[话题]#  #小学数学怎么学[话题]#  #小学数学思维训练[话题]#  #小学数学学习方法[话题]#', 'video_url': 'http://sns-video-al.xhscdn.com/stream/1/110/259/01e9ab9f58c5a6f9010370039cc6673059_259.mp4', 'time': 1772855170000, 'last_update_time': 1772855170000, 'user_id': '6504601f0000000017021a03', 'nickname': 'Mathplore数学思维', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/e6f9e621-2070-3494-bab8-b0f3f41001c0', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '四川', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102112/5133a9458893290b066184cf3cf4427a/spectrum/1040g34o31td9e7srl8105p84c0fls6g3k6eh0c0!nd_dft_wlteh_webp_3', 'tag_list': 'Mathplore新加坡数学,Mathplore,新加坡数学,数学思维,小学数学,数学学习,学习规划,小学数学怎么学,小学数学思维训练,小学数学学习方法', 'last_modify_ts': 1773148360913, 'note_url': 'https://www.xiaohongshu.com/explore/69ab9f820000000015039c06?xsec_token=ABZNdBl2gDwQzwN9c2YjfyO8dOCCMer5gCgrL8BdqMfH4=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABZNdBl2gDwQzwN9c2YjfyO8dOCCMer5gCgrL8BdqMfH4='}
