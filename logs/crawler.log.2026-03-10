2026-03-10 22:46:59 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69735275000000002103e6ed', 'type': 'normal', 'title': '高途高中1人1班寒假招生中🔥全基础适配', 'desc': '👀 家有高中生的家长速看！高途高中1人1班寒假招生开启\n✨ 时间灵活定制不管是零基础补漏、中等生拔高，还是尖子生冲刺，任何基础都能学！\n高中数学/物理/化学/英语/地理/生物\n🏃 寒假想同步校内、专项拔高、为高考逆袭蓄力的，这门课直接闭眼冲～\n\t\n✅ 寒假三大核心需求！一站式搞定：\n✔️ 同步校内学：紧跟学校进度，查漏补缺，避免假期脱节，巩固核心知识点；\n✔️ 寒假想拔高：突破学习瓶颈，专攻中档题、难题，梳理答题技巧，实现分数跃升；\n✔️ 高考想逆袭：趁寒假夯实基础、优化复习节奏，为后续冲刺筑牢根基，抢占先机；\n\t\n✅ 高途专属保障！放心选不踩坑\n✔️ 严选名师团队：6轮严选名校毕业学霸讲师持证上岗，擅长拆解难点，不满意可随时更换；\n✔️ 时间灵活定制：不用迁就固定课时，寒假每天任意时段可选，家长省心、孩子高效；\n\t\n高途全程定制规划、跟盯答疑，适配全基础、全需求，助力孩子寒假逆袭～\n感兴趣的家长可以点击【立即咨询】领取1v1试学名额～\n📝 报名要求：仅面向32岁以上家长\n📆 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #寒假班[话题]# #学习规划[话题]# #课程辅导[话题]# #高效学习[话题]# #线上课[话题]##高中数学[话题]#', 'video_url': '', 'time': 1769217061000, 'last_update_time': 1769824001000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '1', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102246/820b90f8d026339b8ac41654c5c1698c/spectrum/1040g34o31rma0t0mi8105oakffv0j2co62kegeo!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,寒假班,学习规划,课程辅导,高效学习,线上课,高中数学', 'last_modify_ts': 1773154019623, 'note_url': 'https://www.xiaohongshu.com/explore/69735275000000002103e6ed?xsec_token=ABAMvHMgwEIWkL4U1rB_4n0voiySOlhIf7A3A-niQ-Cz8=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABAMvHMgwEIWkL4U1rB_4n0voiySOlhIf7A3A-niQ-Cz8='}
