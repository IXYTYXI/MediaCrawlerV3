2026-03-10 23:57:47 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6795abb500000000180133a3', 'type': 'normal', 'title': '一对一追着学‼️新学期直接逆袭成学霸🥰', 'desc': '各位家长是否有这种烦恼👉孩子的成ji一直不上不下\n月考期末接连失利💔一学期拼尽全力，结果还是在班级中游徘徊...\n孩子自己也着急缺没有学习方法\n-\n👀 试试👉高途1v1线上网课，让孩子新学期逆风翻盘💪\n🔥 名师亲自上阵，帮娃梳理知识点，突破重难点☑️\n✔️ 还传授解题思路、做题方法，让孩子举一反三，轻松应对各种题型！\n-\n✅ 跟着高途1对1网课学，时间自由，在家就能上课；\n🧑\u200d🏫 上课形式还是面对面直播，和上线下课一模一样；\n💻 课前课后，老师都会点名回答问题，让孩子想走神都难！\n-\n📈 学习之前，还有摸底测试，帮孩子找出薄弱环节，然后针对性辅导；\n💁 课下的练习也是1对1批改，及时反馈，让孩子及时纠正错误；\n✨ 适合你家孩子专属学习计划，根据学习进度量身定制，进步看得见！\n-\n现在点击⬇【立即咨询】还能抢占试听名额\n🉐1v1学情分析➕1v1学习方案➕学习资料\n领取时间：即日起—2025年12月31日\n报名要求：32岁以上家长\n\ufeff#高途[话题]#\ufeff\xa0\ufeff#一对一[话题]#\ufeff\xa0\ufeff#网课[话题]#\ufeff\xa0\ufeff#伴学[话题]#\ufeff\ufeff', 'video_url': '', 'time': 1737862069000, 'last_update_time': 1745371973000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '1', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102357/3c074da958b8f423080e38de6201ea50/spectrum/1040g0k031d3re2kd0e005oakffv0j2coccu1mbg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102357/ef7d48bf2e8ff82aa4e5fdc08aa840eb/spectrum/1040g0k031d3re2kd0e0g5oakffv0j2cohdds150!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102357/0c1a198174195035636363418e018457/spectrum/1040g0k031d3re2kd0e105oakffv0j2cofnm4l40!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,伴学', 'last_modify_ts': 1773158267656, 'note_url': 'https://www.xiaohongshu.com/explore/6795abb500000000180133a3?xsec_token=ABQUnlCtEpQbD_Kh2Sm_0cefPbhbsShUsA_OuZF32KkO0=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABQUnlCtEpQbD_Kh2Sm_0cefPbhbsShUsA_OuZF32KkO0='}
