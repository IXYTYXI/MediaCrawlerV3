2026-03-10 23:44:20 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '680993fd000000001b03e1de', 'type': 'normal', 'title': '🔥暑假别摆烂！ 跟高途高中1对1自律', 'desc': '各位家长请注意\n👉🏻 暑假在家不是玩手机就是躺平，作业拖到最后一晚\n👉🏻 报线下ke？接送太麻烦，上课还走神\n👉🏻 自己教血压飙升，不会更管不住……\n别焦虑！高途高中1对1，专治暑假摆烂！\n🈶 全方位开展服务，巩固知识点，不留知识死角；\n🈶 在家就可以享受优质的教育资源，家长还可随时了解学习进度！\n-\n📣 选择高途，暑假不摆烂～先人一步\n快快点击左下角【立即咨询】👇抢先加入暑假训练\n⏰ 截止时间：即日起至25年9月1日\n\ufeff#高途[话题]#\ufeff\xa0\xa0\xa0\xa0\xa0\xa0\ufeff#一对一[话题]#\ufeff\xa0\xa0\xa0\xa0\xa0\xa0\ufeff#暑假[话题]#\ufeff\xa0\xa0\xa0\xa0\xa0\xa0\ufeff#提前学[话题]#\ufeff \ufeff#高中[话题]#\ufeff', 'video_url': '', 'time': 1745458173000, 'last_update_time': 1745976026000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '4', 'collected_count': '7', 'comment_count': '', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102344/e2e0a63148ec9066df7e6f77280fabd3/spectrum/1040g34o31gl8t5rnj81g5oakffv0j2coc4io9vg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102344/813df3aa1bc3ee5ccf4b39a1936a8ad4/spectrum/1040g34o31gl8t5rnj8205oakffv0j2cohh0kh3o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102344/276605d8caa61def28f492f5758492b2/spectrum/1040g34o31gl8t5rnj82g5oakffv0j2co6l0efb0!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,暑假,提前学,高中', 'last_modify_ts': 1773157460902, 'note_url': 'https://www.xiaohongshu.com/explore/680993fd000000001b03e1de?xsec_token=ABuTeg-y02O_coiO5uIALyNvbw_tfN3ifDVIZBGFn11R4=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABuTeg-y02O_coiO5uIALyNvbw_tfN3ifDVIZBGFn11R4='}
