2026-03-10 23:40:48 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '681ab91e000000002202b97e', 'type': 'normal', 'title': '真香❗️跟1v1辅导学1小时＞自学7天', 'desc': '📢 各位高中生是不是也这样？\n🤷 刷题到凌晨，成绩却不见起色\n🤷 上课听懂了，做题还是不会\n🤷 数理化越学越吃力，差距越拉越大\n🤷 时间总是不够用，效率低到怀疑人生\n\t\n💡 别让低效学习毁了你的重本梦！高途1v1专业辅导，用科学方法让你告别无效努力，直线飙升！\n✅ 多轮严选名校学霸优秀主讲，教学经验丰富；\n✅ 因材施教，定位问题及薄弱点，覆盖全科知识点；\n✅ 课前中后全方位开展服务，巩固知识点；\n✅ 在家就可以享受优质的教育资源，定期家长会，还可随时了解学习进度！\n\t\n点击⬇【立即咨询】获取名师专属1v1指导+专属试听名额\n🌈名额有限，先到先得！\n报名要求：32岁以上家长\n截止时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#高中[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff', 'video_url': '', 'time': 1746597639000, 'last_update_time': 1746581791000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102340/64085315caeac580a6684d8422fc1924/spectrum/1040g0k031h5pa9raj8005oakffv0j2cosjhjvf8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102340/7f76554435a564e1643fb9b88eb65f3e/spectrum/1040g0k031h5pa9raj80g5oakffv0j2co7olkra0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102340/642cf61eafb9700f3e0bd54d09fd39ee/spectrum/1040g0k031h5pa9raj8105oakffv0j2coqborq78!nd_dft_wlteh_webp_3', 'tag_list': '高途,高中,一对一,网课', 'last_modify_ts': 1773157248048, 'note_url': 'https://www.xiaohongshu.com/explore/681ab91e000000002202b97e?xsec_token=ABvCvu4VdZPq1kCumVVAhSgX-fMOghIiu7h9tpbP6nNpE=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABvCvu4VdZPq1kCumVVAhSgX-fMOghIiu7h9tpbP6nNpE='}
