2026-03-10 23:50:23 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67e7db90000000001200d1a2', 'type': 'normal', 'title': '高途一对一7天规划突破数学困境❓', 'desc': '各位家长，你家学生是否也面临这些问题？\n❌ 数理公式背了又忘，题目一变就懵\n❌ 刷题无数，分数却原地踏步\n❌ 上课能听懂，考试就崩溃\n-\n高途一对一来帮忙，名师带着突破数理困境\n【为什么选择高途1V1？】\n✅ 精准学情诊断：专业测试找出薄弱环节，直击痛点\n✅ 定制学习方案：名师1对1制定专属学习计划，哪里不会补哪里\n✅ 高效解题技巧：传授秒.杀公式，📈解题速度\n✅ 保姆式托管：专属班班全程陪伴式跟进，学习有保障\n-\n点击左下方【立即咨询】定制专属课程\n🉐 根据需求定制课程，适合任何基础\n🉐 线上直播课，3年内无限次回放\n🉐 可只购买专题课程，专项提升\n🉐 真名师，经过6轮严选，持证上岗\n🉐 海量题库免费提供+心理辅导\n报名对象：仅面向32岁以上家长\n活动时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#数理[话题]#\ufeff \ufeff#开窍[话题]#\ufeff', 'video_url': '', 'time': 1743302281000, 'last_update_time': 1743248273000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '26', 'collected_count': '8', 'comment_count': '', 'share_count': '2', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102350/bc6569ecdd8617e0894502447434c28d/spectrum/1040g34o31fk3or8dne1g5oakffv0j2co1jmjsb0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102350/6bb7ab10f578abbac9bc3856229fd1fa/spectrum/1040g34o31fk3or8dne205oakffv0j2coq6j3neg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102350/0515eec6d4696e896cb2b2e99c275e88/spectrum/1040g34o31fk3or8dne2g5oakffv0j2cojtmndu0!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,数理,开窍', 'last_modify_ts': 1773157823636, 'note_url': 'https://www.xiaohongshu.com/explore/67e7db90000000001200d1a2?xsec_token=AB2HzCtE9kOASgLwGM3rGQskMJ_liXs9iQtFiKejeZtdQ=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB2HzCtE9kOASgLwGM3rGQskMJ_liXs9iQtFiKejeZtdQ='}
