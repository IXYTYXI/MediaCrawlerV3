2026-03-10 18:20:12 MediaCrawler INFO (__init__.py:234) - [store.xhs.update_xhs_note_comment] xhs note comment:{'comment_id': '6881d8d70000000002006063', 'create_time': 1753340119000, 'ip_location': '浙江', 'note_id': '68803682000000001301285f', 'note_title': '二升三提前学', 'content': '我们5升六，也就每天口算，和洋葱预习，', 'user_id': '624451be000000001000bed1', 'nickname': '硕妈户外', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/624451be000000001000bed1.jpg?imageView2/2/w/120/format/jpg', 'sub_comment_count': 0, 'pictures': '', 'parent_comment_id': '68809ee70000000009015ee4', 'last_modify_ts': 1773138012580, 'like_count': '0'}
2026-03-10 18:20:12 MediaCrawler INFO (__init__.py:234) - [store.xhs.update_xhs_note_comment] xhs note comment:{'comment_id': '68823ee1000000001901efd7', 'create_time': 1753366242000, 'ip_location': '河北', 'note_id': '68803682000000001301285f', 'note_title': '二升三提前学', 'content': '我家一升二，现在让孩子预习二上感觉孩子不愿意学，没有你家那么多激情。', 'user_id': '5c04b8016b58b756305ec324', 'nickname': '小红薯_4720', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31sofsaejm8604bupkbs03gp4ngr69gg?imageView2/2/w/120/format/jpg', 'sub_comment_count': 0, 'pictures': '', 'parent_comment_id': '6880b7f6000000000200629f', 'last_modify_ts': 1773138012600, 'like_count': '0'}
2026-03-10 18:20:18 MediaCrawler INFO (__init__.py:234) - [store.xhs.update_xhs_note_comment] xhs note comment:{'comment_id': '6882e46e000000001a02dbb8', 'create_time': 1753408622000, 'ip_location': '广东', 'note_id': '68803682000000001301285f', 'note_title': '二升三提前学', 'content': '我们都是考完就先去玩一趟，互相约定好了', 'user_id': '5a5e1bdb11be101a653636d5', 'nickname': '小可爱', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31l5rgihqj2004a0snsdtmdmlm16rpf8?imageView2/2/w/120/format/jpg', 'sub_comment_count': 0, 'pictures': '', 'parent_comment_id': '68823ee1000000001901efd7', 'last_modify_ts': 1773138018061, 'like_count': '0'}
2026-03-10 18:20:18 MediaCrawler INFO (__init__.py:234) - [store.xhs.update_xhs_note_comment] xhs note comment:{'comment_id': '68889cce00000000290370f6', 'create_time': 1753783503000, 'ip_location': '黑龙江', 'note_id': '68803682000000001301285f', 'note_title': '二升三提前学', 'content': '姐妹，你家奥数时间长会不会忘记一些学过的题型？你们会重复练习吗', 'user_id': '5922853a50c4b43def293acd', 'nickname': '绚丽的草莓', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31tfkfovqls0049h2b32jkemdhgep47g?imageView2/2/w/120/format/jpg', 'sub_comment_count': 0, 'pictures': '', 'parent_comment_id': '6880b7f6000000000200629f', 'last_modify_ts': 1773138018083, 'like_count': '0'}
2026-03-10 18:20:18 MediaCrawler INFO (__init__.py:234) - [store.xhs.update_xhs_note_comment] xhs note comment:{'comment_id': '688c4cfb000000002903383f', 'create_time': 1754025211000, 'ip_location': '辽宁', 'note_id': '68803682000000001301285f', 'note_title': '二升三提前学', 'content': '我家是三升四，然后假期做的四上的学霸。提前学我跟您是一个路线，洋葱+53，也是进度不快，现在是到五下，不做题吧，是快，但是不做又不行，至今我也没摸索出啥好办法[哭惹R]', 'user_id': '556d6939e4b1cf265ac24f2d', 'nickname': 'ゞ三三-✨', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/556d6939e4b1cf265ac24f2d.jpg?imageView2/2/w/120/format/jpg', 'sub_comment_count': 0, 'pictures': '', 'parent_comment_id': '68809ee70000000009015ee4', 'last_modify_ts': 1773138018103, 'like_count': '1'}
2026-03-10 18:20:18 MediaCrawler INFO (__init__.py:234) - [store.xhs.update_xhs_note_comment] xhs note comment:{'comment_id': '688c5bb50000000029036198', 'create_time': 1754028982000, 'ip_location': '湖南', 'note_id': '68803682000000001301285f', 'note_title': '二升三提前学', 'content': '我们都没时间做学霸的。', 'user_id': '58fa25366a6a694d38ee6069', 'nickname': '知一老师带普娃～', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31bvohk5n0u5g49dvqhijco39d71kqo0?imageView2/2/w/120/format/jpg', 'sub_comment_count': 0, 'pictures': '', 'parent_comment_id': '688c4cfb000000002903383f', 'last_modify_ts': 1773138018124, 'like_count': '0'}
2026-03-10 18:20:18 MediaCrawler INFO (__init__.py:234) - [store.xhs.update_xhs_note_comment] xhs note comment:{'comment_id': '688c5de10000000029025354', 'create_time': 1754029538000, 'ip_location': '辽宁', 'note_id': '68803682000000001301285f', 'note_title': '二升三提前学', 'content': '我们是先保课内。假期把下学期的五星学霸做完，开学基本不管课内了。我基本开学以后超前学，我估计八月初学霸能结束，准备继续弄三导，希望能按照计划来吧[偷笑R]我看大伙儿评论，觉得先做题，遇到不会的再看洋葱或者自己看教材全解，这样效率也许能高点儿，共勉，继续努力[飞吻R]', 'user_id': '556d6939e4b1cf265ac24f2d', 'nickname': 'ゞ三三-✨', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/556d6939e4b1cf265ac24f2d.jpg?imageView2/2/w/120/format/jpg', 'sub_comment_count': 0, 'pictures': '', 'parent_comment_id': '688c5bb50000000029036198', 'last_modify_ts': 1773138018143, 'like_count': '3'}
2026-03-10 18:20:24 MediaCrawler INFO (__init__.py:234) - [store.xhs.update_xhs_note_comment] xhs note comment:{'comment_id': '688c5ea00000000029032001', 'create_time': 1754029729000, 'ip_location': '湖南', 'note_id': '68803682000000001301285f', 'note_title': '二升三提前学', 'content': '是的，可以。我打算让她自己看教材。', 'user_id': '58fa25366a6a694d38ee6069', 'nickname': '知一老师带普娃～', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31bvohk5n0u5g49dvqhijco39d71kqo0?imageView2/2/w/120/format/jpg', 'sub_comment_count': 0, 'pictures': '', 'parent_comment_id': '688c5de10000000029025354', 'last_modify_ts': 1773138024142, 'like_count': '0'}
