2026-03-10 16:06:06 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67ea454e000000001c029224', 'type': 'video', 'title': '小学数学超前学三本练习册详评❗️难度比较✅', 'desc': '我们一直用《学霸》超前学习数学，但是做到三年级发现它变简单了，所以又入了两本浅奥，和大家分析一下它们的难度，还有分别适合什么样的孩子？\n#00:19[时刻]# 一、《学霸》超前学\n#01:25[时刻]# 二、视频讲解浅奥《七星学霸》\n#02:03[时刻]# 三、《高思导引》奥数试水\n#这就是数学[话题]# #教辅推荐[话题]# #数学学习[话题]# #生活中数学[话题]# #小学数学[话题]# #数学思维[话题]#', 'video_url': 'http://sns-video-hs.xhscdn.com/stream/1/110/259/01e7ea45130e858e0103700395eb216ab3_259.mp4', 'time': 1743406414000, 'last_update_time': 1743406415000, 'user_id': '5688680bcb35fb35029c1761', 'nickname': '我家小二咪', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/59db168614de412365ea3326.jpg', 'liked_count': '386', 'collected_count': '438', 'comment_count': '29', 'share_count': '60', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603101558/2abcf66726ee37d783649f16052b0e68/1040g00831fmf6h597e0044v8ugk0m5r1c2u66jo!nd_dft_wlteh_webp_3', 'tag_list': '这就是数学,教辅推荐,数学学习,生活中数学,小学数学,数学思维', 'last_modify_ts': 1773129966978, 'note_url': 'https://www.xiaohongshu.com/explore/67ea454e000000001c029224?xsec_token=ABAdpre-bc1f4jEzXL19X8ihd4pgVmc4pE7eSwGkwz9v0=&xsec_source=pc_search', 'source_keyword': '数学超前学', 'xsec_token': 'ABAdpre-bc1f4jEzXL19X8ihd4pgVmc4pE7eSwGkwz9v0='}
