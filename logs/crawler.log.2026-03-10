2026-03-10 16:06:40 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68b2dc21000000001d018232', 'type': 'normal', 'title': '哪位学霸家长帮忙指导一下数学到底怎么超前学呢？都说小学毕业就得学完初一或者初二的内容，我们四年级，应该怎么学呢？提前把课内学完吗？那上课干嘛？', 'desc': '哪位学霸家长帮忙指导一下数学到底怎么超前学呢？都说小学毕业就得学完初一或者初二的内容，我们四年级，应该怎么学呢？提前把课内学完吗？那上课干嘛？', 'video_url': '', 'time': 1756552225000, 'last_update_time': 1756552226000, 'user_id': '5a8a8465e8ac2b23997491e7', 'nickname': '小宝妈妈', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/5a8a84a8d1d3b96b8a59faa0.jpg', 'liked_count': '302', 'collected_count': '488', 'comment_count': '264', 'share_count': '42', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603101559/63f39ac7b0be224f3d7531dc256eb81a/1040g00831lqbi06458704a1jn026b4f7bnk494o!nd_dft_wlteh_webp_3', 'tag_list': '', 'last_modify_ts': 1773130000641, 'note_url': 'https://www.xiaohongshu.com/explore/68b2dc21000000001d018232?xsec_token=AB8faH6ozj6iC8SfL2aIiZ1dKZiP-xq75ot41O1c3zPU8=&xsec_source=pc_search', 'source_keyword': '数学超前学', 'xsec_token': 'AB8faH6ozj6iC8SfL2aIiZ1dKZiP-xq75ot41O1c3zPU8='}
