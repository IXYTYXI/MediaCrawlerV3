2026-03-10 16:08:49 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67d287ee000000001d018803', 'type': 'normal', 'title': '提前学初中，怎么搞？', 'desc': '小学提前学\n初中数学\n自学？报班？求推荐！\n#学习[话题]# #初中数学[话题]#', 'video_url': '', 'time': 1741850606000, 'last_update_time': 1741850606000, 'user_id': '5610d27b8a75e12b34d3a094', 'nickname': '陪萱姐长大', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31ebtn8ej0m0041b11497n84kn0oqfq8', 'liked_count': '69', 'collected_count': '91', 'comment_count': '147', 'share_count': '8', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603101603/aae737776d2704a3ef8654245fd96477/notes_pre_post/1040g3k831ev99mtimi7041b11497n84kj7mnlr8!nd_dft_wlteh_webp_3', 'tag_list': '学习,初中数学', 'last_modify_ts': 1773130129534, 'note_url': 'https://www.xiaohongshu.com/explore/67d287ee000000001d018803?xsec_token=ABlB2xmKKm0PGFsg0mOlM7q4ZEC8q1p6Px8SF1igQdKe0=&xsec_source=pc_search', 'source_keyword': '数学超前学', 'xsec_token': 'ABlB2xmKKm0PGFsg0mOlM7q4ZEC8q1p6Px8SF1igQdKe0='}
