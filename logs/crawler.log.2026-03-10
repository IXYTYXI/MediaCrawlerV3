2026-03-10 23:10:44 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68c4cc29000000001c031fe5', 'type': 'normal', 'title': '学习没人盯？高途高中1v1真人带学超负责', 'desc': '高中找辅导，最怕 “学了等于没学”\n上ke没人带，知识点学不透\n报了班却没人监督，作业拖拉、上ke走神，成ji不见涨…\n直到试了高途高中1v1，真人老师带学+全程督学，才知道负责的辅导有多省心！\n\t\n👉 👉 高途1v1：真人带学 + 全程督学，负责到每一步\n▫️ 定制学习规划，目标清晰：先做学情测评，找出薄弱项，每周、每月都有明确学习目标，避免盲目刷题；\n▫️ 真人1v1带学，难点当场吃透：不是录播！没听懂就反复讲，学一个会一个；\n▫️ 专属督学全程盯，不用家长催：配专属班班，从上ke到作业全程盯，想偷懒都没机会；\n▫️ 疑问随时解，不堆积：遇到疑问都能随时找督学或主讲🧑\u200d🏫，不用等、不拖延，疑问当天清；\n\t\n高途帮高中生扫清学习障碍，学得省心、家长放心～\n↙️ 点击【立即咨询】抢先体验1v1试学名额\n🙋 报名要求：仅面向32岁以上家长\n⏰ 活动时间：即日起-25年12月31日\n#高途[话题]# #高中[话题]# #高中生[话题]# #高中网课[话题]# #一对一[话题]#  #学习规划[话题]# #弯道超车[话题]# #高效学习[话题]# #学习干货[话题]#', 'video_url': '', 'time': 1757757362000, 'last_update_time': 1759810306000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '2', 'collected_count': '1', 'comment_count': '2', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102310/9bb07b82907e0fd8e6d2f04194c6f576/spectrum/1040g34o31n5kl8qlku105oakffv0j2co8qpd9gg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102310/efb421e21db073984d4917ec5f1de6bc/spectrum/1040g0k031mbs4lup500g5oakffv0j2cootesbpg!nd_dft_wlteh_webp_3', 'tag_list': '高途,高中,高中生,高中网课,一对一,学习规划,弯道超车,高效学习,学习干货', 'last_modify_ts': 1773155444075, 'note_url': 'https://www.xiaohongshu.com/explore/68c4cc29000000001c031fe5?xsec_token=ABMURaXv7JX3vOU4j2bgAE2kvhx69SKSYBd7AQwahXfzY=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABMURaXv7JX3vOU4j2bgAE2kvhx69SKSYBd7AQwahXfzY='}
