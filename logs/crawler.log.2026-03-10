2026-03-10 23:40:35 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '681ab9eb0000000021000d18', 'type': 'normal', 'title': '偏科学不会❓选高途一对一妥妥逆袭', 'desc': '😮\u200d💨 数学：公式背了但不会用，考试全靠蒙\n😮\u200d💨 英语：单词记不住，阅读永远错一半\n😮\u200d💨 物理：大题无从下手，只会写个"解"\n\t\n💡【高途1对1严选好老师，专补薄弱项，真教真会】\n✅ 双一流名校毕业，6轮筛选持证上岗，多年带教经验，大招秘籍传授\n\t\n💡 【闭环学习体系助力】\n✅ 课前：1v1课前测评，定制专属学习课件，专项加强，学习效率 👏\n✅ 课中：1v1直播实时互动，传授各个题型底层逻辑和答题思路👍\n✅ 课后：一课一练+定期阶段性测试，实时检验学习成果，查漏补缺\n\t\n💡 【贴心服务】\n✅ 点对点沟通，摸底测试了解问题\n✅ 制定学习目标，专属规划师给孩子做专属规划\n✅ 全程督学，主讲老师直播，辅导老师课后答疑\n\t\n家长们现在点击左下角【立即咨询】👇抢占专属试听名额\n💬 报名要求：仅面向32岁以上家长\n⏰ 截止时间：即日起至25年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#高中[话题]#\ufeff \ufeff#名师[话题]#\ufeff', 'video_url': '', 'time': 1746666054000, 'last_update_time': 1746581995000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '8', 'collected_count': '2', 'comment_count': '1', 'share_count': '3', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102340/f9f423e0ab2ed20aa3fe24185321e7db/spectrum/1040g0k031h5pc51lj8005oakffv0j2co47do3to!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102340/a5fee90b1b8f17bf70ba42f447e97722/spectrum/1040g0k031h5pc51lj80g5oakffv0j2co2l80t78!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中,名师', 'last_modify_ts': 1773157235599, 'note_url': 'https://www.xiaohongshu.com/explore/681ab9eb0000000021000d18?xsec_token=ABvCvu4VdZPq1kCumVVAhSgSTT_7SUMUgV9Sn43dJevYM=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABvCvu4VdZPq1kCumVVAhSgSTT_7SUMUgV9Sn43dJevYM='}
