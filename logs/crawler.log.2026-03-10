2026-03-10 23:55:09 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67b83700000000000b015e53', 'type': 'normal', 'title': '百天冲刺❗️高途一对一网课负责到出分', 'desc': '家长们有没有发现，孩子上了9阶之后分级严重\n差距就像被放大镜照过一样，越来越明显\n如果没有科学有效的学习规划，继续让孩子自己挣扎肯定不行\n-\n👏 想要孩子冲刺重点高中重点班，高途一对一网课来帮忙\n针对性强👍上课时间自由选择👍上课内容定制化👍\n-\n🈶 专属学情分析，针对性的辅导提升，学习更有针对性\n🈶 定制专属学习规划，确保每一阶段都有明确的目标和方向\n🈶 系统梳理知识点，形成完整的知识体系，重难点的突破\n🈶 名师传授解题技巧，讲解解题思路和技巧，提升解题速度和准确度\n🈶 随时在线答疑解惑，解决疑难杂症，不留知识死角\n🈶 及时的反馈与调整，及时调整学习计划，确保每一步都走得稳扎稳打\n-\n📢现在点击⬇【立即咨询】领取专属试听特权\n还能🉐1对1专业辅导+定制专属计划+学习资料\n📝报名要求：32岁以上家长\n📅截止时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff\xa0\ufeff#一对一[话题]#\ufeff\xa0\ufeff#网课[话题]#\ufeff\xa0\ufeff#百天冲刺[话题]#\ufeff\ufeff', 'video_url': '', 'time': 1740125952000, 'last_update_time': 1742539504000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '2', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102355/ac07af7fa72f98e28df4607f4014fef5/spectrum/1040g0k031e5irk8uh6005oakffv0j2co35o8fno!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102355/e2c9a4b4524eaf8d170304bc41deb236/spectrum/1040g34o31f9hqdnnls0g5oakffv0j2co4daf05o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102355/187769c76bcfcafc9e611c9d2f95f702/spectrum/1040g0k031e5irk8uh6105oakffv0j2co17ivvt8!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,百天冲刺', 'last_modify_ts': 1773158109219, 'note_url': 'https://www.xiaohongshu.com/explore/67b83700000000000b015e53?xsec_token=ABnq4Tgrl6AInMyejjBjJfNNipqQK3OeceyAwPrC7KDEU=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABnq4Tgrl6AInMyejjBjJfNNipqQK3OeceyAwPrC7KDEU='}
