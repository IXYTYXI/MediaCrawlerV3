2026-03-10 21:51:29 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69ae860d00000000150214da', 'type': 'normal', 'title': '数学基础越薄弱越香！1v1狠狠补漏洞👍', 'desc': '高中数学一直不及格，是不是都卡在这几处？\n❌刷再多题目，成绩还是上不去，越学越没信心\n❌基础知识点不牢固，公式记不住，做题全靠猜\n❌题型一变就不会，越学越焦虑，越考越害怕\n.\n别再让孩子独自硬扛了！🙅\u200d♀️\n专为数学不及格、基础薄弱的同学量身打造\n👉【掌门一对一高中数学网课】\n专注打牢基础，一步一步帮孩子把漏洞补扎实📚\n.\n为什么一定要选【掌门一对一高中数学网课】✨\n专业老师带学，思路讲得明白🎯\n老师拥有多年高中数学教学经验，熟悉教材与考点，用孩子听得懂的方式讲解。从概念到例题，一步步拆解，不跳步骤、不赶进度，基础再弱的孩子，也能跟上、听懂、真正学会\n.\n一对一上课，跟着孩子节奏走📝\n全程一对一教学，不跟大班、不被别人进度拖着走。\n哪里薄弱就重点讲哪里，不赶、不催、不糊弄，慢慢把落下的内容一点点补回来，学起来更踏实\n.\n全程陪伴学习，疑问及时解答🤝\n课上认真教，课下也能及时帮孩子解决问题。有不懂的地方不用憋着、不用硬扛，有人带着学、陪着练，孩子不孤单，家长更放心\n.\n现在报名，专属福利限时领🎁\n点击咨询即可0元体验一对一试听课\n还能获得学情了解+学习规划+学习资料📖\n.\n⏰福利截止：即日起—2026年12月31日\n🎯适合人群：面向32岁以上的家长\n#掌门一对一[话题]#  #掌门[话题]#  #掌门1对1[话题]#  #数学逆袭[话题]#  #高中数学[话题]#  #网课推荐[话题]#  #家长必看[话题]#  #高中学习[话题]#  #数学薄弱[话题]#  #网课[话题]#', 'video_url': '', 'time': 1773050494000, 'last_update_time': 1773045261000, 'user_id': '649e933900000000140344d9', 'nickname': '掌门1对1特训营', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/65e0143c21adbc000145da44.jpg', 'liked_count': '1', 'collected_count': '', 'comment_count': '4', 'share_count': '1', 'ip_location': '上海', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102151/4e74a1df9f28fceb2562a984e3989905/spectrum/1040g34o31tg42r0cl6105p4uicsl6h6p14mfrf8!nd_dft_wlteh_webp_3', 'tag_list': '掌门一对一,掌门,掌门1对1,数学逆袭,高中数学,网课推荐,家长必看,高中学习,数学薄弱,网课', 'last_modify_ts': 1773150689423, 'note_url': 'https://www.xiaohongshu.com/explore/69ae860d00000000150214da?xsec_token=AB-w_qzoOURA9QpHihjgrBIAcaRwEVNFCHTUZasn6fc84=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB-w_qzoOURA9QpHihjgrBIAcaRwEVNFCHTUZasn6fc84='}
