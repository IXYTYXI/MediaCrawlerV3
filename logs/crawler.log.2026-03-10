2026-03-10 23:07:50 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68da39a300000000140082b1', 'type': 'normal', 'title': '双师伴学❗️高三1v1陪跑至出分为止', 'desc': '👉 高三备考怕踩坑？\n❌ 盲目刷题：知识点繁杂，无从下手，耗时低效；\n❌ 难点卡壳：无人指导拆解，越学越没信心；\n❌ 缺乏监督：居家复习易懈怠，作业敷衍，进度逐渐落后......\n高途高三1v1陪跑，精准解决上述难点，全程护航复习规划与执行👇\n\t\n👉 1v1陪跑至26高考：3大核心优势托底备考\n✅ 专属提芬方案 + 规划布局：报课先做学情诊断，结合高考目标和薄弱项，定制一轮专属方案 ，每月、每周该学啥都清晰，避免盲目；\n✅ 在线1v1直播 + 双师伴学：深耕高三考点，讲题不跳步；专属班班全程盯学，课前提醒、课后批改作业、有疑问当天答疑；\n✅ 高性价比省成本：相比线下1v1，价格更亲民；包含智能题库、阶段测+模考，不用再额外花钱买资料、报冲刺班！\n\t\n1v1陪跑从规划到监督全到位，还兼顾性价比，冲刺高考少走弯路～\n👇 点击左下角【立即咨询】领取1v1试学名额\n🙋 报名要求：32岁以上家长\n📆 截止时间：即日起-26年12月31日\n#高途[话题]# #高效学习[话题]# #学习更高效[话题]# #高考逆袭[话题]# #高三复习[话题]# #高中网课[话题]# #一轮复习[话题]# #二轮复习[话题]#', 'video_url': '', 'time': 1759369247000, 'last_update_time': 1759542888000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '11', 'collected_count': '5', 'comment_count': '5', 'share_count': '4', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102307/9150e729183cef15753321d279ef6e90/spectrum/1040g0k031n0pnrqgl0005oakffv0j2corvsp0cg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102307/d932a70ce47110cbb8c3c1a57654dd24/spectrum/1040g0k031n0pnrqgl00g5oakffv0j2coopu2f10!nd_dft_wlteh_webp_3', 'tag_list': '高途,高效学习,学习更高效,高考逆袭,高三复习,高中网课,一轮复习,二轮复习', 'last_modify_ts': 1773155270465, 'note_url': 'https://www.xiaohongshu.com/explore/68da39a300000000140082b1?xsec_token=ABnuWM8tUBDTVm0rlQoKRR9jEVoaXJ2ug-R6ffBi53hGA=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABnuWM8tUBDTVm0rlQoKRR9jEVoaXJ2ug-R6ffBi53hGA='}
