2026-03-10 21:42:55 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69afbee4000000002202dfff', 'type': 'normal', 'title': '数理思维全年课❗专为L1-L8中等生家长设置', 'desc': '🎉🎉L1-L8家长注意！平行线教育给大家送福利啦❗\n18年专注数理思维的老牌机构，口碑实打实！\n全年班=1440学一整年（无任何二次收费）\n⚠️为什么敢做到这么低价？\n🎯 18年老牌机构，实力底气足\n🎯 老学员续报率高，口碑说话\n🎯 初心做教育，创始人刘育涛老师曾坚持两年公益直播👍\n💡为什么L1-L8家长都选平行线？\n1️⃣ 清北名师直播互动  根据孩子课堂状态灵活调整深度，录播课根本比不了！\n2️⃣ 完整学习闭环  直播课+月度测评+专项突破，能力稳步提升\n3️⃣ 超高性价比  15元/课时 = 名师授课+全套教材+全年服务，仅为线下1/3\n💡家长一致好评的贴心服务\n✅ 365天真人1V1答疑，拒绝AI机器人\n✅ 8次专业测评报告，清晰掌握学习情况\n✅ 每月12次专项小灶课，6-8人小班复盘，扫清知识漏洞  现在机构五花八门，很容易被营销套路忽悠。 平行线能做18年，靠的是教学质量与真实口碑！\n趁这波内部底价，别犹豫！\n同样的花费，享受几倍的优质资源，超划算！ 每天不到4块钱，给孩子思维真正提升！\n👇👇点击【立即咨询】 添加老师，立即了解详情！\n*仅面向32岁以上家长·\n#数理思维[话题]#  #小学奥数[话题]#  #小学数理[话题]#  #平行线教育[话题]#   #数学思维[话题]#   #数学素养[话题]#     #平行线1440年课[话题]#   #家长必看[话题]#  #浅奥思维[话题]#   #奥数思维[话题]#', 'video_url': '', 'time': 1773125349000, 'last_update_time': 1773136046000, 'user_id': '642ba9780000000012011a80', 'nickname': '平行线名师大课堂', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/f0238b56-4bdd-3597-adf3-db36cfdcf315', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102142/8b81da1fb09556788f8564ffc29d6644/spectrum/1040g0k031tha1nc6l8005p1bl5s4i6k0r0qnhhg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102142/adb63d4cf7a9a40ce249ce807049c1dd/spectrum/1040g0k031tha241d5e005p1bl5s4i6k0nsn88l0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102142/e81530e07df5e1888e00efc396ef7319/spectrum/1040g34o31thfcmfvla1g5p1bl5s4i6k0nni6fj8!nd_dft_wlteh_webp_3', 'tag_list': '数理思维,小学奥数,小学数理,平行线教育,数学思维,数学素养,平行线1440年课,家长必看,浅奥思维,奥数思维', 'last_modify_ts': 1773150175239, 'note_url': 'https://www.xiaohongshu.com/explore/69afbee4000000002202dfff?xsec_token=AB9mya0G5gRV6vHe5UesXJL0Wb2_LIlMS7EmaWMiuIGnU=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB9mya0G5gRV6vHe5UesXJL0Wb2_LIlMS7EmaWMiuIGnU='}
