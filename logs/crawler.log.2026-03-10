2026-03-10 22:49:01 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '696a166e000000000a02e8db', 'type': 'normal', 'title': '高中差生逆袭！1v1寒假私教带你丝滑进阶', 'desc': '是谁还在为高中成绩焦虑？\n学不进去、跟不上进度、一考试就懵？\n别急！差生逆袭计划来了🎯\n✅ 高途1v1名师带学\n严选名校毕业学霸+持证上岗，真人直播互动\n黄大桔、王美乐、闫伟光等名师亲自带\n不满意？随时换老师！\n\t\n✅ 闭环式学习服务\n1v1定制课程规划 + 课前摸底定位短板\n课中实时互动讲题，随时提问不留疑问\n学后24h答疑 + 作业精批，当天知识当天消化✔\n\t\n✅ 灵活安排，精准匹配校内进度\n1人1班，个性化难度分级，内容量身定制\n寒假也能高效追赶，开学惊艳所有人✨\n📌 现在咨询还可领 1v1试学机会\n适合基础弱、想提分、需要针对性辅导的🧑\u200d🎓！\n抓住寒假，悄悄逆袭👉\n\t\n想给孩子争取1v1试听名额的家长，点击【立即咨询】获取专属学情检测和学习方案～\n📝 报名要求：仅面向32岁以上家长\n📆 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #高效学习[话题]# #线上课[话题]# #学习更高效[话题]#', 'video_url': '', 'time': 1768560238000, 'last_update_time': 1770702588000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '1', 'ip_location': '河北', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102249/5ed9054849c8390e31e73835104b6152/spectrum/1040g0k031sd711tc58005oakffv0j2cog0sti7g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102249/20a8250f6cba8dae22995c9a86fe3381/spectrum/1040g0k031sd711tc580g5oakffv0j2cov1e97j0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102249/42fe1415fb7d4b2957fd59ee6fa47cb1/spectrum/1040g0k031sd711tc58105oakffv0j2co2jass2g!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,高效学习,线上课,学习更高效', 'last_modify_ts': 1773154141457, 'note_url': 'https://www.xiaohongshu.com/explore/696a166e000000000a02e8db?xsec_token=ABxWR6eCHHjiBogLMt5uPR92-MVrWPVdVKe4CfhtX7nRk=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABxWR6eCHHjiBogLMt5uPR92-MVrWPVdVKe4CfhtX7nRk='}
