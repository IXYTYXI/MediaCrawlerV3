2026-03-10 22:46:17 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '697c74cc000000001a02d314', 'type': 'normal', 'title': '模考次次拔高！全靠高三一对一盯学', 'desc': '😭 家有高三娃的家长谁懂啊！\n❌ 一轮二轮复习越学越迷茫，成绩却忽高忽低\n❌ 基础不牢又跟不上老师节奏，在家学没人管效率低\n❌ 想补弱又找不到精准方法，眼看高考越来越近急得睡不着觉\n✅ 直到给孩子安排了高三一对一网课，才发现原来可以这么顺！全程1v1盯学定制，终于不用再瞎忙活了！\n\t\n👉 1v1定制精准高分方案\n基础差跟不上？0基础起步一站式学习规划，解题技巧层层兜底；\n复习没方向？根据娃的具体学情1v1定制课程，精准发力不做无用功；\n\t\n👉 足不出户在家轻松超车\n线上直播课灵活高效，在家打开设备就能上课\n主讲老师全是严选的名校毕业学霸，各科考点全面覆盖\n\t\n👉 24h全程督学，家长双省心\n课前提醒预习、课中紧盯状态、课后督促复盘，全程陪伴不松懈\n定期组织家长会，详细反馈孩子的学习进度、知识漏洞、模考情况\n\t\n为什么有人模考次次拔高？不过是找对了1v1盯学的精准方法，每一步都踩在提分点上～\n\t\n点击【立即咨询】获取专属学情检测和1v1试听！\n📝 报名要求：仅面向32岁以上家长\n📆 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #线上课[话题]# #高考逆袭[话题]# #艺考文化课[话题]# #高三复习[话题]# #高考逆袭[话题]#', 'video_url': '', 'time': 1769764044000, 'last_update_time': 1769764044000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102246/892b84768e7d0b18a8f7fb57697c702c/spectrum/1040g34o31rv7f9gu3o305oakffv0j2coujehi50!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102246/2b85a02c182c0f4130d94a9823d475fb/spectrum/1040g34o31rv7f9gu3o3g5oakffv0j2cohsf5m28!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102246/7705278b4f5c912406b0c666fba3b165/spectrum/1040g34o31rv7f9gu3o405oakffv0j2cono0bnho!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,线上课,高考逆袭,艺考文化课,高三复习,高考逆袭', 'last_modify_ts': 1773153977954, 'note_url': 'https://www.xiaohongshu.com/explore/697c74cc000000001a02d314?xsec_token=ABEs_FLh4JX7EWRqvtpb1hsAl2n0p8rtW8hsTWjg8lSRA=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABEs_FLh4JX7EWRqvtpb1hsAl2n0p8rtW8hsTWjg8lSRA='}
