2026-03-10 23:21:37 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6878a26d00000000120231cd', 'type': 'normal', 'title': '试过那么多课，这家高中1v1网课我真的服', 'desc': '很多家长都想知道，高途一对一到底值不值得报？从入学测评到定制方案，从名师带学到全程督学，今天就来好好说道说道～\n\t\n👉 入学先 “扒底”，孩子的薄弱精准定位\n近期考卷逐题分析：圆锥曲线计算错 5 次，不是不会方法，是步骤漏了‘判别式验证’”都写进报告，家长自己都没有这么细心！\n\t\n👉 1v1定制方案，专治孩子学不会”\n根据测评，老师当场给了专属计划，把问题拆得明明白白，每天学习计划清清楚楚！\n\t\n👉 老师选得用心，不满意还能换，太懂家长心\n多轮严选的双一流名师，讲课真有一套，最贴心的是能换老师，不同类型的老师都有！\n👉 全程有人盯，老母亲终于不用当 “监工”\n以前天天催写作业，现在有老师盯着，家长省了太多心；还有阶段测试和家长会，随时了解学习进度！\n\t\n真心觉得，有人精准揪错、有人带练方法、有人盯着执行，比我们家长瞎着急管用多了。\n现在点击【立即咨询】领取试听还送测评 + 定制方案\n⏰ 活动时间：即日起-26年12月31日\n\ufeff#高途[话题]#\ufeff\xa0\ufeff#一对一[话题]#\ufeff\xa0\ufeff#网课[话题]#\ufeff\xa0\ufeff#体验[话题]#\ufeff\xa0\ufeff#高中网课[话题]#\ufeff\ufeff#高一[话题]#\ufeff \ufeff#高二[话题]#\ufeff \ufeff#高三[话题]#\ufeff \ufeff', 'video_url': '', 'time': 1752801121000, 'last_update_time': 1753234517000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '2', 'collected_count': '1', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102321/cae2b94b851dc77c0859fe6c8b685f53/spectrum/1040g0k031k1g19o4jq405oakffv0j2coruub63g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102321/83657d688417493626119cb4998f058c/spectrum/1040g0k031k1g19o4jq4g5oakffv0j2cof9ovp08!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,体验,高中网课,高一,高二,高三', 'last_modify_ts': 1773156097768, 'note_url': 'https://www.xiaohongshu.com/explore/6878a26d00000000120231cd?xsec_token=AB8CR3kcsUfNMvn-S4wwqefXrdB80bmvl3l21tdXajCHM=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB8CR3kcsUfNMvn-S4wwqefXrdB80bmvl3l21tdXajCHM='}
