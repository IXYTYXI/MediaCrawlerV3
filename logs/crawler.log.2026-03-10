2026-03-10 23:17:05 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '689dc772000000001b01f3ee', 'type': 'normal', 'title': '高途1v1名师直播，新高三负责至出分为止', 'desc': '😭 新高三家长是不是已经开始焦虑？\n🤔 孩子对着课本抓不住重点，老师讲课进度快跟不上，错题一错再错没头绪…\n✅ 别担心！新高三首轮复习跟着高途1v1 播学，名师从头讲重点，每次 2 小时精准发力，全程负责到出分，让孩子赢在高三起跑线！\n\t\n👉 会推、会导、会总结，出分超流畅\n👉 传授多种思路方法，学完忘不了\n👉 历年真题、重难点总结，随时练\n\t\n🔥 跟高途1v1精准高效复习\n✅ 专属定制：入学先做精准摸底，然后量身定制课程内容，薄弱专项突破；\n✅ 名师1对1带学：不只是讲题更传思路，解题技巧当场消化，学习效率翻一翻；\n✅ 灵活省时：打开电脑就能学，临时有事还能调课，不用迁就集体进度；\n✅ 专属服务：专属班班全程督学，课前提醒打卡、课中盯专注度、课后催作业复盘，学习可视化更安心；\n\t\n让高途1v1名师带着孩子把首轮复习打扎实，从高三开始就领跑，一路稳到高考～\n🙋 报名要求：仅面向32岁以上家长\n⏰ 活动时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#高中网课[话题]#\ufeff \ufeff#高三复习[话题]#\ufeff \ufeff#一轮复习[话题]#\ufeff \ufeff#重点知识复习[话题]#\ufeff', 'video_url': '', 'time': 1755170674000, 'last_update_time': 1755170674000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102317/1704094275c34c9d2bd72ec0aa2f63e8/spectrum/1040g0k031l5oppujkq705oakffv0j2cotrt36vo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102317/882e4f041b5730b4f6acdf3d14bf9e61/spectrum/1040g0k031l5oppujkq7g5oakffv0j2coir24kco!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,高三复习,一轮复习,重点知识复习', 'last_modify_ts': 1773155825476, 'note_url': 'https://www.xiaohongshu.com/explore/689dc772000000001b01f3ee?xsec_token=ABMYSyG5sRCJEXQQbEFzjzIdkao87AkKMvYrA_dus0t78=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABMYSyG5sRCJEXQQbEFzjzIdkao87AkKMvYrA_dus0t78='}
