2026-03-10 23:12:58 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68b69701000000001d03ab39', 'type': 'normal', 'title': '想拔高逆袭？高途1v1陪跑至出分', 'desc': '🌟 知识点学了没体系\n🌟 偏科短板补不上、没人盯着就偷懒…\n✅ 高途官方1v1来帮衬，双🧑\u200d🏫师全程陪跑，一路负责到出芬～\n.\n🔥【高途一对一6轮严选师资】\n👉 汇聚毕业于211、985名校的翘楚\n👉 经过多轮严选，拥有丰富的教学经验\n👉 知识点高度凝练，内容深入浅出\n.\n🔥【高途一对一闭环式学习体系】\n👉 一整套高效完整的学习方案，全程1v1直播互动；\n👉 专业测试诊断分析，因材施教，精准学习；\n👉 ke中全程督促伴学，避免跑神，学一整节课；\n👉 专属一对一沟通群，及时沟通了解，查漏补缺❗️\n\t\n点击左下角【立即咨询】体验1v1试听～\n🙋 报名要求：仅面向32岁以上家长\n⏰ 活动时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #弯道超车[话题]# #线上课[话题]# #家长必读[话题]##学习更高效[话题]##高中[话题]# #高中网课[话题]#', 'video_url': '', 'time': 1756796673000, 'last_update_time': 1760146880000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '2', 'comment_count': '1', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102312/bca1f927d51753ff776ce91253616acc/spectrum/1040g34o31lu050fckq305oakffv0j2cotavp260!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102312/9ff1d598dce30bbddcd8cdcb1219fa5b/spectrum/1040g34o31lu050fckq3g5oakffv0j2co1e435vo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102312/7d19115668dd8a66c9322a99e82045d1/spectrum/1040g34o31lu050fckq405oakffv0j2coi5bnis8!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,弯道超车,线上课,家长必读,学习更高效,高中,高中网课', 'last_modify_ts': 1773155578120, 'note_url': 'https://www.xiaohongshu.com/explore/68b69701000000001d03ab39?xsec_token=AB4CxoWUcxP3S5svdQ68j2diu5VdxejCU-Yt8RmehHEqc=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB4CxoWUcxP3S5svdQ68j2diu5VdxejCU-Yt8RmehHEqc='}
