2026-03-10 21:43:40 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69afbaac00000000220314d2', 'type': 'normal', 'title': '1-9阶想学浅奥的家长看过来！一周1次刚好', 'desc': '别等一个学期都结束了，才发现孩子数学思维已经断层了…  很多孩子数学被拉开差距，关键不在“算得多快”，而在“怎么思考”。\n👉🏻数学思维弱的孩子： ▸ 只会死背公式，题目一变就懵 ▸ 做题步骤混乱，错了也不知道原因 ▸ 刷了很多题，分数却一直卡在85分上不去\n👉🏻数学思维强的孩子： ▸ 读完题会主动画图、找关系、拆线索 ▸ 一种方法不行，马上换思路再试 ▸ 不怕新题难题，反而觉得思考很有成就感\n⭕️这不是天赋差距，是思维模式没被打通\n⭕️小学数学真正要练的，不是刷题速度，而是解题脑回路  -\n如果你也希望孩子：\n✔️ 做题有思路、有方法，不靠死记硬背\n✔️ 遇到难题敢尝试、会拆解、不逃避\n✅一定要试试平行线浅奥数学思维课！逐级提升，稳步开窍\n🏆70%校内基础+浅奥+深奥拓展，巩固课本同时拔高思维\n🏆1v6小组直播互动，课堂参与感拉满，趣味PK+场景化学习，专注不走神\n🏆用生活实例讲数学，让孩子真正理解、会迁移、能举一反三\n🏆清北背景严选讲师团队，经验足、讲得透，全程1v1真人答疑\n🚩报名人群：仅面向32岁以上家长\n👉🏻点击下方【立即咨询】了解详情，可免费体验\n🎁赠送1v1专属学习规划+能力分析报告\n#数学思维[话题]#  #浅奥[话题]#  #小学数学[话题]#  #数学网课[话题]#   #数学学习[话题]#    #数竞[话题]#    #平行线教育[话题]#  #浅奥思维[话题]#  #奥数[话题]# ##小学奥数[话题]#', 'video_url': '', 'time': 1773124268000, 'last_update_time': 1773124269000, 'user_id': '642ba9780000000012011a80', 'nickname': '平行线名师大课堂', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/f0238b56-4bdd-3597-adf3-db36cfdcf315', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102143/0dc31223e07aeb07a91aa85f79774f8b/spectrum/1040g34o31th9nnsdme105p1bl5s4i6k07tv39hg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102143/c2a68d82c75ca3102609318610b80c3e/spectrum/1040g34o31th9o824l6005p1bl5s4i6k056qqseo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102143/8d91641db428af8fa8656c01eb1af656/spectrum/1040g34o31th9o824l60g5p1bl5s4i6k00ltdam0!nd_dft_wlteh_webp_3', 'tag_list': '数学思维,浅奥,小学数学,数学网课,数学学习,数竞,平行线教育,浅奥思维,奥数,小学奥数', 'last_modify_ts': 1773150220678, 'note_url': 'https://www.xiaohongshu.com/explore/69afbaac00000000220314d2?xsec_token=AB9mya0G5gRV6vHe5UesXJL4ECgkduz9fLN0u_sQt8MkM=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB9mya0G5gRV6vHe5UesXJL4ECgkduz9fLN0u_sQt8MkM='}
