2026-03-10 16:05:55 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '691d1b9d000000001b030f0b', 'type': 'normal', 'title': '小学生校内数学提前学内容框架规划小初一体', 'desc': '一年级\n· ① 二年级计算（每2页）\n· ② 一二新加坡数学建模\n· ③ 详选数单超前看（1-3）\n二年级\n· ① 三四年级计算（每2页）\n· ② 三四新加坡数学建模\n· ③ 详选数单超前看（4-6）\n三年级\n· ① 五六年级计算（每2页）\n· ② 五六新加坡数学建模\n· ③ 小补初总复习（未结）\n四年级\n· ① 初一计算（每2页）\n· ② 初中详选数单超前看\n· ③ 第一遍刷《少刷题》\n· ④ 第二遍刷《新思维》\n五年级\n· ① 初二计算（每2页）\n· ② 初中详选数单超前看\n· ③ 第一遍刷《少刷题》\n· ④ 第二遍刷《新思维》\n六年级\n· ① 初三计算（每2页）\n· ② 第一遍刷《少刷题》\n· ③ 第二遍刷《新思维》\n· ④ 中考复习总结\n---\n📝 备注说明：\n· “计算是数学基本功” 被特别强调。\n· 建议在三年级左右加入奥数或暑假学习。\n· 提到时间不够可以申请本班作业复习，或由家长监督，保证睡眠，避免低效劳动。#小学生[话题]# #数学[话题]# #小学数学[话题]# #小学数学思维训练[话题]# #初中数学[话题]# #小学教育[话题]# #鸡娃[话题]# #小学奥数[话题]# #数学思维[话题]# #数学学习[话题]#', 'video_url': '', 'time': 1763515293000, 'last_update_time': 1763600823000, 'user_id': '58bbf94b82ec3949994f780a', 'nickname': '渣妈陪娃', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/641a745f2fa7055bf34883a8.jpg', 'liked_count': '443', 'collected_count': '671', 'comment_count': '83', 'share_count': '41', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603101557/7e20bc3eb1002988d891f2b087a2dc2e/notes_uhdr/1040g3qg31p23rmim2s00498co1skmu0arvri8g8!nd_dft_wlteh_webp_3', 'tag_list': '小学生,数学,小学数学,小学数学思维训练,初中数学,小学教育,鸡娃,小学奥数,数学思维,数学学习', 'last_modify_ts': 1773129955793, 'note_url': 'https://www.xiaohongshu.com/explore/691d1b9d000000001b030f0b?xsec_token=ABKXeGBQwtdMk8OOygvs9g-bUiJbVvyFSlOYfjTQdXDas=&xsec_source=pc_search', 'source_keyword': '数学超前学', 'xsec_token': 'ABKXeGBQwtdMk8OOygvs9g-bUiJbVvyFSlOYfjTQdXDas='}
