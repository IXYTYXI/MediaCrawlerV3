2026-03-10 22:58:32 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '692518f8000000001f0098de', 'type': 'normal', 'title': '26高考从头学！在家1v1陪跑效率封神', 'desc': '🤔 26届高考想从头逆袭，不想挤机构奔波？\n🏃 在家上一对一全程陪跑真的香！\n👍 不用赶课通勤，名师全程盯学负责到出分，效率直接拉满，备考节奏稳稳的～\n\t\n✅ 告别机构！在家1v1从头学太香了\n👉 在家打开设备就能上专属1v1，从基础补起；\n👉 全程陪跑不脱节，从一轮复习到高考冲刺；\n\t\n✅ 名师1v1带学！出分效率看得见\n👉 严选名师1v1精准带学，针对性规划复习；\n👉 用名师总结的技巧轻松吃透，告别死记硬背；\n👉 结合历年真题训练，从题型拆解到解题思路；\n👉 全程负责到出分！家长完全省心\n👉 不是上完课就结束，而是全程闭环服务；\n👉 24小时随时答疑，家长只需做好后勤，彻底解放！\n\t\n26高考与其在机构奔波低效学，不如在家选1v1全程陪跑～\n感兴趣的家长赶紧点击【立即咨询】领1v1试学名额～\n🔍 报名要求：32岁以上家长\n⏰ 截止时间：即日起-26年12月31日\n#高途[话题]# #高中网课[话题]# #一对一[话题]# #一轮复习[话题]# #高考逆袭[话题]# #学霸养成[话题]# #高考冲刺[话题]# #学习效率[话题]# #学习规划[话题]#', 'video_url': '', 'time': 1764038904000, 'last_update_time': 1764038905000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '1', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102258/609b1b35e5af98facdd06b34564ad6ea/spectrum/1040g0k031p9tgo25i40g5oakffv0j2counpchi8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102258/a925e36412bd4388585db7af3aaa78aa/spectrum/1040g0k031p9tgo25i4105oakffv0j2cov7aum7g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102258/5c5c1b2deb881d8b45d877c3ad52acc5/spectrum/1040g0k031p9tgo25i41g5oakffv0j2co8hvhihg!nd_dft_wlteh_webp_3', 'tag_list': '高途,高中网课,一对一,一轮复习,高考逆袭,学霸养成,高考冲刺,学习效率,学习规划', 'last_modify_ts': 1773154712543, 'note_url': 'https://www.xiaohongshu.com/explore/692518f8000000001f0098de?xsec_token=ABCno0QiLioCS8fy-YMr1sfhx9Iop6jxHMglU_ZvDvXZA=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABCno0QiLioCS8fy-YMr1sfhx9Iop6jxHMglU_ZvDvXZA='}
