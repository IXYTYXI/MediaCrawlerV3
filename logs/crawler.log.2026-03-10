2026-03-10 19:42:15 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69affe57000000000c00ad63', 'type': 'normal', 'title': 'sparkmath真能让小阶娃开窍！我服了', 'desc': '体验了三个月说说大实话！ 之前一直被种草新加坡数学，又担心线上课效果不好\n🥳 体验了三个月sparkmath新加坡数学（火花新加坡数学），真心想分享给纠结的妈妈们👇\n💥 0元试听，点击【立即咨询】抢占名额\n---\n✅ 8人封顶小班直播课：\n人少就是不一样！老师能照顾到每个孩子，我娃性格内向也被鼓励着举手，现在上课可积极了\n✅ 中/英/双语可选：\n这个太贴心了！我们选的双语班，数学概念和英语表达一起抓，一举两得\n✅ 清北老师领衔：\n老师是真的会教，不是照本宣科。一个问题能用三种方法讲，直到娃听懂为止\n✅ 学习闭环体系：\n预习-上课-练习-复习-测评，全套安排得明明白白，我再也不用操心“今天学啥、明天练啥”\n✅ 三个月下来，娃从“妈妈这道题怎么做”变成“妈妈我来给你讲”！\n应用题自己画图分析，计算题主动检查，老母亲终于可以躺平了～\n现在正好有活动，3600/季，超级划算💥\n-\n👇点击【立即咨询】立即锁定试听名额\n⏰ 活动有效期：即日起至2027年12月31日\n*面向家长群体\n#新加坡数学线上课价格[话题]# #新加坡数学网课[话题]# #新加坡数学直播课体验[话题]# #新加坡数学多少钱一节[话题]# #sparkmath新加坡数学[话题]# #sparkmath[话题]# #火花新加坡数学[话题]# #提升孩子思维能力[话题]#', 'video_url': '', 'time': 1773141591000, 'last_update_time': 1773141756000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603101942/55fee69e0d745d92f161d20aa87cd9f7/1040g2sg31thi11k4ln2g5olhcu8lbcmas6em3io!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学线上课价格,新加坡数学网课,新加坡数学直播课体验,新加坡数学多少钱一节,sparkmath新加坡数学,sparkmath,火花新加坡数学,提升孩子思维能力', 'last_modify_ts': 1773142935601, 'note_url': 'https://www.xiaohongshu.com/explore/69affe57000000000c00ad63?xsec_token=AB9mya0G5gRV6vHe5UesXJL9BE7tf017ZbL9UYxoSXrZY=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB9mya0G5gRV6vHe5UesXJL9BE7tf017ZbL9UYxoSXrZY='}
