2026-03-10 16:06:54 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6936822b000000001e0306f7', 'type': 'normal', 'title': '数学超前学怎么规划，怎么学（2小学阶段）', 'desc': '数学超前学习小学阶段目标是搭建基本知识结构，方法是逐字逐句阅读1-6年级课本，或使用总复习教辅。常见问题包括家长观念、坚持方法和自主学习培养。建议尽早完成小升初衔接，避免校内成绩提升不明显。#鸡娃必备[话题]# #让孩子爱上数学[话题]# #学霸养成[话题]# #', 'video_url': '', 'time': 1765179947000, 'last_update_time': 1765179947000, 'user_id': '57ed56e65e87e7283a7e695e', 'nickname': '小梦', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31h4t8tekjo0048nnh2becqau6egajng', 'liked_count': '277', 'collected_count': '463', 'comment_count': '49', 'share_count': '68', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603101600/dfd02a4295db40b77beef377695a2cb7/1040g2sg31pqsr3l9527048nnh2becqaunj3cpeg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101600/4707dcc07e71e9cd778ef2b762cacc55/1040g2sg31pqsr3l9527g48nnh2becqauu4f5gh8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101600/13f072052d8131ef8eb1b474ed6bb3e6/1040g2sg31pqsr3l9528g48nnh2becqaueju7mp0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101600/8c8aaa423d326ae153931a88a4d95b4d/1040g2sg31pqsr3l9528048nnh2becqaui3htod0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101600/0dff502d9cda22d3e290622323a9c7f3/1040g2sg31pqsr3l9529048nnh2becqauejd81ho!nd_dft_wlteh_webp_3', 'tag_list': '鸡娃必备,让孩子爱上数学,学霸养成', 'last_modify_ts': 1773130014728, 'note_url': 'https://www.xiaohongshu.com/explore/6936822b000000001e0306f7?xsec_token=ABFgEnIUTVfspQTto7Nab8KDIxDlCl2F_B6_4oV_T-R6U=&xsec_source=pc_search', 'source_keyword': '数学超前学', 'xsec_token': 'ABFgEnIUTVfspQTto7Nab8KDIxDlCl2F_B6_4oV_T-R6U='}
