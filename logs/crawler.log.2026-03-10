2026-03-10 22:49:50 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '695f50b900000000210334e4', 'type': 'normal', 'title': '高中线上1v1也太香了吧！全程盯学不跑偏', 'desc': '🫢 不是吧不是吧！还有高中家长不知道线上1v1有多香？\n🏃 不用接送、时间灵活，老师全程盯着学\n🎉 精准补弱不做无用功，每一分钱都花在刀刃上，彻底解放家长！\n👉 在家就能学！时间灵活到哭，家长太省心\n\t\n🔥【全程盯学不跑偏！走神？不存在的】\n✅ 课前：提前安排预习任务，梳理基础框架，上课更快进入状态；\n✅ 课中：全程1v1专属关注，实时提问互动，全程高频不走神；\n✅ 课后：紧跟效果，不是上完课就结束，确保学过的知识真的吃透！\n\t\n🔥【全流程保障！教学质量拉满，提分更有底】\n✅ 精研精讲：老师都是经过六轮严选+阶段功底考核出来的；\n✅ 专属报告：根据个人学情定制，不是照本宣科，每节精准适配；\n✅ 诊断复盘：随堂检测及时掌握学习情况，24h在线答疑不打烊；\n\t\n线上1v1全程盯学、灵活省心、精准补弱，还能全流程保障教学质量\n想给孩子试试的家长，点击【立即咨询】获取1v1试听名额和专属学情诊断～\n📝 报名要求：仅面向32岁以上家长\n📆 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #线上课[话题]# #课程辅导[话题]# #学习规划[话题]# #高中[话题]# #高效学习[话题]# #高考冲刺[话题]#', 'video_url': '', 'time': 1767854265000, 'last_update_time': 1767854265000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102249/7a36397e7b194ad7ec3ba105905a8636/spectrum/1040g0k031r2oqih670005oakffv0j2coq12thd8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102249/d8014f6412f8c5dd04934a53d0e6f88d/spectrum/1040g0k031r2oqih6700g5oakffv0j2co94hh5pg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102249/654d2e0d59e9a6dacea07971a281c6c7/spectrum/1040g0k031r2oqih670105oakffv0j2co64vag7g!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,线上课,课程辅导,学习规划,高中,高效学习,高考冲刺', 'last_modify_ts': 1773154190075, 'note_url': 'https://www.xiaohongshu.com/explore/695f50b900000000210334e4?xsec_token=AB_e4TLEe2FvTsCISOpzib8RoF9qC44zyqXlTL0KX_pO0=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB_e4TLEe2FvTsCISOpzib8RoF9qC44zyqXlTL0KX_pO0='}
