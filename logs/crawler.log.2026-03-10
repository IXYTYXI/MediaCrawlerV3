2026-03-10 23:52:27 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67df7ff2000000001e001571', 'type': 'normal', 'title': '一人一班负责到出分❗️复习就找高途', 'desc': '⚠️ 各位9阶家长们，总复习已经不足百天了\n心里又焦虑又无奈，跟不上校内进度怎么办❓\n高途一对一来帮忙\n一人一班，跟着名师在家搞定高效复习\n-\n【跟着高途1v1精准复习高效备考】\n🈶 课前：大数据诊断薄弱，学习报告专业反馈，精准掌握学习脉络，题库练习点对点巩固；\n🈶 课中：名师主讲1v1直播互动，及时解决遇到的问题，当场解决，互相交流讨论；\n🈶 互动：手把手拆解重难点公式、母题，传授解题方法、大招，帮助🧑\u200d🎓能够轻松化解难点\n🈶 课后：专属班班课后精批作业，随时答疑解惑，有任何问题随时问，不留知识死角！\n-\n别再无效学习了，赶紧跟着高途1v1一起冲刺吧\n点击左下角【立即咨询】定制专属个人课程\n🉐1对1检测+学习方案+学习资料\n报名对象：仅面向32岁以上家长\n活动时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#复习[话题]#\ufeff \ufeff#定制课程[话题]#\ufeff', 'video_url': '', 'time': 1742700530000, 'last_update_time': 1742700530000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '6', 'collected_count': '3', 'comment_count': '2', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102352/23bc744403914fc3a9c9a447837350f5/spectrum/1040g0k031fbuik3k5s005oakffv0j2cocjd4tqo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102352/c7a237a0a3d3d611d4dda3140873cc48/spectrum/1040g0k031fbuik3k5s0g5oakffv0j2coke402dg!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,复习,定制课程', 'last_modify_ts': 1773157947252, 'note_url': 'https://www.xiaohongshu.com/explore/67df7ff2000000001e001571?xsec_token=AB_ja5Jb6kK8iO93NAZZbn1FhezsBYzdry5fKeXLQsQY4=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB_ja5Jb6kK8iO93NAZZbn1FhezsBYzdry5fKeXLQsQY4='}
