2026-03-10 23:17:38 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6896adfc0000000025020a94', 'type': 'normal', 'title': '一对一盯着学！9天吃透高中数学核心', 'desc': '🤷 高中数学是不是总让孩子犯难？\n😮\u200d💨 核心公式背了又忘，函数、几何这些重点模块像隔着层雾\n✍️ 自己刷题总在简单题上耗时间，核心考点却一直没吃透……\n✅ 其实数学的关键是抓准核心知识，找对人盯着学，重点难点逐个击破！\n\t\n🔥 【高途一对一让高中数学不再是难题】\n📣 个性化教学\n针对每个学生的学习情况，1v1制定个性化的高中数学学习方案。先从基础出发，再逐步深入，帮助孩子巩固基础，掌握核心知识点！\n\t\n📣 1v1直播授课高效学习\n专项补弱，经典题型+重塑解题能力+梳理知识点+总结答题技巧，提高思维能力，快速解题！\n\t\n📣 课后专属班班全程带学，阶段测试巩固\n匹配课程设置强化技巧知识的吸收，提升解ti能力，严管监督不自律，进步看得见！\n\t\n不用赶时间赶进度，一对一效率拉满，串联起高中数学核心知识网～\n点击左下角【立即咨询】领取1v1试学名额\n活动时间：即日起-26年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#高中数学[话题]#\ufeff \ufeff#立体几何[话题]#\ufeff \ufeff#函数[话题]#\ufeff', 'video_url': '', 'time': 1754705404000, 'last_update_time': 1754705405000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '13', 'collected_count': '9', 'comment_count': '4', 'share_count': '4', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102317/9c269feaa4e3b9ce64504cf22cfaa758/spectrum/1040g0k031kuqus4kkk005oakffv0j2coeopatlo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102317/bc5f7789269f9a3d9a0e30e39f126786/spectrum/1040g0k031kuqus4kkk0g5oakffv0j2coo1503do!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,高中数学,立体几何,函数', 'last_modify_ts': 1773155858928, 'note_url': 'https://www.xiaohongshu.com/explore/6896adfc0000000025020a94?xsec_token=ABnmatSxT3DMU9caN1Wt0dSrdXy-FOzwolA4pFBFZm-WI=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABnmatSxT3DMU9caN1Wt0dSrdXy-FOzwolA4pFBFZm-WI='}
