2026-03-10 23:46:40 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67f5e2e6000000001b03caea', 'type': 'normal', 'title': '🔥高途线上1v1，五一逆袭加速器！', 'desc': '五一小长假即将来临\n您是否正在为🧑\u200d🎓学习而担忧？\n🌟 五一跟着高途偷偷逆袭，领跑！\n🌟 名师1v1在线教学，效率没得说\n-\n🎓 为什么选择高途一对一网课？\n✅ 1v1预学：学前摸底测，探测知识盲区，帮家长定位短板，根据喜好，个性化匹配老师；\n✅ 1V1直播引导：实时双向在线互动，课堂完成3个核心目标，细致剖析知识点，攻克学习难点；\n✅ 1V1伴学：报告分析试卷，找到知识薄弱点，课后批改，全程答疑，减轻家长压力；\n-\n时间不等人，感兴趣的家长赶紧点击左下角【立即咨询】领取专属试听特权\n报名要求：仅面向32岁以上家长\n活动时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff\xa0\xa0\ufeff#一对一[话题]#\ufeff\xa0\xa0\ufeff#假期逆袭[话题]#\ufeff\xa0\xa0\ufeff#五一[话题]#\ufeff', 'video_url': '', 'time': 1744254602000, 'last_update_time': 1744248497000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '25', 'collected_count': '2', 'comment_count': '3', 'share_count': '2', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102346/a84b2d5c81256ea0388644888c8ac31f/spectrum/1040g34o31g24pbfrni1g5oakffv0j2copaogdm8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102346/8e1bf42fbb5ef2f65cea39b7f41d7058/spectrum/1040g34o31g24pbfrni205oakffv0j2co2dteav0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102346/69ae470baa4f262bfd13c6aa49579a75/spectrum/1040g34o31g24pbfrni2g5oakffv0j2cotqrq078!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,假期逆袭,五一', 'last_modify_ts': 1773157600493, 'note_url': 'https://www.xiaohongshu.com/explore/67f5e2e6000000001b03caea?xsec_token=ABbr9kgSoDd_EAd8g3xqf85H08jjtonNetx_mkGpM52FI=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABbr9kgSoDd_EAd8g3xqf85H08jjtonNetx_mkGpM52FI='}
