2026-03-10 23:44:03 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '680994b3000000001d000c0e', 'type': 'normal', 'title': '1对1真名师严管督学🔥补到位盯着学！', 'desc': '📢 各位家长请注意！\n👶学习总摸鱼？补课没效果？\n“大班课跟不上，自学又没方向？”\n“知识点一听就懂，考试一做就废？”\n💪 别焦虑！高途一对一定制课，名师全程盯学，专治各种摆烂！\n\t\n🎯 【严管督学，拒绝无效学习】\n✅ 真名师1对1——985/211资深教师，精.准.补弱\n✅ 班班全程紧盯式教学——走神？偷懒？不存在的！\n✅ 定制化课程——根据成绩动态调整，只学不会的内容\n\t\n📈 【闭环学习体系】\n1️⃣ 入学诊断——精.准.定位知识漏洞\n2️⃣ 严管课堂——高频互动+解题大招轰炸\n3️⃣ 课后督学——作业批改+错题追杀，绝不放过任何一个漏洞\n\t\n点击↙️【立即咨询】领取专属试听特权\n*本课程为家庭教育规划课，内容仅面向家长\n活动时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#名师[话题]#\ufeff', 'video_url': '', 'time': 1745548321000, 'last_update_time': 1745458355000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '2', 'collected_count': '1', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102344/e26d915e47035df469225249d7b8c588/spectrum/1040g0k031gl1k51fk2005oakffv0j2cod4s8mq0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102344/cffdd32f440eb9dd6847141423b15a38/spectrum/1040g0k031gl1k51fk20g5oakffv0j2covv9uve0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102344/3f25e4601b26a54996c7ff6ac4cc1d74/spectrum/1040g0k031gl1k51fk2105oakffv0j2cobgdth40!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,名师', 'last_modify_ts': 1773157443304, 'note_url': 'https://www.xiaohongshu.com/explore/680994b3000000001d000c0e?xsec_token=ABuTeg-y02O_coiO5uIALyNhlmneICTtxwCIKTHmS3Pr0=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABuTeg-y02O_coiO5uIALyNhlmneICTtxwCIKTHmS3Pr0='}
