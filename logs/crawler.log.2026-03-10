2026-03-10 23:16:33 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '689dc7f0000000001d01ef6c', 'type': 'normal', 'title': '高中1v1直播网课，名师全程陪跑出分', 'desc': '👉 高中学习想高效，选对老师太重要！\n🤷 孩子自己对着课本抓不住重点，大班跟不上节奏…\n👉 别让无效努力耗光孩子的学习热情！高中一对一网课带着 “名师天团” 来了\n✅ 双一流名师1v直播，从基础巩固到难点突破全程护航，让孩子跟着专业老师学，少走弯路！\n\t\n👉 出身双一流院校，自带学霸基因：串联整个高中考点，让孩子学知识不只是记结论，更懂来龙去脉；\n👉 1v1直播互动感拉满：全程盯着学习状态，讲题时随时提问 “这一步思路是什么”，比录播课效率高几倍；\n👉 课前定制学习方案：入学先做 “学情诊断”，基础弱就从课本核心公式补起，尖子生直接练压轴题拓展，避免盲目学习；\n👉 阶段复盘 + 动态调整：根据进步情况调整下一阶段计划，家长还能通过 “学习报告” 随时了解进度，不用再担心孩子 “学没学进去”。\n\t\n让双一流名师1v1带着孩子精准学，全程护航到高考，高中学习不迷茫～\n🙋 报名要求：仅面向32岁以上家长\n⏰ 活动时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#名师[话题]#\ufeff \ufeff#高中一对一[话题]#\ufeff \ufeff#学习日常[话题]#\ufeff \ufeff#学习规划[话题]#\ufeff', 'video_url': '', 'time': 1755217621000, 'last_update_time': 1755170800000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '2', 'collected_count': '1', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102316/12789868d7384cfc56a0754edccef8a8/spectrum/1040g0k031l5orvgi4s005oakffv0j2cosgvjh9o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102316/a868aaa91e779f83fc6503edbb425726/spectrum/1040g0k031l5orvgi4s0g5oakffv0j2coq98alco!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102316/450ab95ea5175b55d7dab0634d2af6d2/spectrum/1040g0k031l5orvgi4s105oakffv0j2coueu3uog!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,名师,高中一对一,学习日常,学习规划', 'last_modify_ts': 1773155793590, 'note_url': 'https://www.xiaohongshu.com/explore/689dc7f0000000001d01ef6c?xsec_token=ABMYSyG5sRCJEXQQbEFzjzIcDN2nJ4H78q33dRS1ZwShg=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABMYSyG5sRCJEXQQbEFzjzIcDN2nJ4H78q33dRS1ZwShg='}
