2026-03-10 22:08:17 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a92957000000001d010598', 'type': 'video', 'title': '一对一每周学1h数学，挑战新学期冲满❗️', 'desc': '高中数学还在 120 分以下徘徊？\n数列公式背了就忘，选填耗时又丢分？\n导数放缩无从下手，向量题总踩坑？刷题无数，分数就是不动？\n-\n👉你不是不努力，是没跟对人！\n-\n👨\u200d🏫跟谁学？\n【掌门一对一高中数学网课】名师天团平均 10 年 + 教龄，累计帮助上万名学员数学逆袭\n亲历高考前 2 个月数学提高70+\n-\n💡怎么学？\n✔️从命题人视角拆解数列、导数放缩核心套路\n✔️“会一道，通一类” 不靠刷题，专攻选填秒杀技巧\n✔️针对易错点、向量题型定制避坑指南\n✔️为 120 分以下人群打造专属提分路径\n-\n💰多少钱？\n100+ / 课时，每周 2h，性价比超高，还能跟清北等名师学一年！\n-\n📌适合谁？\n✅基础弱、方法乱的\n✅听得懂做不对的\n✅想冲 120 + 但找不到方向的\n-\n👉趁现在跟着【掌门一对一高中数学网课】把数列、选填技巧、导数放缩、易错点、向量 5 大核心板块吃透！卷过同龄人，直接逆袭～🚀\n👇点击左下角【立即咨询】0 元领名师数学秒题试听课还送 1V1 专属学情诊断规划哦！\n📚此课程为高中线上教育课程，现在报名即可领取\n-\n📅报名时间：即日起 —12 月 31 日\n👪对应人群：仅面向 32 岁以上家长\n#高中数学[话题]#  #掌门一对一[话题]#   #数学老师[话题]#  #数学学习[话题]#  #高考数学[话题]#  #数学思维[话题]#  #数学高考题型与技巧[话题]# #考试[话题]# #学习方法[话题]#', 'video_url': 'http://sns-video-al.xhscdn.com/stream/79/110/259/01e9a92924281f44010370039cbcca58c8_259.mp4', 'time': 1772703027000, 'last_update_time': 1772693847000, 'user_id': '649a70220000000010036bfc', 'nickname': '掌门1对1学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31pumqmjhls005p4qe0h46qvs49pjit8', 'liked_count': '1', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '上海', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102208/929fffccac677fa330ae60788c08817d/spectrum/1040g0k031tasga9j56105p4qe0h46qvsv6j4e18!nd_dft_wlteh_webp_3', 'tag_list': '高中数学,掌门一对一,数学老师,数学学习,高考数学,数学思维,数学高考题型与技巧,考试,学习方法', 'last_modify_ts': 1773151697384, 'note_url': 'https://www.xiaohongshu.com/explore/69a92957000000001d010598?xsec_token=ABkXiiT8OoWfy0U4yQ6YI3tv0JyMnsuUCSE-a1iqWVL_A=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABkXiiT8OoWfy0U4yQ6YI3tv0JyMnsuUCSE-a1iqWVL_A='}
