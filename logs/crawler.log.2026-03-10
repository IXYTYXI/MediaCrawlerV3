2026-03-10 20:56:04 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a8edf7000000002603d606', 'type': 'normal', 'title': '🔥3800一季的新加坡数学，小班教学真香❗', 'desc': '新加坡数学怎么样？sparkmath新加坡数学（火花新加坡数学）3-8人小班效果太惊喜✨\n💥sparkmath新加坡数学（火花新加坡数学）限时特惠，0元试听，点击【立即咨询】抢占名额\n---\n🔥【小班教学】\n3-8人小班配置\n老师能照顾到每个娃\n互动机会多 氛围超好\n📚【CPA教学法】\n具象-形象-抽象三步走\n娃终于搞懂为什么要进位退位\n数学不再是死记硬背\n🌍【双语可选】\n中/英/双语自由切换\n我们选的英文班\n数学思维+英语能力一起抓\n⚡【学习闭环】\n预习→上课→练习→测评\n完整的学习闭环体系\n每周进步肉眼可见\n---\n💰一季3800\n比线下班便宜太多\n关键是娃爱上数学了\n每天主动问：今天上数学课吗？\n-\n👇点击【立即咨询】，或戳@Spark Math 数学课程 回【领取】，立即锁定试听名额\n• 1节在线思维直播课\n• 1V1定制学习规划方案\n• 价值3422元228课时学习大礼包\n⏰ 活动有效期：即日起至2026年12月31日\n*面向家长群体\n#sparkmath[话题]# #新加坡数学[话题]# #sparkmath新加坡数学[话题]# #小学数学[话题]# #数学思维[话题]# #火花新加坡数学[话题]# #小学数学思维训练[话题]# #新加坡数学建模[话题]# #小学数学怎么学[话题]# #数学学习[话题]#', 'video_url': '', 'time': 1772678647000, 'last_update_time': 1772678648000, 'user_id': '64740b96000000000f006adf', 'nickname': 'Spark Math 数学课程', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo30oe65qe8ie5g5p3k1eb3oqmvph5fk6g', 'liked_count': '', 'collected_count': '1', 'comment_count': '6', 'share_count': '3', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102056/d3f0440bcdbe1b0855708528fa194984/spectrum/1040g0k031tal7up2l6005p3k1eb3oqmvmjao8n8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102056/52b1a7262d17e7a795c9c251b4e53677/spectrum/1040g0k031tal7up2l60g5p3k1eb3oqmv54n3qo0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102056/917227d6bec7ad0026b71bd3c01ca321/spectrum/1040g0k031tal7up2l6105p3k1eb3oqmv73pmf08!nd_dft_wlteh_webp_3', 'tag_list': 'sparkmath,新加坡数学,sparkmath新加坡数学,小学数学,数学思维,火花新加坡数学,小学数学思维训练,新加坡数学建模,小学数学怎么学,数学学习', 'last_modify_ts': 1773147364276, 'note_url': 'https://www.xiaohongshu.com/explore/69a8edf7000000002603d606?xsec_token=ABnvIy8YG46cQOPm-Ta-dez2lTw0QWiSOJX-GVOBVWsWU=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABnvIy8YG46cQOPm-Ta-dez2lTw0QWiSOJX-GVOBVWsWU='}
