2026-03-10 22:48:52 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '696a16ac000000001a030ace', 'type': 'normal', 'title': '收差生！数学弱速进🚀1v1线上陪跑', 'desc': '数学拖后腿？基础不稳越学越累？\n别怕！高途高中1v1就是为“差生”量身打造！\n📌 我们收：\n✅ 数学差生\n✅ 基础薄弱生\n✅ 严重偏科生\n✅ 想短期提分的学生\n\t\n🔥 为什么选高途1v1？\n✔️ 严选名校毕业学霸，持证上岗，直播互动\n✔️ 个性化分级教学，内容完全量身定制\n✔️ 精准匹配校内进度，24小时随时答疑\n✔️ 老师不满意可随时更换，课程支持试听\n\t\n🎯 1v1闭环陪跑体系：\n❶ 定制方案——结合基础+目标，拒绝模板化\n❷ 批改答疑——作业量身布置，7×24h答疑\n❸ 直播互动——动态调整节奏，专注补缺\n\t\n✨ 线上1v1陪跑，直到你出分！\n寒假是逆袭的关键期，别让自己再掉队👇\n想给孩子争取1v1试听名额的家长，点击【立即咨询】获取专属学情检测和学习方案～\n📝 报名要求：仅面向32岁以上家长\n📆 截止时间：即日起-26年12月31日\n#高途[话题]# #高中网课[话题]# #一对一[话题]# #高效学习[话题]# #线上课[话题]# #高中学习方法[话题]# #高中数学[话题]#', 'video_url': '', 'time': 1768560301000, 'last_update_time': 1768560301000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102248/ee17d4abb7c5813a8b0af34a0dd2f1c9/spectrum/1040g0k031rd9fk25n4005oakffv0j2cogtorj90!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102248/c1a987c3a44ca04983eac1139dfbbbda/spectrum/1040g0k031rd9fk25n40g5oakffv0j2codl1ajlo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102248/167431d952aa30ff95cda8673843a4ae/spectrum/1040g0k031rd9fk25n4105oakffv0j2co8e5882o!nd_dft_wlteh_webp_3', 'tag_list': '高途,高中网课,一对一,高效学习,线上课,高中学习方法,高中数学', 'last_modify_ts': 1773154132515, 'note_url': 'https://www.xiaohongshu.com/explore/696a16ac000000001a030ace?xsec_token=ABxWR6eCHHjiBogLMt5uPR90O584ocq7zMZ4bTAYCcvHg=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABxWR6eCHHjiBogLMt5uPR90O584ocq7zMZ4bTAYCcvHg='}
