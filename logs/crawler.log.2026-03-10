2026-03-10 21:45:27 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69abfcea000000002202e28e', 'type': 'normal', 'title': '我敢说，这个数理思维课性价，真的绝！', 'desc': '妈妈们是不是也在愁： 娃数理越学越吃力，刷题再多，一遇灵活题就懵❓\n别急！平行线数理思维课，真正帮孩子把思维“拧过来”！\n学会拆条件、找关系、画图/列表、举一反三，校内更稳，新题不慌✨\n💰 性价比拉满：一年仅1440元，一节课≈30元\n💎 清北名师领衔：清北/985/名校老师+竞赛教练，教龄足、讲得透\n👥 一周1次直播：节奏轻松不压娃，孩子能长期坚持\n📈 分层教学更精准：笃学/睿学/创新班，适配不同基础\n🔥 核心优势，一招搞定痛点：\n✅ 不教套路，只教真思维：会一道，通一类\n✅ 拒绝录播/AI：真人直播互动，孩子不走神\n✅ 全套配套拉满：教材+测评+小灶课+全年1V1答疑  对上班忙、没时间辅导的家长，真的超省心！  👇 点击左下角【立即咨询】 发年级+基础，帮孩子精准匹配班型！\n#让孩子爱上数学[话题]#   #数理思维[话题]#   #提升孩子思维能力[话题]#     #数学[话题]#   #学霸[话题]#   #学习规划[话题]#   #数学学习[话题]#   #小学数学思维训练[话题]#', 'video_url': '', 'time': 1772879082000, 'last_update_time': 1772879083000, 'user_id': '642ba9780000000012011a80', 'nickname': '平行线名师大课堂', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/f0238b56-4bdd-3597-adf3-db36cfdcf315', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102145/5766596f1b3fce57d755387f4236d070/spectrum/1040g0k031tdkovje6e005p1bl5s4i6k0d3btht8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102145/007edbdb52ec7ced4e4ccfc84d56af20/spectrum/1040g34o31tdkis6rl6105p1bl5s4i6k0d4loi70!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102145/053a02bf82f112d18c2ea68e320fccb3/spectrum/1040g0k031tdklgpole005p1bl5s4i6k0kfe1gig!nd_dft_wlteh_webp_3', 'tag_list': '让孩子爱上数学,数理思维,提升孩子思维能力,数学,学霸,学习规划,数学学习,小学数学思维训练', 'last_modify_ts': 1773150327641, 'note_url': 'https://www.xiaohongshu.com/explore/69abfcea000000002202e28e?xsec_token=ABZNdBl2gDwQzwN9c2YjfyO-A3x4vSCtwtEiyiFsvUzZA=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABZNdBl2gDwQzwN9c2YjfyO-A3x4vSCtwtEiyiFsvUzZA='}
