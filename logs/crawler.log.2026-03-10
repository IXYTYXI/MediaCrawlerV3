2026-03-10 16:07:29 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '65a375d1000000000f01e0d2', 'type': 'normal', 'title': '四年级娃一年学完小学数学！干货！', 'desc': '📚四年级学生如何一年内学完小学数学？🎯\n学习计划安排起来！✍\n家有四年级学生的家长看过来🤩！今天给大家分享一份小学数学学习进度表，帮助孩子在一年内完成小学数学的学习📖。\n以下是一个可供参考的学习进度表：\n📅阶段一：数与代数（3 个月）\n学习整数、小数、分数的四则运算，打好数学基础！\n📅阶段二：图形与几何（3 个月）\n探索平面图形和立体图形的奥秘，掌握周长、面积、体积的计算方法。\n📅阶段三：统计与概率（3 个月）\n学会数据收集、整理和分析的方法，培养数据思维！\n📅阶段四：综合复习（1 个月）\n全面复习所有知识点，通过模拟考试和错题分析，查缺补漏！\n#小学数学[话题]# #数学学习[话题]# #小学数学超前学[话题]# #学习计划[话题]# #四年级[话题]#', 'video_url': '', 'time': 1705211345000, 'last_update_time': 1716530563000, 'user_id': '54e5d001e7798903364e9f95', 'nickname': '小红薯6953958F', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31t6613celk00401fgh8037slso6c7m0', 'liked_count': '246', 'collected_count': '414', 'comment_count': '61', 'share_count': '59', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603101601/a36f6f914c62c303b5e3368d1aa84cec/1040g00830ttac17h4e00401fgh8037sltfcbph8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101601/6094a7ca1a30bb0e5917631f3f89678e/1040g00830ttac17h4e0g401fgh8037sl5d1kbfg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101601/840b5e3a33a5cf022bc2bad04eb909d9/1040g00830ttac17h4e10401fgh8037slnlla9so!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101601/f6e6b182039729cc2b516d843ec84f43/1040g00830ttac17h4e1g401fgh8037sltmv9h28!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101601/44b9293ddd35f0d52d23f9344127e534/1040g00830ttac17h4e20401fgh8037slgfbjse0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101601/69379a136a97d4c6a92a7b1fd27c3b37/1040g00830ttac17h4e2g401fgh8037sl8ri7clg!nd_dft_wlteh_webp_3', 'tag_list': '小学数学,数学学习,小学数学超前学,学习计划,四年级', 'last_modify_ts': 1773130049032, 'note_url': 'https://www.xiaohongshu.com/explore/65a375d1000000000f01e0d2?xsec_token=ABLdhPcRq5XT0wlDFm6a_q1L3by1QJ53NN2O5KxMWyS00=&xsec_source=pc_search', 'source_keyword': '数学超前学', 'xsec_token': 'ABLdhPcRq5XT0wlDFm6a_q1L3by1QJ53NN2O5KxMWyS00='}
