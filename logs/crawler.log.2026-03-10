2026-03-10 22:57:04 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69300c9d000000001b0301f5', 'type': 'normal', 'title': '高中线上1v1！负责到出分超省心', 'desc': '⚠️ 家有高中生的都懂！\n💡 孩子平时住校 / 晚自习到深夜\n📑 只有晚上、周末能挤时间补弱提分\n😮\u200d💨 跑线下机构赶场又折腾，自学没方向还容易摸鱼…\n✅ 试了线上1v1才发现，利用碎片时间精准学，负责到出分！\n\t\n▫️ 精准规划，先1v1检测孩子薄弱点，再定制专属方案，不用浪费时间想 “该学啥”，跟着计划走就行；\n▫️ 1v1直播带学，边学边练不摸鱼老师全程盯着学习状态，趁热打铁巩固，比自己刷题效率高几倍；\n▫️ 全程督学+24h答疑，没人盯也自律，24小时在线答疑，深夜刷题卡壳也能随时问，疑问不隔夜；\n\t\n👉 这3类孩子，晚/周末学线上1v1超适配\n平时时间紧，只有晚上、周末能挤出学习时间；\n自制力一般，需要老师盯学督促，避免碎片时间浪费；\n基础薄弱 / 偏科，想利用业余时间精准补漏提分。\n\t\n高中不用 “熬大夜、挤时间”，选对线上1v1，孩子学得轻松，家长也省心！\n点击【立即咨询】预约1v1试学吧～\n报名要求：仅面向32岁以上家长\n活动时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #线上课[话题]# #高中学习[话题]# #高效学习[话题]# #高途高中[话题]# #课程辅导[话题]#', 'video_url': '', 'time': 1764756637000, 'last_update_time': 1764756638000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '6', 'collected_count': '1', 'comment_count': '1', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102257/ee0123c3bbe5e49b17e46cd80671a47a/spectrum/1040g0k031pkjo1laks005oakffv0j2co9fpgbro!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102257/abe709e086f2d3afa143b6d05e6d9c2a/spectrum/1040g0k031pkjo1laks0g5oakffv0j2com8dfpno!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,线上课,高中学习,高效学习,高途高中,课程辅导', 'last_modify_ts': 1773154624791, 'note_url': 'https://www.xiaohongshu.com/explore/69300c9d000000001b0301f5?xsec_token=ABccRRpIQ2vzxkw55WdyG1-H_7m9EMkTwh6ySOuBtMgiU=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABccRRpIQ2vzxkw55WdyG1-H_7m9EMkTwh6ySOuBtMgiU='}
