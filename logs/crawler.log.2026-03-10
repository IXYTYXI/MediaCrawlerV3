2026-03-10 23:52:02 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67dfa97b000000001d01ce15', 'type': 'normal', 'title': '高途线上1v1保姆式托管陪伴式学习', 'desc': '跟不上进度❓严重偏科❓\n阅读写作总丢分❓数理不开窍❓\n😮\u200d💨 身为家长只能干着急❓\n高途1v1来帮忙👉保姆式托管，陪伴式学习\n-\n🔥【高途一对一闭环式学习体系】\n👉 入学后拥有专属成长档案记录学习；\n👉 专业测试诊断分析，因材施教，精准学习；\n👉 课中全程督促伴学，避免跑神，学一整节课；\n👉 专属一对一沟通群，及时沟通了解，查漏补缺❗️\n.\n🔥【高途一对一6轮严选师资】\n👉 1v1的课堂汇聚毕业于211、985名校的翘楚\n👉 经过多轮严选，拥有丰富的教学经验\n👉 知识点高度凝练，内容深入浅出\n-\n现在点击左下角【立即咨询】抢专属试听\n💬 报名要求：仅面向32岁以上家长\n⏰ 截止时间：即日起至25年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#学习[话题]#\ufeff', 'video_url': '', 'time': 1742711163000, 'last_update_time': 1742711164000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '1', 'comment_count': '2', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102352/aa424da38b0959b41640c5afc003e5bb/spectrum/1040g34o31fc3k70h6q0g5oakffv0j2coc0r4ut0!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,学习', 'last_modify_ts': 1773157922565, 'note_url': 'https://www.xiaohongshu.com/explore/67dfa97b000000001d01ce15?xsec_token=AB_ja5Jb6kK8iO93NAZZbn1EDRUR9Z9BKLeFTyKgDcmkw=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB_ja5Jb6kK8iO93NAZZbn1EDRUR9Z9BKLeFTyKgDcmkw='}
