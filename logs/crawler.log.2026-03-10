2026-03-10 21:13:09 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69ab9f4d0000000015039ae1', 'type': 'video', 'title': '数学渣娃用这套规划变学霸❓不看血亏', 'desc': '劝所有数学弱的娃：\n别再盲目刷题了，真的没用👇\n\t\n👉 计算慢、粗心多，正确率上不去\n\t\n👉 文字题绕两圈就懵，逻辑完全跟不上\n\t\n👉 只会死记答案，不会举一反三\n\t\n👉 越补越抵触，一提数学就抗拒\n\t\n想让娃真正开窍，一定要试试这套新加坡建模思维！\n\t\n🌟 为什么这套方法能风靡全球 60 多个国家？\n\t\n不靠死记硬背、不搞题海战术，用科学逻辑让数学变简单：\n\t\n✅ 具象感知：借助实物、教具理解数量关系\n\t\n✅ 建模思维（核心）：把复杂文字转化为直观图表\n\t\n✅ 抽象运用：从图形过渡到算式，轻松掌握逻辑\n\t\n💎 为什么推荐 Mathplore 新加坡数学思维课？\n\t\n🔹 优质师资：老师均来自国内外名校，平均拥有 5 年以上教学经验\n\t\n🔹 精品小班：2-6 人小班直播教学，高频互动，孩子全程专注\n\t\n🔹 完整伴学：多师协同服务，课前测评 + 课后辅导一站式跟进\n\t\n🔹 阶梯进阶：从幼小衔接到小学六年级，贴合校内知识，同时拓展思维\n\t\n🔥 现在点击左下角【立即咨询】即可0 元领取价值 1888 元思维提升大礼包~名额有限，先到先得！\n\t\n⏰ 活动时间：即日起-2028 年 12 月 31 日\n* 仅限 18 岁以上海外家长\n\t\n#数学思维[话题]#  #新加坡数学[话题]#  #小学数学[话题]#  #数学启蒙[话题]#   #学霸规划[话题]# #Mathplore新加坡数学[话题]#  #数学学习[话题]#  #数学网课[话题]#', 'video_url': 'http://sns-video-al.xhscdn.com/stream/1/110/259/01e9ab9f17c612be010370039cc666648c_259.mp4', 'time': 1772855117000, 'last_update_time': 1772855117000, 'user_id': '6504601f0000000017021a03', 'nickname': 'Mathplore数学思维', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/e6f9e621-2070-3494-bab8-b0f3f41001c0', 'liked_count': '2', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '四川', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102113/99a9f4a29c7ffb4daca28d7f5511b6fd/spectrum/1040g34o31td9d8eh5a105p84c0fls6g3d18c578!nd_dft_wlteh_webp_3', 'tag_list': '数学思维,新加坡数学,小学数学,数学启蒙,学霸规划,Mathplore新加坡数学,数学学习,数学网课', 'last_modify_ts': 1773148389645, 'note_url': 'https://www.xiaohongshu.com/explore/69ab9f4d0000000015039ae1?xsec_token=ABZNdBl2gDwQzwN9c2YjfyO8qj1WtTiSPpBJXwH4H03-Q=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABZNdBl2gDwQzwN9c2YjfyO8qj1WtTiSPpBJXwH4H03-Q='}
