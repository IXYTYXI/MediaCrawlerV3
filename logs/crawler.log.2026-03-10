2026-03-10 23:37:22 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '683021ce000000000f0380c5', 'type': 'normal', 'title': '跟着高途1v1，只学有用的❗️', 'desc': '⚠️ 家长请注意！辅导娃写作业是不是像渡劫\n🤷 知识点讲三遍还不懂，卡在中游上不去…\n🤷 花了不少钱，却没什么效果\n🎉 直到遇见高途1v1，只让孩子学有用的！\n\t\n✅ 【真名师天团，专治各种学不会！】\n👉 名校学霸+多年教学老将，知识点都能掰开揉碎了讲\n👉 教的都是技巧、作文万能模板，告别无效刷题\n👉 可视化进步报告，知识点掌握度、答题正确率… 一目了然\n👉 在家就能上 “重点班”，不用接送、不用挤地铁，享受一线城市师资\n👉 专属督学老师，课前提醒！作业没交？追着催到半夜！\n\t\n👉快来【立即咨询】抢占专属试听名额！还可以领「学情分析+规划」哦~\n报名要求：仅面向32岁以上家长\n活动时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff   \ufeff#一对一[话题]#\ufeff   \ufeff#在家学[话题]#\ufeff   \ufeff#逆袭[话题]##高中[话题]# #高中网课[话题]# \ufeff\ufeff', 'video_url': '', 'time': 1748049002000, 'last_update_time': 1760924721000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102337/42f1f61765b43b8868556710766e3865/spectrum/1040g0k031i0q7lp16s005oakffv0j2co3nhl5bo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102337/c852eec6857b8139b593983a2a3defc3/spectrum/1040g0k031hqmb6mo3a0g5oakffv0j2co97f7fvo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102337/0401c152db663720e83afe90c6a29be3/spectrum/1040g0k031hqmb6mo3a105oakffv0j2co6qben48!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,在家学,逆袭,高中,高中网课', 'last_modify_ts': 1773157042173, 'note_url': 'https://www.xiaohongshu.com/explore/683021ce000000000f0380c5?xsec_token=ABpLud-iFzQ4SMHxVK079vNMrIR-h9wxX5kFwOWuHGbVc=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABpLud-iFzQ4SMHxVK079vNMrIR-h9wxX5kFwOWuHGbVc='}
