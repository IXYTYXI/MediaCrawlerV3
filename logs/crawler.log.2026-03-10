2026-03-10 23:19:38 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '688c971d000000002500ec76', 'type': 'normal', 'title': '高中全程陪跑！跟高途1v1学完真忘不了', 'desc': '⚠️ 高中三年想不慌，选对 “陪跑搭子” 太重要！\n❌ 知识点又多又难，好不容易记住的公式和概念，第二天就忘得一干二净；\n❌ 成绩卡在瓶颈上不去，家长心急如焚却无从下手……\n✅ 强烈给各位家长推荐高途一对一网课——从高一打基础到高三冲分全能选，老师盯得紧、方法学得牢，学过的知识点想忘都难～\n\t\n🎯 高途超值服务，一站式搞定高中学习\n✔️ 学前检测，1V1定制专属学习计划\n✔️ 班班预习提醒，学习进度全程跟进\n✔️ 1v1直播互动+重点查漏补缺\n✔️ 学后1v1批改作业，24小时在线答疑\n-\n🎯 高途科学模式+强大师资\n✔️ 多轮严选双一流学霸主讲\n✔️ 主讲传授大招+班班全程盯学\n✔️ 内容严格对应试要求，无缝衔接xiao内\n\t\n跟着高途，让专业老师带着孩子把每个知识点都学牢记牢\n点击左下角【立即咨询】领取1v1试听名额吧～\n活动时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#高一[话题]#\ufeff \ufeff#高二[话题]#\ufeff \ufeff#高三[话题]#\ufeff \ufeff#学习日常[话题]#\ufeff \ufeff#家长必读[话题]#\ufeff', 'video_url': '', 'time': 1754044189000, 'last_update_time': 1754044190000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '1', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102319/2f4143dc350024bcd2d43a4f1202d392/spectrum/1040g34o31kkvl4gpig205oakffv0j2co4cdhqs8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102319/bf9ed95caaffede67a56aaf20400b84c/spectrum/1040g34o31kkvl4gpig2g5oakffv0j2coarikmho!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,高一,高二,高三,学习日常,家长必读', 'last_modify_ts': 1773155978708, 'note_url': 'https://www.xiaohongshu.com/explore/688c971d000000002500ec76?xsec_token=ABpyvw13YbDaU1Uv_R4lkknv6lzoVoRdc1mb-JzYfFvA4=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABpyvw13YbDaU1Uv_R4lkknv6lzoVoRdc1mb-JzYfFvA4='}
