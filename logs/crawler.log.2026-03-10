2026-03-10 23:27:03 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '686624040000000013013fae', 'type': 'normal', 'title': '在家上1v1网课，全程陪跑卷到出分', 'desc': '😱 高中假期在家只想躺平刷剧？\n🤯 醒醒！你的对手已经偷偷连上 1v1 网课 “开挂” 了！\n✅ 从早到晚全程陪跑、知识点直接 “焊” 进脑子，让你学完忘不了！\n\t\n📣 一对一专属学习规划\n针对每个孩子的学习情况量身定制学习规划，吃透重点题型，掌握解题大招！\n📣 双师辅导闭环学习\n高途采用主讲+二讲双师辅导，从督学到答疑，从规划到伴学，全程陪跑！\n📣 三方会议高效沟通\n线上预约之后会有专门的老师和家长联系，初步沟通学情，老师根据！\n📣 全国各地考情库\n全国各地题库支持，全国各地学员学习经验荟萃\n\t\n📍 赶紧点击左下角【立即咨询】领取1v1试听吧～\n⏰ 活动时间：即日起-25年12月31日\n🙋 报名要求：仅面向32岁以上家长\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#高中[话题]#\ufeff \ufeff#高一[话题]#\ufeff \ufeff#高二[话题]#\ufeff \ufeff#高三[话题]#\ufeff', 'video_url': '', 'time': 1751524356000, 'last_update_time': 1751524357000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '9', 'collected_count': '1', 'comment_count': '1', 'share_count': '2', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102327/b20759d966132b4da577dffaa3e34f01/spectrum/1040g0k031jfe3rbf2a005oakffv0j2co8np5gog!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,高中,高一,高二,高三', 'last_modify_ts': 1773156423188, 'note_url': 'https://www.xiaohongshu.com/explore/686624040000000013013fae?xsec_token=ABqipxp4a6oPWAk9br2XGY0jM_J27fFAiwM-sBaB0fGxQ=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABqipxp4a6oPWAk9br2XGY0jM_J27fFAiwM-sBaB0fGxQ='}
