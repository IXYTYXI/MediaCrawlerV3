2026-03-10 17:57:59 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6814e80500000000230127b3', 'type': 'normal', 'title': '记录：一年级的超前学收获', 'desc': '[红色心形R]贾宝，六岁，坐标新一线城市，公办小学一年级男娃\n\t\n[向右R]4岁开始认字，用了半年时间学完高频字1300个,在后续的看书中，逐步增加词汇量，目前应该有2000多词汇量了。\n\t\n[向右R]4.5岁开始启蒙英语，上小学前积累了5000词汇量（百词斩测的），初章书中章书看了不少，家里的英语书堆满整个书架。\n\t\n[向右R]5岁10个月开始鸡数学。在此之前贾贾跟着幼儿园老师学会了20以内加减，幼升小暑假我带着他开始系统学习小学数学。目前数学刚学完4年级，浅奥学完学而思秘笈1-4级，高思导引学了一小段时间。按这个进度，2年级就能学完整个小学的数学，3年级想大力搞小奥。4-5年级学初中数学。\n\t\n[彩虹R]以上一共耗费2年8个月，超前学这条路我们会坚定不移地走下去\n#东莞[话题]# #小学数学[话题]# #小学家长[话题]# #一年级[话题]# #组队学习[话题]#', 'video_url': '', 'time': 1746200581000, 'last_update_time': 1746239394000, 'user_id': '5e3ed5c6000000000100242d', 'nickname': '贾宝学英语（二年级）', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo318tqr27lgm005nhuqn30891dhk8hj7o', 'liked_count': '204', 'collected_count': '276', 'comment_count': '156', 'share_count': '53', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603101753/9e99a19f8f5cc7fd2e2be146956ea30b/1040g00831h03cqb538505p2bot84mm0jg2dhro8!nd_dft_wlteh_webp_3', 'tag_list': '东莞,小学数学,小学家长,一年级,组队学习', 'last_modify_ts': 1773136679666, 'note_url': 'https://www.xiaohongshu.com/explore/6814e80500000000230127b3?xsec_token=AB5lDQ9eQOCDfu82JCuQLz15GEAH2dhyuSX5ljFFqSgg4=&xsec_source=pc_search', 'source_keyword': '数学超前学', 'xsec_token': 'AB5lDQ9eQOCDfu82JCuQLz15GEAH2dhyuSX5ljFFqSgg4='}
