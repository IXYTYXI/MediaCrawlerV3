2026-03-10 23:08:00 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68da39530000000013015977', 'type': 'normal', 'title': '高中停了线下班！转线上1v1效率真高', 'desc': '👉 高中生线下班常见痛点：多是 “浪费时间” 的坑\n▫️ 通勤耗时长，上课效率低，休息时间被严重挤压；\n▫️ 大班课 “陪跑”，课后没人答疑，疑问堆积到下周；\n▫️ 课后缺乏监督，学习效果打折扣...\n✅ 不少高中生家长纠结后，选择停掉线下全科班，转报高途线上1v1：无需赶路、针对性强，比线下班更省时间、效率更高！\n\t\n👉 【高途线上1v1：效率与负责兼具】\n🔥 时间灵活，效率翻倍：无需通勤，在家通过电脑即可上课，1v1直播授课，老师全程关注学生状态，有效减少走神；\n🔥 针对性强，拒绝无用功：报课先进行学情诊断，结合学生基础明确薄弱点，1节课解决 1个核心问题；\n🔥 双师全程盯学：除主讲老师授课外，专属班班全程跟进，及时答疑，定期向家长同步学习情况，保障学习连贯性！\n\t\n选择高途线上1v1—既高效又负责，能帮助高中生少走弯路～\n👇 点击左下角【立即咨询】领取1v1试学名额\n🙋 报名要求：32岁以上家长\n📆 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]#  #线上课[话题]# #线下转线上[话题]# #线上线下课[话题]# #学习日常[话题]# #学习经验[话题]#', 'video_url': '', 'time': 1759289155000, 'last_update_time': 1759289156000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '9', 'collected_count': '6', 'comment_count': '1', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102308/9caedf99d4e5b003e8e9423e24622a5c/spectrum/1040g0k031n0pmpaakq005oakffv0j2co73ocauo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102308/ffa51e30d4578cc615e32410f430ed20/spectrum/1040g0k031n0pmpaakq0g5oakffv0j2co6j8hquo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102308/504cb445382e5118a9acc74a09d95e08/spectrum/1040g0k031n0pmpaakq105oakffv0j2colhpf63g!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,线上课,线下转线上,线上线下课,学习日常,学习经验', 'last_modify_ts': 1773155280525, 'note_url': 'https://www.xiaohongshu.com/explore/68da39530000000013015977?xsec_token=ABnuWM8tUBDTVm0rlQoKRR9sb0oONYhyMuDkwp-QsXsHA=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABnuWM8tUBDTVm0rlQoKRR9sb0oONYhyMuDkwp-QsXsHA='}
