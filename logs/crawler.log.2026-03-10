2026-03-10 23:07:40 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68e8d2a00000000007023544', 'type': 'normal', 'title': '强推❗️超级负责的物理一对一网课', 'desc': '👉 高中物理补不动？问题多是 “没找对人”\n❌ 薄弱点找不准：刷了一堆题，越补越盲目；\n❌ 解题没思路：遇到综合题只会套公式，稍微变题型就慌；\n❌ 没人盯进度：上ke听懂了，ke后没练习、没复盘，知识点很快忘；\n直接跟着黄大桔老师的1v1网课，从 “找问题” 到 “练方法” 全到位，把每一步都做细了！\n\t\n✅ 周末在家就能学，依据基础薄弱程度，制定专属学习计划，效率更高\n✅ 黄大桔1v1在线直播传授高中物理解题技巧，提升解题能力\n✅ 专属班班全程陪伴式学习，防止拖延，确保按计划推进学习\n✅ 阶段测试，根据结果动态调整学习计划，不盲目学习\n\t\n高中物理想拔高，找对老师比瞎学强！跟着黄大桔搞定物理难点，稳稳进阶～\n点击左下角【立即咨询】领取1v1试学名额吧～\n🙋 报名要求：32岁以上家长\n📆 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #网课[话题]# #学物理原来这么简单[话题]# #高中物理[话题]# #高考物理[话题]# #高中网课[话题]#', 'video_url': '', 'time': 1760088736000, 'last_update_time': 1760088737000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '8', 'collected_count': '3', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102307/72198f5188691b88794cc6e4eb11b360/spectrum/1040g0k031nf1tvajks005oakffv0j2cod9i3g4o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102307/72154d886db5ae5ee32b9b30829bcfa7/spectrum/1040g0k031nf1tvajks0g5oakffv0j2coq0j5m08!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102307/e80601f6b52ddd7576c3dd1cb759b813/spectrum/1040g0k031nf1tvajks105oakffv0j2co0ivtlng!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,学物理原来这么简单,高中物理,高考物理,高中网课', 'last_modify_ts': 1773155260632, 'note_url': 'https://www.xiaohongshu.com/explore/68e8d2a00000000007023544?xsec_token=ABw7V_0d16TjVV-Y9RhzFE8s_bTnpDWGQDTSbED68pa7s=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABw7V_0d16TjVV-Y9RhzFE8s_bTnpDWGQDTSbED68pa7s='}
