2026-03-10 23:58:19 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6789d0b3000000002100259d', 'type': 'normal', 'title': '数理逆袭找一对一网课🔥出分特快', 'desc': '🎉 家有初三的各位家长请注意！一定要抓好最后一个寒假！\n数理想逆袭，跟着高途一对一网课在家这样做👇\n❶ 理解概念和公式\n❷ 多做实验，加深理解\n❸ 建立数理模型，培养解题思维\n-\n【为什么选择一对一网课】\n🔥 课前1v1预学\n课前摸底测，探测知识盲区，帮家长定位孩子短板，根据孩子喜好，个性化匹配老师\n🔥 1V1直播引导\n实时双向在线互动，课堂完成3个核心目标，细致剖析知识点，攻克学习难点\n🔥 课后1V1伴学\n报告分析大考试卷，找到知识薄弱点，课后批改，全程答疑，减轻家长陪读压力\n-\n📈 高科技监督➕陪伴\n✅ 智能诊断+大数据定位薄弱点+点对点巩固\n✅ 智能错题本功能，自行拍照收录，更便捷\n✅ 家长随时了解情况，查看👶情况\n-\n↙️点击左下方【立即咨询】了解课程试听~\n👫 面向人群：32岁以上家长群体\n📆 活动时间：即日起-2025年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#数理[话题]#\ufeff', 'video_url': '', 'time': 1737085107000, 'last_update_time': 1737085107000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '2', 'comment_count': '2', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102358/57308eb9ee6159a132d0b07525db8f1f/spectrum/1040g34o31co8ttp5161g5oakffv0j2coobu7l2g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102358/a16aabbbe68bce193a0d3b591fc17e27/spectrum/1040g34o31co8ttp516205oakffv0j2cotq5evpo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102358/16db745af03ab35dbfc44e6a9f9e2cc5/spectrum/1040g34o31co8ttp5162g5oakffv0j2cohvhnpio!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,数理', 'last_modify_ts': 1773158299855, 'note_url': 'https://www.xiaohongshu.com/explore/6789d0b3000000002100259d?xsec_token=ABCMdbT2GZscRFvW-fJ-Y1CG7Ac4_E4a9XMakJE9n7VUQ=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABCMdbT2GZscRFvW-fJ-Y1CG7Ac4_E4a9XMakJE9n7VUQ='}
