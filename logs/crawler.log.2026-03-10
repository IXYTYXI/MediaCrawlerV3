2026-03-10 21:29:15 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69ae90eb000000001d025193', 'type': 'normal', 'title': '每周2节课🔒死Mathplore新加坡数学小班！', 'desc': '性价比高的思维小班真不好找❌\n给二年级娃报了Mathplore新加坡数学\n一周2节，内容全面又扎实，方法科学又高效，性价比直接拉满！这次真的稳了！\n-------------\n🔥老师懂引导、懂教学\n不是灌输式教学，而是用孩子能懂的案例、感兴趣的动画、游戏带娃真正理解数学逻辑，学懂更会用\n\t\n🔥小班直播，关注多，互动多\n严格将人数控制在2-6人，通过游戏互动去关注每位孩子，人均互动次数达8次+，比大班课效率高太多！\n\t\n🔥深耕本土学情，分层授课\n结合本地学情+国际体系研发，G0-G6完整覆盖幼小全阶段，目标清晰节奏科学，普娃也能跟得上\n---------------\n🏆全球120+国家和地区都在使用的CPA教学法\n从具象感知-形象表达-抽象转化，三步构建孩子思考逻辑链，懂原理，会应用，不用死记硬背也能扎实学好数学\n\t\n🙎\u200d♀️五师一体，多角色协作，从课前预习-课中精讲-课后巩固-阶段测评，家长随时掌握学习动态，孩子进步肉眼课件，负责到开窍为止！\n----------------\n📌课程提供全中/全英两种语言班型\n家长可根据孩子学习需求、基础进行选择\n班型间无差价，调换灵活，中教外教都能选\n-----\n👉戳@Mathplore数学开窍 领0元试听课，先试再报，不踩雷🎉🎉\n活动时间：即日起至2030年12月31日\n* 仅面向海外18+家长\n#新加坡数学[话题]# #数学思维[话题]# #数学学习[话题]# #Mathplore[话题]# #数学[话题]# #小学数学[话题]# #开窍[话题]# #小学数学提升[话题]# #数学开窍[话题]#', 'video_url': '', 'time': 1773048043000, 'last_update_time': 1773048402000, 'user_id': '66c854d2000000001d022cac', 'nickname': 'Mathplore数学开窍', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31djmkng2h66g5pm8aj97cb5cr77jngg', 'liked_count': '3', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '四川', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102129/c00f3dd6b0a9cdfc7aa5066424f9b875/spectrum/1040g34o31tfrli8n5a0g5pm8aj97cb5c2c2k20g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102129/93e9950a5d56f25dfa9dc5b75bdd693a/spectrum/1040g0k031tg5cho4l6005pm8aj97cb5cp29vp5g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102129/b06fde167fdc059862ee289fc4301a93/spectrum/1040g0k031tg5cho4l60g5pm8aj97cb5c3t1pcrg!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学,数学思维,数学学习,Mathplore,数学,小学数学,开窍,小学数学提升,数学开窍', 'last_modify_ts': 1773149355942, 'note_url': 'https://www.xiaohongshu.com/explore/69ae90eb000000001d025193?xsec_token=AB-w_qzoOURA9QpHihjgrBIMmf6efStIBc2taaPltEVes=&xsec_source=pc_search', 'source_keyword': '', 'xsec_to