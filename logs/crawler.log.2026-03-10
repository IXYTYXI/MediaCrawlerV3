2026-03-10 21:31:54 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a7ffd1000000001b01c58f', 'type': 'video', 'title': '刷再多题不如学透思维❗ 亲测有效', 'desc': '明明没少刷题，可一遇到变式题就抓瞎🤦\u200d♀️\n校内成绩勉强过得去，一做大题就思维短路，完全找不到切入点。\n其实症结在于——❌数学思维还在“浅水区”扑腾！\n还好遇到了Mathplore新加坡数学，这学期终于看到了“开窍”的曙光❗ @双眼皮芝芝\n\t\n🔥Mathplore凭什么能帮孩子“爆改”？\n\t\n🌟 新加坡CPA教学法，直击痛点\n✅具象感知：用实物演示，让孩子“摸”到数学\n✅形象建模：画图拆解难题，逻辑清晰看得见\n✅抽象思维：从懂一道题到通一类题，举一反三\n\t\n🚀Mathplore新加坡数学直播课亮点\n✔️覆盖G0-G6，校内夯实基础+校外思维拓展\n✔️对标AMC8等国际竞赛，拓宽视野\n✔️CPA三步进阶：告别死记硬背，建立底层逻辑\n✔️金牌师资团队：名校背景，懂教学更懂引导\n✔️精品小班制：2-6人互动，全程关注，效率翻倍\n\t\n🔥快点点击左下角【立即咨询】领取免费的试听大礼包吧~\n⏰ 活动时间：即日起至2028年12月31日\n📍 面向海外18岁以上家长\n#小学数学[话题]#  #Mathplore新加坡数学[话题]#  #Mathplore[话题]#  #数学开窍[话题]#  #数学思维[话题]#  #趣味数学[话题]#  #提升孩子思维能力[话题]#', 'video_url': 'http://sns-video-al.xhscdn.com/stream/1/110/259/01e9a7ffbbc5eb6b010370039cb83fda6a_259.mp4', 'time': 1772617681000, 'last_update_time': 1772617682000, 'user_id': '66c854d2000000001d022cac', 'nickname': 'Mathplore数学开窍', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31djmkng2h66g5pm8aj97cb5cr77jngg', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '四川', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102131/3fbc183aac8414f33eb98a86e19a22b5/spectrum/1040g0k031t9o6htg5a005pm8aj97cb5cbs4jdg8!nd_dft_wlteh_webp_3', 'tag_list': '小学数学,Mathplore新加坡数学,Mathplore,数学开窍,数学思维,趣味数学,提升孩子思维能力', 'last_modify_ts': 1773149514468, 'note_url': 'https://www.xiaohongshu.com/explore/69a7ffd1000000001b01c58f?xsec_token=ABvtKkoN-JdN_qRqzuJpkmXIc5HyxcOshz8trufEs8NeY=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABvtKkoN-JdN_qRqzuJpkmXIc5HyxcOshz8trufEs8NeY='}
