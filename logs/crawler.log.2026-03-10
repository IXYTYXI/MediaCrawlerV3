2026-03-10 22:58:05 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69251983000000001e024c8a', 'type': 'normal', 'title': '灵活约课❗️高中数学逆袭选高途1v1', 'desc': '🤔 高中数学遇瓶颈，期末提芬没方向？\n😭 传统课程时间难适配？\n✅ 高途1v1来救场！灵活约课，定制计划，全程跟进，助力冲刺逆袭！\n\t\n👉 选网课，最怕不灵活、没效果，高途直接把 “贴心” 和 “高效” 拉满：\n\t\n🎯 灵活约课不折腾，不用迁就固定课表！随时能约课，一人一个班专属课堂，不用浪费时间赶场子，在家就能高效学；\n\t\n🎯 计划具体到每天，学习不盲目！结合基础目标，定制专属方案，具体到每天学什么，不用花时间想规划；\n\t\n🎯 全程监督陪跑，不用家长盯！从1v1直播带学，到课后作业批改、24小时答疑，一整套学习方案闭环，家长完全不用费心；\n\t\n高途从灵活约课到定制方案，再到全程陪跑，每一步都为逆袭铺路～\n↙️ 点击左下方【立即咨询】领取1v1试学名额～\n🔍 报名要求：32岁以上家长\n⏰ 截止时间：即日起-26年12月31日\n#高途[话题]# #高中网课[话题]# #高中数学怎么学[话题]# #高中数学[话题]# #线上教学[话题]# #课程辅导[话题]# #一对一[话题]#', 'video_url': '', 'time': 1764039043000, 'last_update_time': 1764039044000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '1', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102258/325bfc8e30ff7220018f463712f6bd0f/spectrum/1040g34o31p9tirmii6305oakffv0j2coamn8vj0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102258/5b5da512eda88cf9dff254646320255f/spectrum/1040g34o31p9tirmii63g5oakffv0j2cos19nhq8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102258/208aceadac90146d059dfd831ac6de41/spectrum/1040g34o31p9tirmii6405oakffv0j2cour0q6a8!nd_dft_wlteh_webp_3', 'tag_list': '高途,高中网课,高中数学怎么学,高中数学,线上教学,课程辅导,一对一', 'last_modify_ts': 1773154685130, 'note_url': 'https://www.xiaohongshu.com/explore/69251983000000001e024c8a?xsec_token=ABCno0QiLioCS8fy-YMr1sfrClTKQrUBB5q0-TLl_8bV8=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABCno0QiLioCS8fy-YMr1sfrClTKQrUBB5q0-TLl_8bV8='}
