2026-03-10 23:55:25 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67b013fc0000000029031222', 'type': 'normal', 'title': '别卷了！跟着高途1v1学负责到出分为止', 'desc': '👋 你是否还不知道，👶如何改善成ji？快来看看高途！\n1⃣ 基础薄弱，对kao试充满畏惧？\n2⃣ 单科拖后腿导致总fen不稳定？\n3⃣ 想自学却无头绪？\n-\n别担心！我们的高途1对1课程就是为👶量身打造的🤳\n✅ 2V1教学：主讲+专属班班老师，每天拉着往前冲~\n✅ 多轮严选名校毕业的学霸担任主讲，多年教龄\n✅ 价格公道，课程➕课前课中课后服务➕1v1批改➕测试……\n✅ 跟随👶时间上课！系统课程，从基础到提高，掌握所有要点\n-\n最主要！现在咨询🉐免费检测+定制学习计划\n⭕ 点击左下角【立即咨询】了解课程详情和价格\n*面向32岁以上家长\n*截止时间：即日起至-2025年12月31日\n\ufeff#高途[话题]#\ufeff\xa0\ufeff#一对一[话题]#\ufeff\xa0\ufeff#网课[话题]#\ufeff\ufeff', 'video_url': '', 'time': 1739592700000, 'last_update_time': 1742540107000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102355/2ed2f24100561e16988c1db25fe5ec80/spectrum/1040g34o31dtkj0mr081g5oakffv0j2coqg0b0h8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102355/a25ae5f73335579ddf2407bc06506a0e/spectrum/1040g34o31dtkj0mr08205oakffv0j2co2to5img!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102355/56740611c3cb0c3d74dc5ffb1f0927cd/spectrum/1040g34o31f9i3c8vls0g5oakffv0j2co1s38j0g!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课', 'last_modify_ts': 1773158125911, 'note_url': 'https://www.xiaohongshu.com/explore/67b013fc0000000029031222?xsec_token=AB6RrcZzGXiyMa4XQxZNa1mTiJN8gwUE2p8Cxq8BdROW0=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB6RrcZzGXiyMa4XQxZNa1mTiJN8gwUE2p8Cxq8BdROW0='}
