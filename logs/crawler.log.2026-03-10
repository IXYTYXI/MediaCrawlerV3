2026-03-10 22:56:37 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69300d28000000000d03422a', 'type': 'normal', 'title': '高途1v1陪跑高三复习！负责到出分', 'desc': '📣 家有 26 届高考生，越临近越焦虑：\n🤔 孩子基础弱不知道从哪补、自学没方向瞎刷题\n🥹 遇到难题没人管、学习进度摸不清…\n✅ 对比N家后选了高途高考1v1，全程陪跑+24h答疑，终于不用再揪着心盯学习！\n\t\n👉 这些高考备考问题，高途1v1全解决\n▫️ 基础薄弱 / 0 起步，不知如何规划？\n高途1v1直接给一站式提分规划，根据学情定制课程，细致到每节课的复习目标；\n\t\n▫️ 怕遇到 “伪名师”，白花钱没效果？\n严选名校毕业学霸主讲，还得持证上岗，1v1直播带学精准覆盖重难点；\n\t\n▫️ 疑问攒一堆，没人及时解答？\n7*24 小时答疑不打烊！错题当场拆解，疑问不隔夜，学习节奏不被打断；\n\t\n👉 保姆级陪跑服务，从起步到出分不脱节\n课前：精准检测学情，找准知识盲区，避免无效复习；\n课中：1v1直播互动，实时盯专注度，听不懂随时叫停重讲；\n课后：作业批改 + 随时答疑 + 阶段测评，形成完整学习闭环。\n\t\n26高考拼的不是时间，是效率和靠谱的引导！\n赶紧点击【立即咨询】预约1v1试学吧～\n报名要求：仅面向32岁以上家长\n活动时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #高考逆袭[话题]# #高考冲刺[话题]# #高考复习[话题]# #学习规划[话题]# #高三复习[话题]#', 'video_url': '', 'time': 1764810960000, 'last_update_time': 1764756777000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102256/c6cfb020a0a39054c03e66f6b146aba6/spectrum/1040g0k031pkjqejp3s005oakffv0j2co44juor0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102256/a64f8bdfd36336f1cc1415f352581167/spectrum/1040g0k031pkjqejp3s0g5oakffv0j2coi7rb53g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102256/a741affd6bd37a5dea37ce138841c2e8/spectrum/1040g0k031pkjqejp3s105oakffv0j2cos3msivo!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,高考逆袭,高考冲刺,高考复习,学习规划,高三复习', 'last_modify_ts': 1773154597371, 'note_url': 'https://www.xiaohongshu.com/explore/69300d28000000000d03422a?xsec_token=ABccRRpIQ2vzxkw55WdyG1-Jjqe8JxYInmum4QnW0uZDA=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABccRRpIQ2vzxkw55WdyG1-Jjqe8JxYInmum4QnW0uZDA='}
