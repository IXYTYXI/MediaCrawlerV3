2026-03-10 16:06:25 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '682499e200000000230125c7', 'type': 'normal', 'title': '超前学➕奥数刷题\n你们都是怎么办到的？\n娃三年级，校内不用操心，奥数学的是深奥，一边夯实校内基础，一边刷题巩固奥数知识，打算五年级择校考上岸。花钱找当地明师给他规划，让数学和英语超前学，英语超前已经做了，但总挤不出时间做数学的超前学…ps.我不打算让小学生晚睡，晚上8点40之前必须离开书桌准备洗澡睡觉。那些学霸都是怎么安排的时间？学习好，还各种才艺考级……\n#家有小学生[话题]# #奥数[话题]##超前学[话题]# #鸡娃[话题]# #卷[话题]#', 'desc': '超前学➕奥数刷题\n你们都是怎么办到的？\n娃三年级，校内不用操心，奥数学的是深奥，一边夯实校内基础，一边刷题巩固奥数知识，打算五年级择校考上岸。花钱找当地明师给他规划，让数学和英语超前学，英语超前已经做了，但总挤不出时间做数学的超前学…ps.我不打算让小学生晚睡，晚上8点40之前必须离开书桌准备洗澡睡觉。那些学霸都是怎么安排的时间？学习好，还各种才艺考级……\n#家有小学生[话题]# #奥数[话题]##超前学[话题]# #鸡娃[话题]# #卷[话题]#', 'video_url': '', 'time': 1747229154000, 'last_update_time': 1747352423000, 'user_id': '659c9591000000002001dda3', 'nickname': '立志做一个好妈妈', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31hr799g4j40g5pcsim8o3nd3u7al51g', 'liked_count': '334', 'collected_count': '532', 'comment_count': '273', 'share_count': '108', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603101559/753892d199b8c40e5d35e6a00b8137b1/1040g2sg31hfdp9ue4q005pcsim8o3nd37c2cen0!nd_dft_wlteh_webp_3', 'tag_list': '家有小学生,奥数,超前学,鸡娃,卷', 'last_modify_ts': 1773129985675, 'note_url': 'https://www.xiaohongshu.com/explore/682499e200000000230125c7?xsec_token=ABwXi3n0hZQqpyW0VJ-uzGX1-TVGekePMnjijJkHht_OQ=&xsec_source=pc_search', 'source_keyword': '数学超前学', 'xsec_token': 'ABwXi3n0hZQqpyW0VJ-uzGX1-TVGekePMnjijJkHht_OQ='}
