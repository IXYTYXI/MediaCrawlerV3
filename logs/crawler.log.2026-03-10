2026-03-10 22:29:37 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69aab533000000002603d332', 'type': 'normal', 'title': '高中数学救星！线上1对1带你逆袭前三🚀', 'desc': '还在为娃数学成绩发愁？\n基础差跟不上，刷题没效果，考试总在及格线徘徊😣\n掌门一对一高中数学课程，每晚1小时名师线上1对1，\n专收数学差生，带你逆袭前三👏\n-\n🌟【分层教学，基础弱也不怕】\n清北名师从基础公式讲起，函数、几何、导数逐个击破，让娃真正“开窍”\n🌟【定制提升，中等生冲高分】\n入学先做知识漏洞诊断，锁定薄弱模块精准突破，成绩蹭蹭涨📈\n🌟【拓展拔高，尖子生更优秀】\n专攻克压轴题，挑战导数解析几何，冲刺140+🏆\n👩\u200d🏫【清北师资，教学有保障】\n985/211导师均经6轮严选，教学经验丰富，懂高考更懂学生\n📈【全程督学，进步看得见】\n三师伴学+全天答疑+每周学情报告，学习状态全程在线\n-\n🔥现在点击下方【立即咨询】0 元 get 1 对 1 体验课！\n📢报名要求：32 岁以上家长\n⏰截止时间：即日起 - 2026 年 12 月 31 日\n#掌门[话题]#  #掌门一对一[话题]#  #学习规划[话题]#  #家长必看[话题]#  #高三[话题]#  #高二[话题]#  #高一[话题]#  #高中数学[话题]#  #清北名师[话题]#  #数学逆袭[话题]#', 'video_url': '', 'time': 1772795187000, 'last_update_time': 1772795188000, 'user_id': '649a8e5f000000001001c410', 'nickname': '掌门1对1知识分享', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/65d83c913237730001928a26.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '上海', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102229/9f8fbd8e94c32bc7e9fbbf4281271233/spectrum/1040g34o31tccr51v56305p4qhpfk3h0gk4p6bng!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102229/17a9dee036c99559f7872cc793740342/spectrum/1040g34o31tccr51v563g5p4qhpfk3h0g3jjlmh8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102229/0d9e5feb87c0f0c4eee8b918becdb902/spectrum/1040g34o31tccr51v56405p4qhpfk3h0g3ulod10!nd_dft_wlteh_webp_3', 'tag_list': '掌门,掌门一对一,学习规划,家长必看,高三,高二,高一,高中数学,清北名师,数学逆袭', 'last_modify_ts': 1773152977617, 'note_url': 'https://www.xiaohongshu.com/explore/69aab533000000002603d332?xsec_token=ABEY8sU4xINMp3qbyKnY2hi-I0Dj2yvA-6OkAJSZsDbPM=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABEY8sU4xINMp3qbyKnY2hi-I0Dj2yvA-6OkAJSZsDbPM='}
