2026-03-10 23:36:10 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68394cb6000000000f039937', 'type': 'normal', 'title': '高二暑假偷跟1v1，开学直接降维打击', 'desc': '❌ 9月开学即将高三请注意，千万别踩坑！\n以前总觉得 “一轮复习开学再搞来得及”，结果：\n▫️ 开学后知识点太多，根本跟不上进度\n▫️ 别人已经刷压轴题，你还在补三角函数公式\n▫️ 想短期突击，却发现连基础题都错一堆\n高二暑假才是抢跑黄金期！！现在跟着 1v1 提前学，开学直接赢在起跑线～\n✅ 1v1定制学习方案：每节课针对性教学，时间不浪费，效果翻倍提升！\n✅ 1v1直播互动：薄弱环节提升，逐个攻破重难点，让解题更加得心应手！\n✅ 1v1班班全程陪伴：课后精批作业，阶段测试，随时调整学习计划更高效！\n高二暑假不跟1v1抢跑一轮，开学只能看别人 “碾压”！\n赶紧点击左下角【立即咨询】即可领取1v1试听\n活动时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff\xa0\ufeff#一对一[话题]#\ufeff\xa0\ufeff#高中[话题]#\ufeff\xa0\ufeff#网课[话题]#\ufeff\xa0\ufeff#一轮复习[话题]#\ufeff\ufeff', 'video_url': '', 'time': 1748654041000, 'last_update_time': 1748827647000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102336/decb3c89b0eea2b8906f864b72e0b8c4/spectrum/1040g0k031i3kqp0pmq005oakffv0j2co0cr2jr0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102336/8449580fe94bba4343786b67902844da/spectrum/1040g0k031i3kqp0pmq0g5oakffv0j2co6v670j0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102336/c5141cacd3ee93d586fd7d8db9d574aa/spectrum/1040g0k031i3kqp0pmq105oakffv0j2cofuvsj40!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中,网课,一轮复习', 'last_modify_ts': 1773156970807, 'note_url': 'https://www.xiaohongshu.com/explore/68394cb6000000000f039937?xsec_token=AB0g3976cXjNme1HZWBddwR2EfGp61C99R_MkBtDC3IqI=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB0g3976cXjNme1HZWBddwR2EfGp61C99R_MkBtDC3IqI='}
