2026-03-10 23:18:31 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '688c99ef00000000220388b8', 'type': 'normal', 'title': '高中冲刺选1v1陪跑！高途全程护送出分', 'desc': '📣 高一学了一堆知识点却不成体系，高二遇到难点越学越慌，高三刷题无数却抓不住重点…… 家长想帮却插不上手😮\u200d💨\n👍 还好有高途高中1v1网课，全程陪跑1人1班定制课程，让孩子在冲刺路上不迷路，家长也能踏实陪考～\n\t\n【选择高途一对一网课，轻松助力学习】\n✅ 1V1专属直播课，名师在线实时互动\n✅ 精准匹配校内进度，随学随用更高效\n✅ 个性化难度分级，量身定制教学内容\n✅ 系统培养思维，掌握科学解题方法\n✅ 智能诊断学习盲区，靶向突破薄弱环节\n-\n跟着高途1v1从报名到出分全程护航，孩子学得踏实，家长也能少些焦虑\n感兴趣的家长赶紧点击左下角【立即咨询】领取1v1试听特权吧～\n报名要求：仅面向32岁以上家长\n活动时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#学习日常[话题]#\ufeff \ufeff#名师[话题]#\ufeff', 'video_url': '', 'time': 1754096531000, 'last_update_time': 1754044911000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '2', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102318/93ac44f7128e15a9759f4dafd423134b/spectrum/1040g0k031kl00epj2a005oakffv0j2co5mfcpmg!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,学习日常,名师', 'last_modify_ts': 1773155911515, 'note_url': 'https://www.xiaohongshu.com/explore/688c99ef00000000220388b8?xsec_token=ABpyvw13YbDaU1Uv_R4lkknk19zcVPnzKDEU0un6I_WyM=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABpyvw13YbDaU1Uv_R4lkknk19zcVPnzKDEU0un6I_WyM='}
