2026-03-10 16:08:42 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6753c9d0000000000203974d', 'type': 'normal', 'title': '五年级超前自学：六上数学学霸刷到第3单元👏', 'desc': '五年级是一场洗礼，期中考三门第一落下帷幕\n期中考后整装待发，学校12月紧锣密鼓提速中。                      🧮数学\n五上解方程这单元108分，很遗憾白丢了两分！\n语文稳定，英语稳定，英语连续4单元满分💯\n超前自学，只用周末，周中忙碌得像螺丝钉🔩\n目前自学到六上第三单元的“分数除以整数”✅\n校内98以上有能力超前自学一定要周末挤时间\n寒暑假更是超前自学的好时机：保证思维连贯！\n🦜英语\n五年级英语融合很多语法知识\n能够一直保持班级第一，无非就是“背诵”！\n课内单词百分百要对，每周背诵默写作文📓\n作文可以选带音频的，每天磨耳朵十分钟✅\n📚语文\n语文和英语靠长积累，广泛阅读➕背文言文\n最近背诵《陈涉世家》，课外课内并行不悖👏\n语数英主课拉到天花板，才是为初中学习减压\n💻编程\n已经通过python 九级，争取年前通过十二级✅\n🏀运动\n每周六周日保障运动4小时\n身体心理健康永远是第一☝️\n#超前学[话题]# #小学数学怎么学[话题]# #数学[话题]# #小升初英语[话题]# #小升初数学[话题]# #小学生的学习习惯[话题]# #提前学数学[话题]# #五年级[话题]# #提前学[话题]# #语文[话题]#', 'video_url': '', 'time': 1733544400000, 'last_update_time': 1733830896000, 'user_id': '58ac059250c4b415f11d1b19', 'nickname': '吴比乐同学', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31oaaem5hmm00496d432p46op0cgu0ao', 'liked_count': '73', 'collected_count': '61', 'comment_count': '16', 'share_count': '2', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603101602/638b26251a1ad58c2cedf955fcc4c403/1040g00831b7p7n4jne00496d432p46op81d9buo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101602/2105aa664d70af4bc38dcacd5e087e82/1040g2sg31b3gjl1l7a7g496d432p46opjp9jp9g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101602/7de880f47301a5c63378cc71e2351994/1040g2sg31b3gjl1l7a80496d432p46opv9vvkfg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101602/5424263d80b3d4af86a4603d075b6fc7/1040g2sg31b3gjl1l7a8g496d432p46ope6gh34o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101602/0dedfe655538c6b4d958cc80f1180b8a/1040g2sg31b3gjl1l7a90496d432p46opss4njso!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101602/72b3a17194a0a17cd3da680e27329d2c/1040g2sg31b3gjl1l7a9g496d432p46opjers9h0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101602/1a2b0982166ead46153dc31b2d308831/1040g2sg31b3gjl1l7aa0496d432p46ope7gn3tg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101602/9aa2211190ad8f58ed27fac577e9379c/1040g2sg31b3gjl1l7aag496d432p46opha4spf0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101602/11145f263315d5b0c07072fcea1f82b5/1040g2sg31b3gjl1l7ab0496d432p46op60hvgao!nd_dft_wlteh_webp_3', 'tag_list': '超前学,小学数学怎么学,数学,小升初英语,小升初数学,小学生的学习习惯,提前学数学,五年级,提前学,语文', 'last_modify_ts': 1773130122698, 'note_url': 'https://www.xiaohongshu.com/explore/6753c9d0000000000203974d?xsec_token=ABaiZm1EKw5HP_g9v65hWFTLCBO508uFYvbjrpqjcs80A=&xsec_source=pc_search', 'source_keyword': '数学超前学', 'xsec_token': 'ABaiZm1EKw5HP_g9v65hWFTLCBO508uFYvbjrpqjcs80A='}
