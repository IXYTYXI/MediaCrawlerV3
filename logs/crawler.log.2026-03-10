2026-03-10 21:04:54 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a95b3300000000150217a3', 'type': 'video', 'title': '开学数学不再愁！小班课真香🔥', 'desc': '开学最怕数学拖后腿！听课像听天书、作业磨蹭到大半夜，老母亲血压蹭蹭涨...😫 试过各种大招，最后发现还是小班课最管用！跟着学了半学期，娃现在的状态简直绝了，不仅作业写得快，还敢跟我显摆解题思路了✨@瓶子媽媽\n\t\n✅ 互动高频，专注力拉满\n2-6人精品小班，老师时刻盯着，娃想走神都难，每个孩子都能被关注，课堂参与感超强，不敢举手的普娃也能大胆开麦。\n\t\n✅ CPA建模，思维更清晰\n不只教做题，更重底层逻辑。用画图、建模把抽象概念变具象，娃真正理解了原理，学会举一反三，遇到新题也不怕。\n\t\n✅ 紧跟校内，同步拔高\n课程体系完美匹配新学期进度，校内基础打牢，思维拓展跟上，考试做题不慌张，稳步提升成绩。\n\t\n✅ 科学规划，轻松坚持\n每周固定频率，时长适中不费眼，不占用过多课余时间，娃学得开心，好习惯也自然养成了。\n\t\n✅ 师资过硬，全程答疑\n严选资深师资，课上引导思考，课后1v1反馈，哪里薄弱补哪里，家长彻底放手更省心。\n新学期选对这趟小班课，数学轻松领跑，普娃也能逆袭成学霸～\n\t\n🔥 点击左下角【立即咨询】即可领取价值1888元学习礼包。\n名额有限，欢迎把握机会。\n——\n活动时间：即日起至2028年12月31日\n面向18岁以上海外家长群体\n#数学开窍[话题]#  #Mathplore新加坡数学[话题]#  #Mathplore[话题]#  #小学数学怎么学[话题]#  #数学启蒙[话题]#  #让孩子爱上数学[话题]#  #Mathplore[话题]#  #数学学习[话题]#', 'video_url': 'http://sns-video-al.xhscdn.com/stream/79/110/259/01e9a95a8c2f3c56010370039cbd8c8f49_259.mp4', 'time': 1772710261000, 'last_update_time': 1772706611000, 'user_id': '5ff43d2b0000000001001995', 'nickname': 'Mathplore线上数学', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/640f03dce33a6ed3c5116b3d.jpg', 'liked_count': '1', 'collected_count': '1', 'comment_count': '1', 'share_count': '', 'ip_location': '四川', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102104/aec6d54ca4a2cd8335af068fafe77d9d/spectrum/1040g0k031tb2jvhd6e105nvk7klg86cld3ccnmo!nd_dft_wlteh_webp_3', 'tag_list': '数学开窍,Mathplore新加坡数学,Mathplore,小学数学怎么学,数学启蒙,让孩子爱上数学,Mathplore,数学学习', 'last_modify_ts': 1773147894481, 'note_url': 'https://www.xiaohongshu.com/explore/69a95b3300000000150217a3?xsec_token=ABkXiiT8OoWfy0U4yQ6YI3tiaShwmCaK6jv1CNPwhAbZg=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABkXiiT8OoWfy0U4yQ6YI3tiaShwmCaK6jv1CNPwhAbZg='}
