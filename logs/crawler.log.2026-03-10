2026-03-10 23:25:38 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '686f189c000000000b02efee', 'type': 'normal', 'title': '暑假10天搞定数学一轮，高考都不忘！', 'desc': '高三数学一轮复习还在磨磨蹭蹭？\n别人已经用1v1网课把函数、几何、概率吃透了！名师带着拆解真题，每天精准突击，花更少时间、更准的钱，学完像刻在脑子里，刷题能条件反射出思路！\n\t\n🔥 【跟高途1v1高效学习】\n✅ 时间灵活随时学：在家就能学，1v1上课时间超灵活，随时根据孩子的时间安排调整，不用接送家长更省心！\n✅ 全程严管盯学：课前预习，课中有任何走神的迹象，老师会立刻调整教学方式，课后跟盯学习效果！\n✅ 家长省心更放心：1v1针对性定位孩子的薄弱点，才能真正补到位，让每一分钱都花在刀刃上！\n\t\n别再让高中数学拖后腿啦！这个暑假打牢基础，带着满满的底气进入高三冲刺期！\n↙️ 点击左下角【立即咨询】领取1v1试听权限\n⏰ 活动时间：即日起-2025年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#高中[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#高三一轮[话题]#\ufeff \ufeff#高三数学[话题]#\ufeff', 'video_url': '', 'time': 1752111260000, 'last_update_time': 1752111261000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '4', 'collected_count': '4', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102325/a54f6af59de2128373c0799270df00ad/spectrum/1040g0k031jo5v86o48105oakffv0j2coajnbo50!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102325/5bd191929c148480981a176a0c214cef/spectrum/1040g0k031jo5v86o481g5oakffv0j2coodn6cig!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102325/c2bb7e490684aca3571525bb4bec4188/spectrum/1040g0k031jo5v86o48205oakffv0j2co3734bho!nd_dft_wlteh_webp_3', 'tag_list': '高途,高中,一对一,网课,高三一轮,高三数学', 'last_modify_ts': 1773156338667, 'note_url': 'https://www.xiaohongshu.com/explore/686f189c000000000b02efee?xsec_token=ABqJmkmJAf0neNFA-MkLd2HNGKBobCVHZ2rPksn2I8X2g=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABqJmkmJAf0neNFA-MkLd2HNGKBobCVHZ2rPksn2I8X2g='}
