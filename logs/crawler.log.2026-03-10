2026-03-10 23:15:12 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68a869b9000000001c00b5cd', 'type': 'normal', 'title': '新⑦衔接高途护航，1对1学更轻松', 'desc': '⚠️ 各位家长注意了！“衔接坎” 真的能拉开差距\n👉 新⑦衔接没做好，整个3年都可能追着跑！\n✅ 还好有高途1对1，帮助平稳过渡，轻松领跑～\n\t\n🔥 课程内容：\n👉 5轮严选资深985/211名校学霸主讲，多年经验\n👉 2v1保姆级督学服务，主讲+班班全程陪跑\n👉 24小时在线随时答疑解惑，作业精批\n\t\n🔥 高途一对一闭环体系：\n👉 学之前充分与家长沟通，了解基础水平，根据基础和目标实际，情况1v1定制学习计划\n👉 高途系统学习体系，分为3阶段，基础—强化—冲刺，层层递进，逐步拔高学习水平\n👉 学后专属班班24小时在线随时答疑解惑，主讲+班班全程，保姆式陪伴，紧盯不走神\n\t\n新⑦衔接做好了，学得轻松有信心，家长也能少焦虑～\n点击左下角【立即咨询】即可领取1v1试学名额～\n报名对象：仅面向32岁以上家长\n活动时间：即日起-26年12月31日\n\ufeff#一对一[话题]#\ufeff \ufeff#高途[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#学习日常[话题]#\ufeff \ufeff#衔接[话题]#\ufeff \ufeff#家长必读[话题]#\ufeff', 'video_url': '', 'time': 1755867577000, 'last_update_time': 1755867577000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102315/b6df26383f81b24d95d46ab95e4dbff6/spectrum/1040g0k031lg543h650005oakffv0j2couo8anc0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102315/e37da83701fab97a6ab54f84334567d1/spectrum/1040g0k031lg543h6500g5oakffv0j2coolpchu8!nd_dft_wlteh_webp_3', 'tag_list': '一对一,高途,网课,学习日常,衔接,家长必读', 'last_modify_ts': 1773155712958, 'note_url': 'https://www.xiaohongshu.com/explore/68a869b9000000001c00b5cd?xsec_token=ABW16h-jAGl4a1EwxXENEgxQxHbQrt84EUvAS1G_H2RJY=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABW16h-jAGl4a1EwxXENEgxQxHbQrt84EUvAS1G_H2RJY='}
