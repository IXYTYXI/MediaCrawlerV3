2026-03-10 23:23:01 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6878a1030000000013012206', 'type': 'normal', 'title': '1v1新高三7月从头学，双师全程陪跑', 'desc': '📖 新高三想逆袭，7月从头学真的不晚！\n🏃 高途1v1直接上 “双师陪跑” 狠活\n🧑\u200d🏫 双一流名师每天直播带学，督学老师 24 小时盯进度\n⏰ 15天就能看到变化，详细到每天每小时的学习计划，这节奏想不进步都难！\n\t\n高途的服务体系👇\n🔥 一套高效完整的复习方案，完全不用自己瞎规划，老师直接甩出计划表；\n🔥 全程高频互动，老师太懂 “上课走神” 的痛，全程用 “强互动” 锁死注意力；\n🔥 边讲边练习，刚懂就练练错立刻补，错1道就加练几道同类题，趁热打铁吃透知识点；\n🔥 个性化提分方案，入学先做深度诊断，漏洞就是主攻方向；\n🔥 专属班班全程督学，从早到晚被班班 “360° 无死角盯学”，这才是高三该有的效率！\n\t\n新高三这波冲刺，一定要跟着1v1精准学习，太值了！\n🎁 点击【立即咨询】即可领取1v1专属试学名额\n⏰ 活动时间：即日起-26年12月31日\n🙋 报名要求：仅面向32岁以上家长\n\ufeff#高途[话题]#\ufeff \ufeff#高中[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#高三[话题]#\ufeff \ufeff#一轮复习[话题]#\ufeff', 'video_url': '', 'time': 1752736003000, 'last_update_time': 1752736003000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102323/95d4f21e06569b05074186a35689422e/spectrum/1040g0k031k1frqm9jq005oakffv0j2co9v6lf6o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102323/7697f76acb3ffa580a6c9e15337e71cf/spectrum/1040g0k031k1frqm9jq0g5oakffv0j2cofi3kh10!nd_dft_wlteh_webp_3', 'tag_list': '高途,高中,一对一,网课,高三,一轮复习', 'last_modify_ts': 1773156181636, 'note_url': 'https://www.xiaohongshu.com/explore/6878a1030000000013012206?xsec_token=AB8CR3kcsUfNMvn-S4wwqefWQY_ZeJWfYH-ubU3celNX0=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB8CR3kcsUfNMvn-S4wwqefWQY_ZeJWfYH-ubU3celNX0='}
