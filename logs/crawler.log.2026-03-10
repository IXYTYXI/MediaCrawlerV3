2026-03-10 22:59:41 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '691d1aed000000001e0262f0', 'type': 'normal', 'title': '高中周末1v1在家学！效率高出分快', 'desc': '🤔 高中周末在家学习总 “磨洋工”\n❌ 玩手机、盲目刷题，效率极低\n✅ 赶紧试试高途1v1线上带学，学习效率高，进步显著，家长也无需再督促～\n\t\n📣 高途1v1充分利用周末时间，每一步都追求高效：\n▫️ 学前先做检测，精准定位薄弱项，定制方案集中攻克，比盲目刷题有效得多；\n▫️ 高频互动，即学即练，名师直播课全程互动，实时提问引导思路，紧盯孩子状态；\n\t\n👉 除了高效，这些细节更让家长放心\n▫️ 随时答疑，不留疑问：7*24 小时在线答疑，晚上提问也能及时解惑，不让疑问累积；\n▫️ 透明课堂，实时掌握：家长可随时旁听，课后有复盘总结，孩子学习进度一目了然；\n▫️ 全包服务，省心省力：从检测、规划到带学、复盘，全流程覆盖，家长无需再费心。\n\t\n高中周末时间太宝贵，与其让孩子在家 “磨洋工”，不如试试高途1v1线上带学！\n↙️ 感兴趣的家长点击左下方【立即咨询】预约1v1试学\n🔍 报名要求：32岁以上家长\n⏰ 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #高中学习方法[话题]# #高考复习[话题]# #高考逆袭[话题]# #课程辅导[话题]# #高效学习[话题]#', 'video_url': '', 'time': 1763515117000, 'last_update_time': 1763515118000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '3', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102259/56fb82bb77604903b7e2b3a17ceea735/spectrum/1040g0k031p23nsgg2c005oakffv0j2coddp1ijg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102259/ff5426703a877e8498dde4bbdd960334/spectrum/1040g0k031p23nsgg2c0g5oakffv0j2cohf27deg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102259/1bac5e0926c4c4b279698cdc924c7037/spectrum/1040g0k031p23nsgg2c105oakffv0j2colskub80!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,高中学习方法,高考复习,高考逆袭,课程辅导,高效学习', 'last_modify_ts': 1773154781127, 'note_url': 'https://www.xiaohongshu.com/explore/691d1aed000000001e0262f0?xsec_token=ABDC86EEMWRgxe46qArkIGH8nyAu3ijSFsk7gVXED9hYA=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABDC86EEMWRgxe46qArkIGH8nyAu3ijSFsk7gVXED9hYA='}
