2026-03-10 22:44:07 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6985ad34000000001a0211ab', 'type': 'normal', 'title': '📚高中全科没重点？高途1V1带你冲刺高分', 'desc': '各位家长好～\n你的孩子是否存在这样的问题：\n🎯 孩子学习抓不住重点，学完就忘\n🎯 补了很久，成绩还是没明显进步\n别慌！挖到高途高中线上1V1这个宝藏课啦✨\n\t\n✅【1V1定制学习方案】\n先精准定位你的薄弱项，量身规划提升路径，告别盲目刷题，每一分钟都用在刀刃上🚀\n\t\n✅【名师1V1直播教学】\n严选资深高中老师，精准抓高kao高频考点，讲题思路超清晰，上课全程不犯困🎯\n\t\n✅【1V1督学答疑】\n专业老师全程盯着你学，遇到问题随时问，再也不用攒着疑问到深夜 emo 了💡\n\t\n✅【专属学情分析】\n每次课后都有详细反馈，进步可视化，越学越有信心，根本停不下来💪\n不管是补基础还是冲高分，这个模式都太适配高中生了！\n现在点击【立即咨询】领取专属规划\n📝 报名要求：仅面向32岁以上家长\n📆 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #高考复习[话题]# #高中学习方法[话题]# #学习技巧[话题]# #高考逆袭[话题]# #高效学习[话题]#', 'video_url': '', 'time': 1770426601000, 'last_update_time': 1770368309000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '3', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102244/e45bdcaf4147b8dc5f150c0b8abe084e/spectrum/1040g0k031s87jq62lc005oakffv0j2copph8sq8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102244/4a8bce32757f6f1b2a90b0ed9129dbd9/spectrum/1040g0k031s87jq62lc0g5oakffv0j2cod4mrmuo!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,高考复习,高中学习方法,学习技巧,高考逆袭,高效学习', 'last_modify_ts': 1773153847727, 'note_url': 'https://www.xiaohongshu.com/explore/6985ad34000000001a0211ab?xsec_token=ABzaatJlt5nlUnF3m8mEHx3hfhFYmVcQEGLfGgLkXjC-E=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABzaatJlt5nlUnF3m8mEHx3hfhFYmVcQEGLfGgLkXjC-E='}
