2026-03-10 21:44:17 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69ac028e000000002203ac9f', 'type': 'normal', 'title': '小阶平行线浅奥思维，1周2节，孩子轻松开窍', 'desc': '娃校内数理题能轻松搞定，一碰到拓展题就卡壳犯难？\n核心还是逻辑思维没跟上，越往后差距越明显😭  别焦虑！给家长们强推——平行线浅奥思维*✅清北名师带队，寒假帮娃练透思维、实现逆袭！ 单课时低至 15 元，性价比直接拉满～\n✅ 师资硬核不踩雷  清北名师真人直播，拒绝录播凑数！ 擅长把抽象知识点拆得通俗好懂，孩子一听就抓住核心逻辑🧠\n✅ 价格亲民超划算 对比线下动辄几千的课，这里一年只要 1440 元，低至15元/课时， 名校老师带学浅奥思维，性价比吊打同类💰\n✅ 课程适配性超强 专为 1–9年级 设计，从数感启蒙到浅奥逻辑全覆盖， 想夯实校内、或冲拓展拔高的孩子，都能精准适配📖\n🔥 这个学期，给孩子一次“思维开窍”的机会\n👇🏻 点击【立即咨询】，测测孩子的数学思维在哪一关！\n#平行线教育[话题]# #数学学习[话题]#  #数学思维[话题]#  #思维训练[话题]#  #提升孩子思维能力[话题]# #浅奥思维[话题]# #奥数思维[话题]# #小学奥数[话题]# #小学数学[话题]#', 'video_url': '', 'time': 1772880526000, 'last_update_time': 1772880526000, 'user_id': '642ba9780000000012011a80', 'nickname': '平行线名师大课堂', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/f0238b56-4bdd-3597-adf3-db36cfdcf315', 'liked_count': '1', 'collected_count': '', 'comment_count': '3', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102144/556cd030a3e59970378c34fef7e754fc/spectrum/1040g0k031tdlct4ml8005p1bl5s4i6k07q51ui0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102144/396f4850f4ffb6db6a5f3c23bb0d8889/spectrum/1040g0k031tdleegt56005p1bl5s4i6k0pa5jpio!nd_dft_wlteh_webp_3', 'tag_list': '平行线教育,数学学习,数学思维,思维训练,提升孩子思维能力,浅奥思维,奥数思维,小学奥数,小学数学', 'last_modify_ts': 1773150257393, 'note_url': 'https://www.xiaohongshu.com/explore/69ac028e000000002203ac9f?xsec_token=ABD5e8bswyAnrGYMJQddOAemZwzoHsBv71CCnRVBt30cg=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABD5e8bswyAnrGYMJQddOAemZwzoHsBv71CCnRVBt30cg='}
