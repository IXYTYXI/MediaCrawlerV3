2026-03-10 23:13:55 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68b17bd7000000001d00b040', 'type': 'normal', 'title': '家长选辅导？高途1对1官方更靠谱', 'desc': '想问下各位家长：是不是怕👶偏科拖后腿、找不到靠谱辅导？\n🤔 试过高价线下课，🧑\u200d🏫上完就走没人盯？\n🤔 普通网ke没人答疑，学没学会全靠猜…\n\t\n✅ 其实选对辅导真的能省不少心！选择高途1对1，双🧑\u200d🏫师全程陪跑，从学习到出分全程负责～ 今天想跟大家聊聊，为啥辅导选高途1对1这么香，也欢迎有需求的家长来交流！\n\t\n🔥【高途有】\n👉 严选双一流学霸、全部持证上岗\n👉 1v1主讲+专属二讲陪练/批改/答疑\n\t\n🔥【高途有】\n👉 1v1诊断学情：针对现阶段学习水平，输出学情诊断报告、制定学习方案；\n👉 由浅入深，循序渐进，讲练结合，强化巩固，精准复习，单点突破；\n👉 主讲二讲全程盯着学习，一ti多法，开拓思维，效率加倍；\n\t\n如果你们也在找 “有人盯、全程负责” 的线上1对1，真心推荐试试高途！\n↙️ 点击左下角【立即咨询】领取专属1v1试听名额\n🙋 报名要求：仅面向32岁以上家长\n⏰ 活动时间：即日起-26年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#学习日常[话题]#\ufeff \ufeff#一对一体验[话题]#\ufeff \ufeff#周末学习[话题]##高中网课[话题]# \ufeff', 'video_url': '', 'time': 1756462039000, 'last_update_time': 1760755049000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '3', 'collected_count': '2', 'comment_count': '4', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102313/68b269918d2cf38a80552c69268bb4d5/spectrum/1040g34o31lp0ig8i4s1g5oakffv0j2cotmhnppo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102313/0be5dd8278377d71bbc202f4fe98789f/spectrum/1040g34o31lp0ig8i4s205oakffv0j2cot7melho!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,学习日常,一对一体验,周末学习,高中网课', 'last_modify_ts': 1773155635872, 'note_url': 'https://www.xiaohongshu.com/explore/68b17bd7000000001d00b040?xsec_token=ABm0S40USQCSLfscQ6b4ineL7myWHDlG3nPQKfeFY20qI=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABm0S40USQCSLfscQ6b4ineL7myWHDlG3nPQKfeFY20qI='}
