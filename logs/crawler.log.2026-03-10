2026-03-10 22:46:10 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '697c750e0000000021029a13', 'type': 'normal', 'title': '高途英语持证名师！1v1负责到出分', 'desc': '🥹 家有高中英语差生的家长真的会谢！\n🤔 背单词背了就忘、阅读满篇生词、完形全靠蒙\n😭越学越抵触，成绩常年在及格线徘徊，补了无数课还是不见效\n🧑\u200d🏫 高途一对一持证英语名师，专收英语差生，每次仅需2小时，针对性带学直击痛点！\n\t\n👉 专啃英语硬骨头！持证名师专治各种学不会\n持证上岗 + 多年专攻差生提分，太懂英语薄弱生的学习痛点\n知道单词的误区、清楚阅读解题的卡点、明白作文下笔的难点\n用差生能听懂的方式拆解，零基础也能跟上\n\t\n👉 每次2小时高效学！拒绝无效磨时间\n✅ 单词：告别死记硬背，教高效记忆方法，背了就能用；\n✅ 阅读 / 完形：拆解解题技巧，教定位关键词、分析长难句；\n✅ 语法：从基础语法补起，梳理核心考点，扫清语法障碍；\n✅ 作文：教万能模板 + 高分句式，手把手教写开头结尾！\n\t\n👉 高途一对一全流程护航！提分更有底气\n✅ 上课时间超灵活：在家就能学，不用接送，晚上、周末都能安排；\n✅ 课前课后全盯学：24 小时在线答疑，娃有疑问随时解；\n\t\n根据娃的学习情况动态调整方案，步步进阶，看着娃的英语成绩一点点涨，逆袭看得见！\n\t\n点击【立即咨询】获取专属学情检测和1v1试学名额吧～\n📝 报名要求：仅面向32岁以上家长\n📆 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #高效学习[话题]# #线上课[话题]# #学习规划[话题]# #高考英语[话题]# #高中英语[话题]#', 'video_url': '', 'time': 1769764110000, 'last_update_time': 1769764111000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '2', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102246/b0283d3eea15d0dad91eff696abba38a/spectrum/1040g34o31rv7g6ct3k105oakffv0j2covkuunng!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,高效学习,线上课,学习规划,高考英语,高中英语', 'last_modify_ts': 1773153970482, 'note_url': 'https://www.xiaohongshu.com/explore/697c750e0000000021029a13?xsec_token=ABEs_FLh4JX7EWRqvtpb1hsPNxC8C0JR8KLKjLi26tU2c=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABEs_FLh4JX7EWRqvtpb1hsPNxC8C0JR8KLKjLi26tU2c='}
