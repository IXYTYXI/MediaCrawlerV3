2026-03-10 22:43:23 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '698bf15e000000002800b449', 'type': 'normal', 'title': '26高考倒计时⚠️高途1v1陪跑到出分', 'desc': '⏰ 距离高考只剩几个月，孩子复习越慌家长越急\n😭 跑机构浪费时间，自学没方向、难点堆成山\n😭 眼看别人稳步提分，自家娃却原地踏步，真的快愁疯了...\n\t\n✅ 别慌！给所有高考生家长安利这款高途1v1陪跑网课\n🎉 全程负责到出分，不用跑机构、在家就能高效复习\n⏰ 每次2小时，名师从头精讲，约课灵活不耽误\n\t\n### 👉 专属陪跑，负责到底\n不用跑机构赶通勤，省去来回路上的时间，在家打开设备就能上课，每次仅2小时，精准高效，珍惜高考前的每一秒！\n\t\n### 👉 高途名师1v1从头讲\n所有讲师均经过高途多轮严选，学历可查、持证上岗，多年高考带教经验，不是兼职凑数，更懂高考技巧！\n\t\n### 👉 高考大招+1v1定制｜告别低效刷题\n高途各科自研高考大招模型，精准拆解高考考点，把时间花在能直接提分的地方，复习效率翻倍！\n\t\n### 👉 24h答疑+家长会反馈｜家长超放心\n7*24小时在线答疑，不管是课后刷题、深夜复习，还是考前冲刺遇到任何难点，随时提问、秒响应，疑问不隔夜！\n\t\n⏰ 26高考倒计时已开启，每一分每一秒都耽误不起！\n跟着1v1在家就能高效冲刺，帮孩子抓住最后机会！\n\t\n点击【立即咨询】即可领取1v1试学名额\n📌 报名要求：仅面向家长\n🛎️ 活动截止时间：2026年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #学习规划[话题]# #高考冲刺[话题]# #高考逆袭[话题]# #高考提分[话题]# #弯道超车[话题]# #备考攻略[话题]#', 'video_url': '', 'time': 1770778974000, 'last_update_time': 1770778975000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '1', 'comment_count': '1', 'share_count': '', 'ip_location': '河北', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102243/dca122b79c571ba4d8d3a2c6d63cb1ac/spectrum/1040g0k031sebe0n3lc005oakffv0j2coa3n65b0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102243/8357720a50dfed99588c725db97f6e45/spectrum/1040g0k031sebe0n3lc0g5oakffv0j2co3c5tjsg!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,学习规划,高考冲刺,高考逆袭,高考提分,弯道超车,备考攻略', 'last_modify_ts': 1773153803460, 'note_url': 'https://www.xiaohongshu.com/explore/698bf15e000000002800b449?xsec_token=AB0Z9yfQ7GgsduS9DBlYJ1Whyw_pBe2sVQqTcLwXKAf6Q=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB0Z9yfQ7GgsduS9DBlYJ1Whyw_pBe2sVQqTcLwXKAf6Q='}
