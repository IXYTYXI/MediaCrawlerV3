2026-03-10 22:42:07 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '699eb592000000002303a16a', 'type': 'normal', 'title': '⚠️高途1v1定制辅导，家长彻底省心', 'desc': '🤔 家有高中生是不是都有这样的困扰：\n😭 孩子上课听不懂、课后不会练，偏科严重\n😭 想找辅导却踩遍坑，花了不少钱，孩子成绩没起色\n😭 家长急得团团转，却又无能为力......\n\t\n✅ 真心给各位家长推荐高途高中线上1v1，专属定制辅导方案\n🎉 适配高一至高三全阶段，从0基础一站式护航到出分\n\t\n🏆 高途线上1v1，专属定制不敷衍\n从摸底到出分，每一步都精准适配孩子的学情，全程负责到底，不用家长追着问、催着学，彻底解放家长！\n\t\n🏆 严选名师1v1带学，不满意可更换\n多轮严选，筛选名校毕业学霸主讲，全员持证上岗、经验丰富，全程1v1直播带学，讲解细致、重点突出，学习效率翻倍！\n\t\n🏆 全流程陪伴+24h答疑｜家长省心，娃学的安心\n管是课后刷题还是深夜复习，遇到疑问随时提问、秒响应，不让问题过夜，学习不卡壳。家长随时了解孩子的学习状态，省心又放心。\n\t\n想给娃锁定专属提升名额，获取专业学情诊断和名师试听的家长\n\t\n📣 赶紧点击左下角【立即咨询】领取1v1试学名额\n📍 活动范围：仅面向32岁以上家长\n🌈 活动时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #线上教学[话题]# #弯道超车[话题]# #学习规划[话题]# #学习经验[话题]# #学霸养成[话题]#', 'video_url': '', 'time': 1772068201000, 'last_update_time': 1772008851000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '1', 'comment_count': '1', 'share_count': '', 'ip_location': '河北', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102242/f0f036123af72a45b9eb94a7c19e4c11/spectrum/1040g0k031t0lsaefle005oakffv0j2coku3hr30!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102242/45e339ab9d6edaba907765d489815784/spectrum/1040g0k031t0lsaefle0g5oakffv0j2cor467km0!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,线上教学,弯道超车,学习规划,学习经验,学霸养成', 'last_modify_ts': 1773153727523, 'note_url': 'https://www.xiaohongshu.com/explore/699eb592000000002303a16a?xsec_token=AB2iCfwYPnGan88a-wVARvBrIRBzG7Kbm-v_WlZlGYVhs=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB2iCfwYPnGan88a-wVARvBrIRBzG7Kbm-v_WlZlGYVhs='}
