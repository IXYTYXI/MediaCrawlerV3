2026-03-10 22:55:07 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69393d1d000000000d00dff1', 'type': 'normal', 'title': '26高考兜底！在家1v1网课陪跑到出分', 'desc': '📣 家有26届高考生，最怕孩子复习没方向\n🤔 基础弱跟不上、疑问攒一堆没人解？\n🔥 别愁！在家就能上的高中一对一网课\n🏃 全程陪跑负责到高考出分，名师带学+科学提分方案，孩子稳扎稳打冲高分，家长彻底省心！\n\t\n✔️ 学前精准检测，提芬不盲目\n课前先做学科薄弱分析，哪个模块拖后腿一目了然，拒绝 “一刀切” 教学，从源头找准突破口；\n\t\n✔️ 名师1v1陪跑，出分效率看得见\n名师记忆法 + 真人1v1带学 + 历年真题训练，做一道会一类，提分效率肉眼可见；\n\t\n✔️ 7*24小时答疑 + 阶段调整，学习不跑偏\n7*24 小时随时答疑，不管是凌晨的压轴题，还是清晨的疑惑，老师都会响应，疑问不过夜；\n\t\n✔️ 定期组织阶段测试\n根据成绩动态调整学习进度，基础弱就多补公式，进度快就拔高难题，始终让孩子在适合的节奏里学习；\n\t\n26高考备考倒计时，选对方法比盲目努力更重要！\n↙️ 赶紧点击【立即咨询】领取1v1试学名额，给孩子一个稳妥的复习保障\n🔍 报名要求：32岁以上家长\n⏰ 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #线上课[话题]# #高考复习[话题]# #学习规划[话题]# #高效学习[话题]# #高考逆袭[话题]# #课程辅导[话题]#', 'video_url': '', 'time': 1765358877000, 'last_update_time': 1765358878000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102255/1d869bad08adf3796e8d4d76edea2ca2/spectrum/1040g34o31ptitljmjq305oakffv0j2coqs5ko0g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102255/0c99d828570343510ab4bef35d31014f/spectrum/1040g34o31ptitljmjq3g5oakffv0j2co6eqg6gg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102255/1b297165932f5aa8b3e3bd9009edd0dd/spectrum/1040g34o31ptitljmjq405oakffv0j2coqj0mjr0!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,线上课,高考复习,学习规划,高效学习,高考逆袭,课程辅导', 'last_modify_ts': 1773154507340, 'note_url': 'https://www.xiaohongshu.com/explore/69393d1d000000000d00dff1?xsec_token=ABVnDHGnmSLIAItD3W41IyX57Ag_dwptzF5kw5faeB8Ek=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABVnDHGnmSLIAItD3W41IyX57Ag_dwptzF5kw5faeB8Ek='}
