2026-03-10 22:04:42 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69ae82fc00000000150202c5', 'type': 'video', 'title': '高中英语想逆袭❓一对一带你冲刺前三✨', 'desc': '英语单词背了就忘🤯\n语法从句绕来绕去读不懂❌\n阅读完形抓不住逻辑总丢分❌\n家长看着着急又无力，别让英语成为孩子高中路上的绊脚石！\n-\n是时候给娃换个高效学法啦！👀\n加入【掌门一对一高中英语网课】，带娃攻克英语难关，轻松搞定课内考点课外拓展💪\n🈶专属学情诊断\n学前老师会带孩子进行摸底测试，深入剖析孩子英语上的薄弱点，生成学情报告，一眼就能看出孩子哪里没学好，哪个知识点没掌握！📊\n🈶个性化学习计划\n根据孩子学习薄弱点及学习习惯，量身定制专属学习计划 让孩子摆脱盲目刷题，进行针对性提升\n🈶名师1V1辅导\n清北等名师1V1直播授课，孩子在家就能享受优质课程 会帮娃系统梳理词汇语法体系，突破阅读写作重难点，传授解题思路和应试技巧，让孩子学会举一反三\n🉑随时答疑解惑\n孩子在学习过程中遇到任何问题，都可以随时向老师提问💡会及时解答孩子疑惑，让娃不留知识死角\n📣而且时间⏰灵活，不用来回跑！\n-\n一对一才是孩子英语学习的正确打开方式‼\n💪精准捕捉英语痛点，15天轻松解决英语难题！\n-\n现在点击【立即咨询】免费领试听课+1v1诊断规划！\n名额有限，先到先得\n-\n报名要求：32岁以上家长\n截止日期：即日起-2026年12月31日\n#掌门[话题]#  #掌门1对1[话题]# #掌门一对一[话题]#  #高中学习方法[话题]#  #高中英语[话题]#  #开学逆袭[话题]#  #家长必看[话题]#  #在家学英语[话题]#', 'video_url': 'http://sns-video-al.xhscdn.com/stream/79/110/259/01e9ae82f82ff1ff010370039cd1b00d17_259.mp4', 'time': 1773057671000, 'last_update_time': 1773044477000, 'user_id': '649a70220000000010036bfc', 'nickname': '掌门1对1学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31pumqmjhls005p4qe0h46qvs49pjit8', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '上海', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102204/6ffd75406d5c79e929999de675e7c5a9/spectrum/1040g34o31tg3md2ime105p4qe0h46qvs03dqsh0!nd_dft_wlteh_webp_3', 'tag_list': '掌门,掌门1对1,掌门一对一,高中学习方法,高中英语,开学逆袭,家长必看,在家学英语', 'last_modify_ts': 1773151482183, 'note_url': 'https://www.xiaohongshu.com/explore/69ae82fc00000000150202c5?xsec_token=AB-w_qzoOURA9QpHihjgrBICdsPe3PtsGrYl3RmdBvKvI=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB-w_qzoOURA9QpHihjgrBICdsPe3PtsGrYl3RmdBvKvI='}
