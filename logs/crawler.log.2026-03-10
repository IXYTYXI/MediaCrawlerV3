2026-03-10 23:27:32 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '685ca55d000000002201d0a8', 'type': 'normal', 'title': '暑假跟1v1死磕数理，真的能出分！', 'desc': '⚠️ 孩子做数理像踩 “雷区”？函数题一看就懵… 家长急得直上火，孩子越学越没信心！\n😰 这个暑假再放任不管，开学直接被同学甩在身后！\n✅ 直接跟着高途1v1死磕薄弱点，从根源拆解学习难点，中等生直接逆袭！\n\t\n🔥 【为什么选择高途1v1？】\n✅ 学前检测薄弱点，助力暑期快速逆袭\n✅ 1V1定制专属学习方案计划\n✅ 多轮严选名校毕业老师在线1v1直播互动\n✅ 家长专属vip群，随时了解学习进度\n✅ 专属班班全程陪伴教学、严管督学\n✅ 老师可选，适配满意为止\n-\n这个暑假，让孩子跟着高途一对一陪伴一起逆袭吧！\n↙️ 点击【立即咨询】领取1v1试听名额，了解更多课程详情哦～\n💬 报名要求：仅面向32岁以上家长\n⏰ 活动时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#暑假[话题]#\ufeff \ufeff#数理思维[话题]#\ufeff', 'video_url': '', 'time': 1750987741000, 'last_update_time': 1750902110000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '4', 'comment_count': '2', 'share_count': '3', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102327/6d6b0bd84806ddf5943cb7be72dc5a52/spectrum/1040g34o31j65d36l2i305oakffv0j2co76gt7go!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102327/de7843ec3861647cdbc25d96c0c93243/spectrum/1040g34o31j65d36l2i3g5oakffv0j2coepd85po!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102327/52a3358d7f6d427ba17266fc774abad5/spectrum/1040g34o31j65d36l2i405oakffv0j2coo5b1v88!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,暑假,数理思维', 'last_modify_ts': 1773156452289, 'note_url': 'https://www.xiaohongshu.com/explore/685ca55d000000002201d0a8?xsec_token=AByDJTlnACsHzxeM0GQCmYaXEcL56LHWjSpyNMdKETdpg=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AByDJTlnACsHzxeM0GQCmYaXEcL56LHWjSpyNMdKETdpg='}
