2026-03-10 17:56:26 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '662f7794000000001e03449a', 'type': 'video', 'title': '普娃小学数学超前学实操技术帖', 'desc': '选一本难度合适的教辅，每天一页固定习惯，一定要让孩子自己想自己做，还是那句老话，一听就会一学就废，只有自己弄明白的，才是真的明白。\xa0#小学数学[话题]#\xa0\xa0#数学[话题]#\xa0\xa0#超前学[话题]#', 'video_url': 'http://sns-video-hw.xhscdn.com/stream/110/259/01e62f766e200101010371038f296f1217_259.mp4', 'time': 1714395680000, 'last_update_time': 1714386837000, 'user_id': '5c7b2c970000000011000cbd', 'nickname': '方爸谈学习', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662ade365a6514fcd3525ad0.jpg', 'liked_count': '672', 'collected_count': '780', 'comment_count': '128', 'share_count': '155', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603101749/7a367af44084dbf8e735ab136ff1585d/spectrum/1040g0k031261fhjlhi005n3r5ibk835topbdkto!nd_dft_wlteh_webp_3', 'tag_list': '小学数学,数学,超前学', 'last_modify_ts': 1773136586220, 'note_url': 'https://www.xiaohongshu.com/explore/662f7794000000001e03449a?xsec_token=AB67HHvTlD0ftmifSmUBv9cKvoWM35MbIz3tB4xaf8AlE=&xsec_source=pc_search', 'source_keyword': '数学超前学', 'xsec_token': 'AB67HHvTlD0ftmifSmUBv9cKvoWM35MbIz3tB4xaf8AlE='}
