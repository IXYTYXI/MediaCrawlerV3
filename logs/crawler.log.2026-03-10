2026-03-10 20:52:25 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69afbc7b000000002202d2c2', 'type': 'normal', 'title': '挖到宝了💰100＋的新加坡数学小班课', 'desc': '新加坡数学多少钱一节课？\n今天挖到这个宝藏必须分享—sparkmath新加坡数学（火花新加坡数学）\n💥 限时特惠，0元试听，点击【立即咨询】抢占名额\n-\n💰100＋/节就能上正宗新加坡数学，这价格在市面上真的良心了\n👥 3-8人小班\n真人老师全程互动，每个娃都有发言机会，内向孩子也能被照顾到\n🗣️中/英/双语可选\n想练英语思维选全英班，怕听不懂选中文班，双语自由切换太贴心了\n📚K2-P6分阶\n从幼小衔接启蒙，到小高年级思维拔高，每个阶段都有对应课程\n🔄学习闭环体系\n课前预习→课中互动→课后巩固→阶段诊断，环环相扣\n老母亲完全不用操心\n-\n👇点击【立即咨询】立即锁定试听名额\n• 1节在线思维直播课\n• 1V1定制学习规划方案\n• 价值3422元228课时学习大礼包\n⏰ 活动有效期：即日起至2027年12月31日\n*面向家长群体\n#sparkmath[话题]# #sparkmath新加坡数学[话题]# #新加坡数学[话题]# #火花新加坡数学[话题]# #数学思维[话题]# #新加坡数学多少钱一节[话题]# #新加坡数学教材[话题]# #新加坡数学测评[话题]# #小学数学网课[话题]# #小学数学如何提高[话题]#', 'video_url': '', 'time': 1773124731000, 'last_update_time': 1773124732000, 'user_id': '64740b96000000000f006adf', 'nickname': 'Spark Math 数学课程', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo30oe65qe8ie5g5p3k1eb3oqmvph5fk6g', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102052/6a3b42316290684129dddc0fbe44d4d9/spectrum/1040g0k031th9u44kl8005p3k1eb3oqmvgqrhvlg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102052/f7143116ef38d324164da04c43965849/spectrum/1040g0k031th9u6vole005p3k1eb3oqmveimjk8o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102052/2c4cef69bd73ee51ea34dd016991ff09/spectrum/1040g34o31th9u7iv5a105p3k1eb3oqmvgcn4lig!nd_dft_wlteh_webp_3', 'tag_list': 'sparkmath,sparkmath新加坡数学,新加坡数学,火花新加坡数学,数学思维,新加坡数学多少钱一节,新加坡数学教材,新加坡数学测评,小学数学网课,小学数学如何提高', 'last_modify_ts': 1773147145204, 'note_url': 'https://www.xiaohongshu.com/explore/69afbc7b000000002202d2c2?xsec_token=AB9mya0G5gRV6vHe5UesXJL0ETB4miZ6euGc9H79trSpA=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB9mya0G5gRV6vHe5UesXJL0ETB4miZ6euGc9H79trSpA='}
