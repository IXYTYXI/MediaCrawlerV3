2026-03-10 23:26:34 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '686624d10000000015021eb6', 'type': 'normal', 'title': '为什么选真人1对1带学？看完秒懂', 'desc': '🤗 高中生想要告别无效学习、实现全科逆袭？\n🧑\u200d🏫 真人老师1对1直播带学才是真正的 “秘密武器”！\n👉 和录播课、大班课完全不同，它能精准匹配学生短板，1v1精准学习！\n\t\n高途1v1这4大碾压级优势，家长和学生必须知道！\n🔥 优势 1：“私人订制” 学习方案，短板无处遁形\n入学就做全科深度测评，精准揪出学习问题。根据测评结果，当场定制专属学习计划！\n\t\n🔥 优势 2：真人实时互动，走神0可能\n录播课看一半就走神？大班课不敢提问？1v1直播直接 “治” 好学习拖延症！\n\t\n🔥 优势 3：全程督学，学习效果看得见\n1v1 直播课配备专属班班全程跟盯：每日学习提醒+随时答疑解惑+阶段学情报告\n\t\n🔥 优势 5：“沉浸式” 查漏补缺，知识无死角\n定期阶段测试，随时调整学习计划，确保学过的知识几个月后依然牢记！\n\t\n真人老师1v1带学，这个暑假让全科知识全面拔高，开学直接逆袭！\n↙️ 赶紧点击左下角【立即咨询】领1v1试听吧～\n⏰ 活动时间：即日起-25年12月31日\n🙋 报名要求：仅面向32岁以上家长\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#高中[话题]#\ufeff \ufeff#高一[话题]#\ufeff \ufeff#高二[话题]#\ufeff \ufeff#高三[话题]#\ufeff', 'video_url': '', 'time': 1751585760000, 'last_update_time': 1751524562000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102326/f7b342cc10501fc6f0aa4513eb6373bb/spectrum/1040g0k031jfe6rj2ia005oakffv0j2codc68q1g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102326/a037ca8c2ab3c7f8119b6f6e06d75aa0/spectrum/1040g0k031jfe6rj2ia0g5oakffv0j2co4jtpuio!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102326/c6882b4f5e1874a871d376645df59347/spectrum/1040g0k031jfe6rj2ia105oakffv0j2cololl5kg!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,高中,高一,高二,高三', 'last_modify_ts': 1773156394287, 'note_url': 'https://www.xiaohongshu.com/explore/686624d10000000015021eb6?xsec_token=ABqipxp4a6oPWAk9br2XGY0sMlszIKN7KDKNk5W4ma38M=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABqipxp4a6oPWAk9br2XGY0sMlszIKN7KDKNk5W4ma38M='}
