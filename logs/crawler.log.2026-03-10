2026-03-10 23:28:27 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '685ca4a20000000012021509', 'type': 'normal', 'title': '思维学崩溃？1v1陪跑暑假直接开窍', 'desc': '算浮力像算玄学、画电路图像画迷宫，见题就懵…\n这不是笨，是物理思维压根没搭起来！\n这个暑假高途1v1物理思维，带着从头学，搭框架到秒解压轴题，死磕到开窍为止！\n\t\n🔥 1v1从头学，凭啥让物理思维 “开挂”？\n✅ “生活化” 拆解物理思维难题：\n老师1v1带着拆解抽象原理，再也不用死记硬背！\n✅ “定制化” 1v1陪跑方案：\n入学先做思维测评！力学薄弱？电学迷糊？专属老师定制每日计划，稳扎稳打不跑偏！\n✅ “盯到极致” 的开窍跟练：\n▫️ 课前预习提醒，上课秒进入状态！\n▫️ 课中1v1解题，老师实时纠正思维漏洞！\n▫️ 课后1v1批改，错题追着重做！\n\t\n↙️ 现在点击左下角【立即咨询】领取1v1专属试听名额\n🙋 报名对象：仅面向 32 岁以上家长\n⏰ 活动时间：即日起 - 25年12月31日\n\ufeff#高途[话题]#\ufeff\xa0\xa0\ufeff#一对一[话题]#\ufeff\xa0\xa0\ufeff#网课[话题]#\ufeff\xa0\xa0\ufeff#物理思维[话题]#\ufeff\xa0\xa0\ufeff#开窍[话题]#\ufeff', 'video_url': '', 'time': 1750915260000, 'last_update_time': 1751955869000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '5', 'collected_count': '2', 'comment_count': '', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102328/33ec0d865b3de25cd41ac58b6bacbdb6/spectrum/1040g34o31j65a55oie8g5oakffv0j2cor5e82q0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102328/2fba3a365215ad4f0170aef857537ea6/spectrum/1040g34o31j65a55oie905oakffv0j2coo69e00o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102328/fc1c5cd873cf613d63c36f6ba7a12e20/spectrum/1040g34o31j65a55oie9g5oakffv0j2colo1428g!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,物理思维,开窍', 'last_modify_ts': 1773156507494, 'note_url': 'https://www.xiaohongshu.com/explore/685ca4a20000000012021509?xsec_token=AByDJTlnACsHzxeM0GQCmYaXL7tTmTc9vmEx_9ZAcJyPs=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AByDJTlnACsHzxeM0GQCmYaXL7tTmTc9vmEx_9ZAcJyPs='}
