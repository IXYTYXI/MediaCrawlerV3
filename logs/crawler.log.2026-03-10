2026-03-10 20:56:14 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a7ec2b0000000015020f49', 'type': 'normal', 'title': '学sparkmath的小学娃，真的赢麻了！', 'desc': '谁懂啊！看着自家娃面对奥数难题不再皱眉\n而是随手画个图就秒出答案，那种感觉真的太爽了！😭\n-\n💡 凭什么说小学阶段学sparkmath真的赢麻了？\n✅ 思维降维打击｜CPA 建模太香了！\n✅ 成绩稳稳领跑｜80%基础+20%拔高\n✅ 注意力“焊”死｜40 分钟通关模式\n✅ 全球赛道衔接｜视野赢在起跑线\n-\n别再让娃在题海里苦苦挣扎了！\n给孩子一套高效的思维武器，你会发现：数学想赢，其实真的很简单！\n现在点击下方↙️【立即咨询】\n⭐ 0元 领1节新加坡数学名师体验课\n⭐ 228节小学阶段拓展课\n⭐ 1v1深度学习规划\n\t\n📅 活动时间：即日起至 2027 年 12 月 31 日\n📍 面向人群：海内外 5-12 岁青少儿家长群体\n#sparkmath[话题]# #sparkmath新加坡数学[话题]# #新加坡数学[话题]# #火花新加坡数学[话题]# #小学数学怎么学[话题]# #小学数学网课[话题]# #小学数学突围[话题]# #新加坡数学建模[话题]# #新加坡数学网课[话题]#', 'video_url': '', 'time': 1772612651000, 'last_update_time': 1772612651000, 'user_id': '64740b96000000000f006adf', 'nickname': 'Spark Math 数学课程', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo30oe65qe8ie5g5p3k1eb3oqmvph5fk6g', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102056/4178c618cad36c058ac1a37b6616227b/spectrum/1040g34o31t9lgq5al8105p3k1eb3oqmv9pes94o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102056/b7ec963bf290a99b07c97b1293f8eaae/spectrum/1040g34o31t9lgscime105p3k1eb3oqmv3agibqg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102056/c0b7c83cca35992b99f1951288e38dac/spectrum/1040g0k031t9lgt76le005p3k1eb3oqmv20ebv40!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102056/91db23f38ad066cc87ee45770c946f68/spectrum/1040g34o31t9lguj95e105p3k1eb3oqmv6ns4pe8!nd_dft_wlteh_webp_3', 'tag_list': 'sparkmath,sparkmath新加坡数学,新加坡数学,火花新加坡数学,小学数学怎么学,小学数学网课,小学数学突围,新加坡数学建模,新加坡数学网课', 'last_modify_ts': 1773147374890, 'note_url': 'https://www.xiaohongshu.com/explore/69a7ec2b0000000015020f49?xsec_token=ABvtKkoN-JdN_qRqzuJpkmXFiHCFSbj7VC6xApjNtTezs=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABvtKkoN-JdN_qRqzuJpkmXFiHCFSbj7VC6xApjNtTezs='}
