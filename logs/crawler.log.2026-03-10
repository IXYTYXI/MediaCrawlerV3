2026-03-10 16:08:13 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68031190000000001a006d89', 'type': 'normal', 'title': '4岁8个月超前学进度', 'desc': '#幼儿园中班[话题]# #让孩子爱上数学[话题]# #小学数学[话题]# #自主学习[话题]# #陪孩子学习[话题]# #边玩边学[话题]# #孩子的进步[话题]# #超前学[话题]# #数学思维[话题]# #爱学习[话题]# #口算速算[话题]# #数学启蒙[话题]# #超前学习[话题]# #计算[话题]# #玩中学学中玩[话题]# #趣味数学[话题]# #兴趣培养从小抓起[话题]# #被娃赐予的力量[话题]# #孩子的兴趣[话题]# #做的有模有样的[话题]# #勤奋的孩子[话题]# #孩子的爱好[话题]#', 'video_url': '', 'time': 1745031568000, 'last_update_time': 1745031568000, 'user_id': '5a92bca511be1029952de20b', 'nickname': '纯白👼', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31rr8uo7j32004a2adruabogb8ba4ra8', 'liked_count': '96', 'collected_count': '43', 'comment_count': '79', 'share_count': '66', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603101602/5d663a2a1e9be4aecda1678db1c32c6c/1040g2sg31gem4dvpji704a2adruabogbkjl2isg!nd_dft_wgth_webp_3', 'tag_list': '幼儿园中班,让孩子爱上数学,小学数学,自主学习,陪孩子学习,边玩边学,孩子的进步,超前学,数学思维,爱学习,口算速算,数学启蒙,超前学习,计算,玩中学学中玩,趣味数学,兴趣培养从小抓起,被娃赐予的力量,孩子的兴趣,做的有模有样的,勤奋的孩子,孩子的爱好', 'last_modify_ts': 1773130093344, 'note_url': 'https://www.xiaohongshu.com/explore/68031190000000001a006d89?xsec_token=AB1r9bjxT7EF3EULHcUD9mFpzN592LvdH1kXAjN8e5vpE=&xsec_source=pc_search', 'source_keyword': '数学超前学', 'xsec_token': 'AB1r9bjxT7EF3EULHcUD9mFpzN592LvdH1kXAjN8e5vpE='}
