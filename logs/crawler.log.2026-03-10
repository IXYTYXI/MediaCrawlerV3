2026-03-10 22:41:43 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '699eb558000000002603fb35', 'type': 'normal', 'title': '亲测有效！高途1v1带学，效率拉满', 'desc': '⚠️ 家有高中生的家长集合！找靠谱1v1网课，真的别踩坑了！\n😭 老师无证敷衍、不盯学，无定制、答疑慢，钱白花、分不涨！\n✅ 试错了无数终于选定了高途高中1v1，持证名师+全程盯学，不玩虚的，帮家长省心、孩子提分\n\t\n💥 区别于普通网课甩手掌柜，高途主打名师亲授+全程盯学，全流程拉满，适配高一至高三👇\n\t\n✅ 持证名师坐镇｜1v1直播精讲\n严选持证名师，名校毕业、深耕高中教学，1v1直播精讲考点，讲透知识点，传授解题技巧。\n\t\n✅ 1v1全程盯学｜家长彻底省心\n课前督预习、课中盯专注、课后查作业，高频互动防跑神，杜绝摆烂，解放双职工家庭。\n\t\n✅ 定制因材施教｜精准补弱\n学情检测找薄弱，1v1定制方案，基础补弱、冲分拔高，不盲目学习，高效提分。\n\t\n✅ 及时答疑+回放研习\n7*24h答疑秒响应，课程可回放巩固，生成错题本，吃透知识点不遗留。\n\t\n✅ 阶段复盘反馈｜提分可视化\n阶段复盘补漏洞，定期生成学习报告，提分看得见，不少孩子成功逆袭。\n\t\n📌 致所有高中生家长：找1v1靠谱至上！在家就能学，省去奔波，让孩子专注提分。\n\t\n📣 赶紧点击左下角【立即咨询】领取1v1试学名额\n📍 活动范围：仅面向32岁以上家长\n🌈 活动时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #线上教学[话题]# #线上课[话题]# #弯道超车[话题]# #学习规划[话题]# #高考逆袭[话题]# #高效学习[话题]#', 'video_url': '', 'time': 1772068560000, 'last_update_time': 1772008793000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '3', 'share_count': '', 'ip_location': '河北', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102241/d057f92a91f31c2cc0b138ff7b8f3b07/spectrum/1040g34o31t0lrcen58105oakffv0j2con5ukldg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102241/2fd9d8cbd54dea94bf960859aee3ffbf/spectrum/1040g34o31t0lrcen581g5oakffv0j2co0lp6jdo!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,线上教学,线上课,弯道超车,学习规划,高考逆袭,高效学习', 'last_modify_ts': 1773153703667, 'note_url': 'https://www.xiaohongshu.com/explore/699eb558000000002603fb35?xsec_token=AB2iCfwYPnGan88a-wVARvBmnaKmwYoT5UTNfo55SSvBE=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB2iCfwYPnGan88a-wVARvBmnaKmwYoT5UTNfo55SSvBE='}
