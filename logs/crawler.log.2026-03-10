2026-03-10 22:46:29 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '697c749100000000280094e7', 'type': 'normal', 'title': '想冲尖子生！终于找到了靠谱高中1v1网课', 'desc': '🤔 想给孩子找靠谱高中1v1？\n挑来挑去不是师资掺水、名师是噱头\n就是课程千篇一律没针对性，花了大价钱娃却难提分\n还有的上课没人盯、课后没反馈，学习效果全靠猜\n想找个官方靠谱的1v1网课真的太难了😭\n🏆 强烈给各位家长推荐高途高中官方1v1网课，从定制方案到闭环督学全拉满，在家就能高效学！\n\t\n👉 官方靠谱师资\n全是官方严选的持证名师，经多轮筛选，名校毕业 + 多年高中教学经验\n资质可查、教学有保障，擅长拆解高阶难点、提炼解题大招\n带着孩子深挖考点本质、拓展解题思路，从 “会做题” 到 “做对题、快做题”\n\t\n👉 1v1定制方案\n先精准诊断孩子的学情，找到知识漏洞和提分卡点\n量身定制专属冲刺方案，细致到每节课的学习目标\n不浪费孩子的每一分钟，让提分更有针对性\n\t\n👉 名师全程陪跑\n课前：定制预习任务，学习更有方向\n课中：1v1直播互动，杜绝走神低效学\n课后：盯作业、24小时答疑兜底\n\t\n不用接送、不用迁就固定课时，家长省心，孩子也能在熟悉的环境里高效学习，冲刺尖子生更轻松！\n\t\n点击【立即咨询】获取专属学情检测和1v1试学名额吧～\n📝 报名要求：仅面向32岁以上家长\n📆 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #高效学习[话题]# #线上课[话题]# #学习规划[话题]# #高中学习[话题]#', 'video_url': '', 'time': 1769763985000, 'last_update_time': 1769763985000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102246/c65b4ac9cbc7ecddc7b9eb61d1b1ff61/spectrum/1040g34o31rv7ec8j3k905oakffv0j2co8bn7rro!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102246/a893aa7288d48d7bb77329b3e2e839aa/spectrum/1040g34o31rv7ec8j3k9g5oakffv0j2cokvmrofo!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,高效学习,线上课,学习规划,高中学习', 'last_modify_ts': 1773153989158, 'note_url': 'https://www.xiaohongshu.com/explore/697c749100000000280094e7?xsec_token=ABEs_FLh4JX7EWRqvtpb1hsLx9dfRHMxqGdxLOmGImdlU=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABEs_FLh4JX7EWRqvtpb1hsLx9dfRHMxqGdxLOmGImdlU='}
