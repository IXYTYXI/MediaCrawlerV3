2026-03-10 23:09:35 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68d5f85800000000130350d9', 'type': 'normal', 'title': '高途高中1对1：官方资质+负责到出分', 'desc': '🤔 各位高中家长，给孩子选1对1辅导，最看重 “安心” 和 “效果”\n🤔 怕资质不靠谱、怕没人管、怕时间凑不上\n✅ 强烈建议各位家长试试高途高中1对1：专属提升方案、官方资质兜底、双师全程陪跑，还能灵活选时间，连 “负责到出fen” 都敢承诺，真的太懂家长需求！\n\t\n▫️ 官方资质安心选：老师100% 持证上岗，学历、教龄全透明可查，还得经过5轮考核才能上课；\n▫️ 专属1对1学习方案：先做学情诊断，结合年级、目标和薄弱项，定制专属计划，每节课目标清晰，不盲目赶进度；\n▫️ 双师全程陪跑不撒手：不只是主讲上课！还有专属二讲全程盯学，学习弱项还会实时同步给家长；\n▫️ 时间灵活自选：每天时间灵活自选，娃周末要补课，就选周中晚上；月考前后没时间，就调整课程节奏，再也不用为了上课迁就机构，学习更灵活。\n\t\n如果你们家娃也是高中生，想找靠谱1对1，别再瞎折腾：\n👇 现在点击左下角【立即咨询】领取1v1体验名额\n🙋 报名要求：32岁以上家长\n📆 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #弯道超车[话题]# #高中逆袭[话题]# #一对一学习[话题]# #定制学习方案[话题]#', 'video_url': '', 'time': 1758853208000, 'last_update_time': 1758853208000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '2', 'collected_count': '2', 'comment_count': '', 'share_count': '3', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102309/0b90c17547b65ac90101aea5f5900d6d/spectrum/1040g0k031msknsuv4q005oakffv0j2coun9qq50!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102309/d6abf16ca8bb670ecfac7df6f095a1dc/spectrum/1040g0k031msknsuv4q0g5oakffv0j2cosemem9g!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,弯道超车,高中逆袭,一对一学习,定制学习方案', 'last_modify_ts': 1773155375129, 'note_url': 'https://www.xiaohongshu.com/explore/68d5f85800000000130350d9?xsec_token=ABagdCbWquIGyu7b_rrvbLB7-eNSpgSjrAolnXsZw1Bi4=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABagdCbWquIGyu7b_rrvbLB7-eNSpgSjrAolnXsZw1Bi4='}
