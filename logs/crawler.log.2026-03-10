2026-03-10 23:39:55 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6826dad7000000002301e918', 'type': 'normal', 'title': '高途1v1网课带你，暑假黄金期超车！', 'desc': '💡 为什么说暑假是高中生逆袭的好机会？\n⚠️ 新高三：一轮复习跟不上的，9月直接被淘汰\n⚠️ 新高二：高一漏洞不补，高二直接听不懂\n⚠️ 新高一：初升高不衔接，开学就垫底\n\t\n✅ 高途高中1v1暑假班\n✔️ 双一流名师1对1授课\n✔️ 任何基础都能试听\n✔️ 在家学=省时+高效\n\t\n🎯 四类学生精准学习方案\n1️⃣ 专题补弱：死磕薄弱模块，讲透必考基础题\n2️⃣ 高中衔接：预学重难点，开学当学霸\n3️⃣ 双一流冲刺：压轴题技巧+应试大招\n4️⃣ 竞赛强基：名师1v1带练\n\t\n🎯 1v1教学五大优势\n✅ 上课时间自由约，睡醒就能学\n✅ 每节课1v1量身定制，拒绝无效刷题\n✅ 24小时答疑，晚上有难题也能及时回\n✅ 学情分析，薄弱点一目了然\n\t\n现在点击左下角【立即咨询】预报名即可享受专属优惠\n💬 报名要求：仅面向32岁以上家长\n⏰ 截止时间：即日起至25年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#高中[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#逆袭[话题]#\ufeff', 'video_url': '', 'time': 1747376855000, 'last_update_time': 1747376856000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '2', 'collected_count': '2', 'comment_count': '', 'share_count': '2', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102339/e142cf0077c7502f1c510e343f6d764b/spectrum/1040g34o31hhke2gok20g5oakffv0j2cocd9g8k8!nd_dft_wlteh_webp_3', 'tag_list': '高途,高中,一对一,逆袭', 'last_modify_ts': 1773157195703, 'note_url': 'https://www.xiaohongshu.com/explore/6826dad7000000002301e918?xsec_token=ABLZ5tESpUCBJHu9L7GzkeA8xSH9wuMgfS8IkqVEE7LX0=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABLZ5tESpUCBJHu9L7GzkeA8xSH9wuMgfS8IkqVEE7LX0='}
