2026-03-10 23:19:31 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '688c97770000000002003ad4', 'type': 'normal', 'title': '高途1v1网课灵活选时，1人1班超高效', 'desc': '🏃 孩子放学就背着书包赶线下补习班，到了教室刚坐稳就要上课，一节课下来又累又懵…… 高中三年就这么点冲刺时间，哪经得起这样耗？\n\t\n✅ 还好换了高途高中1v1网课，时间灵活自己选，1人1班专属定制，连学习计划都按孩子节奏来，不用赶路、不浪费时间，孩子学得轻松悄悄进步～\n\t\n👉 时间灵活到离谱，再也不用 “赶场式” 补课\n▫️ 回家坐在书桌前就能上课，省下的时间用来刷题或休息\n▫️ 时间全由你定：和老师约好时间就开讲，完全贴合孩子的作息\n▫️ 状态不好随时调：提前和老师沟通改时间，绝不硬撑着上低效课\n\t\n👉 1人1班定制化，孩子的节奏就是ke堂节奏\n▫️ 上课前先做 “学情分析”，连例题都是按孩子易错点选的；\n▫️ 专属提分计划在手：怕孩子学了没方向？学习计划细到每月每周；\n▫️ 老师定时发 “进度报告”：家长打开手机就知道进步在哪，不用再猜 “学没学好”。\n\t\n别让赶路浪费孩子的冲刺时间，用高途1v1把每分每秒都好好利用～\n点击左下角【立即咨询】领取1v1试听名额吧～\n活动时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#学习日常[话题]#\ufeff \ufeff#定制课程[话题]#\ufeff \ufeff#家长必读[话题]#\ufeff', 'video_url': '', 'time': 1754044279000, 'last_update_time': 1754044279000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '2', 'collected_count': '3', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102319/0d7141d518ed037ad49c4d3b924e3a9d/spectrum/1040g0k031kkvm9lf3q005oakffv0j2coiv95df0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102319/91c7a59ace6ef8f838c357f4a04ac29f/spectrum/1040g0k031kkvm9lf3q0g5oakffv0j2coggngado!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,学习日常,定制课程,家长必读', 'last_modify_ts': 1773155971406, 'note_url': 'https://www.xiaohongshu.com/explore/688c97770000000002003ad4?xsec_token=ABpyvw13YbDaU1Uv_R4lkknstuyh_njiF4rpGQrWVNjEU=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABpyvw13YbDaU1Uv_R4lkknstuyh_njiF4rpGQrWVNjEU='}
