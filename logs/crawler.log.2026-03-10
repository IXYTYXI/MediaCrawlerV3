2026-03-10 17:55:17 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68803682000000001301285f', 'type': 'normal', 'title': '二升三提前学', 'desc': '数学一直在提前学。平时都是先看洋葱，再每天一张五三。感觉速度太慢了，也没有专门拉计算。所有都是和五三同步。二升三，现在才搞完三年级上下册。拜托过来人指导我，想走得快一点。总觉得哪个细节错了。\n不赞同提前学的，说我用五三太简单了的都不要理我。我家是普娃，谢谢！我认为提前学不能搞难了！\n主要是现在我觉得，每天都提前学，挤压时间过多。\n#小学学习资料[话题]# #小学数学[话题]# #小学数学[话题]# #数学提前学[话题]# #学习规划[话题]# #学霸养成[话题]# #小学数学思维训练[话题]# #小学奥数[话题]# #自主学习[话题]# #孩子学习[话题]#', 'video_url': '', 'time': 1753233026000, 'last_update_time': 1753427755000, 'user_id': '58fa25366a6a694d38ee6069', 'nickname': '知一老师带普娃～', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31bvohk5n0u5g49dvqhijco39d71kqo0', 'liked_count': '1657', 'collected_count': '2459', 'comment_count': '804', 'share_count': '206', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603101747/06371b3e02403cdd6a33a70d13f76f91/1040g00831k8sqsnh306049dvqhijco39kescijg!nd_dft_wlteh_webp_3', 'tag_list': '小学学习资料,小学数学,数学提前学,学习规划,学霸养成,小学数学思维训练,小学奥数,自主学习,孩子学习', 'last_modify_ts': 1773136517844, 'note_url': 'https://www.xiaohongshu.com/explore/68803682000000001301285f?xsec_token=ABWusOwgqKYneW_APMTVfjBP1WIRiBrVFoRWdD-3tM-Uc=&xsec_source=pc_search', 'source_keyword': '数学超前学', 'xsec_token': 'ABWusOwgqKYneW_APMTVfjBP1WIRiBrVFoRWdD-3tM-Uc='}
