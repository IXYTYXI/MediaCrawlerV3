2026-03-10 22:57:26 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69300bfe000000001e010f0e', 'type': 'normal', 'title': '扒遍全网❗️终于找到负责的高中1v1网课', 'desc': '🧑\u200d💻 想给孩子挑靠谱高中1v1网课，扒遍全网👇\n❌ 有老师资质模糊的、有答疑半天不回的，有上完课就不管的…\n✅ 踩了一圈坑，终于选定高途 —— 全程陪跑+24小时答疑，体验过才懂：选对比选多更重要！\n\t\n👉 为啥扒遍全网，偏偏锁定高途1v1？\n▫️ 【老师靠谱不踩雷】\n不像有的机构 “名师” 查不到学历，高途1v1老师是多轮严选的 —— 学历可查、持证上岗，还有多年高中教学经验；\n\t\n▫️ 【1v1高效互动直播】\n1v1直播，全程高频互动避免跑神，边讲边练习、趁热打铁，比录播课、大班课生动多了，学习效率直接拉满；\n\t\n▫️ 【24小时答疑不隔夜】\n全程陪伴，批改作业，深夜刷题遇难题，老师都能响应，疑问当天清，学习节奏完全不被打乱；\n\t\n真心建议家长：挑高中网课不用贪多，选个负责到底、能陪跑到出分的，比啥都强！\n点击【立即咨询】预约1v1试学吧～\n报名要求：仅面向32岁以上家长\n活动时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #线上课[话题]# #高效学习[话题]# #学习干货[话题]# #全程陪跑[话题]# #学习规划[话题]#', 'video_url': '', 'time': 1764756478000, 'last_update_time': 1764756478000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102257/dcddab2f410290df18bd031cc7cdd44c/spectrum/1040g34o31pkjl7rs3u305oakffv0j2cocernjo0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102257/e999b542001a435bc1ddfe508df8faee/spectrum/1040g34o31pkjl7rs3u3g5oakffv0j2coni8hso0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102257/87762c2f755336241c02bd734b7336af/spectrum/1040g34o31pkjl7rs3u405oakffv0j2counrahe0!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,线上课,高效学习,学习干货,全程陪跑,学习规划', 'last_modify_ts': 1773154646396, 'note_url': 'https://www.xiaohongshu.com/explore/69300bfe000000001e010f0e?xsec_token=ABccRRpIQ2vzxkw55WdyG1-DONpXTM5UQLrvzjS7FmiZk=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABccRRpIQ2vzxkw55WdyG1-DONpXTM5UQLrvzjS7FmiZk='}
