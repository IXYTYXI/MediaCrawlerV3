2026-03-10 23:05:47 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68f0c5540000000007022b3b', 'type': 'normal', 'title': '高中数学差❓1人1班高效学找高途', 'desc': '👉 不少家长愁孩子高中数学\n👉 基础差跟不上、想冲高分没方向，补了课也没效果\n🔥 其实选对方法很重要！高途高中数学1v1课，1人1班高效学，做一站式规划，负责到出芬，在家线上学就能轻松超车！\n\t\n✅ 【想让孩子数学高效冲刺，高途4大优势缺一不可】\n▫️ 1人1 班高效学，不浪费1分钟：全程1v1专属教学，不会有 “老师顾不上” 的情况！孩子哪块弱就重点补，不用跟着别人节奏浪费时间，效率翻倍；\n\t\n▫️ 严选名校学霸主讲，知识全覆盖：主讲老师都是名校毕业，既懂 “0 基础怎么教”，也会 “高分技巧”帮孩子在考试中抢时间；\n\t\n▫️ 课前课中课后，督学全程陪：课前帮孩子整理 预习复习，课中同步记录听课状态，课后批作业、答疑，不让漏洞堆积；\n\t\n▫️ 定期家长会，进度透明：老师会详细反馈 “孩子近期掌握了哪些知识点”“还需加强哪块内容”，家长随时了解进度，放心又省心；\n\t\n让孩子在家就能高效学，从基础差到尖子生，冲刺理想大学～\n↙️ 赶紧点击【立即咨询】领取1v1试学体验～\n🙋 报名要求：32岁以上家长\n⏰ 报名时间：即日起 - 2026年12月31日\n#高途[话题]# #一对一[话题]# #网课[话题]# #高中数学怎么学[话题]# #高中学习方法[话题]# #高考数学[话题]# #高中网课[话题]# #高效学习[话题]# #高中数学[话题]#', 'video_url': '', 'time': 1760660220000, 'last_update_time': 1760609621000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '', 'comment_count': '4', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102305/475c92158a18be9b0ace27a377876027/spectrum/1040g0k031nmq9g6152005oakffv0j2cofesqes0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102305/1cb64f14068c2c42e4fcfee452c9d216/spectrum/1040g0k031nmq9g61520g5oakffv0j2co9btodt8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102305/f252f00e3c609166afdffad89aaf3c81/spectrum/1040g0k031nmq9g6152105oakffv0j2coavdcph8!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,高中数学怎么学,高中学习方法,高考数学,高中网课,高效学习,高中数学', 'last_modify_ts': 1773155147478, 'note_url': 'https://www.xiaohongshu.com/explore/68f0c5540000000007022b3b?xsec_token=ABkizMhL1hJiuB0BaMp63_fNRGNLZRsx1XnVXgNlrTafM=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABkizMhL1hJiuB0BaMp63_fNRGNLZRsx1XnVXgNlrTafM='}
