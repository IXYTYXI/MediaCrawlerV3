2026-03-10 21:20:13 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69afb62c000000001503164a', 'type': 'video', 'title': '娃开心妈省心！数学思维培养超简单', 'desc': '真香！以前辅导数学鸡飞狗跳，现在娃自己学得乐呵呵！🥳 多亏@妤熙麻麻  挖到的宝藏，数学思维培养原来一点都不费妈～\n\t\n🔍 具象化教学｜理解不费劲\n把枯燥的数字变成图形和实物，抽象概念一眼看懂，娃不用死记硬背，知识点吸收快，老母亲再也不用拍桌子了～\n\t\n🚀 游戏化闯关｜学习不枯燥\n把数学题藏在动画和游戏里，娃以为是玩，其实是在练思维！每过一关都有成就感，主动要求“再玩一局”，根本不用催～\n\t\n🌐 精品小班｜辅导不费妈\n老师全程关注，引导娃自己讲出思路，当甩手掌柜真爽！有不懂的老师当场解决，课后还有报告，娃的进度随时掌握～\n\t\n🎨 双语启蒙｜能力双丰收\n数学英语一起抓，娃在解题中还能练听力口语，不仅思维活了，嘴皮子也溜了，性价比真的绝了～\n想搞定娃数学思维的姐妹快冲！选对方法，带娃真的一点都不累，轻松实现母慈子孝～\n\t\n现在Mathplore开启了免费试听活动❗点击左下角【立即咨询】即可0元领取价值1888元的试听大礼包~\n\t\n⏰活动时间：即日起-2028年12月31日\n*仅面向海外18+家长群体\n\t\n#数学思维训练[话题]#  #数学开窍[话题]#  #Mathplore新加坡数学[话题]#  #新加坡数学[话题]#  #小学数学怎么学[话题]#  #孩子爱学习[话题]#', 'video_url': 'http://sns-video-al.xhscdn.com/stream/79/110/259/01e9afb5df48f4aa010370039cd65ff540_259.mp4', 'time': 1773123116000, 'last_update_time': 1773123116000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '1', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '四川', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102120/71b9b863455a434ab8bad8187e1d8bde/spectrum/1040g34o31th96jukl80g5odiop740t80j9pegc8!nd_dft_wlteh_webp_3', 'tag_list': '数学思维训练,数学开窍,Mathplore新加坡数学,新加坡数学,小学数学怎么学,孩子爱学习', 'last_modify_ts': 1773148813724, 'note_url': 'https://www.xiaohongshu.com/explore/69afb62c000000001503164a?xsec_token=AB9mya0G5gRV6vHe5UesXJL1TxMkk3J0ZzK7plkoVHkUM=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB9mya0G5gRV6vHe5UesXJL1TxMkk3J0ZzK7plkoVHkUM='}
