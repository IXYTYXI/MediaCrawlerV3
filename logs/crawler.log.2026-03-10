2026-03-10 20:55:48 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69aa7366000000002303b6a2', 'type': 'normal', 'title': '新加坡数学开学班，数学思维直接打通💥', 'desc': '-\n孩子学数学只会套公式、死记硬背\n稍微灵活一点就卡壳，换个题型就不会做😫\n逻辑讲不清、思路打不开，越学越抵触数学\n-\n别慌！开学季给大家挖到王炸：\nsparkmath新加坡数学开学班\n专注新加坡数学思维，用国际公认的科学方法教数学～\n-\n为啥家长都在选？👇\n【CPA教学法，打通底层逻辑】\n从具象到图形再到抽象，一步步把概念讲透，不硬背公式、不盲目刷题，真正理解数学本质，逻辑一通百通📚\n【≤8人小班，精准盯卡点】\n每班不超8个孩子，老师实时同步解题步骤，一眼捕捉思维漏洞，当场纠正、全程关注\n【全流程伴学，问题不过夜】\n课后全程跟进辅导，疑问当天解决、错题及时梳理\n【游戏化设计，爱上数学不费力】\n趣味互动+动画激励，孩子边玩边学，主动举手、主动思考\n-\n这么靠谱的新加坡数学课，开学季必须给娃安排上！\n📩感兴趣的家长速戳下方【立即咨询】\n领限时0元试听大礼包～\n👇0元领3重福利：\n1️⃣1节新加坡数学直播课\n2️⃣1v1定制学习规划\n3️⃣价值3422元228课时学习大礼包\n⏰活动时间：即日起-2027年12月31日\n*本内容为教育规划，面向家长群体\n#新加坡数学[话题]# #sparkmath[话题]# #数学思维[话题]# #小学数学[话题]# #开学必备[话题]# #学习规划[话题]#', 'video_url': '', 'time': 1772778342000, 'last_update_time': 1772778343000, 'user_id': '64740b96000000000f006adf', 'nickname': 'Spark Math 数学课程', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo30oe65qe8ie5g5p3k1eb3oqmvph5fk6g', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102055/88cbabf1ddde0b1c829ef01181e61821/spectrum/1040g0k031tc4ppj1la005p3k1eb3oqmvpi8lm80!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102055/aafff39b1191d7c53cc2fde4aede0ac2/spectrum/1040g0k031tc4ppj1la0g5p3k1eb3oqmvaj736l0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102055/430a95dcb7ffbdf5c0f29bf41cac8110/spectrum/1040g0k031tc4ppj1la105p3k1eb3oqmv8hkprd0!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学,sparkmath,数学思维,小学数学,开学必备,学习规划', 'last_modify_ts': 1773147348563, 'note_url': 'https://www.xiaohongshu.com/explore/69aa7366000000002303b6a2?xsec_token=ABEY8sU4xINMp3qbyKnY2hi1LsLaTi6PhyGJXizJbviAQ=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABEY8sU4xINMp3qbyKnY2hi1LsLaTi6PhyGJXizJbviAQ='}
