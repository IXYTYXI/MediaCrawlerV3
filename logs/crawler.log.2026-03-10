2026-03-10 23:27:19 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '686623d10000000015021822', 'type': 'normal', 'title': '1v1陪跑15天，高三一轮复习通关', 'desc': '🤷 高三党还在焦虑一轮复习无从下手？\n😐 别人暑假躺平，学霸已经用把三年知识点复习了一遍！\n✅ 别焦虑，直接跟着高途1v1网课名师带飞 + 全天督学，每天沉浸式逆袭，开学直接领跑！\n\t\n👉 一对一个性化定制适合你的复习课程\n👉 督学鼓励，难题及时答疑解惑\n👉 课程灵活，时间地点任你定\n👉 提供个性化学习方案，生成专属学习报告\n👉 全程陪伴式服务，家长安心放心\n.\n🌟 课前：制定专属个性化的复习方案，因材施教；\n💎 课中：双一流名师主讲，高效的学一整节；\n🥳 课后：专属班班课后答疑，查漏补缺；\n-\n🙋🏻\u200d♀ 如果孩子自学效率低、学习压力大、备考迷茫没头绪，试试高途1v1吧～\n📍 点击左下角【立即咨询】领取1v1试听吧～\n⏰ 活动时间：即日起-25年12月31日\n🙋 报名要求：仅面向32岁以上家长\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#高中[话题]#\ufeff \ufeff#高三[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#暑假课[话题]#\ufeff \ufeff#高三一轮[话题]#\ufeff \ufeff#一轮复习[话题]#\ufeff', 'video_url': '', 'time': 1751524305000, 'last_update_time': 1751524306000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '6', 'collected_count': '5', 'comment_count': '', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102327/b1d4840a1af67b230735e48f22a6bb04/spectrum/1040g34o31jfe2vidji105oakffv0j2copqvnm2g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102327/3bf610774d1168a8c1903be373d40328/spectrum/1040g34o31jfe2vidji1g5oakffv0j2co6tqvcr0!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中,高三,网课,暑假课,高三一轮,一轮复习', 'last_modify_ts': 1773156439952, 'note_url': 'https://www.xiaohongshu.com/explore/686623d10000000015021822?xsec_token=ABqipxp4a6oPWAk9br2XGY0u4QuL_13EGbZ2Pd03VvKro=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABqipxp4a6oPWAk9br2XGY0u4QuL_13EGbZ2Pd03VvKro='}
