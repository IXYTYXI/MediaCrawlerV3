2026-03-10 22:18:03 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69afd7bc0000000022033744', 'type': 'normal', 'title': '语文太拉分👊跟1V1 逆袭前排~', 'desc': '🆘🆘🆘你家娃的语文是不是学起来很困难😰\n古诗文背了就忘，阅读理解总丢分，成绩上不去❓\n基础知识点零散，病句成语频频踩坑，越学越乱❓\n作文没素材没结构，写来写去都是口水话，高分根本沾不上边❓\n·\n❌别让孩子就这样放弃了啊❗❗❗\n跟着👉【掌门一对一高中语文网课】，直接卷飞同龄人啊🔥🔥\n·\n为什么选择掌门❓\n🈶专属学情诊断\n课前安排语文小测，精准揪出知识短板 —— 不管是古诗文薄弱、基础不扎实，还是阅读作文没方法，都能针对性制定学习规划，哪里不会补哪里，稳步提升有方向📈\n🈶高频互动不走神\n老师讲课不枯燥，用巧记方法背古诗文、用真题拆解阅读答题模板，还会随时引导思路，让孩子跟着节奏走，想跑神都难✍\n🈶雄厚的师资力量\n清北等名校毕业名师坐镇，经过层层筛选和专项培训，懂语文考点更懂答题套路；不局限当地师资，全国好老师任选，孩子不满意可免费换🔥\n🈶全时段答疑解惑\n课上没吃透的知识点、课下想不通的阅读主观题、作文不会修改，随时找老师问，24h 在线攻克语文 “死角”，不让问题过夜，今日事今日毕💪\n·\n📢现在点击下方⬇【立即咨询】还能 0⃣元领取👉🏻1V1 体验课～\n🉐1 对 1 专业语文辅导➕定制专属提升计划➕语文干货资料\n这么超值的活动家长们还不赶紧冲！！！\n·\n🔍报名要求：32 岁以上家长\n⏰截止时间：即日起 - 2026 年 12 月 31 日\n#掌门一对一[话题]#  #语文文言文[话题]#  #掌门1对1[话题]#  #高中语文[话题]#  #语文学习[话题]#  #一对一[话题]#  #语文[话题]#  #网课[话题]#  #语文老师[话题]#', 'video_url': '', 'time': 1773145982000, 'last_update_time': 1773131709000, 'user_id': '636b58ff000000001f01a10d', 'nickname': '掌门1对1规划', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/65e00d1bd52bf10001bb9cdb.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '湖北', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102218/084106faf6c4d494115edc8f09048921/spectrum/1040g0k031thd998il60g5orbb3vnr88d9mvano8!nd_dft_wlteh_webp_3', 'tag_list': '掌门一对一,语文文言文,掌门1对1,高中语文,语文学习,一对一,语文,网课,语文老师', 'last_modify_ts': 1773152283462, 'note_url': 'https://www.xiaohongshu.com/explore/69afd7bc0000000022033744?xsec_token=AB9mya0G5gRV6vHe5UesXJLzou0t7tSdiCiQ5G1xBmvgg=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB9mya0G5gRV6vHe5UesXJLzou0t7tSdiCiQ5G1xBmvgg='}
