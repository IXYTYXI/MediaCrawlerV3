2026-03-10 22:51:57 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '694bb79c000000000d00c133', 'type': 'normal', 'title': '26高考冲刺！名师1v1负责到出分为止', 'desc': '📣 家有26届高考生的家长集合！\n🤔 复习进入关键期，孩子遇高考难题卡壳、偏科补不上、自律性差？\n✅ 别慌！这款高三1v1陪跑网课直接封神——复旦、人大名师领航，先试听再报名，全程陪跑到高考出分！\n\t\n👉 名校名师坐镇！高考难题全拿捏\n✔️ 严选名校出身的名师，深耕高考辅导多年，太懂命题规律和套路了；\n✔️ 帮孩子重塑解题能力，梳理知识点框架、总结专属答题技巧，效率直接翻倍；\n\t\n👉 先试听再报名！零风险试错不踩坑\n✔️ 最怕报课遇到不合适的老师？这里直接给足安全感；\n✔️ 先试听让孩子感受名师上课节奏，看教学风格、解题思路合不合拍；\n\t\n👉 拒绝“一刀切”复习！从入学开始就全程个性化：\n✔️ 先做入学检测，精准定位孩子的薄弱科目和知识盲区；\n✔️ 再根据检测结果和高考目标，1v1定制专属学习规划；\n✔️ 课上1v1直播授课，专项攻克薄弱点，聚焦经典题型强化训练；\n\t\n更安心的是，全程陪跑到高考出分，从一轮复习到考前冲刺，不用频繁换辅导，跟着老师的节奏走，孩子复习有方向，家长彻底不用愁！\n↙️ 赶紧点击【立即咨询】领取1v1试学名额👇\n📝 报名要求：仅面向32岁以上家长\n📆 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #高考冲刺[话题]# #艺术生文化课[话题]# #高考逆袭[话题]# #高考复习[话题]#', 'video_url': '', 'time': 1766624761000, 'last_update_time': 1766569884000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '10', 'collected_count': '1', 'comment_count': '3', 'share_count': '2', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102251/37cb4992e8121566eb8caee739283eba/spectrum/1040g0k031qfkcepm6u005oakffv0j2co0s1o7d8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102251/1563097d41952e44014e063f73aa8605/spectrum/1040g0k031qfkcepm6u0g5oakffv0j2co3cghcko!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,高考冲刺,艺术生文化课,高考逆袭,高考复习', 'last_modify_ts': 1773154317015, 'note_url': 'https://www.xiaohongshu.com/explore/694bb79c000000000d00c133?xsec_token=ABzN0YzaYGsofFe34HW7gz-GX5kH74Bz_oH8KJSX2ej5w=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABzN0YzaYGsofFe34HW7gz-GX5kH74Bz_oH8KJSX2ej5w='}
