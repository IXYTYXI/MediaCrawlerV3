2026-03-10 21:40:06 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69842d71000000002200a2d4', 'type': 'normal', 'title': '三年级⚠️千金不换的数理思维布局（赛版）', 'desc': '三年级还在死磕数理思维基础？❌\n聪明的家长已经在布局大赛了！\n\t\n以赛促学不仅能拔高思维，含金量也直接拉满，帮孩子赢在6升7阶的关键节点。\n如果还没方向，直接跟平行线根源学习法抄作业就对了！\n它的1-6阶体系从1阶启蒙到6阶，完美覆盖基础+参赛需求：\n• L3：开启模块化学习，直接拿下鸡兔同笼、割补思想等核心奥数模型\n• L4-L5：衔接赛级内容，为冲击各类奖项打基础\n• L6：系统梳理七大模块，强化应试技巧，无缝衔接初z内容\n\t\n平行线的核心优势真的让人放心：\n✅ 根源教学法：不靠刷题死记，帮孩子搭建清晰的思维体系，把抽象知识变直观\n✅ 清北名师团队：简历通过率仅1%，用底层逻辑带孩子真正学会思考\n✅ 365天伴学服务：阶段诊断+特训小灶+全年答疑+1年回放，效果看得见\n✅ 性价比拉满：15元/课时，还送纸质教材+1v1规划\n\t\n🎁 现在点击【立即咨询】，免费领专业老师1v1规划\n⚠️ 仅面向28+以上家长，学前不适用哦～\n#平行线教育[话题]#  #数理思维[话题]#   #根源学习法[话题]#', 'video_url': '', 'time': 1770270065000, 'last_update_time': 1772619698000, 'user_id': '642a3b7f000000001102347e', 'nickname': '平行线根源在线数学', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31lto8ekklmq05p1a7dvkcd3utccduk0', 'liked_count': '2', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '河南', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102140/830eaa9b0c71c39bf57f96ee6266d0c6/spectrum/1040g0k031s6ooar45e1g5p1a7dvkcd3unogp2l0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102140/74813823b3662acca3793bac24aeea73/spectrum/1040g0k031s6ooar45e105p1a7dvkcd3ud5d3qkg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102140/7a5878d1a67f39828ab6a39248a29452/spectrum/1040g0k031s6ooar45e0g5p1a7dvkcd3u3tvjdj0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102140/963949c4adf8ede53cc6b9f674c4f54f/spectrum/1040g0k031s6ooar45e005p1a7dvkcd3uv7om8ho!nd_dft_wlteh_webp_3', 'tag_list': '平行线教育,数理思维,根源学习法', 'last_modify_ts': 1773150006822, 'note_url': 'https://www.xiaohongshu.com/explore/69842d71000000002200a2d4?xsec_token=ABJpUCJJ50QjggqKFv5HUQly_L1I3qEooJM4itk6acxTM=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABJpUCJJ50QjggqKFv5HUQly_L1I3qEooJM4itk6acxTM='}
