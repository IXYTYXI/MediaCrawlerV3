2026-03-10 22:44:53 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6985aca3000000001b01cfb0', 'type': 'normal', 'title': '专收高中物理差生｜1v1线上高效逆袭', 'desc': '👀 家有物理差生速看！\n👨\u200d🏫 本人高中物理老师，依托高途1v1网课，专收物理差生（诚心学优先）！\n🎓 中国地质大学（北京）毕业，授课1000h+，经验丰富，基础再差也能教，每次2小时亲自带，全程负责到大考出分，帮孩子摆脱差生标签～\n\t\n### 👉 关于我｜靠谱不玩噱头\n🌟 非兼职老师，名校毕业、理科功底扎实，只讲实用方法；\n🌟 带过无数差生逆袭，哪怕从零开始，也能稳步提分，深谙差生提分技巧；\n\t\n### 👉 高途1v1加持｜逆袭更高效\n🌟 依托高途平台，在家就能学、不用跑机构：\n🌟 1v1定制：贴合个人基础，精准补漏薄弱模块；\n🌟 大招拆解：手把手教公式用法、解1道通1类；\n🌟 聚焦提分：对接高频考点，专攻差生易错题型，不做无用功；\n\t\n✅ 7*24h答疑：我+高途团队随时在线，疑问不隔夜；\n✅ 全程盯学：我亲自盯预习、听课、复习，高途同步辅助，杜绝拖延；\n✅ 定期反馈：每周同步学习进度，家长随时了解；\n\t\n每次2小时亲自带，负责至出分，诚心学就来，帮你摆脱物理拖后腿！\n点击【立即咨询】获取专属学情检测和1v1试学名额吧～\n📝 报名要求：仅面向32岁以上家长\n📆 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #高考物理[话题]# #高中物理[话题]# #学物理原来这么简单[话题]# #高效学习[话题]#', 'video_url': '', 'time': 1770368163000, 'last_update_time': 1770368163000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '2', 'comment_count': '1', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102244/f89f5c33ee74a827e6ba8a6f8a336f0b/spectrum/1040g34o31s87hipt58105oakffv0j2co59klb78!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,高考物理,高中物理,学物理原来这么简单,高效学习', 'last_modify_ts': 1773153893026, 'note_url': 'https://www.xiaohongshu.com/explore/6985aca3000000001b01cfb0?xsec_token=ABzaatJlt5nlUnF3m8mEHx3skzo1UfmZA2kE_1k1QpKCA=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABzaatJlt5nlUnF3m8mEHx3skzo1UfmZA2kE_1k1QpKCA='}
