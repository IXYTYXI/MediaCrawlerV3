2026-03-10 20:44:21 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '66acec7d000000002701e7f3', 'type': 'normal', 'title': '新加坡数学跟着这个课学❗超越同龄人', 'desc': '现在学习新加坡数学的孩子越来越多了\n它能让孩子学习提速，还能让家长减负\n快来报名这个新加坡数学课程，错过后悔一辈子❗\n·\n🚩小班直播课班型：培优班&竞赛班\n🚩班容：4-6人班\n🚩纯英文课件系统\n🚩多种语言：全英班、双语班、中文班\n·\n🚩Spark Math课程特色\n✅课堂中强大的交互设计，沉浸式的课堂体验，让孩子更专注！\n✅CPA教学法让复杂的问题简单化、可视化，让思维更快，更清晰\n✅多种形式的巩固复习，有助于提升对知识的吸收和理解\n·\n娃都能轻松入门数学，从小建立起良好的数学思维\n现在点击图片下方⬇ 【立即领取】即可免费获得Spark Math试听课~\nSpark Math持续提供：\n✅全级别系统课程，一站式直通1%\n✅老师全程伴学、陪练kao\n✅课堂中因材施教，保证每个孩子学习效果\n✅课前课后练习丰富，强化巩固知识点\n✅课件交互操作，让知识【直观化】，更容易理解\n·\n现在点击图片下方⬇ 【立即领取】就可以免费体验哦\n试听名额已开启，立即预约吧~\n⏰ 截止时间：即日起—2024年12月31日\n*课程面向海外人群（18岁以上）\n#sparkmath新加坡数学[话题]#\xa0\xa0\xa0#新加坡数学[话题]#\xa0\xa0#新加坡数学网课[话题]#\xa0\xa0#新加坡数学建模[话题]#\xa0\xa0#新加坡数学补习[话题]#\xa0\xa0#新加坡数学竞赛[话题]#\xa0\xa0#新加坡数学应用题[话题]#\xa0\xa0#新加坡数学思维[话题]#\xa0\xa0#新加坡数学课[话题]#\xa0\xa0#新加坡数学课程[话题]#\xa0\xa0#新加坡数学老师[话题]#\xa0\xa0#新加坡数学教材[话题]#\xa0\xa0#新加坡数学英文[话题]#\xa0\xa0#新加坡数学cpa[话题]#\xa0\xa0#新加坡小学数学[话题]#\xa0\xa0#小学数学[话题]#\xa0\xa0#数学思维[话题]#\xa0\xa0#开学季[话题]#', 'video_url': '', 'time': 1722608765000, 'last_update_time': 1722608765000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '3', 'collected_count': '', 'comment_count': '3', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102044/415e1713b934ceb28f797290d407759a/spectrum/1040g0k03160i1s080q005olhcu8lbcma3vp9n20!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102044/eae3590472fab9ba57f39d34a9b2dfc3/spectrum/1040g34o3160i1tk1go0g5olhcu8lbcmaf2aq5e0!nd_dft_wlteh_webp_3', 'tag_list': 'sparkmath新加坡数学,新加坡数学,新加坡数学网课,新加坡数学建模,新加坡数学补习,新加坡数学竞赛,新加坡数学应用题,新加坡数学思维,新加坡数学课,新加坡数学课程,新加坡数学老师,新加坡数学教材,新加坡数学英文,新加坡数学cpa,新加坡小学数学,小学数学,数学思维,开学季', 'last_modify_ts': 1773146661313, 'note_url': 'https://www.xiaohongshu.com/explore/66acec7d000000002701e7f3?xsec_token=ABGQKHSS-