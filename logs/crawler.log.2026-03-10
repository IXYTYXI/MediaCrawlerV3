2026-03-10 23:39:29 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6826db0a000000000f03bcc2', 'type': 'normal', 'title': '暑假1v1督学是真凶！专治不自律🔥', 'desc': '💡 为什么有些学生高三突然开挂？\n⚠️ 真相：他们暑假偷偷上了1v1魔鬼督学课！\n✔️ 每天学习状态被监控\n✔️ 每道错题都被追盯到底\n✔️ 想偷懒？班班立刻连环call\n🎯 高途1v1督学到底有多狠？比家长更操心孩子学习状态\n👉 课前：\n专属班班提前提醒上课时间\n发送当堂【预习锦囊】（含重点知识）\n定制学习计划，详细到每天每小时按照学习进度更新，每周动态调整\n👉 课中：\n名师直播授课时，班班实时监控学习状态\n主讲老师实时互动，随时提问，提溜着学\n实用大招指导、解题思路传授\n👉 课后：\n课后班班督促作业，1v1精批\n智能题库+阶段测试，家长随时了解学习情况\n24小时提问必回应（专属班班答疑）\n▸ 先诊断再上课，专打知识漏洞，不自律的必选！\n👇点击【立即咨询】抢占专属试听\n💬 报名要求：仅面向32岁以上家长\n⏰ 截止时间：即日起至25年12月31日\n\ufeff#高途[话题]#\ufeff\xa0\ufeff#高中[话题]#\ufeff\xa0\ufeff#一对一[话题]#\ufeff\xa0\ufeff#暑假[话题]#\ufeff\xa0\ufeff#逆袭[话题]#\ufeff\ufeff', 'video_url': '', 'time': 1747377213000, 'last_update_time': 1747377213000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '129', 'collected_count': '41', 'comment_count': '', 'share_count': '11', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102339/0dc61b145e4cd866e17ccc3096d6c4ae/spectrum/1040g34o31hhker32j4005oakffv0j2co9jltmn8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102339/112919f61c06b1796b788cc8911bdbf1/spectrum/1040g34o31hhker32j40g5oakffv0j2co87atato!nd_dft_wlteh_webp_3', 'tag_list': '高途,高中,一对一,暑假,逆袭', 'last_modify_ts': 1773157169164, 'note_url': 'https://www.xiaohongshu.com/explore/6826db0a000000000f03bcc2?xsec_token=ABLZ5tESpUCBJHu9L7GzkeA_aUPWl1jKTb9sJ4wdJCZkg=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABLZ5tESpUCBJHu9L7GzkeA_aUPWl1jKTb9sJ4wdJCZkg='}
