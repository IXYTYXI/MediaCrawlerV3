2026-03-10 22:50:08 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '695f508b000000001a0276f8', 'type': 'normal', 'title': '冲刺26高考❗️高途高中1v1陪跑至出分', 'desc': '😭 谁懂高三家长的奔波之苦！\n🏃 之前送孩子跑机构，来回1小时全浪费在路上\n✅ 现在高途1v1在家就能学，省去通勤麻烦\n⏰ 孩子能多挤时间刷题复习，更安心的是全程陪跑至出分\n👉 从现在到高考结束，不用频繁换辅导，跟着老师节奏走就行！\n\t\n✅ 高途严选学霸名师！任选不满意就换\n✔️ 多轮严选名校毕业学霸，不仅功底扎实，更懂高考考点趋势和提芬套路；\n✔️ 更贴心的是老师可自由挑选，不满意随时更换，不用委屈将就；\n✔️ 还支持先试听再决定，感受完教学节奏再报名，不花冤枉钱！\n\t\n✅ 1v1精准提分！高效不做无用功\n✔️ 学前检测+薄弱分析：精准定位提分突破口；\n✔️ 根据学情定制一套完整计划，每节课都有明确目标；\n✔️ 高频互动防跑神：1v1直播带学，高频提问互动；\n✔️ 边讲边练趁热打铁：及时巩固消化，不让疑问堆积；\n✔️ 7*24小时随时答疑：疑问不隔夜，让娃学习更顺畅；\n\t\n高途名师1v1全程陪跑，在家就能高效学，精准提芬还省心～\n想给孩子争取1v1试听名额的家长，点击【立即咨询】获取专属学情检测和学习方案～\n📝 报名要求：仅面向32岁以上家长\n📆 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #高中学习方法[话题]# #高考冲刺[话题]# #高效学习[话题]# #高考逆袭[话题]# #艺考文化课[话题]# #高考[话题]#', 'video_url': '', 'time': 1767854219000, 'last_update_time': 1767854220000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '1', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102250/e072cf9410431e9985e07c7fae5473b0/spectrum/1040g34o31r2op75un0005oakffv0j2coosuk7fg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102250/796941f331682f2f6d37714edc3a89f3/spectrum/1040g34o31r2op75un00g5oakffv0j2co4oo6gu8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102250/c10d3c451b742c2b7c19f72546492dbb/spectrum/1040g34o31r2op75un0105oakffv0j2cornfuak0!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,高中学习方法,高考冲刺,高效学习,高考逆袭,艺考文化课,高考', 'last_modify_ts': 1773154208350, 'note_url': 'https://www.xiaohongshu.com/explore/695f508b000000001a0276f8?xsec_token=AB_e4TLEe2FvTsCISOpzib8RpkFIajgFhf3QsvCCjqh7E=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB_e4TLEe2FvTsCISOpzib8RpkFIajgFhf3QsvCCjqh7E='}
