2026-03-10 23:12:00 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68c4caf9000000001c004797', 'type': 'normal', 'title': '找靠谱1对1？高途超超超负责❗️', 'desc': '给娃找1对1，最怕 “报了等于没报”：\n没人盯学、老师不专业、教学没针对性…\n直到试了高途1对1才发现，靠谱的网课真的能让学习效果翻一番！\n专属规划、全程监督、双一流名🧑\u200d🏫师，不管基础如何都能适配，太懂家长需求了～\n\t\n👉【高途1对1从 “规划 - 教学 - 监督” 全流程把关，每一点都让家长放心】\n▫️ 专属1对1提升规划，不浪费1分钟：不管哪个年级、基础如何，先做专业学情测评，每节课都有明确目标，不做无用功；\n▫️ 全方位陪伴监督，不用家长催：不只是老师上课，还有专属班班全程盯学，根据娃的掌握情况调整后续计划；\n▫️ 双一流持证主讲，解题有技巧：全是985/211或重点师范毕业，100% 持证上岗，让娃学会技巧，解ti又快又准，得心应手。\n\t\n给娃选1对1靠谱比啥都重要！高途全程盯学超负责，让娃少走弯路~\n↙️ 点击【立即咨询】抢先体验1v1试学名额\n🙋 报名要求：仅面向32岁以上家长\n⏰ 活动时间：即日起-25年12月31日\n#高途[话题]# #一对一[话题]# #线上课[话题]# #课程辅导[话题]# #学习规划[话题]# #线上教学[话题]# #学习更高效[话题]#', 'video_url': '', 'time': 1757727481000, 'last_update_time': 1758160441000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '23', 'collected_count': '8', 'comment_count': '7', 'share_count': '12', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102312/7256754c14945b68b5e4456107cf1d08/spectrum/1040g34o31mbrukd2ku205oakffv0j2co4bgicvo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102312/5bbfdf3efc574346429bda40524f9a5a/spectrum/1040g34o31mbrukd2ku2g5oakffv0j2co7sjqor8!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,线上课,课程辅导,学习规划,线上教学,学习更高效', 'last_modify_ts': 1773155520957, 'note_url': 'https://www.xiaohongshu.com/explore/68c4caf9000000001c004797?xsec_token=ABMURaXv7JX3vOU4j2bgAE2hLZNT6wBariaCsgl1ZvB84=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABMURaXv7JX3vOU4j2bgAE2hLZNT6wBariaCsgl1ZvB84='}
