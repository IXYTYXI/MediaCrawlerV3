2026-03-10 22:42:37 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '699eb4bd000000000d009f2f', 'type': 'normal', 'title': '26高考百天冲刺，高途1v1全程陪跑', 'desc': '### 👉 百天冲刺，这类孩子闭眼冲\n- 26高考生，想抓住最后百天想要逆袭的；\n- 在家备战高考，踩过坑的想找靠谱1v1的；\n- 基础薄弱/偏科，需要从头带学、精准补弱的；\n- 家长没时间盯学，想找全程负责、省心兜底的......\n\t\n✅ 百天冲刺核心｜高途1v1，陪跑到高考不敷衍\n不是上完课就散，每一步都有老师全程跟进，相当于给娃请了专属高考管家，不用我追着问、催着学；\n\t\n✅ 名师1v1从头带学｜百天精准提分不盲目\n高途名师经多轮严选，持证上岗、经验丰富，全程1v1从头带学考点；\n1人1班直播授课，聚焦高频核心考点，摒弃冷门知识点；\n\t\n✅ 课前1v1诊断｜精准定位，不做无用功\n全面检测娃的学科基础水平，1v1量身定制百天冲刺计划；\n精准对接薄弱点，不搞“一刀切”，让百天冲刺每一步都有效；\n\t\n✅ 全流程伴学+24h答疑批改｜家长彻底省心\n从课前预习到课后练习，全程超级负责，随时反馈娃的学习进度；\n课后24h在线，不仅答疑解惑，还会批改作业、复盘错题；\n\t\n⏰ 高考百天冲刺，时间不等人，选对高途1v1，让娃少走弯路，成功上岸✨\n\t\n📣 赶紧点击左下角【立即咨询】领取1v1试学名额\n📍 活动范围：仅面向32岁以上家长\n🌈 活动时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #高考冲刺[话题]# #高中学习方法[话题]# #高考逆袭[话题]# #高效学习[话题]# #线上课[话题]#', 'video_url': '', 'time': 1772008637000, 'last_update_time': 1772008638000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '3', 'collected_count': '', 'comment_count': '1', 'share_count': '2', 'ip_location': '河北', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102242/3c9063afa3a782e6e50dd8de82986b47/spectrum/1040g34o31t0lp8a1le305oakffv0j2co8q8l2s8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102242/c2fcc764dc47c47b1592016acfbbd4b9/spectrum/1040g34o31t0lp8a1le3g5oakffv0j2co8i3veo8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102242/e2807cdb9ed431a48928b62abaed0efc/spectrum/1040g34o31t0lp8a1le405oakffv0j2co2v9gtk0!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,高考冲刺,高中学习方法,高考逆袭,高效学习,线上课', 'last_modify_ts': 1773153757339, 'note_url': 'https://www.xiaohongshu.com/explore/699eb4bd000000000d009f2f?xsec_token=AB2iCfwYPnGan88a-wVARvBha7BUEGIRpTNQa-VlHm24s=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB2iCfwYPnGan88a-wVARvBha7BUEGIRpTNQa-VlHm24s='}
