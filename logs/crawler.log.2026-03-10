2026-03-10 17:57:19 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '669e04f0000000000d00d755', 'type': 'normal', 'title': '数学超前学习的经验', 'desc': '幼儿园阶段数学几乎没有不提前学的，至少20内加减基本都是靠家长奶出来的，厉害的可能一路超前\n\t\n我家数学也超前学了，但是数学超前学很容易出现问题。前期这个问题很隐蔽也很难察觉，但是几乎无一例外的在学习到三下至四年级这段，超前学的问题很容易就看出来了，这个阶段非常关键，记住这个关键技术位，跨过这个技术位，前面又是一片广阔的天地\n\t\n#数学学习[话题]# ＃#学霸养成[话题]#', 'video_url': '', 'time': 1721631984000, 'last_update_time': 1721631984000, 'user_id': '56580788f53ee02b86a5d94e', 'nickname': '哈哈哈2222jjjj', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/0dd6f7e91ce0bea602fbc47515b7c72f.jpg', 'liked_count': '270', 'collected_count': '226', 'comment_count': '1263', 'share_count': '25', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603101751/57fb6478256b68275cd95a12a3876799/1040g2sg315hsm9k81e5g43a5ph3ohmaefk9qchg!nd_dft_wlteh_webp_3', 'tag_list': '数学学习,学霸养成', 'last_modify_ts': 1773136639525, 'note_url': 'https://www.xiaohongshu.com/explore/669e04f0000000000d00d755?xsec_token=ABB0l4UZodlVRnW7OOX1jqIxAywC-DdNZihnpWbCLrSXI=&xsec_source=pc_search', 'source_keyword': '数学超前学', 'xsec_token': 'ABB0l4UZodlVRnW7OOX1jqIxAywC-DdNZihnpWbCLrSXI='}
