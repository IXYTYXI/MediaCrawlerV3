2026-03-10 23:21:08 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68834b7f00000000230051a2', 'type': 'normal', 'title': '高途1v1全程陪跑，效率真的太高了', 'desc': '🥳 有高中家长反馈：前前后后试听8家机构，对比到眼花，最终定了高途一对一\n✅ 现在学了2个月彻底服了 —— 老师从知识点讲到考试技巧，连课后作业、半夜有问题都管，全程陪跑效率真的高！\n\t\n🎯 【三方会议，高效沟通】\n线上预约之后会有专门的老师和家长联系，初步沟通学情，老师根据练习和学习情况，通过三方会议制定专属学习方案；\n\t\n🎯 【1v1专属学习规划】\n针对每个人的学习情况量身定制学习规划，时间有限，只学对自己“有用”的！\n\t\n🎯 【专属1v1辅导，全程陪伴学习】\n名校主讲从督学到答疑，从规划到伴学，陪高中生走过每一个奋斗的日夜！\n\t\n🎯 【定期测试+阶段家长会】\n根据现状及时调整学习计划，查漏补缺；阶段家长会随时同步孩子学习状态，家长省心！\n\t\n点击左下角【立即咨询】即可领取1v1试听特权吧～\n💬 报名要求：仅面向32岁以上家长\n⏰ 截止时间：即日起-26年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#高中[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#高一[话题]#\ufeff \ufeff#高二[话题]#\ufeff \ufeff#高三[话题]##高中网课[话题]#  #高中物理[话题]# #高中化学[话题]# \ufeff', 'video_url': '', 'time': 1753435007000, 'last_update_time': 1761961692000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '820', 'collected_count': '781', 'comment_count': '1219', 'share_count': '298', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102321/bc756af31395b378d305c6947811d4af/spectrum/1040g34o31oauvaavks305oakffv0j2co3825lv0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102321/537c8218a4da36c82c2d535ae0f1b3e6/spectrum/1040g34o31oauvaavks3g5oakffv0j2cosupop5g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102321/a1ac9aa1910e5188984c4a5ea5201fab/spectrum/1040g34o31oauvaavks405oakffv0j2colbjeh88!nd_dft_wlteh_webp_3', 'tag_list': '高途,高中,一对一,网课,高一,高二,高三,高中网课,高中物理,高中化学', 'last_modify_ts': 1773156068436, 'note_url': 'https://www.xiaohongshu.com/explore/68834b7f00000000230051a2?xsec_token=ABv4ctUCPbF-xvXHlefxtvkKW39RZCcTdKsOFDQipzfw0=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABv4ctUCPbF-xvXHlefxtvkKW39RZCcTdKsOFDQipzfw0='}
