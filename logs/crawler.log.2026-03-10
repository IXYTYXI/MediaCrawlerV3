2026-03-10 22:54:34 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69393d8e000000000d038005', 'type': 'normal', 'title': '在家上高途高中1v1！陪跑至出分太省心', 'desc': '🫢 家有高中生，不想跑机构折腾\n😭 又怕孩子复习没方向、没人盯？\n✅ 众多家长选择的高途高中一对一网课直接封神！\n🙋 在家就能学，全程陪跑负责到出分，名校学霸名师 + 定制教学，家长彻底不用揪着心！\n\t\n👉 严选真名师，教学质量不踩雷\n高途1v1的老师全是名校毕业学霸，持证上岗、经验扎实，不是随便凑数的新手！\n\t\n👉 1v1量身定制，精准适配孩子节奏\n学之前检测基础水平，再量身定制学习计划，层层拔高，不是盲目刷题，而是稳步提升学习水平。\n\t\n👉 全流程伴学 + 24h答疑，保姆式服务太香\n课前：提醒预习重点，提前扫清知识盲区；\n课中：1v1 直播互动，实时提问防走神，确保每节课都学透；\n课后：专属24小时答疑，作业批改、错题复盘一步不落；\n\t\n高途1v1在家就能学，孩子学得高效，家长省心省力～\n↙️ 赶紧点击【立即咨询】领取1v1试学名额\n🔍 报名要求：32岁以上家长\n⏰ 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #线上课[话题]# #课程辅导[话题]# #高中学习方法[话题]# #学习规划[话题]#', 'video_url': '', 'time': 1765415580000, 'last_update_time': 1765358990000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102254/1b0de7af4bbe02a5ceadde0a762c3ca5/spectrum/1040g34o31ptivg5el4305oakffv0j2coe5iv83g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102254/da35547989ad07f4982a3d021054d245/spectrum/1040g34o31ptivg5el43g5oakffv0j2co9u8j6i0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102254/d1a5edf1f5c20016609249ef4285090a/spectrum/1040g34o31ptivg5el4405oakffv0j2co19ns3cg!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,线上课,课程辅导,高中学习方法,学习规划', 'last_modify_ts': 1773154474803, 'note_url': 'https://www.xiaohongshu.com/explore/69393d8e000000000d038005?xsec_token=ABVnDHGnmSLIAItD3W41IyX5T4XaFB4q562ssUM1LflcA=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABVnDHGnmSLIAItD3W41IyX5T4XaFB4q562ssUM1LflcA='}
