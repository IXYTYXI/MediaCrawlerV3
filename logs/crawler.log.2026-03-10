2026-03-10 23:42:45 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '681069cc0000000022035397', 'type': 'normal', 'title': '高途1对1名师严管！效果看得见', 'desc': '“补课花了好几万，成绩还是不上不下？”\n❌ 无效补课＝浪费钱＋消耗信心！\n👉 大班课老师顾不到娃\n👉 普通1对1只会照本宣科\n👉 学不进去，家长干着急\n\t\n🔥 高途名师1对1，全程严管有效学习！\n✅ 严选名师——985/211双一流背景，多年教学经验\n✅ 定制计划——检测弱项，根据结果定制专属学习计划\n✅ 学习计划精确到每天——每节课解决哪些问题\n✅ 严管模式——上课走神班班提醒+作业未完成夺命call\n✅ 随时答疑——专属班班课后随时答疑解惑，不留任何知识死角\n\t\n感兴趣的家长赶紧冲，现在点击左下角【立即咨询】领取👉🏻1V1试听课\n*本课程为家庭教育规划课，内容仅面向家长\n⏰ 截止时间：即日起至12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#高中[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff', 'video_url': '', 'time': 1745924102000, 'last_update_time': 1745906124000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102342/88b3588689d4657257b2d3182888f72c/spectrum/1040g0k031grn4f8cjc005oakffv0j2co9ummb90!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102342/052f07fea513dff3b6a4aa9347a17580/spectrum/1040g0k031grn4f8cjc0g5oakffv0j2cona0pb9g!nd_dft_wlteh_webp_3', 'tag_list': '高途,高中,一对一,网课', 'last_modify_ts': 1773157365038, 'note_url': 'https://www.xiaohongshu.com/explore/681069cc0000000022035397?xsec_token=ABLFa6ILQJSZYTbxife49lnd83oIQALaXpifNS_4VJpLA=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABLFa6ILQJSZYTbxife49lnd83oIQALaXpifNS_4VJpLA='}
