2026-03-10 21:25:22 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a7e61b000000001b01ec65', 'type': 'video', 'title': '每周 2 节课，娃数学思维直接起飞🚀', 'desc': '以前总觉得数学要靠“题海战术”，每天逼着练，孩子累，效果还微乎其微，亲子关系一度降至冰点\n直到遇见Mathplore新加坡数学，才发现原来“少而精”才是王道——每周两次课，孩子轻松坚持，数学思维竟然突飞猛进🚀\n@Lena妈咪奇育记  直言：这里的节奏太舒服了👉不用死磕时间，而是讲究效率，娃现在做题反应快多了！\n\t\n📌 科学频率，拒绝疲劳战\n每周2次课，每次40-50分钟，完美匹配孩子专注力。不占用过多课余时间，留白给孩子探索世界，学习兴趣反而更浓了。\n\t\n📌 CPA建模，思维可视化\n即使每周只上两次课，但每次都直击核心。用画图建模搞定复杂逻辑，把“想不通”变成“画得懂”，效率直接翻倍。\n\t\n📌 小班互动，高效吸收\n2-6人小班直播，老师全程关注，孩子课上高频互动，当堂消化知识点，省去了课后家长漫长的“二次辅导”时间。\n\t\n📌 闭环学习，省心省力\n不用家长东拼西凑找资源，课前测-课中学-课后练，一步到位，真正实现“轻负担、高质量”的数学进阶。\n\t\n👇现在点击左下角【立即咨询】即可0元领取价值1888元的试听大礼包哦~\n⏰ 活动时间：即日起至2028年12月31日\n📍 面向海外18岁以上家长\n#Mathplore新加坡数学[话题]#  #新加坡数学[话题]#  #小学数学[话题]#  #数学思维[话题]#  #让孩子爱上数学[话题]#  #数学启蒙[话题]#  #数学学习[话题]#  #Mathplore[话题]#  #数感启蒙[话题]#  #小学数学规划[话题]#', 'video_url': 'http://sns-video-al.xhscdn.com/stream/79/110/259/01e9a7e5c545e5e3010370039cb7dbcb3f_259.mp4', 'time': 1772611099000, 'last_update_time': 1772611100000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '四川', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102125/3d2e3171dbfbe5231555bab853aff7cb/spectrum/1040g0k031t9l0rk556005odiop740t80hji7hqo!nd_dft_wlteh_webp_3', 'tag_list': 'Mathplore新加坡数学,新加坡数学,小学数学,数学思维,让孩子爱上数学,数学启蒙,数学学习,Mathplore,数感启蒙,小学数学规划', 'last_modify_ts': 1773149122707, 'note_url': 'https://www.xiaohongshu.com/explore/69a7e61b000000001b01ec65?xsec_token=ABvtKkoN-JdN_qRqzuJpkmXJM3WfoEsF0q4HO5v24ypNc=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABvtKkoN-JdN_qRqzuJpkmXJM3WfoEsF0q4HO5v24ypNc='}
