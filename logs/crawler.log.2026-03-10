2026-03-10 19:43:19 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69ae925200000000150326d8', 'type': 'normal', 'title': '跟着新加坡数学🔥娃学数学终于不费妈了！', 'desc': '不管你家娃是数学基础薄弱、逻辑跟不上\n还是想提升思维、攻克难点\n适配全年龄段娃的数学学习👇\n📣这些需求sparkmath新加坡数学全满足❗\n✅ CPA教学法\n✨把抽象数学变直观，娃能轻松理解原理，不是死记硬背公式\n✅ 小班教学\n📌每班≤8人，拒绝大锅饭，老师能实时同步每个娃的解题步骤，精准捕捉思维卡点\n✅ 全流程伴学，家长彻底解放双手\n✨专属伴学老师全程跟进，娃的学习情况、薄弱点及时反馈，1v1针对性辅导，问题不过夜\n✅ 游戏化设计，爱上数学不费力\n✨打破“数学枯燥”刻板印象，课堂融入趣味游戏、互动闯关，娃主动参与不抗拒\n——————————\n👉 娃数学学不会、不爱学？不管娃处于哪个阶段，点击左下角【立即咨询】，限时领0元试听大礼包，福利直接拉满👇\n🎁0元试听大礼包包含：\n1️⃣1节新加坡数学直播课\n2️⃣ 1v1定制学习规划\n3️⃣ 价值3422元228课时学习大礼包\n📩感兴趣的家长速戳下方【立即咨询】抢占名额～\n▼报名要求：28 岁以上家长\n▼截止时间：即日起 - 2027年 12 月 31 日\n#sparkmath新加坡数学[话题]# #sparkmath[话题]# #新加坡数学[话题]# #数学思维[话题]# #小学数学怎么学[话题]# #数学学习[话题]# #孩子教育[话题]# #学习规划[话题]#', 'video_url': '', 'time': 1773048402000, 'last_update_time': 1773048403000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '1', 'collected_count': '1', 'comment_count': '', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603101943/a973dd77ba9a69d248f327b739da59eb/spectrum/1040g0k031tg5hrljl8005olhcu8lbcmaoo34mg8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101943/c57facb358e0b04d68feaaea406dab00/spectrum/1040g0k031tg5hrljl80g5olhcu8lbcmah94ug7g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101943/f2ec607b0ddad005cb782cdb2aba20b9/spectrum/1040g0k031tg5hrljl8105olhcu8lbcmamlqricg!nd_dft_wlteh_webp_3', 'tag_list': 'sparkmath新加坡数学,sparkmath,新加坡数学,数学思维,小学数学怎么学,数学学习,孩子教育,学习规划', 'last_modify_ts': 1773142999533, 'note_url': 'https://www.xiaohongshu.com/explore/69ae925200000000150326d8?xsec_token=AB-w_qzoOURA9QpHihjgrBICMjHBdmZL8wpnREUFSYsh8=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB-w_qzoOURA9QpHihjgrBICMjHBdmZL8wpnREUFSYsh8='}
