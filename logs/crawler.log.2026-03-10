2026-03-10 23:20:21 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68834d6f000000001c037e6a', 'type': 'normal', 'title': '新高三1v1网课10天，物理会用会考', 'desc': '对于不少新高三生复习来说，物理堪称 “拦路虎”👇\n受力分析图怎么都画不对，公模考成绩总被物理拖后腿\n别再让孩子闷头苦学了！直接跟高途1v1网课名师学！\n\t\n【高途1v1全程陪跑伴学】\n✅ 计划具体到每天学什么怎么学\n✅ 1对1直播带学传授解题方法\n✅ 一整套复习方案+课后巩固\n\t\n【高途闭环学习体系更高效】\n👨🏼\u200d🏫 强大师资力量：一流名师天团全方位领航，全程互动，当场解决问题；\n📖 专属诊断学情：针对现阶段水平，输出学情报告+制定学习方案；\n📒 私人定制服务：专属入学档案，根据现状制定适合娃当下的计划；\n📃 精细化服务：1人1班，私人订制专属VIP沟通群，专属🧑\u200d🏫全程陪伴；\n🙋 定期诊断 查漏补缺：定期专业诊断，总结当下的掌握程度，及时查漏补缺；\n\t\n新高三想搞定物理，真不用怕基础差，找对1v1网课，开学直接惊艳全班～\n点击左下角【立即咨询】即可领取1v1试听特权吧～\n💬 报名要求：仅面向32岁以上家长\n⏰ 截止时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff\xa0\ufeff#一对一[话题]#\ufeff\xa0\ufeff#网课[话题]#\ufeff\xa0\ufeff#新高三[话题]#\ufeff\xa0\ufeff#高三复习[话题]#\ufeff\xa0\ufeff#高中物理[话题]#\ufeff\ufeff', 'video_url': '', 'time': 1753489501000, 'last_update_time': 1753498060000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102320/12be05ddb1f4cce27bd790a3056eed1a/spectrum/1040g0k031kbtdh9j48105oakffv0j2co7hdif5g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102320/11c9cdb7a1ffea5ab07a83c78506d698/spectrum/1040g0k031kbtdh9j481g5oakffv0j2co3mj9cg0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102320/7c50e873e4e468592189bdc7b3c6c8ea/spectrum/1040g0k031kbtdh9j48205oakffv0j2com995i50!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,新高三,高三复习,高中物理', 'last_modify_ts': 1773156021437, 'note_url': 'https://www.xiaohongshu.com/explore/68834d6f000000001c037e6a?xsec_token=ABv4ctUCPbF-xvXHlefxtvkPnRXPg9QltMEV1x9791iHs=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABv4ctUCPbF-xvXHlefxtvkPnRXPg9QltMEV1x9791iHs='}
