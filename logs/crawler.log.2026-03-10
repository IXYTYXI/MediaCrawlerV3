2026-03-10 23:48:27 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67f5dfaa000000001c0006a8', 'type': 'normal', 'title': '六升七跟一对一抢跑，开学直接碾压', 'desc': '各位家长，六升七的残酷真相你一定要知道\n1️⃣ 知识量暴增3倍，一节课=小阶一周内容\n2️⃣ 90%🧑\u200d🎓开学第一次月考就遭遇滑铁卢\n3️⃣ 学霸变普娃，就因没做好衔接过渡\n-\n别急，高途1对1私教拯救计划来啦！\n⭕️ 名师带队：5年毕业班经验老师1对1诊断\n⭕️ 精准打击薄弱点：3小时学情分析+定制预习方案\n⭕️ 抢跑重点模块：\n✔️ 「几何证明」思维塑形\n✔️ 「文言文解码」专项突破\n✔️ 「长难句拆解」技巧特训\n-\n【为什么选择高途线上1v1私教】\n💯 高途多轮严选，学历可查，持证上岗，多年教龄，更懂学习方法，好评率超高👍\n💯 面对面灵活直播授课，老师实时互动讲课，更生动，时间更灵活，有问题直接问；\n💯 督预习：固定预习范围，记录问题与班班沟通；\n💯 督听课：根据上课计划督促到课，治疗拖延症；\n💯 督作业：课后作业精批，巩固所学才能记得牢固；\n-\n点击左下角【立即咨询】领取专属试听特权\n报名要求：仅面向32岁以上家长\n活动时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#家长必读[话题]#\ufeff', 'video_url': '', 'time': 1744166826000, 'last_update_time': 1744166827000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '2', 'collected_count': '2', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102348/84a5addfd838dff84f7dbb5bae254a8c/spectrum/1040g34o31g1pop0k0c005oakffv0j2cos1g2qa8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102348/b8b7c0abd07754ee07b7d31080b85307/spectrum/1040g34o31g1pop0k0c0g5oakffv0j2conueghqo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102348/38db1f231a33dcf2da13009ac8d68dca/spectrum/1040g34o31g1pop0k0c105oakffv0j2cop9jr268!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,家长必读', 'last_modify_ts': 1773157707907, 'note_url': 'https://www.xiaohongshu.com/explore/67f5dfaa000000001c0006a8?xsec_token=ABbr9kgSoDd_EAd8g3xqf85Ny-vHnsWdWurWgvHnEDxc4=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABbr9kgSoDd_EAd8g3xqf85Ny-vHnsWdWurWgvHnEDxc4='}
