2026-03-10 23:43:03 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6810697e000000001201f75c', 'type': 'normal', 'title': '1人1班🔥高途线上专项突破训练开始报名', 'desc': '各位家长，你家🧑\u200d🎓是不是一提起数理就头疼🤯\n每次看着绕人的逻辑推理、压轴的难题\n瞬间感觉压力山大，却又不知从何下手😤\n-\n💁\u200d♀️自学吧，知识漏洞却越来越多❌\n💁\u200d♀️报个大班课一节课下来，云里雾里😅\n-\n别慌！高途线上1v1专项突破来啦～\n✅ 假期在家就能学，40课时数理训练\n✅ 依据数理基础薄弱程度，制定专属学习计划，效率更高\n✅ 专属班班全程陪伴式学习，防止拖延，确保按计划推进学习\n✅ 严选名校毕业学霸主讲，在线直播传授解题技巧，提升解题能力\n✅ 阶段测试，根据结果动态调整学习计划，不盲目学习\n\t\n现在点击左下角【立即咨询】发送年级领取专属试听吧～\n*本课程为家庭教育规划课，内容仅面向家长\n⏰ 截止时间：即日起至12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#高中[话题]#\ufeff \ufeff#学习日常[话题]#\ufeff', 'video_url': '', 'time': 1745906046000, 'last_update_time': 1745906046000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '2', 'collected_count': '1', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102343/732f3e7cf4cdbfe5f70439104a205d34/spectrum/1040g34o31grn3dfo3c0g5oakffv0j2co17pimgg!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,高中,学习日常', 'last_modify_ts': 1773157383416, 'note_url': 'https://www.xiaohongshu.com/explore/6810697e000000001201f75c?xsec_token=ABLFa6ILQJSZYTbxife49lneyU7LxsbscSnV85r6CCGvM=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABLFa6ILQJSZYTbxife49lneyU7LxsbscSnV85r6CCGvM='}
