2026-03-10 18:27:24 MediaCrawler INFO (__init__.py:234) - [store.xhs.update_xhs_note_comment] xhs note comment:{'comment_id': '67511494000000001b003d8e', 'create_time': 1733366933000, 'ip_location': None, 'note_id': '6750989d0000000002019378', 'note_title': '小学提前学数学，每天怎么做？', 'content': '请问自学初一数学用什么练习册？', 'user_id': '5c79b48500000000170005bd', 'nickname': '大西瓜', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/2b4cefbb01e0a0824f5c173dde7f98b2.jpg?imageView2/2/w/120/format/jpg', 'sub_comment_count': '4', 'pictures': '', 'parent_comment_id': 0, 'last_modify_ts': 1773138444179, 'like_count': '1'}
2026-03-10 18:27:24 MediaCrawler INFO (__init__.py:234) - [store.xhs.update_xhs_note_comment] xhs note comment:{'comment_id': '6782fc10000000002200d118', 'create_time': 1736637456000, 'ip_location': None, 'note_id': '6750989d0000000002019378', 'note_title': '小学提前学数学，每天怎么做？', 'content': '请问博士爸爸，孩子目前四年级，基础不好，数学70分，这个寒假打算从网课开始从头复习，但是孩子学不进去，孩子想要一边预习下册数学，穿插着再去复习不会的，有没有好的方法指点一下呢？', 'user_id': '5a9beef7e8ac2b11940ffa7b', 'nickname': '玉咪儿＿Yan', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31dcucer3gs004a33glnffujr6ppb6jg?imageView2/2/w/120/format/jpg', 'sub_comment_count': '2', 'pictures': '', 'parent_comment_id': 0, 'last_modify_ts': 1773138444204, 'like_count': '1'}
2026-03-10 18:27:24 MediaCrawler INFO (__init__.py:234) - [store.xhs.update_xhs_note_comment] xhs note comment:{'comment_id': '67515a1200000000070066ae', 'create_time': 1733384723000, 'ip_location': None, 'note_id': '6750989d0000000002019378', 'note_title': '小学提前学数学，每天怎么做？', 'content': '自己讲题么[失望R]', 'user_id': '59bf003851783a2c81574911', 'nickname': '是九妹啊', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31pb3h9o92g0049q64t03gi8h6gkmk6o?imageView2/2/w/120/format/jpg', 'sub_comment_count': '1', 'pictures': '', 'parent_comment_id': 0, 'last_modify_ts': 1773138444229, 'like_count': '0'}
2026-03-10 18:27:24 MediaCrawler INFO (__init__.py:234) - [store.xhs.update_xhs_note_comment] xhs note comment:{'comment_id': '675b2312000000000f0310e9', 'create_time': 1734026002000, 'ip_location': None, 'note_id': '6750989d0000000002019378', 'note_title': '小学提前学数学，每天怎么做？', 'content': '请教您，孩子一年级，提前在学二年级，碰到难题是不是直接跟他讲解就行？每次我用了大量时间引导他啊类比啊给线索啊 他还是没有头绪，最后我自己情绪也上来了，太耗时间和精力，请问是否应该平和一点看淡一点，他不会我就正常讲，再不会我继续一遍遍讲，是嘛？[抱拳R]', 'user_id': '554b28a34fac63556682e946', 'nickname': 'Edieeeee', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/68dd192ef212dc1c530ba448.jpg?imageView2/2/w/120/format/jpg', 'sub_comment_count': '8', 'pictures': '', 'parent_comment_id': 0, 'last_modify_ts': 1773138444254, 'like_count': '4'}
2026-03-10 18:27:24 MediaCrawler INFO (__init__.py:234) - [store.xhs.update_xhs_note_comment] xhs note comment:{'comment_id': '6783bd4d000000002003ba3a', 'create_time': 1736686926000, 'ip_location': None, 'note_id': '6750989d0000000002019378', 'note_title': '小学提前学数学，每天怎么做？', 'content': '七月爸爸，看您的笔记，每学期教学是4个月，咱们用2个半月就可以学完，然后就一直提前学，打出时间差呗？', 'user_id': '5e6627fe0000000001003995', 'nickname': '小波波', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo3125ti4sd1m6g5nj64vv08eclvjleui8?imageView2/2/w/120/format/jpg', 'sub_comment_count': '1', 'pictures': '', 'parent_comment_id': 0, 'last_modify_ts': 1773138444279, 'like_count': '3'}
2026-03-10 18:27:24 MediaCrawler INFO (__init__.py:234) - [store.xhs.update_xhs_note_comment] xhs note comment:{'comment_id': '67735f8a000000001200ddd4', 'create_time': 1735614347000, 'ip_location': None, 'note_id': '6750989d0000000002019378', 'note_title': '小学提前学数学，每天怎么做？', 'content': '请问一下。希望学的那种网课适合孩子提前学吗？这个讲的还是比较难的题。', 'user_id': '548c58cde779897cb91651b4', 'nickname': '未央lily', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/591eefb114de41223ff29196.jpg?imageView2/2/w/120/format/jpg', 'sub_comment_count': '2', 'pictures': '', 'parent_comment_id': 0, 'last_modify_ts': 1773138444305, 'like_count': '1'}
2026-03-10 18:27:24 MediaCrawler INFO (__init__.py:234) - [store.xhs.update_xhs_note_comment] xhs note comment:{'comment_id': '67511660000000001a030cb1', 'create_time': 1733367393000, 'ip_location': None, 'note_id': '6750989d0000000002019378', 'note_title': '小学提前学数学，每天怎么做？', 'content': '加群吗', 'user_id': '5c2853db00000000070396a5', 'nickname': 'KETianVV', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31n4vgdthl2005n18afdhv5l5jovum6g?imageView2/2/w/120/format/jpg', 'sub_comment_count': '1', 'pictures': '', 'parent_comment_id': 0, 'last_modify_ts': 1773138444333, 'like_count': '1'}
2026-03-10 18:27:24 MediaCrawler INFO (__init__.py:234) - [store.xhs.update_xhs_note_comment] xhs note comment:{'comment_id': '679050e5000000000b00970b', 'create_time': 1737511141000, 'ip_location': None, 'note_id': '6750989d0000000002019378', 'note_title': '小学提前学数学，每天怎么做？', 'content': '小学小学6年级，数学在98-100之间，之前没有提前学也没有出去学过，如果想考重点高中重点班，现在应该着手提前学还是奥数思维的培训呢，诚心求解，谢谢[飞吻R]', 'user_id': '5b97357d94fc390001c85be8', 'nickname': '小啊小包包', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo316s6b79i3u604ats9lqnqmv8rp5f658?imageView2/2/w/120/format/jpg', 'sub_comment_count': '1', 'pictures': '', 'parent_comment_id': 0, 'last_modify_ts': 1773138444361, 'like_count': '0'}
2026-03-10 18:27:24 MediaCrawler INFO (__init__.py:234) - [store.xhs.update_xhs_note_comment] xhs note comment:{'comment_id': '67868a0b000000002200c4fc', 'create_time': 1736870412000, 'ip_location': None, 'note_id': '6750989d0000000002019378', 'note_title': '小学提前学数学，每天怎么做？', 'content': '我想问下，是不是每天晚上都学新知识的同时，还跟校内进度同步复习？还是就是学新知识复习新知识，校内的已经不用复习了？', 'user_id': '54266dc3d6e4a94b73ef8d1a', 'nickname': '不会起昵称', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/2b4cefbb01e0a0824f5c173dde7f98b2.jpg?imageView2/2/w/120/format/jpg', 'sub_comment_count': '2', 'pictures': '', 'parent_comment_id': 0, 'last_modify_ts': 1773138444386, 'like_count': '0'}
2026-03-10 18:27:29 MediaCrawler INFO (__init__.py:234) - [store.xhs.update_xhs_note_comment] xhs note comment:{'comment_id': '67877ec70000000021018b1e', 'create_time': 1736933063000, 'ip_location': None, 'note_id': '6750989d0000000002019378', 'note_title': '小学提前学数学，每天怎么做？', 'content': '我们这儿没有小升初的硬性奥数需求，所以我们肯定不学', 'user_id': '65f3b01e000000000500bf6e', 'nickname': '博士爸爸带七月', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo311ihtjkhmk0g5pfjm0f19frebvu9al0?imageView2/2/w/120/format/jpg', 'sub_comment_count': 0, 'pictures': '', 'parent_comment_id': '6786895600000000220035d2', 'last_modify_ts': 1773138449502, 'like_count': '0'}
2026-03-10 18:27:29 MediaCrawler INFO (__init__.py:234) - [store.xhs.update_xhs_note_comment] xhs note comment:{'comment_id': '6753cf8a000000001a019cca', 'create_time': 1733545866000, 'ip_location': None, 'note_id': '6750989d0000000002019378', 'note_title': '小学提前学数学，每天怎么做？', 'content': '就是53，笔记封面的这个', 'user_id': '65f3b01e000000000500bf6e', 'nickname': '博士爸爸带七月', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo311ihtjkhmk0g5pfjm0f19frebvu9al0?imageView2/2/w/120/format/jpg', 'sub_comment_count': 0, 'pictures': '', 'parent_comment_id': '67511494000000001b003d8e', 'last_modify_ts': 1773138449533, 'like_count': '3'}
