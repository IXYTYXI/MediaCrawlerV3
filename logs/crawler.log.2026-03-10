2026-03-10 17:55:01 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67581cef0000000002037a6d', 'type': 'video', 'title': '超前学初中，小学儿子做初二试卷考了95分', 'desc': '四年级的时候我们决定放弃奥数，开始超前学，孩子目前6上，上周做了一套初二期末卷，考了95分，结果还不错，今天这期视频，分享一下我们小学阶段超前学的思路和方法#数学超前学[话题]# #小学数学[话题]# #超前学[话题]# #提前学[话题]# #小学数学怎么学[话题]#', 'video_url': 'http://sns-video-hw.xhscdn.com/stream/110/259/01e7581a4a2be9190103700393b033a585_259.mp4', 'time': 1733827823000, 'last_update_time': 1733827824000, 'user_id': '67288ad9000000001d02c712', 'nickname': '禹妈爱学习', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31aukr3me7g005pp8hbcndhoita547q8', 'liked_count': '2389', 'collected_count': '3286', 'comment_count': '235', 'share_count': '864', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603101746/77ab06a17b1a03e077eef643f4ec2b47/1040g00831b7nor607g705pp8hbcndhoifa640s0!nd_dft_wlteh_webp_3', 'tag_list': '数学超前学,小学数学,超前学,提前学,小学数学怎么学', 'last_modify_ts': 1773136501016, 'note_url': 'https://www.xiaohongshu.com/explore/67581cef0000000002037a6d?xsec_token=ABBQIQ4btOfgLcaS01jYIwOfySzIxK98qD0hQDGDQPBlk=&xsec_source=pc_search', 'source_keyword': '数学超前学', 'xsec_token': 'ABBQIQ4btOfgLcaS01jYIwOfySzIxK98qD0hQDGDQPBlk='}
