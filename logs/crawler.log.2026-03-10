2026-03-10 21:15:12 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a8e1c7000000001600a79a', 'type': 'video', 'title': '孩子爱上数学的㊙💥坚持一周2节Mathplore', 'desc': '别再怪娃数学不开窍了😫 真不是孩子笨，是传统教学太生硬——直接甩抽象公式，跳过具象认知，娃的大脑根本转不过来！\n\t\n还好@凉清薄荷  遇到了Mathplore新加坡数学，才发现让娃爱上学数学，真的有捷径🏃\u200d\n\t\n它的核心CPA教学法，简直是为孩子量身打造！先靠积木、水果等实物帮娃建立具象认知，再转化成直观的图形建模，最后过渡到公式，彻底告别死记硬背，应用题也能轻松吃透。\n\t\n一周2节、每节40-50分钟的2-6人小班直播课，完全不枯燥✨\n\t\n👍每3分钟就有一次互动答题，搭配动画情景和游戏化闯关，娃坐得住、听得进，甚至主动举手发言，根本不觉得是在上课。\n\t\n有这样的师资和服务，家长完全不用费心盯梢👇\n\t\n✅ 国内外名校师资，平均5年+教学经验，懂孩子更懂如何引导\n\t\n✅ 中/英授课语言任选，适配不同家庭的学习需求\n\t\n✅ 65%校内重难点巩固，35%竞赛拓展，衔接袋鼠数学、AMC8，校内竞赛双提升\n\t\n✅ 五师伴学，从课前规划到课后反馈，学习闭环拉满\n\t\n覆盖G0学前到G6全年级，不管娃基础如何，都能找到适配阶段~\n\t\n想让娃从抵触数学变成主动爱上数学，赶紧冲试听！\n\t\n🔥 现在戳左下角【立即咨询】即可0元get价值1888元试听大礼包，名额有限，先到先得～\n\t\n——\n\t\n⏰活动时间：即日起至2028年12月31日\n\t\n*面向18＋海外家长群体\n\t\n#Mathplore新加坡数学[话题]##让孩子爱上数学[话题]##数学开窍[话题]##小学数学[话题]##新加坡数学[话题]# #数学思维[话题]# #数学学习[话题]#  #小学数学怎么学[话题]#', 'video_url': 'http://sns-video-al.xhscdn.com/stream/1/110/259/01e9a8e17ec61ad0010370039cbbb2814e_259.mp4', 'time': 1772675527000, 'last_update_time': 1772675527000, 'user_id': '6504601f0000000017021a03', 'nickname': 'Mathplore数学思维', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/e6f9e621-2070-3494-bab8-b0f3f41001c0', 'liked_count': '1', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '四川', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102115/2bfb89c7004b6f0bf8869d8f0b5ff6e7/spectrum/1040g0k031tajpbfvla005p84c0fls6g3unhlkpo!nd_dft_wlteh_webp_3', 'tag_list': 'Mathplore新加坡数学,让孩子爱上数学,数学开窍,小学数学,新加坡数学,数学思维,数学学习,小学数学怎么学', 'last_modify_ts': 1773148512811, 'note_url': 'https://www.xiaohongshu.com/explore/69a8e1c7000000001600a79a?xsec_token=ABnvIy8YG46cQOPm-Ta-dezxo8YsGZeotwOHb0VeaTDL8=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABnvIy8YG46cQOPm-Ta-dezxo8YsGZeotwOHb0VeaTDL8='}
