2026-03-10 23:41:45 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '681ab7f9000000002301e733', 'type': 'normal', 'title': '高中一对一追着学，没想到效率能这么高❗', 'desc': '📢 高中数学的痛，我是真的懂\n✖️ 上课一听就会，做题一做就废\n✖️ 公式背得滚瓜烂熟，考试就是不会用\n✖️ 大题永远只写“解”，得分全靠运气\n别慌！高途1对1来帮忙💪 名师专题1对1辅导，像开了挂一样\n✅ 1对1精准诊断——不是盲目刷题，而是直击薄弱点，哪里不会补哪里！\n✅ 持证名师带队——不是普通老师，而是经过6轮严选，教的全是拿.分技巧！\n✅ 数学专项补弱——手把手教解题套路，从“完全没思路”到“看到题就会做”！\n✅ 实时监督+学情反馈——家长随时查看学习报告，再也不用担心孩子偷懒！\n-\n感兴趣的家长点击左下角【立即咨询】了解课程详情+抢占试听名额\n🉐1对1检测+学习方案+学习资料\n报名对象：仅面向32岁以上家长\n活动时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff\xa0\ufeff#高中[话题]#\ufeff\xa0\ufeff#一对一[话题]#\ufeff\xa0\ufeff#数学[话题]#\ufeff\ufeff', 'video_url': '', 'time': 1746581498000, 'last_update_time': 1746581724000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '1', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102341/42d8fe3d191664749b27999f35e8ac00/spectrum/1040g0k031h5p57tak2005oakffv0j2cocr9kuao!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102341/72333d792e54cca6be88df17ebe657ab/spectrum/1040g0k031h5p57tak20g5oakffv0j2coa1famdg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102341/b1d8bbb2207832b0a87a3835b48a3e9f/spectrum/1040g0k031h5p57tak2105oakffv0j2couh1s7cg!nd_dft_wlteh_webp_3', 'tag_list': '高途,高中,一对一,数学', 'last_modify_ts': 1773157305437, 'note_url': 'https://www.xiaohongshu.com/explore/681ab7f9000000002301e733?xsec_token=ABvCvu4VdZPq1kCumVVAhSgcsFgfaNZZ5fxkOB8dRNDEI=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABvCvu4VdZPq1kCumVVAhSgcsFgfaNZZ5fxkOB8dRNDEI='}
