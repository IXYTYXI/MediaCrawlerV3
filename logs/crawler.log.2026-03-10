2026-03-10 22:45:45 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '697c755a00000000210318ae', 'type': 'normal', 'title': '家有高中生！终于找到靠谱的1v1网课了', 'desc': '😭 给高中生找一对一网课的家长谁没踩过坑啊！\n❌ 挑机构挑花眼，老师资质掺水、上课敷衍\n❌ 定制方案全是噱头，钱花了不少娃成绩一点没起色\n❌ 想找个靠谱的真的太难了...\n\t\n✅ 直到挖到高途高中1v1网课，6轮严选的持证名师，实打实的1v1定制，在家就能学还不用接送，终于不用再为孩子补习操心了！\n\t\n👉 6 轮严选持证名师！彻底告别师资踩坑\n所有讲师都经过6 轮严苛筛选，名校毕业 + 持证上岗\n资质可查、功底扎实，不是随便凑数的兼职老师\n讲课有方法、带学有耐心，能精准抓核心、破难点\n\t\n👉 1v1量身定制！钱花在刀刃上才叫靠谱\n课前精准定位薄弱点，哪里差补哪里\n梳理核心重点定制专属学习方案\n让每一分补习费都花在刀刃上，真正补到位、提分快\n\t\n👉 在家灵活学！不用接送家长太省心\n直接在家学，上课时间超灵活，完全根据孩子的寒春作息调整\n不用迁就固定课时，娃不用奔波，家长不用接送\n\t\n👉 课前课中课后全盯学！想走神都难\n课前：专属预习任务，带着问题上课，学习更有针对性\n课中：1v1 专属关注，实时互动提问，确保注意力全程在线\n课后：紧跟学习效果，盯复习、查作业、答疑解惑\n\t\n想给孩子锁定1v1试听名额的家长，赶紧点击【立即咨询】获取专属学情检测和1v1试学名额吧～\n📝 报名要求：仅面向32岁以上家长\n📆 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #高效学习[话题]# #线上课[话题]# #学习规划[话题]# #高中学习[话题]#', 'video_url': '', 'time': 1769822161000, 'last_update_time': 1769764187000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102245/cf85cb3ab45ec90bbb17cebe3db4188c/spectrum/1040g0k031rv7h80oji005oakffv0j2cok5cl42g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102245/f8629ed14b813640db6287a43e2213c6/spectrum/1040g0k031rv7h80oji0g5oakffv0j2coudk2450!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,高效学习,线上课,学习规划,高中学习', 'last_modify_ts': 1773153945525, 'note_url': 'https://www.xiaohongshu.com/explore/697c755a00000000210318ae?xsec_token=ABEs_FLh4JX7EWRqvtpb1hsKqZG9gIpCfx-oGswrPxmV4=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABEs_FLh4JX7EWRqvtpb1hsKqZG9gIpCfx-oGswrPxmV4='}
