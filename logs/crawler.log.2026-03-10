2026-03-10 22:59:50 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '691d1a82000000001e02610e', 'type': 'normal', 'title': '后悔没早点发现！线上1v1效率这么高', 'desc': '⚠️ 给高中生报线下班踩了无数坑：\n😮\u200d💨 老师水平参差不齐、进度跟不上、没人盯学…\n✅ 果断停课后，扒遍全网测评，最终选了高途高中1对1线上陪跑\n🧑\u200d🏫 好老师 + 好体系，负责到出分为止，家长终于不用瞎操心！\n\t\n👉 为啥放弃线下班？高途1v1这 3 点太戳心\n▫️ 严选真名师，比线下更靠谱\n老师都是名校毕业学霸，还得持证上岗，直播课上不仅讲知识点，还会结合高考考点推导思路；\n\t\n▫️ 专属盯学，比家长更细致\n高途全程1v1督学：课前提醒上课，课中互动直播，课后批改标注错误，比家长盯得还仔细；\n\t\n▫️ 精准适配校内，学了就能用\n精准匹配校内进度，线上就同步练高频题型、补易错点，学完直接能用到校内作业和考试，效率拉满；\n\t\n高途1v1用 “好老师 + 好体系” 陪跑到出芬，真心推荐给还在为线下班纠结的家长～\n↙️ 点击左下方【立即咨询】预约1v1试学\n🔍 报名要求：32岁以上家长\n⏰ 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #线上课[话题]# #学习规划[话题]# #高效学习[话题]# #学习更高效[话题]# #学习方法很重要[话题]# #网课[话题]# #高中[话题]#', 'video_url': '', 'time': 1763515010000, 'last_update_time': 1763515010000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '1', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102259/d5dec23b87b14cb5096fd74068aa241b/spectrum/1040g0k031p23lsb7i6005oakffv0j2coj2ak1r8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102259/20dbbddcce226200f134aab0f6dccd89/spectrum/1040g0k031p23lsb7i60g5oakffv0j2coji2cir0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102259/93e7d33386078e95031f515f4249c636/spectrum/1040g0k031p23lsb7i6105oakffv0j2cohjitq68!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,线上课,学习规划,高效学习,学习更高效,学习方法很重要,网课,高中', 'last_modify_ts': 1773154790615, 'note_url': 'https://www.xiaohongshu.com/explore/691d1a82000000001e02610e?xsec_token=ABDC86EEMWRgxe46qArkIGHytroFgA9Wu5zRVbYxWOivw=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABDC86EEMWRgxe46qArkIGHytroFgA9Wu5zRVbYxWOivw='}
