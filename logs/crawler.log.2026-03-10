2026-03-10 23:41:57 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68106a65000000002202d332', 'type': 'normal', 'title': '培优补差❗️高途1v1全程紧盯有效学习', 'desc': '⚠️ 各位家长你是不是\n👉 曾经每晚陪写作业到崩溃👉 月考被老师约谈\n👉 补习班砸2万却越补越差👉 自己和娃都焦虑\n\t\n强烈推荐高途线上一对一特训，全程严格催着学～\n✅ 硬核师资：高途严选名校毕业学霸主讲老师授课\n✅ 学前：1v1学前测评，定制专属学习计划，专项加强培优补弱，学习效率更高👏\n✅ 学中：1v1直播实时互动，传授各个题型底层逻辑和答题思路👍突破瓶颈期\n✅ 一课一练+定期阶段性测试，实时检验学习成果，针对性查漏补缺\n✅ 课后督学：专属班班随时盯学，随时答疑解惑\n\t\n🏃 立即行动↙️点击左下角【立即咨询】领取专属试听权限\n或直接私✉ 🌟即可获得👉智能诊断+专项规划+大招技巧\n*本课程为家庭教育规划课，内容仅面向家长\n活动时间：即日起-2025年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#高中[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff', 'video_url': '', 'time': 1745996280000, 'last_update_time': 1745906278000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '', 'comment_count': '1', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102341/ecef0267c1a88f2c456f4c04254ce35a/spectrum/1040g34o31grn6nr23c1g5oakffv0j2coim5tebg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102341/03000c2134ea9165e0b94ff436b65409/spectrum/1040g34o31grn6nr23c205oakffv0j2co20v96a8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102341/eb99e1d3e05b50de65d5606a110506b6/spectrum/1040g34o31grn6nr23c2g5oakffv0j2cofg3o1n8!nd_dft_wlteh_webp_3', 'tag_list': '高途,高中,一对一,网课', 'last_modify_ts': 1773157317169, 'note_url': 'https://www.xiaohongshu.com/explore/68106a65000000002202d332?xsec_token=ABLFa6ILQJSZYTbxife49lnX-o-DTE27udu555eC-cnD0=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABLFa6ILQJSZYTbxife49lnX-o-DTE27udu555eC-cnD0='}
