2026-03-10 23:12:17 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68b697fd000000001b03472b', 'type': 'normal', 'title': '1对1找高途，10+年品牌保障负责到底！', 'desc': '给娃找辅导的家长，是不是都有过这些糟心经历：\n❌ 报了小机构没上几节就跑路\n❌ 主讲资质不明上ke没效果，花了钱却看不到提fen…\n✅ 其实选对品牌很重要！高途10+年口碑品牌，初🀄️家长必看，帮娃避坑还能有效学习～\n\t\n👉 10+年品牌高途，靠谱在哪？\n▫️ 品牌保障不踩坑：10+年专注教研，千万家长选择，ke程体系成熟，权益有保障；\n▫️ 严选师资超放心：🧑\u200d🏫都是经过5轮筛选，持证上岗，且有多年教学经验；\n▫️ 1对1定制超安心：先做学情诊断，每节都有明确目标，还会发学习报告；\n▫️ 双师督学不偷懒：主讲1v1直播，边讲边互动，确保娃跟上思路；专属班班每天盯学习，有问题随时答疑，不用家长天天催；\n\t\n学习的关键期还得选高途，10+年品牌的，靠谱又高效，家长少操心，娃学得更顺～\n↙️ 赶紧点击左下角【立即咨询】体验1v1试学\n🙋 报名要求：仅面向32岁以上家长\n⏰ 活动时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #课程辅导[话题]# #学习经验[话题]# #弯道超车[话题]# #学习干货[话题]# #学习更高效[话题]# #学习规划[话题]#', 'video_url': '', 'time': 1756865340000, 'last_update_time': 1756796926000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '5', 'collected_count': '1', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102312/99a337daf3ebb8be9d39e6dcdfa1d2c7/spectrum/1040g34o31lu08tqtks205oakffv0j2cokr0snj0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102312/5331de9902a90ae87a3ddf7a1780465c/spectrum/1040g34o31lu08tqtks2g5oakffv0j2cosa4duc8!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,课程辅导,学习经验,弯道超车,学习干货,学习更高效,学习规划', 'last_modify_ts': 1773155537065, 'note_url': 'https://www.xiaohongshu.com/explore/68b697fd000000001b03472b?xsec_token=AB4CxoWUcxP3S5svdQ68j2dtkA9oWeHDcrKPcw8aiagn4=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB4CxoWUcxP3S5svdQ68j2dtkA9oWeHDcrKPcw8aiagn4='}
