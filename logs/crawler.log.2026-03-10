2026-03-10 23:17:30 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6896ae330000000003031a18', 'type': 'normal', 'title': '高途1v1高中网课，名师带学技巧全解析', 'desc': '🤯 高中学习最怕走弯路：翻来覆去记不住重点\n🥹 刷ti刷到深夜却没摸到学习套路，想补弱科又怕遇不上靠谱老师…\n👉 其实不用让孩子硬熬，高途高中1v1网课，只讲重点、专攻速成，技巧点拨 + 名师解析 + 重点速记全配齐，让孩子学得gao效又省心！\n\t\n👉 双一流名师坐镇，每节课都在 “抓重点”\n▫️ 高途的老师可不是随便选的，全是经过层层筛选的双一流名师，只讲重点技巧点拨超实用，听一节课比自己刷题3小时还管用；\n\t\n👉 1v1专属服务，从诊断到全程定制\n▫️ 先做专属学情诊断找出 “知识盲区”，定制学习策略，节奏完全自己说了算；不用盲目刷题，练一道题就会一类题，效率直接翻倍；\n\t\n👉 题库随时练，学习效率再翻倍\n✅ 全国题库：按难度分级的真ti + 模拟，🧑\u200d🏫会圈出 “必刷ti”，避免无效练习；\n\t\n让双一流🧑\u200d🏫带着孩子抓重点、学技巧～\n点击左下角【立即咨询】领取1v1试学名额\n活动时间：即日起-26年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#高中[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#学习日常[话题]#\ufeff \ufeff#好老师[话题]#\ufeff', 'video_url': '', 'time': 1754730662000, 'last_update_time': 1754705460000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102317/05dbd5b2b65c43d971b5e4d3f4ecd919/spectrum/1040g34o31kuqviua2a105oakffv0j2co8thu7hg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102317/190bbf1876ffaffe7353b4ba37fb857c/spectrum/1040g34o31kuqviua2a1g5oakffv0j2copn6vm1o!nd_dft_wlteh_webp_3', 'tag_list': '高途,高中,一对一,网课,学习日常,好老师', 'last_modify_ts': 1773155850977, 'note_url': 'https://www.xiaohongshu.com/explore/6896ae330000000003031a18?xsec_token=ABnmatSxT3DMU9caN1Wt0dSowu-SXhCIw9jPKVPKo3FB4=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABnmatSxT3DMU9caN1Wt0dSowu-SXhCIw9jPKVPKo3FB4='}
