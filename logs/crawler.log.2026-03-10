2026-03-10 16:06:49 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '662db89e000000000d03373a', 'type': 'normal', 'title': '小学生想提前学初中数学，用什么教材好？', 'desc': '小学生想提前学初中数学，用什么教材好？', 'video_url': '', 'time': 1714272414000, 'last_update_time': 1714272414000, 'user_id': '55dc2adaa75c9542741c5465', 'nickname': '布丁', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/ae351b5abc78ae2e8d79998354db8440.jpg', 'liked_count': '284', 'collected_count': '414', 'comment_count': '85', 'share_count': '27', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603101559/529fd0de35c405a597eae5be754228bf/1040g2sg3124b0vuj3s6g414jfcldkl35ad84mq0!nd_dft_wlteh_webp_3', 'tag_list': '', 'last_modify_ts': 1773130009603, 'note_url': 'https://www.xiaohongshu.com/explore/662db89e000000000d03373a?xsec_token=ABqPdyEULZp2U3G4eDUNPu3Dz0R52JtzcJQxsyQoSTHk0=&xsec_source=pc_search', 'source_keyword': '数学超前学', 'xsec_token': 'ABqPdyEULZp2U3G4eDUNPu3Dz0R52JtzcJQxsyQoSTHk0='}
