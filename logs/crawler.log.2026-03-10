2026-03-10 19:46:29 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a93cf9000000002203399d', 'type': 'normal', 'title': '🔥3800/季！挖到性价比天花板新加坡数学', 'desc': '新加坡数学价格一直是我纠结的点，线下动不动就上万，直到挖到sparkmath新加坡数学（火花新加坡数学)这个宝藏！\n8人封顶小班+完整体系，一季才3800，还是限时特惠，果断入手了。\n💥sparkmath新加坡数学（火花新加坡数学）限时特惠，0元试听，点击【立即咨询】抢占名额\n---\n📚 K2-P6完整分阶\n从幼儿园到六年级，每个阶段该学什么都安排得清清楚楚。跟着体系走，完全不用自己操心衔接问题。\n🧮 CPA教学法\n实物操作→图形建模→抽象数字，娃终于搞懂了数学背后的逻辑，不再是死记硬背。现在做题会自己画图分析了！\n👥 8人封顶小班\n人少就是香！说是8人封顶，老师能照顾到每个孩子，互动感拉满，娃想走神都难。\n🔄 学习闭环体系\n课前预习+课中互动+课后练习+阶段测评，完整的闭环设计，每一步都安排得明明白白.\n💰 限时特惠3800/季\n这个价格配上这个配置，真的很良心了。比线下大班课还便宜，效果却好太多。\n娃上了两个月，数学从班级中游冲到前排，这3800花得太值了！\n-\n👇点击【立即咨询】，或戳@Spark Math线上教育 回【领取】，立即锁定试听名额\n• 1节在线思维直播课\n• 1V1定制学习规划方案\n• 价值3422元228课时学习大礼包\n⏰ 活动有效期：即日起至2026年12月31日\n*面向家长群体\n#sparkmath新加坡数学[话题]# #新加坡数学[话题]# #数学思维[话题]# #小学数学[话题]# #小学数学怎么学[话题]# #小学数学思维训练[话题]# #数学网课[话题]# #幼小衔接数学[话题]# #sparkmath[话题]# #火花新加坡数学[话题]#', 'video_url': '', 'time': 1772698873000, 'last_update_time': 1772698874000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603101946/f79b2489d1ce7c749c5d7b656dd88c85/spectrum/1040g34o31taut3mkme205olhcu8lbcma5shgaoo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101946/b1362ec359e0414d9306860665efd1a1/spectrum/1040g34o31taut3mkme2g5olhcu8lbcma4anksh8!nd_dft_wlteh_webp_3', 'tag_list': 'sparkmath新加坡数学,新加坡数学,数学思维,小学数学,小学数学怎么学,小学数学思维训练,数学网课,幼小衔接数学,sparkmath,火花新加坡数学', 'last_modify_ts': 1773143189063, 'note_url': 'https://www.xiaohongshu.com/explore/69a93cf9000000002203399d?xsec_token=ABkXiiT8OoWfy0U4yQ6YI3tjl--Nqf1oIdbA9SewBpEBE=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABkXiiT8OoWfy0U4yQ6YI3tjl--Nqf1oIdbA9SewBpEBE='}
