2026-03-10 20:52:37 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69aea5940000000026030db2', 'type': 'normal', 'title': '掰手指到98+，只差一个sparkmath的距离！', 'desc': '如果你还在问“新加坡数学怎么样？”，看看它家怎么把普娃变牛娃的👇\n✅ 100%重点本科名师，5年+经验打底\n严选国内外名校师资，不是实习生、不是兼职，是实打实懂教学、懂孩子的全职老师！讲得透、带得稳，娃的思路一秒被抓住！\n✅ CPA教学法，培养真思维\n具象→形象→抽象三步走，鸡兔同笼、排队问题全用“画”的！孩子自己推公式、讲思路，灵活解题，举一反三，轻松爱上学数学✨\n✅ 分阶段教学，K2-P6全覆盖\n分层教学，让娃专心听、练得会、轻松懂、记得牢。从掰手指到心算，从应用题到竞赛题，每一步都踩在娃的最近发展区！\n✅ 全流程伴学，进步看得见\n3-8人小班直播，老师1v1盯学；课后6v1全程跟进，问题不过夜。一周两节，轻松开窍！\n—\n现在0元试听开放，还送1v1定制计划+价值3422元228课时大礼包！先试后报，让娃亲身体验从掰手指到98+的快乐👇\n👇点击左下方【立即咨询】，抢0元试听课！\n🎁 1节新加坡数学直播课\n🎁 1v1定制学习计划\n🎁 价值3422元228课时学习礼包\n⏰活动时间：即日起-2027年12月31日\n*本内容为教育规划，面向家长群体\n#sparkmath[话题]# #新加坡数学[话题]# #sparkmath新加坡数学[话题]# #小学奥数[话题]# #数学学习[话题]# #数学思维[话题]# #数学启蒙[话题]# #孩子教育[话题]# #学习规划[话题]# #小学数学[话题]#', 'video_url': '', 'time': 1773053332000, 'last_update_time': 1773053332000, 'user_id': '64740b96000000000f006adf', 'nickname': 'Spark Math 数学课程', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo30oe65qe8ie5g5p3k1eb3oqmvph5fk6g', 'liked_count': '1', 'collected_count': '1', 'comment_count': '1', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102052/3f0685734da43acbcf134ffe50e3330f/spectrum/1040g0k031tg7tp39le005p3k1eb3oqmvn36du2o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102052/52080fb655165eee23c71a068c4405cd/spectrum/1040g0k031tg7tp39le0g5p3k1eb3oqmv78tn7c8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102052/d79267f62e68733855f663693aa66c3c/spectrum/1040g0k031tg7tp39le105p3k1eb3oqmv0m3peog!nd_dft_wlteh_webp_3', 'tag_list': 'sparkmath,新加坡数学,sparkmath新加坡数学,小学奥数,数学学习,数学思维,数学启蒙,孩子教育,学习规划,小学数学', 'last_modify_ts': 1773147157609, 'note_url': 'https://www.xiaohongshu.com/explore/69aea5940000000026030db2?xsec_token=AB-w_qzoOURA9QpHihjgrBIPD2Ic6hxzo46lW2DRj_ULo=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB-w_qzoOURA9QpHihjgrBIPD2Ic6hxzo46lW2DRj_ULo='}
