2026-03-10 22:49:18 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '695f5123000000000e03d854', 'type': 'normal', 'title': '家有高中生！选对1v1名师真的太重要了', 'desc': '⚠️ 给孩子报高中一对一\n❌ 踩过最大的坑就是遇不到适配的好老师\n❌ 要么讲课枯燥娃走神，要么抓不住考点瞎忙活钱花了还没效果\n✅ 直到挖到高途1v1严选名师团队，才知道啥叫 “选对老师，提芬事半功倍”！\n\t\n👉 高途6轮严选名师团！风格任选不满意就换\n✔️ 6轮严选 + 持证上岗，能留下来的都是实力派；\n✔️ 有幽默风趣的段子手老师，有严谨细致的细节控老师；\n✔️ 不同风格任你挑不适应直接换，直到找到适配的那一个；\n\t\n👉 全流程1v1定制！提分不走弯路\n✔️ 1v1精准检测：先摸清薄弱科目，再定制具体学习计划；\n✔️ 1v1直播带学：边讲边练边巩固，实时互动学一个会一个；\n✔️ 全程督学+24h答疑：盯作业查复习，难题随时问；\n✔️ 一整套学习方案：从课前预习到课后巩固，出分更流畅；\n\t\n高途6轮严选名师团，风格任选+全程定制\n想给孩子找靠谱1v1的家长，赶紧点击【立即咨询】获取1v1试听名额，让孩子亲自感受好老师的魅力～\n📝 报名要求：仅面向32岁以上家长\n📆 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #高中学习方法[话题]# #学习规划[话题]# #艺考文化课[话题]# #高考逆袭[话题]# #好老师[话题]#', 'video_url': '', 'time': 1767863460000, 'last_update_time': 1767854371000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '4', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102249/0ee1aeeb0e00e77696536fabc3f95992/spectrum/1040g0k031r2os3g8mu005oakffv0j2co7749r30!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102249/954e646758d46d5fbaa344d384aab29d/spectrum/1040g0k031r2os3g8mu0g5oakffv0j2coh30si38!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,高中学习方法,学习规划,艺考文化课,高考逆袭,好老师', 'last_modify_ts': 1773154158147, 'note_url': 'https://www.xiaohongshu.com/explore/695f5123000000000e03d854?xsec_token=AB_e4TLEe2FvTsCISOpzib8ZL-OGkYv6fUuSq0ijFro3Y=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB_e4TLEe2FvTsCISOpzib8ZL-OGkYv6fUuSq0ijFro3Y='}
