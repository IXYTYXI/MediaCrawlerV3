2026-03-10 23:58:12 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6789d0f3000000001d011390', 'type': 'normal', 'title': '🤔高途线上1对1到底什么价❓', 'desc': '很多家长都想给孩子找靠谱的一对一机构\n那火爆家长圈的高途1对1到底有什么优势❓\n-\n【高途初阶1V1】\n✅ 根据孩子的真实情况做专属规划，每个孩子的课程安排都不一样；\n✅ 师资全是名校老师，平均教龄8年+，能够针对娃的不同需求，1V1提供个性化的教学方\n✅ 直播授课，孩子在家就能学习！ 再也不用费心去盯娃，也无需费劲跑线下课✌️\n✅ 高途特有的八步学习法，形成完整闭环，想不提升都难✅\n-\n很多家长都在问价格，🙋现在点击【立即咨询】添加助理\n即可获取专属报价\n💬仅面向32岁以上家长\n活动时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff\xa0\xa0\xa0\ufeff#一对一[话题]#\ufeff\xa0\xa0\xa0\ufeff#网课[话题]#\ufeff\ufeff', 'video_url': '', 'time': 1737085171000, 'last_update_time': 1742539321000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '52', 'collected_count': '12', 'comment_count': '17', 'share_count': '5', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102358/9bf2a4e755b0a605054096b205cea09f/spectrum/1040g34o31epssod1m00g5oakffv0j2co2i78ifo!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课', 'last_modify_ts': 1773158292058, 'note_url': 'https://www.xiaohongshu.com/explore/6789d0f3000000001d011390?xsec_token=ABCMdbT2GZscRFvW-fJ-Y1CGplbEN1R12VTyTpWWqYTas=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABCMdbT2GZscRFvW-fJ-Y1CGplbEN1R12VTyTpWWqYTas='}
