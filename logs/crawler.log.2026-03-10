2026-03-10 23:43:18 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6810694b000000002300f0fd', 'type': 'normal', 'title': '被1v1严管督学🥰现在娃强得可怕', 'desc': '收到家长反馈啦！😄\n说在高途给娃找到了"学习管家"！每天被班班督促检查，天天被追着学！不怕没效果！\n----\n🤗 高途一对一6步严管督学\n1️⃣ 一对一定制学习计划，详细到每天每小时按照学习进度更新，每周动态调整\n2️⃣ 专属班班全程答疑解惑，监督完成学习计划，确保学习效率\n3️⃣ 阶段测试，定期检测学习情况，随时调整学习计划\n4️⃣ 定期家长会，了解学习情况，省心更放心\n5️⃣ 智能分析错题数据，可视化呈现成长曲线\n6️⃣ 课前提醒、课中监督、课后检查课堂笔记、作业、错题复盘\n----\n🤗 高途严选名师确保效率：全部双一流学校毕业，持证上岗，1v1面对面直播互动教学，效率更高，个性化匹配不同学生，实现因材施教\n----\n现在点击左下角【立即咨询】体验一对一督学服务吧～\n*本课程为家庭教育规划课，内容仅面向家长\n⏰ 截止时间：即日起至12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#高中[话题]#\ufeff', 'video_url': '', 'time': 1745905995000, 'last_update_time': 1745905995000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '2', 'comment_count': '', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102343/1aa5c3b71382c2da4bbb495051427f02/spectrum/1040g0k031grn2fecj4005oakffv0j2coo46pe98!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102343/7dc2778f333d0c1c0c29df0cc18d263a/spectrum/1040g0k031grn2fecj40g5oakffv0j2col3pk938!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102343/17d0eeefd5dc530f62a0564f77eeb7a8/spectrum/1040g0k031grn2fecj4105oakffv0j2cos07mo3g!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,高中', 'last_modify_ts': 1773157398714, 'note_url': 'https://www.xiaohongshu.com/explore/6810694b000000002300f0fd?xsec_token=ABLFa6ILQJSZYTbxife49lnUsHa7ngMHP_tX9TUqxOsw4=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABLFa6ILQJSZYTbxife49lnUsHa7ngMHP_tX9TUqxOsw4='}
