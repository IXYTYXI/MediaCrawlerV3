2026-03-10 23:20:03 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68834da8000000001c031322', 'type': 'normal', 'title': '高中1v1网课超靠谱，全程陪跑到出分', 'desc': '以前总觉得网课不如线下靠谱，直到报了这个高中 1v1 网课，才发现 “在家学 + 全程陪跑” 有多香！老师从知识点讲到解题大招，一路陪跑到出分，这波才是真的选对了～\n\t\n👉 在家学却比线下还专注，全程被 “盯” 着进步，比在学校还抓得紧😃\n✅ 一对一个性化定制课程\n✅ 严选名师1v1直播教学\n✅ 督学鼓励，难题及时答疑解惑\n✅ 课程灵活，时间地点任你定\n\t\n🎯 高途一对一闭环学习，全程陪跑出分\n🌟 课前：制定专属个性化的学习内容，因材施教，定期展开教研，多轮打磨助力好课；\n💎 课中：资深讲师全程监督，高效的学一整节，还有质检随堂持续护航质量；\n🥳 课后：可以根据回放复盘，二讲老师课后答疑，查漏补缺；\n-\n🙋🏻\u200d♀如果孩子自学效率低、学习压力大，那一定要来试试高途一对一网课\n🔗点击左下角【立即咨询】领取1v1网课试听\n💬 报名要求：仅面向32岁以上家长\n⏰ 截止时间：即日起至25年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#高中[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#陪跑[话题]#\ufeff', 'video_url': '', 'time': 1753492861000, 'last_update_time': 1753435560000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102320/ac0e392dc36ef09421e5f05633ecb92a/spectrum/1040g0k031kbtefgjj6005oakffv0j2codgt1p68!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102320/82d186a122cfb92fa92bc1f62871c9e5/spectrum/1040g0k031kbtefgjj60g5oakffv0j2cos59pi0o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102320/a46c05f7f7942ed8b039129e41b8522c/spectrum/1040g0k031kbtefgjj6105oakffv0j2cood48d4g!nd_dft_wlteh_webp_3', 'tag_list': '高途,高中,一对一,网课,陪跑', 'last_modify_ts': 1773156003662, 'note_url': 'https://www.xiaohongshu.com/explore/68834da8000000001c031322?xsec_token=ABv4ctUCPbF-xvXHlefxtvkKqme-alTJkrP5CfbUgrDBc=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABv4ctUCPbF-xvXHlefxtvkKqme-alTJkrP5CfbUgrDBc='}
