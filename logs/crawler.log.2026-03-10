2026-03-10 22:10:23 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a7ef70000000001b01e29a', 'type': 'video', 'title': '数学差生正确打开方式！一对一真神了💪', 'desc': '高中数学真的别硬熬了😭\n公式背到吐，换个题型就废❌\n基础题会做，综合题直接懵😢\n刷题刷到麻，分数还是原地踏步💧\n说到底不是孩子笨，是没找对方法、没打通思维，瞎忙活不如精准学🔥\n开学30天黄金学习期，别再被低效刷题内耗！\n所以真心推荐试试我们的【掌门一对一高中数学网课】三步闭环，专治“学得累却考不好”：\n📊 课前｜精准诊断，不浪费一分钟\n先做智能测评，找到孩子到底是概念模糊、思路卡壳还是不会举一反三，学习计划直接瞄准薄弱点。\n👩🏫 课中｜一对一沉浸式互动\n老师100%关注你家孩子，随时提问当场解决，不光讲答案，更教“怎么想”，把知识点变成解题能力。\n📝 课后｜作业配专属反馈\n每次练习都针对当堂弱点，批改后附详细错因分析和举一反三题，进步看得见，家长超省心~\n👉点击【直播间】就能get一节免费的试听体验课🎁\n还🈶1对1专业辅导+定制专属计划+学习资料，数量不多，先到先得~\n👪 面向32岁以上家长\n截止时间：即日起-2026.12.31\n#掌门一对一[话题]#  #掌门1对1[话题]#  #高中数学[话题]#  #网课[话题]#  #数学[话题]#  #家长必看[话题]#  #网课推荐[话题]#  #学习日常[话题]#', 'video_url': 'http://sns-video-al.xhscdn.com/stream/79/110/259/01e9a7ef4f2c317d010370039cb7ffcc0e_259.mp4', 'time': 1772629225000, 'last_update_time': 1772613489000, 'user_id': '649a70220000000010036bfc', 'nickname': '掌门1对1学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31pumqmjhls005p4qe0h46qvs49pjit8', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '上海', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102210/81150fd5cb09afb6296c12e2c0fc2be9/spectrum/1040g34o31t9m6idc6e105p4qe0h46qvs8uv7d28!nd_dft_wlteh_webp_3', 'tag_list': '掌门一对一,掌门1对1,高中数学,网课,数学,家长必看,网课推荐,学习日常', 'last_modify_ts': 1773151823205, 'note_url': 'https://www.xiaohongshu.com/explore/69a7ef70000000001b01e29a?xsec_token=ABvtKkoN-JdN_qRqzuJpkmXE6fV12Op-j8iq4ITBzJPCw=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABvtKkoN-JdN_qRqzuJpkmXE6fV12Op-j8iq4ITBzJPCw='}
