2026-03-10 23:34:52 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6842549f0000000021009fd3', 'type': 'normal', 'title': '准高三让1v1盯着学，真的能出分！', 'desc': '家有准高三的家长！！别再说 “孩子天生不是学习的料”！！\n只要找对方法，中等生也能逆袭成学霸！！\n\t\n🔥 高途一对一3 大痛点一次性解决！\n❌ 漏洞多却找不到重点：\n1v1 入学测评直接 “透视” 薄弱项，精准圈定高频考点\n❌ 自律差学一会儿就摆烂：\n专属班班每天课前提醒、作业盯梢、错题追问，比闹钟还准时\n❌ 老师讲了却学不会：\n1v1 直播课“贴脸教学”，老师全程盯着你互动，解题步骤手把手教\n\t\n中等生不是终点，是逆袭的起点！这波跟 1v1 盯学，明年高考就是 “黑马本马”！！💥\n赶紧点击左下角【立即咨询】领取1v1试听吧\n活动时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff\xa0\xa0\ufeff#高三[话题]#\ufeff\xa0\xa0\ufeff#一轮复习[话题]#\ufeff\xa0\xa0\ufeff#逆袭[话题]#\ufeff\xa0\xa0\ufeff#一对一[话题]#\ufeff\xa0\xa0\ufeff#网课[话题]#\ufeff', 'video_url': '', 'time': 1749177503000, 'last_update_time': 1749189886000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '2', 'collected_count': '', 'comment_count': '', 'share_count': '3', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102334/b8256a1986d9d70a2ba4c4186aa78b98/spectrum/1040g34o31icf1kthnq305oakffv0j2co88bkn6o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102334/9ce65acc8a626c64590616d6e4c7efc6/spectrum/1040g34o31icf1kthnq3g5oakffv0j2coqc1gvao!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102334/f8758bb3a9d17c95ad636344cabcb35c/spectrum/1040g34o31icf1kthnq405oakffv0j2cohab3tpo!nd_dft_wlteh_webp_3', 'tag_list': '高途,高三,一轮复习,逆袭,一对一,网课', 'last_modify_ts': 1773156892024, 'note_url': 'https://www.xiaohongshu.com/explore/6842549f0000000021009fd3?xsec_token=ABuaz470kNXBYLCyU2QOJBbhgbnX-RDSjPoOvltyFr3rY=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABuaz470kNXBYLCyU2QOJBbhgbnX-RDSjPoOvltyFr3rY='}
