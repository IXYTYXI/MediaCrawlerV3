2026-03-10 23:18:02 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6896adca0000000025029cec', 'type': 'normal', 'title': '全基础适配！高途1v1定制负责到出芬', 'desc': '高中学习最愁 “不对症”：基础弱的跟不上大班课节奏，成绩中等的总在瓶颈期徘徊，尖子生想拔高却没人带… 其实关键在 “精准”👇\n高途高中1v1网课主打 “每次2小时高频学”，专属定制方案，用碎片化时间高效学习！\n\t\n👉 2小时高频学，碎片时间激发潜力\n不用硬熬整天上大课，每天2小时精准突击更高效，避开孩子疲劳期专注度比4小时低效学习还高；\n\t\n👉 全基础适配，不管啥起点都能学\n不搞 “一刀切” 教学，1v1定制方案精准匹配学情，老师带着拆解高kao命ti逻辑，打开解ti新思路。\n\t\n👉 1v1 定制方案，从计划到落地全陪跑\n全程监督巩固：专属班班每天盯打卡，课前发重点提醒，课后催错题复盘；智能题库自动推送同类题，24小时答疑通道随时解疑，学过的内容不遗漏。\n\t\n感兴趣的家长赶紧点击左下角【立即咨询】领取1v1试学吧～\n活动时间：即日起-26年12月31日\n报名要求：仅面向32岁以上家长\n\ufeff#高途[话题]#\ufeff \ufeff#高中[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#学习日常[话题]#\ufeff \ufeff#高中数学[话题]#\ufeff \ufeff#高中物理[话题]#\ufeff', 'video_url': '', 'time': 1754705354000, 'last_update_time': 1754705354000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '2', 'collected_count': '1', 'comment_count': '', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102318/6f53ec854d050f37ae03456f2cda2101/spectrum/1040g34o31kuqtt9h2g005oakffv0j2co4qlkkt8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102318/10d49d89803fdd4570dc5ce35e23f78a/spectrum/1040g34o31kuqtt9h2g0g5oakffv0j2cou61oj80!nd_dft_wlteh_webp_3', 'tag_list': '高途,高中,一对一,网课,学习日常,高中数学,高中物理', 'last_modify_ts': 1773155882520, 'note_url': 'https://www.xiaohongshu.com/explore/6896adca0000000025029cec?xsec_token=ABnmatSxT3DMU9caN1Wt0dSonT5OKitmDiX4NEA3z8xyM=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABnmatSxT3DMU9caN1Wt0dSonT5OKitmDiX4NEA3z8xyM='}
