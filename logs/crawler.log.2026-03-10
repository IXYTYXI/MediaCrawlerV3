2026-03-10 22:42:57 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '698bf1f6000000001600831c', 'type': 'normal', 'title': '高中1v1开学陪跑｜负责到出分！家长闭眼冲', 'desc': '⚠️ 高中生开学想稳住成绩冲刺提分，真的太需要靠谱1v1了！\n😭 自学没计划、上课听不懂、问题堆成山、没人盯就走神\n🎉 这款高中1v1网课直接把 “负责” 拉满，开学全程陪跑\n👍 一路负责到大考出分，孩子稳学，家长超安心！\n\t\n👉 开学1v1陪跑｜负责到底，不半途而废\n开学就进入状态，主讲全程陪跑盯学，从开学一直负责到出分，不是上完课就不管，保姆式陪伴，紧盯状态，想走神都难！\n\t\n👉 持证名师带学｜不满意可随时换\n✅ 正规持证名师，懂考点、会带学、超负责✅ 约课时间自由选，不耽误校内学习✅ 风格不合适、不满意随时可换老师！\n\t\n👉 先检测再定制｜不盲目学\n上课前先全面检测基础，摸清薄弱点，结合真实水平和目标，1v1量身定制学习计划，基础差补基础，想冲分就拔高，不浪费一分钟！\n\t\n👉 24h 在线答疑｜疑问不过夜\n课前、课中、课后全程在线，24h 随时答疑，当天问题当天清，主讲亲自盯，超级负责，学习不卡壳！\n\t\n开学选对1v1，真的能少走90%的弯路！\n持证名师+定制计划+全程陪跑+24h答疑，负责到出分，安心又靠谱，开学逆袭就靠它！\n\t\n点击【立即咨询】即可领取1v1试学名额\n📌 报名要求：仅面向家长\n🛎️ 活动截止时间：2026年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #高考冲刺[话题]# #高效学习[话题]# #快速提分[话题]# #课程辅导[话题]# #学习规划[话题]# #线上课[话题]# #高考逆袭[话题]#', 'video_url': '', 'time': 1770793801000, 'last_update_time': 1770779126000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '2', 'comment_count': '1', 'share_count': '2', 'ip_location': '河北', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102242/dd5722b2b28e2503e54f620d031de40a/spectrum/1040g34o31sebfvco581g5oakffv0j2cok5l85d0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102242/6645df1f7b841bbfa6378570bcfe7f60/spectrum/1040g34o31sebfvco58205oakffv0j2col3uqu98!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102242/a95f6afdd7731c61d8c595f1a260b5da/spectrum/1040g34o31sebfvco582g5oakffv0j2codjc4oho!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,高考冲刺,高效学习,快速提分,课程辅导,学习规划,线上课,高考逆袭', 'last_modify_ts': 1773153777404, 'note_url': 'https://www.xiaohongshu.com/explore/698bf1f6000000001600831c?xsec_token=AB0Z9yfQ7GgsduS9DBlYJ1WnVWpHyy0MKpIML3OaQIqJg=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB0Z9yfQ7GgsduS9DBlYJ1WnVWpHyy0MKpIML3OaQIqJg='}
