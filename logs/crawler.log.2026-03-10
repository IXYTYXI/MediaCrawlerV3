2026-03-10 23:36:26 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68394c72000000001101cb3d', 'type': 'normal', 'title': '早知道不找1v1了，学到停不下来！！', 'desc': '👉 自制力差，一个人复习三天打鱼两天晒网\n👉 基础稀碎，高一高二知识点像一盘散沙，完全没有系统框架\n⚠️ 高三一轮复习是夯实基础的黄金期，把地基打牢才能在二轮冲刺时弯道超车，📢所以准高三生一定要提前抢占先机！\n-\n✅【跟着高途 1v1一轮复习提前学】\n⭕ 定制化复习方案：入学测评锁定薄弱科目，量身规划从基础到拔高的全阶段学习路径\n⭕ 全学科系统梳理：覆盖语数英政史地 / 理化生，构建知识体系，串联高频考点\n⭕ 1v1靶向突破：名师一对一辅导，直击偏科短板，专项攻克函数、文言文等硬骨头\n⭕ 沉浸式跟盯教学：每日学习任务打卡 + 直播带练，作业精批，确保学透每一个知识点\n⭕ 24 小时在线答疑：小到单词拼写，大到压轴题解法，有问必答\n-\n有想体验的赶紧点击左下角【立即咨询】领取1v1试听吧～\n活动时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#高中[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#督学[话题]#\ufeff \ufeff#一轮复习[话题]#\ufeff', 'video_url': '', 'time': 1748585586000, 'last_update_time': 1748585586000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '1', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102336/f2e57fb46629bbfdbac1699f575d0b2d/spectrum/1040g34o31i3kpjh26s1g5oakffv0j2coq7pk0no!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102336/b38eaf26fdd7f10a7788aa3352ba0c15/spectrum/1040g34o31i3kpjh26s205oakffv0j2co3v561h0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102336/55a0a67b08245f4a41728936408c891e/spectrum/1040g34o31i3kpjh26s2g5oakffv0j2cofk1g1lo!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中,网课,督学,一轮复习', 'last_modify_ts': 1773156986842, 'note_url': 'https://www.xiaohongshu.com/explore/68394c72000000001101cb3d?xsec_token=AB0g3976cXjNme1HZWBddwR43jLrS6-XydphnjQQDrZdA=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB0g3976cXjNme1HZWBddwR43jLrS6-XydphnjQQDrZdA='}
