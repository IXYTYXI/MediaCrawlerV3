2026-03-10 23:52:47 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67d63bae000000001d00689d', 'type': 'normal', 'title': '手把手教❗️跟一对一倒数也能翻盘❓', 'desc': '各位家长们，你家🧑\u200d🎓是不是起早贪黑的去学习\n成绩就是一般，考试也不出分❓\n👏 想要在短时间内高效学习？拒绝无用功？\n直接跟着【高途一对一】学\n-\n➡️ 针对7-9阶段不同基础提供合适的辅导计划\n【7-8阶段辅导版】：1v1基础薄弱入手+真题实战演练+总结复习\n【百日冲刺备考版】：1v1高效复习+高强度练习+针对性讲评\n-\n✅ 课前测试各科薄弱，定位短板，根据学习现状及喜好，个性化匹配1v1老师；\n✅ 这里有名校毕业的老师，实时双向在线互动，课堂细致剖析知识点，攻克学习难点，传授解题方法，测试不发愁；\n✅ 课后1v1精批作业，随时随地答疑解惑，根据阶段测试结果，随时调整学习计划，确保效率；\n-\n↙️ 点击左下方【立即咨询】即可领取试听特权\n📍报名要求：面向32岁以上家长\n📍活动时间：即日起-2025年12月31日\n\ufeff#高途[话题]#\ufeff\xa0\ufeff#一对一[话题]#\ufeff\xa0\ufeff#网课[话题]#\ufeff\ufeff', 'video_url': '', 'time': 1742102880000, 'last_update_time': 1742539261000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102352/4ae982e67170d83bec8247083a3331d7/spectrum/1040g34o31f2t0fm5mm1g5oakffv0j2corbjrhh0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102352/bb93764bfadc3efcbcae4fa567913560/spectrum/1040g34o31f2t0fm5mm205oakffv0j2codu9bdtg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102352/1083799cadeeace8cf1fe90763631060/spectrum/1040g0k031f9hmi2i6q005oakffv0j2coc0efdr0!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课', 'last_modify_ts': 1773157967754, 'note_url': 'https://www.xiaohongshu.com/explore/67d63bae000000001d00689d?xsec_token=ABoJrgVW_2Bo-8ZI74peuSYTa7DafFORdX5vIRtDHMGw4=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABoJrgVW_2Bo-8ZI74peuSYTa7DafFORdX5vIRtDHMGw4='}
