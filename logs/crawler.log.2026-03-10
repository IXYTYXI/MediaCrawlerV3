2026-03-10 22:44:32 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6985acce000000001a025839', 'type': 'normal', 'title': '高途高中1v1✨真正靠谱！家长放心选择', 'desc': '家有高中生找1v1太踩坑😭\n单科顾此失彼、师资掺水、督学缺位\n钱花了成绩没起色，偏科短板越积越多...\n\t\n✅ 高途高中1v1辅导，才是真正靠谱的神器！师资、内容、规划、督学全拉满，一站式解决难题，家长彻底省心～\n\t\n✅ 1人1班 因材施教｜提分不盲目\n拒绝千人一课！专属对接学情，量身定制学习计划，精准匹配不同基础，逐科补漏、拔瓶颈、冲高分；\n\t\n✅ 持证名师 随时可换｜全科师资有保障\n讲师持证上岗、多轮严选，用命题人思维传技巧、抓考点，任意学科老师不满意可随时换，适配度拉满；\n\t\n✅ 精心打磨 优质内容｜全科学习有质感\n课程多轮打磨，兼顾知识点与解题技巧，只讲核心方法，一节课有一节课的收获，吃透知识、提升应试力；\n\t\n跟着高途凭实力补短板、拔高分，一站式护航高中三年，不玩虚的！\n点击【立即咨询】获取专属学情检测和1v1试学名额吧～\n📝 报名要求：仅面向32岁以上家长\n📆 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #课程辅导[话题]# #艺考文化课[话题]# #高效学习[话题]# #学习规划[话题]# #线上课[话题]#', 'video_url': '', 'time': 1770368206000, 'last_update_time': 1770368700000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '3', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102244/7e036ea8d47737691ebaf4c503c68707/spectrum/1040g34o31s87i9hj56105oakffv0j2co3b33k70!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102244/766573ebf1ed742ac836d30b7193b309/spectrum/1040g34o31s87i9hj561g5oakffv0j2co29ujc90!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,课程辅导,艺考文化课,高效学习,学习规划,线上课', 'last_modify_ts': 1773153872859, 'note_url': 'https://www.xiaohongshu.com/explore/6985acce000000001a025839?xsec_token=ABzaatJlt5nlUnF3m8mEHx3r_dz08IfJjBd7chg5rnGh4=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABzaatJlt5nlUnF3m8mEHx3r_dz08IfJjBd7chg5rnGh4='}
