2026-03-10 23:26:49 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '686624400000000012031ada', 'type': 'normal', 'title': '高三1v1陪跑带学，课上课下盯到出分止', 'desc': '⚠️ 都高三了还在盲目刷题、熬夜背书却不见效果？\n👍 跟高途1v1陪跑督学直接开挂！\n👉 从早到晚全程盯学，定制每日学习计划，负责到底！\n\t\n✅ 【1v1定制学习方案，才能精准学习】\n👉 入学前：1v1考前测评分析报告、真个性化/定制化学习方案\n👉 直播课中：时间灵活，1人1班，双一流名师直播互动\n👉 课后督学：督预习、督听课、督作业\n👉 课后答疑：专属班班24小时在线；阶段测试巩固所学；\n👉 专攻薄弱：按 “基础→进阶→冲刺” 分级训练，薄弱题型直接死磕到底！\n\t\n高三逆袭没有捷径，但选对课程就是开挂！\n📍 点击左下角【立即咨询】领取1v1试听吧～\n⏰ 活动时间：即日起-25年12月31日\n🙋 报名要求：仅面向32岁以上家长\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#高中[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#高三[话题]#\ufeff \ufeff#一轮复习[话题]#\ufeff', 'video_url': '', 'time': 1751524416000, 'last_update_time': 1751524416000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '1', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102326/63a2ef51a9b6e5253f323bdc776804f8/spectrum/1040g34o31jfe4lab2a1g5oakffv0j2cojh302p0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102326/895fb29a5817607ef306dac3b988eb42/spectrum/1040g34o31jfe4lab2a205oakffv0j2cogs7e040!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102326/7367eaae8092016a587a5d40e9eeaf1d/spectrum/1040g34o31jfe4lab2a2g5oakffv0j2coi935288!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中,网课,高三,一轮复习', 'last_modify_ts': 1773156409555, 'note_url': 'https://www.xiaohongshu.com/explore/686624400000000012031ada?xsec_token=ABqipxp4a6oPWAk9br2XGY0jQ2CbL1XQEs2L_oSR-vp5s=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABqipxp4a6oPWAk9br2XGY0jQ2CbL1XQEs2L_oSR-vp5s='}
