2026-03-10 23:22:30 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6878a138000000001d00fef3', 'type': 'normal', 'title': '高中1v1暑假班，高途定制时间灵活自选', 'desc': '🤔 暑假想弯道超车又怕时间被绑架？高途高中1v1网课直接把 “学习主动权” 还给你\n🎉 名师天团1v1定制课程，早上8点学还是晚上7点学全看你时间\n👉 哪怕今天突然想出去玩，课程随时调期不耽误\n🔥 暑假边玩边学还能悄悄拔尖，这波操作真的戳中高中生的心！\n\t\n✅ 1v1定制课程，你的薄弱点就是主攻方向\n不用跟着大班课 “陪跑”，高途老师上来就给你做全科漏洞扫描，制定专属学习计划；\n\t\n✅ 时间完全随心定，暑假安排再也不打架\n不用赶早八、不用挤公交，高途的时间灵活到离谱：\n▫️ 想睡懒觉？课程直接排下午 2 点，睡醒了吃口饭再学，状态拉满；\n▫️ 某天突然没状态？当天课程可延后，不用硬撑着低效学习，高途懂高中生的 “情绪波动期”。\n✅ 双一流名师主讲 + 班班督学，学没学会有人盯到底\n▫️ 老师一对一教学全程互动，梳理知识点，深入讲解重难点，传授做题技巧和学习方法\n▫️ 专属的课程督学老师及时批改作业并反馈，及时调整学习方案\n\t\n不用被时间绑架，也能悄悄把成绩提上去，开学惊艳所有人～\n🎁 点击【立即咨询】即可领取1v1专属试学名额\n⏰ 活动时间：即日起-25年10月1日\n🙋 报名要求：仅面向32岁以上家长\n\ufeff#高途[话题]#\ufeff \ufeff#高中[话题]#\ufeff \ufeff#一对一网课[话题]#\ufeff \ufeff#高一[话题]#\ufeff \ufeff#高二[话题]#\ufeff \ufeff#高三[话题]#\ufeff', 'video_url': '', 'time': 1752736056000, 'last_update_time': 1752736056000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '1', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102322/339f7b47d49f6cce15a219ea62ad3e87/spectrum/1040g0k031k1fsv2k2a0g5oakffv0j2co1p5hsc0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102322/d5cef6db82d8e168d04a96476da58b5a/spectrum/1040g0k031k1fsv2k2a105oakffv0j2copt7q7f8!nd_dft_wlteh_webp_3', 'tag_list': '高途,高中,一对一网课,高一,高二,高三', 'last_modify_ts': 1773156150837, 'note_url': 'https://www.xiaohongshu.com/explore/6878a138000000001d00fef3?xsec_token=AB8CR3kcsUfNMvn-S4wwqefR2Yrhur_nWUs_4_7hZuxfY=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB8CR3kcsUfNMvn-S4wwqefR2Yrhur_nWUs_4_7hZuxfY='}
