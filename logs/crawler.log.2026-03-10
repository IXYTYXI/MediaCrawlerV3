2026-03-10 22:41:02 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69aa9d34000000002602c591', 'type': 'normal', 'title': '高考冲刺｜选高途1v1，陪跑到出分', 'desc': '😭 家有高考生真的太焦虑了\n😭 前前后后砸了好几万在辅导上\n😭 要么老师水、要么不负责、要么完全不对接高考\n😭 钱白花、时间白扔，孩子越学越慌！\n直到换了高途高考 1v1 陪跑，全程负责到出分，才知道什么叫真正靠谱❗️\n\t\n✅ 6轮严选名师·懂新高考懂命题\n全部持证上岗、用命题人思维备课讲课，抓考点准、提分快，不做无用功；\n\t\n✅ 学情诊断·1v1量身定制计划\n先测基础、再定方案，完全按孩子水平定制教学，不搞一刀切；\n\t\n✅ 科学体系·完整学习闭环\n从入门到拔高，分层教学、循序渐进，稳扎稳打提分；\n\t\n✅ 24h 在线答疑·问题不过夜\n课前课后全程跟进，深夜刷题有疑问也能马上问，不留漏洞到明天；\n\t\n✅ 高考大招技巧\n各科自研解题模型，拆解考点、教思路、给方法，刷题少、见效快，效率拉满。\n\t\n真心劝高三家长：最后阶段别乱花冤枉钱！选对一个负责到出分的 1v1，比报10个课都有用！\n\t\n📣 赶紧点击左下角【立即咨询】领取1v1试学名额\n📍 活动范围：仅面向32岁以上家长\n🌈 活动时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #高考改变人生[话题]# #高考冲刺[话题]# #高考逆袭[话题]# #高考心态很重要[话题]# #高效学习[话题]#', 'video_url': '', 'time': 1772789044000, 'last_update_time': 1772789045000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '河北', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102241/06b9d8c3ece6c4195e70d983f2830ddf/spectrum/1040g34o31tc9tctjl82g5oakffv0j2coeas0cf8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102241/c5fd1700e47c08aac428643f89effce4/spectrum/1040g34o31tc9tctjl8305oakffv0j2co3gojnc0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102241/79b217e5bb2d10c6890a28ce9fed755e/spectrum/1040g34o31tc9tctjl83g5oakffv0j2co0u1vn58!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,高考改变人生,高考冲刺,高考逆袭,高考心态很重要,高效学习', 'last_modify_ts': 1773153662774, 'note_url': 'https://www.xiaohongshu.com/explore/69aa9d34000000002602c591?xsec_token=ABEY8sU4xINMp3qbyKnY2hiwiAlJgBjJ4Qx8lUPog6rs4=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABEY8sU4xINMp3qbyKnY2hiwiAlJgBjJ4Qx8lUPog6rs4='}
