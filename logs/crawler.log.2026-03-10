2026-03-10 22:54:42 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69393dc3000000001b032446', 'type': 'normal', 'title': '听劝！高中选对1v1网课选对少走半年弯路', 'desc': '⚠️ 家有高中生，辅导选不对真的白费功夫！\n😭 要么是老师不匹配，要么是课程没规划\n✅ 直到试了高途高中1v1线上网课，100%名师定制授课，从0基础到出分全程护航，家长彻底不用愁！\n\t\n🧑\u200d🏫 【好老师：严选名校学霸，不满意随时换】\n多轮严选的名校毕业学霸，持证上岗，1v1 直播带学，实时互动、针对性讲解，学习积极性直接拉满；\n\t\n🤩 【好体系：0基础起步，定制到每节课目标】\n先做精准学情检测，找准知识盲区，再根据孩子情况1v1定制课程，全程护航到出分；\n\t\n🤩 【好服务：全程陪伴，家长随时掌握进度】\n课后批改作业，7*24小时答疑不打烊，孩子深夜刷题遇难题，随时提问秒响应，疑问不隔夜；\n\t\n给孩子选网课，选对 “名师 + 定制 + 服务” 才是王道！\n↙️ 感兴趣的家长赶紧点击【立即咨询】领取1v1试学名额\n🔍 报名要求：32岁以上家长\n⏰ 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #线上课[话题]# #学习规划[话题]# #课程辅导[话题]# #高效学习[话题]# #学习更高效[话题]#', 'video_url': '', 'time': 1765415460000, 'last_update_time': 1765359044000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '2', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102254/5f264ad084131d2d59d235f316e1091c/spectrum/1040g34o31ptj0d0hl4205oakffv0j2copcedd40!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102254/173ce5b778c468541ca45eef7c810ed2/spectrum/1040g34o31ptj0d0hl42g5oakffv0j2co86cfhj0!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,线上课,学习规划,课程辅导,高效学习,学习更高效', 'last_modify_ts': 1773154482525, 'note_url': 'https://www.xiaohongshu.com/explore/69393dc3000000001b032446?xsec_token=ABVnDHGnmSLIAItD3W41IyX0_nhbBSAKZpnJ6zyoc78Tw=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABVnDHGnmSLIAItD3W41IyX0_nhbBSAKZpnJ6zyoc78Tw='}
