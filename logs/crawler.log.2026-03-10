2026-03-10 21:31:19 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a9178900000000150320f4', 'type': 'video', 'title': '开学不用慌！Mathplore让娃吃透数学✨', 'desc': '开学想让娃弯道超车？别再焦虑娃基础差、跟不上进度了❗\n试了Mathplore新加坡数学一个月，我终于懂为啥学霸妈妈都在推，我家娃的变化直接肉眼可见✨感谢@小红薯704FBC82 的分享👇\n以前娃数学总是垫底，一做题就咬笔头，稍微变个题型就懵，辅导作业家里鸡飞狗跳，我没方法、讲不透，看着成绩单上的分数，急得整夜睡不着😭\n直到试了Mathplore才发现，数学逆袭找对课程真的太重要，不用逼娃、不用费妈，开学用来追赶再合适不过！\n\t\n✅ 一周两节高效学：精准适配小学生节奏，不占用过多课余时间，动画讲概念、互动练思维，娃学得进去，开学状态拉满，再也不用我催\n✅ CPA建模透逻辑：新加坡数学核心教法，把抽象的数量关系变成看得见的图形，娃不再死记硬背，自己就能理清思路、攻克难题\n✅ 紧跟校内冲前排：课程体系完美贴合校内大纲，查漏补缺又适度拔高，知识点层层递进，吃透每一个考点，越学越有自信\n✅ 小班直播更专注：2-6人小班模式，老师全程盯着不走神，互动频繁纠错及时，每个娃都能被照顾到，家长真正省心\n🌟 精品小班授课 | 每节40-50分钟 | 中英双语任选\n不确定适配娃？速戳左下角【立即咨询】领取价值1888元试听礼包，开学趁别人还在适应，让娃悄悄逆袭直冲班级前列💥\n⏰ 活动时间：即日起至2028.12.31\n面向18+海外家长\n#小学数学思维训练[话题]#  #Mathplore新加坡数学[话题]#  #新加坡数学[话题]#  #数学开窍[话题]#  #爱上数学[话题]#  #数学思维课[话题]#', 'video_url': 'http://sns-video-al.xhscdn.com/stream/79/110/259/01e9a916df48fccb010370039cbc8416e9_259.mp4', 'time': 1772689289000, 'last_update_time': 1772689290000, 'user_id': '66c854d2000000001d022cac', 'nickname': 'Mathplore数学开窍', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31djmkng2h66g5pm8aj97cb5cr77jngg', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '四川', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102131/472080636042c358cae00681bc9afb61/spectrum/1040g0k031taq99n058005pm8aj97cb5c7nec338!nd_dft_wlteh_webp_3', 'tag_list': '小学数学思维训练,Mathplore新加坡数学,新加坡数学,数学开窍,爱上数学,数学思维课', 'last_modify_ts': 1773149479847, 'note_url': 'https://www.xiaohongshu.com/explore/69a9178900000000150320f4?xsec_token=ABkXiiT8OoWfy0U4yQ6YI3ttNWVUAP219-YTYFHkSTxK8=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABkXiiT8OoWfy0U4yQ6YI3ttNWVUAP219-YTYFHkSTxK8='}
