2026-03-10 22:43:59 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '698bf0f1000000001600be37', 'type': 'normal', 'title': '高途高三1v1！负责到26年高考✅', 'desc': '高三党和家长看过来！🙋\u200d♀️ 想高效冲刺高考，又怕大班课跟不上？\n高途高中1v1名师线上教学，真的太香了！\n\t\n✨ 名师天团1v1带学\n教龄超6年的金牌名师亲自授课，严格筛选师资，擅长用命题人思维传授知识，孩子跟着学，思路清晰不迷茫！👨\u200d🏫\n\t\n🎯 直击学习痛点\n大班课跟不上、知识点断层、刷题没方向？1v1教学精准定制计划，从基础到拔高，名师从头讲到高考，负责到26年高考💪\n\t\n🧩 五大核心优势闭环体系\n1️⃣ 学前检测制定专属计划，精准定位薄弱点📝\n2️⃣ 名师1v1带学负责到出分，全程陪伴不脱节📚\n3️⃣ 24h督学答疑，问题不过夜，学习更安心✨\n4️⃣ 阶段测试调整规划，及时优化学习节奏📊\n5️⃣ 知识系统梳理+学情报告，进步看得见📈\n\t\n💡 科学闭环，放心托付\n精心打磨优质内容，每天督学看学情，科学体系层层递进，家长放心，孩子安心！\n\t\n现在点击【立即咨询】，还能领取1v1试学体验，赶紧冲！🚨\n📌 报名要求：仅面向家长\n🛎️ 活动截止时间：2026年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #高考冲刺[话题]# #艺术生文化课[话题]# #高考复习[话题]# #高考逆袭[话题]# #高效学习[话题]#', 'video_url': '', 'time': 1770778865000, 'last_update_time': 1770778865000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '2', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '河北', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102243/b5eb1e9f657f88249c7327885f877447/spectrum/1040g34o31sebcaokl6305oakffv0j2co0oe3nr8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102243/03ebb5dea95bcfd758d25b470c5c5051/spectrum/1040g34o31sebcaokl63g5oakffv0j2cojm021s8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102243/318e84732e05571e88211e39b50ba69e/spectrum/1040g34o31sebcaokl6405oakffv0j2cohk0lgfg!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,高考冲刺,艺术生文化课,高考复习,高考逆袭,高效学习', 'last_modify_ts': 1773153839229, 'note_url': 'https://www.xiaohongshu.com/explore/698bf0f1000000001600be37?xsec_token=AB0Z9yfQ7GgsduS9DBlYJ1WhVkE4JXWCeVXxgox8JIAWo=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB0Z9yfQ7GgsduS9DBlYJ1WhVkE4JXWCeVXxgox8JIAWo='}
