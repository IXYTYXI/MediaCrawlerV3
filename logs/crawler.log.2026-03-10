2026-03-10 23:58:35 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6780eee40000000001008aeb', 'type': 'normal', 'title': '最后一个暑假‼️再不学就来不及啦😭', 'desc': '各位家长，孩子暑假不会还没有学习计划吧❓\n⚠️ 作为最后一个暑假也是一个弯道超车的机会！！\n真的要抓住提前抢跑\n学习的轻重缓急要注意，别把重点弄错啦~\n🔥 我们的目标是分，每个科目都要充分学习复习\n-\n【跟着高途一对一，全面复习，狠补短板】\n✅ 不同基础不同进度都能学；\n✅ 拥有超多10年+经验丰富的教师1v1授课，对各科目了如指掌，不仅传授知识更教学习方法；\n✅ 老师根据复习目标，基础水平，1v1量身制定学习计划，这份计划将是👶学习路上的指南针；\n✅ 采用直播的形式，无论是零基础还是有基础薄弱，灵活调整课程内容以适应👶的基础；\n✅ 专门的老师1v1实时答疑解惑，无论遇到什么难题卡点，都能及时解决！\n-\n🙋 现在点击⬇【立即咨询】抢先领取👉🏻试听课名额~\n🉐1对1专业诊断+定制专属计划+学习资料\n🌈名额有限，先到先得！\n报名要求：32岁以上家长\n截止时间：即日起-25年5月31日\n\ufeff#高途[话题]#\ufeff  \ufeff#一对一[话题]#\ufeff    \ufeff#暑假逆袭[话题]#\ufeff', 'video_url': '', 'time': 1736514120000, 'last_update_time': 1760924776000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '72', 'collected_count': '29', 'comment_count': '1', 'share_count': '3', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102358/806c810951bb9e9e23d2f6a1133a8866/spectrum/1040g0k031ibfks0g7i005oakffv0j2coc20jmq0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102358/9ee6b962945894e730b53f218d3df891/spectrum/1040g0k031ia6cibb6q0g5oakffv0j2co9708r98!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102358/80d849107ec30ba861991c4fc441cd03/spectrum/1040g0k031ia6cibb6q105oakffv0j2cochjd188!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,暑假逆袭', 'last_modify_ts': 1773158315555, 'note_url': 'https://www.xiaohongshu.com/explore/6780eee40000000001008aeb?xsec_token=ABKB1PAxdwQSYuAJYxA3w94YPjp8voYgl3WSUKPMUQQbQ=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABKB1PAxdwQSYuAJYxA3w94YPjp8voYgl3WSUKPMUQQbQ='}
