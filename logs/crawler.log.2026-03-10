2026-03-10 17:56:42 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67e5730100000000060399b5', 'type': 'video', 'title': '超前自学用费曼学习法才是永远的神！', 'desc': '#二年级[话题]# #一年级[话题]# #计算[话题]# #小学数学[话题]# #费曼学习法[话题]# #三年级[话题]# #四年级[话题]# #五年级[话题]# #规划[话题]#', 'video_url': 'http://sns-video-hw.xhscdn.com/stream/1/110/259/01e7e572bd2d20860103700395d84ad7bf_259.mp4', 'time': 1743116521000, 'last_update_time': 1743090433000, 'user_id': '608a833d000000000101f769', 'nickname': '乐妈～', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31jtq15qaiu6g5o4agcugbtr9pv2jia0', 'liked_count': '337', 'collected_count': '287', 'comment_count': '2', 'share_count': '59', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603101750/0daded85ba7b2018842dfe88e0d2ae1f/1040g2sg31fhofo0u7qd05o4agcugbtr9soth8q8!nd_dft_wlteh_webp_3', 'tag_list': '二年级,一年级,计算,小学数学,费曼学习法,三年级,四年级,五年级,规划', 'last_modify_ts': 1773136602937, 'note_url': 'https://www.xiaohongshu.com/explore/67e5730100000000060399b5?xsec_token=ABDfZSwO0A3d7C3wrKiMkxAx9xEGt3GJCLLrcizPlEzXo=&xsec_source=pc_search', 'source_keyword': '数学超前学', 'xsec_token': 'ABDfZSwO0A3d7C3wrKiMkxAx9xEGt3GJCLLrcizPlEzXo='}
