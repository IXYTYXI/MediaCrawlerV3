2026-03-10 23:04:25 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68f701a900000000040201cf', 'type': 'normal', 'title': '高中物理别乱花钱！1v1定制课轻松领先', 'desc': '🤔 不少高中家长给孩子补物理，钱花了不少\n😭 考试还是懵、就连基础题也依旧卡壳......\n🔥 其实不是高中物理难，是没选对方法！\n\t\n聪明家长都认准1v1定制课，名师带学+精准规划，30天轻松领先，不花一分冤枉钱！\n\t\n👉 【1v1定制课4大核心优势】\n🧑\u200d🏫 1v1名师带学，懂考点更懂弱生：高中物理资深名师，不是只会讲难题，更懂 “基础弱的孩子怎么入门，一步步教不让孩子卡壳；\n\t\n🙋 专项诊断，找准问题再发力：老师先测孩子现阶段水平，再出专属学情报告，制定针对性方案，不做无用功；\n\t\n📈 阶梯进步方案，稳扎稳打：从基础到拔高循序渐进，不跳步不赶进度，确保每节课都能有收获；\n\t\n▫️ 全程陪跑，不怕孩子偷懒掉队：学前提醒，课中互动防走神，学后24小时答疑，哪怕半夜问 难题，也能及时得到解答，知识不堆积。\n\t\n高中物理提芬，选对课比乱报班管用！\n戳左下角【立即咨询】领取1v1试学名额\n🙋 报名要求：32岁以上家长\n⏰ 报名时间：即日起 - 2026年12月31日\n#高途[话题]# #一对一[话题]# #网课[话题]# #高中物理[话题]# #学物理原来这么简单[话题]# #高考物理[话题]# #高中网课[话题]#', 'video_url': '', 'time': 1761096840000, 'last_update_time': 1761018281000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '1', 'comment_count': '1', 'share_count': '5', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102304/0e86741e17a29c5e0a46b43bc6bf5bf8/spectrum/1040g0k031nst5c25ks005oakffv0j2covbaobsg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102304/8add1fa4454d7e93efd88b56588da975/spectrum/1040g0k031nst5c25ks0g5oakffv0j2cogjo4mg8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102304/66cdd37db6ac7e695a2c509e8962c1f4/spectrum/1040g0k031nst5c25ks105oakffv0j2cosqq8nl0!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,高中物理,学物理原来这么简单,高考物理,高中网课', 'last_modify_ts': 1773155065606, 'note_url': 'https://www.xiaohongshu.com/explore/68f701a900000000040201cf?xsec_token=AB03pUkyOffo3GF5muHHQUAfj4HV4ugTr5rNB6K4PMPiw=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB03pUkyOffo3GF5muHHQUAfj4HV4ugTr5rNB6K4PMPiw='}
