2026-03-10 17:57:03 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '695e23cf000000001a026654', 'type': 'video', 'title': '一二年级下学期数学预习建议方法', 'desc': '要说在前面的话就是我不是这样预习的\n甚至可以说我没有做预习的工作\n因为我始终在用着之前一直在分享给大家的方式提前学\n没错就是周周学新加坡数学高思原来还有秘籍\n这里面只有新加坡数学算作是教材\n但我确实没有只学它\n我也不建议大家只用它来学\n因为很多东西都是相辅相成的\n数学本来就是一个既要往前也要往深的学科\n如果不知道我在说什么的话\n那就请翻一翻我之前二年级发的视频吧～\n#一年级数学[话题]# #二年级数学[话题]# #数学预习[话题]# #寒假预习[话题]# #数学提前学[话题]#', 'video_url': 'http://sns-video-hw.xhscdn.com/stream/1/110/259/01e95e2345070804010370039b97c1611e_259.mp4', 'time': 1767777231000, 'last_update_time': 1767777232000, 'user_id': '561e859e33f60c42513af398', 'nickname': '是胖妈呀', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/5dcc1e82fb231000015ef1a8.jpg', 'liked_count': '274', 'collected_count': '201', 'comment_count': '55', 'share_count': '35', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603101751/1247fe6068ef0990777d69ba42413b16/1040g2sg31r1fcsm200e041ij322ptssoim5mt60!nd_dft_wlteh_webp_3', 'tag_list': '一年级数学,二年级数学,数学预习,寒假预习,数学提前学', 'last_modify_ts': 1773136623492, 'note_url': 'https://www.xiaohongshu.com/explore/695e23cf000000001a026654?xsec_token=ABv0_xd8T1RB7s5KWOzmuvC3NMHS1NI2Fdnhns-_Zsxxg=&xsec_source=pc_search', 'source_keyword': '数学超前学', 'xsec_token': 'ABv0_xd8T1RB7s5KWOzmuvC3NMHS1NI2Fdnhns-_Zsxxg='}
