2026-03-10 23:53:57 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67cd5e1f00000000290194e0', 'type': 'normal', 'title': '太🐮了！这么负责的一对一你还不知道？', 'desc': '孩子每天努力刷题，早起晚睡还是不尽人意\n心情焦虑，作为父母的各位看在眼里\n-\n这时候，省心省力的1v1就显得尤为重要\n在家就能享受到名师优质教育资源，而且根据学习情况调整教学节奏和方法，这是大班课无法比拟的🤩\n-\n【高途一对一】\n✅ 1v1精准定位学习水平，全方位评估，找到具体知识薄弱点\n✅ 1v1量身定制学习计划，每天学习计划安排得明明白白\n✅ 在家就能开启随时随地学习模式，还能和老师实时互动\n✅ 名校毕业的老师1v1授课，教学经验丰富，复习效率更高\n✅ 1v1课后答疑解惑+精批作业+专属家长沟通群，随时了解学习动态\n-\n现在点击⬇【立即咨询】还能领取专属试听特权\n🉐1对1专业辅导+定制专属计划+学习资料\n报名要求：32岁以上家长\n截止时间：即日起-2026年12月31日\n\ufeff#高途[话题]#\ufeff\xa0\xa0\xa0\ufeff#一对一[话题]#\ufeff\xa0\xa0\xa0\ufeff#网课[话题]#\ufeff\ufeff', 'video_url': '', 'time': 1741525253000, 'last_update_time': 1750327493000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '540', 'collected_count': '254', 'comment_count': '80', 'share_count': '109', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102353/4ca7636aa2a4dd06a9d8eb7cf44626c7/spectrum/1040g34o31itjcsjigm205oakffv0j2cof6vvfjg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102353/562fa8e8319af1dcbb886fe9b37a45ea/spectrum/1040g34o31itjcsjigm2g5oakffv0j2cocpghh20!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102353/c4eceb76884f8474d907440a34465bb7/spectrum/1040g34o31itjcsjigm305oakffv0j2coq3277tg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102353/45761954a18b0983184e2be294382763/spectrum/1040g34o31itjcsjigm3g5oakffv0j2cocmalcso!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课', 'last_modify_ts': 1773158037649, 'note_url': 'https://www.xiaohongshu.com/explore/67cd5e1f00000000290194e0?xsec_token=AB3SK0mImtClgB_ZsjgVMk5LftLxuDllhN8_8VmyiC-ks=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB3SK0mImtClgB_ZsjgVMk5LftLxuDllhN8_8VmyiC-ks='}
