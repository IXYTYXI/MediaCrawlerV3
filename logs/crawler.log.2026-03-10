2026-03-10 23:21:51 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6878a220000000000d025314', 'type': 'normal', 'title': '高三1V1选高途，全程陪跑助逆袭', 'desc': '高三这一年，时间比金子还贵，要是复习没方向、学了就忘，真的太吃亏！\n还好报了高途1V1，名师全程盯着学，定制计划、带练带讲、盯紧落实\n把每个知识点都嚼碎了喂到脑子里，这波陪跑真的让我复习效率翻倍！\n\t\n👉 一轮复习从 “扫盲” 开始，薄弱点被追着补\n哪个知识点弱就死磕哪个，基础打得牢，后面刷题才不费劲。\n\t\n👉 二轮三轮专攻 “ti分点”，大招技巧直接套用\n到了二轮三轮，老师带学主攻高频考点和解题大招，刷题时看到题目就知道用啥方法\n\t\n👉 双一流名师 + 督学双保险，想偷懒都难\n高途的老师是多轮严选的双一流学霸，讲课有独特方法，还有督学老师全程盯梢\n\t\n👉 进度透明，家长也能随时了解情况\n定期发学习报告，阶段模考测试，随时调整复习计划，才能实现真正高效学习\n\t\n有专业的人带着，少走弯路不说，还能把知识点学扎实，到高kao时才能稳稳发挥\n🎁 点击【立即咨询】即可领取1v1专属试学名额\n⏰ 活动时间：即日起-26年12月31日\n🙋 报名要求：仅面向32岁以上家长\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#高三陪跑[话题]#\ufeff \ufeff#一轮复习[话题]#\ufeff \ufeff#高三[话题]#\ufeff', 'video_url': '', 'time': 1752797461000, 'last_update_time': 1752736289000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '8', 'collected_count': '1', 'comment_count': '6', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102321/7b8f3475abdaaa561e2e3911e43c2466/spectrum/1040g0k031k1g0dgria005oakffv0j2conf07ddo!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,高三陪跑,一轮复习,高三', 'last_modify_ts': 1773156111315, 'note_url': 'https://www.xiaohongshu.com/explore/6878a220000000000d025314?xsec_token=AB8CR3kcsUfNMvn-S4wwqefbzVDtDItV5xQX7f-lw0GAs=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB8CR3kcsUfNMvn-S4wwqefbzVDtDItV5xQX7f-lw0GAs='}
