2026-03-10 17:55:20 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '694e6bec000000002103eef3', 'type': 'video', 'title': '放弃奥数改超前学，女儿最大的变化', 'desc': '在孩子经历了半年的奥数学习后，我和孩子爸爸认真复盘、反复讨论，最终做了一个决定：不再继续走奥数路线，而是转向在家自主安排数学超前学习。 #洋葱超前学[话题]#  #奥数[话题]#  #小学数学[话题]#  #学习规划[话题]#', 'video_url': 'http://sns-video-hw.xhscdn.com/stream/1/110/259/01e94e6be61d5e84010370039b5a573a12_259.mp4', 'time': 1766747116000, 'last_update_time': 1767089729000, 'user_id': '68305818000000000e01d586', 'nickname': '知知妈带娃学', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31kno6i0f2a0g5q1gb0c3jlc6hcunln0', 'liked_count': '1325', 'collected_count': '1871', 'comment_count': '88', 'share_count': '566', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603101747/2d035bf39ee573c67fdb37d99b16f1a9/spectrum/1040g34o31qi8tav6n20g5q1gb0c3jlc6un82c18!nd_dft_wlteh_webp_3', 'tag_list': '洋葱超前学,奥数,小学数学,学习规划', 'last_modify_ts': 1773136520798, 'note_url': 'https://www.xiaohongshu.com/explore/694e6bec000000002103eef3?xsec_token=AB33gLXPESSsG0qxOEa-J4EM55Yi4pxqqp_0FwQhjEvdY=&xsec_source=pc_search', 'source_keyword': '数学超前学', 'xsec_token': 'AB33gLXPESSsG0qxOEa-J4EM55Yi4pxqqp_0FwQhjEvdY='}
