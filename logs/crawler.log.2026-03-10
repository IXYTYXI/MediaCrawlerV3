2026-03-10 22:10:11 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a7efee000000001503b27e', 'type': 'video', 'title': '真的不骗人💥100多上一节1V1名师课🤔', 'desc': '家长们，有没有发现孩子学数学总卡在这几个地方？😥\n① 上课一听就懂，下课做题就懵\n② 刷题特别认真，分数就是不动\n③ 单章测试还行，大考就垮掉\n最扎心的是，看着孩子从“不会做”慢慢变成“不敢做”…数学拖后腿，拖的其实是信心和选择呀！😔\n坦白说，高中还只让孩子埋头刷题、跟大班赶进度，真的费时又低效！\n提升数学的关键，其实是：✨ 建立解题思维模型 + 🎯 精准打击高频考点！\n所以真心推荐试试我们的【掌门一对一高中数学网课】三步闭环，专治“学得累却考不好”：\n📊 课前｜精准诊断，不浪费一分钟\n先做智能测评，找到孩子到底是概念模糊、思路卡壳还是不会举一反三，学习计划直接瞄准薄弱点。\n👩🏫 课中｜一对一沉浸式互动\n老师100%关注你家孩子，随时提问当场解决，不光讲答案，更教“怎么想”，把知识点变成解题能力。\n📝 课后｜作业配专属反馈\n每次练习都针对当堂弱点，批改后附详细错因分析和举一反三题，进步看得见，家长超省心~\n🙋♀️现在点击⬇️【直播间】还能有1V1体验课~\n🉐1对1专业辅导+定制专属计划+学习资料\n感兴趣的家长们这个暑假赶紧冲！！！\n-\n👩报名要求：32岁以上家长\n⏰截止时间：即日起-2026年12月31日\n#掌门[话题]#  #掌门1对1[话题]#  #掌门一对一[话题]#  #网课[话题]#  #网课推荐[话题]#  #学习方法[话题]#  #数学[话题]#', 'video_url': 'http://sns-video-al.xhscdn.com/stream/79/110/259/01e9a7efad45f726010370039cb801f2a8_259.mp4', 'time': 1772631009000, 'last_update_time': 1772613614000, 'user_id': '649a70220000000010036bfc', 'nickname': '掌门1对1学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31pumqmjhls005p4qe0h46qvs49pjit8', 'liked_count': '1', 'collected_count': '2', 'comment_count': '', 'share_count': '', 'ip_location': '上海', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102210/5d50eb3318f5f3df06220ea88ade4ef5/spectrum/1040g0k031t9m800g56005p4qe0h46qvsfj02spg!nd_dft_wlteh_webp_3', 'tag_list': '掌门,掌门1对1,掌门一对一,网课,网课推荐,学习方法,数学', 'last_modify_ts': 1773151811577, 'note_url': 'https://www.xiaohongshu.com/explore/69a7efee000000001503b27e?xsec_token=ABvtKkoN-JdN_qRqzuJpkmXDPMyL5Ih0W0cX9RhGCDpfI=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABvtKkoN-JdN_qRqzuJpkmXDPMyL5Ih0W0cX9RhGCDpfI='}
