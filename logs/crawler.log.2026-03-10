2026-03-10 23:43:43 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6809952c000000001d017c2e', 'type': 'normal', 'title': '一对一盯着学💥中等生逆袭学霸', 'desc': '💢 中等生的致命痛点，你家🧑\u200d🎓中招了吗？\n👉🏻 卡在瓶颈期：成绩不上不下，补课没效果，越学越迷茫\n👉🏻 假努力严重：笔记抄满书，一到考试全不会\n👉🏻 偏科拖后腿：单科拉低总分，怎么也学不会\n👉🏻 不会自主学习：没人盯着就偷懒，作业全靠糊弄\n\t\n高途1v1严管盯学，名师手把手带，教到学会为止！\n📣 持证上岗真名师：6轮严选名校毕业学霸，经过严格培训才走上讲台授课；\n📣 一对一专属学习规划：量身定制学习规划，吃透重点题型，掌握解题大招；\n📣 辅导闭环学习：高途采用主讲+二讲模式，从督学到答疑，全程陪跑；\n📣 三方会议高效沟通：线上预约之后会有专门的老师和家长联系，沟通详细内容；\n\t\n感兴趣的家长点击下方【立即咨询】即可领取专属试听\n*本课程为家庭教育规划课，内容仅面向家长\n📆 活动时间：即日起-2025年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#学习日常[话题]#\ufeff \ufeff#自律学习[话题]#\ufeff', 'video_url': '', 'time': 1745555641000, 'last_update_time': 1745458476000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '3', 'collected_count': '', 'comment_count': '2', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102343/19223316436db9521f27e3a638be0b14/spectrum/1040g34o31gl1lue738005oakffv0j2coqp5h3d8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102343/a58dd5bec2faa80a275409406d2738b9/spectrum/1040g34o31gl1lue7380g5oakffv0j2co4g4bg7o!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,学习日常,自律学习', 'last_modify_ts': 1773157423494, 'note_url': 'https://www.xiaohongshu.com/explore/6809952c000000001d017c2e?xsec_token=ABuTeg-y02O_coiO5uIALyNnvT8G6ELr9pIZ5p1n89Yso=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABuTeg-y02O_coiO5uIALyNnvT8G6ELr9pIZ5p1n89Yso='}
