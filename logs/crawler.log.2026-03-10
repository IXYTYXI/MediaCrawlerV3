2026-03-10 16:08:15 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '669fbf3b000000000302480d', 'type': 'normal', 'title': '四升五暑假进度：数学学霸刷到多边形面积啦', 'desc': '七月还有一周结束。\n数学深度预习按计划顺利推进着🤏\n教材快准狠自学+学霸刷一天3面✅\n每晚讲两道错题给我听：费曼法巩固。\n计划8月开始前完成整学期深度自学！\n−\n英语语法课：本周巩固现在进行时✅\n单词打卡：每周抽背30个单词。\n−\n语文学霸假期不做题不预习只阅读和背诵\n《历史深处的民国》第三册打卡到p172。\n《中学生必备古诗》今天已背完石壕吏。\n−\n编程升到python 班：一周三课✅\n每天都有时间让给开心运动与玩耍啦^ - ^\n#学霸[话题]# #超前学[话题]# #四升五暑假[话题]# #四升五[话题]# #阅读[话题]# #小学数学怎么学[话题]# #编程[话题]# #运动[话题]# #英语[话题]# #佛系鸡娃[话题]#', 'video_url': '', 'time': 1721745211000, 'last_update_time': 1721785185000, 'user_id': '58ac059250c4b415f11d1b19', 'nickname': '吴比乐同学', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31oaaem5hmm00496d432p46op0cgu0ao', 'liked_count': '89', 'collected_count': '71', 'comment_count': '69', 'share_count': '5', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603101602/cadf3dec40c8c997b5caaa52143fc081/1040g008315jma3odio00496d432p46opdm4tkug!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101602/352a34bd0c2aa0c8b25cb16baf377b95/1040g008315jma3odio0g496d432p46opf6kv6q0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101602/6bec66ed1c638b99135179769363dbb8/1040g008315jma3odio10496d432p46opo7a1i2o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101602/ddab88bbb4bb0cea6c7dbaa4cd399620/1040g008315jma3odio1g496d432p46op33t5dc0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101602/c1c7d82fc12ab0680c9d797a1a9e6476/1040g008315jma3odio20496d432p46opvdehh5g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101602/ba471b2367611497dd4277b6993f7807/1040g008315jma3odio2g496d432p46op6kaesc0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101602/62443deeb134e18ce2e2be3e9a714658/1040g008315jma3odio30496d432p46op6p2bjto!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101602/44c55fa4ee4b48f9674ac6a259e0c60a/1040g008315jma3odio3g496d432p46op1530ctg!nd_dft_wlteh_webp_3', 'tag_list': '学霸,超前学,四升五暑假,四升五,阅读,小学数学怎么学,编程,运动,英语,佛系鸡娃', 'last_modify_ts': 1773130095448, 'note_url': 'https://www.xiaohongshu.com/explore/669fbf3b000000000302480d?xsec_token=ABCQ39GNJP0R2yl8FehHAIuwOiYbbLBKPjTVVzZ-RCtHc=&xsec_source=pc_search', 'source_keyword': '数学超前学', 'xsec_token': 'ABCQ39GNJP0R2yl8FehHAIuwOiYbbLBKPjTVVzZ-RCtHc='}
