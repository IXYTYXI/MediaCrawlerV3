2026-03-10 22:55:19 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69393cc7000000001b026ef8', 'type': 'normal', 'title': '完全没想到❗️高三在家上1v1效率这么高', 'desc': '😮\u200d💨 家有高三生，最愁两件事：\n😭 一是跑机构赶通勤，浪费宝贵备考时间；\n😭 二是孩子刷题无数却提分慢，没人盯学总摸鱼…\n✅ 试了高途高三 1v1 网课后彻底松口气 —— 在家就能学，全程负责到高考出分！\n\t\n🎯 大招传授，效率直接拉满\n先做精准学情检测，再1v1定制课程，复习效率直接翻倍，不用再盲目耗时间；\n\t\n🎯 名师1v1直播，精准抓高考重难点\n严选名校毕业学霸主讲，1v1直播带学不搞 “单向灌输”，在家学比跑机构听得更专注、收获更多；\n\t\n🎯 全程陪伴盯巩固，家长不用天天盯\n课前：提醒预习重点，帮孩子提前梳理知识框架；\n课中：盯紧听课状态，防止走神，听不懂当场重讲；\n课后：7*24h答疑不打烊，疑问不隔夜；\n\t\n高三备考拼的是效率和靠谱的引导，想让孩子少走弯路的家长赶紧点击【立即咨询】领取1v1试学名额～\n🔍 报名要求：32岁以上家长\n⏰ 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #高考逆袭[话题]# #学习效率[话题]# #一轮复习[话题]# #学习更高效[话题]# #高考冲刺[话题]#', 'video_url': '', 'time': 1765358791000, 'last_update_time': 1765358791000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '2', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102255/c9d1cb1d62122ab354a3c0aec8de91cc/spectrum/1040g34o31ptimk1kju305oakffv0j2cocij4pi8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102255/15a8f04a79244ab7aee9901ba60fcff6/spectrum/1040g34o31ptimk1kju3g5oakffv0j2co364mgeg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102255/a8f1a8e0cb29f92613cd80ec5587be6a/spectrum/1040g34o31ptimk1kju405oakffv0j2cov0m8v40!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,高考逆袭,学习效率,一轮复习,学习更高效,高考冲刺', 'last_modify_ts': 1773154519736, 'note_url': 'https://www.xiaohongshu.com/explore/69393cc7000000001b026ef8?xsec_token=ABVnDHGnmSLIAItD3W41IyX_NRW0NQla62PJRWwSXcbzU=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABVnDHGnmSLIAItD3W41IyX_NRW0NQla62PJRWwSXcbzU='}
