2026-03-10 23:40:23 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '681aba830000000022036c4f', 'type': 'normal', 'title': '准高三暑期特训营，抢跑新学期🏃', 'desc': '📢 985/211学霸都在偷偷做的事：\n⚠️ 别人暑假在补弱科，你还在刷手机？\n⚠️ 开学第一次月考，差距直接拉开50分？\n⚠️ 高三才开始努力？太晚了！\n\t\n💎 高途1V1暑期特训营，赢在起跑线👇根据目前学习情况，1v1定制专属复习计划👉巩固基础、专题强化、冲刺训练❗️\n\t\n2️⃣ 严选名校毕业学霸，持证上岗真名师直播\n3️⃣ 专属班班，课前、中、后1v1严格督学\n4️⃣ 精准匹配校内进度，随学随用高效学习\n5️⃣ 个性化难度分级，量身定制教学内容\n6️⃣ 系统培养思维，掌握科学解题方法\n7️⃣ 智能诊断学习盲区，靶向突破薄弱环节\n\t\n别再浪费时间无效学习了！选择高中1对1辅导，开启高效复习👇\n现在点击左下角【立即咨询】定制专属复习计划+抢占试听名额\n🙋\u200d♀️服务对象：32岁以上家长\n⏰截止时间：即日起-2025年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#高中[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#暑假[话题]#\ufeff', 'video_url': '', 'time': 1746666120000, 'last_update_time': 1746582148000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '3', 'collected_count': '2', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102340/9eb2f4ba14358f4555c4fcb9c20e460b/spectrum/1040g34o31h5pfoj3j81g5oakffv0j2coucv5g58!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102340/8b11716bc19a0d77ea295ac3daa6a20b/spectrum/1040g34o31h5pfoj3j8205oakffv0j2corf2l5so!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102340/1a914b472db8eec7771a0a15e7973fb7/spectrum/1040g34o31h5pfoj3j82g5oakffv0j2co7f4a578!nd_dft_wlteh_webp_3', 'tag_list': '高途,高中,一对一,暑假', 'last_modify_ts': 1773157223281, 'note_url': 'https://www.xiaohongshu.com/explore/681aba830000000022036c4f?xsec_token=ABvCvu4VdZPq1kCumVVAhSgQea_QbGw47okPZ8DtJs9xA=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABvCvu4VdZPq1kCumVVAhSgQea_QbGw47okPZ8DtJs9xA='}
