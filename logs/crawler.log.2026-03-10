2026-03-10 22:59:21 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '691d1b1a0000000019026c79', 'type': 'normal', 'title': '15天吃透高中物理！高途1v1超负责', 'desc': '15天吃透高中物理！高途1v1超负责\n🤯 高中物理难到 “啃不动”\n😭 孩子对着公式发呆、刷题没思路，周末补了不少课也没效果......\n✅ 直到找到高途高中物理1v1，才发现原来吃透物理薄弱点这么简单👇\n🧑\u200d🏫 好老师带学 + 科学体系 + 全程服务，家长随时掌握进度，不用再为物理发愁！\n\t\n👉 吃透物理，好老师是关键！\n高途严选名校学霸，既懂考点又擅教学，告别枯燥公式灌输，直播带学全程互动，对教学风格不适应，随时可换～\n\t\n👉 好体系护航，0基础也能吃透\n科学体系助力0基础逆袭，从公式推导、概念辨析起步，逐步搭建知识框架，1v1定制学习计划，确保每天学有所得～\n\t\n👉 好服务兜底，家长放心又省心！\n课前预习、课中互动、课后复盘，全程学习闭环。7×24小时随时答疑，难题不过夜家长全程掌握孩子学习情况，省心又安心～\n\t\n↙️ 感兴趣的家长点击左下方【立即咨询】预约1v1试学\n🔍 报名要求：32岁以上家长\n⏰ 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #高中物理[话题]# #高考物理[话题]# #学物理原来这么简单[话题]# #高中学习方法[话题]#', 'video_url': '', 'time': 1763515162000, 'last_update_time': 1763515162000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '78', 'collected_count': '11', 'comment_count': '11', 'share_count': '3', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102259/ef01a5fe61d46b0de9582e25e5435047/spectrum/1040g34o31p23p6p52c305oakffv0j2coq3uv7jg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102259/4f422008fc36ff8b1a9da9f01e0d0d8c/spectrum/1040g34o31p23p6p52c3g5oakffv0j2covugsnv0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102259/934cb7b5a59c8df32cca262d4b13ef63/spectrum/1040g34o31p23p6p52c405oakffv0j2copieaodo!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,高中物理,高考物理,学物理原来这么简单,高中学习方法', 'last_modify_ts': 1773154761085, 'note_url': 'https://www.xiaohongshu.com/explore/691d1b1a0000000019026c79?xsec_token=ABDC86EEMWRgxe46qArkIGHxLBFGAi34Tv-dDiHYAlhPE=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABDC86EEMWRgxe46qArkIGHxLBFGAi34Tv-dDiHYAlhPE='}
