2026-03-10 23:22:11 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6878a1a90000000012030c73', 'type': 'normal', 'title': '高途1v1助力新高三，暑假精准复习领跑', 'desc': '⚠️ 新高三暑假这两个月，可不是用来 “躺平” 的！\n👉 想开学就甩开同龄人，就得靠高途官方 1v1 精准复习\n✅ 名师带着揪漏洞、抓考点、练技巧，把高一高二的薄弱点补成优势，把高频考点嚼碎了刻进脑子里！\n\t\n👉 精准到 “每个点” 的复习，不做无用功\n分析大考成绩单 + 考纲精准补弱，连 “ke本里藏着的母题” 都挖出来练，每个知识点都瞄准考法，暑假复习不浪费一分钟；\n\t\n👉 1v1 定制复习节奏，基础差也能跟上\n高途老师太懂新高三学生的痛点了，复习计划细到每天，督学老师准时发提醒，专治不自律学不进去；\n\t\n👉 名师 + 班班督学，想偷懒都难\n高途的老师是官方严选的双一流名师，不仅会教知识，还懂怎么让学生听进去；督学老师24小时随时答疑解惑、监督作业；\n\t\n👉 家长随时查进度，复习效果看得见\n阶段家长会+模考测试，定时发复习进度报告，家长打开手机就知道孩子的学习进度；\n\t\n新高三暑假就是 “弯道超车” 的关键期，有高途1v1精准带学，不用自己瞎摸索，跟着老师走就能把知识点学透。\n🎁 点击【立即咨询】即可领取1v1专属试学名额\n⏰ 活动时间：即日起-26年12月31日\n🙋 报名要求：仅面向32岁以上家长\n\ufeff#高途[话题]#\ufeff \ufeff#高三[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#一轮复习[话题]#\ufeff \ufeff#网课[话题]#\ufeff', 'video_url': '', 'time': 1752736169000, 'last_update_time': 1752736170000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '2', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102322/190b93f265488d90f10faa1bc3867790/spectrum/1040g0k031k1fuol93q005oakffv0j2cof0b44bo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102322/791e6e700b4e4103e7f8051d827e5f4f/spectrum/1040g0k031k1fuol93q0g5oakffv0j2co896phr0!nd_dft_wlteh_webp_3', 'tag_list': '高途,高三,一对一,一轮复习,网课', 'last_modify_ts': 1773156131350, 'note_url': 'https://www.xiaohongshu.com/explore/6878a1a90000000012030c73?xsec_token=AB8CR3kcsUfNMvn-S4wwqefZ0Y0snRij8AolpCQ3-ALxE=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB8CR3kcsUfNMvn-S4wwqefZ0Y0snRij8AolpCQ3-ALxE='}
