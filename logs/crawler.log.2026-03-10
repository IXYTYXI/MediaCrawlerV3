2026-03-10 23:29:40 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68537dbe000000000b01e6b0', 'type': 'normal', 'title': '暑假在家搞定一轮！1v1全程跟到出分！', 'desc': '😱 原来高三一轮复习真的能在家偷偷逆袭！！\n🏃 不用顶着高温跑补习班，窝在家里被1v1 老师追着学，从知识点扫盲到压轴题突破，全程陪跑稳到离谱！\n\t\n🉐 入学即享深度测评，从学科漏洞到习惯全面剖析！哪里不会补哪里，拒绝盲目刷题\n🉐 细分每日目标，从公式推导到压轴突破，每个阶段都知道 “该学什么、怎么学”\n🉐 名师带着把零散知识点织成网！重点题型反复打磨，薄弱板块逐个击破\n🉐 24小时随时在线答疑解惑，解决疑难杂症，不留知识死角\n🉐 及时的反馈与调整，及时调整学习计划，确保每一步都走得稳扎稳打\n\t\n📢现在点击⬇【立即咨询】领取1v1试听特权\n还能🉐1对1专业辅导+定制专属计划+学习资料\n📝报名要求：32岁以上家长\n📅截止时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#高三复习[话题]#\ufeff \ufeff#暑假[话题]#\ufeff', 'video_url': '', 'time': 1750381501000, 'last_update_time': 1750302143000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '1', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102329/ac9fa4dec102988a46ee9b6c0f93a604/spectrum/1040g34o31it7a6g3hi305oakffv0j2covg0nec0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102329/1b582edf01e65bb1642700fc5b6497f0/spectrum/1040g34o31it7a6g3hi3g5oakffv0j2cocvdoht0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102329/f30108b8062b7475a97c20a6c7735560/spectrum/1040g34o31it7a6g3hi405oakffv0j2coodmiam8!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,高三复习,暑假', 'last_modify_ts': 1773156580781, 'note_url': 'https://www.xiaohongshu.com/explore/68537dbe000000000b01e6b0?xsec_token=ABRHJLVPtugc366G_ZjpButPcPEZBQk9Xrkiq-MgRGPKU=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABRHJLVPtugc366G_ZjpButPcPEZBQk9Xrkiq-MgRGPKU='}
