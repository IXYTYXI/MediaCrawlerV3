2026-03-10 23:56:02 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67a5c370000000002901c735', 'type': 'normal', 'title': '推荐❗️负责到底的高途1对1太香啦', 'desc': '⭕ 如果👶基础薄弱、偏科、想拔高，没有方法\n⭕ 偏偏各位家长平时工作忙没有时间辅导\n⭕ 各位家长担心上课没效果也没人管\n选择高途1对1网课，各种问题，都不怕！\n-\n高途1V1陪跑式网课，入学前会有基础测试，根据👶基础情况和学习时间量身定制每日学习计划，先打好基础再上课！名师全程1v1直播\n-\n🥰服务内容：\n1v1诊断学习情况，制定专属学习规划\n1v1直播授课，全程干货，确保课程吸收\n1v1课后辅导，及时查漏补缺，随时答疑\n1v1阶段测试，检测学习效果\n全方位一对一教学，课后监督，贴心指导，不浪费每一分钟宝贵时间！\n-\n点击左下角【立即咨询】抢试学名额👉\n（课程面向32岁以上家长）\n活动时间：即日起-2025.12.31\n\ufeff#高途[话题]#\ufeff\xa0\xa0\ufeff#一对一[话题]#\ufeff\xa0\xa0\ufeff#线上课[话题]#\ufeff', 'video_url': '', 'time': 1738922676000, 'last_update_time': 1742540341000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '10', 'collected_count': '6', 'comment_count': '1', 'share_count': '2', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102356/9ba062808a138ad6708a8358f3a20b46/spectrum/1040g0k031f9i741rlu005oakffv0j2coom2j95g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102356/db79ec7d76dc560be20e165fcaefa1f7/spectrum/1040g0k031djiab4j120g5oakffv0j2covsil150!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,线上课', 'last_modify_ts': 1773158162149, 'note_url': 'https://www.xiaohongshu.com/explore/67a5c370000000002901c735?xsec_token=AB4sDXzJmLmDGrcj0EC2Y4ckKRFMtnf8aaqBptHlRN6AY=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB4sDXzJmLmDGrcj0EC2Y4ckKRFMtnf8aaqBptHlRN6AY='}
