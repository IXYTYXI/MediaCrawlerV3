2026-03-10 22:43:09 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '698bf1a60000000015022f3a', 'type': 'normal', 'title': '高途1v1网课！名师从头讲，家长超省心', 'desc': '👀 家有高三备考生、艺考生的家长集合！\n⏰ 高考越来越近，孩子复习却陷入困境\n😭 基础薄弱跟不上，艺考生文化课断层...\n\t\n✅ 别愁！给所有高三家长安利这款高途1v1高考网课，名师从头精讲考点，24h答疑解惑，孩子高效提分！\n\t\n🏆 学情诊断+量身定制\n先给孩子做全面学情诊断，精准摸清基础水平、知识漏洞和提分目标，量身打造专属学习计划，不搞“一刀切”～\n\t\n🏆 名师严选+自由选师\n高途讲师经6轮严选，全员持证上岗，拥有丰富高考带教经验，熟知高考考点规律、命题趋势，不适应授课节奏，随时可换～\n\t\n🏆 科学规划+循序渐进\n依托高途科学教学体系，搭建“基础入门→查漏补缺→专项强化→尖子生拔高→考前押题”完整学习闭环，循序渐进、层层递进。\n\t\n24h全方位服务，选择高途1v1，把专业的事交给专业的人，家长省心、孩子安心！\n\t\n↙️ 点击【立即咨询】即可领取1v1试学名额\n📌 报名要求：仅面向家长\n🛎️ 活动截止时间：2026年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #线上课[话题]# #高考冲刺[话题]# #高考逆袭[话题]# #快速提分[话题]# #学习规划[话题]#', 'video_url': '', 'time': 1770793501000, 'last_update_time': 1770779046000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '3', 'collected_count': '', 'comment_count': '3', 'share_count': '', 'ip_location': '河北', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102243/589cf7b76a441eed366d4bbe1d12e4d0/spectrum/1040g34o31sebeour56205oakffv0j2corcpa4p8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102243/df3df35ad5dc6310add1bc3d9b933b00/spectrum/1040g34o31sebeour562g5oakffv0j2co913c7j8!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,线上课,高考冲刺,高考逆袭,快速提分,学习规划', 'last_modify_ts': 1773153789058, 'note_url': 'https://www.xiaohongshu.com/explore/698bf1a60000000015022f3a?xsec_token=AB0Z9yfQ7GgsduS9DBlYJ1Wv16-daTWDA5MgHOTrDqDxE=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB0Z9yfQ7GgsduS9DBlYJ1Wv16-daTWDA5MgHOTrDqDxE='}
