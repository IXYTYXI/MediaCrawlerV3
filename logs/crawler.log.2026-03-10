2026-03-10 21:46:57 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a91c15000000002303954f', 'type': 'normal', 'title': '这样的效果，真没想到！真是🐮我是服气的', 'desc': '有没有宝妈和我一样， 一开始就疯狂试听各种数理思维课？🧐 前前后后试了快10家… 不是老师讲得太枯燥，就是课程太散没体系… 直到遇到平行线浅奥数理思维！真的香到我了！！\n✨为什么我果断直接报它？✨\n✅【真人直播互动，拒绝走神摸鱼】 不是录播！不是AI念课！\n老师实时连麦+课堂PK+随时点名提问 孩子全程跟着节奏走，专注力直接拉满 想走神？根本不存在的！🙅\n✅【清北名师+分层教学+双师护航】 清北/985名师团队授课，教龄都超8年\n笃学班｜睿学班｜创新班 按孩子基础精准分班，不脱节、不浪费 主讲+辅导老师双师跟踪 作业、状态、进步全同步，家长超安心📲\n✅【从根上练思维，不刷题不背套路】 覆盖小学核心数理逻辑+浅奥方法\n不硬灌答案，只教思路 孩子学会举一反三，题型再变也不慌 思路一通，数学真的越学越顺！🤩\n✅【价格真的良心，性价比拉满】 一年系统学，一周一次2节课课 算下来低至15元/课时，比线下便宜太多，效果还更稳 普通家庭也能轻松给娃上好课！\n如果你也在找： ✔️不枯燥 ✔️真互动 ✔️体系完整 ✔️价格实在 的数学思维课\n真心建议你试试平行线！\n👇点击【立即咨询】 领专属测评+学习诊断报告 帮孩子精准匹配最适合的班型💪\n#数学思维[话题]#   #小学奥数[话题]#   #思维训练[话题]#   #线上课程[话题]#   #平行线教育[话题]#', 'video_url': '', 'time': 1772690453000, 'last_update_time': 1772690454000, 'user_id': '642ba9780000000012011a80', 'nickname': '平行线名师大课堂', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/f0238b56-4bdd-3597-adf3-db36cfdcf315', 'liked_count': '2', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102146/c04e0e42efa61647d6f8f33716727ae8/spectrum/1040g0k031tao02unme005p1bl5s4i6k05kl2pl8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102146/c434bbdb6db9b359077f2729800d29e6/spectrum/1040g0k031taqp2b7la005p1bl5s4i6k04g1td70!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102146/c0e25d6b82077407ddd373f68867cd9b/spectrum/1040g0k031taqp2b7la0g5p1bl5s4i6k0pq7tab0!nd_dft_wlteh_webp_3', 'tag_list': '数学思维,小学奥数,思维训练,线上课程,平行线教育', 'last_modify_ts': 1773150417878, 'note_url': 'https://www.xiaohongshu.com/explore/69a91c15000000002303954f?xsec_token=ABkXiiT8OoWfy0U4yQ6YI3tvAEjvaiaVQmgs1fiddtb-0=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABkXiiT8OoWfy0U4yQ6YI3tvAEjvaiaVQmgs1fiddtb-0='}
