2026-03-10 20:01:03 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67231d430000000019015c44', 'type': 'normal', 'title': '家长必看🉑用这个方法，孩子数学秒开窍‼', 'desc': '辅导孩子数学，老母亲的心声谁懂🥹简单的加减乘除要算半天，看到数字就头疼，相同的题型反复出错，完全不会举一反三。\n-\n想让孩子数学早日开窍不掉队‼建议家长们给娃试试Spark Math新加坡数学!一招让孩子数学开窍！培养好了数学思维，数学想不好都难呢！\n-\nSpark Math新加坡数学专专为5-12岁打造小班数学直播课程；基于新加坡小学数学教材研发；覆盖课内重难点，兼顾竞赛需求；激发学习兴趣，锻炼数学思维能力。\n-\n✅小班直播授课，关注每一个孩子的成长\n✅双语灵活选择，满足不同需求\n✅闭环学习方式，课前、课后多种练习方式，巩固知识\n✅CPA 教学法，提升思维能力\n✅联合专业老师，教学质量有保障\n✅个性化教学，循序渐进培养综合实力\n-\n现在咨询立即领取Spark Math新加坡数学试听课，快来给孩子领取吧~~\n#新加坡数学[话题]#\xa0\xa0#新加坡数学网课[话题]#\xa0\xa0#新加坡数学建模[话题]#\xa0\xa0#新加坡数学补习[话题]#\xa0\xa0#新加坡数学竞赛[话题]#\xa0\xa0#新加坡数学应用题[话题]#\xa0\xa0#新加坡数学思维[话题]#\xa0\xa0#新加坡数学课程[话题]#\xa0\xa0#新加坡数学老师[话题]#\xa0\xa0#新加坡数学课[话题]#\xa0\xa0#新加坡数学教材[话题]#\xa0\xa0#新加坡数学英文[话题]#\xa0\xa0#新加坡数学cpa[话题]#\xa0\xa0#sparkmath新加坡数学[话题]#\xa0\xa0#小学数学[话题]#\xa0\xa0#小学数学怎么学[话题]#', 'video_url': '', 'time': 1730365321000, 'last_update_time': 1730354500000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '1', 'collected_count': '', 'comment_count': '1', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102001/5af8d5146c934cb104661e5096a029e0/spectrum/1040g34o319jvfjq7mm0g5olhcu8lbcmapvkv9og!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102001/2accc1b5c7abfd5bbcc0c97b889b909a/spectrum/1040g0k0319jvff886m005olhcu8lbcma3234v8g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102001/5ab024f483826b02c7d0d535ce13ae0d/spectrum/1040g34o319jvfh7s6u005olhcu8lbcma9c5tskg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102001/9092b29bac158208629774aff995bfeb/spectrum/1040g0k0319jvfcsums005olhcu8lbcma5ojpacg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102001/71aad849e410804866ac503a612324d2/spectrum/1040g34o319jvgapqmu0g5olhcu8lbcmae40r8t8!nd_dft_wlteh_webp_3',