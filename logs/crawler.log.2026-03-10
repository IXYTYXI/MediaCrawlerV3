2026-03-10 23:42:06 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68106a2d000000000d014c1f', 'type': 'normal', 'title': '被狠狠折服👍高途名师专题课真的牛', 'desc': '“自己越学越差，孩子都快没信心了…”\n👉 计算总出错？ 基础不牢，一考试就崩！\n👉 阅读写作不会？ 没思路，只能硬着头皮写！\n👉 英语听不懂？ 错题反复错，越学越焦虑！\n\t\n🔥 高途1对1，1人1班名师专题ke已上线\n📍1v1全程陪伴式\n辅导全程跟进学习进度，及时答疑，解决学习中的问题，不留知识死角。\n📍1v1定制学习方案\n根据每个🧑\u200d🎓的学习情况，量身定制个性化的学习方案，因材施教，提升学习效率。\n📍1v1系统化教学\n学习内容设计科学系统，从基础到高阶，逐步深入，帮助全面掌握各科知识点。\n📍1v1硬核师资\n高途经过6轮严选师资，都是名校毕业的学霸，持证上岗，多年教龄经验丰富，专业知识深厚。\n\t\n跟着高途1对1拒绝无效学习❌轻松掌握学习重点\n现在点击左下角【立即咨询】抢占专属试听名额\n🉐 一对一个性化调研+专属分析报告+精细化服务\n*本课程为家庭教育规划课，内容仅面向家长\n⏰ 截止时间：即日起至12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#高中[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff', 'video_url': '', 'time': 1745989020000, 'last_update_time': 1745906222000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '', 'comment_count': '', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102342/3f2078cd2d6e4042eb562762be99e711/spectrum/1040g0k031grn60743a005oakffv0j2coobnfa3g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102342/17004b64dffc5a827e3561c0b115303f/spectrum/1040g0k031grn60743a0g5oakffv0j2cov728e28!nd_dft_wlteh_webp_3', 'tag_list': '高途,高中,一对一,网课', 'last_modify_ts': 1773157326633, 'note_url': 'https://www.xiaohongshu.com/explore/68106a2d000000000d014c1f?xsec_token=ABLFa6ILQJSZYTbxife49lnVLLh6KNy-1hbffPOVePs_c=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABLFa6ILQJSZYTbxife49lnVLLh6KNy-1hbffPOVePs_c='}
