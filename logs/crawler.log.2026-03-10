2026-03-10 22:58:21 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69251950000000001f00c3d7', 'type': 'normal', 'title': '扒遍全网才选定的高中1v1❗️效率真高', 'desc': '给高中生选网课真的快挑花眼！扒了几十篇测评、对比N家机构\n✅ 最终选了高途1v1—— 价格确实比普通网课高一点\n但体验下来才懂：贵有贵的道理，孩子能学出成ji又省心比啥都强！\n\t\n👉 为啥敢选 “小贵” 的高途？这几点直接戳中家长心\n▫️ 真名师不掺水，不满意就换\n严选双一流学霸老师，还得全部持证上岗，更贴心的是能挑风格，孩子不合拍、听不懂能换老师；\n\t\n▫️ 1v1全流程盯到底，不搞走过场\n从一开始就精准定位：先检测学科薄弱处，再针对性定制提芬规划，课后还有24小时答疑，一套完整方案闭环～\n\t\n👉 贵价背后的 “负责”，家长看得到摸得着\n▫️ 不用自己盯学习：主讲专属团队24小时兜底，作业批注，随时答疑解惑；\n▫️ 进度透明不踩坑：从检测薄弱点到定制计划，每一步都有记录；\n▫️ 出芬有保障：全程陪跑，及时调整方案，不会让孩子 “学了白学”；\n\t\n选高途，每一分钱都花在 “帮孩子提芬、帮家长省心” 上，真心推荐给想找靠谱网课的家长～\n↙️ 点击左下方【立即咨询】领取1v1试学名额～\n🔍 报名要求：32岁以上家长\n⏰ 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #高效学习[话题]# #学习规划[话题]# #高途[话题]# #学习更高效[话题]# #线上课[话题]#', 'video_url': '', 'time': 1764038992000, 'last_update_time': 1764038992000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102258/da59dad2e999e43cb6ca90e1f7dc6e91/spectrum/1040g34o31p9thhr12a305oakffv0j2co24apgd8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102258/01c82f0e2a0864844420eb2d6adb5c8b/spectrum/1040g34o31p9thhr12a3g5oakffv0j2co4qic538!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102258/14096dd02c5ec480b08ea891d9cd5a28/spectrum/1040g34o31p9thhr12a405oakffv0j2cobph7vso!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,高效学习,学习规划,高途,学习更高效,线上课', 'last_modify_ts': 1773154701476, 'note_url': 'https://www.xiaohongshu.com/explore/69251950000000001f00c3d7?xsec_token=ABCno0QiLioCS8fy-YMr1sfgib5eBwG17Eya7w6tIsEg4=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABCno0QiLioCS8fy-YMr1sfgib5eBwG17Eya7w6tIsEg4='}
