2026-03-10 23:59:33 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67760a9f000000000b021cf3', 'type': 'normal', 'title': '什么样的孩子需要一对一的辅导❓', 'desc': '你家孩子是不是本身基础就差❓\n记住这些弱项就像雪球一样，学校学的越多，雪球只会越滚越大❗️\n-\n你家孩子是不是考试只会生搬硬套❓\n没有学习思维，没有解题思路，只会套公式、套模版❗️\n-\n你家孩子是不是粗心大意❓\n明明很聪明，题都会做，没有好的学习习惯，粗心大意丢了很多分❗️\n-\n你家孩子是不是学习效率低下❓\n没有学习方法，畏难心理，导致跟不上❗️\n-\n⭕️ 孩子出现这些表现，就需要一对一老师的正确引导，才能成功逆袭，少走弯路！\n有想体验一对一课程的家长\n点击左下角【立即咨询】即可预约体验\n报名要求：32岁以上家长\n截止时间：即日起-2025年5月31日\n\ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#高途[话题]#\ufeff \ufeff#家长必读孩子教育[话题]#\ufeff', 'video_url': '', 'time': 1735806780000, 'last_update_time': 1735789216000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '2', 'collected_count': '4', 'comment_count': '', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102359/8eec5b0964c1a9cb3f3274fa691bb80c/spectrum/1040g0k031c4v05r8g8005oakffv0j2co7qjsivg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102359/4b710b1cb59b020e6c75ddc0585ef692/spectrum/1040g0k031c4v05r8g80g5oakffv0j2colgjfnq8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102359/cc1ecf7a210aaa6ed24886a399de7d7e/spectrum/1040g0k031c4v05r8g8105oakffv0j2coebierhg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102359/1848d2ce1a41bb5c8ce66236c50b18fd/spectrum/1040g0k031c4v05r8g81g5oakffv0j2coudov3jo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102359/160abb0075cfe4ee3807bb263d694d9f/spectrum/1040g0k031c4v05r8g8205oakffv0j2co8tnk330!nd_dft_wlteh_webp_3', 'tag_list': '一对一,网课,高途,家长必读孩子教育', 'last_modify_ts': 1773158373247, 'note_url': 'https://www.xiaohongshu.com/explore/67760a9f000000000b021cf3?xsec_token=ABcbVNLlsM-ZSZb4ks3AmkNPXPaV1j6g1ZZ87WlmEp1Qc=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABcbVNLlsM-ZSZb4ks3AmkNPXPaV1j6g1ZZ87WlmEp1Qc='}
