2026-03-10 22:49:31 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '695f50f0000000000a03edcf', 'type': 'normal', 'title': '寒假不用跑机构！1人1班高中直播课太香了', 'desc': '家有高中生的家长集合！\n一想到寒假要天天跑机构，就头大到不行？\n路上折腾、时间固定，孩子累家长也累！\n别愁了！高途寒假1人1班直播来救场，在家就能学\n时间灵活任选，名师全程带学还负责到出分，彻底解放家长～\n👉 1人1班专属带学！学习效率拉满\n💯 老师全程盯学，注意力高度集中，每次沉浸式授课\n💯 针对薄弱点精准讲解，还能实时互动答疑\n💯 听不懂当场重讲，比大班效率高太多！\n\t\n👉 时间灵活到飞起！完美适配娃的作息\n💯 具体时间完全可以灵活选，不用为了赶课打乱作息\n💯 不用接送、不用等电梯，在家打开设备就能上课\n💯 省下的时间还能让娃多休息会儿，家长也能安心\n\t\n👉 严选持证名师！不满意随时换\n💯 持证上岗还得经过多轮严格筛选才能入职，教学功底扎实\n💯 风格多样，有幽默风趣的、有严谨细致的\n💯 听着不适应不满意随时换，不用委屈将就\n\t\n👉 7*24h答疑盯学！负责到出分超安心\n💯 深夜刷题遇到卡壳，随时提问都能响应\n💯 全程盯学，催作业、查复习、反馈学习进度\n\t\n一直负责到出分，全程兜底不撒手，家长彻底不用追着问！\n赶紧点击【立即咨询】获取1v1试听名额～\n📝 报名要求：仅面向32岁以上家长\n📆 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #线上课[话题]# #网课[话题]# #学习规划[话题]# #寒假学习[话题]# #高中学习方法[话题]#', 'video_url': '', 'time': 1767863341000, 'last_update_time': 1767854321000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '3', 'collected_count': '', 'comment_count': '3', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102249/92a5e475be5211eef620ec65ae5cce06/spectrum/1040g0k031r2or9s46u005oakffv0j2co6i54v30!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,线上课,网课,学习规划,寒假学习,高中学习方法', 'last_modify_ts': 1773154171839, 'note_url': 'https://www.xiaohongshu.com/explore/695f50f0000000000a03edcf?xsec_token=AB_e4TLEe2FvTsCISOpzib8RpEoHRIUVbgqg6FxmYyUBk=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB_e4TLEe2FvTsCISOpzib8RpEoHRIUVbgqg6FxmYyUBk='}
