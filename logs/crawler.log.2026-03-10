2026-03-10 22:30:14 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69aab0ff0000000015022d79', 'type': 'normal', 'title': '高中化学在家1对1🙌也能轻松冲90+', 'desc': '高中化学怎么补都上不去？\n方程式背了又忘，实验题总踩不到得分点，旧的内容没学透新的章节又开始了…🥲\n为了补课来回跑机构，路上花的时间比学的时间还久，却不见效果😞\n别折腾了！其实每天只需要抽出1小时，跟着掌门一对一在家学，化学考试也能冲刺90+！\n🎯 掌门一对一，科学规划学程，让学的每一步都扎实可靠\n🔆 精准揪漏洞，学习不瞎忙\n入学测定位弱点（方程式 / 反应原理 / 实验题误区），对着漏洞补，不瞎忙\n🔆 清北名师把抽象知识讲 “活”\n名师巧用 “社交比化学键、排队比平衡” 讲透难点，枯燥知识秒变有趣\n🔆 定制学习计划，稳扎稳打\n稳基础、破难点、练应用，学得扎实不赶趟\n🔆 1 对 1 盯学，问题不隔夜\n专属监督群 + 逐题批改，漏洞当天补，家长实时看进度！\n不用跑线下班，在家就能学，老师 1 对 1 带着捋顺所有知识点，化学突然开窍真的超爽！\n-\n🔥现在点击下方【立即咨询】0 元 get 1 对 1 体验课！\n📢报名要求：32 岁以上家长\n⏰截止时间：即日起 - 2026 年 12 月 31 日\n#掌门[话题]#  #掌门一对一[话题]#  #学习规划[话题]#  #家长必看[话题]#  #高三[话题]#  #高二[话题]#  #高一[话题]#  #高中化学[话题]#  #清北名师[话题]#  #化学差生[话题]#', 'video_url': '', 'time': 1772794111000, 'last_update_time': 1772794112000, 'user_id': '649a8e5f000000001001c410', 'nickname': '掌门1对1知识分享', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/65d83c913237730001928a26.jpg', 'liked_count': '1', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '上海', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102230/d664e2b1c95cb396d05c6c33e234a25d/spectrum/1040g34o31tcca8es58105p4qhpfk3h0g9s0lsdo!nd_dft_wlteh_webp_3', 'tag_list': '掌门,掌门一对一,学习规划,家长必看,高三,高二,高一,高中化学,清北名师,化学差生', 'last_modify_ts': 1773153014076, 'note_url': 'https://www.xiaohongshu.com/explore/69aab0ff0000000015022d79?xsec_token=ABEY8sU4xINMp3qbyKnY2hi4Fj_RcKw3K9bJ0ZY8cAxjE=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABEY8sU4xINMp3qbyKnY2hi4Fj_RcKw3K9bJ0ZY8cAxjE='}
