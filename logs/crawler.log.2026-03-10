2026-03-10 22:59:12 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '691d1b5c000000001e0391cd', 'type': 'normal', 'title': '26高考网课选高途1v1！陪跑提芬又省心', 'desc': '26 届高考倒计时越来越近，孩子复习总找不到方向：\n全科进度乱、薄弱科拖后腿、刷题没效果…\n强烈推荐高途26高考1v1网课 —— 从定制提芬方案到全周期陪跑，连老师都能挑，全程负责，备考终于不用慌！\n\t\n👉 26 高考1v1定制！精准提芬不盲目\n✔️ 精准定位：全科 / 单科检测，直击薄弱点，告别无效刷题；\n✔️ 定制方案：依检测结果分层教学，直播内容与课后练习精准匹配；\n✔️ 名师护航：持证名师紧扣考纲，直击热点命题，学习效率翻倍；\n\t\n👉 全周期复习不间断！陪跑到出芬\n✔️ 学练结合：直播课知识点精讲后，立即辅导练习强化记忆；\n✔️ 动态复盘：周测试、月模考，用数据定位知识盲区；\n✔️ 全程保障：从备考到出芬全程服务，告别 “结课即止”；\n\t\n高途1v1网课用定制方案、全周期陪跑、专项突破助力冲刺！\n↙️ 感兴趣的家长点击左下方【立即咨询】预约1v1试学\n🔍 报名要求：32岁以上家长\n⏰ 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #高考提分[话题]# #高中学习方法[话题]# #一轮复习[话题]# #网课[话题]# #高考逆袭[话题]#', 'video_url': '', 'time': 1763597460000, 'last_update_time': 1763515228000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '', 'comment_count': '1', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102259/327272809af599741e464ce5b1f3d59c/spectrum/1040g0k031p23pq6ii4005oakffv0j2cocml7ps0!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,高考提分,高中学习方法,一轮复习,网课,高考逆袭', 'last_modify_ts': 1773154752611, 'note_url': 'https://www.xiaohongshu.com/explore/691d1b5c000000001e0391cd?xsec_token=ABDC86EEMWRgxe46qArkIGHzi8P7J6U_N7MdJ2iFEiNq8=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABDC86EEMWRgxe46qArkIGHzi8P7J6U_N7MdJ2iFEiNq8='}
