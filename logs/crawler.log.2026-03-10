2026-03-10 23:26:04 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6866251e00000000170323b6', 'type': 'normal', 'title': '高中党注意！高途1v1贵但督学真有效', 'desc': '⚠️ 家有高中生的都懂：好的网课就像 “学习加速器”，花钱都在刀刃上！\n👉 高途高中1v1暑假班就是这挂 —— 督学比班主任还严，24小时随时答疑，作业批改连细节都不放过，难怪家长说：“贵点但能出分，值了！”\n\t\n✅ “私人定制” 学习方案\n入学先做全科漏洞扫描：按 “必考点→易混点→压轴题” 排序攻克，拒绝无效刷题！\n\t\n✅ “全程陪伴” 式督学\n▫️ 课前提醒、课后批改作业、督促每日学习计划、24小时答疑！\n▫️ 上课走神立刻提醒，专治各种拖延症！\n\t\n✅ “双师天团” 随时待命\n▫️ 主讲老师：双一流毕业+多年高三经验+大招解题方法；\n▫️ 辅导老师：作业批注 + 错题反复推送，半夜刷题卡壳及时答疑！\n\t\n还有学习报告 + 阶段家长会，孩子进步多少、哪科还需补，比自己盯更清楚！\n↙️ 赶紧点击左下角【立即咨询】领1v1试听吧～\n⏰ 活动时间：即日起-25年12月31日\n🙋 报名要求：仅面向32岁以上家长\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#暑假[话题]#\ufeff \ufeff#高中[话题]#\ufeff \ufeff#高一[话题]#\ufeff \ufeff#高二[话题]#\ufeff \ufeff#高三[话题]#\ufeff', 'video_url': '', 'time': 1751589420000, 'last_update_time': 1751524639000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102326/be81a4dcb84f9289e7e35f553cfb8e2f/spectrum/1040g34o31jfe7om23i005oakffv0j2co5eq6h70!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102326/88e9d25275f711d628cee37ea843b659/spectrum/1040g34o31jfe7om23i0g5oakffv0j2cos8iujrg!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,暑假,高中,高一,高二,高三', 'last_modify_ts': 1773156364854, 'note_url': 'https://www.xiaohongshu.com/explore/6866251e00000000170323b6?xsec_token=ABqipxp4a6oPWAk9br2XGY0lZTpdceCEMT7LeeiQizjEQ=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABqipxp4a6oPWAk9br2XGY0lZTpdceCEMT7LeeiQizjEQ='}
