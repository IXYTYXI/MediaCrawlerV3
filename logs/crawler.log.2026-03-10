2026-03-10 23:12:47 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68b6974c000000001b03fee0', 'type': 'normal', 'title': '有想体验高途一对一的家长吗？', 'desc': '🥹 数理是不是怕跟不上？\n😭 大班ke没人盯、普通ke学不透，真的急人！\n✅ 试试1对1直播盯学，🧑\u200d🏫全程跟着学、盯着练，想体验的千万别错过～\n\t\n👉 【1对1直播盯学，拔高+盯学双管齐下】\n▫️ 1对1直播教学，不是录播！会随时提问互动，走神了会及时提醒，还会让当场练习，错了立刻纠正；\n▫️ 定制拔高计划，攻难点：先做学情测评，找出薄弱项再定制拔高方案——不做无用功；\n▫️ 督预习：固定预习范围，记录问题与班班沟通\n▫️ 督听ke：根据上课计划督促到课，治疗拖延症！\n▫️ 督作业：课后作业精批，巩固所学才能记得牢固！\n\t\n想体验的家长点击【立即咨询】获取专属1v1体验名额～\n🙋 报名要求：仅面向32岁以上家长\n⏰ 活动时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #数理思维[话题]# #开窍[话题]# #家长必读[话题]# #线上学习[话题]#', 'video_url': '', 'time': 1756796748000, 'last_update_time': 1758333515000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '5', 'collected_count': '4', 'comment_count': '2', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102312/4604472732a527920a18d1400cdb9cb2/spectrum/1040g0k031lu060ptkq005oakffv0j2cob421cog!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102312/e83d9ea20085c61a4a4ec4eaf7639089/spectrum/1040g0k031lu060ptkq0g5oakffv0j2co32l0910!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102312/c608bccd9c411c5c8fd5060d2c0fccd5/spectrum/1040g0k031lu060ptkq105oakffv0j2copnq3lp8!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,数理思维,开窍,家长必读,线上学习', 'last_modify_ts': 1773155567844, 'note_url': 'https://www.xiaohongshu.com/explore/68b6974c000000001b03fee0?xsec_token=AB4CxoWUcxP3S5svdQ68j2dnpz-lF1Os8TB50eYqMi1DY=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB4CxoWUcxP3S5svdQ68j2dnpz-lF1Os8TB50eYqMi1DY='}
