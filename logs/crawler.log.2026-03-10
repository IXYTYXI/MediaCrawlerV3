2026-03-10 19:43:30 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69ae91530000000015032098', 'type': 'normal', 'title': '新加坡数学课试听了，谈谈我的感受✨', 'desc': '家有小学生，数学真的愁坏我了😭\n以前逼他刷题，坐那半小时一道题不会，越讲越抵触，我也跟着上火，总怕他跟不上\n偶然刷到SparkMath，抱着试试的心态领了试听，没想到娃居然不抗拒！\n最惊喜的是它家CPA教学法，不是死记公式，而是用实物、动画一步步引导，我家娃跟着老师思路走，居然能自己说出解题逻辑，以前绕不过来的题，现在一下就通了\n而且是≤8人的小班\n老师真的能顾到每个孩子，娃做题的每一步，老师都能实时看到，哪里卡壳当场就指出来，不用等下课再问\n还有全程伴学\n晚上娃做课后题有疑问，发消息老师很快就回复了，不用攒到第二天，也不用我这个数学渣瞎辅导\n最最意外的是，课堂有小游戏，娃上完一节课还念叨着下次什么时候上，再也不用我催着坐书桌前\n不是广，是真的亲测有用，娃现在做题不磨蹭了，思路也清晰了，老母亲终于能松口气\n家有数学抵触、没思路的娃，真的可以试试这个试听\n-👇点击【立即咨询】，限时领0元试听大礼包\n1️⃣1节新加坡数学直播课\n2️⃣1v1定制学习规划\n3️⃣价值3422元228课时学习大礼包\n⏰活动时间：即日起-2027年12月31日\n*本内容为教育规划，面向家长群体\n#sparkmath[话题]# #新加坡数学[话题]# #sparkmath新加坡数学[话题]# #数学思维[话题]# #小学数学[话题]# #数学启蒙[话题]# #CPA教学法[话题]##数学思维[话题]# #孩子教育[话题]# #学习规划[话题]#', 'video_url': '', 'time': 1773048147000, 'last_update_time': 1773048147000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '1', 'collected_count': '1', 'comment_count': '', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603101943/fc192d8b73627619d762bc216b76c429/spectrum/1040g0k031tg5di776e0g5olhcu8lbcmaobamrrg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101943/94c46d4b48a9b44869da049145b29f27/spectrum/1040g0k031tg5di776e105olhcu8lbcmai4h09ig!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101943/cb2ab3a0c60f13d109831f89fbb31342/spectrum/1040g0k031tg5di776e1g5olhcu8lbcmanqfjqp0!nd_dft_wlteh_webp_3', 'tag_list': 'sparkmath,新加坡数学,sparkmath新加坡数学,数学思维,小学数学,数学启蒙,CPA教学法,数学思维,孩子教育,学习规划', 'last_modify_ts': 1773143010208, 'note_url': 'https://www.xiaohongshu.com/explore/69ae91530000000015032098?xsec_token=AB-w_qzoOURA9QpHihjgrBIBUu3PMVHKLZ3cic3bof-6s=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB-w_qzoOURA9QpHihjgrBIBUu3PMVHKLZ3cic3bof-6s='}
