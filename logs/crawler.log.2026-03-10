2026-03-10 22:56:57 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69300ced000000001e02a2a3', 'type': 'normal', 'title': '期末冲刺选高途1v1！全程陪跑超省心', 'desc': '😭 期末倒计时敲响，孩子对着数学函数、物理电磁题直犯愁，成绩总在及格线挣扎？\n😭 想逆袭却无从下手，大班课听得云里雾里，复习全是无用功？\n👍 高途高中1v1期末冲刺课来救场！\n学前精准测评定位薄弱点，量身定制学习计划\n名师全程1对1辅导，家长不操心，孩子轻松逆袭！\n\t\n✅ 高途1v1的实力早有口碑，这些优势期末冲刺用得上：\n📍 首先是严选名师兜底，多轮筛选的持证老师，不仅懂高中各学科考点，更摸透期末考纲重点；\n📍 其次是1v1检测基础，针对性规划复习内容，拒绝盲目刷题；\n📍 还有全程督学+24h 答疑，老师会盯紧学习全流程，课前提醒预习、课中互动防走神、课后随时答疑；\n📍 而且高途1v1还有个贴心点：不满意可换老师，不怕孩子跟老师 “不对频”；\n\t\n课程还能先试听再报正价课，家长和孩子都能先感受教学节奏，放心了再决定～\n感兴趣的家长赶紧点击【立即咨询】预约1v1试学吧～\n报名要求：仅面向32岁以上家长\n活动时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #课程辅导[话题]# #学霸养成[话题]# #复习方法[话题]# #弯道超车[话题]# #高效学习[话题]# #期末逆袭[话题]#', 'video_url': '', 'time': 1764810061000, 'last_update_time': 1764756717000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '2', 'collected_count': '', 'comment_count': '1', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102256/4d14ca661c401616bc367e1ddfbb8238/spectrum/1040g34o31pkjp72njs105oakffv0j2cocokv5do!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,课程辅导,学霸养成,复习方法,弯道超车,高效学习,期末逆袭', 'last_modify_ts': 1773154617740, 'note_url': 'https://www.xiaohongshu.com/explore/69300ced000000001e02a2a3?xsec_token=ABccRRpIQ2vzxkw55WdyG1-EftZqdf8HrtmZEi1azvpyU=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABccRRpIQ2vzxkw55WdyG1-EftZqdf8HrtmZEi1azvpyU='}
