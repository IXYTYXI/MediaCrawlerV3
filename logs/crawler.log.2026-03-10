2026-03-10 23:49:20 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67ede43d000000001c006999', 'type': 'normal', 'title': '真香警告🔥90%的学霸家长都选了一对一', 'desc': '各位家长们是不是每天都在为🧑\u200d🎓的学习操碎了心？\n试过各种辅导班，效果却总是不尽如人意？\n❌线下补习三大痛：\n1️⃣ 堵车两小时，上课45分钟\n2️⃣ 课堂走神没人管，回家作业不会做\n3️⃣ 花大价钱却看不到进步\n💡现在聪明家长都在用：\n【高途一对一线上名师课】\n-\n✅ 个性化教学：1v1定制课程，针对性强\n✅ 灵活调整：进度、难度和教学方式可随时调整\n✅ 专注度高：全程与老师互动，减少分心\n✅ 时间灵活：课程时间可协商，3年免费回放\n-\n【高途一对一专属优势】\n1️⃣ 多轮筛选、360°综合考核评价，最终只有4%的老师获得授课资格，学习效率没得说；\n2️⃣ 1V1直播教学模式，高度互动，传授解题小窍门，告别对着题目无助又无力；\n3️⃣ 科学系统安排课后作业、精批，专属班班随时答疑解惑，真真正正学懂，然后触类旁通。\n-\n感兴趣的家长现在点击【立即咨询】抢占课程试听名额\n🉐 一对一诊断+学习计划+专属金牌班班\n💬 报名要求：仅面向32岁以上家长\n活动时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff', 'video_url': '', 'time': 1743668881000, 'last_update_time': 1743643709000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102349/4f02e875f1d6736431e94bdcff34e503/spectrum/1040g34o31fq0an1uni205oakffv0j2coqo1nv98!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102349/50f6a33758e76f75f89d1023c9490c4a/spectrum/1040g34o31fq0an1uni2g5oakffv0j2coad5r4bg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102349/c0d1a2fce66c0d8a16af5b6ee6abc6af/spectrum/1040g34o31fq0an1uni305oakffv0j2cols772co!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课', 'last_modify_ts': 1773157760012, 'note_url': 'https://www.xiaohongshu.com/explore/67ede43d000000001c006999?xsec_token=AB-mQV5QrjCKDREDtuq6wbSshdFZZF6Pw8WfDYPFJmnqU=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB-mQV5QrjCKDREDtuq6wbSshdFZZF6Pw8WfDYPFJmnqU='}
