2026-03-10 23:50:56 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67e7db1d000000000b02ee2b', 'type': 'normal', 'title': '高途1v1辅导，闭环式学习体系👍', 'desc': '各位家长们，你家🧑\u200d🎓是不是有这些问题👇\n🤷 成绩不上不下的，心里急得不行\n🤷 课后做作业，一知半解\n🤷 各种办法都试过了，就是没啥效果\n-\n别灰心，高途1v1辅导来帮忙👇\n✅【专属分析诊断，找到问题】\n学前先做检测，各个学科的重点知识、常考题型都包含在内，从基础知识掌握得咋样到解题思路全方位评估一遍；\n.\n✅【多轮严选名师，教学实力有保障】\n高途多轮严选名校毕业的老师，都是持证上岗，专业知识非常扎实，手把手拆解重难点；\n.\n✅【阶段测试，巩固学习成果】\n定期学情检测，总结当下的掌握程度，及时查漏补缺，针对性解决当堂薄弱点，课后双重跟进；\n-\n感兴趣的家长点击左下角【立即咨询】定制专属培优课程\n🉐1对1检测+学习方案+学习资料\n报名对象：仅面向32岁以上家长\n活动时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff\xa0\xa0\ufeff#一对一[话题]#\ufeff\xa0\xa0\ufeff#闭环学习[话题]#\ufeff', 'video_url': '', 'time': 1743255062000, 'last_update_time': 1743495265000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102350/34f29eef534a75f134852af7bab12851/spectrum/1040g0k031fm4ftbkgc005oakffv0j2coqp9013o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102350/a9d06eb824c4ffa2bfc5dd43fd8acea7/spectrum/1040g0k031fm4ftbl0c005oakffv0j2co5s65iq0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102350/885260e89e10fb41220533c16e7fa25d/spectrum/1040g0k031fm4ftbl0c0g5oakffv0j2copahnvt8!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,闭环学习', 'last_modify_ts': 1773157856770, 'note_url': 'https://www.xiaohongshu.com/explore/67e7db1d000000000b02ee2b?xsec_token=AB2HzCtE9kOASgLwGM3rGQsoeBeHD-sSKspki6M1s11Ls=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB2HzCtE9kOASgLwGM3rGQsoeBeHD-sSKspki6M1s11Ls='}
