2026-03-10 20:02:23 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6719f13500000000210067b9', 'type': 'normal', 'title': '被问爆了的在线数学课，真的超级牛❗❗', 'desc': '真的要哭了🆘终于找到了这个神仙新加坡数学课\n平时让娃去上线下班👩\u200d🏫，不仅贵，而且学生数量众多老师根本照顾不过来\n有时接送连上课一上午就过去了，耗时又费力🧑🏫\n这个Spark Math新加坡数学线上直播课真的超省心\n在家就能学，而且4-8人小班制，针对性更强\n孩子想不提升都难❗❗❗\n-\n💞课程体系：K2--P6七个阶段\n💞课程内容：教学采用主流CPA法，以建模为中心，锻炼娃的计算、几何、逻辑多维能力\n💞班型：中文/英文/双语，直播课\n💞师资：10-20年深耕教育行业专家\n💞价格：每节课仅100+，超高性价比放心选择\n-\n现在点击图片下方⬇ 【立即领取】就可以免费试听👏\n⏰ 活动时间：即日起—2025年12月31日\n*课程面向海外人群（18岁以上）\n#新加坡数学[话题]#\xa0\xa0#新加坡数学网课[话题]#\xa0\xa0#新加坡数学建模[话题]#\xa0\xa0#新加坡数学补习[话题]#\xa0\xa0#新加坡数学竞赛[话题]#\xa0\xa0#新加坡数学应用题[话题]#\xa0\xa0#新加坡数学思维[话题]#\xa0\xa0#新加坡数学课程[话题]#\xa0\xa0#新加坡数学老师[话题]#\xa0\xa0#新加坡数学课[话题]#\xa0\xa0#新加坡数学教材[话题]#\xa0\xa0#新加坡数学英文[话题]#\xa0\xa0#新加坡数学cpa[话题]#\xa0\xa0#sparkmath新加坡数学[话题]#\xa0\xa0#小学数学[话题]#\xa0\xa0#数学思维[话题]#\xa0\xa0#在线数学课[话题]#', 'video_url': '', 'time': 1729760582000, 'last_update_time': 1729753398000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '1', 'collected_count': '', 'comment_count': '1', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102002/207be80608075c70250d9a3835e33ca5/spectrum/1040g0k0319b0r81b5o705olhcu8lbcmarsaro9g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102002/d7799853b796f8d7589994af960ef444/spectrum/1040g0k0319b0rh7l5o005olhcu8lbcmalgml59o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102002/8096d4c2dac4fc82f791c7e3bed91898/spectrum/1040g0k0319b0rkfslo005olhcu8lbcma3g5en2o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102002/a78e04f461ada44c1803d7e1bbb5e2c8/spectrum/1040g0k0319b0rm4h5o005olhcu8lbcmagrmasuo!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学,新加坡数学网课,新加坡数学建模,新加坡数学补习,新加坡数学竞赛,新加坡数学应用题,新加坡数学思维,新加坡数学课程,新加坡数学老师,新加坡数学课,新加坡数学教材,新加坡数学英文,新加坡数学cpa,sparkmath新加坡数学,小学数学,数学思维,在线数学课', 'last_m