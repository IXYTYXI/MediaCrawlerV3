2026-03-10 23:16:50 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '689dc7ab000000001d01b340', 'type': 'normal', 'title': '高三复习1v1从头带学！托管式负责到出分', 'desc': '🤷 高三复习刚开始就慌了阵脚？课本知识点太多理不清脉络\n😭 刷题刷到崩溃却没摸到提分规律… 别让混乱的复习节奏拖垮冲刺状态！\n✅ 高三复习1v1网课来救场，从头带学帮你理清思路，托管式计划 + 双师监督 + 因材施教，从一轮基础到三轮冲刺全程托底，让高三复习每一步都走得扎实！\n\t\n👉 每日托管式计划，复习节奏不跑偏\n不用再纠结 “今天该学什么”，精细化计划帮你把时间用在刀刃上，计划跟着进度变，始终贴合需求；\n\t\n👉 主讲 + 班主任双护航，偷懒走神不存在\n主讲根据你的基础从头讲起，专属班主任盯学到底，随时答疑不攒问题，当天问题当天清；\n👉 讲练测闭环学，效率看得见\n讲练结合即时巩固，阶段测试 + 作业精批，阶段测试随时调整学习计划，每一步都有人管，学得特别踏实！\n\t\n让1v1从头带学帮你理清复习思路，托管式计划 + 双师护航，高三冲刺少走弯路～\n🙋 报名要求：仅面向32岁以上家长\n⏰ 活动时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#高中[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#高三复习[话题]#\ufeff \ufeff#复习[话题]#\ufeff \ufeff#学习日常[话题]#\ufeff \ufeff#一轮复习[话题]#\ufeff', 'video_url': '', 'time': 1755170731000, 'last_update_time': 1755170731000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '4', 'collected_count': '1', 'comment_count': '', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102316/83a5e67bb06fcb266face42e386810c3/spectrum/1040g34o31l5or16a50105oakffv0j2coaldgsbo!nd_dft_wlteh_webp_3', 'tag_list': '高途,高中,一对一,网课,高三复习,复习,学习日常,一轮复习', 'last_modify_ts': 1773155810893, 'note_url': 'https://www.xiaohongshu.com/explore/689dc7ab000000001d01b340?xsec_token=ABMYSyG5sRCJEXQQbEFzjzIXw42KWSCxhCuvRSAV-qt7k=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABMYSyG5sRCJEXQQbEFzjzIXw42KWSCxhCuvRSAV-qt7k='}
