2026-03-10 23:25:02 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '686f19130000000012021f51', 'type': 'normal', 'title': '高中暑假跟高途1v1网课，每天2h', 'desc': '😮\u200d💨 还在愁孩子高中知识断层补不上？\n✅ 高途1v1网课每天2小时精准发力，名师带着从基础啃起，家长不用盯、孩子学得进！\n\t\n✅ 【高途高中1v1全程陪跑】\n🔥 时间灵活随时学：在家就能学，1v1上课时间超灵活，随时根据家长时间安排调整！\n🔥 双师全程盯学：上课过程中，有任何走神的迹象，老师会立刻调整教学方式，课后专属班班追更作业、24小时随时答疑\n🔥 省心不费妈：精准定位孩子的薄弱点，补到位，阶段测试及家长会随时了解学习进度！\n\t\n跟着高途高中1v1，节省了时间和精力，真正实现 “省钱不费妈”～\n赶紧点击左下角【立即咨询】领取1v1试学\n活动时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff\xa0\xa0\ufeff#一对一[话题]#\ufeff\xa0\xa0\ufeff#高中[话题]#\ufeff\xa0\xa0\ufeff#网课[话题]#\ufeff\xa0\xa0\ufeff#学习日常[话题]#\ufeff\xa0\xa0\ufeff#带学[话题]#\ufeff \ufeff#高一[话题]#\ufeff \ufeff#高二[话题]#\ufeff \ufeff#高三[话题]#\ufeff', 'video_url': '', 'time': 1752111379000, 'last_update_time': 1753786598000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '2', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102325/d217e910429e7a72b9f40c9243145d2d/spectrum/1040g0k031jo610tm2g005oakffv0j2cosbhqrgo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102325/c654bb3f6a61cb7085547b84167529f0/spectrum/1040g0k031jo610tm2g0g5oakffv0j2co64u7o2g!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中,网课,学习日常,带学,高一,高二,高三', 'last_modify_ts': 1773156302085, 'note_url': 'https://www.xiaohongshu.com/explore/686f19130000000012021f51?xsec_token=ABqJmkmJAf0neNFA-MkLd2HJjP7fQyJ6L7sMZz4hOTAk8=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABqJmkmJAf0neNFA-MkLd2HJjP7fQyJ6L7sMZz4hOTAk8='}
