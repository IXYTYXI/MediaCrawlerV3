2026-03-10 23:37:14 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68302209000000000f038245', 'type': 'normal', 'title': '高二跟不上？高途1v1定制衔接负责到出分', 'desc': '孩子马上升高三了\n现在学习进度混乱、知识断层严重？\n这个暑假来高途线上 1v1，简直是专为准高三打造的 “通关秘籍”！\n\t\n🔥 【量身定制，专治 “水土不服”】\n✅ 入学就做专业测评，知识漏洞、学习短板一目了然\n✅ 衔接课程超丝滑：进阶无缝过渡，提前打好地基，开学直接赢在起跑线\n✅ 专属学习计划表：细化到每天学什么、练什么，家长省心\n\t\n🔥 【死磕到底，负责到学会】\n✅ 上课状态、作业完成，老师全程紧盯，不留疑惑过夜\n✅ 根据测试结果，灵活调整学习计划，薄弱科目重点突破\n\t\n🔥 【高途官方背书，师资超硬核】\n✅ 老师全是985/211 毕业+多年带班经验的 “实力派”\n✅ 讲题逻辑清晰到飞起，再复杂的知识点都能轻松get\n✅ 传授的都是实用的学习方法和答题技巧\n\t\n现在预约👉【立即咨询】领专属试听\n报名要求：仅面向32岁以上家长\n活动时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#高中[话题]#\ufeff \ufeff#高二[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#准高三[话题]#\ufeff', 'video_url': '', 'time': 1748050261000, 'last_update_time': 1747984906000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '2', 'collected_count': '1', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102337/fae00bb12eef7eacf354d8b20dcbbc8a/spectrum/1040g34o31hqmc19p420g5oakffv0j2co99bu3o0!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中,高二,网课,准高三', 'last_modify_ts': 1773157034670, 'note_url': 'https://www.xiaohongshu.com/explore/68302209000000000f038245?xsec_token=ABpLud-iFzQ4SMHxVK079vNPLTdxT2N1NG3gF4Frq-rAo=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABpLud-iFzQ4SMHxVK079vNPLTdxT2N1NG3gF4Frq-rAo='}
