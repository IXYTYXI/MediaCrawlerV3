2026-03-10 23:44:34 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67ff1706000000001b03b3a0', 'type': 'normal', 'title': '🔥学习效率低？试试高途1v1陪伴式督.学！', 'desc': '📌 你家🧑\u200d🎓是否也这样？\n❌ 学得慢，忘得快——知识点讲完就忘，kao试还是不会\n❌ 刷题多，作用少——天天做题，成ji却不见涨\n❌ 没人盯，易偷懒——家长没空管，自己学不进去\n❌ 基础弱，补不动——落下的课越堆越多，越学越没信心\n----\n💡 别焦虑！高途1v1陪伴式督.学，让学习事半.功倍！\n\t\n🌟 为什么选择高途1v1？\n✅ 持证名师1v1陪练——严选经验丰富的老师，精. 准诊断学习问题，定制专属学习方案\n✅ 直播互动高效学习——实时答疑，拒绝“单向灌输”，真正听懂学会\n✅ 专攻薄弱环节——哪里不会补哪里，重难点逐个击破，拒绝无效刷题\n✅ 全程督. 学，拒绝摆烂——课后作业跟踪+定期测试，学习效.果看得见\n----\n点击下方【立即咨询】抢占专属试听特权\n🉐1v1学情分析+定制学习计划+学习资料\n报名要求：面向32岁以上家长\n截止时间：即日起-2025年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#学习[话题]#\ufeff', 'video_url': '', 'time': 1744860841000, 'last_update_time': 1744770823000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '2', 'collected_count': '2', 'comment_count': '3', 'share_count': '2', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102344/d13b9284af3f5ee8d77873ec0f2c48c5/spectrum/1040g34o31gapp8jt2a1g5oakffv0j2col5qif78!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102344/6733bfd725c26df9ed7fb6095fac8fdf/spectrum/1040g34o31gapp8jt2a205oakffv0j2col4jd0co!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102344/0e98c879744382c35422b88f2fac7fd4/spectrum/1040g34o31gapp8jt2a2g5oakffv0j2codde6q00!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,学习', 'last_modify_ts': 1773157474745, 'note_url': 'https://www.xiaohongshu.com/explore/67ff1706000000001b03b3a0?xsec_token=AB7-MPRvjuNrG3KtsQM4C94S0duJaU9ymKQYn9wvUByQI=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB7-MPRvjuNrG3KtsQM4C94S0duJaU9ymKQYn9wvUByQI='}
