2026-03-10 23:18:11 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6896ad000000000002000dd9', 'type': 'normal', 'title': '2小时高效学！高途高中1v1性价比拉满', 'desc': '📣 高中家长都懂：孩子每天作业写到深夜，想补弱科却挤不出整块时间；\n✍️ 线下补一次3小时坐不住，钱花了效果却一般；怕学了没反馈，到考试才发现漏洞一堆…\n✅ 直接跟着高途官方正品1v1网课学，主打 “2 小时高频学”，性价比拉满还负责到出芬，让孩子在有限时间里学得更高效！\n\t\n👉 计划具体到每天学什么怎么学：不用家长费心规划，每一步都有明确指引；\n👉 专属班班每天监督学习打卡：班班会像 “专属学习管家” 一样全程盯学；\n👉 1对1直播带学传授解ti方法：跟着老师的节奏动手练，告别 “听得懂做不出” 的困境；\n👉 一整套学习方案 + 课后巩固：确保学过的内容能及时消化吸收；\n👉 24 小时随时答疑解惑：确保疑问不过夜，不让小问题堆积成大漏洞；\n👉 阶段家长会随时了解学习情况：让家长清晰掌握学习进度，不再当 “局外人”。\n\t\n感兴趣的家长赶紧点击左下角【立即咨询】领取1v1试学吧～\n活动时间：即日起-26年12月31日\n报名要求：仅面向32岁以上家长\n\ufeff#高途[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#高中[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#学习日常[话题]#\ufeff \ufeff#高一[话题]#\ufeff \ufeff#高二[话题]#\ufeff \ufeff#高三[话题]#\ufeff \ufeff#高中数学[话题]#\ufeff \ufeff#高中物理[话题]#\ufeff', 'video_url': '', 'time': 1754705152000, 'last_update_time': 1754705152000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102318/5e744001820621c6bb8ec69b16760d00/spectrum/1040g0k031kuqqqspj6005oakffv0j2co1ebv6p8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102318/4342932d1ee1b2f36f0c56a20d0d36fd/spectrum/1040g0k031kuqqqspj60g5oakffv0j2cot0s1bd0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102318/159f20250957348a8b6e886f969e524f/spectrum/1040g0k031kuqqqspj6105oakffv0j2cod7vqbug!nd_dft_wlteh_webp_3', 'tag_list': '高途,网课,高中,网课,学习日常,高一,高二,高三,高中数学,高中物理', 'last_modify_ts': 1773155891489, 'note_url': 'https://www.xiaohongshu.com/explore/6896ad000000000002000dd9?xsec_token=ABnmatSxT3DMU9caN1Wt0dSo9ZRTJu8epvA2WvhG9kwMY=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABnmatSxT3DMU9caN1Wt0dSo9ZRTJu8epvA2WvhG9kwMY='}
