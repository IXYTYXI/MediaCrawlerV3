2026-03-10 23:44:12 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68099443000000001e00877d', 'type': 'normal', 'title': '学习不自律？找一对一！胜过盲目补3年', 'desc': '👉🏻 计划列一堆，学了5分钟就想摸鱼\n👉🏻 笔记抄满本，考试还是不会用\n👉🏻 补课班上了3年，分数反而倒退…\n别怀疑！不是孩子笨，是方法全错！\n\t\n被焦虑了，高途一对一来帮忙！全程严管督学，比爸妈还狠\n✅ 全程盯学模式：专属班班从早到晚督促，作业没写完？夺命连环催！\n✅ 1对1直播课：名师讲解进行学科知识梳理、重难点讲解全面教授破题思路及方法技巧\n✅ 精.准.狙.击.弱点：学前先检测，揪出“隐形难点”（比如我家🧑\u200d🎓数学总跳步骤扣fen）\n✅ 行动派落实：专属班班对各科目都有自己的实战方法论，思路、解题、方法，全方位、无时限答疑\n\t\n⬇️ 现在点击图片下方 【立即咨询】抢占试听名额💝\n*本课程为家庭教育规划课，内容仅面向家长\n📆 活动时间：即日起-2025年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#学习日常[话题]#\ufeff', 'video_url': '', 'time': 1745458243000, 'last_update_time': 1745458244000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '3', 'collected_count': '4', 'comment_count': '1', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102344/53299a9cf1669b347028bd6834d2f11f/spectrum/1040g0k031gl1i7nvja005oakffv0j2co19ffcmg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102344/ed3870f10d8e97f0e7baab6393f4bd03/spectrum/1040g0k031gl1i7nvja0g5oakffv0j2conr9pr30!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,学习日常', 'last_modify_ts': 1773157452922, 'note_url': 'https://www.xiaohongshu.com/explore/68099443000000001e00877d?xsec_token=ABuTeg-y02O_coiO5uIALyNlpY99sxWD4SkTS7mJ8Hjhc=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABuTeg-y02O_coiO5uIALyNlpY99sxWD4SkTS7mJ8Hjhc='}
