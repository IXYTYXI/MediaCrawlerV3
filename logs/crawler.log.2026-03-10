2026-03-10 21:46:12 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a95f670000000022039494', 'type': 'video', 'title': '对比完所有小学浅奥机构，平行线真的🐮', 'desc': '家长们，给娃报了一堆思维课，学了大半年，孩子是不是只学会了一点解题小技巧？ 别先怪孩子，很可能是机构在用套路糊弄你！\n❌ 只教固定模板、教“秒杀”，短期看似提分\n❌ 不教底层逻辑，孩子一遇到新题就懵 长期下来，反而固化思维，越学越死。\n【平行线：只教真思维，不玩虚套路】 从第一天就坚持：不讲套路，只讲原理。 用数形结合、生活场景、逻辑拆解，让孩子真正懂本质，实现**学一题，通一类。\n【硬核实力，不怕对比】\n✅ 名师直播：清北/985/竞赛教练亲授，全程互动带学\n✅ 超高性价比：1440元=48次直播（96课时）+全套教材，不到别家1/3\n【三大班型，精准匹配】\n💡 笃学班（30%校内+70%浅奥） 适合校内稳85+，想夯实基础、拓展思维\n💡 睿学班（10%校内+90%浅奥） 适合90+，想打通奥数思维、突破瓶颈\n💡 创新班（70%浅奥+30%深奥） 适合数学有天赋，目标竞赛、重点升xue\n想让孩子学真数学思维，选平行线就对了！\n↙️ 点击左下角【咨询】 或@平行线名师大课堂 ，发【年级+基础】 我直接给你发对应课程介绍！  此内容为面向家长的思维规划课\n#数学思维[话题]#    #小学奥数[话题]#    #让孩子爱上数学[话题]#    #小学数学[话题]#    #平行线教育[话题]#   #思维训练[话题]#   #数学从这里开始[话题]#', 'video_url': 'http://sns-video-al.xhscdn.com/stream/79/110/259/01e9a95f68ec4132010370039cbd9d2e36_259.mp4', 'time': 1772707687000, 'last_update_time': 1772707688000, 'user_id': '642ba9780000000012011a80', 'nickname': '平行线名师大课堂', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/f0238b56-4bdd-3597-adf3-db36cfdcf315', 'liked_count': '4', 'collected_count': '3', 'comment_count': '1', 'share_count': '1', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102146/4e3c6b068d48be35f031ec6ca4781889/spectrum/1040g34o31tb2vff9la105p1bl5s4i6k0v855i10!nd_dft_wlteh_webp_3', 'tag_list': '数学思维,小学奥数,让孩子爱上数学,小学数学,平行线教育,思维训练,数学从这里开始', 'last_modify_ts': 1773150372570, 'note_url': 'https://www.xiaohongshu.com/explore/69a95f670000000022039494?xsec_token=ABkXiiT8OoWfy0U4yQ6YI3tmt_eFhZIZZnxjnAepJ0u48=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABkXiiT8OoWfy0U4yQ6YI3tmt_eFhZIZZnxjnAepJ0u48='}
