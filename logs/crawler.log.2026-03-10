2026-03-10 22:50:50 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6954f166000000001e032024', 'type': 'normal', 'title': '高中寒假在家学！高途1v1名师陪跑', 'desc': '👀 家有高中生的家长看过来！\n🤔 寒假不想让孩子跑机构折腾，还想趁假期补短板、冲分数？\n✅ 选择高途高中1v1寒假网课直接封神！\n💻 在家就能学，复旦人大名师领航带学，一直负责到出分，精准适配各类学习需求～\n\t\n👉 这4类孩子，寒假冲1v1准没错！\n- 严重偏科党：单科目拖后腿，拉低总分难提；\n- 专项短板明显：核心知识扎实，细分题型总丢分；\n- 冲刺目标线：徘徊在目标院校分数边缘，提分空间大；\n- 有明确方向：备考目标清晰，需要针对性精准逆袭；\n\t\n👉 复旦人大等双一流名校学霸坐镇！逆袭更有底气\n多轮严选名校毕业学霸主讲，深耕高中教学多年，1人1班直播授课，高频聚焦核心知识点，不会让孩子做无用功！\n\t\n👉 全流程1v1定制！补弱不盲目\n课前1v1诊断：精准定位学科薄弱点，找准突破口；\n课中1v1直播：老师实时互动带学，边学边练习；\n课后7*24h兜底：作业批改、答疑解惑不打烊；\n\t\n👉 先试学再报名！家长放心选\n让孩子亲自感受名师教学风格、课程节奏，觉得合适再决定！\n想抓住寒假提分机会的家长，点击【立即咨询】获取试学名额和1v1学习计划～\n📝 报名要求：仅面向32岁以上家长\n📆 截止时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #网课日常[话题]# #线上课[话题]# #寒假[话题]# #在家学[话题]#', 'video_url': '', 'time': 1767174502000, 'last_update_time': 1767174502000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '1', 'comment_count': '3', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102250/c93800fdf20c3a2f79d501f1741993bd/spectrum/1040g0k031qokm679n4005oakffv0j2co512jnd8!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,网课日常,线上课,寒假,在家学', 'last_modify_ts': 1773154250394, 'note_url': 'https://www.xiaohongshu.com/explore/6954f166000000001e032024?xsec_token=ABfMRpUXU5A0kKOrOk9ZG4HBagcTjb3IHDhHAMAJT9PwY=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABfMRpUXU5A0kKOrOk9ZG4HBagcTjb3IHDhHAMAJT9PwY='}
