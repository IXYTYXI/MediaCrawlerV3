2026-03-10 22:42:28 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '699eb4eb000000000d00a005', 'type': 'normal', 'title': '别瞎报！高考冲刺就选高途1v1陪跑', 'desc': '⏰ 高考百天倒计时！\n🔥 别等了！赶紧给娃安排上救命1v1陪跑课\n直接把“省心+提分”焊在身上！老师一站式盯学\n全程负责到出分，不管是娃的学习状态，还是家长的顾虑\n全给你安排得明明白白，百天逆袭真的有戏！\n\t\n✅ 真名师坐镇｜严选名校学霸，持证直播带学\n全员持证上岗，深耕高考考点，1v1直播从头精讲，不跳步、不敷衍，每个考点都讲透，哪怕基础弱也能跟上。\n\t\n✅ 一站式盯学｜课前中后全程督学，不摆烂\n全程1v1严格督学，高频互动避免跑神，边讲边练习、趁热打铁，杜绝拖延摆烂。\n\t\n✅ 精准适配+个性定制｜高效不脱节\n精准匹配校内进度，学的内容能直接用到课堂、用到刷题，随学随用不脱节；个性化难度分级，基础弱补基础，想冲分拔高峰。\n\t\n✅ 7*24h答疑+家长旁听｜双重安心\n7*24小时随时答疑解惑，疑问不过夜；还有阶段复盘，总结漏洞、优化方案，每一步都有反馈，提分看得见、摸得着！\n\t\n不用家长费心盯学，不用孩子盲目努力，这门1v1陪跑课，一站式解决所有痛点。\n\t\n📣 赶紧点击左下角【立即咨询】领取1v1试学名额\n📍 活动范围：仅面向32岁以上家长\n🌈 活动时间：即日起-26年12月31日\n#高途[话题]# #一对一[话题]# #高中网课[话题]# #高考复习[话题]# #高考冲刺[话题]# #高考逆袭[话题]# #高效学习[话题]# #线上课[话题]#', 'video_url': '', 'time': 1772008683000, 'last_update_time': 1773023167000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '', 'collected_count': '1', 'comment_count': '6', 'share_count': '', 'ip_location': '河北', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102242/a0876726e8141ccb097c8eb3fbc5d797/spectrum/1040g0k031t0lpvt1l8005oakffv0j2coeufq9m0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102242/53e67856d52cc481ac35e85f824bd249/spectrum/1040g0k031t0lpvt1l80g5oakffv0j2coun10he0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102242/1fc2b2a02da50eb2f16fd15d5051a68b/spectrum/1040g0k031t0lpvt1l8105oakffv0j2co5afcu20!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中网课,高考复习,高考冲刺,高考逆袭,高效学习,线上课', 'last_modify_ts': 1773153748409, 'note_url': 'https://www.xiaohongshu.com/explore/699eb4eb000000000d00a005?xsec_token=AB2iCfwYPnGan88a-wVARvBvEtpaMB05fn-lViEtBjC48=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB2iCfwYPnGan88a-wVARvBvEtpaMB05fn-lViEtBjC48='}
