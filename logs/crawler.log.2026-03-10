2026-03-10 23:36:38 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68394c31000000002301c807', 'type': 'normal', 'title': '暑假别摆烂！跟1v1集训直接逆袭尖子生', 'desc': '⚠️ 各位家长一定知道！高二暑假就是逆袭黄金期！！\n🤷 还在担心知识点漏洞多、做题没思路、自律性差？\n👍 这波1v1线上督学集训营直接 “开挂”，学前学中学后全流程锁死！\n\t\n【高途高二线上1v1集训】\n✅ 1v1量身定制学习方案：每日学习计划精确到小时，调整学习进度，薄弱环节重点突破方案\n✅ 专属班班严管督学服务：随时答疑，每日学习任务全程监督，学后三检制度（笔记/作业/错题）\n✅ 1v1检测学习薄弱体系：知识点通关测试，学习成果评估，动态调整教学策略\n✅ 家长随时了解学习进度：家长学习汇报会，学习情况查询，专属家长群\n✅ 智能科技助理高效：错题大数据诊断，知识点掌握度可视化\n\t\n现在上车，开学惊艳所有人！\n点击左下角【立即咨询】领取1v1试听\n活动时间：即日起-25年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#高中[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#一轮复习[话题]#\ufeff', 'video_url': '', 'time': 1748585521000, 'last_update_time': 1748585521000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '2', 'collected_count': '1', 'comment_count': '1', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603102336/36c58e6ef6373ba6c1d68155ee2b0517/spectrum/1040g0k031i3kouuq6s005oakffv0j2cosh37oeo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102336/124ba6273e69e027e2aaa84933fdb045/spectrum/1040g0k031i3kouuq6s0g5oakffv0j2cop365lsg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603102336/fb998619d3b0c7d2328a111d138baac4/spectrum/1040g0k031i3kouuq6s105oakffv0j2coc47g63o!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,高中,网课,一轮复习', 'last_modify_ts': 1773156998378, 'note_url': 'https://www.xiaohongshu.com/explore/68394c31000000002301c807?xsec_token=AB0g3976cXjNme1HZWBddwR8-ZNPSdICKz-mCDGUaCfkQ=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB0g3976cXjNme1HZWBddwR8-ZNPSdICKz-mCDGUaCfkQ='}
