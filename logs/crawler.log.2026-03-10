2026-03-10 16:04:10 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '65e05e88000000000102aa40', 'type': 'normal', 'title': '我很后悔📢小学没有超前学、深入学⁉️', 'desc': '整理了一位学霸妈妈的分享🔥，其实在教育孩子的过程中，许多家长和教育工作者都面临一个常见的问题，那便是如何处理孩子的超前学习。超前学习本身并不是问题👍，关键在于我们超前学习的方法和目的。以及相对应的科目特性合理安排。💪\n#弯道超车[话题]#\xa0\xa0#小学数学超前学[话题]#\xa0\xa0#小学规划[话题]#\xa0\xa0#小学生[话题]#\xa0\xa0#学霸养成[话题]#\xa0\xa0#家有小学生[话题]#\xa0\xa0#孩子教育[话题]#\xa0\xa0#儿童记录[话题]#', 'video_url': '', 'time': 1709203080000, 'last_update_time': 1709203080000, 'user_id': '64b643150000000011000788', 'nickname': '深圳童学幼小营', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31gnlinuhjq605p5m8cak81s82utocg8', 'liked_count': '1942', 'collected_count': '3206', 'comment_count': '64', 'share_count': '436', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603101555/ab528f70c0c2c7bed8488bdca3326c2d/spectrum/1040g0k030vopiggbm0005p5m8cak81s8uqnmlu0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101555/fe226ada53f378ffe3436117bd8a147b/spectrum/1040g0k030vopigeu60005p5m8cak81s827r7lo8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101555/0f7dd29afb3add257fa4d85747c2e2a2/spectrum/1040g34o30vopigjelq005p5m8cak81s82pfg8fg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101555/2777c68d3e0f45b084d9814c0ee2aa38/spectrum/1040g0k030vopighn5o005p5m8cak81s88eghlro!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603101555/8d1591a51e8bd511c370deccb52879e6/spectrum/1040g0k030vopim2slu005p5m8cak81s8jk9fah0!nd_dft_wlteh_webp_3', 'tag_list': '弯道超车,小学数学超前学,小学规划,小学生,学霸养成,家有小学生,孩子教育,儿童记录', 'last_modify_ts': 1773129850360, 'note_url': 'https://www.xiaohongshu.com/explore/65e05e88000000000102aa40?xsec_token=ABTxbfrVcYQkdj-XKK97ugc3yHXSEs9g218-8o_lfuusY=&xsec_source=pc_search', 'source_keyword': '数学超前学', 'xsec_token': 'ABTxbfrVcYQkdj-XKK97ugc3yHXSEs9g218-8o_lfuusY='}
