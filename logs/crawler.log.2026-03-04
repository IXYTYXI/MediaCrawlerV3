2026-03-04 12:21:52 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a6b296000000001d0108b5', 'type': 'video', 'title': '这样学数学！普娃也能轻松开窍🧠', 'desc': '普娃数学破局，思维开窍才是硬道理！🥳还好@面团妈咪爱分享 及时遇到了Mathplore新加坡数学，孩子现在拿到题目居然能自己画图分析，再也不用家长盯着吼着学了！\n\t\n🔍CPA建模法｜逻辑可视化\n拒绝死记硬背！用新加坡CPA教学法，把抽象的数学概念转化为具象图形，孩子一眼看懂解题关键，思维开关瞬间被打开✨\n\t\n🚀课内+思维｜能力双保障\n紧跟校内重难点打基础📝，同时融入思维拓展题拉升上限！让孩子不仅会做题，更懂举一反三，遇到新题型也不怕\n\t\n🌐中英双语｜思维语言双赢\n中英班型可选，用英语学数学、讲思路！不仅锻炼逻辑，还能提升语言能力💪，一举两得轻松拿捏～\n\t\n🎮情境教学｜兴趣动力足\n把数学融入游戏和生活场景！超市购物、分披萨🍕…让娃在玩中建立数感，告别枯燥题海，真正爱上动脑筋！\n\t\n🔥 点击左下角【立即咨询】即可领取价值1888元学习礼包。\n名额有限，欢迎把握机会。\n——\n活动时间：即日起至2028年12月31日\n面向18岁以上海外家长群体\n#数学开窍[话题]#  #Mathplore新加坡数学[话题]#  #Mathplore[话题]#  #小学数学怎么学[话题]#  #数学差生[话题]#  #数学网课[话题]#', 'video_url': 'http://sns-video-bd.xhscdn.com/stream/79/110/259/01e9a6b26f45c97c010370039cb32a7a1d_259.mp4', 'time': 1772536022000, 'last_update_time': 1772532375000, 'user_id': '5ff43d2b0000000001001995', 'nickname': 'Mathplore线上数学', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/640f03dce33a6ed3c5116b3d.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '四川', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041221/35fae2ffd31941740f3de97497348a96/spectrum/1040g0k031t8fhc496e005nvk7klg86clc678jvo!nd_dft_wlteh_webp_3', 'tag_list': '数学开窍,Mathplore新加坡数学,Mathplore,小学数学怎么学,数学差生,数学网课', 'last_modify_ts': 1772598112501, 'note_url': 'https://www.xiaohongshu.com/explore/69a6b296000000001d0108b5?xsec_token=ABzDDpMxlCbuHHbn2MYrMCzkHY6BXjtD0Z61ywkD5kbyg=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABzDDpMxlCbuHHbn2MYrMCzkHY6BXjtD0Z61ywkD5kbyg='}
