2026-03-04 14:21:31 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a2c0ef000000001d013e23', 'type': 'normal', 'title': 'Mathplore数学课补差、超前、拔高一起抓！', 'desc': '家有小学娃的妈妈们懂的都懂\n校内跟不上、想超前学、还要练思维\n报3门课费钱费时间，孩子还累\n\t\n给大家挖到一家宝藏数学课—Mathplore新加坡数学\n一周两次=校内补差+同步超前+思维拔高\n直接把国内娃的数学需求一网打尽\n\t\n📚 课程内容精准贴合校内\n65%校内重难点巩固，吃透课本不丢分\n计算薄弱、应用题不会、考试粗心\n跟着课程查漏补缺，基础稳稳扎牢\n\t\n🚀 适度超前学\n课程按照G0-G6螺旋式进阶\n娃在掌握了底层逻辑后\n可选择向高年级内容拓展\n\t\n🧠 思维拔高不搞题海\n新加坡CPA教学法+建模思维\n画图拆解难题，抽象变直观\n难题一看就懂，会一道通一类\n真正练逻辑、不硬背、不死刷题\n\t\n👩\u200d🏫 上课信息\n✅ 在线小班直播（2-6人），老师全程互动\n✅ 专属班主任1v1跟踪学情\n✅ 中/英双语可选\n✅ 一课一练+闭环复习，不用家长盯\n✅ 覆盖5-12岁孩子，零基础/拔高都能跟\n\t\n真心推荐给想高效学数学的小学生家庭\n少走弯路\n🔥现在戳即可0元get价值1888元的数学学习大礼包哦\n名额有限，先到先得～\n——\n活动时间：即日起至2027年12月31日\n*面向18＋海外用户群体\n#新加坡数学[话题]# #数学思维[话题]# #Mathplore[话题]# #小学数学[话题]# #小学数学怎么学[话题]# #数学学习[话题]# #Mathplore新加坡数学[话题]# #数学网课[话题]# #数学开窍[话题]# #小学数学思维训练[话题]#', 'video_url': '', 'time': 1772273903000, 'last_update_time': 1772418589000, 'user_id': '66c854d2000000001d022cac', 'nickname': 'Mathplore数学开窍', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31djmkng2h66g5pm8aj97cb5cr77jngg', 'liked_count': '1', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '四川', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041421/06a6df6746915527b3f45096c753a64a/spectrum/1040g0k031t4k8db36e105pm8aj97cb5cdepj0r0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041421/dca3e99739539fa95c8ed544074efbad/spectrum/1040g0k031t4k8db36e005pm8aj97cb5cjrerqmg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041421/cb6e4d1886589793ccffcc9da947c344/spectrum/1040g0k031t4k8db36e0g5pm8aj97cb5cr1o9ino!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学,数学思维,Mathplore,小学数学,小学数学怎么学,数学学习,Mathplore新加坡数学,数学网课,数学开窍,小学数学思维训练', 'last_modify_ts': 1772605291162, 'note_url': 'https://www.xiaohongshu.com/explore/69a2c0ef000000001d013e23?xsec_token=ABOd9DKaujxPmBXwmUsK9eV3MXk-8aajiDq-N34WdCeQw=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABOd