2026-03-04 11:26:51 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '675fe14b000000000b00c68c', 'type': 'normal', 'title': '剑桥🏫不是上不起，学新加坡数学就行❗', 'desc': '家长们请看→世界top级别的剑桥大学都注重考察哪些学习能力？\n🧑\u200d🏫对候选人进行面试，着重考察创新思维、逻辑思维、批判精神、提问能力，而不只是一个试卷上的分数而已哦。\n那未来有想要海外留学，冲刺高校的孩子，这些能力该如何培养❓\n-\n💥十分推荐选择新加数学，内容涵盖公立小学所有内容，额外扩展数学思维。\n✅采用CPA教学法，从小促进深入理解数学概念及其背后的逻辑，为未来的高阶学习打下坚实的基础。\n✅培养数学建模技能，培养好学会举一反三的能力。\n-\n找不到在哪里学？Spark Math线上直播，现在就来👋\n点⬇【立即咨询】，还能0元试听数学课\n活动时间：即日起-2025年12月31日\n\t\n\ufeff#小学数学怎么学[话题]#\ufeff \ufeff#小学数学思维训练[话题]#\ufeff \ufeff#小班课[话题]#\ufeff \ufeff#新加坡数学[话题]#\ufeff \ufeff#新加坡数学思维[话题]#\ufeff \ufeff#数学思维[话题]#\ufeff \ufeff#思维训练[话题]#\ufeff \ufeff#sparkmath[话题]#\ufeff \ufeff#小学数学[话题]#\ufeff \ufeff#小学数学期末复习[话题]#\ufeff', 'video_url': '', 'time': 1734336843000, 'last_update_time': 1734400266000, 'user_id': '61b2fc7e000000001000f059', 'nickname': 'Spark Math线上课程', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4aeb79ls6g5odivhv41s2pgohmd30', 'liked_count': '1', 'collected_count': '1', 'comment_count': '', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041126/af118e7d1b12d94cfbefec70c5c4a553/spectrum/1040g0k031bfaefh9ga005odivhv41s2p9fsdgio!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041126/c61f6c5b78490c2385c68d81e83efca1/spectrum/1040g0k031bfaefh9ga0g5odivhv41s2pn7heobg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041126/850cba9867f4491abe28d502e405ab72/spectrum/1040g0k031bfaefh9ga105odivhv41s2p7udq17g!nd_dft_wlteh_webp_3', 'tag_list': '小学数学怎么学,小学数学思维训练,小班课,新加坡数学,新加坡数学思维,数学思维,思维训练,sparkmath,小学数学,小学数学期末复习', 'last_modify_ts': 1772594811534, 'note_url': 'https://www.xiaohongshu.com/explore/675fe14b000000000b00c68c?xsec_token=ABGjHDg7Kwdhyt3oXrnmS_6TbGvj5YHagdUZLhjXuLbLY=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABGjHDg7Kwdhyt3oXrnmS_6TbGvj5YHagdUZLhjXuLbLY='}
