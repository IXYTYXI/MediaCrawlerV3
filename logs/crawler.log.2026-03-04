2026-03-04 15:16:11 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a67e32000000002602f9d9', 'type': 'normal', 'title': '开学每周2h❗️平行线浅奥带你逆袭到前三', 'desc': '小学数学思维不开窍？快来试试平行线 新学期轻松逆袭！低至15元/课时\n⛄️新学期来平行线的孩子，悄悄变了样\n✔ 思路清晰，会主动画图、拆解题目，应用题不再犯难\n✔ 专注力提升，能完整坚持90-120分钟课堂，坐得住、听得进\n✔ 不再依赖家长讲题，遇到难题愿意自己先思考、先尝试\n✔ 题型再变也不慌，举一反三能力强，学习更有底气  🥰在平行线上课有多省心？\n🌟课程干货拉满，不搞虚的、不玩套路！\n✅ 紧扣新课标，基础巩固+浅奥拓展一步到位 👉🏻 知识点紧贴校内重难点，同时拓展浅奥思维，逐步培养理科逻辑，为初中、高中打下扎实基础。\n✅ 不教死答案，只练“活思维”！ 👉🏻 不硬背公式、不直接给答案，用多种模型、多种思路解题，重点锻炼迁移能力与思维灵活性，新题、变形题都能从容应对。\n✅ 节奏超友好，学习休息两不误！ 👉🏻 每周一次，一次2节，每节课90-120分钟，知识点不断档，也不给孩子过多压力，学有余力还能放心玩耍休息。\n🔥新学期，给孩子一次“数学开窍”的机会\n👇🏻点击【立即咨询】，测测孩子的数学思维在哪一关，精准适配班型！\n#平行线教育[话题]#   #数学思维[话题]#   #数学素养[话题]#     #平行线1440年课[话题]#   #家长必看[话题]#  #浅奥思维[话题]# #小学奥数[话题]#   #奥数思维[话题]# #思维训练[话题]#', 'video_url': '', 'time': 1772518962000, 'last_update_time': 1772518963000, 'user_id': '642ba9780000000012011a80', 'nickname': '平行线名师大课堂', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/f0238b56-4bdd-3597-adf3-db36cfdcf315', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041516/8e6afe0ef7faf6abdddd5dedcd45f205/spectrum/1040g0k031t88u0egme005p1bl5s4i6k0klp1vd0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041516/129400f4435f8b14b324215e4a0c5c99/spectrum/1040g34o31t88ud1p5a105p1bl5s4i6k0ll1g9jo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041516/c4f573e3a32b3fac93ef76752f0f5b9a/spectrum/1040g0k031t8904f0le005p1bl5s4i6k0f9amqb8!nd_dft_wlteh_webp_3', 'tag_list': '平行线教育,数学思维,数学素养,平行线1440年课,家长必看,浅奥思维,小学奥数,奥数思维,思维训练', 'last_modify_ts': 1772608571183, 'note_url': 'https://www.xiaohongshu.com/explore/69a67e32000000002602f9d9?xsec_token=ABzDDpMxlCbuHHbn2MYrMCztV9xbkvq4l2B92JJlqglxg=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABzDDpMxlCbuHHbn2MYrMCztV9xbkvq4l2B92JJlqglxg='}
