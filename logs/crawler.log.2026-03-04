2026-03-04 14:00:52 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a15f03000000001b01554d', 'type': 'normal', 'title': '思维差真能练！Mathplore小班课效果真明显', 'desc': '孩子数学差、不开窍，真的不是因为笨！🚫\n.\n每次辅导作业，气得血压飙升，孩子一脸懵，家长一肚子火🔥明明很简单的题目，换个说法就不会了，思维完全转不过弯来😫\n.\n别急，思维差这件事，是真的可以练出来的！\n👇\n【Mathplore新加坡数学】2-6人小班直播课，让孩子思维轻松开窍！\n.\n✅趣味性强：真实情景导学，动画游戏课件，孩子主动想学\n✅CPA教学法：把抽象概念变直观，举一反三不再难\n✅严选师资：5年以上教学经验，懂孩子更懂数学\n✅五师一体：五位老师服务一个娃，效果看得见\n.\n从G0到G6，科学规划带孩子一步步提升：\n学前数感启蒙 ➡️ 小学运算逻辑 ➡️ 分数方程思维\n每个阶段都有明确目标和海量练习，稳扎稳打📈\n.\n2-6人小班直播课，40-50分钟一节，可选中/英授课，5-12岁都能找到适合自己的节奏🎯\n.\n不是孩子不行，是方法没对！\n让孩子试试新加坡数学，思维真的会“开窍”！💡\n.\n👇点击左下角【立即咨询】\n享\u200b价值1888元数学学习大礼包🎁\n⏰时间：即日起-2026年12月31日\n👦🏻报名人群：面向海外18+用户\u200b\n👇现在点击【立即咨询】，限量0元试学名额，还有隐藏福利\u200b\n#Mathplore新加坡数学[话题]# #Mathplore[话题]# #数学思维[话题]# #儿童逻辑思维[话题]# #小学数学怎么学[话题]# #小学数学[话题]# #小学数学思维训练[话题]# #新加坡数学[话题]# #数学学习[话题]#', 'video_url': '', 'time': 1772183299000, 'last_update_time': 1772183299000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '四川', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041400/ef5827f8ea3e8f49126a27775e659588/spectrum/1040g0k031t391fetla005odiop740t80cb7mqi0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041400/4c8731975b08ac60bea211c08b64cc47/spectrum/1040g0k031t391fetla0g5odiop740t803941lh8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041400/e42c818c007d86500532449de1752fc6/spectrum/1040g0k031t391fetla105odiop740t80vlf25ig!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041400/837acf3cb1890850c37439563f91a081/spectrum/1040g0k031t391fetla1g5odiop740t80nl07b4g!nd_dft_wlteh_webp_3', 'tag_list': 'Mathplore新加坡数学,Mathplore,数学思维,儿童逻辑思维,小学数学怎么学,小学数学,小学数学思维训练,新加坡数学,数学学习', 'last_modify_ts': 1772604052652, 'note_url': 'https://www.xiaohongshu.com/explore/69a15f03000000001b01554d?xs