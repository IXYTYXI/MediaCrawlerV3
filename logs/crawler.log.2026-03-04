2026-03-04 10:56:30 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '699e8fb30000000016008ef4', 'type': 'normal', 'title': '小学开学数学跟不上？sparkmath让娃稳定1%', 'desc': '别再让娃死记硬背公式了！数学逻辑没打通，刷再多题也是白搭\nsparkmath新加坡数学【开学早鸟报名】正式开启，专治各种数学“不爱学、听不懂、坐不住”\n-\n为什么聪明家长都选sparkmath（火花新加坡数学）❓\n✅ CPA建模思维教学\n拒绝死记硬背！把抽象题变成“看得见”的图形，娃一听就懂，解题就像通关游戏一样简单！\n✅ 3-8人精品小班\n老师全程精准关注，每个孩子都有发言机会。拒绝“云听课”，真正实现沉浸式课堂互动\n✅ 对标校内+竞赛拓展\n80%巩固基础+20%竞赛拔高，校内考试不仅不丢分，更能提前布局奥数！\n✅ 三师伴学不费妈\n课前预习、课后督学、定期反馈。家长不用盯，娃能自己主动学！\n-\n🎁 【开学限时福利】 现在点击左下角【立即咨询】或者@Spark Math线上教育\n即可0元价值锁定3288元开学大礼包：\n⭐1节资深名师直播体验课\n⭐1份儿童数学能力全维度测评\n⭐228节小学数学思维拓展课\n👇点击下方↙【立即咨询】抢占试听名额！名额有限，别让娃在开学季掉队！\n#sparkmath新加坡数学[话题]# #sparkmath[话题]# #新加坡数学[话题]# #新加坡数学网课[话题]# #小学开学[话题]# #新加坡数学教材[话题]# #小学数学怎么学[话题]# #小学数学这样学[话题]# #国际课程[话题]# #国际网课[话题]#', 'video_url': '', 'time': 1771999156000, 'last_update_time': 1771999156000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '', 'collected_count': '1', 'comment_count': '1', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041056/45ceb03c8d405e67b13d5e0a355cb858/spectrum/1040g34o31t0h45b2la005olhcu8lbcma89tc6b8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041056/5c73a61284b4fdb0ff64e5054f196bda/spectrum/1040g0k031t0h45gi5e005olhcu8lbcmae5u56p0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041056/ed75801a551e01d343421611ec24d12e/spectrum/1040g0k031t0h46425c005olhcu8lbcma7i4d600!nd_dft_wlteh_webp_3', 'tag_list': 'sparkmath新加坡数学,sparkmath,新加坡数学,新加坡数学网课,小学开学,新加坡数学教材,小学数学怎么学,小学数学这样学,国际课程,国际网课', 'last_modify_ts': 1772592990550, 'note_url': 'https://www.xiaohongshu.com/explore/699e8fb30000000016008ef4?xsec_token=AB2iCfwYPnGan88a-wVARvBqWCrCbN7vWksskl0xK-OgA=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB2iCfwYPnGan88a-wVARvBqWCrCbN7vWksskl0xK-OgA='}
