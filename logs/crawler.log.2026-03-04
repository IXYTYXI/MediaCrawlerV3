2026-03-04 12:32:08 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6990331e000000001b016d98', 'type': 'video', 'title': '5-12岁思维养成关键期💪Mathplore来助力', 'desc': '5-12岁娃数学学习常见痛点💥看看你家娃是不是也这样👇\n\t\n👉计算易粗心失误、知识点记忆不牢固，学完即忘\n\t\n👉作业效率低下、耗时冗长，面对几何题型毫无解题思路\n\t\n👉公式掌握熟练，却无法灵活应用于解题\n\t\n👉学习漏洞频发、难以兼顾，成绩起伏不定，且缺乏举一反三的能力\n\t\n针对以上痛点，Mathplore新加坡数学给出高效解决方案！\n\t\n🌟 核心教学优势，精准破解学习难题\n\t\n✅ CPA教学法，分层适配成长节奏\n通过具象化动画搭配游戏化操作，帮助3-6岁娃轻松理解数学概念；为6-9岁娃提供图形建模析题方式，直观梳理数量关系；引导9-12岁娃提取抽象算式，阶梯式培养解题思维，打通数学学习关键脉络。\n\t\n✅ 2-6人小班直播，保障教学质量\n课堂互动感拉满，依托动画课件与生活场景模拟，激发儿童主动探索兴趣，避免课堂走神\n\t\n老师经过5轮严格筛选，1.2%的通过率确保优质教学，授课教师均具备超5年教学经验，支持全中/全英班型切换，实现因材施教。\n\t\n✅ 分龄分级教学，覆盖全阶段需求：课程涵盖学前至六年级，从数感启蒙到方程几何，1976个知识点层层递进；同步培养8种思维能力与10种核心能力，配套8650+次针对性练习，夯实基础、强化提升。\n\t\n✅ 五师伴学体系，全程护航学习之路：提供课前预热回顾、课中互动练习、课后批改反馈的全流程服务，教研团队持续优化课程内容，全方位保障学习效果。\n\t\n🔥 限时福利来袭！点击左下角【立即咨询】即可0元领取价值1888元学习大礼包🎁\n\t\n⏰ 活动时间：即日起至2028年12月31日\n*仅面向18+海外家长\n\t\n#小学数学[话题]#  #新加坡数学[话题]#  #Mathplore新加坡数学[话题]#  #让孩子爱上数学[话题]#  #数学思维[话题]#  #数学学习[话题]#  #提升孩子思维能力[话题]#  #Mathplore[话题]#  #数学启蒙[话题]#  #小学数学思维训练[话题]#', 'video_url': 'http://sns-video-bd.xhscdn.com/stream/79/110/259/01e99032f9281f01010370039c5b47c7de_259.mp4', 'time': 1771147981000, 'last_update_time': 1771057951000, 'user_id': '5ff43d2b0000000001001995', 'nickname': 'Mathplore线上数学', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/640f03dce33a6ed3c5116b3d.jpg', 'liked_count': '1', 'collected_count': '1', 'comment_count': '1', 'share_count': '', 'ip_location': '四川', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041232/e1f5d38b974751c3d9188abb097b4eb6/spectrum/1040g0k031siget07l8005nvk7klg86clneo5fco!nd_dft_wlteh_webp_3', 'tag_list': '小学数学,新加坡数学,Mathplore新加坡数学,让孩子爱上数学,数学思维,数学学习,提升孩子思维能力,Mathplore,数学启蒙,小学数学思维训练', 'last_modify_ts': 1772598728775, 'note_url': 'https://www.xiaohongshu.com/explore/6990331e000000001b016d98?xsec_token=ABv0Z38lOPVjC18nF1xWp_0h_CpP333nbTU_PgZZXcdD8=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABv0Z38lOPVjC18nF1xWp_0h_