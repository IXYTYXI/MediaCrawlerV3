2026-03-04 21:35:02 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a82702000000001b0158ad', 'type': 'video', 'title': '花大几万报班纹丝不动❓这个一对一真能救', 'desc': '救命🆘这种假努力你家娃还在做吗？\n说实话，每次看到家长花钱报那种放羊式网课，都替孩子着急😢\n💢屏幕开着，人却在神游\n💢老师念PPT，比学校上课还催眠\n💢钱花了，时间废了，成绩还在原地踏步......\n-\n选错辅导方式，真的比不补还坑！\n这个掌门一对一真的不一样👇\n✅真人老师实时互动，不是冷冰冰的录播，随时提问随时答\n✅能盯着孩子思路走，上课走神？老师第一时间拉回来\n✅1对1定制学习方案，按照薄弱点逐个击破\n✅精准定位知识盲区，每一分钟都在有效学习\n✅学完还有反馈，课后生成专属学习报告，进步看得见\n-\n我们懂你想对孩子好的心，但真正的好，是让他的努力不白费💪\n👉现在【点击直播间】领取1v1高中英语/语文/数学线上试听网课\n让孩子体验一下什么叫有人带着飞的学习\n不试试，怎么知道他可以？\n领取时间：即日起-2026年12月31日#掌门一对一[话题]# #掌门1对1[话题]# #网课[话题]# #线上课[话题]# #学霸养成[话题]# #线上线下课[话题]# #学霸秘籍[话题]##学习规划[话题]# #学习经验[话题]# #学习干货[话题]#', 'video_url': 'http://sns-video-bd.xhscdn.com/stream/79/110/259/01e9a826352fc412010370039cb8d8cb53_259.mp4', 'time': 1772627714000, 'last_update_time': 1772627714000, 'user_id': '669f40a3000000001e00b482', 'nickname': '掌门1对1逆袭', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6729d05045dcad0001e0ab91.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603042135/317d1dce016ed07c96907d184a5cdfba/spectrum/1040g0k031t9sv5rr5a005pkv82hnhd42eqt2d9g!nd_dft_wlteh_webp_3', 'tag_list': '掌门一对一,掌门1对1,网课,线上课,学霸养成,线上线下课,学霸秘籍,学习规划,学习经验,学习干货', 'last_modify_ts': 1772631302730, 'note_url': 'https://www.xiaohongshu.com/explore/69a82702000000001b0158ad?xsec_token=ABnvIy8YG46cQOPm-Ta-dez7IT4s3xgqqQqFqLUyWq7ec=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABnvIy8YG46cQOPm-Ta-dez7IT4s3xgqqQqFqLUyWq7ec='}
