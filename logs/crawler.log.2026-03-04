2026-03-04 14:00:03 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a16b920000000015022ecf', 'type': 'normal', 'title': '别瞎跟！这才是小学娃该有的数学开窍规划！', 'desc': '家有小学生的爸妈谁没崩溃过😮\u200d💨\n计算粗心、应用题看不懂、一到三年级就滑坡\n刷题刷到哭，成绩还是上不去\n其实不是娃不努力，而是底层思维没打通！\n\t\n小学数学拼的不是死记硬背\n是逻辑、建模、数形结合的思维力✨\n只会套公式=一听就会一做就废\n思维开窍=举一反三、越学越轻松\n\t\n试遍方法，终于挖到Mathplore新加坡数学\n精准踩中小学娃学习痛点，科学开窍不费妈\n✅CPA教学法：具象→形象→抽象，难懂概念变直观，应用题不再卡壳\n✅学习资源丰富：对标新课标，65%校内基础+35%竞赛拓展配置，校内同步+竞赛拔高两不误\n✅名校师资+精品小班：老师全是名校背景，不仅教知识，更教怎么思考，课上会引导孩子一步步推理，每节课内容能精准吃透\n✅ 家长省心：支持随时监课，还有课后回放，疑问也有专人实时解答\n\t\n从数感、运算到逻辑、推理\n一步步搭建数学思维框架\n低年级打地基，高年级稳提升\n告别盲目报班，不走弯路不内耗\n\t\n数学开窍真的不用鸡娃\n找对方法，普通娃也能变学霸💯\n小学黄金期别浪费，思维练对，初高中都省力\n🔥现在戳即可0元get价值1888元的数学学习大礼包哦\n名额有限，先到先得～\n——\n活动时间：即日起至2026年12月31日\n*面向18＋海外用户群体\n#Mathplore新加坡数学[话题]# #Mathplore[话题]# #数学思维[话题]# #小学数学怎么学[话题]# #小学数学思维训练[话题]# #数学网课[话题]# #小学数学[话题]# #新加坡数学[话题]# #数学学习[话题]#', 'video_url': '', 'time': 1772186514000, 'last_update_time': 1772186515000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '3', 'share_count': '1', 'ip_location': '四川', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041400/77cac3971f5ee4370d57d0662b4fd887/spectrum/1040g0k031t3ahguk58005odiop740t80vfk35gg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041400/54cdb18c3ed24ef0f0ace7956395eb84/spectrum/1040g0k031t3ahguk580g5odiop740t80kl3hdr0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041400/2191e7a66ea15f85a3da02ef563f686a/spectrum/1040g0k031t3ahq3bla005odiop740t80g61r0l8!nd_dft_wlteh_webp_3', 'tag_list': 'Mathplore新加坡数学,Mathplore,数学思维,小学数学怎么学,小学数学思维训练,数学网课,小学数学,新加坡数学,数学学习', 'last_modify_ts': 1772604003300, 'note_url': 'https://www.xiaohongshu.com/explore/69a16b920000000015022ecf?xsec_token=ABr_9yVr-hrBc-EABFGIVzVddjw1DxiK-KZ5HkC8idku4=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABr_9yVr-h