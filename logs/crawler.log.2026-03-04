2026-03-04 17:17:58 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a682f80000000015039e76', 'type': 'normal', 'title': '高三有想一对一补弱拔高的吗？100+/课时❗', 'desc': '高三真的别再硬扛了！！家长们👋\n你家娃是不是也这样：\n❌ 天天刷题，成绩一动不动\n❌ 基础漏洞多，越学越慌，简单题粗心，难题不会\n❌ 上课听懂，一考就废，弱科拖后腿，强科冲不上去\n越到后期越焦虑，方法不对，努力全白费！\n-\n家长们👋刷再多题，真不如精准补漏一次💥\n直接来【掌门高中一对一网课】👇\n✅ 靶向定位薄弱点，不做无用功\n✅ 老师全程1V1盯着学，效率直接拉满\n✅ 弱科补牢、强科拔高，稳步提分\n✅ 语数英、物化生全覆盖，节奏完全适配，越学越有信心\n-\n➡️ 课前：精准学情诊断，摸清薄弱模块、知识漏洞和高频丢分点📋，量身定制高三专属冲刺计划，不浪费一分一秒，真正靶向突破。\n.\n➡️ 课中：1 对 1 真人直播授课，拒绝大锅饭式复习，老师针对性讲考点、拆题型、梳思路，高频互动、实时答疑，让孩子吃透高考核心考点，解题思路一通百通，做题又快又准。\n.\n➡️ 课后：专属习题 + 精准批改，每道题逐题精讲 + 思路拆解 + 答题模板，同类题型举一反三，孩子不再 “换题就懵”，错题当天清，弱点当天补。\n.\n➡️ 全程陪伴式督学：老师全程跟进学习进度，24h 在线答疑，定期向家长推送学情报告，复习效果看得见，家长更放心。\n-\n🌈 现在点击下方⬇【立即咨询】还能 0⃣元领取👉🏻1V1 体验课～\n🉐 1 对 1 专属辅导➕个性化学习计划➕学习资料\n-\n🔍 报名要求：32 岁以上家长\n⏰ 截止时间：即日起 - 2026 年 12 月 31 日\n#掌门一对一[话题]#  #掌门[话题]#  #掌门1对1[话题]#  #高中[话题]#  #高中家长必看[话题]#  #高中学习规划[话题]#  #高三[话题]#  #高三数学[话题]#  #高三英语[话题]#  #高三物理[话题]#', 'video_url': '', 'time': 1772523840000, 'last_update_time': 1772520184000, 'user_id': '649a70220000000010036bfc', 'nickname': '掌门1对1学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31pumqmjhls005p4qe0h46qvs49pjit8', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '上海', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041717/3ef69324e2f6fcc2c7842fb3e98107a3/spectrum/1040g0k031t89msi46e005p4qe0h46qvs393din0!nd_dft_wlteh_webp_3', 'tag_list': '掌门一对一,掌门,掌门1对1,高中,高中家长必看,高中学习规划,高三,高三数学,高三英语,高三物理', 'last_modify_ts': 1772615878496, 'note_url': 'https://www.xiaohongshu.com/explore/69a682f80000000015039e76?xsec_token=ABzDDpMxlCbuHHbn2MYrMCzhSoJzGmJKsIvvvIJBYkjEk=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABzDDpMxlCbuHHbn2MYrMCzhSoJzGmJKsIvvvIJBYkjEk='}
