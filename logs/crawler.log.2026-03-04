2026-03-04 14:05:22 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6990213f000000001503b32a', 'type': 'video', 'title': '娃学数学太费妈❓跟Mathplore不走弯路', 'desc': '说真的，不是我吹❗一周2节新加坡数学直播课，直接解救了我这个陪读老母亲，也让6岁儿子彻底数学开窍，进步快到我惊讶！\n\t\n👉让我省心的是，它不搞枯燥灌输，形式上寓教于乐，把数学融入趣味互动里，娃上课主动参与，再也不用我催着坐端正\n\t\n👉内容上更贴心，既能稳稳衔接校内课本，又有专属思维拓展练习，不用额外刷题，基础和提升一步到位。\n\t\n专注5-12岁娃数学思维培养，Mathplore的核心优势是真能打💪\n\t\n✅ 2-6人精品小班，不凑数更高效\n\t\n都是同水平娃组班，搭配动态交互式课件，课堂全程高能互动，娃能紧跟节奏，不走神、不掉队，老师也能兼顾到每个孩子。\n\t\n✅ 优质名师坐镇，实力拉满\n\t\n录取率仅1.2%，平均教龄5年+，不仅摸透主流教纲规律，讲解还特别耐心细致，娃听得懂、能吸收。\n\t\n✅ CPA教学法，帮娃真正开窍\n\t\n从实物传递信息，到图像理解数量关系，再到算式表达，一步步引导娃吃透逻辑，以前看不懂的抽象难题，现在一眼就能找到解题思路！\n\t\n还有超多贴心亮点✨：\n➡40-50分钟一节，有趣有料不拖沓\n\t\n➡全中/全英班型可选，同价可灵活选择\n\t\n➡65%校内基础+35%思维练习，兼顾吃透知识点和培养举一反三能力\n\t\n➡五师全程辅导+录播回放，娃遇到难题随时有人解。\n\t\n👉 点击【立即咨询】就能0元领取1888元试听大礼包，名额有限、先到先得~\n\t\n⏰ 活动时间：即日起-2028年12月31日 |\n*面向18＋海外家长群体\n\t\n#Mathplore[话题]#  #新加坡数学[话题]#  #数学思维[话题]#  #小学数学思维训练[话题]#  #小学数学[话题]#  #数学[话题]#  #数学学习[话题]#  #数学网课[话题]#  #儿童逻辑思维[话题]#  #思维训练[话题]#', 'video_url': 'http://sns-video-hs.xhscdn.com/stream/79/110/259/01e9902109282cf7010370039c5b01fc73_259.mp4', 'time': 1771459236000, 'last_update_time': 1771053376000, 'user_id': '61b2c64e0000000010007500', 'nickname': 'Mathplore国际数学咨询', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6560918549c0660001b70cc8.jpg', 'liked_count': '2', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '四川', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041405/ee188f3602fa70b4dde85641378805c7/spectrum/1040g34o31sie94h7l8105odiop740t800jabfm0!nd_dft_wlteh_webp_3', 'tag_list': 'Mathplore,新加坡数学,数学思维,小学数学思维训练,小学数学,数学,数学学习,数学网课,儿童逻辑思维,思维训练', 'last_modify_ts': 1772604322370, 'note_url': 'https://www.xiaohongshu.com/explore/6990213f000000001503b32a?xsec_token=ABv0Z38lOPVjC18nF1xWp_0npRoLHz7gOuym003R7jq4k=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABv0Z38lOPVjC18nF1xWp_0npRoLHz7gOuym003R7jq4k='}
