2026-03-04 15:15:44 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a6aab6000000002602fc62', 'type': 'video', 'title': '有没有家长上平行线浅奥思维课！1440一整年', 'desc': '🎉🎉L1-L8家长们，天大的好消息❗我们平行线教育，一家做了18年数理思维的老牌机构！\n🎁为了回馈新老学员，直接把数理思维网课价格给到内部底价！\n⚠️【我们为什么敢卖这么便宜❓】\n🎯18年老牌机构的硬底气，不玩虚的！\n🎯超多老学员每年主动续报，口碑说话！\n🎯创始人刘育涛老师曾做过两年公益直播，抱着做公益的心态做教育👍\n💡 为什么L1-L8家长们都信赖平行线？\n1️⃣清北名师直播互动讲堂：根据学员实时状态，灵活调整知识深度（别家录播根本做不到！） 2️⃣ 动态学习闭环：每周直播+每月测评+专项突破\n3️⃣ 良心性价比拉满：15元/课时=名师指导+全套教材+全年伴学服务，仅为线下1/3价格！ - 💡【L1-L8家长一致称赞的硬核服务】\n✅365天真人1V1答疑，拒绝AI敷衍❗\n✅8次专业阶段测评报告，进步看得见❗\n✅每月12次专项小灶课，6-8人一组，老师亲自月度复盘，彻底清理疑难题❗\n⚠️现在市面上的数理思维机构鱼龙混杂，家长们很容易被营销口号忽悠！\n👍但平行线能做18年，拥有庞大的复购老学员群体，靠的就是实实在在的教学质量和口碑❗\n📢别犹豫了！趁着这波内部底价，赶紧给娃安排上！\n✅花同样的钱，享受别人花好几倍钱才能买到的优质学习资源，太划算❗\n📢每天不到4块钱的投资，换孩子数学思维的大突破！\n👇👇点击下方【立即咨询】添加我们老师，即可了解详情\n此内容为仅面向32岁以上家长的素养课\n#数学思维[话题]#  #平行线教育[话题]#  #平行线1440年课[话题]#  #小学数学思维训练[话题]#  #线上线下课[话题]# #小学奥数[话题]# #思维训练[话题]# #浅奥思维[话题]# #思维浅奥[话题]#', 'video_url': 'http://sns-video-hs.xhscdn.com/stream/1/110/259/01e9a6be9bed5285010370039cb358eb74_259.mp4', 'time': 1772530358000, 'last_update_time': 1772535452000, 'user_id': '642ba9780000000012011a80', 'nickname': '平行线名师大课堂', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/f0238b56-4bdd-3597-adf3-db36cfdcf315', 'liked_count': '3', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041515/60cf9722997982e280e4e8ecfc4793d8/spectrum/1040g34o31t8h0bhble105p1bl5s4i6k059e690o!nd_dft_wlteh_webp_3', 'tag_list': '数学思维,平行线教育,平行线1440年课,小学数学思维训练,线上线下课,小学奥数,思维训练,浅奥思维,思维浅奥', 'last_modify_ts': 1772608544143, 'note_url': 'https://www.xiaohongshu.com/explore/69a6aab6000000002602fc62?xsec_token=ABzDDpMxlCbuHHbn2MYrMCzt6lZf6QsW4hD2nqUMfEQm4=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABzDDpMxlCbuHHbn2MYrMCzt6lZf6QsW4hD2nqUMfEQm4='}
