2026-03-04 13:02:43 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '699036a000000000150206e4', 'type': 'video', 'title': '数学思维开窍！赶超前排就这么简单！', 'desc': '家有数学不开窍的娃，真的太磨人了😫\n基础薄弱、做题没思路，换个题型就懵；抵触数学不说，写作业还拖延，计算错误百出，家长急破头也没用！\n\t\n还好@杨杨杨的一二三 选择了✅ Mathplore新加坡数学思维直播课，专为5-12岁娃量身打造，不用奔波跑机构，在家就能学，轻松帮娃打通数学任督二脉，赶超前排超简单！\n\t\n不同于普通数学课，它精准戳中娃的数学痛点，每一步都踩在娃的学习需求上🤩\n\t\n📌 精准学情诊断：课前专属测评，不管是算题依赖掰手指，还是应用题找不到突破口，都能精准揪出问题根源，不盲目补课；\n\t\n📌 个性化学习方案：结合G0-G6分龄体系，根据测评结果量身定制，从基础夯实到思维拓展，完全贴合娃的节奏，不超前、不落后；\n\t\n📌 趣味建模教学：采用CPA教学法，把抽象数学转化成“图形积木”，应用题一画就懂，不用死记硬背公式；2-6人精品小班，动画+闯关游戏，让娃主动学、不抵触；\n\t\n📌 专业课后跟进：专属习题匹配课堂内容，老师逐题批改、详解错因，还会发送详细学习报告，娃的进步看得见，家长不用费心盯梢。\n\t\n✅ 2-6人小班授课，每个娃都能被重点关注；\n\t\n✅ 一节40-50分钟，时长科学，学透知识点不疲劳；\n\t\n✅ 中/英文授课语言可选，学数学还能兼顾英语提升\n\t\n✅ 师资严格筛选，5年+教学经验，层层考核把关。\n\t\n🔥重点福利来啦！现在咨询即可0元直接解锁1888元试听大礼包！\n\t\n名额有限、先到先得！\n\t\n⏰活动时间：即日起至2028年12月31日，面向18+海外家长人群～\n\t\n让娃告别数学焦虑，轻松开窍，赶超前排，就从这节试听课开始✨\n\t\n#数学思维[话题]#  #让孩子爱上数学[话题]#  #数学网课[话题]#  #Mathplore[话题]#  #Mathplore新加坡数学[话题]#  #数学思维训练[话题]#  #小学数学学习方法[话题]# #小学数学怎么学[话题]#', 'video_url': 'http://sns-video-bd.xhscdn.com/stream/1/110/259/01e99036697c86e8010370039c5b55eb3e_259.mp4', 'time': 1771152480000, 'last_update_time': 1771058849000, 'user_id': '6504601f0000000017021a03', 'nickname': 'Mathplore数学思维', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/e6f9e621-2070-3494-bab8-b0f3f41001c0', 'liked_count': '1', 'collected_count': '1', 'comment_count': '1', 'share_count': '1', 'ip_location': '四川', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041302/f0370867b0001314640bb30f52da27cc/spectrum/1040g0k031sigsjrpl8005p84c0fls6g3an1qj58!nd_dft_wlteh_webp_3', 'tag_list': '数学思维,让孩子爱上数学,数学网课,Mathplore,Mathplore新加坡数学,数学思维训练,小学数学学习方法,小学数学怎么学', 'last_modify_ts': 1772600563956, 'note_url': 'https://www.xiaohongshu.com/explore/699036a000000000150206e4?xsec_token=ABv0Z38lOPVjC18nF1xWp_0hmSOGtEluGg3ohmJ9mcSvs=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABv0Z38lOPVjC18nF1xWp_0hmSOGtEluGg3ohmJ9mcSvs='}
