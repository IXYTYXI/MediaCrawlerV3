2026-03-04 19:10:06 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a02e5f000000001503a21c', 'type': 'video', 'title': '解救高中“数学困难户”，我的提升思路👆', 'desc': '数学卷子一发就心慌❓️\n公式记不住、题目没思路、考试总卡壳…\n明明很努力，分数却一动不动❓️\n不是娃不认真，而是方法没找对！\n-\n那这个寒假别再盲目刷题了！\n真正的提升需要👉精准诊断+系统规划\n✨️【掌门一对一高中数学网课】帮娃彻底打破瓶颈，让数学从弱项变强项‼️\n-\n✅科学诊断，专治“不会学”：先摸底测试，找出孩子的知识薄弱点，不再浪费时间盲目复习\n✅定制计划，告别“瞎努力”：清北毕业老师为娃量身设计学习路径，每一步都朝着提升目标稳扎稳打\n✅系统拆解，难点变简单：从课本入手，梳理知识框架，带孩子真正吃透题型，举一反三\n✅实时答疑，问题不过夜：随时提问随时解决，不留知识死角，学习路上有人随时护航\n✅灵活学习，高效省时：网课随时上，免去奔波，让娃专注投入，效率翻倍\n-\n数学逆袭不是奇迹，而是用对方法✔️\n找准问题、漏洞补上、把思路打通！下一次kao试就是翻盘机会！\n-\n💡现在点击下方直播入口，0元就能领一节试听课\n还🈶1对1专业辅导+定制专属计划+高中数学学习资料！\n名额有限，先到先得！！！！！\n-\n🌈报名要求：32岁以上家长\n⏰截止时间：即日起-2026年12月31日\n#掌门[话题]#  #掌门一对一[话题]#  #掌门1对1[话题]#  #高中[话题]#  #高中学习方法[话题]#  #高一[话题]#  #高二[话题]#  #高三[话题]#  #网课日常[话题]#', 'video_url': 'http://sns-video-qc.xhscdn.com/stream/79/110/259/01e9a02e4d4d2522010370039c99b59eaf_259.mp4?sign=aef970788698a943d6bc2c36e6957e5a&t=69acb04e', 'time': 1772105311000, 'last_update_time': 1772105312000, 'user_id': '6735499c000000001600b1b9', 'nickname': '掌门1对1学习规划', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/67498a5d4010f300017a590c.jpg', 'liked_count': '1', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '上海', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041910/2bb4b6daf3117904c0c23497775fd507/spectrum/1040g34o31t23sfrv58105ppl96e5hcdpepc180o!nd_dft_wlteh_webp_3', 'tag_list': '掌门,掌门一对一,掌门1对1,高中,高中学习方法,高一,高二,高三,网课日常', 'last_modify_ts': 1772622606199, 'note_url': 'https://www.xiaohongshu.com/explore/69a02e5f000000001503a21c?xsec_token=AB4201y3j7SF6bEqhP2ezZnNgVz4RAH9lrj9UiXITLm-U=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB4201y3j7SF6bEqhP2ezZnNgVz4RAH9lrj9UiXITLm-U='}
