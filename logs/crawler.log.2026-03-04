2026-03-04 11:26:36 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '675fe19a000000000b016f72', 'type': 'normal', 'title': '25袋鼠竞赛老师盯着学，一次拿下🏆', 'desc': '妈妈们，25年袋鼠数学竞赛都报名了吗？\n如果你家有正在L1-L12年级的孩子，一定要来试试🦘袋鼠国际竞赛，培养🧠数学逻辑和思维能力！还能帮助在其他竞赛和考试中游刃有余🎉\n现在推荐来Spark Math，pm或留言0元试听数学课\n-\n🧑\u200d🏫有专业老师带领、针对性辅导，不仅能理解题目背后的思路，还能掌握灵活解答技巧。\n📕采用CPA教学法，一步步提升思维能力、解决问题的速度，不学死知识。\n🧑\u200d🏫小班在线直播，老师能关注到每一个孩子的学习状态。\n-\n现在点击⬇【立即咨询】领取0元试听课，寒假开始学🎉\n⏰活动时间：即日起至2025年12月31日\n*面向18+海外家长用户群体\n\t\n\ufeff#小学数学怎么学[话题]#\ufeff \ufeff#小学数学思维训练[话题]#\ufeff \ufeff#小班课[话题]#\ufeff \ufeff#新加坡数学[话题]#\ufeff \ufeff#新加坡数学思维[话题]#\ufeff \ufeff#数学思维[话题]#\ufeff \ufeff#思维训练[话题]#\ufeff\ufeff#袋鼠数学[话题]#\ufeff \ufeff#袋鼠数学竞赛[话题]#\ufeff \ufeff#国际数学竞赛[话题]#\ufeff', 'video_url': '', 'time': 1734336922000, 'last_update_time': 1734336922000, 'user_id': '61b2fc7e000000001000f059', 'nickname': 'Spark Math线上课程', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4aeb79ls6g5odivhv41s2pgohmd30', 'liked_count': '1', 'collected_count': '', 'comment_count': '', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041126/51efd34b615b3731c59b9b169bd3578d/spectrum/1040g34o31bfag160gc205odivhv41s2pagec8ao!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041126/faa746178648220be0798b76f428b586/spectrum/1040g34o31bfag160gc2g5odivhv41s2pimjjkp8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041126/8f4ce9457f0323e3ce55ea2c41b1c46c/spectrum/1040g34o31bfag160gc305odivhv41s2p07qh76o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041126/ff03cb08ae0041f874c0f5238e9c1331/spectrum/1040g34o31bfag160gc3g5odivhv41s2pd2cso98!nd_dft_wlteh_webp_3', 'tag_list': '小学数学怎么学,小学数学思维训练,小班课,新加坡数学,新加坡数学思维,数学思维,思维训练,袋鼠数学,袋鼠数学竞赛,国际数学竞赛', 'last_modify_ts': 1772594796703, 'note_url': 'https://www.xiaohongshu.com/explore/675fe19a000000000b016f72?xsec_token=ABGjHDg7Kwdhyt3oXrnmS_6Zs3hUeX1rEkyk9gCQt0KRA=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token