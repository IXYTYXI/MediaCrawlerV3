2026-03-04 12:25:44 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a16e7e000000001d010f5a', 'type': 'video', 'title': '从垫底到学霸👉全靠这个数学思维学习计划', 'desc': '孩子数学越学越吃力🤯 多少妈妈在崩溃边缘反复横跳？\n\t\n👉天天陪着娃刷题到深夜，试卷上还是红叉一片\n\t\n👉公式背得滚瓜烂熟，换个题型就瞬间懵圈\n\t\n👉应用题读半天，连题干逻辑都理不清，成绩一路垫底，娃自卑、妈心累！\n\t\n别再死磕刷题了！无数宝妈亲测验证：孩子数学开窍，从来不是“刷”出来的，而是“想”出来的！数学的核心，从来不是堆砌知识，而是打好数学思维地基🏗️\n\t\n选对数学思维训练方法，垫底娃也能逆袭成学霸！Mathplore新加坡数学直播课，精准戳中娃数学痛点，凭实力圈粉无数学霸妈妈，成为数学开窍首选✨\n\t\n✅ 新加坡CPA教学法：用图形化思维拆解抽象数学，把枯燥公式、复杂题目变成直观画面，孩子一看就懂、一学就会，彻底吃透原理不混淆\n\t\n✅ 科学思维进阶路径：贴合5-12岁孩子认知规律，阶段重点突破2-3个核心思维模块，循序渐进不跳跃，稳步搭建系统化数学思维\n\t\n✅ 2-6人精品直播课：游戏化互动+高频答疑，孩子抢着参与、主动思考，在同伴交流中梳理思路，慢慢养成举一反三的能力\n\t\n✅ 告别题海战术：资深名师带学，精讲经典题型，掌握1道题就能搞定100道同类题，省时又高效，家长彻底解放\n\t\n🔥 宠粉福利来袭！现在点击左下角【立即咨询】可0元get价值1888元试听大礼包！\n\t\n名额有限，先到先得，手慢无！\n\t\n活动时间：即日起至2028年12月31日\n*面向18＋海外家长\n\t\n#新加坡数学[话题]#  #小学数学[话题]#  #数学思维训练[话题]#  #数学开窍[话题]#  #Mathplore[话题]#  #小学数学逆袭[话题]#  #数学思维[话题]# #Mathplore新加坡数学[话题]#', 'video_url': 'http://sns-video-bd.xhscdn.com/stream/79/110/259/01e9a16e2f2c1bc6010370039c9e97b25f_259.mp4', 'time': 1772198101000, 'last_update_time': 1772187262000, 'user_id': '5ff43d2b0000000001001995', 'nickname': 'Mathplore线上数学', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/640f03dce33a6ed3c5116b3d.jpg', 'liked_count': '1', 'collected_count': '1', 'comment_count': '1', 'share_count': '', 'ip_location': '四川', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041225/938270901492dfaa882cb8f435aa4041/spectrum/1040g34o31t3au5stle105nvk7klg86cldfnavt8!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学,小学数学,数学思维训练,数学开窍,Mathplore,小学数学逆袭,数学思维,Mathplore新加坡数学', 'last_modify_ts': 1772598344811, 'note_url': 'https://www.xiaohongshu.com/explore/69a16e7e000000001d010f5a?xsec_token=ABr_9yVr-hrBc-EABFGIVzVUpty2Kw4uKOUV6ag49f8-g=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABr_9yVr-hrBc-EABFGIVzVUpty2Kw4uKOUV6ag49f8-g='}
