2026-03-04 15:16:01 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a67fa1000000002203b646', 'type': 'normal', 'title': '有没有想要在家学浅奥，一周2小时直到开窍', 'desc': '1-8阶家长注意！有没有想要在家学浅奥，一周2小时直到开窍！\n孩子高年级数学差距越拉越大，真不是天赋问题，而是思维没早培养！小学正是黄金期，错过再补太难💪！\n中优生别只盯课本，一定要练浅奥思维——不刷难题，重点练逻辑、想象、拆解能力，数学开窍、全科都受益📈。\n🧠为什么选「平行线」更适合？\n1️⃣ 顶尖名师天团亲授✨ 北京奥数名师陈平、两届IMO金牌罗炜、平行线创始人刘育涛带队，真人直播+实时答疑，贴合1-8年级认知，听得懂、学得活！\n2️⃣ 高性价比优选🪙 低至15元/课时，无溢价，钱全花在师资和服务上，普通家庭也能轻松学，低成本搭建思维体系！\n3️⃣ 闭环教学强保效📊 紧扣新课标，校内巩固+浅奥拓展一步到位。双师伴学、阶段测评、1对1答疑，搭配专属学习规划，进步看得见！\n4️⃣ 分层适配更精准📚 笃学班｜睿学班｜创新班任选！ 入门、提优、拔高都能匹配，不浪费孩子每一分努力！\n⏳【限时福利·春季抢跑开启】 低至15元/课时，名额有限，招满即止！\n适合想拓展思维、稳步提优的中小学生，为初高中理科打牢基础！\n👇点击【立即咨询】，测孩子思维水平，锁定适配班型，给孩子一次思维突破的机会🏆！\n#平行线教育[话题]# #思维训练[话题]# #小学奥数[话题]#   #数学思维[话题]#   #数学素养[话题]#     #平行线1440年课[话题]#   #家长必看[话题]#  #浅奥思维[话题]#   #奥数思维[话题]#', 'video_url': '', 'time': 1772519329000, 'last_update_time': 1772519329000, 'user_id': '642ba9780000000012011a80', 'nickname': '平行线名师大课堂', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/f0238b56-4bdd-3597-adf3-db36cfdcf315', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041516/2b3b48f4ca73787a8dca1ed65d886369/spectrum/1040g34o31t8950r15e105p1bl5s4i6k09t84cfo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041516/31d917a9706572b831605d7870e5bb2d/spectrum/1040g34o31t895fd6le105p1bl5s4i6k0e25s458!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041516/83a52b5d56a318d10895c757b767c0e7/spectrum/1040g0k031t895ldnl8005p1bl5s4i6k0ieh2vao!nd_dft_wlteh_webp_3', 'tag_list': '平行线教育,思维训练,小学奥数,数学思维,数学素养,平行线1440年课,家长必看,浅奥思维,奥数思维', 'last_modify_ts': 1772608561110, 'note_url': 'https://www.xiaohongshu.com/explore/69a67fa1000000002203b646?xsec_token=ABzDDpMxlCbuHHbn2MYrMCztSFXzTgtg4KElPn7kafPVk=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABzDDpMxlCbuHHbn2MYrMCztSFXzTgtg4KElPn7kafPVk='}
