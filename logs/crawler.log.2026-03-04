2026-03-04 11:32:17 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '699e95ed0000000015039f72', 'type': 'normal', 'title': '别家娃在刷题，我家在SparkMath开窍', 'desc': '救命！开学第一周，邻居家娃已经开始领跑了？😭\n再让娃在题海里瞎忙活了！数学要赢，靠的不是手速，而是脑回路！\n跟sparkmath（火花新加坡数学）开启抢跑模式，让娃在开学季直接开启“降维打击”！\n-\n🤔 为什么选sparkmath新加坡数学能稳赢？👇\n🚀逻辑“黑科技”｜CPA教学法\n拒绝死记硬背！用建模把抽象问题变乐高一样简单，娃快速穿插题目陷阱，做题速度快到飞起！\n🏆详细“超车仪”｜分层教学体系\n80%校内基础+20%竞赛拓展，不仅稳定住校内前排，还能提前布局AMC8/袋鼠数学思维，全方位拉开差距\n🔥专注“稳定器”｜小班高频互动\n拒绝“云听课”！名师全程在线问答，每一分钟都在动脑筋，娃上课比看动画还专注，老母亲彻底解放。\n✅服务“全家桶”｜三师一体督学\n课前预习+课中互动+课后反馈+24小时答疑+定期考核！不用家长督学，进度透明看得见，省心到家！\n-\n别家娃还在焦虑开学，咱家娃已经掌握了“开窍密码”！\n⏳开学前2周是建立数学自信的黄金期，早抢跑，早赢麻！\n现在点击左下角↙【立即咨询】 0元锁定价值3288元开学大礼包\n📅活动时间：即日起至2026年3月31日\n#sparkmath[话题]# #sparkmath新加坡数学[话题]# #新加坡数学[话题]# #小学开学[话题]# #小学数学[话题]# #数学启蒙[话题]# #幼小衔接[话题]# #开学季抢跑[话题]# #数学学习[话题]# #国际数学竞赛[话题]#', 'video_url': '', 'time': 1772000749000, 'last_update_time': 1772000749000, 'user_id': '64740b96000000000f006adf', 'nickname': 'Spark Math 数学课程', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo30oe65qe8ie5g5p3k1eb3oqmvph5fk6g', 'liked_count': '', 'collected_count': '', 'comment_count': '3', 'share_count': '1', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041132/c199bf1cd9ced2675b0f06fcb9f51ae5/spectrum/1040g0k031t0ho7url6005p3k1eb3oqmvn7l1kr0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041132/6f87f8798bc03f6e04136ae9cbe1661d/spectrum/1040g0k031t0ho8qjl8005p3k1eb3oqmvtqlqjmg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041132/85643f99f0dec0f457287fbc0aa18ec4/spectrum/1040g0k031t0ho9hc5e005p3k1eb3oqmveej0ko0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041132/e2a2f4b3164911ecae245ffcefc814ed/spectrum/1040g34o31t0hoag256105p3k1eb3oqmv794fvbg!nd_dft_wlteh_webp_3', 'tag_list': 'sparkmath,sparkmath新加坡数学,新加坡数学,小学开学,小学数学,数学启蒙,幼小衔接,开学季抢跑,数学学习,国际数学竞赛', 'last_modify_ts': 1772595137983, 'note_url': 'https://www.xiaohongshu.com/explore/699e95ed0000000015039f72?xsec_token=AB2iCfwYPnG