2026-03-04 15:37:30 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a2957c0000000023038196', 'type': 'normal', 'title': '高中数学想冲130+？1人1班线上课等你来💯', 'desc': '数学卡在110上不去？中档题全会，压轴题全废。\n白天学校节奏太快，晚上自己刷题效率太低。\n想冲130+，却总差那临门一脚？\n每晚抽出2h，听掌门一对一线上一人一班数学定制课，只为让你冲刺高分！\n🎯 为什么晚班提分效果翻倍？\n✅ 清北名师领衔，专攻“高分瓶颈期”\n• 清北、985/211严选授课导师，深谙压轴题命题规律与得分技巧\n• 不教基础题重复练，专讲导数、解析几何、新定义题型等“拉分题”\n✅ 课程体系直击130+，每一题都是得分点\n• 入学先做“潜力诊断”，定位你离130还差哪些必会题\n• 20:00-22:00 黄金2小时：前1小时专题突破，后1小时实战带练\n• 一人一班，节奏完全跟着你走，讲到你真会为止\n✅ 督学团队全天在线，问题不过夜\n• 主讲老师实时互动，卡壳随时打断、随时讲透\n• 课后专属巩固练习+随时答疑，当天学的当天消化\n• 每周学情报告同步，进步轨迹清晰可见\n-\n🚀 跟着掌门一对一全力冲击高中数学130+！\n⬇️ 点击下方【立即咨询】0元领1对1诊断课！\n📢 仅限32岁以上家长\n⏰ 截止：即日起-2026年12月31日\n#掌门[话题]#  #掌门一对一[话题]#  #学习规划[话题]#  #家长必看[话题]#  #高三[话题]#  #高二[话题]#  #高一[话题]#  #高中数学[话题]#  #开学考试[话题]#  #数学逆袭[话题]#', 'video_url': '', 'time': 1772273581000, 'last_update_time': 1772262781000, 'user_id': '649e933900000000140344d9', 'nickname': '掌门1对1特训营', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/65e0143c21adbc000145da44.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '上海', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041537/e45433f8d4ff562119510c6ca479a5c6/spectrum/1040g34o31t4evbf56e105p4uicsl6h6p8snoldg!nd_dft_wlteh_webp_3', 'tag_list': '掌门,掌门一对一,学习规划,家长必看,高三,高二,高一,高中数学,开学考试,数学逆袭', 'last_modify_ts': 1772609850725, 'note_url': 'https://www.xiaohongshu.com/explore/69a2957c0000000023038196?xsec_token=ABOd9DKaujxPmBXwmUsK9eVwO4NdlAzfVzN8DDdsq6JN8=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABOd9DKaujxPmBXwmUsK9eVwO4NdlAzfVzN8DDdsq6JN8='}
