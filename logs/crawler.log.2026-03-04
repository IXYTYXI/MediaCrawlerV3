2026-03-04 14:25:18 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a00b3a000000001600a720', 'type': 'normal', 'title': '跟着Mathplore数理开窍后，做题就像抄答案', 'desc': '别等到了三年级孩子数学跟不上才后悔！\n❌定义记不住❌题目看不懂❌越学越吃力...\n\t\n根本原因还是孩子没有掌握数学思维！\n我家娃跟着Mathplore新加坡数学直播课\n一周2节，不背公式，只练逻辑\n\t\n一个月，冲进班级前3️⃣🏆\nMathplore到底是怎么做到的✨？\n\t\n🤩告别大班摸鱼！Mathplore坚持2-6人精品小班，老师能关注每个孩子的解题步骤与思维漏洞\n🤩重视思维培养，CPA教学法+趣味课件，直观复现思考过程、总结规律，孩子自己就能推导公式\n🤩全职主讲名师团，名校毕业，国际化教学经验丰富，深谙主流教纲教学要求\n\t\n课后轻量化练习，只练重点、难点\n五师线上“云陪读”，随时答疑响应及时\n📝入学测评+学练结合+课后跟盯，省心又省妈\n\t\n✅适合5-12岁思维提升\n✅一周2次直播|40-50分钟一节\n✅全中/全英双班型，二选一\n✅100%覆盖小学数学重难点\n-\n📌 点击【立即咨询】0 元预约试听课\n⏰ 活动时间：即日起至 2027 年12月31日\n* 仅面向海外 18 + 家长，名额有限，先到先得❗️\n#新加坡数学[话题]# #Mathplore[话题]# #数学思维题[话题]# #三年级数学[话题]# #数学思维[话题]# #数学开窍[话题]# #小学数学[话题]# #数学[话题]# #思维训练[话题]# #数学干货[话题]#', 'video_url': '', 'time': 1772096314000, 'last_update_time': 1772096315000, 'user_id': '66c854d2000000001d022cac', 'nickname': 'Mathplore数学开窍', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31djmkng2h66g5pm8aj97cb5cr77jngg', 'liked_count': '2', 'collected_count': '3', 'comment_count': '1', 'share_count': '', 'ip_location': '四川', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041425/e1126122b4f283c82bed280bed2b2dec/spectrum/1040g34o31t1vi633lc505pm8aj97cb5c7rsiu0g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041425/d0fc3d6d2fbfbe81815beee5f1d8530e/spectrum/1040g34o31t1vi633lc5g5pm8aj97cb5c75brvhg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041425/8307b9e958daa449b1925f579e71d5d7/spectrum/1040g34o31t1vi633lc605pm8aj97cb5chijhgoo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041425/d7c93d5e24118628f93c50a5b5296d35/spectrum/1040g34o31t1vi633lc6g5pm8aj97cb5cc129uf8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041425/c7a54cac8ce54827a456c36802581972/spectrum/1040g34o31t1vi633lc705pm8aj97cb5ccms7me8!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学,Mathplore,数学思维题,三年级数学,数学思维,数学开窍,小学数学,数学,思维训练,数学干货', 'last_modify_ts': 17