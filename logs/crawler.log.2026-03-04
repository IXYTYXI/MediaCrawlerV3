2026-03-04 17:16:49 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a79580000000001b014e05', 'type': 'video', 'title': '高三语文不拖后腿的秘诀，都在一对一啦！', 'desc': '😭家有高中生的都懂！\n高三一到语文考试，阅读理解直接成重灾区！\n文章读不懂、题干看不明白，答题全靠瞎蒙😰\n要么答非所问，要么没答到采分点，分数哗哗的😫\n别慌！高中语文阅读真的不用死磕！\n找对答题思路，提升又快又👌稳，轻松甩开同龄人！\n试试✨️【掌门1对1】高中语文阅读理解网课\n-\n💥每天1小时直播课上，名师手把手带练：\n✅拆解题型模板，快速定位答案区间\n✅理清文章逻辑，再也不被题干绕晕\n✅针对性刷题复盘，越做越快、越练越准\n·\n👩🏻🏫师资过硬！\n老师多来自清北等名校，懂考点、懂高中生痛点，不讲空话，只教能直接用上的答题技巧，彻底摆脱阅读拖后腿的困境\n·\n🍃课前：精准学情测评，排查阅读、作文等薄弱点，量身定制学习方案🔥\n🍃课中：一对一精讲，难点细拆、疑点速解，专注度拉满🔥\n🍃课后：精细批改+错题解析，闭环巩固，学完就练、练完就会🔥\n·\n⬇️点击左下方【立即咨询】免费领取\n🔥直播试听课+1V1学习规划+海量学霸资料\n.\n仅面向32岁以上人群\n截止时间：即日起-2027年12月31日\n#掌门一对一[话题]#  #掌门1对1[话题]#  #高中语文[话题]#  #语文网课[话题]#  #差生逆袭[话题]#  #高中学习[话题]#  #家长必看[话题]#', 'video_url': 'http://sns-video-hs.xhscdn.com/stream/79/110/259/01e9a7956b2fc20f010370039cb6a0fb55_259.mp4', 'time': 1772590464000, 'last_update_time': 1772590465000, 'user_id': '649a70220000000010036bfc', 'nickname': '掌门1对1学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31pumqmjhls005p4qe0h46qvs49pjit8', 'liked_count': '', 'collected_count': '1', 'comment_count': '', 'share_count': '', 'ip_location': '上海', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041716/23e85d62b638e3c321c6ed3947c1d6a7/spectrum/1040g0k031t9b7anjl6005p4qe0h46qvslu4mgeg!nd_dft_wlteh_webp_3', 'tag_list': '掌门一对一,掌门1对1,高中语文,语文网课,差生逆袭,高中学习,家长必看', 'last_modify_ts': 1772615809420, 'note_url': 'https://www.xiaohongshu.com/explore/69a79580000000001b014e05?xsec_token=ABvtKkoN-JdN_qRqzuJpkmXN1__LfESg9oFcTu-toyBZo=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABvtKkoN-JdN_qRqzuJpkmXN1__LfESg9oFcTu-toyBZo='}
