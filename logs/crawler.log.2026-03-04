2026-03-04 21:39:18 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a4f4e1000000002801f843', 'type': 'video', 'title': '别不信！数学垫底到三位数！跟1对1学了15天', 'desc': '别不信❗高中数学从班级垫底冲到年级前排，真的可能❗\n只要用对方法，暴涨三位数的逆袭，🔥下一个就是你孩子！\n-\n一提起数学就焦虑？孩子是不是这样：\n❌上课听懂，下课做题就懵，概念公式一团乱麻\n❌试卷一发，基础题失误、中档题卡壳、压轴题直接放弃\n❌刷题无数，成绩却稳如泰山，学习信心备受打击\n-\n如果你也为此头疼，✨请了解一下【掌门一对一的高中数学网课】✨\n清北等背景的名师一对一盯学，💡专治数学不开窍\n-\n💐深度学情诊断，精准“揪”出所有问题\n通过专业摸底诊断学情🔍是公式记忆不牢？解题思路偏差？还是计算习惯粗心？\n一份专属学情报告，彻底看清短板\n-\n💐量身定制方案，只练你该练的，根据诊断，规划专属路径：\n1️⃣基础弱，就带娃回归课本，系统重建知识网络\n2️⃣中档题不稳，就专项训练解题模板\n3️⃣目标是高分，就攻坚压轴题思维，每一步都精准用力😎\n-\n💐动态效果跟踪，保证每一步都在进步！\n✔️课后辅导老师推送孩子专属习题，只练重难点、薄弱点作业精细批改标注📝\n✔️每周学习反馈、每月成效评估清晰可见📉根据进展调整节奏和难度，确保教学匹配状态，越学越有信心💕\n-\n更贴心的是时间地点自由，高效利用每一分钟🙋\u200d♀️\n手机/电脑随时上课，💻省去通勤奔波时间，课程时间灵活预约，在家就能高效学习，特别适合作息紧张的高中生\n-\n🔥数学短板，恰恰是潜力最大的地方\n现在点击左下角头像⬇【进入直播间】0元领取👉🏻1V1体验课~\n🉐1对1专业辅导+定制专属计划+学习资料\n感兴趣的家长们赶紧冲！！！\n-\n📍报名对象：仅面向32岁以上的家长\n📍截止时间：即日起—2026年12月31日\n-\n#掌门一对一[话题]#  #掌门[话题]#  #高中数学[话题]#  #学习方法[话题]#  #家长必看[话题]#  #数学[话题]#  #高一[话题]#  #高二[话题]#  #高三[话题]#  #家长收藏孩子受益[话题]#', 'video_url': 'http://sns-video-bd.xhscdn.com/stream/1/110/259/01e9a4f4db37a298010370039cac5d19b9_259.mp4', 'time': 1772418273000, 'last_update_time': 1772418273000, 'user_id': '669f40a3000000001e00b482', 'nickname': '掌门1对1逆袭', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6729d05045dcad0001e0ab91.jpg', 'liked_count': '23', 'collected_count': '12', 'comment_count': '', 'share_count': '', 'ip_location': '安徽', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603042139/0a925786d90d860ae3e4863cbf68ae94/spectrum/1040g0k031t6p3p0ame0g5pkv82hnhd42mp4p5dg!nd_dft_wlteh_webp_3', 'tag_list': '掌门一对一,掌门,高中数学,学习方法,家长必看,数学,高一,高二,高三,家长收藏孩子受益', 'last_modify_ts': 1772631558032, 'note_url': 'https://www.xiaohongshu.com/explore/69a4f4e1000000002801f843?xsec_token=ABlWMF9ZWvcv5nCo191O-ICExling0UiNtVzzk1ezQEaI=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABlWMF9ZWvcv5nCo191O-ICExling0UiNtVzzk1ezQEaI='}
