2026-03-04 15:38:48 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a1658f000000001b01fd67', 'type': 'normal', 'title': '数学及格线挣扎的娃😭一对一真的有救了', 'desc': '娃的数学是不是还在拖后腿📉？每次考试都在及格线上下徘徊\n❓函数图像变换永远晕，一画就错\n❓几何证明卡壳，辅助线怎么加都想不到点子上😖\n❓公式背了又忘📝，套用起来完全懵\n❓计算粗心，步骤分扣到心碎\n·\n刷题班没少报📚，卷子没少做📄，成绩还是原地踏步\n孩子越学越没信心，看到数学题就头皮发麻……\n·\n数学这门课，真不是靠盲目刷题就能翻身的‼️\n基础不牢、方法不对，刷再多题也是白搭\n·\n【掌门一对一】的高中数学网课来啦🎒！专门收基础差、底子薄的孩子，每天晚上19:00-20:00，📖在家就能跟着清北等老师系统学，把落下的基础补上来⬆️\n·\n✅课前摸底，哪里不行补哪里\n🔸先做专项测评，把函数、几何、概率这些模块彻底摸个底\n🔸失分点在哪、薄弱项是什么，老师心里有数了，🗓️再定制专属提升计划\n·\n✅课中真人露脸直播，全程干货输出\n🔸清北等老师直播带学🎥，不讲废话\n🔸函数怎么数形结合、几何辅助线怎么找、题目陷阱怎么避📊\n🔸边讲边练，孩子哪里卡壳当场就能喊停\n·\n✅课后不留疑问，24h在线答疑\n🔸课上听懂了，做题又卡住？随时可以找老师\n🔸步骤写得不顺、思路卡在半路，老师线上直接点拨，🌙不让问题过夜\n🔸练的每一道题，都是冲着巩固方法去的\n·\n💕真心话：数学差不可怕！！\n可怕的是明明还有时间，却一直拖着不敢面对\n基础越差，老师教起来越有成就感💯，孩子冲起来也越有劲儿\n·\n💪现在点击下方⬇【立即咨询】，还能 0⃣元领取👉🏻1V1体验课～\n🉐1对1专属辅导➕定制学习计划➕数学解题秘籍\n·\n报名要求：32岁以上家长\n#掌门一对一[话题]# #掌门1对1[话题]# #家长必看[话题]# #数学学习[话题]# #数学[话题]# #数学高考题型与技巧[话题]# #高考数学[话题]# #网课推荐[话题]# #网课[话题]# #学习方法[话题]#', 'video_url': '', 'time': 1772184975000, 'last_update_time': 1772184976000, 'user_id': '649e933900000000140344d9', 'nickname': '掌门1对1特训营', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/65e0143c21adbc000145da44.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '1', 'ip_location': '上海', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041538/86062c1018301fe675f7c5875fbb0757/spectrum/1040g34o31t39s4u8l6105p4uicsl6h6pvl3f38o!nd_dft_wlteh_webp_3', 'tag_list': '掌门一对一,掌门1对1,家长必看,数学学习,数学,数学高考题型与技巧,高考数学,网课推荐,网课,学习方法', 'last_modify_ts': 1772609928300, 'note_url': 'https://www.xiaohongshu.com/explore/69a1658f000000001b01fd67?xsec_token=ABr_9yVr-hrBc-EABFGIVzVYdPI9DJHQQjudQx6_nonUA=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABr_9yVr-hrBc-EABFGIVzVYdPI9DJHQQjudQx6_nonUA='}
