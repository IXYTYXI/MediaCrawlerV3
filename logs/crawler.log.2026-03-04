2026-03-04 19:07:21 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a030ab000000001b016585', 'type': 'video', 'title': '如果早知道一对一…娃数学也不至于垫底😰', 'desc': '⚠️⚠️家长们！注意了！你家娃的数学是不是越学越差！！\n每天熬夜刷题，函数导数越做越懵😵……\n解析几何背了模板还是踩不中得分点……\n成绩原地打转⚡️，简单题丢分，难题直接放弃⁉️\n-\n数学差还真不是孩子笨！现在数学更注重理解逻辑和方法运用\n一昧刷题只会让数学继续消耗孩子的信心与时间⏳\n🔥解救秘籍来了——【掌门一对一高中数学专项网课】清北等名校老师直播亲授，让孩子告别盲目刷题，🎯一对一精准狙击薄弱点\n-\n✨为什么大多数家长选择了掌门一对一？\n✔️深度学情诊断，锁定失分根源\n从函数思维、几何想象、计算熟练度等多维度剖析📊，快速定位漏洞，找到孩子到底卡在哪一步，学习才能不走冤枉路\n-\n✔️根据孩子基础制定个性化方案\n不是从头学到尾，而是哪里不会补哪里！擅长代数却怕几何？计算常粗心但思路清晰？课程匹配孩子真实节奏⏱️，聚焦弱项突破\n-\n✔️传授拆题技巧+真题实战，建立解题自信\n清北等名校老师会带娃一步步拆题，用真题练手感📐，“复杂题拆解+经典题演练”巩固方法，让孩子越学越主动🚀\n-\n✔️1对1全程督学，陪伴式纠偏\n课后还有专属辅导老师跟踪作业与错题📚，针对讲解解题逻辑，随时纠正跳步、粗心的毛病，把方法“钉”在习惯里\n-\n不让数学拖后腿，就从一次对的开始✨\n点击左下角头像↙️【进入直播间】🎥即可领取1节一对一体验课！\n🗂️1节清北名师高中数学直播课\n🗂️个性化学习能力测评\n🗂️定制阶段方案+高频考点资料\n-\n📍报名要求：32岁以上家长\n📍截止时间：即日起—2026年12月31日\n#掌门一对一[话题]# #掌门1对1[话题]# #家长必看[话题]# #数学学习[话题]# #学习方法[话题]# #数学思维[话题]# #数学[话题]# #学习规划[话题]#', 'video_url': 'http://sns-video-qc.xhscdn.com/stream/79/110/259/01e9a030a42f1226010370039c99beba1c_259.mp4?sign=654d82ef677e0029725c8ffa6c4b4df5&t=69acafa9', 'time': 1772105899000, 'last_update_time': 1772105899000, 'user_id': '6735499c000000001600b1b9', 'nickname': '掌门1对1学习规划', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/67498a5d4010f300017a590c.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '上海', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041907/88f4252dfad1bb27017ce5315d8dfd28/spectrum/1040g34o31t245jnbla105ppl96e5hcdp6uq0dk8!nd_dft_wlteh_webp_3', 'tag_list': '掌门一对一,掌门1对1,家长必看,数学学习,学习方法,数学思维,数学,学习规划', 'last_modify_ts': 1772622441087, 'note_url': 'https://www.xiaohongshu.com/explore/69a030ab000000001b016585?xsec_token=AB4201y3j7SF6bEqhP2ezZnH8pxVod_B3l-R6SIiMr2uk=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB4201y3j7SF6bEqhP2ezZnH8pxVod_B3l-R6SIiMr2uk='}
