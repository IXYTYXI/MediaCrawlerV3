2026-03-04 11:10:14 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '675941bd000000000103e04b', 'type': 'normal', 'title': '爆改数学普娃🔥轻松提高数学成绩', 'desc': '家里有个“数学困难户”真的太折磨家长了😭\n每次问他听懂没，他都会连连点头👀\n可一旦做到T目，还是各种错误一大堆💔\n👉做过的T换个说法就傻眼，根本弄不懂问题的底层逻辑\n👉马虎粗心更是不用说，上一行的数字挪到下一行都能写岔了\n……\n-\n如果你真的想让自家娃的数学成绩有效提高💪\n找对方法很重要‼️‼️\n如果家长们不知道怎么教，不妨来试试这个🌈0元的新加坡数学课\n现在点击下方⬇️【立即领取】就能带孩子免费学啦\n✅️课程分为K2-P6七个阶级，对标不同年龄及数学基础的孩子\n✅️每节课40-45min，确保孩子全程注意力集中\n✅️4-8人小班直播教学，互动多，发言多\n✅️强大的师资力量，都是拥有10-20年丰富教学经验的专家\n✅️每节课仅需100+，超高性价比放心选择\n-\n感兴趣的家长快快点击下方⬇️【立即领取】即可0元体验\n⏰ 活动时间：即日起—2025年12月31日\n*课程面向海外人群（18岁以上）\n\ufeff#sparkmath新加坡数学[话题]#\ufeff \ufeff#新加坡数学[话题]#\ufeff \ufeff#新加坡数学网课[话题]#\ufeff \ufeff#数学[话题]#\ufeff \ufeff#小学数学[话题]#\ufeff \ufeff#数学思维[话题]#\ufeff \ufeff#一年级数学[话题]#\ufeff \ufeff#小学数学怎么学[话题]#\ufeff \ufeff#新加坡数学建模[话题]#\ufeff \ufeff#新加坡数学应用题[话题]#\ufeff', 'video_url': '', 'time': 1733902781000, 'last_update_time': 1733902781000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '1', 'collected_count': '1', 'comment_count': '2', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041110/5068482bf2b5beddbd84eb7872cb5711/spectrum/1040g0k031b8rfogbnq005olhcu8lbcmatjtk8do!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041110/c577c9f8c5dea619781ad83502192e49/spectrum/1040g34o31b8rfr01mo0g5olhcu8lbcmaelle2kg!nd_dft_wlteh_webp_3', 'tag_list': 'sparkmath新加坡数学,新加坡数学,新加坡数学网课,数学,小学数学,数学思维,一年级数学,小学数学怎么学,新加坡数学建模,新加坡数学应用题', 'last_modify_ts': 1772593814426, 'note_url': 'https://www.xiaohongshu.com/explore/675941bd000000000103e04b?xsec_token=ABlt4IdCYu3ZKARfDhn7AXnOTEHAcBuK2njHrmTXz0aK4=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABlt4IdCYu3ZKARfDhn7AXnOTEHAcBuK2njHrmTXz0aK4='}
