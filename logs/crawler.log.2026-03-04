2026-03-04 12:58:14 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a0226a0000000015021873', 'type': 'video', 'title': '娃从怕难题到主动学 还得是Mathplore👍', 'desc': '谁懂啊！我家娃以前一见难题就绕道走，现在居然主动钻研！🥳 多亏@蚂蚁_不睡觉 ✨   挖到的宝藏，把数学难点攻克得明明白白～\n\t\n🔍 可视化拆解｜难题不抽象\n用画图、建模拆解复杂应用题，把抽象逻辑变成看得见的步骤，娃自己能推导思路，不再对着难题发呆～\n\t\n🚀 闯关式激趣｜心态不崩塌\n紧扣数学难点，融入情景模拟与挑战游戏，娃在解题里找成就感，越战越勇，告别畏难心理～\n\t\n🌐小班护航｜每个娃都被看见\n2-6人小班，老师能捕捉娃畏难的情绪，及时引导鼓励，互动感拉满，娃跟着老师攻坚，专注力也练出来了～\n\t\n🎨 逻辑深挖｜思维+表达双提升\n科学引导思考，鼓励娃用语言复述难题解法，既练数学思维，又磨逻辑表达，一举两得～\n想帮娃攻克难题的宝妈别踩坑！选对救星，娃会主动思考，数学少走超多弯路～\n\t\n现在Mathplore开启了免费试听活动❗点击左下角【立即咨询】即可0元领取价值1888元的试听大礼包~\n名额有限！先到先得\n~\n⏰活动时间：即日起-2028年12月31日\n*仅面向海外18+家长群体\n#数学思维训练[话题]#  #数学开窍[话题]#  #Mathplore新加坡数学[话题]#  #新加坡数学[话题]#  #小学数学怎么学[话题]#  #孩子爱学习[话题]#', 'video_url': 'http://sns-video-bd.xhscdn.com/stream/79/110/259/01e9a0220a2fc6cb010370039c99869c55_259.mp4', 'time': 1772102250000, 'last_update_time': 1772102250000, 'user_id': '6504601f0000000017021a03', 'nickname': 'Mathplore数学思维', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/e6f9e621-2070-3494-bab8-b0f3f41001c0', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '四川', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041258/68a9893264b53777253321bc574cc354/spectrum/1040g34o31t22d53fl8105p84c0fls6g3da6cgto!nd_dft_wlteh_webp_3', 'tag_list': '数学思维训练,数学开窍,Mathplore新加坡数学,新加坡数学,小学数学怎么学,孩子爱学习', 'last_modify_ts': 1772600294177, 'note_url': 'https://www.xiaohongshu.com/explore/69a0226a0000000015021873?xsec_token=AB4201y3j7SF6bEqhP2ezZnK5O6oszsHMdXQfbYEKKjAM=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB4201y3j7SF6bEqhP2ezZnK5O6oszsHMdXQfbYEKKjAM='}
