2026-03-04 11:25:16 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67625d2c000000000900e42b', 'type': 'video', 'title': '海淀妈妈们为什么更愿意学新加坡数学？', 'desc': '聪明的妈妈们早就知道了，要培养孩子的数学，就要先让🧠大脑开窍。一个很值得推荐给所有妈妈们的课程→选择新加坡数学🎉\n✅国内数学更注重计算，忽略启发，而新加坡数学从低龄开始，就着重🧠思维培养，带着孩子们发掘数学问题的本质是什么？有“打破砂锅问到底”的气势👍。\n✅新加坡数学采用建模教学法，复杂，抽象问题具象化，配合动画课件，孩子学起来也轻松。\n-\n妈妈们现在就可以来Spark Math试听，点⬇【立即咨询】或pm即可0元领取\n⏰活动时间：即日起至2025年12月31日\n*面向18+海外家长用户群体\n\t\n\ufeff#小学数学思维训练[话题]#\ufeff \ufeff#小学数学怎么学[话题]#\ufeff \ufeff#小学数学奥数[话题]#\ufeff \ufeff#小学数学[话题]#\ufeff \ufeff#新加坡数学[话题]#\ufeff \ufeff#数学思维[话题]#\ufeff \ufeff#sparkmath[话题]#\ufeff \ufeff#sparkmath种草官[话题]#\ufeff \ufeff#新加坡数学cpa教学法[话题]#\ufeff \ufeff#CPA教学法[话题]#\ufeff', 'video_url': 'http://sns-video-bd.xhscdn.com/stream/110/259/01e7623f092b7b150103700393d83cf336_259.mp4', 'time': 1734499628000, 'last_update_time': 1734499629000, 'user_id': '61b2fc7e000000001000f059', 'nickname': 'Spark Math线上课程', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4aeb79ls6g5odivhv41s2pgohmd30', 'liked_count': '2', 'collected_count': '', 'comment_count': '', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041125/32d5087d39d64b9e1e7727594de25f58/110/0/01e7623f092b7b1500100000000193d7c64aff_0.jpg!nd_dft_wlteh_webp_3', 'tag_list': '小学数学思维训练,小学数学怎么学,小学数学奥数,小学数学,新加坡数学,数学思维,sparkmath,sparkmath种草官,新加坡数学cpa教学法,CPA教学法', 'last_modify_ts': 1772594716306, 'note_url': 'https://www.xiaohongshu.com/explore/67625d2c000000000900e42b?xsec_token=ABZW_BS0TWvCnrgXJFDwLcd2C47MX-Duf2h31vKSiOvVk=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABZW_BS0TWvCnrgXJFDwLcd2C47MX-Duf2h31vKSiOvVk='}
