2026-03-04 14:24:42 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a168cd000000001d012b92', 'type': 'normal', 'title': '直接封神！Mathplore新加坡数学让娃开窍了', 'desc': '我家娃以前一上数学课就眼神放空😫\n校内成绩中不溜，奥数又跟不上，每次都要吼着学\n既想让他校内稳一点，又想拔高思维，真的好难！\n-\n直到被闺蜜安利了这个Mathplore新加坡数学\n上了一个月，真后悔没早点报！\n-\n🎯7阶体系，校内竞赛两手抓\n原版新加坡体系+国内新课改\n65%校内夯实基础+35%竞赛思维拓展\n不偏科也不“拔苗助长”，刚刚好\n\t\n💡CPA教学法，真的让孩子开窍\n以前讲“3个苹果+5个苹果”，掰手指都算不明白\n现在学会用图形建模，把抽象数字变成方块图\n不仅能理解，还能举一反三！\n\t\n👩\u200d🏫2-6人小班，老师盯得紧\n小班直播互动太重要了！\n老师高频提问，娃根本没机会走神\n结合动画闯关游戏，以前抵触上课，现在天天盼着上课\n\t\n🌟师资强得离谱\n名校毕业+数理背景，讲得透基础，也带得动拔高\n亲和力还强，娃喜欢得不得了！\n\t\n⏰节奏刚好，在家就能学\n每周2节（40/50分钟）\n完美融入课后和周末，再也不用风雨无阻去接送！\n---------------\n👇现在点击左下角【立即咨询】即可0元领取1888元试听大礼包哦~\n⏰ 活动时间：即日起至 2027 年12月31日\n* 仅面向海外18 +家长，名额有限，先到先得❗️\n#新加坡数学[话题]# #数学学习[话题]# #Mathplore[话题]# #小学数学怎么学[话题]# #数学[话题]# #CPA教学法[话题]# #建模思维[话题]#', 'video_url': '', 'time': 1772185805000, 'last_update_time': 1772185805000, 'user_id': '66c854d2000000001d022cac', 'nickname': 'Mathplore数学开窍', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31djmkng2h66g5pm8aj97cb5cr77jngg', 'liked_count': '16', 'collected_count': '23', 'comment_count': '2', 'share_count': '1', 'ip_location': '四川', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041424/84766618eb21db72d4e9d8bb2e3ff63b/spectrum/1040g0k031t3a6ojn56005pm8aj97cb5c54173go!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041424/23993ba5c745645a475d805c9001a62f/spectrum/1040g0k031t3a6ojn560g5pm8aj97cb5cipah8m8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041424/b8ae1c24f329b6df06f8fbedb2117575/spectrum/1040g0k031t3a6ojn56105pm8aj97cb5c7g3qjoo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041424/df1f5e29096acf05e28f45d688908871/spectrum/1040g0k031t3a6ojn561g5pm8aj97cb5c711ec9o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041424/21780034822021704df2e6296b43c4ec/spectrum/1040g0k031t3a6ojn56205pm8aj97cb5cedj52dg!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学,数学学习,Mathplore,小学数学怎么学,数学,CPA教