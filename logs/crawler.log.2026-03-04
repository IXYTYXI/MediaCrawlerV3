2026-03-04 11:27:13 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '675abb1f000000000603e062', 'type': 'normal', 'title': '小学数学竞赛top，找不出比它更适合的了', 'desc': '为什么说袋鼠数学竞赛是小学阶段数学竞赛的首选❓\n因为竞赛题目❌不追求复杂计算，而是通过真实场景和有趣的问题，让孩子体验“解题的乐趣”🎉，从而提升解决问题的能力。\n✅不同年龄段设置分组，难度循序渐进，确保每个孩子都能找到适合自己的挑战。\n-\n不知道怎么学？在哪里报名？怎么获取考试信息？👏一个spark math就够了\n他们家现在还有0元试听的活动，点击⬇pm或评论留言即可领取\n-\n🧑\u200d🏫他们家的老师都是国际top大学毕业，教学经验丰富，善于将复杂问题化繁为简，基础不好也听的懂。\n🧑\u200d🏫游戏化交互课件激发兴趣，把枯燥的公式变成直观的图像。\n🧠20种思维方法内容深度、广度、高度一起抓。\n👧精品小班直播课，老师全程追踪学习进度。\n✅涵盖校内数学、考试难题、速算技巧和竞赛数学等内容。\n-\n现在快来点👇【立即咨询】先0元领取数学课，看看讲的怎么样？\n⏰活动时间：即日起至2025年12月31日\n*面向18+海外家长用户群体\n\t\n\ufeff#sparkmath[话题]#\ufeff \ufeff#小学数学思维训练[话题]#\ufeff \ufeff#小学数学怎么学[话题]#\ufeff \ufeff#数学思维[话题]#\ufeff \ufeff#小班课[话题]#\ufeff \ufeff#小学数学奥数[话题]#\ufeff \ufeff#小学数学网课[话题]#\ufeff \ufeff#新加坡数学[话题]#\ufeff \ufeff#新加坡数学网课[话题]#\ufeff \ufeff#新加坡数学教材[话题]#\ufeff', 'video_url': '', 'time': 1733999391000, 'last_update_time': 1733999391000, 'user_id': '61b2fc7e000000001000f059', 'nickname': 'Spark Math线上课程', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4aeb79ls6g5odivhv41s2pgohmd30', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041127/070f5dc09cbcd2d1433af1780b4ec646/spectrum/1040g34o31ba8jer5mo0g5odivhv41s2pia6mg88!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041127/72dcbf888b6fc42c64f3d3ccca984cb0/spectrum/1040g0k031ba8jgeb7q705odivhv41s2pd8e69bo!nd_dft_wlteh_webp_3', 'tag_list': 'sparkmath,小学数学思维训练,小学数学怎么学,数学思维,小班课,小学数学奥数,小学数学网课,新加坡数学,新加坡数学网课,新加坡数学教材', 'last_modify_ts': 1772594833803, 'note_url': 'https://www.xiaohongshu.com/explore/675abb1f000000000603e062?xsec_token=ABfozaOMPiyb5BqfqDPn2OKQUL8IfrdTVMlX34Q0DmpOY=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABfozaOMPiyb5BqfqDPn2OKQUL8IfrdTVMlX34Q0DmpOY='}
