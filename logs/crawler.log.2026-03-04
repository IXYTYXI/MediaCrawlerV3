2026-03-04 21:35:58 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a7a2ea000000002603127d', 'type': 'video', 'title': '语文总丢分📚1v1带娃把阅读写作讲透了', 'desc': '是不是很多家长都有同样的烦恼👇\n孩子语文平时看起来学了不少，但一到考试就开始“掉链子”😣\n📍阅读理解——文章看懂了，答案却总是踩不到得分点\n📍作文写作——背了很多素材，写出来还是平平无奇\n📍语文成绩——努力没少花，分数却一直提不上去\n其实很多孩子语文提不上来，并不是不努力，而是缺少方法和系统训练。\n如果一直靠死记硬背，很容易越学越迷茫。\n-\n来试试【掌门一对一高中语文网课】\n让老师带着孩子一步步把阅读和写作讲清楚、练明白。\n-\n📖基础夯实：先把语文底子打牢\n✔高频字词梳理\n老师会帮孩子整理考试高频字词、古诗文重点内容，搭配记忆方法，不再盲目背。\n✔语感训练\n通过短篇精读+句式仿写，老师一对一带着分析文章逻辑，让孩子慢慢建立语感。\n-\n📝阅读突破：答题有套路\n很多孩子阅读丢分，其实是不会找得分点。\n✔阅读题型精讲\n老师会拆解常见题型，教孩子如何快速抓住题干关键词。\n✔答题逻辑训练\n针对记叙文、说明文、议论文不同题型，总结答题思路，让孩子写出标准得分答案。\n-\n✍️作文提升：从没思路到有结构\n作文提分，关键在于立意+结构+表达。\n✔作文构思训练\n老师会帮孩子建立作文思路框架，不再一提笔就卡壳。\n✔一对一作文精批\n从开头、素材到语言表达逐段修改，让孩子慢慢写出有亮点的文章。\n-\n孩子跟着老师系统学一段时间后，阅读答题更有条理，作文也开始有内容了\n📈如果想让孩子试试这种学习方式，现在可以点击下方头像进入直播间：\n🎁0元领取1节1v1语文体验课\n包含：\n✔语文能力测评\n✔专属学习规划\n✔阅读写作提分建议\n📌报名要求：32岁以上家长\n📅活动时间：即日起—2026.12.31\n#掌门[话题]#   #掌门一对一[话题]#   #掌门1对1[话题]#   #高中[话题]#   #语文[话题]#   #语文作文[话题]#   #高中作文[话题]#   #作文[话题]#   #作文范文[话题]#   #网课[话题]#', 'video_url': 'http://sns-video-bd.xhscdn.com/stream/1/110/259/01e9a7a2ea4d099c010370039cb6d50813_259.mp4', 'time': 1772593898000, 'last_update_time': 1772593898000, 'user_id': '669f40a3000000001e00b482', 'nickname': '掌门1对1逆袭', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6729d05045dcad0001e0ab91.jpg', 'liked_count': '1', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '安徽', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603042135/5a42ee0d4d955c291484e6fb41b1ef92/spectrum/1040g34o31t9crko2me105pkv82hnhd42n3gqeu0!nd_dft_wlteh_webp_3', 'tag_list': '掌门,掌门一对一,掌门1对1,高中,语文,语文作文,高中作文,作文,作文范文,网课', 'last_modify_ts': 1772631358945, 'note_url': 'https://www.xiaohongshu.com/explore/69a7a2ea000000002603127d?xsec_token=ABvtKkoN-JdN_qRqzuJpkmXOO9OKwEzyefAlQbgw2pLVs=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABvtKkoN-JdN_qRqzuJpkmXOO9OKwEzyefAlQbgw2pLVs='}
