2026-03-04 11:28:34 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a137fb000000001503376a', 'type': 'normal', 'title': 'sparkmath新加坡数学网课 好玩又能提思维！', 'desc': '😭学数学是不是经常遇到这些小烦恼：\n1️⃣ 数学题绕来绕去，想不明白\n2️⃣ 做题没思路，容易卡壳\n3️⃣ 问题没人及时讲，越积越多\n4️⃣ 觉得数学好枯燥，坐不住\n5️⃣ 大班课人太多，老师顾不上自家娃\n来试试【sparkmath新加坡数学网课】吧！\n✅ CPA趣味学法：\n从简单到复杂，轻松搞懂数学逻辑，越学越通透\n✅ 小班超贴心：\n每班≤8人，老师全程盯着娃的思路\n✅ 全程陪着学：\n有问题立刻问，当天问题当天解决，不留小尾巴\n✅ 课堂像玩游戏：\n有趣又有料，轻轻松松爱上数学，越学越开心\n现在点击左下角↙【立即咨询】，或戳@Spark Math 数学课程 回【领取】\n新加坡数学免费资源现在0元就能获取\n0元锁定价值3288元开学大礼包\n📅活动时间：即日起至2026年3月31日\n#sparkmath[话题]#  #sparkmath新加坡数学[话题]#  #新加坡数学[话题]#  #小学开学[话题]#  #小学数学[话题]#  #数学启蒙[话题]#  #幼小衔接[话题]#  #开学季抢跑[话题]#  #数学学习[话题]#  #国际数学竞赛[话题]#', 'video_url': '', 'time': 1772173307000, 'last_update_time': 1772173307000, 'user_id': '64740b96000000000f006adf', 'nickname': 'Spark Math 数学课程', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo30oe65qe8ie5g5p3k1eb3oqmvph5fk6g', 'liked_count': '1', 'collected_count': '1', 'comment_count': '3', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041128/d6a1119715a6764627289e4e1c653c81/spectrum/1040g34o31t349g77l6405p3k1eb3oqmv4cd2k38!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041128/0b015cabf08a644f6eeeefb9326318d0/spectrum/1040g34o31t349g77l63g5p3k1eb3oqmvf7a1e5g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041128/26e17a24b0760ab70c9cd46c497f4800/spectrum/1040g34o31t349g77l6305p3k1eb3oqmvq5a36ko!nd_dft_wlteh_webp_3', 'tag_list': 'sparkmath,sparkmath新加坡数学,新加坡数学,小学开学,小学数学,数学启蒙,幼小衔接,开学季抢跑,数学学习,国际数学竞赛', 'last_modify_ts': 1772594914560, 'note_url': 'https://www.xiaohongshu.com/explore/69a137fb000000001503376a?xsec_token=ABr_9yVr-hrBc-EABFGIVzVdauxP7BkIidvJxiv_VdodE=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABr_9yVr-hrBc-EABFGIVzVdauxP7BkIidvJxiv_VdodE='}
