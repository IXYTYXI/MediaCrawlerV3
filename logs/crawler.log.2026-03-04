2026-03-04 19:07:37 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a0306a000000001b01642b', 'type': 'video', 'title': '高中数学新课提前学🔥跟1对1开学不慌✅', 'desc': '⚠家有高中生的家长们，是不是一提到孩子期末数学成绩就愁得头疼😠\n👀看着成绩单上的分数原地踏步\n👉马上开学要面临新课+复习双重压力\n❌孩子对着函数、几何压轴题抓耳挠腮，草稿纸写满还是没思路…\n❌基础不牢越补越乱，报过大班课根本跟不上，钱花了没效果\n❌自己想辅导却看不懂新题型，只能眼睁睁看着孩子焦虑，帮不上半点忙❓\n-\n🔥别焦虑！终于找到靠谱的方法了❗️给孩子安排【掌门一对一高中数学线上1对1辅导】，在家就能学，不用奔波，开学逆袭真的有戏💥\n-\n⭐为什么家长都给娃选掌门一对一❓\n💛AI智能诊断太省心！30分钟精准揪出孩子的拔高卡点‼️哪里没吃透就专攻哪里👉不盲目补弱，对症下💊才有效❗️\n💚名校名师真靠谱！五层严格筛选，清北学霸+8年+资深教龄老师坐镇，比校内老师更懂高中数学考点和孩子的解题盲区，教的都是能逆袭的干货🔥\n💙复杂题拆解太绝了💓把压轴题拆成孩子能懂的基础模型，逆向思维引导，不是死记硬背，而是让孩子真的会解题、能举一反三✅\n💜口碑看得见❣️8000万学员验证，从数学拖后腿变成优势科，孩子自信都回来了！\n-\n🏆清北等名师专属1对1方案，针对性查漏补缺不踩坑‼️\n✅函数综合题速解：专门攻克图像、值域、单调性难点，定制专属解题模板，孩子一看就懂，做题速度翻倍！\n✅几何辅助线秒杀：20+高频题型全覆盖，教孩子精准找切入点，辅助线不再瞎画，做题不卡壳！\n……\n✅全周期服务太放心：课前AI测评定方案、课中实时答疑、课后错题复盘+学习报告，家长能旁听，孩子进步看得见，不用瞎操心！\n-\n👇点击左下角【立即咨询】领取0️⃣元试听课\n💫一对一辅导数学体验课\n💫数学专项学情分析报告\n💫1V1定制化学习方案\n💫超干货学习资料包\n📅报名时间：即日起—2026年12月31日\n👪对应人群：仅面向32岁以上家长\n#掌门一对一[话题]#  #掌门[话题]#  #掌门1对1[话题]#  #数学逆袭[话题]#  #数学薄弱[话题]#  #网课推荐[话题]#  #家长必看[话题]#  #高中学习[话题]#', 'video_url': 'http://sns-video-qc.xhscdn.com/stream/79/110/259/01e9a030434d023f010370039c99bd70fc_259.mp4?sign=cf5c000a2d159313216e8926e71eb6a4&t=69acafb9', 'time': 1772105834000, 'last_update_time': 1772105834000, 'user_id': '6735499c000000001600b1b9', 'nickname': '掌门1对1学习规划', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/67498a5d4010f300017a590c.jpg', 'liked_count': '1', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '上海', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041907/e00ad4df1a0f88ffa24dfba4efb9a596/spectrum/1040g0k031t2441ol5e005ppl96e5hcdpepb0r8g!nd_dft_wlteh_webp_3', 'tag_list': '掌门一对一,掌门,掌门1对1,数学逆袭,数学薄弱,网课推荐,家长必看,高中学习', 'last_modify_ts': 1772622457124, 'note_url': 'https://www.xiaohongshu.com/explore/69a0306a000000001b01642b?xsec_token=AB4201y3j7SF6bEqhP2ezZnK7Rl4INLV5aIz9kAyZb4jY=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB4201y3j7SF6bE