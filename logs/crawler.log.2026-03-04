2026-03-04 19:10:24 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a02e340000000015032daf', 'type': 'video', 'title': '收语文差生🙋\u200d♀️一对一逆袭到班级前几', 'desc': '🤔高中语文真的是“玄学”吗？明明书也读了，卷子也做了，可一到考试，分数还是纹丝不动💦\n💢文言文像看天书，实词虚词全靠猜\n💢阅读理解总丢分，永远读不懂作者的“言外之意”\n💢作文辞藻平平，立意浅显，拿不到分\n.\n家长们，想要孩子语文逆袭冲刺，靠“死记硬背”真的不行🤫\n⭕️语文不是靠堆时间就能出奇迹，关键在于逻辑构建+审美迁移+解题套路\n🙋\u200d♂️直接来【掌门一对一语文线上网课】📣一人一班，深度拆解语文丢分项，30天助力文学素养与考分双齐飞\n.\n想要跨过语文“高山”，一对一才是通往逆袭的捷径‼️\n🈶 精准诊断文学素养\n🔹全方位测评孩子语文学情，覆盖基础知识、古诗鉴赏、现代文阅读、大作文，锁定“丢分黑洞”，精准补齐短板\n🈶 定制化冲刺策略\n🔹紧扣考纲与命题趋势，量身打造学习方案；从文言文断句技巧到现代文“模板化”答题，分项突破，让分数稳中有进\n🈶 名师点拨思维深度\n🔹清北等名校毕业老师在线授课，告别生搬硬套！教孩子如何拆解文本逻辑，传授作文“高阶立意”与“神仙开头”，让卷面充满高级感\n🈶 全场景闭环反馈\n🔹学习进度实时追踪，从字音字形到大作文批改，每一个细节都不放过；家长同步掌握动态，让进步肉眼可见‼️\n.\n现在直播间0元试听课限时抢‼️\n🙋\u200d♀️点击左下角头像进入【直播间】，即可免费领取1V1深度测评名额\n🎁额外加赠：高考语文高频词汇地图+30套万能作文模板\n.\n报名要求：32岁以上家长\n截止时间：即日起-2026年12月31日\n#掌门一对一[话题]# #掌门1对1[话题]# #家长必看[话题]# #语文学习[话题]# #作文方法[话题]# #作文[话题]# #语文[话题]# #高中[话题]# #网课[话题]#', 'video_url': 'http://sns-video-qc.xhscdn.com/stream/79/110/259/01e9a02e272f0ac2010370039c99b50baa_259.mp4?sign=764a26f98a12bf1b801bb7ee2ab42147&t=69acb060', 'time': 1772105268000, 'last_update_time': 1772105269000, 'user_id': '6735499c000000001600b1b9', 'nickname': '掌门1对1学习规划', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/67498a5d4010f300017a590c.jpg', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '上海', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041910/039f8c77ed87250cb149802cf53521ed/spectrum/1040g34o31t23rqid5c105ppl96e5hcdp2h5c340!nd_dft_wlteh_webp_3', 'tag_list': '掌门一对一,掌门1对1,家长必看,语文学习,作文方法,作文,语文,高中,网课', 'last_modify_ts': 1772622624258, 'note_url': 'https://www.xiaohongshu.com/explore/69a02e340000000015032daf?xsec_token=AB4201y3j7SF6bEqhP2ezZnHCUAs2C0DnSer6bEhJxJh8=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB4201y3j7SF6bEqhP2ezZnHCUAs2C0DnSer6bEhJxJh8='}
