2026-03-04 11:24:57 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '676d09ca0000000009014908', 'type': 'normal', 'title': '娃的math有救了❗校内、浅奥、思维三合一', 'desc': '🔥Spark Math新CP课程紧贴新课标核心要求，囊括全球第一的新加坡教法精髓，基于国内外知名数学赛事的核心知识点、主流赛事高频考点，研发的一套提升学员核心竞争力的高品质数学课程。💪\n⛳新CP的课程体系，不仅立足于帮助孩子提升当下成绩，获得杯赛奖项，更注重长远的思维能力培养，教会孩子如何学习，养成更好的学习习惯，思考习惯，解题习惯。🏆\n-\n🔥课程即将上线，招募【大班到6年级】免费试听❗❗\n我们的课程：\n📒内容：覆盖校内知识，拓展校外奥数竞赛\n👧班型：中文/英文/双语，小班直播课\n👩🏫师资：拥有丰富教学经验的老师\n💰价格：每节课仅100+，性价比杠杠的\n-\n现在点击图片下方⬇ 【立即咨询】就可以免费试听❗❗\n⏰ 活动时间：即日起—2025年12月31日\n*课程面向海外人群（18岁以上）\n\t\n\ufeff#小学数学怎么学[话题]#\ufeff \ufeff#新加坡数学[话题]#\ufeff \ufeff#数学思维[话题]#\ufeff \ufeff#新加坡数学网课[话题]#\ufeff \ufeff#小学数学[话题]#\ufeff \ufeff#新加坡数学cpa教学法[话题]#\ufeff \ufeff#数学逆袭[话题]#\ufeff \ufeff#数学开窍[话题]#\ufeff \ufeff#小学数学思维训练[话题]#\ufeff', 'video_url': '', 'time': 1735199178000, 'last_update_time': 1735199178000, 'user_id': '61b2fc7e000000001000f059', 'nickname': 'Spark Math线上课程', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4aeb79ls6g5odivhv41s2pgohmd30', 'liked_count': '1', 'collected_count': '2', 'comment_count': '2', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041124/a70e1b455b4fcd7fb14b4849af85dd1d/spectrum/1040g0k031bs5lcob12005odivhv41s2p4jvk7n0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041124/d07cad8915d1d8cc832ca75c827b1712/spectrum/1040g0k031bs5lcob120g5odivhv41s2pr98u93o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041124/3c74fd5bbeff79b549dc72d124a1d2d2/spectrum/1040g0k031bs5lcob12105odivhv41s2p2ii7p7g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041124/90b734ddc356431e8ec0b19955d51fcc/spectrum/1040g0k031bs5lcob121g5odivhv41s2p3nj9n2g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041124/458081f30e0cb7653d229b7b7b8afbc9/spectrum/1040g0k031bs5lcob12205odivhv41s2pcq47vs0!nd_dft_wlteh_webp_3', 'tag_list': '小学数学怎么学,新加坡数学,数学思维,新加坡数学网课,小学数学,新加坡数学cpa教学法,数学逆袭,数学开窍,小学数学思维训练', 'last_modify_ts': 1772594697485, 