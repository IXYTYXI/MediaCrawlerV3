2026-03-04 17:25:22 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '699fee2e000000001d0251ac', 'type': 'video', 'title': '数学差生集合❗️1v1带娃逆袭尖子生✨', 'desc': '👋 数学总拉分的孩子家长看过来！\n您是否也为孩子这些情况发愁？\n❌ 公式记不牢，题型没思路\n❌ 计算总出错，压轴题不敢碰\n❌ 一考试就紧张，简单题也丢分……\n别担心！【掌门一对一高中数学网课】来助力，\n让孩子在家跟着名师学，悄悄逆袭，\n👉 冲进班级前三，惊艳所有人！\n——\n✨ 掌门高中数学一对一网课\n🌟 学情诊断 + 个性定制 + 时间灵活\n帮助孩子跳出数学学习“坑”，高效提升💯\n✅ 精准定位薄弱环节\n从基础公式、题型解法，到解题逻辑、计算能力，全面测评，找到问题根源。\n✅ 一对一定制学习计划\n根据孩子实际进度，从巩固基础到突破难点，定制专属路径，听得懂、跟得上、学得会。\n✅ 名师亲授解题方法\n清北等教研团队老师1对1辅导，专项攻克薄弱点，系统传授题型思路，课后随时答疑，遇到难题也不慌。\n✅ 上课时间自由安排\n匹配孩子作息灵活调整，免去奔波，在家就能高效学数学。\n-\n🙋♀现在点击下方⬇【立即咨询】就能0元领取👉🏻数学1V1体验课~\n🈶1对1专业辅导➕定制专属计划➕学习资料\n-\n报名要求：32岁以上家长\n截止时间：2026年12月31日\n#掌门一对一[话题]#  #掌门1对1[话题]#  #网课[话题]#  #数学学习[话题]#  #学习方法[话题]#  #数学思维[话题]#  #让孩子爱上数学[话题]#  #数学[话题]#  #高中数学[话题]#', 'video_url': 'http://sns-video-qc.xhscdn.com/stream/79/110/259/01e99fedf748c648010370039c98bafac6_259.mp4?sign=50498ce3d221ca98deaa55d7cefa4033&t=69ac97c2', 'time': 1772092821000, 'last_update_time': 1772088879000, 'user_id': '649a70220000000010036bfc', 'nickname': '掌门1对1学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31pumqmjhls005p4qe0h46qvs49pjit8', 'liked_count': '3', 'collected_count': '2', 'comment_count': '', 'share_count': '', 'ip_location': '上海', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041725/b80dfaf79f6f86126a6b1cb7fd39dd37/spectrum/1040g34o31t1s190ela105p4qe0h46qvsjpjecjo!nd_dft_wlteh_webp_3', 'tag_list': '掌门一对一,掌门1对1,网课,数学学习,学习方法,数学思维,让孩子爱上数学,数学,高中数学', 'last_modify_ts': 1772616322613, 'note_url': 'https://www.xiaohongshu.com/explore/699fee2e000000001d0251ac?xsec_token=ABgDs5i6A-nA_6IJTaWC6cNer10QcRWX-mf-Dx-nukgYE=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABgDs5i6A-nA_6IJTaWC6cNer10QcRWX-mf-Dx-nukgYE='}
