2026-03-04 11:26:11 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67623ec4000000001300d121', 'type': 'video', 'title': '新加坡数学上了一年，数学有什么变化？', 'desc': '自从上了新加坡数学后，才感受到和咱们国内的数学有多大的差异😲，尤其是在培养数学思维方面。\n❌做计算，不靠机械的死记硬背公式，背口诀表，✅而是用了CPA教学法中的建模思维，把复杂抽象的数学问题，转化为简单易懂的图像。\n✅帮助孩子从具象思维到抽象思维的轻松过渡，把晦涩难懂的数学抽象概念变得更容易理解，激发孩子对数学的好奇！\n-\n家长们现在就可以来Spark Math试听，点⬇【立即咨询】或pm即可0元领取\n⏰活动时间：即日起至2025年12月31日\n*面向18+海外家长用户群体\n\t\n\ufeff#小学数学思维训练[话题]#\ufeff \ufeff#小学数学怎么学[话题]#\ufeff \ufeff#小学数学奥数[话题]#\ufeff \ufeff#小学数学[话题]#\ufeff \ufeff#新加坡数学[话题]#\ufeff \ufeff#数学思维[话题]#\ufeff \ufeff#sparkmath[话题]#\ufeff \ufeff#sparkmath种草官[话题]#\ufeff \ufeff#新加坡数学cpa教学法[话题]#\ufeff \ufeff#CPA教学法[话题]#\ufeff', 'video_url': 'http://sns-video-bd.xhscdn.com/stream/110/259/01e7623db82c1eb00103700393d7c5bfcf_259.mp4', 'time': 1734491844000, 'last_update_time': 1734491844000, 'user_id': '61b2fc7e000000001000f059', 'nickname': 'Spark Math线上课程', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4aeb79ls6g5odivhv41s2pgohmd30', 'liked_count': '3', 'collected_count': '1', 'comment_count': '', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041126/f92e62f7e242a3f8692777ba24e69192/spectrum/1040g0k031bhk866bg8005odivhv41s2pi5jsbjg!nd_dft_wlteh_webp_3', 'tag_list': '小学数学思维训练,小学数学怎么学,小学数学奥数,小学数学,新加坡数学,数学思维,sparkmath,sparkmath种草官,新加坡数学cpa教学法,CPA教学法', 'last_modify_ts': 1772594771366, 'note_url': 'https://www.xiaohongshu.com/explore/67623ec4000000001300d121?xsec_token=ABZW_BS0TWvCnrgXJFDwLcd-EPeujuvrCQ3fcChVD1SpM=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABZW_BS0TWvCnrgXJFDwLcd-EPeujuvrCQ3fcChVD1SpM='}
