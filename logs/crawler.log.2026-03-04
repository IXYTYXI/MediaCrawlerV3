2026-03-04 11:12:33 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6736f269000000001b02f7e9', 'type': 'normal', 'title': '袋鼠竞赛考前规划这样做‼拿奖易如反掌', 'desc': '真心建议低年级孩子都去参加袋鼠竞赛，✔难度相对较低，题目题型新颖有趣。✔题型都紧密贴近生活，充满灵活性，主要侧重于培养学生对数学的兴趣。参赛的门槛较低，容易获奖。\n‼绝对是低龄竞赛天花板~~\n-\n如果您家有要参加的宝贝，家长们可以试试跟着👉spark math 的竞赛课做考前规划。\n-\n✅采用小班直播教学，互动多，发言多，知识掌握更牢固。\n✅全面覆盖知识点、难度呈螺旋式上升，针对性强。\n✅每年更新题目，覆盖所有主流竞赛考试，紧贴最新的命题趋势。\n✅提供完备的比赛备考计划，有考前历年真题练习、冲刺集训复习短期班、考前模拟等。\n✅拥有CPA建模教学法、UDSCSE教学法、迁移式教学法等多种教学方法，易理解，能举一反三。\n-\n🔥现在点击下方⬇ 【立即咨询】即可0元get【saprk math国际数学竞赛课】试听课\n·\n🔥名额有限，先到先得～\n⏰活动时间：即日起至2024年12月31日\n*面向18+海外家长用户群体\n.\n截止时间：2024年12月31日\n*面向5-12岁学生家长\n#袋鼠数学[话题]#\xa0\xa0#袋鼠数学竞赛[话题]#\xa0\xa0#袋鼠数学国际竞赛[话题]#\xa0\xa0#袋鼠数学竞赛真题[话题]#\xa0\xa0#袋鼠数学竞赛培训[话题]#\xa0\xa0#袋鼠数学思维[话题]#\xa0\xa0#袋鼠数学报名[话题]#\xa0\xa0#袋鼠数学竞赛资料[话题]#\xa0\xa0#袋鼠数学备考[话题]#\xa0\xa0#2022袋鼠数学竞赛[话题]#\xa0\xa0#新加坡数学cpa[话题]#\xa0\xa0#sparkmath新加坡数学[话题]#\xa0\xa0#新加坡数学补习[话题]#\xa0\xa0#学习日常[话题]#', 'video_url': '', 'time': 1731661442000, 'last_update_time': 1731654250000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '2', 'collected_count': '', 'comment_count': '', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041112/14a7cb12d86f38cf4cc911f11ecc194c/spectrum/1040g34o31a7b8tdomo0g5olhcu8lbcmamtfoqvg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041112/78bdcfbc6fea7d813c6f4b11b4fac5b5/spectrum/1040g34o31a7b921i6m0g5olhcu8lbcmanvon1cg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041112/a641a867012c622de7b0e160ba2104ed/spectrum/1040g34o31a7b94t0mu0g5olhcu8lbcmae8d0d3g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041112/2cbfe07ae0b36d83cced5d7639211fbd/spectrum/1040g34o31a7b93dfmq0g5olhcu8lbcmathbjl4g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041112/c42c0a202c390fdcf9eb171b5c273896/spectrum/1040g34o31a7b90n