2026-03-04 11:32:26 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '699d46e9000000001d0266d6', 'type': 'normal', 'title': '小学数学成绩怎么提高？只差sparkmath‼️', 'desc': '为什么小学数学成绩在90分左右徘徊，迟迟无法突破95+的瓶颈？\n你真的需要sparkmath新加坡数学来帮忙开窍！\n-\n🌟拒绝填鸭，名师在线启发式伴学\n1%通过率严选教师真人直播，把晦涩难懂的考点“翻译”成孩子的语言\n通过层层递进的提问引导，彻底激活大脑，让哪个畏惧数学的娃，成为自信满分的“抢答王”！\n🌟告别死记硬背，独家训练法打通逻辑\n引入创新思维的可视化体系，将干瘪的数字概念包装成趣味探索\n我们不只讲授一反三的破题思路，瞬间理清思维中的逻辑乱麻，让孩子真正开窍！\n🌟沉浸体验，3-8人小班燃爆课堂\n小班真人直播，全面融合抢麦、组队闯关与积分激励机制\n把枯燥听课变成沉浸式打怪升级，激发超强内驱力，孩子每天催着自己要上课！\n-\nsparkmath新加坡数学更多优势，家长更放心👍\n✨ 80%校内基础+20%竞赛拔高，兼顾成绩与能力；\n✨ 3v1实时答疑，疑问不过夜\n✨ 作业精细批改+错题剖析，学习效果看得见；\nsparkmath让孩子数学思维悄悄提升，开窍快、做题稳、分数涨📈！\n小学生数学补差提分，选它就对了！\n🔥 现在戳【立即咨询】即可0元get学习大礼包，名额有限，先到先得～\n🔥 适合5-12岁青少儿，面向32岁以上家长群体\n#sparkmath[话题]# #sparkmath新加坡数学[话题]# #新加坡数学[话题]# #小学数学怎么学[话题]# #小学数学成绩怎么提升[话题]# #小学数学网课平台哪个好[话题]# #数理思维训练[话题]# #火花新加坡数学[话题]# #小学数学应用题[话题]#', 'video_url': '', 'time': 1771914985000, 'last_update_time': 1771914986000, 'user_id': '64740b96000000000f006adf', 'nickname': 'Spark Math 数学课程', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo30oe65qe8ie5g5p3k1eb3oqmvph5fk6g', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041132/4a976cc13f79f59f830cef3ceece2415/spectrum/1040g34o31sv8nhvtl60g5p3k1eb3oqmvfve6vv0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041132/f9e8fda37b666ae857e79b953ed280c6/spectrum/1040g34o31sv8nvr95c105p3k1eb3oqmva8h8rd0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041132/71e9b00e5304194c99329d6387027172/spectrum/1040g0k031sv8o3pp5e005p3k1eb3oqmvuj3jjtg!nd_dft_wlteh_webp_3', 'tag_list': 'sparkmath,sparkmath新加坡数学,新加坡数学,小学数学怎么学,小学数学成绩怎么提升,小学数学网课平台哪个好,数理思维训练,火花新加坡数学,小学数学应用题', 'last_modify_ts': 1772595146911, 'note_url': 'https://www.xiaohongshu.com/explore/699d46e9000000001d0266d6?xsec_token=ABn8N7fdUxn2J27vhDFGL4c5paWv1kngv48Ijk62nuqHI=&xsec_source=pc_search', 'source_keyword': '', 'x