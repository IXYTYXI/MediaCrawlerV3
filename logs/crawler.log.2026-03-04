2026-03-04 12:59:21 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69903b21000000001d025998', 'type': 'video', 'title': '数学困难户❓找对方法也能思维逆袭！', 'desc': '孩子学数学总犯难，越学越抵触，甚至彻底失去信心？😭\n\t\n死记硬背公式记不牢，抽象概念听不懂，课后盲目刷题却错题反复，付出再多，成绩依旧原地踏步，家长看着急在心里！\n\t\n还好@小耳朵专属   选了Mathplore新加坡数学直播课，帮学前-6年级孩子打破数学困境，轻松实现思维逆袭✅\n\t\n在家就能学，每周2节直播课，专业名师手把手带学，精准突破数学重难点，告别无效努力！\n\t\n✅ 2-6人精品小班，高频互动不冷场，名师实时答疑，灵活调整授课节奏，专注度拉满，效率远超大班课，不用奔波机构，省时又省心。\n\t\n✅ CPA可视化建模，把抽象公式、数量关系变直观，不用硬背硬记，引导孩子举一反三，轻松攻克应用题，越学越有底气。\n\t\n✅ 校内+浅奥双提升，65%校内重难点贴合新课标，35%浅奥拓展拔高，一份投入兼顾双重需求，不用额外报课，高效提升。\n\t\n✅ 中文/英文授课任选，适配不同家庭规划；40-50分钟/节，贴合小学娃注意力曲线，每周高频学习，不拖沓、不费力。\n\t\n✅ 严选优质师资，5轮筛选+360°考核，教龄5年以上，精准拿捏孩子思维卡点，耐心引导，帮孩子养成良好学习习惯。\n\t\n现在点击下方⬇【立即咨询】即可0元领取价值1888元试听大礼包！名额有限，先到先得～\n\t\n活动时间：即日起-2028年12月31日\n*仅面向海外18+家长\n\t\n#数学思维网课[话题]#  #Mathplore新加坡数学[话题]#  #新加坡数学[话题]#  #Mathplore[话题]#  #小学数学思维训练[话题]#  #小学数学怎么学[话题]#  #数学逆袭[话题]#', 'video_url': 'http://sns-video-bd.xhscdn.com/stream/79/110/259/01e9903b08281c56010370039c5b680553_259.mp4', 'time': 1771668421000, 'last_update_time': 1771060001000, 'user_id': '6504601f0000000017021a03', 'nickname': 'Mathplore数学思维', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/e6f9e621-2070-3494-bab8-b0f3f41001c0', 'liked_count': '1', 'collected_count': '3', 'comment_count': '1', 'share_count': '', 'ip_location': '四川', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041259/0bc475b7b63942b845d75601828669a2/spectrum/1040g0k031sihe4c056005p84c0fls6g3d7728ko!nd_dft_wlteh_webp_3', 'tag_list': '数学思维网课,Mathplore新加坡数学,新加坡数学,Mathplore,小学数学思维训练,小学数学怎么学,数学逆袭', 'last_modify_ts': 1772600361594, 'note_url': 'https://www.xiaohongshu.com/explore/69903b21000000001d025998?xsec_token=ABv0Z38lOPVjC18nF1xWp_0mF4lvIiGLzRgBXgTMEh_G4=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABv0Z38lOPVjC18nF1xWp_0mF4lvIiGLzRgBXgTMEh_G4='}
