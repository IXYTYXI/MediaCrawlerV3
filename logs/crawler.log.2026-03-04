2026-03-04 15:19:56 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a15e50000000002303a3c3', 'type': 'normal', 'title': '过来人告诉你：120/月数学思维直接开挂❗', 'desc': '平行线浅奥春季班开课啦！快来试试平行线 新学期轻松逆袭！低至15元/课时 -\n⛄️新学期来平行线的孩子，悄悄变了样\n✔ 思路清晰了，会主动画图、拆解题目\n✔ 专注力提升，能坚持完成90-120分钟ke堂\n✔ 不再依赖家长讲题，遇到不会的会自己先琢磨\n✔题目换个题型也不慌了，举一反三的能力到位了\n🥰在平行线上课有多省心？ 🌟课程干货拉满，不搞虚的！\n✅紧扣新ke标，基础+浅奥拓展 👉🏻不用怕学的内容跟校内脱节！老师讲的知识点全是ke本的重难点，还会延伸浅奥内容做拓展，慢慢培养理科思维，为以后L1-L8的学习打基础\n✅不教死答案，只练“活思维”！ 👉🏻平行线不教答案，而是带着孩子用不同模型解同一道题，练的是解题迁移力和思维灵活性，遇到新题也能举一反三，不再慌\n✅节奏超友好，学习休息两不误！\n👉🏻每周一次，每次2节课，，每节课90-120分钟，既不让知识点断档，又不会给孩子堆压力，多余时间还能玩能休息\n🔥新学期，给孩子一次“开窍”的机会\n👇🏻点击【立即咨询】测测孩子的数学思维在哪一关\n仅面向32岁家长\n#平行线教育[话题]#  #数学思维[话题]#   #数学素养[话题]#   #家长必看[话题]#  #数理思维[话题]#  #平行线1440年课[话题]# #浅奥思维[话题]# ##开学季[话题]# #小学奥数[话题]# #思维训练[话题]#', 'video_url': '', 'time': 1772183121000, 'last_update_time': 1772183121000, 'user_id': '642ba9780000000012011a80', 'nickname': '平行线名师大课堂', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/f0238b56-4bdd-3597-adf3-db36cfdcf315', 'liked_count': '2', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041519/56e938fee760a2f26f9897a7e69c3d61/spectrum/1040g0k031t362air56005p1bl5s4i6k0lj0lcco!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041519/f44d821ed15a6a5eb18961d8107306fe/spectrum/1040g0k031t362air560g5p1bl5s4i6k0b3uk7q8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041519/a83a2bcde88792241611e8f3db9037c4/spectrum/1040g0k031t362air56105p1bl5s4i6k0bk169v8!nd_dft_wlteh_webp_3', 'tag_list': '平行线教育,数学思维,数学素养,家长必看,数理思维,平行线1440年课,浅奥思维,开学季,小学奥数,思维训练', 'last_modify_ts': 1772608796349, 'note_url': 'https://www.xiaohongshu.com/explore/69a15e50000000002303a3c3?xsec_token=ABr_9yVr-hrBc-EABFGIVzVUPSbCfYhuLhoCaNLyiDt54=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABr_9yVr-hrBc-EABFGIVzVUPSbCfYhuLhoCaNLyiDt54='}
