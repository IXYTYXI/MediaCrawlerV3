2026-03-04 10:52:06 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a2a720000000001600a3f6', 'type': 'normal', 'title': '新加坡数学春季优惠🔥100+/节❗', 'desc': '数学思维课试过不少，不是孩子坐不住，就是方法太老套，应用题照样读不懂，换个问法就懵……\n直到遇见sparkmath新加坡数学，终于找到真正有效的！关键是，春季优惠来了，一节课100+，性价比超高！\n-\n为什么放心选sparkmath？\n✅ CPA教学法：用画图把复杂题目变直观，孩子自己推出答案，彻底告别死记硬背。\n✅ ≤8人小班直播：互动性超强，抢答PK像玩游戏，主动开麦根本停不下来。\n✅ 严选名师：平均5年以上教龄，可选中/英/双语，懂数学更懂孩子心理。\n✅ 贴心服务：专属学习规划、学后精批、全程学情反馈，及时答疑，家长省心。\n✅ 关键是有效：思路清晰了，做题不怕了，数学自信肉眼可见地起来了。\n-\n趁春季优惠，给孩子一个数学逆袭的机会，真的不亏！\n👇 现在点击下方⬇ 【立即咨询】，即可免费获得sparkmath试听课~\n✔️1节在线思维直播课\n✔️价值3422元228课时拓展课\n✔️1份专属学情诊断\n✔️1V1定制学习方案\n⏰ 活动时间：即日起-2026年12月31日\n*面向5-12岁学生家长\n#sparkmath[话题]# #sparkmath新加坡数学[话题]# #火花新加坡数学[话题]# #新加坡数学[话题]# #小学数学[话题]# #小学数学怎么学[话题]# #新加坡数学教材[话题]# #新加坡数学网课[话题]# #三年级数学[话题]#', 'video_url': '', 'time': 1772267296000, 'last_update_time': 1772267297000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '1', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041052/862c0f5f8bc48f43123ede564e7b9088/spectrum/1040g34o31t4h3i5r5e105olhcu8lbcma5iheeog!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041052/c7c837786bf3639accde236f09538d48/spectrum/1040g0k031t4h3j5gla005olhcu8lbcmarjhg2ng!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041052/49c5cd0d2cec59624594a107808d4269/spectrum/1040g0k031t4h3kqjl6005olhcu8lbcma09ie24o!nd_dft_wlteh_webp_3', 'tag_list': 'sparkmath,sparkmath新加坡数学,火花新加坡数学,新加坡数学,小学数学,小学数学怎么学,新加坡数学教材,新加坡数学网课,三年级数学', 'last_modify_ts': 1772592726225, 'note_url': 'https://www.xiaohongshu.com/explore/69a2a720000000001600a3f6?xsec_token=ABOd9DKaujxPmBXwmUsK9eV9nbhOc2VdpqnIGtwYKVsaM=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABOd9DKaujxPmBXwmUsK9eV9nbhOc2VdpqnIGtwYKVsaM='}
