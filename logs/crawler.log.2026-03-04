2026-03-04 11:24:50 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '676d0aa5000000000b0156aa', 'type': 'normal', 'title': '拒绝盲目刷题❗开启浅奥学习，普娃成功逆袭', 'desc': '⭐最近几年越来越多的家长给自家孩子报浅奥了，但是关于浅奥的东西，很多家长都是不知道的。\n📍浅奥适合谁学❓\n浅奥作为小数补充，适合成绩90+的的孩子学\n📍为什么要学浅奥❓\n可以提升孩子的逻辑思维能力，为未来学校打基础\n📍知识点有哪些❓\n计算、计数、几何、应用题、行程、组合、数论七大板块\n-\n🔥Spark Math【浅奥课程】正式上线，紧贴新课标核心要求，囊括全球第一的新加坡教法精髓，基于国内外知名数学赛事的核心知识点、主流赛事高频考点，研发的一套提升学员核心竞争力的高品质数学课程。💪\n-\n👉🏻现在点击图片下方⬇ 【立即咨询】就可以免费参与试听❗❗\n⏰ 活动时间：即日起—2025年12月31日\n*课程面向海外人群（18岁以上）\n\t\n\ufeff#小学数学怎么学[话题]#\ufeff \ufeff#新加坡数学[话题]#\ufeff \ufeff#数学思维[话题]#\ufeff \ufeff#新加坡数学网课[话题]#\ufeff \ufeff#小学数学[话题]#\ufeff \ufeff#新加坡数学cpa教学法[话题]#\ufeff \ufeff#数学逆袭[话题]#\ufeff \ufeff#数学开窍[话题]#\ufeff \ufeff#小学数学思维训练[话题]#\ufeff', 'video_url': '', 'time': 1735199397000, 'last_update_time': 1735199398000, 'user_id': '61b2fc7e000000001000f059', 'nickname': 'Spark Math线上课程', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4aeb79ls6g5odivhv41s2pgohmd30', 'liked_count': '1', 'collected_count': '', 'comment_count': '', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041124/a219f4c1eda3af69d6f80cb302e0c3d1/spectrum/1040g0k031bs5mfchg8005odivhv41s2p3l124fg!nd_dft_wlteh_webp_3', 'tag_list': '小学数学怎么学,新加坡数学,数学思维,新加坡数学网课,小学数学,新加坡数学cpa教学法,数学逆袭,数学开窍,小学数学思维训练', 'last_modify_ts': 1772594690237, 'note_url': 'https://www.xiaohongshu.com/explore/676d0aa5000000000b0156aa?xsec_token=AB3CUf9tKCSYTXprPBGVR1xIdtNaOvVR3HRLdX7Yp4jZY=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB3CUf9tKCSYTXprPBGVR1xIdtNaOvVR3HRLdX7Yp4jZY='}
