2026-03-04 17:19:53 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a5474c000000001502078d', 'type': 'normal', 'title': '收心归位🥰高中新学期想逆袭？看这篇就行', 'desc': '假期余额告急\n你家高中娃是不是还处于——\n晚上不睡💢早上不起💢\n手机不离手💢作业没写完💢\n一提开学就烦躁🤯\n.\n别急，这不是孩子懒👉这叫“假期惯性”\n是自然规律，不是态度问题⚠️\n.\n😑但是高中不等人啊！\n月考、期中、期末一环扣一环\n一步慢，步步慢⏳\n.\n那怎么帮娃收心+逆袭？\n记住：别瞎努力，要精准👇\n💎早上：唤醒思维，不拖拉，到点就学\n💎专项突破：哪里不会补哪里\n💎晚上复盘：把今天学的记住，不白学\n.\n一天下来，孩子自己都能感觉到“今天没白过”\n.\n但很多家长卡在：\n❌知道要补弱科，但不知道从哪下手\n❌知道要精准发力，但自己不会教\n❌孩子想学，但遇到难题没人问\n慢慢就不想学了......😫\n.\n这时候，光靠收心就不够了\n得有人帮他一把，把卡住的地方打通👇\n【掌门1对1学习中心】，专为高中娃1v1设计学习方案，学一个会一类\n.\n✅1对1定制课\n先测再学，哪里不会教哪里\n不浪费时间，不搞题海战术\n.\n✅老师严选\n5层筛选，全是懂考点、会讲课的\n孩子听得懂、愿意学\n✅全程有人盯\n上课有人教，作业有人管\n错题有人讲，家长不用操心\n✅在家就能上\n不用接送，时间省下来，多背20个单词\n.\n孩子遇到难题有人问，学不会的地方有人讲\n一天天积累下来，底气就出来了😃\n.\n💁🏻\u200d♀️新学期不是比谁先跑，是比谁跑得对、跑得稳！\n.\n🚩【0元】限时领掌门体验课\n1节1对1直播课➕学科诊断➕学习规划\n戳左下角↙【立即咨询】回复“开学”即可领取体验🎁\n.\n*仅限32岁以上家长领取\n*活动截止时间：即日起-2026年12月31日，先到先得\n#收心攻略[话题]# #开学规划[话题]# #开学冲刺[话题]# #高中规划[话题]# #掌门[话题]# #一对一[话题]# #努力成为更好的自己[话题]# #新学期[话题]# #在线教育[话题]# #开学摸底考[话题]#', 'video_url': '', 'time': 1772443827000, 'last_update_time': 1772439373000, 'user_id': '649a70220000000010036bfc', 'nickname': '掌门1对1学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31pumqmjhls005p4qe0h46qvs49pjit8', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '上海', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041719/6ba814989629bd2ce09a84a4aaa48197/spectrum/1040g34o31t735frjl8405p4qe0h46qvsobgtqmg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041719/4e72552ba8235063ecd13b8515ca2b0d/spectrum/1040g34o31t735frjl84g5p4qe0h46qvsgub8ij8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041719/ad704435c8825b8871aa34304ee7e9f6/spectrum/1040g34o31t735frjl8505p4qe0h46qvs52hk9h0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041719/6fd9c4060ae797c5c2ac29e22be49d94/spectrum/1040g34o31t735frjl85g5p4qe0h46qvsdird698!nd_dft_wlteh_webp_3', 'tag_list': '收心攻略,开学规划,开学冲刺,高中规划,掌门,一对一,努力成为更好的自己,新学期,在线教育,开学摸底考', 'last_modify_ts': 1772615993384, 'note_url': 'https://www.xiaohongshu.com/explore/69a5474c000000001502078d?xsec_token=ABb0ydJyN-idmOaGbwHQMIsYRCO-M8kbnFjsayT-8k8OI=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABb0ydJyN-idmOaGbwHQMIsYRCO-M8kbnFjsayT-8k8OI='}
