2026-03-04 12:57:38 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a16af90000000015033e67', 'type': 'normal', 'title': '报过最不后悔的课！真的把娃的逻辑打通了！', 'desc': '以前总觉得数学要多做题，现在发现精讲精练才是王道\nMathplore的课程设计很科学，一个知识点讲透了，孩子能触类旁通。不用刷成千上万道题，就能掌握核心方法。孩子学得轻松，效果反而更好！\n\t\n新加坡数学最牛👍的地方就是CPA教学法（Concrete-Pictorial-Abstract）\n●具象（C）：先用实物（积木、小球）让孩子摸得着\n●形象（P）：再用画图（条形图）把抽象的概念画出来\n●抽象（A）：最后才到数字和公式\n这样孩子不是死记硬背公式，而是真正理解了数学逻辑。现在我家娃做应用题，不用我教，自己就会画图分析\n\t\n之前还担心娃越来越反感数学，现在一周2节，40/50分钟一节，孩子居然主动要上课！\n从G0到G6都有，不同基础都能适配，关键是能精准定位短板，针对性练习\n[派对R]现在做题思路清晰多了，逻辑思维也强了！\n\t\n为什么选Mathplore？\n1️⃣ 体系完善：学前到六年级全覆盖，孩子跟着学就能稳步提升\n2️⃣ 方法科学：不是死记硬背，而是通过互动和练习，让孩子真正理解数学\n3️⃣ 服务贴心：实时反馈，家长也能随时了解孩子学习情况\n\t\n真心推荐去试试他们的0元试听课。好不好，让孩子亲自说了算！\n👉现在点击左下角【立即咨询】享0元试听，同时领1888数学思维大礼包📦 \u200b\n名额有限~先到先得\n~\n⏰ 活动时间：即日起至2030年12月31日\u200b\n*仅面向海外18+家长❗️\u200b', 'video_url': '', 'time': 1772186361000, 'last_update_time': 1772186362000, 'user_id': '6504601f0000000017021a03', 'nickname': 'Mathplore数学思维', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/e6f9e621-2070-3494-bab8-b0f3f41001c0', 'liked_count': '1', 'collected_count': '1', 'comment_count': '1', 'share_count': '', 'ip_location': '四川', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041257/d403b26c2e3f1f8c5f8adf4c499ae7ca/spectrum/1040g0k031t39ffk55c005p84c0fls6g3oi7ujb8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041257/faf82d587105b9a5b83b7260a6ee8834/spectrum/1040g0k031t39ffk55c0g5p84c0fls6g3dlcgfe8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041257/9854601abdd78520dee7ebbdc86fe4bc/spectrum/1040g0k031t39ffk55c105p84c0fls6g38sgi4qo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603041257/6d27d987797683c7335d5e1a4792a21d/spectrum/1040g0k031t39ffk55c1g5p84c0fls6g3ddools0!nd_dft_wlteh_webp_3', 'tag_list': '', 'last_modify_ts': 1772600258917, 'note_url': 'https://www.xiaohongshu.com/explore/69a16af90000000015033e67?xsec_token=ABr_9yVr-hrBc-EABFGIVzVU9MsYCAsK-Xx5A5vBBE5B4=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABr_9yVr-hrBc-EABFGIVzVU9MsYCAsK-Xx5A5vBBE5B4='}
