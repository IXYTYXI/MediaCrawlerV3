2026-03-04 12:30:23 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '699035b3000000001b0179c3', 'type': 'video', 'title': '小阶数学开窍选对课！ 数理思维UP📈', 'desc': '谁懂啊！小阶娃数理总卡壳，逻辑绕不明白？别再盲目刷题内耗啦！看看@跳跳妈妈在家早教  怎么用对方法，让娃数理思维原地升级👇 这门课主打“趣味+精准”，直击小阶数理痛点，把抽象数理变简单，娃越学越上头！\n\t\n✨ 阶梯适配小阶，不超前不脱节\n从数理启蒙到逻辑拓展，分阶段匹配小阶娃认知：基础薄弱补数理漏洞，想拔高就练思维题型，精准踩中娃的能力节点，循序渐进提升，越学越有成就感！\n\t\n✨ 具象启蒙→逻辑建模，数理不抽象\n用教具玩懂数理逻辑，用图形拆解抽象概念，计数器练数感，思维导图理逻辑，复杂数理关系变直观易懂～ 娃不用死记硬背，靠理解就能理清思路，举一反三超轻松！\n\t\n✨ 基础+逻辑双提升，校内衔接无压力\n内容搭配太贴心！校内核心数理考点稳稳夯实，逻辑拓展题打开思维格局，既能轻松应对校内检测，又能练出灵活解题的能力，为高年级数理学习筑牢根基！\n\t\n✨ 小班盯学，数理进步看得见\n懂小阶娃的数理引导师授课，2-6人小班直播，每节课盯紧娃的思路，手把手教方法、拆步骤；课前动画预习、课后专属练习，家长实时查看进度，省心又放心！\n小阶娃数理思维提上来，做题不卡壳、逻辑不绕弯，数理基础打扎实，高年级一路开挂不费力💪\n\t\n🎁 现在咨询可0元领1888元数学思维礼包\n\t\n限量名额，先到先得！\n\t\n📅 活动时间：即日起-2028年12月31日\n*仅面向海外18+家长\n\t\n#Mathplore新加坡数学[话题]#  #新加坡数学[话题]#  #小学数学[话题]#  #数学启蒙[话题]#  #趣味数学[话题]#  #让孩子爱上数学[话题]#  #小学数学思维训练[话题]#  #提升孩子思维能力[话题]#  #Mathplore[话题]#  #数学思维[话题]#', 'video_url': 'http://sns-video-bd.xhscdn.com/stream/1/110/259/01e99034977ca02e010370039c5b5274dc_259.mp4', 'time': 1771656240000, 'last_update_time': 1771058611000, 'user_id': '5ff43d2b0000000001001995', 'nickname': 'Mathplore线上数学', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/640f03dce33a6ed3c5116b3d.jpg', 'liked_count': '1', 'collected_count': '', 'comment_count': '1', 'share_count': '1', 'ip_location': '四川', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603041230/dfd592fbf81154aa8f6083009847b2cc/spectrum/1040g0k031sigo4e05c005nvk7klg86claibsrc8!nd_dft_wlteh_webp_3', 'tag_list': 'Mathplore新加坡数学,新加坡数学,小学数学,数学启蒙,趣味数学,让孩子爱上数学,小学数学思维训练,提升孩子思维能力,Mathplore,数学思维', 'last_modify_ts': 1772598623531, 'note_url': 'https://www.xiaohongshu.com/explore/699035b3000000001b0179c3?xsec_token=ABv0Z38lOPVjC18nF1xWp_0rKqWt2VBaAYgsoiMvqGPPo=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABv0Z38lOPVjC18nF1xWp_0rKqWt2VBaAYgsoiMvqGPPo='}
