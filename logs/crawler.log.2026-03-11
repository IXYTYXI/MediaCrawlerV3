2026-03-11 00:00:02 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '677609a1000000000b01620c', 'type': 'normal', 'title': '寒假不摆烂❗冲刺重高逆风翻盘😎', 'desc': '🔥 各位初三家长们，寒假即将来临\n可别只顾着让孩子放松、玩❓\n✅ 寒假可是一个弯道超车的好机会🏃\n⭕️ 中等生、差等生在这个关键时期把基础知识掌握好了，完全有机会冲刺重点高中💥\n·\n👉 寒假没规划❓跟着高途一对一线上网课，复习与冲刺两手抓🙌\n🈶 专属学情分析，发现问题所在，课前进行学科水平测试摸清知识薄弱点，并询问学习过程中的吃力点\n.\n🈶 1v1定制方案，打破💥知识壁垒，据此定制专属学习方案📄，结合作息规划正确学习方法\n.\n🈶 清北名师一对一直播教学，精准化解难题，课上老师根据学习方案，每天带孩子从基础知识学起以题代练，及时解答各种知识遗漏\n.\n🈶 随时答疑解惑，家长省心不费力，没学好的部分、没理解的定义原理都可以随时询问，补齐漏洞\n-\n😮\u200d💨 如果你也在为孩子的寒假规划操心\n如果你的孩子有学习没有效果、复习没方向\n↙️ 快点击左下角【立即咨询】抢占一对一试听课名额\n获取1V1专属学情分析+个性化学习计划+寒假学习计划\n-\n报名要求：32岁以上家长\n截止时间：即日起-2025年5月31日\n\ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#高途[话题]#\ufeff \ufeff#寒假逆袭[话题]#\ufeff \ufeff#冲刺[话题]#\ufeff', 'video_url': '', 'time': 1735797661000, 'last_update_time': 1735788962000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '63', 'collected_count': '24', 'comment_count': '2', 'share_count': '5', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603110000/a2ef63d22a08cba90a9bd12603a4027a/spectrum/1040g0k031c4urpsgh6005oakffv0j2cokiii6jg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603110000/d050fba84d61ccb39c624946ac8cf91b/spectrum/1040g0k031c4urpsgh60g5oakffv0j2cokuo1990!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603110000/b7e66e5868b8b6652170d7200248ee02/spectrum/1040g0k031c4urpsgh6105oakffv0j2co100ochg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603110000/aea0285b3afd495277f097f47432facc/spectrum/1040g0k031c4urpsgh61g5oakffv0j2co5v2v0eg!nd_dft_wlteh_webp_3', 'tag_list': '一对一,网课,高途,寒假逆袭,冲刺', 'last_modify_ts': 1773158402289, 'note_url': 'https://www.xiaohongshu.com/explore/677609a1000000000b01620c?xsec_token=ABcbVNLlsM-ZSZb4ks3AmkNGZ3-nXxUm-55RuCauMu_fw=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABcbVNLlsM-ZSZb4ks3AmkNGZ3-n