2026-03-11 00:03:34 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '675b8d35000000000603b733', 'type': 'normal', 'title': '30天领跑？中等生的网课“天花板”来了‼️', 'desc': '眼看这学期马上结束，你家孩子成绩仍不见起色❓\n😢休息日为去补习班带娃狂挤公交，心力交瘁？\n😓白天上学晚上熬夜继续学，毫无效果？\n😫基础薄弱，学习兴趣越来越少❓\n🥱自己工作忙没时间辅导，唉声叹气？\n.\n别慌，现在有一个绝妙的解决方法❗️\n🌟请跟随我的脚步，一起来探索【高途一对一】的神奇力量❗️\n.\n⬇️⬇️⬇️\n【师资力量雄厚】\n🧑\u200d🏫清北等名校的优秀教师，工作认真负责，一对一教学经验极为丰富\n【课前规划】\n🐚入学前进行专属学情规划，通过摸底测验等方式了解孩子学习情况，制定学习方案\n【课中学习】\n🏫老师一对一教学，全程互动，孩子沉浸式学习\n梳理知识点，深入讲解重难点，传授做题技巧和学习方法\n【课后反馈】\n✍️根据课程进度布置作业，设立专属的课程督学老师和授课老师\n及时批改作业并反馈，及时调整学习方案\n-\n🔗现在点【立即咨询】即可预约试听课\n🎁还能领取免费1V1全科规划\n🎯1v1学情分析➕学习规划➕各科资料包\n📅活动截止时间：即日起-2025年12月31日\n\ufeff#高途[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#中等生[话题]#\ufeff \ufeff#家长必读[话题]#\ufeff', 'video_url': '', 'time': 1734053173000, 'last_update_time': 1734053173000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '58', 'collected_count': '6', 'comment_count': '', 'share_count': '5', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603110003/ae7f9efd636a1045b0da1766de6944ee/spectrum/1040g0k031bb36bau6m005oakffv0j2copnhk0u8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603110003/e1ffde2090f1efd17341a7776247e0e2/spectrum/1040g0k031bb36bau6m0g5oakffv0j2co5ec4ijg!nd_dft_wlteh_webp_3', 'tag_list': '高途,网课,一对一,中等生,家长必读', 'last_modify_ts': 1773158614281, 'note_url': 'https://www.xiaohongshu.com/explore/675b8d35000000000603b733?xsec_token=ABqw6IgjKHqe-KGX7OJS-myMCOIFSjz27TWgyvwXmKnUk=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABqw6IgjKHqe-KGX7OJS-myMCOIFSjz27TWgyvwXmKnUk='}
