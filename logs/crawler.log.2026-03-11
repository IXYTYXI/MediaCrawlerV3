2026-03-11 11:21:26 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69aa77a4000000002603eb78', 'type': 'normal', 'title': '我要验牌🔥原来拿下小学数学前三这么容易', 'desc': '🔥 挖到宝了！之前总纳闷别人家娃数学怎么学得那么轻松\n今天研究完sparkmath新加坡数学的课程体系，算是彻底悟了！\n原来拿下小学数学前三，靠的真的不是死刷题😱\n-\n🎯【课程亮点】\n✔️3-8人精品小班直播课\n✔️40-55分钟/节，专注力MAX\n✔️低至100+/小时，超高性价比\n✔️清北名师授课，教学经验丰富\n✔️中/英/双语三种模式任选，满足不同需求\n📚 【课程体系】\n▫️ 1-7节：20以内加减法+图形认知\n▫️ 8-16节：120以内加减法+乘除概念\n▫️ 17-24节：大数运算+分数周长\n▫️ 25-31节：分数小数+面积统计+方程启蒙\n循序渐进，完全不担心孩子跟不上！\n👩🏫【金牌师资】\n冉明月：北京交通大学毕业，8年一线教学经验\n李雅婷：北京师范大学毕业，累计授课5000+小时\n罗程程：北京大学毕业，奥赛金牌教练\n-\n🎁现在点击左下角【立即咨询】0元还能领取体验包：\n✅1节在线思维直播课\n✅1v1名师专属定制学情规划\n✅3422元228课时礼包\n点击下方【立即咨询】免费领取试听课\n*报名要求：面向5-12岁家长群体\n*截止时间：即日起-2027年12月31日\n#sparkmath[话题]# #新加坡数学[话题]# #sparkmath新加坡数学[话题]# #数学思维[话题]# #孩子教育[话题]# #学习规划[话题]#', 'video_url': '', 'time': 1772779428000, 'last_update_time': 1772779429000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '1', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603111121/2b1a9bf73255b6c497e971a46adf808c/spectrum/1040g34o31tc58f49l6405olhcu8lbcmas5hecig!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603111121/119f134ef420f279b3a0a932555557cb/spectrum/1040g34o31tc58f49l64g5olhcu8lbcmames4st0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603111121/3a189042b9107745fb28ef8f00efedf6/spectrum/1040g34o31tc58f49l6505olhcu8lbcmanemasio!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603111121/6ba72679704c19721af6c7f15108760d/spectrum/1040g34o31tc58f49l65g5olhcu8lbcmanqsc4r0!nd_dft_wlteh_webp_3', 'tag_list': 'sparkmath,新加坡数学,sparkmath新加坡数学,数学思维,孩子教育,学习规划', 'last_modify_ts': 1773199286967, 'note_url': 'https://www.xiaohongshu.com/explore/69aa77a4000000002603eb78?xsec_token=ABEY8sU4xINMp3qbyKnY2hi08v-x-qFdz41WICjWymNXU=&xsec_source=pc_searc