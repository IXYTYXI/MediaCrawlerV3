2026-03-11 00:02:40 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '675b8f02000000000700d559', 'type': 'normal', 'title': '初中中等生敢接受寒假一对一逆袭挑战吗👊', 'desc': '初中孩子不够自律，抓住寒假狠狠提升！\n🚀家长们，是不是还在为孩子的学习规划挠头？\n🤔 别担心，把孩子交给我们\n👉寒假一对一有规划的盯着学\n孩子从“推一下动一下”到主动出击\n✅不仅能自觉完成作业，还能自主规划学习和复习\n✅学习热情高涨，成就感满满！\n-\n💫💥【课前准备】\n课前摸底测，探测知识盲区，帮家长定位孩子短板，根据孩子喜好，个性化匹配老师\n📺✨【1V1直播引导】\n实时双向在线互动，课堂完成3个核心目标，细致剖析知识点，攻克学习难点\n📝🧑🏻\u200d💻【课后1V1伴学】\n· 专属学情诊断\n报告制定1v1学习方案，针对学情规划更高效\n· 专属试卷分析\n报告分析大考试卷，找到知识薄弱点\n· 专属1v1答疑群\n主讲全程答疑，减轻家长陪读压力\n-\n👇 限时体验👇\n•点击左下角，领取【0元1V1全科规划】\n•一对一专业指导，量身打造学习策略\n•心态调整秘籍，激发内在学习动力\n•专属沟通群，家长、老师无缝对接\n•课后疑惑随时解答，学习无后顾之忧\n👉 仅限32岁以上家长报名\n👉活动时间截止到2024年12月31日，赶紧行动起来吧！\n\ufeff#高途[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#寒假[话题]#\ufeff \ufeff#逆袭[话题]#\ufeff', 'video_url': '', 'time': 1734068040000, 'last_update_time': 1734053635000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '7', 'collected_count': '3', 'comment_count': '1', 'share_count': '4', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603110002/054f015187fcebaded41451b3fba12a5/spectrum/1040g34o31bb3e70ani0g5oakffv0j2coutugkg8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603110002/b28c663b3e33d4dad52898e7e6736cfc/spectrum/1040g34o31bb3brnnnq1g5oakffv0j2conmcfj00!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603110002/3c83ce683ea63a835d4a611da7b0f5d6/spectrum/1040g34o31bb3brnnnq205oakffv0j2congrsqfg!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,寒假,逆袭', 'last_modify_ts': 1773158560614, 'note_url': 'https://www.xiaohongshu.com/explore/675b8f02000000000700d559?xsec_token=ABqw6IgjKHqe-KGX7OJS-myGJHNW-oRF9AC4Fl__gbwzA=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABqw6IgjKHqe-KGX7OJS-myGJHNW-oRF9AC4Fl__gbwzA='}
