2026-03-11 00:02:19 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '676cc035000000000b00db9c', 'type': 'normal', 'title': '学霸私藏🔥靠它一周逆袭期末', 'desc': '😫 期末考试马上就要来了\n你家的孩子是不是还在为复习发愁❓\n别担心，高途一对一来帮你解决！让孩子轻松应对期末❗️\n-\n⭕️ 【跟着高途1对1，找出薄弱，重点记忆，全面拔高】\n✅ 课前1V1预学\n课前摸底测，探测知识盲区，帮家长定位孩子短板，根据孩子喜好，个性化匹配老师；\n✅ 1V1直播引导\n实时双向在线互动，课堂完成3个核心目标，细致剖析知识点，攻克学习难点，老师通过线上视频与学生面对面交流，上课时间和地点更加灵活；\n✅ 课后1V1伴学\n课后批改作业，巩固知识点，报告分析大考试卷，找到知识薄弱点\n-\n现在点击下方【立即咨询】，即可预约体验课！\n免费🉐1V1学习规划+专属分析报告+精细化服务\n👪 面向32岁以上家长\n📅 截止时间：即日起至2025年12月31日止\n\ufeff#期末[话题]#\ufeff \ufeff#逆袭[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#网课[话题]#\ufeff \ufeff#高途[话题]#\ufeff \ufeff#复习规划[话题]#\ufeff', 'video_url': '', 'time': 1735180341000, 'last_update_time': 1735180341000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '1', 'comment_count': '', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603110002/a37a0a8b4a522e5196aed07ff502c064/spectrum/1040g34o31brslir912105oakffv0j2codvp7aqg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603110002/9a83fa81e65624615ec0702c2c90d07d/spectrum/1040g34o31brslir9121g5oakffv0j2co4ebt1e8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603110002/b0d5e7950b323a8bbce9246b991e53b6/spectrum/1040g34o31brslir912205oakffv0j2cocvdj1k8!nd_dft_wlteh_webp_3', 'tag_list': '期末,逆袭,一对一,网课,高途,复习规划', 'last_modify_ts': 1773158539614, 'note_url': 'https://www.xiaohongshu.com/explore/676cc035000000000b00db9c?xsec_token=ABn7jfRuTjyYGBLCRQE6MBj_04aby45Y4BBfdSr0qnLKY=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABn7jfRuTjyYGBLCRQE6MBj_04aby45Y4BBfdSr0qnLKY='}
