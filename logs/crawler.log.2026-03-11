2026-03-11 00:00:22 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67760908000000000800fe69', 'type': 'normal', 'title': '出分特快❗️高途一对一寒假班即将封班🔥', 'desc': '元旦已过，马上就是寒假了❗️\n趁着超长假期赶紧卷起来吧❗️\n高途1对1寒假班特训营开始报名啦🙀\n-\n【加入高途1对1寒假特训营，可以获得】\n✅ 1对1规划：学生的升学之路，个性化定制学习方案，科学有效，详细到每日的学习任务\n.\n✅ 1对1诊断：根据孩子的基础和学习目标，通过摸底测试，精准诊断学生各科目模块的学习情况，找准薄弱项\n.\n✅ 1对1答疑：答疑老师均有📈分经验，对各科目都有自己的实战方法论，思路、解题、方法，全方位、无时限答疑\n.\n✅ 1对1直播课：一对一直播讲解进行学科知识梳理、重难点讲解全面教授破题思路及方法技巧\n-\n⬇️ 现在点击图片下方 【立即咨询】抢占试听名额💝\n👫 面向人群：* 仅面向32岁以上家长群体\n📆 活动时间：即日起-2025年5月31日\n\ufeff#高途[话题]#\ufeff\xa0\xa0\ufeff#一对一[话题]#\ufeff\xa0\xa0\ufeff#网课[话题]#\ufeff\xa0\xa0\ufeff#寒假[话题]#\ufeff\xa0\xa0\ufeff#逆袭[话题]#\ufeff', 'video_url': '', 'time': 1735788808000, 'last_update_time': 1735811687000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '3', 'collected_count': '', 'comment_count': '2', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603110000/84c1df534675cbfdfaae014101a3c7c3/spectrum/1040g0k031c59mq1m0e005oakffv0j2cotfhquj0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603110000/3908484b3cce0c1105bf10fac5dd2485/spectrum/1040g0k031c59mq1m0e0g5oakffv0j2cohf5831g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603110000/97ec6ddbfc2a69afd52888923374fb91/spectrum/1040g0k031c59mq1m0e105oakffv0j2coedmc1e0!nd_dft_wlteh_webp_3', 'tag_list': '高途,一对一,网课,寒假,逆袭', 'last_modify_ts': 1773158422691, 'note_url': 'https://www.xiaohongshu.com/explore/67760908000000000800fe69?xsec_token=ABcbVNLlsM-ZSZb4ks3AmkNPIcV6vUlFjxoUaUlYnJyp4=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABcbVNLlsM-ZSZb4ks3AmkNPIcV6vUlFjxoUaUlYnJyp4='}
