2026-03-11 15:06:30 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69b1079d000000002303b5a1', 'type': 'normal', 'title': '二下有想学浅奥思维吗？我娃就是这么开窍…', 'desc': '二年级有想找到靠谱的浅奥课，真正提高娃的数学思维吗❓\n我也踩过很多坑：\n❌录播课当背景音，孩子边吃边玩，完全不走心\n❌只会刷题背套路，题型一换立刻懵\n❌超前太猛，娃越学越自卑，钱花了信心没了\n如果你家有二年级的孩子，想周末提升思维，又不想瞎试错 真心推荐\n👉平行线浅奥思维班 18年老牌机构，只做数理思维培优，内容全是课堂里磨出来的！\n👩\u200d🏫清北名师·真人直播 低龄娃真的别靠录播学思维！ 直播才能当场纠思路、讲透逻辑，不糊弄。 老师均来自清北/C9/985/211，还有持证数竞教练，教龄足、讲得透。\n💥三类班型·精准匹配\n✅笃学班：夯实基础+浅奥启蒙\n✅睿学班：浅奥为主，冲优秀拔高\n✅创新班：挑战高阶，适合思维强娃\n💪不教死套路·只练活思维 不背模板、不套公式 重点教孩子拆题、推理、验证 做到**会一道，通一类** 校内考试、拓展题、压轴题全都稳！\n💰1440元=96节直播课+全套服务\n✅季度纸质教材包邮\n✅阶段思维测评\n✅每月加餐小灶课\n✅365天1V1真人答疑\n想让孩子周末系统学浅奥、跟着靠谱老师练思维 👇点击【立即咨询】 报年级+基础，我帮你精准选班型！\n#数学思维[话题]#    #小学奥数[话题]#    #思维训练[话题]#    #线上课程[话题]#    #平行线教育[话题]# #浅奥思维[话题]# #奥数思维[话题]#', 'video_url': '', 'time': 1773209501000, 'last_update_time': 1773209502000, 'user_id': '642ba9780000000012011a80', 'nickname': '平行线名师大课堂', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/f0238b56-4bdd-3597-adf3-db36cfdcf315', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603111506/8b9d4e6172c294434f1eb033bb2443a0/spectrum/1040g34o31tii7ecel8105p1bl5s4i6k0vulfkd0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603111506/8567616e01d4eecd0e58301b43e3b02c/spectrum/1040g34o31tii7m8h58205p1bl5s4i6k0vouqbl0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603111506/0301981c8f31aee014f78bffb63c884f/spectrum/1040g34o31tii7m8h582g5p1bl5s4i6k0iqvi30g!nd_dft_wlteh_webp_3', 'tag_list': '数学思维,小学奥数,思维训练,线上课程,平行线教育,浅奥思维,奥数思维', 'last_modify_ts': 1773212790156, 'note_url': 'https://www.xiaohongshu.com/explore/69b1079d000000002303b5a1?xsec_token=ABhfDeuCEAlFJZLSYMUHqXFAq-kIhKt1C27OkM9AbjLsA=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABhfDeuCEAlFJZLSYMUHqXFAq-kIhKt1C27OkM9AbjLsA='}
