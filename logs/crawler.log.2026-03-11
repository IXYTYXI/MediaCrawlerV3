2026-03-11 15:05:58 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69b10a730000000026032702', 'type': 'normal', 'title': '庆幸三年级抓对了！普娃成绩逆袭到前三🔥', 'desc': '真的庆幸三年级抓对了，孩子成绩稳定到前三！\n有没有宝妈和我一样，疯狂试听各种数理思维课🧐 前前后后试了快10家… 要么讲得枯燥，要么课程零散没体系… 直到遇到平行线浅奥数理思维课，真的香！！\n✨为什么我果断直接报？✨\n✅【真人直播互动，拒绝走神摸鱼】 不是录播！不是AI念课！ 实时连麦+课堂互动+随时提问，孩子全程专注，根本没空走神🙅\n✅【清北名师+分层教学+双师护航】 清北/985名师团队，教龄超8年 笃学班｜睿学班｜创新班，按基础精准分班 主讲+辅导双师跟踪，学习状态全同步，家长超安心📲\n✅【从根上练思维，不刷题不背套路】 覆盖小学核心数理逻辑+浅奥方法 不硬灌答案，只教思路，孩子真正举一反三，题型再变也不慌 思路一通，数学越学越顺🤩\n✅【价格良心，性价比拉满】 一年系统学，一周1次2节课 低至**15元/课时**，比线下便宜太多，效果更稳 普通家庭也能轻松上好课！\n如果你也在找：\n✔️真名师\n✔️真互动\n✔️体系完整 ✔️价格实在 的数学思维课 真心建议试试平行线！\n👇点击【立即咨询】 领专属测评+学习诊断报告 帮孩子精准匹配最适合的班型💪\n#平行线教育[话题]#   #数学思维[话题]#   #数学素养[话题]##数学思维训练[话题]#      #三年级数学思维[话题]#   #家长必看[话题]#  #浅奥思维[话题]#   #奥数思维[话题]# #家长收藏孩子受益[话题]#', 'video_url': '', 'time': 1773210227000, 'last_update_time': 1773210227000, 'user_id': '642ba9780000000012011a80', 'nickname': '平行线名师大课堂', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/f0238b56-4bdd-3597-adf3-db36cfdcf315', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603111505/7fe23771b214c85dc8e00197f8cdbe09/spectrum/1040g34o31tiijg93l6105p1bl5s4i6k04am38q0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603111505/246c5cd8a75b213323ce69190d387ba2/spectrum/1040g34o31tiik7vbme105p1bl5s4i6k0r671dlg!nd_dft_wlteh_webp_3', 'tag_list': '平行线教育,数学思维,数学素养,数学思维训练,三年级数学思维,家长必看,浅奥思维,奥数思维,家长收藏孩子受益', 'last_modify_ts': 1773212758151, 'note_url': 'https://www.xiaohongshu.com/explore/69b10a730000000026032702?xsec_token=ABhfDeuCEAlFJZLSYMUHqXFE46g26PhIsBjDFRd722RPY=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABhfDeuCEAlFJZLSYMUHqXFE46g26PhIsBjDFRd722RPY='}
