2026-03-11 00:00:37 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '677608c4000000000b00c478', 'type': 'normal', 'title': '初三家长别怪我没提醒❗千万要抓寒假', 'desc': '🚩 最后一个寒假对于很多学生来说是一个不可多得的机会\n❤️ 无论是逆袭上游，还是冲刺重点高中\n只要掌握正确的学习方法+专业辅导=逆袭成功\n-\n✅ 这个天花板级别的一对一网课，一定要让孩子来听一下！\n不用来回奔波，在家就能高效学！\n🧑\u200d🏫 而且是清北老师一对一辅导，哪里不会补哪里，真的太香了！！！\n-\n【选择高途一对一网课，在这个寒假收获👇】\n🔥 名师辅导，快速理清学习脉络\n为孩子量身打造个性化的学习方案，系统性数理知识点，学习脉络在脑中清楚呈现；\n.\n🔥 做题有道，轻松掌握解题思维\n清北名师1对1带着孩子理清资料库各种题型，锻炼核心思维能力，万能解法信手拈来；\n.\n🔥 引导教学，攻破薄弱知识点\n让孩子摒弃被动学习模式，主动思考，因材施教，激发孩子自主学习能力，各科全面拔高！\n-\n🙋 家长们，赶紧点击左下角【立即咨询】\n🎉 领取0元免费一对一个性化调研+专属分析报告+精细化服务\n💬 报名要求：仅面向32岁以上家长\n⏰ 截止时间：即日起至2025年5月31日\n\ufeff#网课[话题]#\ufeff \ufeff#一对一[话题]#\ufeff \ufeff#高途[话题]#\ufeff \ufeff#家长必读[话题]#\ufeff \ufeff#寒假逆袭[话题]#\ufeff', 'video_url': '', 'time': 1735788740000, 'last_update_time': 1735788740000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '1', 'collected_count': '', 'comment_count': '', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603110000/0ca4a95a33526048b37741a77ab32221/spectrum/1040g0k031c4up5tdh2005oakffv0j2co7l3n2hg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603110000/d9d521a89479d7ecfb8ec19a6e3eaa32/spectrum/1040g0k031c4up5tdh20g5oakffv0j2col4c5vr0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603110000/d1d3d080f4ec942ca6e8b639b208473d/spectrum/1040g0k031c4up5tdh2105oakffv0j2cohl1eg90!nd_dft_wlteh_webp_3', 'tag_list': '网课,一对一,高途,家长必读,寒假逆袭', 'last_modify_ts': 1773158437122, 'note_url': 'https://www.xiaohongshu.com/explore/677608c4000000000b00c478?xsec_token=ABcbVNLlsM-ZSZb4ks3AmkNFA_mSY5gII64dlOcmldHqw=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABcbVNLlsM-ZSZb4ks3AmkNFA_mSY5gII64dlOcmldHqw='}
