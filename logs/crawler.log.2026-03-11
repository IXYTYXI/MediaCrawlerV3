2026-03-11 00:03:22 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '675b8d7a000000000700af69', 'type': 'normal', 'title': '冲刺重高布局㊙️现在开始规划还不晚🔥', 'desc': '📅转眼间已经到了年底，初三上学期也过半了❗️\n有的家长现在心里开始着急了😧想要孩子冲刺重高，但是该准备些什么呢❓\n-\n想帮孩子的安排好学习计划❓但是不知道哪里是重点❌\n想让孩子养成良好学习习惯❓但孩子总是走神没效果❌\n更有的家长，用心陪伴孩子学习，但是沟通上总是碰壁😭真是太愁人了😭\n.\n别急，途途来了👉高途一对一高效冲刺班，让初三家长不再愁\n-\n✅点对点沟通，摸底测试了解问题\n✅制定学习目标，专属规划师给孩子做专属规划\n✅全程督学，主讲老师直播，辅导老师课后答疑\n-\n🔗现在点【立即咨询】即可预约试听课\n🎁还能领取免费1V1全科规划\n🎯1v1学情分析➕学习规划➕各科资料包\n📅活动截止时间：即日起-2025年12月31日\n\ufeff#一对一辅导教学[话题]#\ufeff\xa0\ufeff#高途网课[话题]#\ufeff\xa0\ufeff#逆袭[话题]#\ufeff\ufeff', 'video_url': '', 'time': 1734056821000, 'last_update_time': 1734053283000, 'user_id': '61547bfe0000000002018998', 'nickname': '高途学习中心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/662b5abe22da3c000129394f.jpg', 'liked_count': '5', 'collected_count': '5', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603110003/1e53aa8d6d36ddf361df7a9c762f5d4f/spectrum/1040g34o31bb38uo97q2g5oakffv0j2co6u39fm0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603110003/a3168669afd28469986ad0ec816c8a04/spectrum/1040g34o31bb38uo97q305oakffv0j2conpghmio!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603110003/ced21a30cbfbfd24ceb5f39b4e8fe1f0/spectrum/1040g34o31bb38uo97q3g5oakffv0j2coj0mqhc8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603110003/afcaddf5ed5164fdf73b5b437b1b7005/spectrum/1040g34o31bb38uo97q405oakffv0j2comr3ql4g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603110003/d86e277334a51e7be420e6d7e9941fee/spectrum/1040g34o31bb38uo97q4g5oakffv0j2cot9bmei8!nd_dft_wlteh_webp_3', 'tag_list': '一对一辅导教学,高途网课,逆袭', 'last_modify_ts': 1773158602746, 'note_url': 'https://www.xiaohongshu.com/explore/675b8d7a000000000700af69?xsec_token=ABqw6IgjKHqe-KGX7OJS-myBKK_e6HLNJR9mczpuDEk0I=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABqw6IgjKHqe-KGX7OJS-myBKK_e6HLNJR9mczpuDEk0I='}
