2026-03-11 15:06:09 MediaCrawler INFO (__init__.py:171) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69b1091100000000220236cb', 'type': 'normal', 'title': '别再瞎找啦！让娃数学思维开窍宝藏课在这！', 'desc': '😭谁懂啊！想让娃数学思维开窍，又怕太超前打击信心，直到刷到这个平行线浅奥思维直播班！  🔥 平行线数学思维优势\n✅ 因材施教 不管是没接触过浅奥的普通娃，还是有基础想拔高的孩子 都能听得懂、跟得上，再也不担心“陪跑式”报班！\n✅ 清北名师带学，沉浸式互动多 全程真人直播面对面，孩子能举手连麦主动发言 老师会根据吸收节奏调整进度，每节课留足时间答疑 难题讲透，走神、问题攒堆的痛点一次性解决！\n✅ 闭环进阶+双师陪跑，知识不打折 直播学习+智能监督，孩子走神及时提醒 365天1V1解答，当天问题当天清，知识吸收更扎实\n✅ 性价比直接拉满 1440 元 = 96 课时，每周 1 次 L1-L2 每次 90 分钟，L3-L9 每次 120 分钟 花小钱办大事，比盲目报班划算太多！\n➜现在点击左下角【立即咨询】领取限时优惠！\n同时免费享：\n✅ 2次正课试听\n✅ S级规划师1V1测评分析\n✅ 金牌伴学老师定制学习报告\n👦🏻*仅面向32岁以上家长人群\n#平行线教育[话题]#  #数学思维[话题]#  #数学思维训练[话题]#  #数学思维培养[话题]#  #平行线1440年课[话题]# #小学奥数[话题]# #小学数学[话题]# #浅奥思维[话题]# #二年级数学思维[话题]# #三年级数学思维[话题]#', 'video_url': '', 'time': 1773209873000, 'last_update_time': 1773209874000, 'user_id': '642ba9780000000012011a80', 'nickname': '平行线名师大课堂', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/f0238b56-4bdd-3597-adf3-db36cfdcf315', 'liked_count': '', 'collected_count': '', 'comment_count': '1', 'share_count': '', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603111506/a216e163a54d974306e60b0e65fcd362/spectrum/1040g34o31tiidnmtl8105p1bl5s4i6k08cq4up0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603111506/51d0ecb1bbfe630d8033a0681a1d2452/spectrum/1040g34o31tiiej4b5e0g5p1bl5s4i6k0b34irm0!nd_dft_wlteh_webp_3', 'tag_list': '平行线教育,数学思维,数学思维训练,数学思维培养,平行线1440年课,小学奥数,小学数学,浅奥思维,二年级数学思维,三年级数学思维', 'last_modify_ts': 1773212769825, 'note_url': 'https://www.xiaohongshu.com/explore/69b1091100000000220236cb?xsec_token=ABhfDeuCEAlFJZLSYMUHqXFLdBFsJmVfGhAValEMAeXS4=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABhfDeuCEAlFJZLSYMUHqXFLdBFsJmVfGhAValEMAeXS4='}
