2026-03-09 16:17:25 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '66a1e9ef000000002701ca29', 'type': 'normal', 'title': '谁敢信😭孩子玩着玩着就把数学拿下了', 'desc': '精英家庭都在偷偷给孩子学的新加坡数学课‼️‼️\n看看到底是哪位家长还没给孩子安排上👀\n-\n🔥授课语言：纯英文/纯中文/中英双语\n🌈课程优势：课程涵盖了大部分校内课程，其中包含数学、中文和英语。通过影视级的交互课件，调动孩子的多项感官，提升孩子的注意力，使学习效率更高\n🥰课程价值：通过在线小班直播课让孩子获得有趣、高效的学习体验，从而达到良好的学习效果，为孩子建立自信。同时也融合了新加坡数学袋鼠竞赛的相关T目，为孩子后期参加竞赛打基础\n-\n重要‼️‼️\n现在点击图片下方⬇ 【立即领取】还能免费获得\n🎉Spark Math试听体验课噢，包括\n🎈 1节在线思维直播课\n🎈 12节数独趣味课\n🎈 小学速算巧算训练营课\n⏰ 截止时间：2024年12月31日\n*课程面向海外人群\n#新加坡数学CPA教学法[话题]#\xa0\xa0#新加坡数学网课[话题]#\xa0\xa0#新加坡数学[话题]#\xa0\xa0#新加坡数学建模[话题]#\xa0\xa0#新加坡数学补习[话题]#\xa0\xa0#新加坡数学竞赛[话题]#\xa0\xa0#新加坡数学应用题[话题]#\xa0\xa0#新加坡数学思维[话题]#\xa0\xa0#新加坡数学课[话题]#\xa0\xa0#新加坡数学课程[话题]#\xa0\xa0#新加坡数学教材[话题]#\xa0\xa0#新加坡数学老师[话题]#\xa0\xa0#新加坡数学英文[话题]#\xa0\xa0#新加坡数学cpa[话题]#\xa0\xa0#sparkmath新加坡数学[话题]#\xa0\xa0#Sparkmath新加坡数学海外版[话题]#\xa0\xa0#学霸[话题]#\xa0\xa0#鸡娃[话题]#\xa0\xa0#数形结合[话题]#', 'video_url': '', 'time': 1721898095000, 'last_update_time': 1721887215000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '1', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603091617/eebffce5277dfd8f59a732dee98f0db8/spectrum/1040g0k0315lpvo14go005olhcu8lbcma30g0bpg!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学CPA教学法,新加坡数学网课,新加坡数学,新加坡数学建模,新加坡数学补习,新加坡数学竞赛,新加坡数学应用题,新加坡数学思维,新加坡数学课,新加坡数学课程,新加坡数学教材,新加坡数学老师,新加坡数学英文,新加坡数学cpa,sparkmath新加坡数学,Sparkmath新加坡数学海外版,学霸,鸡娃,数形结合', 'last_modify_ts': 1773044245040, 'note_url': 'https://www.xiaohongshu.com/explore/66a1e9ef000000002701ca29?xsec_token=AB7Qw2y71d2moF3_IN93h2dzEmUYDCx4AMsSvwtukU5JU=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB7Qw2y71d2moF3_IN93h2dzEmUYDCx4AMsSvwtukU5JU='}
