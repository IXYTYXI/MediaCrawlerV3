-webpic-qc.xhscdn.com/202603092012/6811b41cb2017a320f5997367e0b3e1b/spectrum/1040g0k031m0sn47450005q32jkdmr7131iurgi8!nd_prv_wlteh_webp_3', 'live_photo': False}], 'tag_list': [{'id': '5be3f4505b18e80001167d7c', 'name': '数学', 'type': 'topic'}, {'id': '610160dd000000000100b9d9', 'name': '小学数学', 'type': 'topic'}, {'id': '5be51be7d970510001f3117c', 'name': '数学启蒙', 'type': 'topic'}, {'type': 'topic', 'id': '60389112000000000101f769', 'name': '益智动画'}, {'id': '5d3fa829000000000d025b0e', 'name': '数学计算', 'type': 'topic'}, {'type': 'topic', 'id': '623d83f30000000001002ed8', 'name': '让孩子爱上数学'}, {'type': 'topic', 'id': '5c7a5ce6000000000f016c8e', 'name': '数学思维'}, {'id': '5c38ac5a000000000d0178b9', 'name': '小学数学思维训练', 'type': 'topic'}, {'id': '5da1db6e000000000103ebf7', 'name': '三年级', 'type': 'topic'}, {'id': '5f9224750000000001007711', 'name': '三年级上册数学', 'type': 'topic'}], 'share_info': {'un_share': False}, 'note_id': '68b98d3f000000001d03b3e6', 'title': '三年级数学课内同步动画预习-三位数连加', 'user': {'xsec_token': 'ABlz-6kaRZFsgV4pgdmsxbb7IYHUp2aJTtkEZphb92V9s=', 'user_id': '68629d1b000000001b019c23', 'nickname': '小爱知识课堂', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31ovksurt126g5q32jkdmr713sjnv3s0'}, 'video': {'media': {'video_id': 137563802417218122, 'video': {'biz_id': '281678993016992742', 'duration': 250, 'md5': '3f3c213e0216bb6943a45c6e23b89163', 'hdr_type': 0, 'drm_type': 0, 'stream_types': [259, 114, 115], 'biz_name': 110}, 'stream': {'h264': [{'format': 'mp4', 'audio_duration': 249243, 'backup_urls': ['http://sns-bak-v1.xhscdn.com/stream/1/110/259/01e8b98ca907c24a010370039914d0caaa_259.mp4', 'http://sns-bak-v6.xhscdn.com/stream/1/110/259/01e8b98ca907c24a010370039914d0caaa_259.mp4'], 'hdr_type': 0, 'ssim': 0, 'video_bitrate': 420654, 'master_url': 'http://sns-video-al.xhscdn.com/stream/1/110/259/01e8b98ca907c24a010370039914d0caaa_259.mp4', 'vmaf': -1, 'height': 960, 'avg_bitrate': 491221, 'fps': 30, 'audio_codec': 'aac', 'audio_channels': 2, 'width': 720, 'volume': 0, '