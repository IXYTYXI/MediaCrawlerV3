2026-03-09 21:10:21 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6969acd0000000002200a343', 'type': 'video', 'title': '甩掉题海战术🚀CPA让孩子迷上思考', 'desc': '多年的教育实践证明\n没有学不好的孩子\n只有不适合的方法\nCPA教学法的最大优势\n在于它的个性化适应性\n进度个性化\n根据孩子的实际水平\n调整C-P-A各阶段进度\n确保每个孩子都能跟上\n方法个性化\n针对不同学习风格\n提供多种学习方法\n找到最适合的思维路径\n目标个性化\n基于孩子的能力特点\n设定合理的学习目标\n在成功中建立自信\n无论孩子现在数学水平如何\nCPA教学法都能帮助他\n找到最适合的学习路径\n释放数学潜能\n获得学习成功\n\t\nMathplore新加坡数学采用科学的CPA教学法\n专门针对5-12岁孩子提升数学思维的小班直播课：\n💁动画+故事+游戏+高频互动，提升专注力，让每个孩子都有表现机会\n💁有中教和欧美外教，英文班、中文班灵活选择\n💁紧跟校内重难点知识，同时拓展到竞赛相关的知识，基于新加坡和美国顶尖小学数学教材研发标准\n💁小班直播课（2-6人），40-50min一节\n💁师资力量强大，教研团队成员均有10-20年教学或教研经验，很多授课老师还是竞赛金牌教练\n-\n不管是给孩子数学思维提升，还是助力提升数学成绩，都超合适！\n🔥现在点击头像进入直播间，即可领取试听名额～\n课程领取活动时间：即日起至2026年12月31日\n*课程面向海外18+人群\n#mathplore新加坡数学[话题]# #数学思维[话题]# #小学数学[话题]# #让孩子爱上数学[话题]# #提升孩子思维能力[话题]# #逻辑思维[话题]# #思维训练[话题]# #孩子爱上学习[话题]#', 'video_url': 'http://sns-video-hs.xhscdn.com/stream/79/110/259/01e969ac499e2a7a010370039bc4cb7a3d_259.mp4', 'time': 1768533200000, 'last_update_time': 1768533201000, 'user_id': '65fea988000000000600d7df', 'nickname': '新加坡数学直播课', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31l5nb3hnku6g5pful641hluvnpkhvgg', 'liked_count': '74', 'collected_count': '112', 'comment_count': '2', 'share_count': '33', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603092108/79d5b70e5e5630c1e3747d04a8125082/spectrum/1040g0k031rcsiriq70005pful641hluv8mduf48!nd_dft_wlteh_webp_3', 'tag_list': 'mathplore新加坡数学,数学思维,小学数学,让孩子爱上数学,提升孩子思维能力,逻辑思维,思维训练,孩子爱上学习', 'last_modify_ts': 1773061821366, 'note_url': 'https://www.xiaohongshu.com/explore/6969acd0000000002200a343?xsec_token=AB4sKrBaYdxpsetia4hZYxilGfQ9yqKbYdXQh3KRVxSYI=&xsec_source=pc_search', 'source_keyword': '#小学数学   #小学计算 #数学网课 #陪读经验   #提前学 #数学超前学', 'xsec_token': 'AB4sKrBaYdxpsetia4hZYxilGfQ9yqKbYdXQh3KRVxSYI='}
