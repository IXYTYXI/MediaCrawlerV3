2026-03-09 16:04:38 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '671b5bfd000000002100ba11', 'type': 'video', 'title': '听劝！数学差✅快从新加坡数学入手', 'desc': '曾经以为只要刷足够的题就能学好数学，直到看到娃满张纸的红叉叉，真差点就信了😑\n数学差的根本原因就是缺乏思维和解题方法❗\n总是死记硬背，无脑套公式，不去思考本身的解法🤔\n只有清楚数学的底层逻辑，学会举一反三，孩子才能在数学学习中实现逆袭💪\n---\n今天给大家推荐一款超棒的数学学习神器 ——Spark Math新加坡数学线上直播课！🎉\n🥇课程体系：K2--P6七个阶段\n🥇课程内容：教学采用主流CPA法，以建模为中心，锻炼娃的计算、几何、逻辑多维能力\n🥇班型：中文/英文/双语，4-8人小班直播课\n🥇师资：10-20年深耕教育行业专家\n🥇价格：每节课仅100+，超高性价比放心选择\n-\n现在点击图片下方⬇ 【立即领取】就可以免费试听👏\n⏰ 活动时间：即日起—2025年12月31日\n*课程面向海外人群（18岁以上）\n#新加坡数学[话题]#\xa0\xa0#新加坡数学网课[话题]#\xa0\xa0#新加坡数学补习[话题]#\xa0\xa0#新加坡数学建模[话题]#\xa0\xa0#新加坡数学竞赛[话题]#\xa0\xa0#新加坡数学应用题[话题]#\xa0\xa0#新加坡数学思维[话题]#\xa0\xa0#新加坡数学课程[话题]#\xa0\xa0#新加坡数学老师[话题]#\xa0\xa0#新加坡数学课[话题]#\xa0\xa0#新加坡数学教材[话题]#\xa0\xa0#新加坡数学英文[话题]#\xa0\xa0#新加坡数学cpa[话题]#\xa0\xa0#sparkmath新加坡数学[话题]#\xa0\xa0#小学数学[话题]#\xa0\xa0#小学数学怎么学[话题]#\xa0\xa0#数学思维[话题]#', 'video_url': 'http://sns-video-hw.xhscdn.com/stream/110/259/01e71b5acd74bce10103710392c2e14906_259.mp4', 'time': 1729846269000, 'last_update_time': 1729846270000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '8', 'collected_count': '3', 'comment_count': '2', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603091604/2d2153cc8c707fcd0866422e67900c6a/spectrum/1040g0k0319cd316uls005olhcu8lbcma4ca0488!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学,新加坡数学网课,新加坡数学补习,新加坡数学建模,新加坡数学竞赛,新加坡数学应用题,新加坡数学思维,新加坡数学课程,新加坡数学老师,新加坡数学课,新加坡数学教材,新加坡数学英文,新加坡数学cpa,sparkmath新加坡数学,小学数学,小学数学怎么学,数学思维', 'last_modify_ts': 1773043478494, 'note_url': 'https://www.xiaohongshu.com/explore/671b5bfd000000002100ba11?xsec_token=AB9bcgFPqHkkaHVsP70hzY0qYmRc78V-HN2sGoLRVc3zU=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'AB9bcgFPqHkkaHVsP70hzY0qYmRc78V-HN2sGoLRVc3zU='}
