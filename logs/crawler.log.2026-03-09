2026-03-09 21:09:36 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6878c70f000000001d00f60a', 'type': 'normal', 'title': '小学数学到底要不要超前学习', 'desc': '我想问问大家小学数学超前学习的进度，是家长自己按照课本教还是出去补习的？\n各位大佬如何培养起孩子的自学能力的，也分享一下吧[萌萌哒R]', 'video_url': '', 'time': 1752745743000, 'last_update_time': 1752807486000, 'user_id': '6442645a0000000010027d0b', 'nickname': '涂小姐的内核修炼笔记', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31k0bur34io605p22chd44v8bda0folo', 'liked_count': '108', 'collected_count': '61', 'comment_count': '201', 'share_count': '21', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603092107/7401d139f62fc5a8aabd305977f052cd/1040g00831k1kgr752u305p22chd44v8btvgcu60!nd_dft_wlteh_jpg_3', 'tag_list': '', 'last_modify_ts': 1773061776128, 'note_url': 'https://www.xiaohongshu.com/explore/6878c70f000000001d00f60a?xsec_token=ABtnAVWkEa9dxKUbNOOEFnU_Myj9SkeOzZhJhIgEGbS5Q=&xsec_source=pc_search', 'source_keyword': '#小学数学   #小学计算 #数学网课 #陪读经验   #提前学 #数学超前学', 'xsec_token': 'ABtnAVWkEa9dxKUbNOOEFnU_Myj9SkeOzZhJhIgEGbS5Q='}
