ne': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092100/1e2f55a13c192a879ab420ad40c1e930/1040g2sg31t5m2b8o68dg5q2h8jmngfm5b71r87g!nd_dft_wlteh_webp_3'}], 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092100/8058fe08e5ab6f20605898bf39273439/1040g2sg31t5m2b8o68dg5q2h8jmngfm5b71r87g!nd_prv_wlteh_webp_3', 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092100/1e2f55a13c192a879ab420ad40c1e930/1040g2sg31t5m2b8o68dg5q2h8jmngfm5b71r87g!nd_dft_wlteh_webp_3', 'height': 2400, 'trace_id': '', 'stream': {}, 'live_photo': False, 'file_id': ''}, {'trace_id': '', 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092100/583d181d6d9bc0b48850082802ded152/1040g2sg31t5m2b6v5kdg5q2h8jmngfm5mf0l4uo!nd_prv_wlteh_webp_3', 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092100/eb1383c6ca09eba9b9a360204b933d1f/1040g2sg31t5m2b6v5kdg5q2h8jmngfm5mf0l4uo!nd_dft_wlteh_webp_3', 'live_photo': False, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092100/eb1383c6ca09eba9b9a360204b933d1f/1040g2sg31t5m2b6v5kdg5q2h8jmngfm5mf0l4uo!nd_dft_wlteh_webp_3', 'height': 2400, 'width': 1440, 'info_list': [{'url': 'http://sns-webpic-qc.xhscdn.com/202603092100/583d181d6d9bc0b48850082802ded152/1040g2sg31t5m2b6v5kdg5q2h8jmngfm5mf0l4uo!nd_prv_wlteh_webp_3', 'image_scene': 'WB_PRV'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092100/eb1383c6ca09eba9b9a360204b933d1f/1040g2sg31t5m2b6v5kdg5q2h8jmngfm5mf0l4uo!nd_dft_wlteh_webp_3'}], 'stream': {}, 'file_id': ''}], 'last_update_time': 1772344749000, 'ip_location': '吉林', 'share_info': {'un_share': False}, 'xsec_token': 'AB0ZOKhblYA1P4d_Excrh1EpJkUlFoov4c7qKL8rlvAQk=', 'xsec_source': None}, {'user': {'user_id': '60c0d344000000000100a268', 'nickname': '晨晨妈育儿记', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31lnmh60ql26g5o60qd2098j8ksbi8j0', 'xsec_token': 'AB-wlAOb10777z0hRXrDFHD2CfQsIRoCyCdKsWAbArg-M='}, 'ip_location': '广东', 'share_info': {'un_share': False}, 'type': 'normal', 'desc': '最近火花新数学很火，也确实看到很多博主推荐，我相信很多妈妈和我当初一样，真的很纠结要不要报名。担心它是否真的适合孩子，到底是否和校内同步。我家老二学了半年，现在想给大家分享一下真实感受。\n.\n🔴学习情况：\n我们是四年级上学期开始学的，已经上了半年多，前几天刚续课。\n.\n🔴学习结果：\n孩子自己还挺喜欢，直播、动画结合学习内容，互动性很强，小班更有学习课堂氛围，孩子能跟着老师的节奏。\n.\n🔴其实火花新数学的基因就是小班，确实抓孩子注意力还是有点东西在的，课程内容结合新课标大纲来的，我们是人教版，进度一致。再有就是这个新数学里面会有新加坡数学的内容，数形结合，孩子容易理解。\n.\n🔴火花新数学怎么上？\n8-12人线上小班直播，一周2次，一次50分钟左右\n.\n🔴火花新数学价格怎么样？\n我们是买的半年的，2000多块钱，算下来一节课60多，具体我给忘了。确实相比之前的课程划算很多\n.\n🔴一定要注意的：\n✅课程适合6-12岁孩子上，如果大中小班感觉不合适\n✅选课前一定要试听后再定，不要盲目选择，适合孩子的就是最好的！\n#思维培养[话题]# #思维训练[话题]# #数学思维[话题]#  #火花新数学[话题]# #小学数学[话题]# #数学思维[话题]#', 'interact_info': {'followed': False, 'relation': 'none', 'liked': False, 'liked_count': '167', 'collected': False, 'collected_count': '50', 'comment_count': '24', 'share_count': '1'}, 'image_list': [{'url': 'http://sns-webpic-qc.xhscdn.com/202603092100/39bef79d7b6053b6edfd2ba69e022da9/notes_pre_post/1040g3k831t88jdvb6edg5o60qd2098j8dr1r3f8!nd_dft_wlteh_webp_3', 'trace_id': '', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092100/4fa70129625c321306ad102d49cb7c60/notes_pre_post/1040g3k831t88jdvb6edg5o60qd2098j8dr1r3f8!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092100/39bef79d7b6053b6edfd2ba69e022da9/notes_pre_post/1040g3k831t88jdvb6edg5o60qd2098j8dr1r3f8!nd_dft_wlteh_webp_3'}], 'stream': {}, 'live_photo': False, 'file_id': '', 'height': 1656, 'width': 1242, 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092100/4fa70129625c321306ad102d49cb7c60/notes_pre_post/1040g3k831t88jdvb6edg5o60qd2098j8dr1r3f8!nd_prv_wlteh_webp_3', 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092100/39bef79d7b6053b6edfd2ba69e022da9/notes_pre_post/1040g3k831t88jdvb6edg5o60qd2098j8dr1r3f8!nd_dft_wlteh_webp_3'}, {'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092100/dba501a0d68a4cdaf93689e24527de8f/notes_pre_post/1040g3k831t88jdvb6ed05o60qd2098j856f6e40!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603