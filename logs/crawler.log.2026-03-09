5be306b36c820600012c53d7', 'name': '小学生', 'type': 'topic'}, {'id': '619ad1cc0000000001001b51', 'name': '生活中数学', 'type': 'topic'}], 'time': 1767617852000, 'title': '一年级计算竞赛一等奖，我们这样玩转数学‼️', 'user': {'nickname': 'yeye妈咪', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/609c0ee85d56ee5a7a8f9787.jpg', 'xsec_token': 'ABmWlvRyM6ByMAcSvQXO-6NuobcQ08VkU4Y1eWAlUkpxk=', 'user_id': '55a51f9741a2b3463c792273'}, 'at_user_list': [], 'last_update_time': 1769174091000, 'share_info': {'un_share': False}, 'xsec_token': 'ABFj0qTnKmIKbATZxAApaTzeaIYqX9LozdiuYwPC0rBBk=', 'xsec_source': None}, {'share_info': {'un_share': False}, 'note_id': '68527ea4000000000b02e3b3', 'type': 'video', 'desc': '闺女二年级，数学成绩一直名列前茅，主要是在于培养数学思维，以及解题的思路和表述能力，日常可以这样\n✅计算基础打好\n小学阶段坚持每日练习，计算能力强能缩短每道题目完成时间\n✅不要盲目刷题\n一套每课练+-套单元练足够，刷卷子当然能提高成绩，换来的是孩子对学习的兴趣缺失和亲子关系的恶化，从长远来看，得不偿失\n✅重视数学思维\n比起背套路，小学阶段建立起逻辑思维和数学思维的孩子才能学的更轻松\n\t\n像我家孩子就一直在上希望学的数学课程，孩子一直很喜欢上，老师讲课方式简单易懂，一起来跟着校长妈妈看看吧！\n#希望学[话题]# #孩子喜欢希望学[话题]# #希望学网校[话题]# #网课[话题]# #学习APP推荐[话题]# #补课[话题]# #希望学小学[话题]# #日常学习[话题]##小学生的日常[话题]#', 'user': {'user_id': '6285ca31000000002102b24b', 'nickname': '校长妈妈是超人', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31bsj9l8p085g5ok5p8oodcibhk2fegg', 'xsec_token': 'AB4e1Ren8zUwEc_mpJwucA1EhDMRgM4kkz9bg9HEfKWeE='}, 'video': {'media': {'video_id': 137450492271148614, 'video': {'biz_id': '281565680584549299', 'duration': 165, 'md5': '4db0f3072954c566506879f9499b1dce', 'hdr_type': 0, 'drm_type': 0, 'stream_types': [259, 114, 130, 108], 'biz_name': 110}, 'stream': {'h265': [{'master_url': 'http://sns-video-al.xhscdn.com/stream/1/110/114/01e8527e96063e4601037001978242166c_114.mp4', 'quality_type': 'HD', 'avg_bitrate': 840704, 'video_codec': 'hevc', 'audio_channels': 2, 'rotate': 0, 'hdr_type': 0, 'stream_type': 114, 'fps': 30, 'audio_bitrate': 128091, 'audio_codec': 'aac', 'video_duration': 164633, 'format': 'mp4', 'volume': 0, 'ssim': 0, 'vmaf': -1, 'psnr': 40.66699981689453, 'stream_desc': 'X265_MP4_WEB_114', 'height': 1280, 'siz