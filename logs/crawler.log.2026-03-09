2026-03-09 16:01:34 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6733001d000000001b0290af', 'type': 'normal', 'title': '沉浸式在家学数学，逆袭成思维学霸！', 'desc': '谁懂❗❗这个数学小班课的沉浸感也太强了吧❗❗❗\n想被外界干扰都难，因为动画教学引入，激发兴趣的同时，老师全程跟娃互动😃\n参与度高，还能及时发现问题，学习效率真的太高了✅\n·\n🌟而且对于小学阶段的娃来说，4-8人小班课的优势很明显\n👩💻因为老师会将更多的注意力放在你身上，及时跟踪吸收效果，不懂的地方立马重新讲解🕐\n遇到难题，老师马上就能给出清晰的思路和准确的解答，节省了苦思冥想的理解时间🤯。\n-\n为什么选择Spark Math线上直播课！🎉\n👨\u200d🏫课程体系：K2--P6七个阶段\n👨\u200d🏫课程内容：教学采用主流CPA法，以建模为中心，锻炼娃的计算、几何、逻辑多维能力\n👨\u200d🏫班型：中文/英文/双语，4-8人小班直播课\n👨\u200d🏫师资：10-20年深耕教育行业专家\n👨\u200d🏫价格：每节课仅100+，超高性价比放心选择\n-\n现在点击图片下方⬇ 【立即领取】就可以免费试听👏\n⏰ 活动时间：即日起—2025年12月31日\n*课程面向海外人群（18岁以上）\n#新加坡数学[话题]#\xa0\xa0#新加坡数学网课[话题]#\xa0\xa0#新加坡数学建模[话题]#\xa0\xa0#新加坡数学补习[话题]#\xa0\xa0#新加坡数学竞赛[话题]#\xa0\xa0#新加坡数学应用题[话题]#\xa0\xa0#新加坡数学思维[话题]#\xa0\xa0#新加坡数学课[话题]#\xa0\xa0#新加坡数学课程[话题]#\xa0\xa0#新加坡数学老师[话题]#\xa0\xa0#新加坡数学教材[话题]#\xa0\xa0#新加坡数学cpa[话题]#\xa0\xa0#新加坡数学英文[话题]#\xa0\xa0#sparkmath新加坡数学[话题]#\xa0\xa0#小学数学[话题]#\xa0\xa0#小学数学怎么学[话题]#', 'video_url': '', 'time': 1731402782000, 'last_update_time': 1731395613000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '2', 'collected_count': '', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603091601/00c10220f958f8d45e0d4302d7f0bad2/spectrum/1040g0k031a3ftemc6u705olhcu8lbcma67jdsbo!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603091601/eae3f782dce215be6a408a392b62f1d0/spectrum/1040g0k031a3ftiibmm005olhcu8lbcmav1vuo78!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603091601/18133b4acaaf3aa71839cd8b912db493/spectrum/1040g34o31a3ftkcvmq005olhcu8lbcmat2mh94g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603091601/724c1500928346f7abe87f54a44dd1f3/spectrum/1040g0k031a3ftmei6u005olhcu8lbcma4macr0o!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学,新加坡数学网课,新加坡数学建模,新加坡数学补习,新加坡数学竞赛,新加坡数学应用题