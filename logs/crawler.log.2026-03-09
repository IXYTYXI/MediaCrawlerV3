2026-03-09 18:24:45 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '64619ab30000000013032372', 'type': 'normal', 'title': '数学不开窍的孩子❗️请带孩子看这4部纪录片', 'desc': '[皱眉R][皱眉R]数学是很多孩子惧怕的科目，从四年级开始，数学就会开始成为名副其实的拉分王，初高中更是成为拖后腿的科目。这类孩子，多半是对数学不感兴趣，没有体会到数学的乐趣。\n\t\n-\n[拔草R][拔草R].建议家长让孩子多看这几部纪录片，有趣又涨见识，会让孩子看到一个全新的数学世界，让孩子爱上数学。\n\t\n##小学数学[话题]# #数学思维[话题]# #数学启蒙[话题]# #纪录片[话题]# #小学数学怎么学[话题]# #纪录片推荐[话题]# #纪录片分享[话题]# #值得一看的纪录片[话题]#', 'video_url': '', 'time': 1684118195000, 'last_update_time': 1684139959000, 'user_id': '6221b8fa0000000021021f86', 'nickname': '彭老师数学思维分享', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31r5kuccvno005oh1n3t8c7s6i1061eo', 'liked_count': '1.4万', 'collected_count': '3.1万', 'comment_count': '2789', 'share_count': '7096', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603091823/9cd3642dbc75d1c43a39b94ef3cf6b46/1000g0082gc1gdqqi20005oh1n3t8c7s63oaguo8!nd_dft_wlteh_jpg_3,http://sns-webpic-qc.xhscdn.com/202603091823/7081ae3fb6fdb3840d249918227fcddd/1000g0082gc1gdqqi200g5oh1n3t8c7s6s8pmndg!nd_dft_wlteh_jpg_3,http://sns-webpic-qc.xhscdn.com/202603091823/cdff334a3682a3b48c0a78cd3f1d7f64/1000g0082gc1gdqqi20105oh1n3t8c7s6ac9fe08!nd_dft_wlteh_jpg_3,http://sns-webpic-qc.xhscdn.com/202603091823/add4056bd68a23bd8325d772da8ad2ef/1000g0082gc1gdqqi201g5oh1n3t8c7s6910p4r8!nd_dft_wlteh_jpg_3,http://sns-webpic-qc.xhscdn.com/202603091823/18ec14184390efa605a545e840fece4e/1000g0082gc1gdqqi20205oh1n3t8c7s673nft08!nd_dft_wlteh_jpg_3', 'tag_list': '小学数学,数学思维,数学启蒙,纪录片,小学数学怎么学,纪录片推荐,纪录片分享,值得一看的纪录片', 'last_modify_ts': 1773051885881, 'note_url': 'https://www.xiaohongshu.com/explore/64619ab30000000013032372?xsec_token=ABJeiF1Mc5Rx_0IzscHsPiJWZPyYw-6M62Dtlh9sHFr6s=&xsec_source=pc_search', 'source_keyword': '#小学数学', 'xsec_token': 'ABJeiF1Mc5Rx_0IzscHsPiJWZPyYw-6M62Dtlh9sHFr6s='}
