p://sns-bak-v1.xhscdn.com/stream/79/110/258/01e8fe2c182aace64f0370019a20ed9c8f_258.mp4', 'http://sns-bak-v6.xhscdn.com/stream/79/110/258/01e8fe2c182aace64f0370019a20ed9c8f_258.mp4'], 'hdr_type': 0, 'stream_type': 258, 'audio_bitrate': 56311, 'quality_type': 'HD', 'format': 'mp4', 'video_duration': 33866, 'avg_bitrate': 192861, 'weight': 59, 'video_codec': 'h264', 'audio_codec': 'aac', 'height': 960, 'volume': 0, 'duration': 33878, 'vmaf': -1, 'psnr': 0, 'ssim': 0, 'default_stream': 0, 'audio_channels': 2, 'width': 720, 'video_bitrate': 129541}], 'h265': [], 'h266': [], 'av1': []}, 'video_id': 137639253972266200}, 'image': {'first_frame_fileid': '110/0/01e8fe2c182aace60010000000019a20ed837e_0.jpg', 'thumbnail_fileid': 'frame/110/0/01e8fe2c182aace60010000000019a20ed9c51_0.webp'}, 'capa': {'duration': 33}}, 'last_update_time': 1761489026000, 'title': '谁现在还不会这么简单的找规律', 'user': {'nickname': '数学之美', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31nhntjbc6g605q7bh3bto6856addrio', 'xsec_token': 'ABCS5rzHmZVTklqFop7mLJjL3JVs0tDP3nsl9mOMLew6s=', 'user_id': '68eb88d70000000037001905'}, 'xsec_source': None}, {'xsec_token': 'ABffDE8D_JgGIHJWDQutnusCQJs39Xq_h7JtBtNgbK5ZA=', 'desc': '孩子在上小学的家长们！听我一句劝！想要学好学好小学数学！一定要试试新加坡数学CPA画图建模法！\n我怕他学完直接把小学 「八大数学思维能力」全吃透！到时候数学秒开窍，\n在班里疯狂抢C位！这谁顶得住啊！🤯\n\t\n🔥 说的就是这套海淀家长圈 「偷偷传阅」 的 Mathplore新加坡数学！\n我冒着被「卷王家长」拉黑的风险，必须曝光它！\n\t\n为啥这么「可怕」？\n👉 独家CPA教学法，专治“不开窍”：\n1️⃣ 实物轰炸（C）：用一堆生活实物图，让娃秒懂数学是啥！\n2️⃣ 画图破局（P）：图形代替数字，关系理得门儿清，思路瞬间通透！\n3️⃣ 抽象秒杀（A）：最后才上公式！数理思维刻进DNA，做题直接降维打击！💥\n\t\n效果有多「吓人」？\n✨ 每周只跟2节直播课！ 一二年级娃做题像开了挂！\n→ 别人吭哧吭哧 掰手指、列竖式...\n→ 你家娃 唰唰写完+检查3遍！还能托腮发呆等收卷！😎\n这哪是做题？这是考场表演秀啊！\nMathplore新加坡数学小班直播课，致力于提升小学数学思维：\n✅课程分为：G0—G6，7 个阶段，涵盖校内数学重难点巩固+课外拓展竞赛培优，对标国际数学竞赛AMC8和袋鼠数学体系！\n✅教学方法：CPA 教学法，从具象化到形象化再到抽象化，一步步引导孩子构建数学思维模型\n✅优质师资：国内外名校毕业师资，80%+为理工科或教育类硕士及以上学历，平均5年+数学教学经验\n✅上课时长：一周2节，40-50分钟/节\n✅上课形式：在线直播课，2-6人精品小班\n\t\n不管是给孩子数学思维提升，还是助力提升数学成绩，都超合适！\n🔥快快点击头像进入直播间，领取试听名额～\n课程领取活动时间：即日起至2026年12月31日\n*课程面向海外18+人群\n\ufeff#我在小红书上课[话题]#\ufeff \ufeff#数学开窍[话题]#\ufeff \ufeff#mathplore新加坡数学[话题]#\ufeff \ufeff#数学思维[话题]#\ufeff \ufeff#小学数学[话题]#\ufeff \ufeff#小学数学怎么学[话题]#\ufeff \ufeff\ufeff#小学数学思维训练方法[话题]#\ufeff', 'interact_info': {'followed': False, 'relation': 'none', 'liked': False, 'liked_count': '1.5万', 'collected': False, 'collected_count': '1.4万', 'comment_count': '40', 'share_count': '1320'}, 'image_list': [{'url_default': 'http://sns-webpic-qc.xhscdn.com/202603091822/a274a44e9ccb83b103d5fbf6b0d5f152/spectrum/1040g0k031lbnitqll0005pful641hluvrl6mcgo!nd_dft_wlteh_jpg_3', 'height': 1348, 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603091822/fec418bf9188d80a108292b25f0a36fe/spectrum/1040g0k031lbnitqll0005pful641hluvrl6mcgo!nd_prv_wlteh_jpg_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603091822/a274a44e9ccb83b103d5fbf6b0d5f152/spectrum/1040g0k031lbnitqll0005pful641hluvrl6mcgo!nd_dft_wlteh_jpg_3'}], 'url': 'http://sns-webpic-qc.xhscdn.com/202603091822/a274a44e9ccb83b103d5fbf6b0d5f152/spectrum/1040g0k031lbnitqll0005pful641hluvrl6mcgo!nd_dft_wlteh_jpg_3', 'trace_id': '', 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603091822/fec418bf9188d80a108292b25f0a36fe/spectrum/1040g0k031lbnitqll0005pful641hluvrl6mcgo!nd_prv_wlteh_jpg_3', 'stream': {}, 'live_photo': False, 'file_id': '', 'width': 1011}], 'video': {'media': {'video_id': 137536065412549950, 'video': {'duration': 54, 'md5': 'a7951b1d5091b428278746b8b8183ef2', 'hdr_type': 0, 'drm_type': 0, 'stream_types': [258], 'biz_name': 110, 'biz_id': '281651254390000885'}, 'stream': {'h264': [{'height': 1280, 'stream_type': 258, 'stream_desc': 'X264_MP4', 'duration': 53500, 'audio_codec': 'aac', 'default_stream': 0, 'format': 'mp4', 'psnr': 0, 'quality_type': 'HD', 'avg_bitrate': 781526, 'backup_urls': ['http://sns-bak-v1.xhscdn.com/stream/1/110/258/01e8a052a2b84d400103700198b243ded0_258.mp4', 'http://sns-bak-v6.xhscdn.com/stream/1/110/258/01e8a052a2b84d400103700198b243ded0_258.mp4'], 'audio_bitrate': 56213, 'audio_durati