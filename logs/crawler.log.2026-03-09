099089299, 'video': {'biz_name': 110, 'biz_id': '281891972940531036', 'duration': 118, 'md5': '6d1038cc5482d8a2fdb45b94ffe35f37', 'hdr_type': 0, 'drm_type': 0, 'stream_types': [259, 114, 115]}, 'stream': {'h265': [{'fps': 37, 'video_bitrate': 203265, 'master_url': 'http://sns-video-hs.xhscdn.com/stream/1/110/114/01e97b40641a7393010370019c097a32c9_114.mp4', 'backup_urls': ['http://sns-bak-v1.xhscdn.com/stream/1/110/114/01e97b40641a7393010370019c097a32c9_114.mp4'], 'quality_type': 'HD', 'stream_desc': 'X265_MP4_WEB_114', 'size': 5001649, 'audio_channels': 2, 'vmaf': -1, 'width': 720, 'rotate': 0, 'format': 'mp4', 'video_duration': 117567, 'ssim': 0, 'volume': 0, 'audio_codec': 'aac', 'avg_bitrate': 340340, 'audio_duration': 117562, 'weight': 62, 'height': 960, 'hdr_type': 0, 'psnr': 43.0359992980957, 'stream_type': 114, 'default_stream': 0, 'video_codec': 'hevc', 'audio_bitrate': 128126, 'duration': 117568}, {'backup_urls': ['http://sns-bak-v1.xhscdn.com/stream/1/110/115/01e97b40641a7393010370019c0979c94c_115.mp4'], 'format': 'mp4', 'volume': 0, 'avg_bitrate': 489343, 'audio_channels': 2, 'ssim': 0, 'weight': 70, 'psnr': 44.534000396728516, 'audio_duration': 117562, 'master_url': 'http://sns-video-hs.xhscdn.com/stream/1/110/115/01e97b40641a7393010370019c0979c94c_115.mp4', 'hdr_type': 0, 'rotate': 0, 'vmaf': -1, 'default_stream': 0, 'video_codec': 'hevc', 'video_duration': 117567, 'audio_bitrate': 128126, 'quality_type': 'HD', 'width': 1080, 'height': 1440, 'duration': 117568, 'size': 7191392, 'audio_codec': 'aac', 'stream_type': 115, 'stream_desc': 'X265_MP4_WEB_115', 'fps': 37, 'video_bitrate': 352268}], 'h266': [], 'av1': [], 'h264': [{'video_bitrate': 223836, 'quality_type': 'HD', 'volume': 0, 'fps': 37, 'video_codec': 'h264', 'audio_codec': 'aac', 'hdr_type': 0, 'default_stream': 0, 'size': 4362275, 'audio_bitrate': 64063, 'backup_urls': ['http://sns-bak-v1.xhscdn.com/stream/1/110/259/01e97b40641a7393010370039c097835a3_259.mp4'], 'weight': 62, 'format': 'mp4', 'width': 720, 'audio_channels': 2, 'vmaf': -1, 'stream_type': 259, 'duration': 117568, 'avg_bitrate': 296834, 'video_duration': 117567, 'audio_duration': 117562, 'rotate': 0, 'psnr': 0, 'stream_desc': 'WM_X264_MP4_web', 'height': 960, 'master_url': 'http://sns-video-hs.xhscdn.com/stream/1/110/259/01e97b40641a7393010370039c097835a3_259.mp4', 'ssim': 0}]}}, 'image': {'first_frame_fileid': '110/0/01e97b40641a73930010000000019c0977e36a_0.jpg', 'thumbnail_fileid': 'frame/110/0/01e97b40641a73930010000000019c097809fa_0.webp'}, 'capa': {'duration': 117}}, 'at_user_list': [], 'title': '一年级下册数学《百数表》🔥🔥', 'desc': '#浪漫生活的记录者[话题]# 百数表是一年级下学期的重点难点，自己教一点头绪都没有，让孩子跟动画学，瞬间孩子就理解了，太省妈了#一年级[话题]# #数学思维[话题]# #趣味数学[话题]# #小学数学思维训练[话题]# #一年级下册数学[话题]# #小学数学[话题]# #小学奥数[话题]# #小学数学奥数[话题]# #百数表[话题]#', 'user': {'user_id': '6895f1ff000000002802b0bc', 'nickname': '乐乐d68', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31m35da544s5g5q4lu7vq5c5smghqbq8', 'xsec_token': 'AB3eN0_l99aKAkx-T_T7-HI6wddFvxFUXPtTI_klbQlW4='}, 'tag_list': [{'id': '6374a654000000000100394b', 'name': '浪漫生活的记录者', 'type': 'topic'}, {'id': '5452565ad6e4a90c5e30f617', 'name': '一年级', 'type': 'topic'}, {'id': '5c7a5ce6000000000f016c8e', 'name': '数学思维', 'type': 'topic'}, {'id': '5d74ad82000000000103d085', 'name': '趣味数学', 'type': 'topic'}, {'id': '5c38ac5a000000000d0178b9', 'name': '小学数学思维训练', 'type': 'topic'}, {'id': '5e19415900000000010010e7', 'name': '一年级下册数学', 'type': 'topic'}, {'id': '610160dd000000000100b9d9', 'name': '小学数学', 'type': 'topic'}, {'id': '5c087775fdeaef0001938997', 'name': '小学奥数', 'type': 'topic'}, {'id': '5da876c20000000001038acc', 'name': '小学数学奥数', 'type': 'topic'}, {'name': '百数表', 'type': 'topic', 'id': '5ff255d000000000010053dc'}], 'last_update_time': 1769685376000, 'share_info': {'un_share': False}, 'xsec_token': 'ABD8j87sWlO3CJ6EcBm5oKbEVif620SXLME0-aHuHXeNc=', 'xsec_source': None}, {'desc': '小学时，我们数学基本是提前一学期最多一学年的预习量，3年级前每天保持计算练习，到了4-5年级计算练习就坚持得不太好了。不过，计算的练习在小学阶段确实非常重要，用老师的话来说，计算占据了小学数学的半壁江山。对于记忆力好的孩子，在幼儿园阶段最好多让孩子先建立数感再练计算题，不用太早开始，别人的进度不是普适的，要根据自己孩子调整。比如幼儿园阶段有的孩子等量代换可能学不明白，到了一年级不用教也能懂。多和孩子对照实物去数数，多玩游戏，建立数字和实物数量的联系，网上有很多不错的方法可以借鉴。奥数学习同理。否则孩子很可能只是背下了几加几等于几，后续不利于数学学习。兴趣和理解底层逻辑是第一位。\n\t\n教辅只用一课一练增强版，小低年级时间充裕可以完成大部分（我们的经历是好像不做也没影响），到了高年级，只挑一部分难题做。小低年级时，难题很多独立做不出，到了五年级，意外地发现，很多难题不仅可以独立做出，讲解的思路也十分清晰。我们属于小月龄孩子，不得不说，在五年级之前，和大月龄的孩子思维能力是存在差距的，基本就是晚一年。但随着孩子大脑的发育，这个差距正在缩小。所以，我们的经历是不用焦虑，适时投喂，静待花开。有兴趣，认知和能力到了，就更进一步，兴趣和信心第一位。（这个规律也因人而异，有些孩子的思维确实发育超前，且对数学有兴趣，这种孩子适合超前学）\n\t\n小升初阶段，孩子班级里几个成绩不错的都择校了，我当时觉得对口还不错，就没动这个心思。孩子自主时间比较充裕，校内也轻松，就开始自学预初数学。最好的方法其实是看书自学，我们配合的是教材全解，不懂的部分可以参考空中课堂或者其他视频课，学完以后配合练习册自查。这是效率最高且帮助孩子形成自学能力的有效方法。但孩子自学了一部分，就不大有兴趣了。后来接触到洋葱数学，很起劲，效果有待观察，我们家有一个问题，不喜欢题海战术，最多是自己学得不扎实的部分，会让我帮她找点题进行有针对性的练习。小学数学内容少，校内练习册过一遍知识点已经足够，影响不大，到了初中再看。但遇到难题不怕且会想办法搞懂为止，会了就是会了，正确率高。网上很多数学牛娃已经自学了整个初中的数学，这个进度，如果是孩子真心喜欢且愿意学，并且可以学明白，那真是老天爷赏饭吃。我们的认知和思维还没到那个阶段，就一步一个脚印，学有余力就学，校内有问题就停下来，吃透再说。', 'user': {'nickname': '春晖', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1000g2jo2psaraicjm00040ubp2filql6ejjub4g', 'xsec_token': 'ABOE7nyxmGEFV6sVc9fsPt9td3fjTaZiEJeQQOqSimAw0=', 'user_id': '559ddf2a3397db12ca1aeaa6'}, 'interact_info': {'collected': False, 'collected_count': '98', 'comment_count': '16', 'share_count': '6', 'followed': False, 'relation': 'none', 'liked': False, 'liked_count': '83'}, 'time': 1748231540000, 'last_update_time': 1748231540000, 'share_info': {'un_share': False}, 'note_id': '6833e57400000000210002d2', 'type': 'normal', 'tag_list': [], 'at_user_list': [], 'title': '关于数学提前学', 'image_list': [{'trace_id': '', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092108/d92d6e0f4bca8d039c54391f726e1ed0/1040g2sg31hubu3onjo7040ubp2filql64e7s94g!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092108/da5edff97a7518c9b803465758f50c31/1040g2sg31hubu3onjo7040ubp2filql64e7s94g!nd_dft_wlteh_webp_3'}], 'live_photo': False, 'file_id': '', 'height': 1600, 'width': 1200, 'url': 'http://sns-webpic-qc.xhscdn.com/2026030