4bnqoco0p308hh73ni8!nd_dft_wlteh_webp_3', 'file_id': '', 'height': 2560, 'live_photo': False}, {'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/7a20548351b9d9b78c5404785d3371bb/1040g008312tb0nbs5c404bnqoco0p308qf11dg0!nd_dft_wlteh_webp_3', 'trace_id': '', 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092012/202aa00fc7a10aefd592a4847dd42d49/1040g008312tb0nbs5c404bnqoco0p308qf11dg0!nd_prv_wlteh_webp_3', 'stream': {}, 'live_photo': False, 'file_id': '', 'height': 2560, 'width': 1920, 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/202aa00fc7a10aefd592a4847dd42d49/1040g008312tb0nbs5c404bnqoco0p308qf11dg0!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/7a20548351b9d9b78c5404785d3371bb/1040g008312tb0nbs5c404bnqoco0p308qf11dg0!nd_dft_wlteh_webp_3'}], 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092012/7a20548351b9d9b78c5404785d3371bb/1040g008312tb0nbs5c404bnqoco0p308qf11dg0!nd_dft_wlteh_webp_3'}, {'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092012/becb502331bf6226cc3f18acbdd5ed51/1040g008312tb0nbs5c204bnqoco0p30822q6p6g!nd_dft_wlteh_webp_3', 'live_photo': False, 'file_id': '', 'width': 1920, 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/bc7ee2b75b78ae652c24fe917e7823f5/1040g008312tb0nbs5c204bnqoco0p30822q6p6g!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/becb502331bf6226cc3f18acbdd5ed51/1040g008312tb0nbs5c204bnqoco0p30822q6p6g!nd_dft_wlteh_webp_3'}], 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092012/bc7ee2b75b78ae652c24fe917e7823f5/1040g008312tb0nbs5c204bnqoco0p30822q6p6g!nd_prv_wlteh_webp_3', 'height': 2560, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/becb502331bf6226cc3f18acbdd5ed51/1040g008312tb0nbs5c204bnqoco0p30822q6p6g!nd_dft_wlteh_webp_3', 'trace_id': '', 'stream': {}}, {'height': 2560, 'trace_id': '', 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092012/d3b44bbe01dc4f2ace66601513ed8ebe/1040g008312tb0nbs5c104bnqoco0p3089nu4gmo!nd_prv_wlteh_webp_3', 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092012/dfc28da48472cbff6f85091304245065/1040g008312tb0nbs5c104bnqoco0p3089nu4gmo!nd_dft_wlteh_webp_3', 'live_photo': False, 'file_id': '', 'width': 1920, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/dfc28da48472cbff6f85091304245065/1040g008312tb0nbs5c104bnqoco0p3089nu4gmo!nd_dft_wlteh_webp_3', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/d3b44bbe01dc4f2ace66601513ed8ebe/1040g008312tb0nbs5c104bnqoco0p3089nu4gmo!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/dfc28da48472cbff6f85091304245065/1040g008312tb0nbs5c104bnqoco0p3089nu4gmo!nd_dft_wlteh_webp_3'}], 'stream': {}}], 'at_user_list': [], 'time': 1716117398000, 'last_update_time': 1715950121000, 'title': '数学提前学之计算哪个年级都不能停', 'desc': '之前给大家分享过我们家三年级提前学完小学数学的经验，引起了很大关注。很多粉丝问我三年级之后，是不是就不用再搞计算了，只关注难度了？\n实话说，AS确实是我们现阶段的重点，在海淀混XSC还是要有点硬通货。但是，小学阶段的数学，计算才是一切的核心，简单点说，建议小学阶段一直到五六年级都要保持每天的计算练习。\n我家娃目前是四年级，每天用小猿学练机自己做100道计算题，大概花10多分钟。经过这三四年每天的计算训练，孩子的计算一直准确度和速度都不错，前一段学校的计算比赛还拿到了全能王。[气球R][气球R]今天和大家分享一下小学阶段数学每个年级的重点，可以收藏。\n[一R]五六年级主要需要解决的是分数运算。\n分数的加减、乘除，还有巧算，在此基础上会衔接初中的方程计算。分数的运算也是整个小学计算的难点，建议提前到三四年级学完后，后面继续进行训练，每天建议花10-15分钟，完成大约100道的计算。\n推荐不会找题和没时间给孩子检查的家长，试试小猿学练机，它除了可以进行计算的专项练习，还有教材同步练习、阶段测评、教辅专区等多个功能。我主要是看重了它AI精准练习的技术，可以针对孩子的学情和进度，AI智能分析后推到专属你们家孩子的题目。让孩子练习需要的、适合的，不是盲目地只求量，而是高效地练习。错题还有细致的视频讲解。既能帮助孩子练五三、实验班等主流教辅书，又能针对性地出题和练错题等，很适合孩子自己在家搞定计算和练题。\n[二R]三四年级主要解决多位数的运算以及小数的加减乘除。\n多位数计算其实不难，考察的是孩子对算理的掌握，还有细心程度，很多孩子明明竖式列的是对的，最后结果还是错。小数的运算相对难一点，也是易错点。三四年级的计算不难，核心是熟练度和准确率，建议大家追一下正确率。\n[三R]一二年级主要解决数的认知和乘法运算，从数数到位值、进制的理解。\n一年级主要解决数的分合和百以内加减计算，二年级主要涉及乘法，乘法口诀没问题的话，再去解决两位数的乘除法。入手小猿学练机后，我们就是假期出去玩也会抽10分钟搞一下计算，它轻薄便携，很适合利用碎片时间。而且语数英都可以用它专项提升，语文有字词听写、看拼音写字、阅读理解，英语有单词听写、听力闯关、口语练习、背单词等等。\n对了，小猿学练机用的是墨水屏，长时间用它看书也很舒服，有了他家里的IReader基本闲置了。\n#小猿学练机[话题]# #学习机[话题]# #学而思学习机[话题]# #科大讯飞学习机[话题]# #宝贝的学习搭子[话题]#', 'user': {'user_id': '5bdeb00cf7e8b96adc768c08', 'nickname': '球妈乐心', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/62f6f4049055556fdf82ed73.jpg', 'xsec_token': 'ABMU2js57U8G8EWODThPTfFM_GOTOgeXKO9ybXNSUxD-0='}, 'xsec_token': 'ABIgtzUNS6Eh0X2zzNTVmaW531bWUG0S6q_Jp2L0Mrz0U=', 'xsec_source': None}, {'user': {'user_id': '5cf2b2cd0000000005015a25', 'nickname': '芒果豆', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo3166ldg02hc5g5n7imb6hamh5oooagbo', 'xsec_token': 'ABzotp-2aaa2XaavUUxJC2EutlViN7SChzovCcYs4DyaE='}, 'tag_list': [{'id': '6551916c000000000b031850', 'name': '数学超前学', 'type': 'topic'}, {'type': 'topic', 'id': '610160dd000000000100b9d9', 'name': '小学数学'}, {'id': '5d4ff0a600000000170248bf', 'name': '作业帮', 'type': 'topic'}, {'id': '5f4c9b2f000000000100496a', 'name': 'AI学习', 'type': 'topic'}, {'name': 'AI学习神器', 'type': 'topic', 'id': '650dea39000000000d007245'}, {'id': '646213be00000000280196e3', 'name': 'AI学习工具', 'type': 'topic'}, {'id': '6836b1460000000012019998', 'name': 'AI学习用作业帮', 'type': 'topic'}], 'time': 1752739745000, 'last_update_time': 1752652545000, 'type': 'normal', 'title': '小学数学超前学！普娃逆袭！四年级学完初二', 'desc': '女儿从数学垫底到四年级学完初二，我只做对了一件事！\n写下这个标题时，我的心情很复杂。😭 两年前，我还是那个为女儿数学成绩发愁，在家长群里默默“潜水”的焦虑父亲。一年后，看着四年级的女儿开心地和我讨论初二的数学题，从曾经的班级垫底到如今稳居头部，我才敢确信——我们走对了路。✨\n\t\n第一步：战略调整 — 我们为什么首先“扔掉”了教材？🤔\n在分享具体做法前，我想先聊聊我们踩过的最大的坑：啃教材。\n我曾理所当然地认为，学习就该从教材开始。但实践告诉我，这是一个巨大的误区。❌ 小学的数学教材是为课堂教学设计的“教案”，充满了需要老师引导的“留白”，根本不是适合自学的读物。\n让孩子啃这样一本“反自学”的书，只会快速扼杀他的学习兴趣。\n想通这一点后，我做的第一件事就是收起教材，彻底改变作战策略。\n第二步：「看」进去 👀，代替「啃」进去 📚\n具体做法：找知识点做成动画短视频的线上资源。一节课10-15分钟，孩子能坐住，没压力。\n心法：用高效方式“炖烂”硬骨头，让孩子觉得“不难”。非重点章节直接跳过，把力气花在关键处，兴趣才是第一生产力。\n「巧」练习 ✍，代替「傻」刷题 😵\n具体做法：看完视频立刻做几道配套题“练手”。遇难题时，用学习软件（比如女儿习惯用作业帮拍照解题），再跟AI像聊天一样理顺思路。\n心法：核心是培养自主解决问题的能力。好的工具不会直接给答案，而是像教练一样引导孩子找到突破口。靠自己攻克难题的成就感，远胜过家长讲一百遍题。\n「精」复盘 🎯，代替「懒」重复 🥱\n具体做法：利用工具自动归纳错题的功能形成“错题本”。我们用作业帮的错题本复盘，很方便。\n心法：让孩子成为自己错误的主人。复盘能让他清楚跌倒的地方和站起来的方法，效果远胜盲目做新题。\n第三步：心态建设 — 我们到底在追求什么？❤\n这条路能坚持下来，关键是父女俩达成共识：超前学不是为了分数，而是“锻炼思维的肌肉”。\n我告诉女儿，学新知识就像游戏里完成挑战，“大脑”会变得更强。现在她常说：“爸爸，我感觉今天我的脑子又升级了！”\n当学习不是为了应付考试，而是为了内在成长和乐趣，孩子会爆发出惊人能量。她不再怕难题，甚至享受挑战，成绩提升只是自然的副产品。\n希望我们的经验，能帮到你们。\n\t\n#数学超前学[话题]# #小学数学[话题]# #作业帮[话题]# #AI学习[话题]# #AI学习神器[话题]#  #AI学习工具[话题]# #AI学习用作业帮[话题]#', 'interact_info': {'collected': False, 'collected_count': '141', 'comment_count': '18', 'share_count': '12', 'followed': False, 'relation': 'none', 'liked': False, 'liked_count': '106'}, 'image_list': [{'stream': {}, 'live_photo': False, 'width': 1920, 'trace_id': '', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/5c8d82e7ef85a3a98d07d2a335171c06/notes_pre_post/1040g3k031k07s9cuj4j05n7imb6hamh57aj0ck0!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/e72175974dcd8877cefacf86a908cdf9/notes_pre_post/1040g3k031k07s9cuj4j05n7imb6hamh57aj0ck0!nd_dft_wlteh_webp_3'}], 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092012/5c8d82e7ef85a3a98d07d2a335171c06/notes_pre_post/1040g3k031k07s9cuj4j05n7imb6hamh57aj0ck0!nd_prv_wlteh_webp_3', 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092012/e72175974dcd8877cefacf86a908cdf9/notes_pre_post/1040g3k031k07s9cuj4j05n7imb6hamh57aj0ck0!nd_dft_wlteh_webp_3', 'file_id': '', 'height': 2560, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/e72175974dcd8877cefacf86a908cdf9/notes_pre_post/1040g3k031k07s9cuj4j05n7imb6hamh57aj0ck0!nd_dft_wlteh_webp_3'}, {'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/a7b9f88dcd2ae47ccba9cb14c2106b37/notes_pre_post/1040g3k031k07s9cuj4kg5n7imb6hamh5knnvl4g!nd_dft_wlteh_webp_3', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/c247b27af25fd90ef67c23616a012513/notes_pre_post/1040g3k031k07s9cuj4kg5n7imb6hamh5knnvl4g!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/a7b9f88dcd2ae47ccba9cb14c2106b37/notes_pre_post/1040g3k031k07s9cuj4kg5n7imb6hamh5knnvl4g!nd_dft_wlteh_webp_3'}], 