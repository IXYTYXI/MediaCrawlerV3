2026-03-09 23:11:09 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69ad6aca000000001a028f93', 'type': 'normal', 'title': '幼小衔接数学计算/口算练习题/可打印', 'desc': '🔥幼小衔接数学通关！10以内加减法口算表太香了～\n家有准小学生的宝妈集合！\n📚 幼小衔接最关键的就是数学计算，而10以内加减法更是基础中的基础，直接影响后续20以内、100以内计算的熟练度。\n✨ 为什么一定要练10以内口算？\n▫️幼小衔接核心考点，小学一年级数学入门必备\n▫️提升计算速度和准确率，避免后续计算卡顿\n▫️培养数感，为复杂运算打牢基础\n▫️每天10分钟，轻松实现“脱口而出”\n📝 练习题亮点：\n✔️ 题型全面：加法、减法分开练，还有混合口算题\n✔️ 梯度设计：从简单到稍复杂，循序渐进不劝退\n✔️ 超大字体：保护孩子视力，做题更清晰\n✔️ 空白答题区：方便孩子手写答题，即时检验成果\n✔️ 无水印可打印：A4纸直接打印，反复使用不浪费。\n#幼小衔接 #数学口算 #10以内加减法 #幼小衔接数学 #可打印练习题 #宝妈干货 #一年级数学 #学前数学 #口算练习 #育儿分享#加减法[话题]# #拼音练习[话题]# #数的组合与分解[话题]# #让孩子爱上数学[话题]# #口算[话题]# #拼音[话题]# #口算速算[话题]# #数感启蒙[话题]#', 'video_url': '', 'time': 1772972746000, 'last_update_time': 1772972746000, 'user_id': '5c3487be00000000070090f1', 'nickname': '秦可乐', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/6388184cc8f38421bdef3176.jpg', 'liked_count': '24', 'collected_count': '18', 'comment_count': '4', 'share_count': '1', 'ip_location': '广东', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603092309/3408066d1ed65fee5bc5643b28ba87ed/notes_pre_post/1040g3k831tf1c1e5m8d05n1kguv1p47hho792o8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603092309/fca0cd557001bf54a7925ba1157dbb82/notes_pre_post/1040g3k831tf1c1e5m8cg5n1kguv1p47hfpb7meg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603092309/595b8623a3367e3feafcb26bba59b05b/notes_pre_post/1040g3k831tf1c1e5m88g5n1kguv1p47hhq84k48!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603092309/cce997cf7cbdd0035360ee8f22fae32e/notes_pre_post/1040g3k831tf1c1e5m8bg5n1kguv1p47hf02ri0o!nd_dft_wlteh_webp_3', 'tag_list': '加减法,拼音练习,数的组合与分解,让孩子爱上数学,口算,拼音,口算速算,数感启蒙', 'last_modify_ts': 1773069069661, 'note_url': 'https://www.xiaohongshu.com/explore/69ad6aca000000001a028f93?xsec_token=ABvLeRKggm36TRrZStx-KzgbVTrwJB5MeA0n2pKlDmy4g=&xsec_source=pc_search', 'source_keyword': '#小学数学   #小学计算 #数学网课 #陪读经验   #提前学 #数学超前学', 'xsec_token': 'ABvLeRKggm36TRrZStx-KzgbVTrwJB