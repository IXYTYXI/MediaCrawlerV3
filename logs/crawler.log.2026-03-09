c.xhscdn.com/202603092012/5fde5aa356b8940e504134d4e7aa827c/1040g00831ltpt7val06g5novojdgbukr6cv2tl8!nd_prv_wlteh_webp_3', 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092012/a83b5f5e8b9e43a62ebc9393f082393e/1040g00831ltpt7val06g5novojdgbukr6cv2tl8!nd_dft_wlteh_webp_3', 'stream': {}, 'live_photo': False, 'file_id': ''}, {'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/e7ec97f1dd6ab4e335b4e251054e780d/1040g00831ltpt7val0705novojdgbukrut1n24o!nd_dft_wlteh_webp_3', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/aed6cb6f398681e5bd4326ec784bcad3/1040g00831ltpt7val0705novojdgbukrut1n24o!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/e7ec97f1dd6ab4e335b4e251054e780d/1040g00831ltpt7val0705novojdgbukrut1n24o!nd_dft_wlteh_webp_3'}], 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092012/aed6cb6f398681e5bd4326ec784bcad3/1040g00831ltpt7val0705novojdgbukrut1n24o!nd_prv_wlteh_webp_3', 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092012/e7ec97f1dd6ab4e335b4e251054e780d/1040g00831ltpt7val0705novojdgbukrut1n24o!nd_dft_wlteh_webp_3', 'live_photo': False, 'file_id': '', 'height': 1660, 'width': 1242, 'trace_id': '', 'stream': {}}], 'xsec_token': 'ABOxNilSVaOvYB-aRoeAKVo99fJBWjSThEbTI8dCoctWQ=', 'xsec_source': None}, {'note_id': '690ca80b0000000005033661', 'user': {'user_id': '653e14af000000000d004e73', 'nickname': '熙熙老师教学习', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31htiqjp2jq5g5p9u2inj8jjjo2rj9vo', 'xsec_token': 'ABhRS-jLK4vT-SkLvwgL55PXKBKW6hteaMVKaqJx0ifws='}, 'time': 1762437131000, 'last_update_time': 1762437132000, 'type': 'normal', 'title': '我宣布！B站就是普通家庭学小学数学的天堂', 'desc': '作为一位陪娃几年的老母亲，真的太懂那种 “花大几千报班、结果孩子学得痛苦还不出效果” 的崩溃了😭。…… 直到我转战 B 站挖资源，才真正找到适合普通家庭学小学数学的通关密码！B 站自学 + 网课 = 绝杀！\n\t\n🌈今天就把老二常看的几个宝藏 UP 主整理出来，分享给正在迷茫的宝妈们👇按学习方向分好类，大家直接抄作业就行！\n\t\n基础题型狂魔→朱韬\n计算易错点、乘法口诀记混这些，老二总踩的坑，全被老师做成了趣味动画！“进位要记牢，个位满十进一位”“周长计算先找边，长加宽和再乘二”，现在做基础计算题又快又准，上次期末考试，基础题型几乎拿满了分，太欣慰了！\n\t\n算术救星→亮亮巧解小学数学\n老师讲题言简意赅，专啃小学算术难题！普娃也能轻松听懂，把复杂的四则混合运算拆成 “步骤闯关指南”，老二听得眼睛都亮了，再也不犯困，现在还主动跟我讲 “先算括号里，再算乘除后加减”，算术题正确率直线飙升，真是拯救老二的宝藏老师！\n\t\n几何大神→疯哥\n家有怕几何题的娃，选这位准没错！他把长方形面积讲成 “数格子的进阶游戏”，说找对应边是 “几何题的关键钥匙”，老二边听边画图形示意图，现在做 “长方形面积计算” 题，还会念叨 “先找长和宽，再用长乘宽”，步骤写得又规范又完整！\n\t\n应用题提分王→郭化楠老师\n应用题没思路？这位老师的 “题干拆解法” 超管用，能把复杂题干变清晰！老师还总结了各类小学应用题模型，教怎么把 “购物找零问题” 转化成 “减法计算”，现在老二做应用题终于有自己的思路了，再也不盯着题目发呆耗时间。\n\t\n压轴题大杀器→赵礼显数学\n老师的 “小学压轴题破题三步法” 绝了！拿到题先 “找条件”“想公式”“梳步骤”，三步就能突破难点！老二学了一个多月，看到复杂几何题就会说 “这题考组合图形面积呀”，上次模考压轴题只扣了 2 分，连数学老师都在班级群里夸他开窍啦！\n\t\n✅ 【伴学老师定制计划】每天雷打不动学 30 分钟：\n每天 30 分钟雷打不动，伴学老师还会随时给方法、帮答疑！\n周一周三周五：算术基础 + 几何图形\n周二周四周六：基础应用题 + 压轴题\n周末：刷基础题 + 复习解题模型\n\t\n咱们一起加油！愿娃每一个认真听课的夜晚，都能让数学成绩在考卷上稳稳绽放！ #数学学习[话题]#  #数学思维[话题]# #小学数学思维训练[话题]# #小学数学[话题]# #小学[话题]# #数学[话题]# #四年级[话题]# #五年级[话题]# #六年级[话题]# #三年级[话题]#', 'interact_info': {'share_count': '11', 'followed': False, 'relation': 'none', 'liked': False, 'liked_count': '25', 'collected': False, 'collected_count': '55', 'comment_count': '10'}, 'image_list': [{'file_id': '', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/762c3315ef8a753afe67b93793c6e53b/notes_pre_post/1040g3k831oi1o3rg6gdg5p9u2inj8jjju7tu110!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/a857fd792fb8ceaefc29c2fee931c391/notes_pre_post/1040g3k831oi1o3rg6gdg5p9u2inj8jjju7tu110!nd_dft_wlteh_webp_3'}], 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092012/762c3315ef8a753afe67b93793c6e53b/notes_pre_post/1040g3k831oi1o3rg6gdg5p9u2inj8jjju7tu110!nd_prv_wlteh_webp_3', 'height': 1656, 'width': 1242, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/a857fd792fb8ceaefc29c2fee931c391/notes_pre_post/1040g3k831oi1o3rg6gdg5p9u2inj8jjju7tu110!nd_dft_wlteh_webp_3', 'trace_id': '', 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092012/a857fd792fb8ceaefc29c2fee931c391/notes_pre_post/1040g3k831oi1o3rg6gdg5p9u2inj8jjju7tu110!nd_dft_wlteh_webp_3', 'stream': {}, 'live_photo'