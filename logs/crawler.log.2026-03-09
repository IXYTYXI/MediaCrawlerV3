2026-03-09 20:37:39 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69246d60000000001e005046', 'type': 'normal', 'title': '小学数学计算方法', 'desc': '我感觉比算理好记不好说[扶额R]\n（部分算理我放进图片里了，大家需要的可以滑一下）\n我是根据机构老师说的整理的，针对笔试里教学设计的内容，不知道是否适用于面试或者面试的教案，仅供参考[完啦R]\n老师说全部算理会考前给我们说一遍，所以我也没全部的哈', 'video_url': '', 'time': 1763994976000, 'last_update_time': 1764236579000, 'user_id': '5cf14b43000000001002d244', 'nickname': 'momo', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31h5u1tf93c005n7h9d1k5ki4ietbs0o', 'liked_count': '1509', 'collected_count': '1080', 'comment_count': '24', 'share_count': '96', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603092035/a4cb2ab97d907d61ed216ed59ae56b84/note_pre_post_uhdr/1040g3r831p98imrci8705n7h9d1k5ki4c9tb6i0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603092035/b687a0073bc845849c11e5f50f1e2b1d/note_pre_post_uhdr/1040g3r831p98imrci87g5n7h9d1k5ki4647a39o!nd_dft_wgth_webp_3,http://sns-webpic-qc.xhscdn.com/202603092035/3d909ac9edaadcfaca9e23d240ca7ce6/notes_uhdr/1040g3qo31pcrpkm9i4005n7h9d1k5ki4vt4hld8!nd_dft_wgth_webp_3,http://sns-webpic-qc.xhscdn.com/202603092035/2d99aa4f7a544cdcc2b4adc93f785aab/1040g2sg31pcrnff528e05n7h9d1k5ki411s5sb8!nd_dft_wgth_webp_3', 'tag_list': '', 'last_modify_ts': 1773059859671, 'note_url': 'https://www.xiaohongshu.com/explore/69246d60000000001e005046?xsec_token=ABlkq2_naWte0JNmmcxL1A1IlO_qO8qjbbJdQIVstHFLg=&xsec_source=pc_search', 'source_keyword': '#小学数学   #小学计算 #数学网课 #陪读经验   #提前学 #数学超前学', 'xsec_token': 'ABlkq2_naWte0JNmmcxL1A1IlO_qO8qjbbJdQIVstHFLg='}
