2026-03-09 20:07:32 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6936822b000000001e0306f7', 'type': 'normal', 'title': '数学超前学怎么规划，怎么学（2小学阶段）', 'desc': '数学超前学习小学阶段目标是搭建基本知识结构，方法是逐字逐句阅读1-6年级课本，或使用总复习教辅。常见问题包括家长观念、坚持方法和自主学习培养。建议尽早完成小升初衔接，避免校内成绩提升不明显。#鸡娃必备[话题]# #让孩子爱上数学[话题]# #学霸养成[话题]# #', 'video_url': '', 'time': 1765179947000, 'last_update_time': 1765179947000, 'user_id': '57ed56e65e87e7283a7e695e', 'nickname': '小梦', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31h4t8tekjo0048nnh2becqau6egajng', 'liked_count': '276', 'collected_count': '463', 'comment_count': '49', 'share_count': '68', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603092005/bec3ddbf7779566adc11e83f4f321d52/1040g2sg31pqsr3l9527048nnh2becqaunj3cpeg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603092005/78ada94e1232c5f289c309e32bbd07b3/1040g2sg31pqsr3l9527g48nnh2becqauu4f5gh8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603092005/8557efcaf99a206d5af672e31a935fad/1040g2sg31pqsr3l9528g48nnh2becqaueju7mp0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603092005/b9e81e4414cebf78585f4c336bdea197/1040g2sg31pqsr3l9528048nnh2becqaui3htod0!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603092005/cde391bc39dad34b833d27cbb9de0839/1040g2sg31pqsr3l9529048nnh2becqauejd81ho!nd_dft_wlteh_webp_3', 'tag_list': '鸡娃必备,让孩子爱上数学,学霸养成', 'last_modify_ts': 1773058052754, 'note_url': 'https://www.xiaohongshu.com/explore/6936822b000000001e0306f7?xsec_token=ABnvsnMM5k0jAnJTCekD2JcMTr6pKhMjzYAf86OJshZoc=&xsec_source=pc_search', 'source_keyword': '#小学数学   #小学计算 #数学网课 #陪读经验   #提前学 #数学超前学', 'xsec_token': 'ABnvsnMM5k0jAnJTCekD2JcMTr6pKhMjzYAf86OJshZoc='}
