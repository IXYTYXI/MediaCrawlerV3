2026-03-09 16:09:33 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '66ea8004000000000c019176', 'type': 'normal', 'title': '👉新加坡数学，你是真的很牛！', 'desc': '为什么孩子明明看着数学基础还不错😊\n可一旦难度提升就立刻不会了😵\n❓书上的例题都会，但T型稍微变化就懵了\n🫡其实都是一样的解法套路，孩子就是反应不过来...\n⚠这可能是娃还没形成数数理思维\n✅推荐家长们建议试试新加坡数学~因为其更注重建模思维的培养🔺\n将抽象的概念问题，转化成直观的图像问题\n-\n🔥让孩子越学越上瘾的SparkMath新加坡数学\n✔学会建模，将复杂问题化繁为简\n✔激发兴趣，把枯燥的公式变成直观的图像\n✔双语教学，英语➕数学两手抓\n✔个性化学习，及时按能力调整，满足不同学习能力范围的成长\n✔覆盖全球大部分主流赛事知识点，夯基础抓提高两不误\n✔中西结合学习，20种思维方法内容深度、广度、高度齐头并进\n✔资深教师E＆M双修，名校师资、拥有丰富国际化数学授课经验\n-\n💻上课形式：在线小班直播课\n💬授课语言：全英/双语/中文\n-\n🎁试听大礼包包括\n🎈 1节在线思维直播课\n🎈 12节数独趣味课\n🎈 小学速算巧算训练营课\n-\n现在点击图片下方⬇ 【立即领取】就可以免费体验哦\n⏰ 活动时间：即日起—2024年12月31日\n*课程面向海外人群（18岁以上）\n#新加坡数学[话题]#\xa0\xa0#新加坡数学网课[话题]#\xa0\xa0#新加坡数学建模[话题]#\xa0\xa0#新加坡数学补习[话题]#\xa0\xa0#新加坡数学竞赛[话题]#\xa0\xa0#新加坡数学应用题[话题]#\xa0\xa0#新加坡数学思维[话题]#\xa0\xa0#新加坡数学课程[话题]#\xa0\xa0#新加坡数学课[话题]#\xa0\xa0#新加坡数学教材[话题]#\xa0\xa0#新加坡数学老师[话题]#\xa0\xa0#竞赛白名单[话题]#\xa0\xa0#数学竞赛[话题]#\xa0\xa0#小学数学竞赛[话题]#', 'video_url': '', 'time': 1726650093000, 'last_update_time': 1726644228000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '2', 'collected_count': '2', 'comment_count': '4', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603091609/dd5a8d89d3183b49a168e7be6009fe72/spectrum/1040g34o317sm9tum0o0g5olhcu8lbcma12gavh0!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学,新加坡数学网课,新加坡数学建模,新加坡数学补习,新加坡数学竞赛,新加坡数学应用题,新加坡数学思维,新加坡数学课程,新加坡数学课,新加坡数学教材,新加坡数学老师,竞赛白名单,数学竞赛,小学数学竞赛', 'last_modify_ts': 1773043773511, 'note_url': 'https://www.xiaohongshu.com/explore/66ea8004000000000c019176?xsec_token=ABrTblJxDfi4U7mOSoQ4cVHWGuvGdy962SnZ-KdwgZGew=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABrTblJxDfi4U7mOSoQ4cVHWGuvGdy962SnZ-KdwgZGew='}
