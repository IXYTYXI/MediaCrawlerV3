2026-03-09 16:18:47 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '669f4dcd0000000027018b89', 'type': 'normal', 'title': '滴滴🛵孩子的新加坡Math外卖已送达', 'desc': '人家海淀娃、魔都娃都偷着学一两年的Math课🙋\u200d\n已经帮无数孩子从数学学渣极速飞升数学学霸了🚩\n暑假、马上开学的家长们还在纠结给孩子选怎么数学课❓\n有这一个就够了‼️\n-\n尤其是咱家有数渣娃的妈妈们🤔\n估计也想让孩子提前准备💪新学期扭转数渣设定强势逆袭\n但又真怕孩子抗拒数学不知道该怎么办😓\n想要玩学两不误🙋\u200d数学逆袭就来👉SparkMath新加坡数学\n-\n🔥让孩子越学越上瘾的SparkMath新加坡数学\n✔学会建模，将复杂问题化繁为简\n✔激发兴趣，把枯燥的公式变成直观的图像\n✔双语教学，英语➕数学两手抓\n✔个性化学习，及时按能力调整，满足不同学习能力范围的成长\n✔覆盖全球大部分主流赛事知识点，夯基础抓提高两不误\n✔中西结合学习，20种思维方法内容深度、广度、高度齐头并进\n✔资深教师E＆M双修，名校师资、拥有丰富国际化数学授课经验\n-\n💻上课形式：在线小班直播课\n💬授课语言：全英/双语/中文\n-\n🎁试听大礼包包括\n🎈 1节在线思维直播课\n🎈 12节数独趣味课\n🎈 小学速算巧算训练营课\n-\n现在点击图片下方⬇ 【立即领取】就可以免费体验哦\n⏰ 活动时间：即日起—2024年12月31日\n*课程面向海外人群（18岁以上）\n#新加坡数学[话题]#\xa0\xa0#新加坡数学CPA教学法[话题]#\xa0\xa0#新加坡数学网课[话题]#\xa0\xa0#学习日常[话题]#\xa0\xa0#幼小衔接数学[话题]#\xa0\xa0#一年级数学[话题]#\xa0\xa0#小学数学[话题]#\xa0\xa0#sparkmath[话题]#\xa0\xa0#sparkmath中文站[话题]#\xa0\xa0#新加坡数学建模[话题]#\xa0\xa0#数形结合[话题]#\xa0\xa0#建模思维[话题]#\xa0\xa0#学霸[话题]#\xa0\xa0#学霸秘籍[话题]#\xa0\xa0#鸡娃[话题]#\xa0\xa0#鸡娃学习日常[话题]#\xa0\xa0#海淀小学生[话题]#\xa0\xa0#英语学数学[话题]#\xa0\xa0#数学直播课[话题]#\xa0\xa0#直播小班课[话题]#', 'video_url': '', 'time': 1721725279000, 'last_update_time': 1721716174000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '12', 'collected_count': '10', 'comment_count': '8', 'share_count': '3', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603091618/b6186451b9948492563d7e6852ba77b3/spectrum/1040g0k0315j8403q0o005olhcu8lbcmaj9lhen0!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学,新加坡数学CPA教学法,新加坡数学网课,学习日常,幼小衔接数学,一年级数学,小学数学,sparkmath,sparkmath中文站,新加坡数学建模,数形结合,建模思维,学霸,学霸秘籍,鸡娃,鸡娃学习日常,海淀小学生,英语学数学,数学直播课,直播小班课', 'last_modify_ts': 1773044327677, 'note_url': 'https://www.xiaohongshu.com/explore/669f4dcd0000000027018b89?xsec_token=ABr-Vx9gaVuoyReLQeQnDTrq6k0YWBY0F3e40X2lZitBM=&xsec_source=pc_search', 'source_keyword': 