2026-03-09 16:02:55 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '672350b50000000019018b48', 'type': 'normal', 'title': '练好数理思维😎是成为别人家孩子的第一步', 'desc': '如果孩子算数还要掰手指、计算反应慢、遇到稍微复杂的题目就翻车、对数字类的东西不敏感、不开窍、没思路。其实就是数学思维需要加强。\n-\n建议家长们可以试试Spark Math新加坡数学\n✅40分钟一节课，随时随地都能学\n✅自研上课平台，全程追踪学习进度\n✅校内数学、考试难题、速算技巧和竞赛数学等内容面\n✅游戏化交互课件，沉浸式学习\n✅完备的线上测评体系线上线下同步练习\n-\n现在点击图片下方【立即领取】即可免费获得SparkMath试听课~联合专业老师进行授课讲解，分阶教学,循序渐进培养综合实力\n-\n‼试听大礼包包括\n👉1节在线思维直播课\n👉12节数独趣味课\n👉小学速算巧算训练营课\n活动时间:即日起一2024年12月31日\n#新加坡数学[话题]#\xa0\xa0#新加坡数学网课[话题]#\xa0\xa0#新加坡数学建模[话题]#\xa0\xa0#新加坡数学补习[话题]#\xa0\xa0#新加坡数学竞赛[话题]#\xa0\xa0#新加坡数学应用题[话题]#\xa0\xa0#新加坡数学思维[话题]#\xa0\xa0#新加坡数学课程[话题]#\xa0\xa0#新加坡数学老师[话题]#\xa0\xa0#新加坡数学课[话题]#\xa0\xa0#新加坡数学教材[话题]#\xa0\xa0#新加坡数学英文[话题]#\xa0\xa0#新加坡数学cpa[话题]#\xa0\xa0#sparkmath新加坡数学[话题]#\xa0\xa0#小学数学[话题]#\xa0\xa0#小学数学怎么学[话题]#\xa0\xa0#学霸[话题]#\xa0\xa0#鸡娃[话题]#', 'video_url': '', 'time': 1730367669000, 'last_update_time': 1730367670000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '2', 'collected_count': '2', 'comment_count': '', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603091602/71c1ff68f42cdd638707209cab195802/spectrum/1040g0k0319k5of5a6m005olhcu8lbcmaf9bmohg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603091602/373d0a808603c2fc6448ec557280329f/spectrum/1040g0k0319k5olf86m005olhcu8lbcma34litkg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603091602/fe5be6e5311be5bb4c63fbaf2bf81c11/spectrum/1040g34o319k5oikq6m0g5olhcu8lbcmasbcfulg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603091602/528c3e36f084f784ef27d7ab587cd042/spectrum/1040g34o319k5ogfvmu0g5olhcu8lbcmav1c797o!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603091602/3073521fa974b58587e9b6e10411edd4/spectrum/1040g34o319k5ok1jms0g5olhcu8lbcmadfd25og!nd_dft_wlteh_webp_3', 'tag_list':