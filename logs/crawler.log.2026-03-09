ost/1040g3k831tfocknp5kbg5n2mvanmk0oqmgojpm8!nd_dft_wlteh_webp_3'}], 'live_photo': False, 'file_id': '', 'width': 2481, 'trace_id': '', 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092108/af7578af02718852f342e03f28abef0b/notes_pre_post/1040g3k831tfocknp5kbg5n2mvanmk0oqmgojpm8!nd_prv_wlteh_webp_3', 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092108/f79554bc529cd2b64e79a5954f54fc80/notes_pre_post/1040g3k831tfocknp5kbg5n2mvanmk0oqmgojpm8!nd_dft_wlteh_webp_3', 'stream': {}}], 'at_user_list': [], 'time': 1773021230000, 'last_update_time': 1773021231000, 'type': 'normal', 'title': '二年级下册数学计算一课一练（人教版50页）', 'desc': '最近很多老师和家长催我更新26春二下“计算专项”一课一练，每日一练完整版50页。\n二年级下册数学计算题是整个小学阶段的“地基”，全册核心就是计算，直接决定了三年级能不能跟上，这个年级很容易粗心，这可不是小问题，大多数是因为口诀不熟，不验算导致的，一课一练能帮助孩子把计算题练熟，练稳，老师和家长们赶紧给孩子准备上吧。\n#二年级下册数学[话题]# #人教版二下数学[话题]# #一课一练[话题]# #计算题专项[话题]# #二下数学计算专项[话题]# #每日一练[话题]# #数学启蒙[话题]# #计算题训练[话题]#', 'xsec_token': 'ABJN297lxnTOZjpUIS5vmwTh8TvXRaAQkPvquq5BThz_E=', 'xsec_source': None}, {'at_user_list': [], 'share_info': {'un_share': False}, 'title': '数学老师发的，四年级下册同步每课一练‼️', 'image_list': [{'trace_id': '', 'stream': {}, 'live_photo': False, 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092109/5c7a7156cb95d73e5b4d56cc4b2ccc62/1040g2sg31ru27knsj2gg5o2et5008q6jtthr6eg!nd_dft_wlteh_webp_3', 'file_id': '', 'height': 1920, 'width': 1440, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092109/5c7a7156cb95d73e5b4d56cc4b2ccc62/1040g2sg31ru27knsj2gg5o2et5008q6jtthr6eg!nd_dft_wlteh_webp_3', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092109/2aeea0ac6bb499832ffa1fa836608379/1040g2sg31ru27knsj2gg5o2et5008q6jtthr6eg!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092109/5c7a7156cb95d73e5b4d56cc4b2ccc62/1040g2sg31ru27knsj2gg5o2et5008q6jtthr6eg!nd_dft_wlteh_webp_3'}], 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092109/2aeea0ac6bb499832ffa1fa836608379/1040g2sg31ru27knsj2gg5o2et5008q6jtthr6eg!nd_prv_wlteh_w