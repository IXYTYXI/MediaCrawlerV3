p_3', 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092100/ad96e2260d6cb5b6dd811e11213046bf/notes_pre_post/1040g3k031t9nmn2l622g5nijl62091h8u9lt3jo!nd_prv_wlteh_webp_3', 'live_photo': False, 'height': 2560}, {'trace_id': '', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092100/20c2091508edab343ea1f1126f8593d1/notes_pre_post/1040g3k031t9nmn2l621g5nijl62091h8oo1qhe8!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092100/ade7bfeb7e1ea5846325c19a76a872e4/notes_pre_post/1040g3k031t9nmn2l621g5nijl62091h8oo1qhe8!nd_dft_wlteh_webp_3'}], 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092100/ade7bfeb7e1ea5846325c19a76a872e4/notes_pre_post/1040g3k031t9nmn2l621g5nijl62091h8oo1qhe8!nd_dft_wlteh_webp_3', 'stream': {'av1': [], 'h264': [{'backup_urls': ['http://sns-bak-v1.xhscdn.com/stream/1/10/19/01e9a7fc15c59186010050039cb8323cd3_19.mp4'], 'master_url': 'http://sns-video-hs.xhscdn.com/stream/1/10/19/01e9a7fc15c59186010050039cb8323cd3_19.mp4'}], 'h265': [], 'h266': []}, 'live_photo': True, 'height': 2560, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092100/ade7bfeb7e1ea5846325c19a76a872e4/notes_pre_post/1040g3k031t9nmn2l621g5nijl62091h8oo1qhe8!nd_dft_wlteh_webp_3', 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092100/20c2091508edab343ea1f1126f8593d1/notes_pre_post/1040g3k031t9nmn2l621g5nijl62091h8oo1qhe8!nd_prv_wlteh_webp_3', 'file_id': '', 'width': 1920}, {'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092100/b33e6e7538962a7ab16909846481d453/notes_pre_post/1040g3k031t9nmn2l623g5nijl62091h8gbr0hf0!nd_dft_wlteh_webp_3', 'live_photo': False, 'file_id': '', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092100/b33e6e7538962a7ab16909846481d453/notes_pre_post/1040g3k031t9nmn2l623g5nijl62091h8gbr0hf0!nd_dft_wlteh_webp_3', 'trace_id': '', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092100/7c8708c58c8f1bd8a9ac54d4fd0fea34/notes_pre_post/1040g3k031t9nmn2l623g5nijl62091h8gbr0hf0!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092100/b33e6e7538962a7ab16909846481d453/notes_pre_post/1040g3k031t9nmn2l623g5nijl62091h8gbr0hf0!nd_dft_wlteh_webp_3'}], 'height': 2560, 'width': 1920, 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092100/7c8708c58c8f1bd8a9ac54d4fd0fea34/notes_pre_post/1040g3k031t9nmn2l623g5nijl62091h8gbr0hf0!nd_prv_wlteh_webp_3', 'stream': {}}], 'at_user_list': [], 'note_id': '69a7fc6f000000001503bec7', 'type': 'normal', 'xsec_token': 'ABvZQ8gVtpPvPxvK0DB2sI8Ct3jzTHgxTDiRhg94Gu2kY=', 'xsec_source': None}, {'note_id': '685006350000000021002980', 'title': '四年级数学连拿两次100，1v1真的选对了✅', 'desc': '四年级的数学，难度上来了。我家小芃之前数学不算拔尖，我们也试过不少方法，线上线下班、思维课都报过，钱和时间没少花，但总觉得效果不如意，成绩起伏不定，看着真着急。\n\t\n这学期开学后，给小芃尝试了1v1线上课。孩子语文是跟着这个课程的，效果很好，所以也想试试看数学，没想到，上下来效果也挺明显的。最实在的证据就是最近两次考试，小芃都拿了满分100分！ 而且做题明显感觉他思路清晰了，错误少了，我觉得这方法是真的找对了。\n说说我为什么觉得这课适合我们：\n✅第一，不是盲目开课，先摸底：报名后不是马上上课，而是先给孩子做了一个挺详细的学情诊断。老师会通过孩子最近的试卷错题进行分析，然后再和家长沟通孩子情况，精准找出孩子到底卡在哪里。拿到这份报告，我和老师都心里有谱了，知道劲儿该往哪使。\n✅第二，真省时省力：四年级娃放学后，校内作业、课外兴趣班，时间排得满满当当。再往线下课跑，来回接送太折腾孩子和家长了。线上课在家就能上，时间灵活，省下的路上时间，孩子能多休息会儿或者做点别的，我这当家长的也轻松不少。\n✅第三，教的不是死知识，是解题的思路： 这点我感触最深。他们老师不是单纯讲题，而是会用问题一步步引导小芃自己思考，让他把思路说出来，老师会引导他尝试不同的角度，找到更适合他的方法。\n✅第四，完全跟着娃的节奏走：老师能精准抓住小芃哪里卡壳，哪里不熟练。课后布置的练习也很有针对性，不是题海战术，就是专门巩固薄弱环节的。每次作业老师都认真批改，下次课还会讲解错题，这点我觉得特别好。\n✅第五，习惯有人帮着养成：除了上课老师，还有个班主任老师会跟进。课后练习班主任会及时提醒，帮助小芃养成了每天做点数学练习的习惯。运算能力提升特别快，数感也好了很多，这都是靠平时一点点积累的。\n\t\n作为普通家长，我觉得：\n适合自家娃的才是最好的。这种形式在时间效率和针对性上，确实解决了我们的大问题。现在小芃对数学的兴趣和信心都高了不少，期末复习我们也更有底了。希望他能保持状态，继续加油！\n\t\n如果你家也正在为数学发愁，这种上课模式我觉得值得了解看看。毕竟，看到孩子实实在在的进步，是我们当家长最欣慰的事🥰🥰\n\t\n#小学数学[话题]# #四年级数学[话题]# #数学[话题]# #学习习惯[话题]# #小升初准备[话题]#  #亲子教育[话题]# #家有小学生[话题]# #小学数学思维训练[话题]# #期末复习[话题]#', 'tag_list': [{'type': 'topic', 'id': '610160dd000000000100b9d9', 'name': '小学数学'}, {'id': '5d4c25f000000000170236c8', 'name': '四年级数学', 'type': 'topic'}, {'id': '5be3f4505b18e80001167d7c', 'name': '数学', 'type': 'topic'}, {'id': '5c94ed5e000000000e0373ad', 'name': 