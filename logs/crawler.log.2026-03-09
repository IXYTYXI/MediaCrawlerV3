ster_url': 'http://sns-video-al.xhscdn.com/stream/1/110/115/01e99d799c37b245010370019c8f2378fc_115.mp4', 'format': 'mp4', 'height': 1920, 'volume': 0, 'audio_codec': 'aac', 'audio_bitrate': 128959}]}}, 'image': {'thumbnail_fileid': 'frame/110/0/01e99d799c37b2450010000000019c8f2324e5_0.webp'}}, 'tag_list': [], 'at_user_list': [], 'ip_location': '陕西', 'title': '小学数学题', 'time': 1771927967000, 'share_info': {'un_share': False}, 'image_list': [{'height': 1920, 'width': 1080, 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092027/0262cd0b77fc1ec71e1064b9b4b31044/1040g2sg31svfalfq5s705ntbih50bsbioquahlo!nd_prv_wlteh_webp_3'}, {'url': 'http://sns-webpic-qc.xhscdn.com/202603092027/572597a3e1c446ebc1e0faa60ae7ecca/1040g2sg31svfalfq5s705ntbih50bsbioquahlo!nd_dft_wlteh_webp_3', 'image_scene': 'WB_DFT'}], 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092027/0262cd0b77fc1ec71e1064b9b4b31044/1040g2sg31svfalfq5s705ntbih50bsbioquahlo!nd_prv_wlteh_webp_3', 'stream': {}, 'live_photo': False, 'file_id': '', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092027/572597a3e1c446ebc1e0faa60ae7ecca/1040g2sg31svfalfq5s705ntbih50bsbioquahlo!nd_dft_wlteh_webp_3', 'trace_id': '', 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092027/572597a3e1c446ebc1e0faa60ae7ecca/1040g2sg31svfalfq5s705ntbih50bsbioquahlo!nd_dft_wlteh_webp_3'}], 'type': 'video', 'desc': '', 'last_update_time': 1771927967000, 'note_id': '699d799f0000000015039f75', 'xsec_token': 'ABcIsu6TEfbj4bbHURdQ3vPgWCCrLdrSdhYO9oX3rOAHI=', 'xsec_source': None}, {'last_update_time': 1747310082000, 'share_info': {'un_share': False}, 'note_id': '6825d602000000002203799f', 'type': 'normal', 'title': '人教版五下数学异分母分数加减法', 'interact_info': {'comment_count': '19', 'share_count': '159', 'followed': False, 'relation': 'none', 'liked': False, 'liked_count': '2752', 'collected': False, 'collected_count': '2358'}, 'at_user_list': [], 'time': 1747310082000, 'desc': '🌈异分母分数加减法\n[爆炸R]核心是通分，把异分母分数转化成同分母分数。\n这里我分了三类，链接上了之前求最小公倍数的三种情况:\n1️⃣分母有倍数关系[爆炸R]分母中较大数作为公分母\n2️⃣分母是互质关系[爆炸R]分母的乘积作为公分母\n[葡萄R]分母相邻\n[葡萄R]分母都是质数\n[葡萄R]分母的公因数只有1\n3️⃣分母是一般关系[爆炸R]用短除法求分母的最小公倍数\n[星R]总结异分母分数加减法步骤:\n一看（看分母）；\n二通（求分母最小公倍数，把异分母分数转化成同分母分数）；\n三算（分母相同，分子相加减）；\n四约（结果要约成最简分数）。\n#小学数学[话题]# #五下数学[话题]##异分母分数加减法板书设计[话题]##分母有倍数关系[话题]##分母是互质关系[话题]##分母是一般关系[话题]##异分母分数加减法的步骤[话题]#', 'user': {'user_id': '5c109ab5000000000501f011', 'nickname': '娓娓老师', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31frmefb3ne4g4bv0kedbbs0hjkb6mko', 'xsec_token': 'ABCIE2e5ihUghFGMfBWzpO-gfHk-A5EsaHq0eG2ERyMM4='}, 'image_list': [{'width': 1920, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092027/ee967e63056041e908a05616e8f0161a/notes_pre_post/1040g3k031hgkadtn3a6g4bv0kedbbs0h71tc0io!nd_dft_wlteh_webp_3', 'trace_id': '', 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092027/ee967e63056041e908a05616e8f0161a/notes_pre_post/1040g3k031hgkadtn3a6g4bv0kedbbs0h71tc0io!nd_dft_wlteh_webp_3', 'live_photo': False, 'file_id': '', 'height': 2560, 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092027/4b68f3854d8792e97ebd154cc6b6d3d4/notes_pre_post/1040g3k031hgkadtn3a6g4bv0kedbbs0h71tc0io!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092027/ee967e63056041e908a05616e8f0161a/notes_pre_post/1040g3k031hgkadtn3a6g4bv0kedbbs0h71tc0io!nd_dft_wlteh_webp_3'}], 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092027/4b68f3854d8792e97ebd154cc6b6d3d4/notes_pre_post/1040g3k031hgkadtn3a6g4bv0kedbbs0h71tc0io!nd_prv_wlteh_webp_3', 'stream': {}}], 'tag_list': [{'type': 'topic', 'id': '610160dd000000000100b9d9', 'name': '小学数学'}, {'name': '五下数学', 'type': 'topic', 'id': '5ebab23b0000000001003982'}, {'id': '6825d601000000001800ffc9', 'name': '分母是互质关系', 'type': 'topic'}, {'id': '6825d601000000001800ffc7', 'name': '分母有倍数关系', 'type': 'topic'}, {'id': '6825d601000000001800ffcd', 'name': '异分母分数加减法的步骤', 'type': 'topic'}, {'name': '异分母分数加减法板书设计', 'type': 'topic', 'id': '