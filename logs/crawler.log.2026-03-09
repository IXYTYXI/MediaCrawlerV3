091823/e6a03d7c4db0615ac9bd4f8685bf34f5/1040g008318vkpm3tjq4048cloanc4695gv0sjg8!nd_dft_wlteh_jpg_3'}, {'trace_id': '', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603091823/93cfda6df2640e51cc4f64aafa527e2a/1040g008318vkpm3tjq5048cloanc46953fc0tt8!nd_prv_wlteh_jpg_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603091823/7256afeda134df753af97a3296961c98/1040g008318vkpm3tjq5048cloanc46953fc0tt8!nd_dft_wlteh_jpg_3'}], 'stream': {}, 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603091823/93cfda6df2640e51cc4f64aafa527e2a/1040g008318vkpm3tjq5048cloanc46953fc0tt8!nd_prv_wlteh_jpg_3', 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603091823/7256afeda134df753af97a3296961c98/1040g008318vkpm3tjq5048cloanc46953fc0tt8!nd_dft_wlteh_jpg_3', 'live_photo': False, 'file_id': '', 'height': 1656, 'width': 1242, 'url': 'http://sns-webpic-qc.xhscdn.com/202603091823/7256afeda134df753af97a3296961c98/1040g008318vkpm3tjq5048cloanc46953fc0tt8!nd_dft_wlteh_jpg_3'}, {'url': 'http://sns-webpic-qc.xhscdn.com/202603091823/1faa1376cc0de96be0dedc47e3770d98/1040g008318vkpm3tjq3g48cloanc4695foa1li8!nd_dft_wlteh_jpg_3', 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603091823/1faa1376cc0de96be0dedc47e3770d98/1040g008318vkpm3tjq3g48cloanc4695foa1li8!nd_dft_wlteh_jpg_3', 'file_id': '', 'width': 1242, 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603091823/6a69c10c5c1ab79ac6e2b523db1d7901/1040g008318vkpm3tjq3g48cloanc4695foa1li8!nd_prv_wlteh_jpg_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603091823/1faa1376cc0de96be0dedc47e3770d98/1040g008318vkpm3tjq3g48cloanc4695foa1li8!nd_dft_wlteh_jpg_3'}], 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603091823/6a69c10c5c1ab79ac6e2b523db1d7901/1040g008318vkpm3tjq3g48cloanc4695foa1li8!nd_prv_wlteh_jpg_3', 'stream': {}, 'live_photo': False, 'height': 1656, 'trace_id': ''}], 'at_user_list': [], 'time': 1728989749000, 'share_info': {'un_share': False}, 'type': 'normal', 'desc': '大班的家长们是不是都在研究孩子幼小衔接的事情，想要孩子入一年级数学成绩不拉跨，熟练掌握凑十法、破十法、平十法和借十法加减法速算法则至关重要✅！家长们在辅导孩子前一定要看看这篇笔记📖。\nㅤ\n1️⃣凑十法（加法）：让加法变得简单 🤝\n凑十法的核心在于👉将某个数字调整到接近或正好达到10的倍数，从而简化计算过程。例如，在计算9 + 7时，先给9加上1使其变成10，然后再加上剩余的6，即10 + 6 = 16。\n🌟口诀：拆小数，补大数，凑成十，加剩数\nㅤ\n2️⃣破十法（减法）：拆分后的减法艺术 ✅\n破十法主要用于涉及跨十位的减法运算，其精髓在于先分解再重组，可以帮助孩子快速理解“退位”的概念，提升运算速度。以13 - 9为例，先把13想象成10+3，然后分别减去9，即10 -9 = 1 和 3 - 0 = 3，后合并结果得到4。\n🌟口诀：拆大数，分出十，小在左，十在右。减小数，加剩数\nㅤ\n3️⃣平十法（减法）：巧妙转换的加法策略 🔄\n平十法是一种灵活的思维方法，用于处理两位数之间的加法，尤其是当其中一位数接近于10的时候，通过临时调整数值，使计算过程变得更加直观易懂。例如，计算28 + 5时，可以先让28变为30（增加2），然后计算30+3 = 33，完事记得减回之前添加的2，得到答案31。\n🌟口诀：看大数，拆小数，连续相减，算得数\nㅤ\n4️⃣借十法（减法）：跨十位的减法新思路 🎯\n借十法是破十法的高级版，特别适用于跨越多个十位数的减法题。例如，在做45-27这样的题目时，可以先从45中借一个十位（相当于借10），使得原来的45变为35+10，并将其转化为更简单的组合35-27，接着按照常规步骤计算，zui后加上之前借来的10，得出正确答案18。这种过程看似复杂，实则是培养孩子逻辑思维和逆向思考能力的有效途径。\n🌟口诀：拆大数，借出十，减小数，加剩数\nㅤ\n孩子掌握以上四种运算技巧，就像是拥有了通往数学王国的钥匙🔑，它不仅能够显著提高计算效率，还能在无形中培养孩子的数学直觉和分析能力🧬。家长们赶紧带着孩子练起来吧💪。\n\t\n#小学数学思维训练[话题]# #加减法[话题]# #幼小衔接[话题]# #幼儿园[话题]# #幼儿园大班[话题]# #一年级[话题]# #数学启蒙[话题]# #幼小衔接数学[话题]# #幼儿数学启蒙[话题]# #儿童数学思维启蒙[话题]#', 'tag_list': [{'id': '5c38ac5a000000000d0178b9', 'name': '小学数学思维训练', 'type': 'topic'}, {'id': '5ca9fa5a000000000f002604', 'name': '加减法', 'type': 'topic'}, {'id': '5be3f8325b18e8000116f583', 'name': '幼小衔接', 'type': 'topic'}, {'id': '5be2c6f46c82060001225b1a', 'name': '幼儿园', 'type': 'topic'}, {'name': '幼儿园大班', 'type': 'topic', 'id': '5cfe1daf000000000d03399c'}, {'id': '5452565ad6e4a90c5e30f617', 'name': '一年级', 'type': 'topic'}, {'name': '数学启蒙', 'type': 'topic', 'id': '5be51be7d970510001f3117c'}, {'id': '5ddc964d000000000100a7ae', 'name': '幼小衔接数学', 'type': 'topic'}, {'id': '5cbb15bb000000000e01147a', 'name': '幼儿数学启蒙', 'type': 'topic'}, {'type': 'topic', 'id': '62773a810000000001003e09', 'name': '儿童数学思维启蒙'}], 'last_update_time': 1728989749000, 'xsec_source': None}, {'xsec_token': 'ABxdK8u_fi7JGRNtyWbNVrojT_kr36fb9lVcxa9kYrUwU=', 'interact_info': {'liked_count': '1.1万', 'collected': False, 'collected_count': '1.3万', 'comment_coun