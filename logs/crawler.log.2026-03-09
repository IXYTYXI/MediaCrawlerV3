2026-03-09 16:15:53 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '66aced99000000002701c00e', 'type': 'normal', 'title': '数学界的扛把子，新加坡数学就是牛', 'desc': '孩子思维逻辑真的很差💔\n简单的算术，计算起来也很吃力，应该怎么办❓\n想让宝贝🧒赢在起跑线，学习不掉队\n🔥别担心，新加坡数学来解救你，实现无痛鸡娃~\n👉从小培养逻辑思维能力可太重要啦！\n-\n超🔥的Spark Math～省钱省妈省时间～\n让娃吃透思维逻辑，数学越学越有乐趣❗❗\n👩\u200d🎓采用在线小班直播课，同时提供中英、双语、全中文三种班型\n👩\u200d🎓教学采用主流的CPA教学理念，以计算为基础穿插几何、逻辑推理和应用\n👩\u200d🎓采用大量游戏化交互方式，结合UDSCSE六步教学法，攻克数学难关\n👩\u200d🎓课后大量的学具和练习题，让娃玩中学\n·\n现在点击下方⬇ 【立即领取】即可免费获得🆓Spark Math试听课~\n试听大礼包包括\n🎈 1节在线思维直播课\n🎈 12节数独趣味课\n🎈 小学速算巧算训练营课\n·\n现在点击下方⬇ 【立即领取】就可以免费体验🆓哦\n⏰ 截止时间：2024年12月31日\n*课程面向海外人群（18岁以上）\n#新加坡数学[话题]#\xa0\xa0#新加坡数学网课[话题]#\xa0\xa0#新加坡数学建模[话题]#\xa0\xa0#新加坡数学补习[话题]#\xa0\xa0#新加坡数学竞赛[话题]#\xa0\xa0#新加坡数学应用题[话题]#\xa0\xa0#新加坡数学思维[话题]#\xa0\xa0#新加坡数学课[话题]#\xa0\xa0#新加坡数学课程[话题]#\xa0\xa0#新加坡数学老师[话题]#\xa0\xa0#新加坡数学教材[话题]#\xa0\xa0#新加坡数学英文[话题]#\xa0\xa0#新加坡数学cpa[话题]#\xa0\xa0#sparkmath新加坡数学[话题]#\xa0#sparkmath线上教育\xa0#小学数学[话题]#\xa0\xa0\xa0#数学思维[话题]#', 'video_url': '', 'time': 1722609049000, 'last_update_time': 1722609050000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '29', 'collected_count': '11', 'comment_count': '', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603091615/5d8e628a67e19996239600f8a03d91be/spectrum/1040g0k03160i44augk005olhcu8lbcmaind0o28!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学,新加坡数学网课,新加坡数学建模,新加坡数学补习,新加坡数学竞赛,新加坡数学应用题,新加坡数学思维,新加坡数学课,新加坡数学课程,新加坡数学老师,新加坡数学教材,新加坡数学英文,新加坡数学cpa,sparkmath新加坡数学,小学数学,数学思维', 'last_modify_ts': 1773044153368, 'note_url': 'https://www.xiaohongshu.com/explore/66aced99000000002701c00e?xsec_token=ABGQKHSS-hUGJC7LNbER4LnZ2fE7cYGW9faTQlR2FmX58=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABGQKHSS-hUGJC7LNbER4LnZ2fE7cYGW9faTQlR2FmX58='}
