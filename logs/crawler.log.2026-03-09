2026-03-09 21:01:51 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69a67a2600000000220337b6', 'type': 'normal', 'title': '火花新数学上了48节课，想说点大实话！', 'desc': '最近火花新数学很火，也确实看到很多博主推荐，我相信很多妈妈和我当初一样，真的很纠结要不要报名。担心它是否真的适合孩子，到底是否和校内同步。我家老二学了半年，现在想给大家分享一下真实感受。\n.\n🔴学习情况：\n我们是四年级上学期开始学的，已经上了半年多，前几天刚续课。\n.\n🔴学习结果：\n孩子自己还挺喜欢，直播、动画结合学习内容，互动性很强，小班更有学习课堂氛围，孩子能跟着老师的节奏。\n.\n🔴其实火花新数学的基因就是小班，确实抓孩子注意力还是有点东西在的，课程内容结合新课标大纲来的，我们是人教版，进度一致。再有就是这个新数学里面会有新加坡数学的内容，数形结合，孩子容易理解。\n.\n🔴火花新数学怎么上？\n8-12人线上小班直播，一周2次，一次50分钟左右\n.\n🔴火花新数学价格怎么样？\n我们是买的半年的，2000多块钱，算下来一节课60多，具体我给忘了。确实相比之前的课程划算很多\n.\n🔴一定要注意的：\n✅课程适合6-12岁孩子上，如果大中小班感觉不合适\n✅选课前一定要试听后再定，不要盲目选择，适合孩子的就是最好的！\n#思维培养[话题]# #思维训练[话题]# #数学思维[话题]#  #火花新数学[话题]# #小学数学[话题]# #数学思维[话题]#', 'video_url': '', 'time': 1772518902000, 'last_update_time': 1772517926000, 'user_id': '60c0d344000000000100a268', 'nickname': '晨晨妈育儿记', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31lnmh60ql26g5o60qd2098j8ksbi8j0', 'liked_count': '167', 'collected_count': '50', 'comment_count': '24', 'share_count': '1', 'ip_location': '广东', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603092100/39bef79d7b6053b6edfd2ba69e022da9/notes_pre_post/1040g3k831t88jdvb6edg5o60qd2098j8dr1r3f8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603092100/3957704aa72ad3b11b1210b3b8558388/notes_pre_post/1040g3k831t88jdvb6ed05o60qd2098j856f6e40!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603092100/4b00a24fc7a3ae577527288c46c59085/notes_pre_post/1040g3k831t88jdvb6ebg5o60qd2098j8lf9d3vg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603092100/848f4362ec0259b11c8cf0d8dce79414/notes_pre_post/1040g3k831t88jdvb6ec05o60qd2098j84t4tlio!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603092100/9be6a4894a1dd06bb6d7e6c5535c5a1c/notes_pre_post/1040g3k831t88jdvb6ecg5o60qd2098j81bv4cs8!nd_dft_wlteh_webp_3', 'tag_list': '思维培养,思维训练,数学思维,火花新数学,小学数学', 'last_modify_ts': 1773061311808, 'note_url': 'https://www.xiaohongshu.com/explore/69a67a2600000000220337b6?xsec_token=ABEbRHKcmYM8vdAXRq_VIoa4_UKeRtnT7Kx-rT115m80Q=&xsec_source=pc_search', 'source_keyword': '#小学数学   #小学计算 #数学网课 #陪读经验   #提前学 #数学超前学', 'xsec_token': 'ABEbRHKcmYM8vdAXRq_VIoa4_UKeRtnT7Kx-rT115m80Q='}
