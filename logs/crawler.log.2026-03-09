2026-03-09 20:06:26 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '686f62d4000000002203d739', 'type': 'video', 'title': '1年纪开学做学霸，0基础搞定计算有套路', 'desc': '开学第一关就是计算，抓住暑假前 30 天黄金期真的太重要了‼，希望学「30 天魔法计算课」亲测有效！无痛搞定计算，娃学完超自信～\n✨为啥选这课？师资太能打！\n➡️学而思资深大S主讲，《摩比爱数学》主稿人杨景羽老师亲授。鲸鱼老师超懂孩子，教得高效又有趣！\n✅️动画儿歌学原理：凑十歌编成编程动画，孩子一看就懂，追着要学太省心！\n✅️高阶巧算思维全掌握：，凑十法 / 破十法只是基础！拆数凑十、分组凑十、同尾数相减...\n✅️6 种规律秘籍 + 趣味应用：排队问题 / 代换推理 / 扑克游戏...边玩边学逻辑思维跟着蹭蹭涨，不止会算题！\n⏰轻松学不费妈\n每天半小时，碎片时间就能学，随时看回放，不耽误暑假看世界，班主任 1v1 答疑，问题秒解决\n🎁配套超贴心\n天天练 + 周周测练习册（紧贴新课标），定期检测 + 提前适应小学节奏~家长不用费心找资料，省心到家\n暑假带娃看世界的同时，每天半小时就能悄悄拔尖，准备上一年级的娃赶紧冲\n\t\n\ufeff#学习规划[话题]#\ufeff\xa0\ufeff#希望学[话题]#\ufeff\xa0\ufeff#希望学网校[话题]#\ufeff\xa0\ufeff#网课[话题]#\ufeff\xa0\ufeff#学习APP推荐[话题]#\ufeff\xa0\ufeff#孩子喜欢希望学[话题]#\ufeff\xa0\ufeff#辅导班[话题]#\ufeff#幼小衔接[话题]# #幼儿园[话题]# #数学启蒙[话题]#', 'video_url': 'http://sns-video-al.xhscdn.com/stream/79/110/259/01e870791a8249950103700397f775e3e5_259.mp4', 'time': 1752292138000, 'last_update_time': 1752846418000, 'user_id': '65afbd0b000000000d03f04f', 'nickname': '陪午崽打怪兽', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo30u9bql9nle6g5pdfnk5jfs2f5s2q4o0', 'liked_count': '610', 'collected_count': '331', 'comment_count': '14', 'share_count': '7', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603092004/b61f10f303b88cb2c0c4c09bdba6b43d/1040g2sg31k34emkmigi05pdfnk5jfs2fj7kdat8!nd_dft_wlteh_webp_3', 'tag_list': '学习规划,希望学,希望学网校,网课,学习APP推荐,孩子喜欢希望学,辅导班,幼小衔接,幼儿园,数学启蒙', 'last_modify_ts': 1773057986310, 'note_url': 'https://www.xiaohongshu.com/explore/686f62d4000000002203d739?xsec_token=AB395XXHVbMqmiHbiKYnFV9nDeQaIudL7lgty9J9nncsQ=&xsec_source=pc_search', 'source_keyword': '#小学数学   #小学计算 #数学网课 #陪读经验   #提前学 #数学超前学', 'xsec_token': 'AB395XXHVbMqmiHbiKYnFV9nDeQaIudL7lgty9J9nncsQ='}
