2026-03-09 16:16:40 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '66a9dc68000000002701f9b3', 'type': 'normal', 'title': '5-12专属❗SparkMath新加坡数学直播免费听', 'desc': '只会在题海战术里狼狈挣扎😵\n不懂改变思路循序渐进扎实提升怎么行❓\n家有数渣娃的别再靠刷题死磕数学啦😭\n💡想要轻松搞定数学还得是数学思维逻辑培养先行\n-\n🔥让孩子越学越上瘾的SparkMath新加坡数学\n✔学会建模，将复杂问题化繁为简\n✔激发兴趣，把枯燥的公式变成直观的图像\n✔双语教学，英语➕数学两手抓\n✔个性化学习，及时按能力调整，满足不同学习能力范围的成长\n✔覆盖全球大部分主流赛事知识点，夯基础抓提高两不误\n✔中西结合学习，20种思维方法内容深度、广度、高度齐头并进\n✔资深教师E＆M双修，名校师资、拥有丰富国际化数学授课经验\n-\n💻上课形式：在线小班直播课\n💬授课语言：全英/双语/中文\n-\n🎁试听大礼包包括\n🎈 1节在线思维直播课\n🎈 12节数独趣味课\n🎈 小学速算巧算训练营课\n-\n现在点击图片下方⬇ 【立即领取】就可以免费体验哦\n⏰ 活动时间：即日起—2024年12月31日\n*课程面向海外人群（18岁以上）\n#新加坡数学[话题]#\xa0\xa0#新加坡数学网课[话题]#\xa0\xa0#新加坡数学建模[话题]#\xa0\xa0#新加坡数学补习[话题]#\xa0\xa0#新加坡数学竞赛[话题]#\xa0\xa0#新加坡数学应用题[话题]#\xa0\xa0#新加坡数学思维[话题]#\xa0\xa0#新加坡数学课[话题]#\xa0\xa0#新加坡数学课程[话题]#\xa0\xa0#新加坡数学老师[话题]#\xa0\xa0#新加坡数学教材[话题]#\xa0\xa0#新加坡数学英文[话题]#\xa0\xa0#新加坡数学cpa[话题]#\xa0\xa0#sparkmath新加坡数学[话题]#\xa0\xa0#小学数学[话题]#\xa0\xa0#数学思维[话题]#\xa0\xa0#数学直播课[话题]#', 'video_url': '', 'time': 1722408040000, 'last_update_time': 1722408041000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '', 'collected_count': '2', 'comment_count': '', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603091616/5b9cfd0e481e9204e9e7a231e9f53fb4/spectrum/1040g34o315tiaftsgo005olhcu8lbcmao8jf1kg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603091616/674b478cfa6288828f77f97ee841193e/spectrum/1040g0k0315tiahpi0q005olhcu8lbcma3jiabmg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603091616/762dc250b9dca22cea92addeea4a3614/spectrum/1040g0k0315tiaje10m005olhcu8lbcmaf902ps8!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学,新加坡数学网课,新加坡数学建模,新加坡数学补习,新加坡数学竞赛,新加坡数学应用题,新加坡数学思维,新加坡数学课,新加坡数学课程,新加坡数学老师,新加坡数学教材,新加坡数学英文,新加坡数学cpa,sparkmath新加坡数学,小学数学,数学思维,数学直播课', 'last_modify_ts': 1773044200073, 'note_url': 'https://www.xia