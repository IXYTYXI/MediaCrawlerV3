_pre_post/1040g3k031k07s9cuj4i05n7imb6hamh58glodn0!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/2b3ad9e2451a54b6b7e05473ecf7fcb9/notes_pre_post/1040g3k031k07s9cuj4i05n7imb6hamh58glodn0!nd_dft_wlteh_webp_3'}], 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092012/3ae27761e550584048a1955b467f7051/notes_pre_post/1040g3k031k07s9cuj4i05n7imb6hamh58glodn0!nd_prv_wlteh_webp_3'}, {'trace_id': '', 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092012/e885fb0cf3f30154db27f5a6533046e8/notes_pre_post/1040g3k031k07s9cuj4eg5n7imb6hamh5ev7chpg!nd_prv_wlteh_webp_3', 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092012/855d23f1b75e7d2853b1dbfbe2f4598c/notes_pre_post/1040g3k031k07s9cuj4eg5n7imb6hamh5ev7chpg!nd_dft_wlteh_webp_3', 'live_photo': False, 'file_id': '', 'height': 1611, 'width': 741, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/855d23f1b75e7d2853b1dbfbe2f4598c/notes_pre_post/1040g3k031k07s9cuj4eg5n7imb6hamh5ev7chpg!nd_dft_wlteh_webp_3', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/e885fb0cf3f30154db27f5a6533046e8/notes_pre_post/1040g3k031k07s9cuj4eg5n7imb6hamh5ev7chpg!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/855d23f1b75e7d2853b1dbfbe2f4598c/notes_pre_post/1040g3k031k07s9cuj4eg5n7imb6hamh5ev7chpg!nd_dft_wlteh_webp_3'}], 'stream': {}}], 'at_user_list': [], 'share_info': {'un_share': False}, 'note_id': '68775b000000000023005ee9', 'xsec_token': 'ABfJZBmbHlMr-zAfDgCgOGicrAVVBEbeC5c7H6c2k1B8E=', 'xsec_source': None}, {'tag_list': [{'id': '610160dd000000000100b9d9', 'name': '小学数学', 'type': 'topic'}, {'name': '数学计算', 'type': 'topic', 'id': '5d3fa829000000000d025b0e'}, {'id': '5be3f4505b18e80001167d7c', 'name': '数学', 'type': 'topic'}, {'name': '超前学数学', 'type': 'topic', 'id': '64792def00000000250245ce'}], 'at_user_list': [], 'time': 1730957787000, 'note_id': '672c51db000000001b029729', 'title': '数学| 小学计算超前学~~~', 'desc': '🎊🎊🎊计算是数学的基石，小学低年级可以选择不鸡奥数，但是计算一定要拔高。可以超前校内最少半年的进度，如果孩子能力足够，把小学的计算尽快拉一遍也是可行的。但是一定要注意的是不能盲目硬拉，要把底层算理给娃讲清楚。\n\t\n我分享的是小学计算的模块分类表，这种专题化比较有利于构建孩子完整的知识树。每一部分的内容在各类教材里都有对应，比如天天练、洋葱数学都可以找到对应的视频，还有高思也是有对应的章节。\n\t\n因为数学教材，全国版本太多，大家可以结合自己地区的教材选择进度，只要至少提前半年以上就行。计算早一点学可以让孩子多练习，计算练习的多速度和正确率就一定会上去的。\n\t\n计算想要学好，无他，唯手熟尔！\n\t\n#小学数学[话题]#\xa0\xa0#数学计算[话题]#\xa0\xa0#数学[话题]#\xa0\xa0#超前学数学[话题]#', 'interact_info': {'collected_count': '120', 'comment_count': '20', 'share_count': '5', 'followed': False, 'relation': 'none', 'liked': False, 'liked_count': '102', 'collected': False}, 'image_list': [{'file_id': '', 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092012/245a2799c249ecaeb56829dbb1c90315/spectrum/1040g34o319suouvlmq0g413t9nce9itvbf1o10g!nd_prv_wlteh_webp_3', 'stream': {}, 'live_photo': False, 'height': 1706, 'width': 1280, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/7140291f6cacdb1b8c75482b58873eed/spectrum/1040g34o319suouvlmq0g413t9nce9itvbf1o10g!nd_dft_wlteh_webp_3', 'trace_id': '', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/245a2799c249ecaeb56829dbb1c90315/spectrum/1040g34o319suouvlmq0g413t9nce9itvbf1o10g!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/7140291f6cacdb1b8c75482b58873eed/spectrum/1040g34o319suouvlmq0g413t9nce9itvbf1o10g!nd_dft_wlteh_webp_3'}], 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092012/7140291f6cacdb1b8c75482b58873eed/spectrum/1040g34o319suouvlmq0g413t9nce9itvbf1o10g!nd_dft_wlteh_webp_3'}, {'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092012/7fb57f90e81192618c797558bd1982ea/spectrum/1040g0k0319sup19b6q00413t9nce9itvrt6k9lo!nd_prv_wlteh_webp_3', 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092012/3666ae5eab951d3cfa282beb3bee9a3b/spectrum/1040g0k0319sup19b6q00413t9nce9itvrt6k9lo!nd_dft_wlteh_webp_3', 'height': 1706, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092012/3666ae5eab951d3cfa282beb3bee9a3