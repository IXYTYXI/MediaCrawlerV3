b55fbd4ff1220b7ab9b00f/1040g00831svmrm8l68805pifuu30u508snguj10!nd_dft_wlteh_webp_3', 'trace_id': '', 'info_list': [{'url': 'http://sns-webpic-qc.xhscdn.com/202603092052/b632b9b926c16c5501f997e2f0d415e3/1040g00831svmrm8l68805pifuu30u508snguj10!nd_prv_wlteh_webp_3', 'image_scene': 'WB_PRV'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092052/39016334a6b55fbd4ff1220b7ab9b00f/1040g00831svmrm8l68805pifuu30u508snguj10!nd_dft_wlteh_webp_3'}], 'height': 2560, 'width': 1920, 'stream': {}}], 'at_user_list': [], 'title': '❗老师发的预习要求，一下数学课课贴超省心✨', 'desc': '谁懂一年级数学辅导的苦😫！娃认平面/立体图形懵、算20以内退位减慢，100以内数的组成越讲越乱，我嘴瓢他还听不懂…直到挖到这份一年级下册数学必背笔记课课贴！这份课课贴超省心✨：\n📚给平面/立体图形配图标区分，20以内退位减附“破十法口诀”，100以内数的组成列数位规则，娃看一眼就会，不用死记硬背~\n📅按认识平面图形、20以内退位减、100以内数的认识、数量间的加减关系等单元打包考点，每课重点用颜色标明白，5分钟就能过一个单元，不用翻厚书！\n📚七巧板组成、百数表规律全列成条，娃能对着贴子自主练，我终于不用追着问“这题咋算”~老母亲偷偷乐开花👍\n#一年级数学[话题]# #一年级数学下册[话题]#  #课课贴[话题]# #元角分换算[话题]# #一年级数学公式[话题]# #20以内退位减法[话题]# #一年级数学预习[话题]# #一年级课课贴[话题]# #一年级数学重点[话题]# #一年级数学必背知识点[话题]#', 'tag_list': [{'id': '5c19cb6600000000030093d1', 'name': '一年级数学', 'type': 'topic'}, {'id': '5e1ca99d000000000100be8e', 'name': '一年级数学下册', 'type': 'topic'}, {'name': '课课贴', 'type': 'topic', 'id': '64a50be6000000003701ba31'}, {'id': '61095019000000000100a432', 'name': '元角分换算', 'type': 'topic'}, {'type': 'topic', 'id': '601d08e5000000000101c0ac', 'name': '一年级数学公式'}, {'id': '62ef9b8900000000010030e4', 'name': '20以内退位减法', 'type': 'topic'}, {'id': '621f080b0000000001000abb', 'name': '一年级数学预习', 'type': 'topic'}, {'id': '64e4082a000000001a017700', 'name': '一年级课课贴', 'type': 'topic'}, {'id': '5e510eb500000000010091c3', 'name': '一年级数学重点', 'type': 'topic'}, {'id': '6527ce9c000000002a006c9e', 'name': '一年级数学必背知识点', 'type': 'topic'}], 'time': 1770806506000, 'ip_location': '江苏', 'xsec_token': 'AB71YXlRyfmM0lLCkLy5SFcQyoPdDeqDM4oLHw8EsMa2E=', 'xsec_source': None}, {'ip_location': '湖南', 'share_info': {'un_share': False}, 'note_id': '68b5db7c000000001d01a550', 'title': '小学怎么提前学初中数学', 'desc': '多年积累的小升初数学体系分享\n\t\n蓝色：计算模块\n绿色：几何模块\n黄色：函数模块\n橙色：跟着学校同步学\n\t\n1、知识点每日记忆\n2、同步练习用真题，一阶二阶题正确率达标过关\n3、每日 10分钟计算专题，定期更换专题，全对过关\n4、用本校真题考题考题，100/95分过关\n5、错题巩固\n\t\n#数学老师[话题]#  #小升初数学[话题]# #数学提前学[话题]#', 'tag_list': [{'id': '5cb80a54000000000f02c3eb', 'name': '数学老师', 'type': 'topic'}, {'id': '5cd788ba000000000e038faf', 'name': '小升初数学', 'type': 'topic'}, {'id': '645fb4dc000000001f0157fa', 'name': '数学提前学', 'type': 'topic'}], 'at_user_list': [], 'time': 1756748668000, 'last_update_time': 1772701245000, 'type': 'normal', 'user': {'user_id': '6839db9d000000001d01503c', 'nickname': '数学谭老师', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31rm23ok72g6g5q1preenak1sgm7qdlo', 'xsec_token': 'ABiGzmtEo6uHY_w8tcHgKXtucyRK1nd4kZSRGWU3UGcGI='}, 'interact_info': {'share_count': '73', 'followed': False, 'relation': 'none', 'liked': False, 'liked_count': '392', 'collected': False, 'collected_count': '646', 'comment_count': '66'}, 'image_list': [{'trace_id': '', 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092052/c465c13d3b956fc3f47af07fda5253bd/1040g00831lt8sac05e6g5q1preenak1sr76g818!nd_dft_wlteh_webp_3', 'stream': {}, 'file_id': '', 'height': 1600, 'width': 1200, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092052/c465c13d3b956fc3f47af07fda5253bd/1040g00831lt8sac05e6g5q1preenak1sr76g818!nd_dft_wlteh_webp_3', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092052/b602d2222adbe617c5af6a54bf9d7d09/1040g00831lt8sac05e6g5q1preenak1sr76g818!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092052/c465c13d3b956fc3f47af07fda5253bd/1040g00831lt8sac05e6g5q1preenak1sr76g818!nd_dft_wlteh_webp_3'}], 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092052/b602d2222adbe617c5af6a54bf9d7d09/1040g00831lt8sac05e6g5q1preenak1sr76g818!nd_prv_wlteh_webp_3', 'live_photo': False}, {'height': 1716, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092052/72672fc32e612e53e391525100534906/1040g00831lt8sac05e4g5q1preenak1sfrhg1r0!nd