2026-03-09 20:06:04 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '681dcfe3000000002100ef07', 'type': 'normal', 'title': '小学生跟着B站变学霸', 'desc': '今天就把这套【全科B站优质博主】分享给大家，这可都是桃桃亲身验证过，确实有效的！\n-\n🔴语文推荐\n1. 我就是皮皮儿：名著讲解非常清晰，有导读有人物分析，有情节鉴赏，适合搭配精读\n2. 梓墨说语文：阅读和写作方面的内容很全面，很适合打基础和学习各种题型技巧\n3. 白马老师：作文的结构讲解以及素材推荐超实用，孩子跟着系统学习，不愁肚子里没货\n🔴数学推荐\n1. 张齐华：公开课王者，手把手帮孩子梳理公式概念，适合基础不扎实的娃\n2. 数学林老师：拆解常见题型，刷题的时候跟着学方法，效率超高。\n3. 脑王杨易：数学思维讲解得很明白，搭配浅奥练习，娃听完就开窍了。\n🔴英语推荐\n1. 陈君老师：单词讲得细致入微，还会搭配例句和刷题练习，帮助孩子吃透单词。\n2. 英语兔：把单词和语法结合起来巩固，特别适合基础薄弱的孩子。\n3. 平行世界：注重训练听力和口语，想综合提升英语能力的不要错过。\n-\n🔴小四门推荐\n✅地理看羊羊的地理教室：教学风格非常亲切易懂，适合帮助大家快速建立知识框架。\n✅物理看【于总CEO】：适合零基础，通过简单易懂的讲解帮助学生从基础开始积累\n✅生物看【Anne生物】：讲解条理清晰，按照课本内容详细解读知识点，适合预习和复习。\n✅道法看【真人读万物】：适合用来巩固和回顾，在睡前、课间反复听，轻松记忆。\n-\n🎁 自家常看的纪录片\n✅地理：《航拍中国》《河西走廊》\n✅生物：《蓝色星球2》《微观小世界》\n✅历史：《如果国宝会说话》《西汉帝陵》\n✅道法：《故宫100》《国家宝藏》\n-\n🔴最后再提醒一句：B站的学习资源再好，也要形成“看完+输出”的学习闭环！\n\t\n内容来源@桃桃老师在学习 #网课[话题]# #小学生的学习习惯[话题]# #优质课[话题]# #学霸[话题]#', 'video_url': '', 'time': 1746784227000, 'last_update_time': 1746784283000, 'user_id': '5a4abb4411be105ade054ddf', 'nickname': '夏冰蓝蓝', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31gargmoiiq604a0k1dtk8jev7f2lcm0', 'liked_count': '3767', 'collected_count': '6663', 'comment_count': '15', 'share_count': '748', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603092004/5ce3b7515bd4177ad499dc0b17bb8621/1040g00831h8pp2ugji6g4a0k1dtk8jevp3mf98o!nd_dft_wlteh_webp_3', 'tag_list': '网课,小学生的学习习惯,优质课,学霸', 'last_modify_ts': 1773057964995, 'note_url': 'https://www.xiaohongshu.com/explore/681dcfe3000000002100ef07?xsec_token=ABcuD7L6kZX5NRlVpyqgS8VZMABw8zQ8mQiWovkAgl6-Q=&xsec_source=pc_search', 'source_keyword': '#小学数学   #小学计算 #数学网课 #陪读经验   #提前学 #数学超前学', 'xsec_token': 'ABcuD7L6kZX5NRlVpyqgS8VZMABw8zQ8mQiWovkAgl6-Q='}
