m': 0, 'duration': 77634, 'avg_bitrate': 708436, 'audio_channels': 2, 'stream_type': 115, 'width': 1080, 'height': 1920, 'quality_type': 'HD', 'size': 6874844, 'video_duration': 77633, 'audio_codec': 'aac', 'vmaf': -1, 'weight': 70, 'fps': 30, 'rotate': 0, 'hdr_type': 0, 'audio_bitrate': 128193, 'audio_duration': 77622, 'master_url': 'http://sns-video-hs.xhscdn.com/stream/1/110/115/01e979d71e0c2ce2010370019c0403bfcd_115.mp4', 'stream_desc': 'X265_MP4_WEB_115', 'format': 'mp4', 'volume': 0}]}, 'video_id': 137775228440554722, 'video': {'biz_id': '281890417078319524', 'duration': 78, 'md5': '70efeb500266827bd9da303448473b64', 'hdr_type': 0, 'drm_type': 0, 'stream_types': [259, 114, 115], 'biz_name': 110}}, 'image': {'thumbnail_fileid': 'frame/110/0/01e979d71e0c2ce20010000000019c03f1028a_0.webp'}, 'capa': {'duration': 77}}, 'at_user_list': [], 'note_id': '6979d73f00000000220239a4', 'type': 'video', 'title': '五下数学｜第一单元 因数和倍数', 'desc': '#教师备课笔记[话题]# #因数和倍数[话题]# #五年级[话题]# #五年级数学[话题]# #五年级数学下册[话题]#', 'user': {'user_id': '5ca94cd600000000160307b5', 'nickname': '卷心菜的学习笔记', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/5efff63360fa970001c928f8.jpg', 'xsec_token': 'ABg-4pJoZBVjP-zdveVgj49WTPVAb3krxkntYxJGcPxPE='}, 'image_list': [{'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092053/a9c9a30164c987c9a3c6a7633b9cb1a3/1040g00831rslgiuria0g5n599jb5m1tl62jv6dg!nd_dft_wlteh_webp_3', 'live_photo': False, 'file_id': '', 'width': 1080, 'trace_id': '', 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092053/d9e2b48af1553f000be4ad7ee36da6ae/1040g00831rslgiuria0g5n599jb5m1tl62jv6dg!nd_prv_wlteh_webp_3', 'height': 1920, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092053/a9c9a30164c987c9a3c6a7633b9cb1a3/1040g00831rslgiuria0g5n599jb5m1tl62jv6dg!nd_dft_wlteh_webp_3', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092053/d9e2b48af1553f000be4ad7ee36da6ae/1040g00831rslgiuria0g5n599jb5m1tl62jv6dg!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092053/a9c9a30164c987c9a3c6a7633b9cb1a3/1040g00831rslgiuria0g5n599jb5m1tl62jv6dg!nd_dft_wlteh_webp_3'}], 'stream': {}}], 'last_update_time': 1769592639000, 'xsec_token': 'ABLO4WqKDcP6MC3TNLUAAK7XZOvAfklWYYmNURfXXCHt4=', 'xsec_source': None}, {'interact_info': {'liked_count': '300', 'collected': False, 'collected_count': '281', 'comment_count': '7', 'share_count': '5', 'followed': False, 'relation': 'none', 'liked': False}, 'time': 1771725484000, 'last_update_time': 1771144098000, 'share_info': {'un_share': False}, 'title': '三年级开学数学再不怕！从懵圈到拿捏全靠它', 'desc': '.\n最近看冬奥赛场上运动员们摘金夺银，我很感慨！哪有天生赢家，都是日复一日的科学训练+坚持，学习其实也是一样。\n在带着孩子体验了猿辅导数学思维课之后，这种感慨就更强烈了，因为他们把“冠军思维”带入了课堂，不拼蛮力、注重节奏、不盲目卷，科学闭环。每节课都像是一次“热身——冲刺——收尾”的完整训练。[鼓掌R]\n\t\n三年级数学是难度骤然飙升的。我家孩子一开始跟不上，计算速度慢、做题没思路，应用题绕两圈就懵。本质原因在于，难度加大了，但孩子的思维能力没能得到同等提升。我家是在给孩子安排了猿辅导数学思维之后，才算是找对了方向！眼看要开学了，这回娃的数学学习我不用再担心了。[耶R]\n\t\n猿辅导数学思维可以说是“学考同频真课标，即学即练真有效”，今天就来分享下孩子的真实学习感受：\n\t\n⭕紧扣新课标，学本质练思维\n猿辅导完全适配新教材新考法，它让孩子学的是本质，用12个本质模型，解决200+个知识点，不管题型怎么变，孩子都能找出对应模型，一通百通。像我们家最近在学的分数，老师用模型思想和直观的模型工具，教孩子轻松学透了同分母分数加减法。\n⭕真情境真运用，打通高阶思维\n猿辅导注重“真情境”，比如老师会用电池电量图标、运动会接力跑、转盘游戏等孩子熟悉的生活场景，来讲分数，真正的活学活用。运用是数学高阶思维的核心动作，猿辅导把这一点给打通了。讲数学还会融入跨学科知识，像老师用琴谱来讲分数，太有巧思！\n⭕紧贴新教材，所学即所考\n猿辅导数学思维紧扣新教材，课上学的，就是学校考的，娃做的课后题，好几次碰到校内单元测的同类题，那还不拿捏吗？这样学得准练得实，吃透考点太容易。\n⭕学练伴考一体化，学习闭环超完整\n学完马上练，练完有讲解，还有考前策略指导，从知识吸收到巩固运用一气呵成。娃现在上课跟着学方法，下课做针对性练习，知识掌握特别扎实。\n⭕三师课堂，家长彻底解放\n清北名师带领的主讲团队，讲题思路清晰，娃一听就懂；辅导老师全程一对一，课前预习、课中答疑、课后带练；还有AI助教猿小助，课上监督不走神，下课学情反馈再也不用我坐旁边盯着了。\n\t\n现在孩子做题速度翻倍，开学想给娃练思维的，建议试试猿辅导数学思维，现在戳左下角【立即咨询】可以领取试听体验~\n\t\n#猿辅导[话题]# #三年级[话题]# #开学季[话题]#  #小学数学[话题]# #数学思维[话题]# #猿辅导素养课[话题]#  #学会学习稳稳冲金[话题]#', 'user': {'user_id': '5657aab882718c1a885dcedf', 'nickname': '曲奇妈妈', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/674edb536061ff8c2695ec5a.jpg', 'xsec_token': 'ABO9Ik5PleYh4_l28z0U-qqCL06foqsP13qzENCAS6Tt4='}, 'image_list': [{'file_id': '', 'width': 3000, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092053/fda5faabfc60d4f38070adad509f3265/1040g2sg