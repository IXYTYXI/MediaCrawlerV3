f7mr31q0g4a7mfsu5huni9trstk8!nd_dft_wlteh_webp_3', 'image_scene': 'WB_DFT'}]}, {'stream': {}, 'live_photo': False, 'height': 1660, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092011/129d3978b4fc831176ddcf91da9b5b8e/spectrum/1040g0k0312pf7mjpho004a7mfsu5hunisns0lg0!nd_dft_wlteh_webp_3', 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092011/1bec4efb153f68f6f8b6a9e784cc833c/spectrum/1040g0k0312pf7mjpho004a7mfsu5hunisns0lg0!nd_prv_wlteh_webp_3', 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092011/129d3978b4fc831176ddcf91da9b5b8e/spectrum/1040g0k0312pf7mjpho004a7mfsu5hunisns0lg0!nd_dft_wlteh_webp_3', 'file_id': '', 'width': 1245, 'trace_id': '', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092011/1bec4efb153f68f6f8b6a9e784cc833c/spectrum/1040g0k0312pf7mjpho004a7mfsu5hunisns0lg0!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092011/129d3978b4fc831176ddcf91da9b5b8e/spectrum/1040g0k0312pf7mjpho004a7mfsu5hunisns0lg0!nd_dft_wlteh_webp_3'}]}, {'file_id': '', 'height': 1660, 'trace_id': '', 'stream': {}, 'live_photo': False, 'width': 1245, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092011/e2ba1961e9d0ff9fa3cf89cd13efde93/spectrum/1040g0k0312pf7mbvhq004a7mfsu5hunirvlc3b8!nd_dft_wlteh_webp_3', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092011/2a4abee70edb320934a625ad92dea130/spectrum/1040g0k0312pf7mbvhq004a7mfsu5hunirvlc3b8!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092011/e2ba1961e9d0ff9fa3cf89cd13efde93/spectrum/1040g0k0312pf7mbvhq004a7mfsu5hunirvlc3b8!nd_dft_wlteh_webp_3'}], 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092011/2a4abee70edb320934a625ad92dea130/spectrum/1040g0k0312pf7mbvhq004a7mfsu5hunirvlc3b8!nd_prv_wlteh_webp_3', 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092011/e2ba1961e9d0ff9fa3cf89cd13efde93/spectrum/1040g0k0312pf7mbvhq004a7mfsu5hunirvlc3b8!nd_dft_wlteh_webp_3'}], 'xsec_token': 'ABerz8vJxesWnAyM2_gyB9uzCQo1sdLpfJkogVA7lw6fs=', 'xsec_source': None}, {'at_user_list': [], 'time': 1761299477000, 'title': '普娃数学提前学，看看我们都做了什么。', 'desc': '[烟花R][烟花R]前面说我们家四年级，数学提前学到五年级，很多问我是怎么安排的，怎么有时间做这么多。其实只要时间安排好，节约时间，其实普娃提前学也是可以轻松做到的。\n\t\n[一R]课内\n主要暑假会做53这一类的练习提前预习，上学期间学霸或者学霸提优卷。这个是拔高的。基本我们课内上学期间都不用管，基本99-100。\n\t\n[二R]口算\n这个是必须要练的，一般一学期两本，一本口算和三招过关，不要忽视口算，这个非常重要，非常重要‼️\n\t\n[三R]思维拓展\n[烟花R][烟花R]这个我这学期开始是秘籍搭配乐读的课程，我们做到5年级的秘籍后，明显感觉有些章节他自学起来有点困难，因为口语群里的妈妈们推荐，我就报了乐读，上课后，他对原来做的不会的章节，再理解起来容易多了。\n\t\n1）乐读是小班教学。\n也是学而思旗下的，和秘籍算一个系统[偷笑R][偷笑R]，我们刚开始试听了一节课，孩子就很喜欢，老师上课可以有效的调动孩子学习的积极性。\n\t\n2）讲完的知识点实时练习\n上课每讲完例题，都会马上出题让孩子自己做，可以实时了解孩子的掌握情况，不懂的可以马上提出。答了还有金币奖励，孩子积极性得到有效的提高。\n\t\n3）线上课晋升模式\n这个我们家孩子最喜欢，在答题过程中，可以一路从能手晋升到学神。好胜心趋势专注力，会比录播课专注力更好。\n\t\n4）试听前先做线上评估\n试听前先做评估，30分钟15题，然后会推荐学习内容和老师，从A到S+四个等级，乐读是原学而思的老师，课程难度不低，像A+是30%校内70%校外思维。S的话是竞赛的水平，听说还有集训队，不过要上课后，通过选拔才行。根据孩子情况和需求选择。\n\t\n[烟花R][烟花R]很多说感觉我们家做的多，只是因为我们很少上线下课，因为线下课来回送耽误的时间太多，来回接送加上上课时间就4个小时没了，这个我们在家都可以上一节乐读直播课，做3页课课练，一页口算了。提前学的时间是节约出来的，现在孩子的时间都很宝贵，我们要找好方法，找好课程，一直跟着，普娃校内成绩很容易保证的。#乐读[话题]# #乐读小班课效果好[话题]# #原学而思培优[话题]# #期中考试[话题]#  #学习日常[话题]# #学习方法[话题]# #学习规划[话题]# #小学生[话题]#', 'user': {'xsec_token': 'ABP_9sUxa2m2_0Zna3KBQvEJEa5QcA2lmyFwXyd-oeDLU=', 'user_id': '543689d0d6e4a93f3ece97ad', 'nickname': 'Lucy希子', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31ak5qehpna00400bbg4t15td4e21h3o'}, 'image_list': [{'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092011/7b57f5137afc025f48eaa65d6ae4e056/notes_pre_post/1040g3k831o0t2af55mb0400bbg4t15tdtejplvo!nd_dft_wlteh_webp_3', 'width': 3371, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092011/7b57f5137afc025f48eaa65d6ae4e056/notes_pre_post/1040g3k831o0t2af55mb0400bbg4t15tdtejplvo!nd_dft_wlteh_webp_3', 'trace_id': '', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092011/3fb5231faa81aff9a9d86dbe54548825/notes_pre_post/1040g3k831o0t2af55mb0400bbg4t15tdtejplvo!nd_prv_wlteh_webp_3'}, {'image_scene': '