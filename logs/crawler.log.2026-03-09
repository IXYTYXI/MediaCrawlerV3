2026-03-09 16:11:34 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '66cee8aa000000001d03b902', 'type': 'video', 'title': '不夸张🔥偷偷学新加坡数学的孩子赢麻了', 'desc': '⁉️孩子把数学概念背的滚瓜烂熟\n⁉️平时刷T做练习也很积极\n⁉️上课认真听讲、作业也按时完成\n偏偏数学成绩就是上不去😭……\n建议直接给孩子换条路，来🌈Spark Math试试新加坡教学法\n现在点击下方⬇️【立即领取】即刻免费体验直播课✔️\n🥰打破学霸和学渣的壁垒，和差距说拜拜\n-\n为什么选择Spark Math⁉️\n我们以火爆全球的新加坡教学法为基础🔥\n👉采用CPA建模法为核心的教学模式\n通过图形、模型去帮助娃✔️\n💪理清复杂文字间的逻辑关系、分析t目中的数量关系\n将原本抽象复杂的内容变得更加直观形象💯\n在这种教学模式下，娃就能轻松的get到精髓🆘\n同时还不会像传统学习那样感到枯燥无趣🎊\n而且还可以选择双语教学，数学英语两手抓💕\n-\n当然啦，我们的优势可不仅仅只有这些哦\n✅ 9大方式激发学习兴趣\n✅ 12种解题大招，锻炼MATH思维能力\n✅ UDSCSE六步教学法，攻克MATH难关\n✅ 联合专业老师进行授课讲解\n✅ 分阶教学，循序渐进培养综合实力\n-\n试听大礼包包括\n🎈 1节在线思维直播课\n🎈 12节数独趣味课\n🎈 小学速算巧算训练营课\n赶快点击下方⬇【立即领取】免费体验吧\n⏰ 截止时间：2024年12月31日\n*课程面向海外人群\n#新加坡数学[话题]#\xa0\xa0#新加坡数学网课[话题]#\xa0\xa0#新加坡数学建模[话题]#\xa0\xa0#新加坡数学补习[话题]#\xa0\xa0#新加坡数学竞赛[话题]#\xa0\xa0#新加坡数学应用题[话题]#\xa0\xa0#新加坡数学思维[话题]#\xa0\xa0#新加坡数学课[话题]#\xa0\xa0#新加坡数学教材[话题]#\xa0\xa0#新加坡数学课程[话题]#\xa0\xa0#新加坡数学老师[话题]#\xa0\xa0#新加坡数学英文[话题]#\xa0\xa0#新加坡数学cpa[话题]#\xa0\xa0#sparkmath新加坡数学[话题]#\xa0\xa0#开学季[话题]#\xa0\xa0#开学季好物[话题]#\xa0\xa0#开学[话题]#\xa0\xa0#学霸[话题]#\xa0\xa0#鸡娃[话题]#\xa0\xa0#小学数学[话题]#\xa0\xa0#小学数学怎么学[话题]#\xa0\xa0#思维[话题]#', 'video_url': 'http://sns-video-hw.xhscdn.com/stream/110/259/01e6cd7be16e0ffd0103710391983e0da8_259.mp4', 'time': 1724836010000, 'last_update_time': 1724836010000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '191', 'collected_count': '83', 'comment_count': '2', 'share_count': '8', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603091611/e3a88e56de482bdbf70262666392f2ab/spectrum/1040g34o3170bl2di3k005olhcu8lbcmajllmr60!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学,新加坡数学网课,新加坡数学建模,新加坡数学补习,新加坡数学竞赛,新加坡数学应用题,新加坡数学思维,新加坡数学课,新加坡数学教材,新加坡数学课程,新加坡数学老师,新加坡数学英文,新加坡数学cpa,sparkmath新加坡数学,开学季,开学季好物,开学,学霸,鸡娃,小学数学,小学数学怎么学,思维', 'last_modify_ts': 1773043894879, 'note_url': 'http