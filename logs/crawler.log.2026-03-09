2026-03-09 16:05:43 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6718c84d0000000021008808', 'type': 'normal', 'title': '后悔学新加坡数学了 想学的家长都来看看吧', 'desc': '今天接孩子放学，就瞧见那小脸蛋上乐呵呵的🥰\n原来是考试成绩出来了，居然拿了100🔥\n相较于之前在80、90间徘徊不定而言，当真是进步了不少💪💪\n-\n幸好遇见了以新加坡数学为教学基础的🌈Spark Math\n这一年来，亲眼见证了宝贝从原来的\n❌排斥数学、不爱动脑、习惯于依赖别人帮助解决问题\n到现在的\n✔️可以轻松理解更为复杂的数学概念\n✔️遇到难题也不再一筹莫展，而是迅速理清思路、思考对策\n-\n讲实话，现在真的很后悔😭当初怎么没有早点让孩子学新加坡数学\n感兴趣的家长朋友们也别犹豫了\n赶快点击图片下方⬇ 【立即领取】就可以免费试听👏\n✅️课程分为K2-P6七个阶级，对标不同年龄及数学基础的孩子\n✅️每节课40-45min，确保孩子全程注意力集中\n✅️4-6人小班直播教学，互动多，发言多\n✅️强大的师资力量，都是拥有10-20年丰富教学经验的专家\n✅️每节课仅需100+，超高性价比放心选择\n-\n感兴趣的家长直接点击下方⬇️【立即领取】即可0元体验\n⏰ 活动时间：即日起—2025年12月31日\n*课程面向海外人群（18岁以上）\n#新加坡数学[话题]#\xa0\xa0#新加坡数学网课[话题]#\xa0\xa0#新加坡数学建模[话题]#\xa0\xa0#新加坡数学补习[话题]#\xa0\xa0#新加坡数学竞赛[话题]#\xa0\xa0#新加坡数学应用题[话题]#\xa0\xa0#新加坡数学思维[话题]#\xa0\xa0#新加坡数学课程[话题]#\xa0\xa0#新加坡数学老师[话题]#\xa0\xa0#新加坡数学课[话题]#\xa0\xa0#新加坡数学教材[话题]#\xa0\xa0#新加坡数学英文[话题]#\xa0\xa0#新加坡数学cpa[话题]#\xa0\xa0#sparkmath新加坡数学[话题]#\xa0\xa0#小学数学[话题]#\xa0\xa0#小学数学怎么学[话题]#', 'video_url': '', 'time': 1729677389000, 'last_update_time': 1729677390000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '2', 'collected_count': '2', 'comment_count': '1', 'share_count': '2', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603091605/4c69d5b7a4a130a6bce5909249c76fdc/spectrum/1040g0k03199skugkkm005olhcu8lbcma382kh78!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603091605/a16d3bd5038666429bdf98af803173bd/spectrum/1040g0k03199sksit4i005olhcu8lbcmabmp09ig!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603091605/e38e8670542b3c403870bd0e20be9c11/spectrum/1040g34o3199skvp54m0g5olhcu8lbcmakunic90!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学,新加坡数学网课,新加坡数学建模,新加坡数学补习,新加坡数学竞赛,新加坡数学应用题,新加坡数学思维,新加坡数学课程,新加坡数学老师,新加坡数学课,新加坡数学教材,新加坡数学英文,新加坡数学cpa,sparkmath新加坡数学,小学数学,小学数学怎么学', 'last_modify_ts': 1773043543995, 'note_url': 'https://www.xiaohongshu.com/explore/6718c84d0000000021008808?xsec_token=ABc2LwhVx5RUu-XSFvXWLM-l0nqmdsXo5JUbVUS-4nZwY=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABc2LwhVx5RUu-XSFvXWLM-l0nqmdsXo5JUbVUS-4nZwY='}
