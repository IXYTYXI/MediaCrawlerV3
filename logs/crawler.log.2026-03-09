2026-03-09 23:05:09 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68b5c46c000000001d02092e', 'type': 'normal', 'title': '小学简便计算', 'desc': '#简便计算[话题]# #小学数学思维训练[话题]#\n[一R]观察题目当中的数字，能否凑整。例如看到199，想到199=200-1   看到88，想到88=8x11\n[二R]答题过程中，一定要保证上面式子等于下面的式子，有理有据，不能凭感觉', 'video_url': '', 'time': 1756742764000, 'last_update_time': 1756742764000, 'user_id': '68a6765a000000001900fa54', 'nickname': '财来来', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/645b7c0d1d74d41345e61461.jpg', 'liked_count': '59', 'collected_count': '1', 'comment_count': '15', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603092302/c6773896c637bafda2f7ac6daac536c7/notes_pre_post/1040g3k031lt6a7n85i005q56epd69uikk46hm7g!nd_dft_wlteh_jpg_3', 'tag_list': '简便计算,小学数学思维训练', 'last_modify_ts': 1773068709372, 'note_url': 'https://www.xiaohongshu.com/explore/68b5c46c000000001d02092e?xsec_token=ABpgs4rSoOA5ZSLbDGUBPuOWN-fnucEXq2_YB90SwDQZA=&xsec_source=pc_search', 'source_keyword': '#小学数学   #小学计算 #数学网课 #陪读经验   #提前学 #数学超前学', 'xsec_token': 'ABpgs4rSoOA5ZSLbDGUBPuOWN-fnucEXq2_YB90SwDQZA='}
