.xhscdn.com/202603092303/19fca741bf68e15c79856c54dfae28b3/oss-sg/notes/1040g3l031tdtvmv14a5g5qcnftnpgd2d0biqkc0!nd_prv_wlteh_jpg_3', 'stream': {}}], 'at_user_list': [], 'time': 1772898902000, 'last_update_time': 1772898902000, 'ip_location': '海南', 'share_info': {'un_share': False}, 'type': 'normal', 'desc': '#小学奥数[话题]# #思维训练[话题]# #趣味数学[话题]# #锻炼思维能力[话题]# #小学数学易错题[话题]# #开始动脑吧[话题]# #数字[话题]#', 'user': {'user_id': '69977f6f000000002600344d', 'nickname': '小红薯69988F6A', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31srhpfq15g105qcnftnpgd2d9qab9eg', 'xsec_token': 'AB_X3JVRevSt9cteYX45p6zuaY0zILesFvjUrsILYIO9k='}, 'interact_info': {'collected_count': '16', 'comment_count': '71', 'share_count': '3', 'followed': False, 'relation': 'none', 'liked': False, 'liked_count': '44', 'collected': False}, 'tag_list': [{'id': '5c087775fdeaef0001938997', 'name': '小学奥数', 'type': 'topic'}, {'type': 'topic', 'id': '5c3eeae3000000000e003284', 'name': '思维训练'}, {'id': '5d74ad82000000000103d085', 'name': '趣味数学', 'type': 'topic'}, {'id': '61e2b924000000000101e77d', 'name': '锻炼思维能力', 'type': 'topic'}, {'type': 'topic', 'id': '5f7adf1900000000010053a6', 'name': '小学数学易错题'}, {'id': '66382be0000000001b03d4f3', 'name': '开始动脑吧', 'type': 'topic'}, {'id': '5c358bc7000000000d0209cd', 'name': '数字', 'type': 'topic'}], 'note_id': '69ac4a56000000002b00d762', 'title': '', 'xsec_source': None}, {'xsec_token': 'ABv6CTVw482NUeCf2AmzvDehZPTRGzbBGFPmLXj4X4SoI=', 'type': 'normal', 'user': {'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31a667iak72005ponash7ed6uk7691sg', 'xsec_token': 'AB4FnvlOJ5M9Y_iKzkFODM0Fxhx8pVbtkDZyJTOXx_ZiU=', 'user_id': '67175722000000001d0334de', 'nickname': 'Kaiv凯威老师爱数学'}, 'tag_list': [{'id': '5be3f4505b18e80001167d7c', 'name': '数学', 'type': 'topic'}, {'id': '5c7c0488000000000e02ffa2', 'name': '补课', 'type': 'topic'}, {'id': '5f22afcf0000000001003163', 'name': '补课班', 'type': 'topic'}, {'type': 'topic', 'id': '5be15176c4f7a10001c763cc', 'name': '教育'}], 'share_info': {'un_share': False}, 'note_id': '67a9bf0a000000001800d0bc', 'desc': '新收了一个初三孩子，还有4个月马上中考。\n\t\n信息上和妈妈了解了孩子基本情况，\n孩子常年数学垫底，在家没有主动性，作业基本没法做；\n请过很多补习班，发现没什么用都停了。\n\t\n见到人以前还在想，\n是不是因为叛逆，或者不喜欢，导致不想学。\n\t\n见到人，简单了解后很意外，孩子表示很想学好；\n于是简单测试，发现分数加减，大于小于号都不太熟，\n经验上大概已有概念，于是问孩子，\n\t\n“你从几年级开始觉得自己脱节了”。\n\t\n孩子想了想，答：“六年级下”。\n\t\n“脱节后上课听不懂开始睡，作业不会写只能操，回到家试着看了看书，发现看不懂就不看了，去了补习班也听不懂…”\n\t\n一晃2年半过去了，家里人紧张了。\n\t\n接下来就是系统的制定方案和规划。\n\t\n经常和妈妈们聊，\n想学好，想轻松，补课和超前属实是必须且无奈。\n\t\n大班课，注定了孩子们面对知识，一会看得懂一会看不懂；\n具体由每个孩子当天精气神，对知识的天赋而定。\n\t\n补课，\n解决孩子因精神状态，上课不专注，理解力没跟上而错过的知识点。\n\t\n超前学，\n解决孩子因知识过于陌生，导致的困惑和压力，提前学，孩子课上再看到“新”知识，反而会兴奋。\n\t\n补课+超前学很好的弥补了大班课的短板，最大程度防止孩子学习脱节。\n\t\n总结，\n高压和快节奏的教育环境下，大班课只能关注到面，落实到个人，需要关注个体的情绪，状态；\n补课补的是丢失的细节，没涉及到的短板，防止孩子因跟不上而脱节；\n补课可以不来自老师，也可以是父母，只要关注到个体细节成长都行；\n想学好切勿放手，能自学的几乎寥寥无几。\n#数学[话题]##补课[话题]# #补课班[话题]# #教育[话题]#', 'interact_info': {'liked': False, 'liked_count': '44', 'collected': False, 'collected_count': '55', 'comment_count': '14', 'share_count': '12', 'followed': False, 'relation': 'none'}, 'image_list': [{'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092303/75602fed261ea8bdc2ce9bb682c6ccf3/1040g00831dneq1150u005ponash7ed6uoj819t0!nd_dft_wgth_jpg_3', 'stream': {}, 'file_id': '', 'height': 3024, 'width': 4032, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092303/75602fed261ea8bdc2ce9bb682c6ccf3/1040g00831dneq1150u005ponash7ed6uoj819t0!nd_dft_wgth_jpg_3', 'trace_id': '', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092303/f9651732ec9ac981fcf6ebe1be79d2d0/1040g00831dneq1150u005ponash7ed6uoj819t0!nd_prv_wgth_jpg_3'}, {'url': 'http://sns-webpic-qc.xhscdn.com/202603092303/75602fed261ea8bdc2ce9bb682c6ccf3/1040g00831dneq1150u005ponash7ed6uoj819t0!nd_dft_wgth_jpg_3', 'image_scene': 'WB_DFT'}], 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092303/f9651732ec9ac981fcf6ebe1be79d2d0/1040g00831dneq1150u005ponash7ed6uoj819t0!nd_prv_wgth_jpg_3', 'live_photo': False}, {'url': 'http://sns-webpic-qc.xhscdn.com/202603092303/764a56f2924c7bb0b637b942bfb742c0/1040g00831dneq1150u0g5ponash7ed6upjadlco!nd_dft_wgth_jpg_3', 'trace_id': '', 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092303/d9a477a45b0b027d3dce3f0c851b8b22/1040g00831dneq1150u0g5ponash7ed6upjadlco!nd_prv_wgth_jpg_3', 'live_photo': False, 'file_id': '', 'height': 908, 'width': 1284, 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092303/d9a477a45b0b027d3dce3f0c851b8b22/1040g00831dneq1150u0g5ponash7ed6upjadlco!nd_prv_wgth_jpg_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092303/764a56f2924c7bb0b637b942bfb742c0/1040g00831dneq1150u0g5ponash7ed6upjadlco!nd_dft_wgth_jpg_3'}], 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092303/764a56f2924c7bb0b637b942bfb742c0/1040g00831dneq1150u0g5ponash7ed6upjadlco!nd_dft_wgth_jpg_3', 'stream': {}}], 'at_user_list': [], 'time': 1739177738000, 'last_update_time': 1739177850000, 'title': '作为数学老师，谈谈补课和超前学的意义', 'xsec_source': None}, {'xsec_token': 'ABdfLH9auy1h4Ifi_-ouBlTlhr6dYTdTZi5k6k7KxwKv0=', 'type': 'normal', 'title': '数学老师是怎么帮自己孩子选网课的（无广告', 'user': {'user_id': '68aea15d0000000019012bbd', 'nickname': '说数学的乐爸', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31lm7ldou5m605q5ek5emaatt6tr5oh8', 'xsec_token': 'ABEpNfJalhZVLs1q_35wmV6X-EtQV_Qr2QdOdaaBP6xVY='}, 'tag_list': [{'id': '5c7a5ce6000000000f016c8e', 'name': '数学思维', 'type': 'topic'}, {'name': '学习习惯', 'type': 'topic', 'id': '5c94ed5e000000000e0373ad'}, {'type': 'topic', 'id': '5bf562735fb4e60001b3aee3', 'name': '网课'}, {'type': 'topic', 'id': '5c851312000000000f00a3bf', 'name': '学习规划'}, {'id': '610160dd000000000100b9d9', 'name': '小学数学', 'type': 'topic'}, {'id': '5c32300d0000000009015088', 'name': '寒假逆袭', 'type': 'topic'}, {'name': '期末复习', 'type': 'topic', 'id': '5bf004879e1dec00018a2452'}, {'id': '5c1c9873000000000801e02b', 'name': '期末考试', 'type': 'topic'}], 'last_update_time': 1766333899000, 'share_info': {'un_share': False}, 'note_id': '69481dca000000001e00efff', 'desc': '越来越临近寒假期末，我发现小红书上关于数学网课的广告越来越多。\n\t\n分享作为数学老师，我当初给自己孩子选择网课的时候，考虑了哪些维度？\n\t\n在这里不打广告，只说方法。如果大家有好的推荐，也可以在评论区分享。\n\t\n#数学思维[话题]# #学习习惯[话题]# #网课[话题]#  #学习规划[话题]# #小学数学[话题]# #寒假逆袭[话题]# #期末复习[话题]# #期末考试[话题]#', 'interact_info': {'comment_count': '23', 'share_count': '7', 'followed': False, 'relation': 'none', 'liked': False, 'liked_count': '41', 'collected': False, 'collected_count': '52'}, 'image_list': [{'file_id': '', 'height': 2400, 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092303/8b35c8ac1820dd1608772554d6ea81dd/1040g00831qc3nrcvn06g5q5ek5emaatt5mcpgh8!nd_dft_wlteh_jpg_3', 'stream': {}, 'live_photo': False, 'width': 1440, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092303/8b35c8ac1820dd1608772554d6ea81dd/1040g00831qc3nrcvn06g5q5ek5emaatt5mcpgh8!nd_dft_wlteh_jpg_3', 'trace_id': '', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092303/e481b0f269c77fa4438d1c3442d92833/1040g00831qc3nrcvn06g5q5ek5emaatt5mcpgh8!nd_prv_wlteh_jpg_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092303/8b35c8ac1820dd1608772554d6ea81dd/1040g00831qc3nrcvn06g5q5ek5emaatt5mcpgh8!nd_dft_wlteh_jpg_3'}], 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092303/e481b0f269c77fa4438d1c3442d92833/1040g00831qc3nrcvn06g5q5ek5emaatt5mcpgh8!nd_prv_wlteh_jpg_3'}, {'file_id': '', 'height': 2400, 'width': 1440, 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092303/10793ca4b08edd77993f794ebc9505e5/1040g00831qc3nrcvn00g5q5ek5emaatt5oethu8!nd_prv_wlteh_jpg_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092303/158eecb6659faaabbf9f5e2ae2a5289d/1040g00831qc3nrcvn00g5q5ek5emaatt5oethu8!nd_dft_wlteh_jpg_3'}], 'stream': {}, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092303/158eecb6659faaabbf9f5e2ae2a5289d/1040g00831qc3nrcvn00g5q5ek5emaatt5oethu8!nd_dft_wlteh_jpg_3', 'trace_id': '', 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092303/10793ca4b08edd77993f79