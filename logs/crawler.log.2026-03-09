2026-03-09 16:13:16 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '66c87118000000001d039f26', 'type': 'normal', 'title': '🌟 火花思维荣登全球教育科技Top50榜单 🌟', 'desc': '🎓 教育革新，科技领航！《时代》杂志携手 Statista，首次发布2024年全球顶尖教育科技公司榜单，我们自豪地宣布：火花思维荣获全球第41名，中国教育科技领域排名第7位！\n🌏 这份榜单汇聚了全球250家最具创新力和影响力的教育科技公司，我们凭借卓越的实力、行业影响力和技术服务水平，脱颖而出。\n再次给大家介绍一下，我们Spark Math 是火花集团旗下的项目，针对孩子数学培优和竞赛培养。\n🚀 作为中国教育科技的佼佼者，我们将继续以创新驱动教育，用科技赋能未来，与全球教育科技巨头共同推动教育行业的变革与发展。\n🌈 试听可评论区留言\n课程面向海外用户\n#新加坡数学[话题]# #火花思维[话题]# #时代杂志[话题]# #新加坡数学网课[话题]# #新加坡数学建模[话题]# #新加坡cpa数学教学法[话题]# #sparkmath新加坡数学[话题]# #教育[话题]# #新加坡数学思维[话题]# #新加坡数学教材[话题]#', 'video_url': '', 'time': 1724412184000, 'last_update_time': 1724412185000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '', 'collected_count': '', 'comment_count': '', 'share_count': '2', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603091613/4281c94ee243a888c3336c325dc2d136/1040g008316re1jkuk4005olhcu8lbcmaggeg2fo!nd_dft_wlteh_webp_3', 'tag_list': '新加坡数学,火花思维,时代杂志,新加坡数学网课,新加坡数学建模,新加坡cpa数学教学法,sparkmath新加坡数学,教育,新加坡数学思维,新加坡数学教材', 'last_modify_ts': 1773043996430, 'note_url': 'https://www.xiaohongshu.com/explore/66c87118000000001d039f26?xsec_token=ABCzIrg56mu7_TNiLq52Nv8zJLKwm0IqQfucIUTDD3Iq8=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABCzIrg56mu7_TNiLq52Nv8zJLKwm0IqQfucIUTDD3Iq8='}
