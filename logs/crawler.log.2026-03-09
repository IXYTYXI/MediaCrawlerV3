wlteh_webp_3'}]}], 'tag_list': [{'id': '610160dd000000000100b9d9', 'name': '小学数学', 'type': 'topic'}, {'name': '数学思维', 'type': 'topic', 'id': '5c7a5ce6000000000f016c8e'}, {'id': '5e64b4160000000001004df9', 'name': '计算技巧', 'type': 'topic'}, {'name': '速算', 'type': 'topic', 'id': '5c7eccdf000000000d007632'}], 'note_id': '67f64788000000001d005b15', 'type': 'video', 'title': '分享一个学霸的计算技巧', 'at_user_list': [], 'time': 1744193416000, 'last_update_time': 1744193417000, 'xsec_token': 'AB3UJ3SgXjkJz9uIeUItR-y4m3QN3y_C0HUPSDMJiDZFI=', 'xsec_source': None}, {'last_update_time': 1768533201000, 'note_id': '6969acd0000000002200a343', 'type': 'video', 'desc': '多年的教育实践证明\n没有学不好的孩子\n只有不适合的方法\nCPA教学法的最大优势\n在于它的个性化适应性\n进度个性化\n根据孩子的实际水平\n调整C-P-A各阶段进度\n确保每个孩子都能跟上\n方法个性化\n针对不同学习风格\n提供多种学习方法\n找到最适合的思维路径\n目标个性化\n基于孩子的能力特点\n设定合理的学习目标\n在成功中建立自信\n无论孩子现在数学水平如何\nCPA教学法都能帮助他\n找到最适合的学习路径\n释放数学潜能\n获得学习成功\n\t\nMathplore新加坡数学采用科学的CPA教学法\n专门针对5-12岁孩子提升数学思维的小班直播课：\n💁动画+故事+游戏+高频互动，提升专注力，让每个孩子都有表现机会\n💁有中教和欧美外教，英文班、中文班灵活选择\n💁紧跟校内重难点知识，同时拓展到竞赛相关的知识，基于新加坡和美国顶尖小学数学教材研发标准\n💁小班直播课（2-6人），40-50min一节\n💁师资力量强大，教研团队成员均有10-20年教学或教研经验，很多授课老师还是竞赛金牌教练\n-\n不管是给孩子数学思维提升，还是助力提升数学成绩，都超合适！\n🔥现在点击头像进入直播间，即可领取试听名额～\n课程领取活动时间：即日起至2026年12月31日\n*课程面向海外18+人群\n#mathplore新加坡数学[话题]# #数学思维[话题]# #小学数学[话题]# #让孩子爱上数学[话题]# #提升孩子思维能力[话题]# #逻辑思维[话题]# #思维训练[话题]# #孩子爱上学习[话题]#', 'interact_info': {'liked_count': '74', 'collected': False, 'collected_count': '112', 'comment_count': '2', 'share_count': '33', 'followed': False, 'relation': 'none', 'liked': False}, 'tag_list': [{'id': '65f7d555000000000202612e', 'name': 'mathplore新加坡数学', 'type': 'topic'}, {'id': '5c7a5ce6000000000f016c8e', 'name': '数学思维', 'type': 'topic'}, {'id': '610160dd000000000100b9d9', 'name': '小学数学', 'type': 'topic'}, {'id': '623d83f30000000001002ed8', 'name': '让孩子爱上数学', 'type': 'topic'}, {'name': '提升孩子思维能力', 'type': 'topic', 'id': '629ddc1d00000000010083f1'}, {'name': '逻辑思维', 'type': 'topic', 'id': '57ee65c9faa05212bb083f8f'}, {'id': '5c3eeae3000000000e003284', 'name': '思维训练'