-qc.xhscdn.com/202603092303/c2f990df56c70b8f48524086ed4d1310/1040g00831qc3nrcvn0405q5ek5emaatt8l6hva8!nd_prv_wlteh_jpg_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092303/643e52a5216ee3bc36e12f72d365ebb5/1040g00831qc3nrcvn0405q5ek5emaatt8l6hva8!nd_dft_wlteh_jpg_3'}], 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092303/c2f990df56c70b8f48524086ed4d1310/1040g00831qc3nrcvn0405q5ek5emaatt8l6hva8!nd_prv_wlteh_jpg_3', 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092303/643e52a5216ee3bc36e12f72d365ebb5/1040g00831qc3nrcvn0405q5ek5emaatt8l6hva8!nd_dft_wlteh_jpg_3', 'file_id': '', 'height': 2400, 'trace_id': '', 'stream': {}, 'live_photo': False}, {'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092303/6cb8d5ea44692324f31f543a0ee71ea3/1040g00831qc3nrcvn04g5q5ek5emaatts863mi0!nd_dft_wlteh_jpg_3', 'stream': {}, 'live_photo': False, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092303/6cb8d5ea44692324f31f543a0ee71ea3/1040g00831qc3nrcvn04g5q5ek5emaatts863mi0!nd_dft_wlteh_jpg_3', 'trace_id': '', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092303/b1969d538ebf07f149162d81eb0398c3/1040g00831qc3nrcvn04g5q5ek5emaatts863mi0!nd_prv_wlteh_jpg_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092303/6cb8d5ea44692324f31f543a0ee71ea3/1040g00831qc3nrcvn04g5q5ek5emaatts863mi0!nd_dft_wlteh_jpg_3'}], 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092303/b1969d538ebf07f149162d81eb0398c3/1040g00831qc3nrcvn04g5q5ek5emaatts863mi0!nd_prv_wlteh_jpg_3', 'file_id': '', 'height': 2400, 'width': 1440}, {'width': 1440, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092303/465f996530cab3512f135b4a8905d37b/1040g00831qc3nrcvn0505q5ek5emaattmh6n488!nd_dft_wlteh_jpg_3', 'trace_id': '', 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092303/9b842af691ac12233a48a9d3b14ae6ba/1040g00831qc3nrcvn0505q5ek5emaattmh6n488!nd_prv_wlteh_jpg_3', 'stream': {}, 'live_photo': False, 'height': 2400, 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092303/9b842af691ac12233a48a9d3b14ae6ba/1040g00831qc3nrcvn0505q5ek5emaattmh6n488!nd_prv_wlteh_jpg_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092303/465f996530cab3512f135b4a8905d37b/1040g00831qc3nrcvn0505q5ek5emaattmh6n488!nd_dft_wlteh_jpg_3'}], 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092303/465f996530cab3512f135b4a8905d37b/1040g00831qc3nrcvn0505q5ek5emaattmh6n488!nd_dft_wlteh_jpg_3', 'file_id': ''}], 'at_user_list': [], 'time': 1766362681000, 'xsec_source': None}, {'desc': '独立老师||数学其实很简单\n作为一名小学数学老师，大学毕业后一直在公立小学任教，拥有12年经验，带过大循环，对于各个层次的学生都具有丰富的教学经验，在现在的校内学习模式下，我对不同层次的学生提出如下建议:\n一.以课本为主，吃透教材\n1.必须掌握课本上的概念、公式。这是重要的基础，可以自己整理知识点，抄写默写→以巩固+理解。\n2.课本中每一个例题，练习题要反复做。把书中的题目全部从头弄懂。\n二、死磕计算能力(得计算者，得天下)\n1.每天花10分钟左右时间练习，数量不求多，但要求计时。\n2.读题要细心，要看完整题目，一步一步做，保证准确性，不必过分追求速度。\n三.圈画关键字或词\n1.边读题边画关键字词，加深对题目的理解。有助于理清思路，避免漏掉关键信息。\n四.整理错题本\n1.把错题进行分类整理\n2.错因对症下药，做到查漏补缺并养成好习惯，好的数学的学习方法。\n五.坚持使用草稿本\n1.草稿本一定要认真书写，按题号标记清楚，可试试画格分区法，便于后面检查。\n六.书写规范\n1.格式、单位.作答要规范，避免不必要的扣分。\n2.书写不规范，字体不清楚，数位不对齐，很可能对的题被误判。\n七、养成检查的习惯\n1.查漏题\n2.查数字和符号是否抄错。\n3.再次精算一遍结果\n4.检查单位和答是否\n八.定时复习\n1.每天作业前先复习，及时巩固提高对题率。\n1.注意小结，每学完一个知识点，就要把概念，公式。例题，错题完整的复习一遍。\n2.定时复习可查缺补漏，及时调整。\n\t\n调整 #小学数学老师[话题]#   #数学[话题]#   #小学数学[话题]#   #学习[话题]#   #独立老师[话题]#   #数学老师[话题]#   #数学其实很简单[话题]#   #教育[话题]#   #家长[话题]#', 'user': {'xsec_token': 'ABReGXKtMKYvmt0JWXuPHStcmnqpLDlqZ_5THh5kX08jE=', 'user_id': '5b9c8021ba0d4c0001cb0416', 'nickname': '杨老师儿', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31p2qdfaoio004b069k02210m966mef0'}, 'tag_list': [{'id': '5e7820aa0000000001000897', 'name': '小学数学老师', 'type': 'topic'}, {'id': '5be3f4505b18e80001167d7c', 'name': '数学', 'type': 'topic'}, {'name': '小学数学', 'type': 'topic', 'id': '610160dd000000000100b9d9'}, {'id': '5be289a7b6aad100012b8f50', 'name': '学习', 'type': 'topic'}, {'id': '6112533100000000010022c1', 'name': '独立老师', 'type': 'topic'}, {'id': '5cb80a54000000000f02c3eb', 'name': '数学老师', 'type': 'topic'}, {'type': 'topic', 'id': '6109577c000000000101e7f4', 'name': '数学其实很简单'}, {'name': '教育', 'type': 'topic', 'id': '5be15176c4f7a10001c763cc'}, {'name': '家长', 'type': 'topic', 'id': '5cd626ff000000000d03fd53'}], 'at_user_list': [], 'time': 1734617524000, 'last_update_time': 1734617619000, 'note_id': '676429b4000000000900c7ec', 'type': 'normal', 'title': '独立老师||数学其实很简单', 'interact_info': {'liked_count': '38', 'collected': False, 'collected_count': '41', 'comment_count': '29', 'share_count': '10', 'followed': False, 'relation': 'none', 'liked': False}, 'image_list': [{'url': 'http://sns-webpic-qc.xhscdn.com/202603092303/d731700e7c2f3ae4eed1565bd4cdb94b/1040g00831bjganme0m004b069k02210m5obq7u0!nd_dft_wlteh_webp_3', 'trace_id': '', 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092303/d731700e7c2f3ae4eed1565bd4cdb94b/1040g00831bjganme0m004b069k02210m5obq7u0!nd_dft_wlteh_webp_3', 'stream': {}, 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092303/f34d8e8ae77c79a4e20547413d91e9ce/1040g00831bjganme0m004b069k02210m5obq7u0!nd_prv_wlteh_webp_3', 'live_photo': False, 'file_id': '', 'height': 1080, 'width': 756, 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092303/f34d8e8ae77c79a4e20547413d91e9ce/1040g00831bjganme0m004b069k02210m5obq7u0!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092303/d731700e7c2f3ae4eed1565bd4cdb94b/1040g00831bjganme0m004b069k02210m5obq7u0!nd_dft_wlteh_webp_3'}]}], 'share_info': {'un_share': False}, 'xsec_token': 'ABvx3tUXd0Lv4atKYY-IcVgDtPd8q4CLrR-JCL1CtjflE=', 'xsec_source': None}, {'xsec_token': 'ABtXZAV9Zn1ejd9CcKX5kRhygmbQwtT_KA_Mhh3BUyWIg=', 'type': 'normal', 'desc': '#小学数学思维训练[话题]# #数学[话题]# #小学奥数[话题]# #重庆[话题]# #小学生作业[话题]# #数学思维[话题]#', 'image_list': [{'file_id': '', 'width': 3000, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092303/a2190c3a33cda1a65e919ed5ad10af10/notes_pre_post/1040g3k031jje8rrrj06g5pthjk7j92roio3e83o!