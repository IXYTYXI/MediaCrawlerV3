2026-03-09 21:10:08 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67eba95d000000000b0172c4', 'type': 'normal', 'title': '🚀小学数学6年逆袭指南！', 'desc': '《🚀小学数学6年逆袭指南！90%家长不知道的提分路线图💯》\n✨小学数学绝不是题海战术！6年黄金期精准规划看这里👇\n#小学数学[话题]# #学霸养成[话题]# #育儿经验[话题]# #学习规划[话题]#\n一年级👉【筑基黄金期】\n🔸20以内加减法通关秘诀\n🔸趣味计数游戏培养数感\n🔸每日口算打卡模板分享\n二年级👉【思维起航期】\n✅乘法表花式记忆法\n✅应用题审题3步法\n✅数感训练亲子游戏\n⚠️警惕！这个阶段错题本要开始啦！\n三年级👉【爬坡关键期】\n🔥四则运算速算技巧\n🔥几何入门避坑指南\n🔥错题本升级攻略\n（别让三年级现象毁掉数学兴趣！）\n四年级👉【系统提升期】\n⚡️行程问题图解模板\n⚡️数论思维启蒙路线\n⚡️几何模型大全\n💡这个阶段拉开差距的关键竟然是...\n五年级👉【能力飞跃期】\n🌟分数应用题6大套路\n🌟方程思维转换训练\n🌟归纳演绎专项练习\n（搞定这些难点=初中数学自由！）\n六年级👉【终极冲刺期】\n🚀升学真题高频考点\n🚀七大模块查漏补缺\n🚀小升初衔接指南\n💥最后三个月提分计划表已备好！\n建议收藏⭐️每日对照检查\n👉点击关注，分年级详细规划将持续更新……\n\t\n#乐读报名[话题]# #乐读[话题]# #家长必看[话题]# #学霸秘籍[话题]# #小学数学怎么学[话题]#', 'video_url': '', 'time': 1743497565000, 'last_update_time': 1743497565000, 'user_id': '623b402600000000210298fe', 'nickname': '乐读南京李同杰老师', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo3119a42j16g005ohr80j8d67udq59fj8', 'liked_count': '78', 'collected_count': '68', 'comment_count': '2', 'share_count': '1', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603092108/0f702dd4ac7ea6ac993dd60c38d10fdd/notes_pre_post/1040g3k031fnq9jh6000g5ohr80j8d67uvpci0l8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603092108/1a9a25361e15310e6f89468795f00ec8/notes_pre_post/1040g3k031fnq9jh600105ohr80j8d67u9sdgtd0!nd_dft_wlteh_webp_3', 'tag_list': '小学数学,学霸养成,育儿经验,学习规划,乐读报名,乐读,家长必看,学霸秘籍,小学数学怎么学', 'last_modify_ts': 1773061808119, 'note_url': 'https://www.xiaohongshu.com/explore/67eba95d000000000b0172c4?xsec_token=ABVXrn0KLtq-PZXpi0A05bid0q_4pQ_FNqIm5q6d5tsrM=&xsec_source=pc_search', 'source_keyword': '#小学数学   #小学计算 #数学网课 #陪读经验   #提前学 #数学超前学', 'xsec_token': 'ABVXrn0KLtq-PZXpi0A05bid0q_4pQ_FNqIm5q6d5tsrM='}
