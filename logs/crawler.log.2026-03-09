2026-03-09 20:28:28 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68527ea4000000000b02e3b3', 'type': 'video', 'title': '月考满分，看来数学思维这块我是抓对了！', 'desc': '闺女二年级，数学成绩一直名列前茅，主要是在于培养数学思维，以及解题的思路和表述能力，日常可以这样\n✅计算基础打好\n小学阶段坚持每日练习，计算能力强能缩短每道题目完成时间\n✅不要盲目刷题\n一套每课练+-套单元练足够，刷卷子当然能提高成绩，换来的是孩子对学习的兴趣缺失和亲子关系的恶化，从长远来看，得不偿失\n✅重视数学思维\n比起背套路，小学阶段建立起逻辑思维和数学思维的孩子才能学的更轻松\n\t\n像我家孩子就一直在上希望学的数学课程，孩子一直很喜欢上，老师讲课方式简单易懂，一起来跟着校长妈妈看看吧！\n#希望学[话题]# #孩子喜欢希望学[话题]# #希望学网校[话题]# #网课[话题]# #学习APP推荐[话题]# #补课[话题]# #希望学小学[话题]# #日常学习[话题]##小学生的日常[话题]#', 'video_url': 'http://sns-video-al.xhscdn.com/stream/1/110/259/01e8527e96063e4601037003978240a438_259.mp4', 'time': 1750239765000, 'last_update_time': 1750236836000, 'user_id': '6285ca31000000002102b24b', 'nickname': '校长妈妈是超人', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31bsj9l8p085g5ok5p8oodcibhk2fegg', 'liked_count': '5304', 'collected_count': '3221', 'comment_count': '19', 'share_count': '13', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603092026/bafa820314d7af9d85c976fec7fc53d0/1040g00831is45jccgm0g5ok5p8oodcib0mq0im0!nd_dft_wlteh_webp_3', 'tag_list': '希望学,孩子喜欢希望学,希望学网校,网课,学习APP推荐,补课,希望学小学,日常学习,小学生的日常', 'last_modify_ts': 1773059308685, 'note_url': 'https://www.xiaohongshu.com/explore/68527ea4000000000b02e3b3?xsec_token=ABvkySJR7d2jkpdmA69FhrguqVpF12Uv-U7JDM0lenJb4=&xsec_source=pc_search', 'source_keyword': '#小学数学   #小学计算 #数学网课 #陪读经验   #提前学 #数学超前学', 'xsec_token': 'ABvkySJR7d2jkpdmA69FhrguqVpF12Uv-U7JDM0lenJb4='}
