08317u8e8duk4005pgt4naiu6lsalm8ing!nd_dft_wlteh_webp_3'}], 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092035/157be97f4a49dd8b3f4bdb32c202be55/1040g008317u8e8duk4005pgt4naiu6lsalm8ing!nd_prv_wlteh_webp_3', 'file_id': '', 'height': 2337, 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092035/51192113a2f66ce3da5aae4a18b89436/1040g008317u8e8duk4005pgt4naiu6lsalm8ing!nd_dft_wlteh_webp_3'}, {'width': 1653, 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092035/8cd50def3812b1048e51ef111f9cb6ef/1040g008317u8e8duk4205pgt4naiu6ls8ta4je0!nd_prv_wlteh_webp_3', 'file_id': '', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092035/6fe10d61b40d0905ef8345597f040604/1040g008317u8e8duk4205pgt4naiu6ls8ta4je0!nd_dft_wlteh_webp_3', 'trace_id': '', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092035/8cd50def3812b1048e51ef111f9cb6ef/1040g008317u8e8duk4205pgt4naiu6ls8ta4je0!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092035/6fe10d61b40d0905ef8345597f040604/1040g008317u8e8duk4205pgt4naiu6ls8ta4je0!nd_dft_wlteh_webp_3'}], 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092035/6fe10d61b40d0905ef8345597f040604/1040g008317u8e8duk4205pgt4naiu6ls8ta4je0!nd_dft_wlteh_webp_3', 'stream': {}, 'live_photo': False, 'height': 2337}], 'tag_list': [{'id': '5f8a3bc7000000000100a614', 'name': '四年级上册数学', 'type': 'topic'}, {'id': '5fe436000000000001003263', 'name': '竖式计算', 'type': 'topic'}, {'name': '竖式计算题', 'type': 'topic', 'id': '62de1e870000000001004522'}, {'id': '65daf9340000000002018543', 'name': '竖式计算天天练', 'type': 'topic'}, {'id': '6143cbb100000000010040ae', 'name': '四上数学', 'type': 'topic'}, {'type': 'topic', 'id': '5d4c25f000000000170236c8', 'name': '四年级数学'}, {'id': '62b2443b0000000001000ca1', 'name': '四年级上册数学计算', 'type': 'topic'}], 'at_user_list': [], 'interact_info': {'collected': False, 'collected_count': '1202', 'comment_count': '114', 'share_count': '557', 'followed': False, 'relation': 'none', 'liked': False, 'liked_count': '1737'}, 'last_update_time': 1726749243000, 'share_info': {'un_share': False}, 'note_id': '66ec1a3b000000000c019183', 'title': '快存‼️四年级上册数学重点竖式计算500题', 'desc': '孩子老师说四年级最重要的计算就是竖式计算，马上给孩子安排上，计算能力是数学最基础的，每天练5分钟，计算再也不用愁啦[偷笑R]\n#四年级上册数学[话题]# #竖式计算[话题]# #竖式计算题[话题]# #竖式计算天天练[话题]# #四上数学[话题]# #四年级数学[话题]# #四年级上册数学计算[话题]#', 'user': {'xsec_token': 'ABwJxowwcdb4Pt3PAaIOQ4OeIqeOjNt15AkMbnr92jVx0=', 'user_id': '661d25d5000000000b031abc', 'nickname': '小熊🐻', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo317cr4bvqju6g5pgt4naiu6lsvc7hdc8'}, 'xsec_token': 'ABDOM-mTKkEVcZ3Fl4-JNDfzegqdNkxNbYQ2oJgLmG-aQ=', 'xsec_source': None}, {'interact_info': {'liked': False, 'liked_count': '1695', 'collected': False, 'collected_count': '2129', 'comment_count': '431', 'share_count': '303', 'followed': False, 'relation': 'none'}, 'at_user_list': [], 'time': 1729480704000, 'last_update_time': 1729480705000, 'type': 'normal', 'title': '四年级普娃，数学不刷题，照样可以全班第一', 'desc': '提到数学，绝大部分家长，对娃最大的期待，就两个字：开窍！\n.\n家有四年级普娃一枚，从小就英语好、数学差。一开始我觉得是老师不行，于是找了补习。后面怀疑娃不够努力，于是逼着他疯狂刷题。\n.\n结果呢，钱没少花，题没少刷，数学还是原地踏步，老母亲那叫一个愁！后面静下心来复盘，发现娃数学不好，核心原因有下面几点👇\n.\n1⃣长期被打击，失去兴趣，甚至产生恐惧。\n2⃣长期被动接受知识，一直在不停地听课、赶作业，没有时间动脑筋思考。\n3⃣长期刷题背模板大招，都是一时爽，只要题目灵活一点，普娃就被打回原形。\n.\n于是，我为豆丁专门打造了一套学习方案，心理战和实操站双管齐下👇\n.\n1⃣对数学没兴趣，有抵触情绪\n🔸家长给予正反馈，引导娃主动做好学习规划。先定一个切实可行的小目标，比如计算题全对，完成后鼓励孩子继续前行。\n🔸通过看动画片，培养数理兴趣。推荐：《怪物数学小分队》《数学荒岛历险记》\n2⃣基础知识薄弱，概念不清晰\n🔸回归课本，按照概念-公式-定理-例题的顺序，逐项进行排雷，用费曼学习法，让娃当小老师给你讲。\n🔸预习一定要抓起来，每周2次，阅读课本，尝试推导公式、做练习，不会做没关系，上课重点听。\n3⃣计算能力差，做题粗心马虎\n🔸每天雷打不动1道口算＋10道笔算，限时训练。\n🔸审题要慢，做题要快。学会在读题的时候勾画数字、已知条件等关键词，找到思路后再动笔。\n4⃣上课一听就会，练习一做就错。\n🔸错题整理：遇到错题要先标记，找到错因，完成自我订正，把正确的解答步骤写在旁边。\n🔸思维训练：普娃上课能听懂，但是遇到应用题就没有思路。不是因为娃天赋差，而是没有通过思考，养成数学思维，所以不会举一反三。\n⭐从豆丁三年级开始，我就在带他做数理思维训练。一开始是学奥数，但是难度太大，普娃不适合，所以改成了线上的思维打卡。每周2次，清华老师带练，培养底层的数感、逻辑推理和空间图形等数理思维能力。\n⭐每天完成打卡，开始做浅奥练习，比课内难一点点，但是完全不脱离。坚持了一个学期，豆丁进步超级大，整个的思维一打开，数学就开窍了，做难题也有思路。\n.\n🌈都说三年级是道坎儿，四年级是个坡。但其实只要咱们抓好基础、思维和计算，娃数学的问题就不大，打好基础，以后也会很轻松。\n\t\n#数理思维[话题]# #数学[话题]# #四年级[话题]# #三年级[话题]# #数学思维[话题]# #思维[话题]# #思维训练[话题]# #五年级[话题]# #期中[话题]# #数学启蒙这样做[话题]#', 'user': {'user_id': '65713cca0000000020031d5b', 'nickname': '婷婷老师的教育日记', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31qfbehl9g0605pbh7j5867armdplu80', 'xsec_token': 'ABUAU5uuZCR-wgQSZKkpkVWAV0hjwgvmNBndB2pLFKgkI='}, 'share_info': {'un_share': False}, 'note_id': '6715c800000000001b03c467', 'image_list': [{'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092035/a3858e9a247373d38f7e65ef7e7a34fb/1040g2sg3196ut2hdla605pbh7j5867arnhhbq0g!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092035/e42416fc594c54c1d4d493ee3a027e7d/1040g2sg3196ut2hdla605pbh7j5867arnhhbq0g!nd_dft_wlteh_webp_3'}], 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092035/e42416fc594c54c1d4d493ee3a027e7d/1040g2sg3196ut2hdla605pbh7j5867arnhhbq0g!nd_dft_wlteh_webp_3', 'file_id': '', 'height': 2560, 'width': 1920, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092035/e42416fc594c54c1d4d493ee3a027e7d/1040g2sg3196ut2hdla605pbh7j5867arnhhbq0g!nd_dft_wlteh_webp_3', 'trace_id': '', 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092035/a3858e9a247373d38f7e65ef7e7a34fb/1040g2sg3196ut2hdla605pbh7j5867arnhhbq0g!nd_prv_wlteh_webp_3', 'stream': {}, 'live_photo': False}], 'tag_list': [{'id': '602cd5f5000000000100bda7', 'name': '数理思维', 'type': 'topic'}, {'type': 'topic', 'id': '5be3f4505b18e80001167d7c', 'name': '数学'}, {'type': 'topic', 'id': '5e721e0b000000000100b07b', 'name': '四年级'}, {'id': '5da1db6e000000000103ebf7', 'name': '三年级', 'type': 'topic'}, {'type': 'topic', 'id': '5c7a5ce6000000000f016c8e', 'name': '数学思维'}, {'id': '5bef711cffd6080001bf91ef', 'name': '思维', 'type': 'topic'}, {'id': '5c3eeae3000000000e003284', 'name': '思维训练', 'type': 'topic'}, {'id': '5e0dbf990000000001006809', 'name': '五年级', 'type': 'topic'}, {'id': '5caf2dbc000000000e003078', 'name': '期中', 'type': 'topic'}, {'id': '5ce69bbb000000000d03d645', 'name': '数学启蒙这样做', 'type': 'topic'}], 'xsec_token': 'ABjeVWbNA7dRqwkvDlx-9V6N_rL8rkoO2AKCNVwPUZmNA=', 'xsec_source': None}, {'note_id': '61ca5e86000000002103e9c9', 'title': '小学数学必背的16大知识要点（一）', 'desc': '数学老师反复强调：小学数学根本就不用报什么辅导班。课本的基础知识吃透，多做口算和四则混合运算，解决问题举一反三。\n家有小学生的存下这些知识点吧,汇集了1—6年级所学的重点公式,吃透不用去补习班。#孩子教育[话题]# #小学数学[话题]# #数学[话题]# #小学数学怎么学[话题]#', 'user': {'user_id': '5f64177b000000000100b593', 'nickname': 'ginkgo30', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo318equnmv3u5g5nr42ttg9dcj4clf5no', 'xsec_token': 'ABHqaUzHL9uo1QvIEzYMzGyIjgprhI708rpmpTiQ6QPyI='}, 'interact_info': {'liked': False, 'liked_count': '1687', 'collected': False, 'collected_count': '1749', 'comment_count': '14', 'share_count': '223', 'followed': False, 'relation': 'none'}, 'last_update_time': 1640652423000, 'type': 'normal', 'image_list': [{'width': 1242, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092035/cae4bde71770ce3821503bf51e332746/ae03f3c8-82e6-3f63-a9e5-a99b8814d492!nd_dft_wlteh_webp_3', 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092035/2398303fdae5b6764c9cee46701ecbdd/ae03f3c8-82e6-3f63-a9e5-a99b8814d492!nd_prv_wlteh_webp_3', 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092035/cae4bde71770ce3821503bf51e332746/ae03f3c8-82e6-3f63-a9e5-a99b8814d492!nd_dft_wlteh_webp_3', 'stream': {}, 'live_photo': False, 'file_id': '', 'height': 1655, 'trace_id': '', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092035/2398303fdae5b6764c9cee46701ecbdd/ae03f3c8-82e6-3f63-a9e5-a99b8814d492!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092035/cae4bde71770ce3821503bf51e332746/ae03f3c8-82e6-3f63-a9e5-a99b8814d492!nd_dft_wlteh_webp_3'}]}, {'stream': {}, 'file_id': '', 'height': 1655, 'trace_id': '', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092035/f1acc3278b08274e6f160fd1c3f9b568/dc441efd-d060-3647-bafa-5e52d89a3a7e!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http