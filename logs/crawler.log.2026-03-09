-qc.xhscdn.com/202603092107/aa3e0f1cb4ba3c38da4d9c2e45ae3eff/1040g2sg31ccuomv80k5g5n7imb6hamh5nn6gabo!nd_prv_wlteh_webp_3', 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092107/bfcc9d8ceb15d5a94da6c85e4417c9c0/1040g2sg31ccuomv80k5g5n7imb6hamh5nn6gabo!nd_dft_wlteh_webp_3', 'stream': {}, 'live_photo': False, 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092107/aa3e0f1cb4ba3c38da4d9c2e45ae3eff/1040g2sg31ccuomv80k5g5n7imb6hamh5nn6gabo!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092107/bfcc9d8ceb15d5a94da6c85e4417c9c0/1040g2sg31ccuomv80k5g5n7imb6hamh5nn6gabo!nd_dft_wlteh_webp_3'}]}], 'tag_list': [{'id': '6318123a00000000010067ce', 'name': '小学数学超前学', 'type': 'topic'}], 'at_user_list': [], 'time': 1736325522000, 'type': 'normal', 'share_info': {'un_share': False}, 'desc': '#小学数学超前学[话题]#\n为什么小学数学提前学了一学期成绩还是不好？这几天很多家长在跟我讨论这个问题。\n今天讨论一下其中主要一个问题点:超前学已经认真学习并且掌握扎实了知识点，孩子依然不能考高分，还能不能继续超前学？\n[一R]先说答案，这种情况是应该坚定的继续超前学。\n因为就算进行超前学，短期内是没办法解决孩子计算，应用变式，超纲难度运用知识点运用的问题。\n还有的孩子专注力不足，经常漏题、跳题。一个数从上抄到下都会抄错。这些都是超前学无法解决的问题。\n[二R]超前学的目标一定是瞄准高考，不要因为小学几次绩的波动就开始质疑。小学数学题刷得再多做得再深，在高中层面看几乎完全没用。所以不要去拼小学的绝对成绩。只要能掌握知识点就ok\n[三R]一直坚持超前学。不论是普娃还是牛娃，都可以有效的分摊初高中阶段的学业压力。\n[四R]对于专注力差，不断重复犯错的孩子。因为多巴胺受体浓度降低，大脑接收的多巴胺信号少，减弱大脑额叶皮质的活动，对事物结局的敏感性降，这些孩子需要静待孩子大脑发育。但这些娃的逻辑思维完全正常。通过超前学复杂问题的解决，脑力提升，孩子以前犯错的内容会慢慢减少。比起各种专家推荐的做专项训练，超前学的性价比更高。\n[五R]让孩子自学，坚持，并完成一件对他来讲不容易的大事儿，当有了一两年的积累以后。他会习得一种做事的习惯，甚至变成一种心流。会沉溺其中，不能自拔。对今后人生都有很大帮助。', 'last_update_time': 1736325781000, 'note_id': '677e3992000000000203d869', 'xsec_token': 'ABZGQZ_-c0vaSGNcMp6Fsh7amP8MdP_g60MvVoXSNIEJw=', 'xsec_source': None}, {'note_id': '6909a9c900000000030377b0', 'desc': '朋友的孩子上小学了，上数学课不认真，说自己已经会了[石化R]#幼小衔接[话题]# ##人类幼崽学习日常[话题]#', 'interact_info': {'followed': False, 'relation': 'none', 'liked': False, 'liked_count': '102', 'collected': False, 'collected_count': '104', 'comment_count': '286', 'share_count': '3'}, 'tag_list': [{'name': '幼小衔接', 'type': 'topic', 'id': '5be3f8325b18e8000116f583'}, {'id': '60efafef000000000101d087', 'name': '人类幼崽学习日常', 'type': 'topic'}], 'at_user_list': [], 'type': 'normal', 'title': '超前学了，在学校是不是就没兴趣学？', 'user': {'user_id': '608c072d0000000001008e9d', 'nickname': '宁檬妈妈', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31nimp795mm005o4c0smg93kt5opfo70', 'xsec_token': 'ABSq1L_PESmuexOcwR_TDolLHfQo4it7a6oMnAzL3P3Bg='}, 'image_list': [{'file_id': '', 'width': 1268, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092107/4d63b8b831e0afaecccba2fa6420b38c/notes_pre_post/1040g3k831of43kqelm705o4c0smg93kt8sr934g!nd_dft_wlteh_webp_3', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092107/3df6d9ca32f127871897d78b58793412/notes_pre_post/1040g3k831of43kqelm705o4c0smg93kt8sr934g!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092107/4d63b8b831e0afaecccba2fa6420b38c/notes_pre_post/1040g3k831of43kqelm705o4c0smg93kt8sr934g!nd_dft_wlteh_webp_3'}], 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092107/3df6d9ca32f127871897d78b58793412/notes_pre_post/1040g3k831of43kqelm705o4c0smg93kt8sr934g!nd_prv_wlteh_webp_3', 'stream': {}, 'live_photo': False, 'height': 1691, 'trace_id': '', 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092107/4d63b8b831e0afaecccba2fa6420b38c/notes_pre_post/1040g3k831of43kqelm705o4c0smg93kt8sr934g!nd_dft_wlteh_webp_3'}], 'time': 1762240969000, 'last_update_time': 1762240970000, 'share_info': {'un_share': False}, 'xsec_token': 'ABP7rcvodI0LJlpzrAfyBBg-0pulUsEUUnG-2E2knwMiU=', 'xsec_source': None}, {'note_id': '69a501320000000015039f4a', 'video': {'media': {'video_id': 137822686628580407, 'video': {'duration': 62, 'md5': '7de94a165c353eed04a800c46cb109d9', 'hdr_type': 0, 'drm_type': 0, 'stream_types': [259, 114, 115], 'biz_name': 110, 'biz_id': '281937876245520202'}, 'stream': {'av1': [], 'h264': [{'rotate': 0, 'quality_type': 'HD', 'stream_type': 259, 'volume': 0, 'audio_bitrate': 64131, 'vmaf': -1, 