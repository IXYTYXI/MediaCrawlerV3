9783a2da55_114.mp4', 'http://sns-bak-v6.xhscdn.com/stream/79/110/114/01e852d9287e0ff24f0370019783a2da55_114.mp4'], 'hdr_type': 0, 'video_bitrate': 100505, 'quality_type': 'HD', 'stream_type': 114, 'stream_desc': 'X265_MP4_WEB_114', 'height': 960, 'fps': 30, 'width': 720, 'avg_bitrate': 235175, 'audio_duration': 258320, 'rotate': 0}, {'video_codec': 'hevc', 'rotate': 0, 'vmaf': -1, 'width': 1080, 'video_bitrate': 122712, 'audio_codec': 'aac', 'hdr_type': 0, 'avg_bitrate': 195447, 'fps': 30, 'quality_type': 'HD', 'stream_desc': 'X265_MP4_WEB_130', 'format': 'mp4', 'video_duration': 258300, 'backup_urls': ['http://sns-bak-v1.xhscdn.com/stream/1/110/130/01e852d9287e0ff20103700197842528d0_130.mp4', 'http://sns-bak-v6.xhscdn.com/stream/1/110/130/01e852d9287e0ff20103700197842528d0_130.mp4'], 'stream_type': 130, 'height': 1440, 'duration': 258320, 'audio_bitrate': 64012, 'master_url': 'http://sns-video-al.xhscdn.com/stream/1/110/130/01e852d9287e0ff20103700197842528d0_130.mp4', 'ssim': 0, 'size': 6311014, 'audio_channels': 2, 'psnr': 47.65700149536133, 'weight': 70, 'default_stream': 0, 'volume': 0, 'audio_duration': 258320}], 'h266': [], 'av1': []}}, 'image': {'thumbnail_fileid': '110/0/01e852d9287e0ff20010000000019783a08394_0.webp'}, 'capa': {'duration': 258}}, 'xsec_token': 'ABvkySJR7d2jkpdmA69FhrgpwhzXzZ2pPsXxjEXQNLwCw=', 'xsec_source': None}, {'note_id': '695bb53c000000000e03d054', 'type': 'normal', 'desc': '刚刚收到喜报，yeye数学计算竞赛拿了全级一等奖🏅好多妈妈催我出经验贴，这就把我们从数感到提速的核心方法，毫无保留分享给大家\n一年级的计算，核心是➡️数感建立+方法理解‼️分三步，孩子轻松又扎实：\n·\n1️⃣数感启蒙 · 在生活中“玩”数学\n🔸日常渗透：散步时数电线杆、分水果时算多少，把计算融入生活\n🔸必备工具：百数板、数学积木、扑克牌。通过“找数字邻居”“凑十对战”等游戏，建立对数字的敏感度\n🔸关键基础：熟练掌握10以内数字的拆分与组合（如7可以分成3和4），这是后续所有计算的地基\n·\n2️⃣方法构建 · 理解比算对更重要\n🔸巧用“破十法”：借助小棒或积木，将抽象计算可视化。例如15-8，把15拆成10和5，10减8得2，再加5得7\n🔸善用“数轴法”：在纸上画一条数字线，加法则向前跳，减法则向后跳，帮助孩子理解运算的本质是“移动”\n🔸建立“错题宝典”：将错题整理在一起，定期回顾，和孩子一起分析“当时哪里想岔了”，把薄弱点变成进步点\n·\n3️⃣高效练习 · 重质不重量\n🔸每日“五分钟挑战”：定时不定量，保持专注，记录正确率，让孩子看见自己的进步曲线\n🔸趣味化练习：玩“商店买卖”游戏、用扑克牌玩加减竞赛、选择优质的数学启蒙APP，在游戏中巩固\n🔸竞赛小技巧：平时练习时鼓励“一眼看算式”，比赛时学会用逆向运算快速验算（如加法用减法验算）\n·\n🌈育儿心得：\n计算能力是“练”出来的，但兴趣和信心是“养”出来的。起步阶段，请多鼓励孩子“讲出你的思路”，真诚肯定他的思考过程。速度会随着熟练度自然提升，而保护好那份“我能搞定数学”的自信，才会让他走得更远💙\n·\n#小学数学[话题]# #奖状[话题]# #小学数学思维训练[话题]# #数学[话题]# #数学启蒙[话题]# #一等奖[话题]# #计算竞赛[话题]# #一年级[话题]# #小学生[话题]# #生活中数学[话题]#', 'interact_info': {'liked': False, 'liked_count': '5623', 'collected': False, 'collected_count': '5626', 'comment_count': '61', 'share_count': '948', 'followed': False, 'relation': 'none'}, 'image_list': [{'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092026/9d615d3ba72571d4be81f39ad26e178c/notes_pre_post/1040g3k031rmdtuuqige040uvrjfpe8jj660af68!nd_prv_wlteh_webp_3', 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092026/31f171895ea64ee6d441008c9f2c4c72/notes_pre_post/1040g3k031rmdtuuqige040uvrjfpe8jj660af68!nd_dft_wlteh_webp_3', 'stream': {}, 'file_id': '', 'width': 2858, 'trace_id': '', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092026/9d615d3ba72571d4be81f39ad26e178c/notes_pre_post/1040g3k031rmdtuuqige040uvrjfpe8jj660af68!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092026/31f171895ea64ee6d441008c9f2c4c72/notes_pre_post/1040g3k031rmdtuuqige040uvrjfpe8jj660af68!nd_dft_wlteh_webp_3'}], 'height': 3811, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092026/31f171895ea64ee6d441008c9f2c4c72/notes_pre_post/1040g3k031rmdtuuqige040uvrjfpe8jj660af68!nd_dft_wlteh_webp_3', 'live_photo': False}, {'stream': {}, 'live_photo': False, 'file_id': '', 'height': 3987, 'width': 2990, 'trace_id': '', 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092026/b29c63f2c17203e6aa9b93bd20d9681a/notes_pre_post/1040g3k031rmdtuuqigh040uvrjfpe8jjr49c7og!nd_prv_wlteh_webp_3', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092026/390cfa6d84e306aa283425a6f0637a5a/notes_pre_post/1040g3k031rmdtuuqigh040uvrjfpe8jjr49c7og!nd_dft_wlteh_webp_3', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092026/b29c63f2c17203e6aa9b93bd20d96