2026-03-09 20:13:51 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '6999ce3b000000001a01c8c1', 'type': 'normal', 'title': '我宣布！B站就是普通家庭小学数学的天堂！', 'desc': '当老师这么多年，最愁的就是看自家学生数学卡壳——应用题读三遍不明白，计算题天天抄错数，图形题盯着发呆十分钟……那段时间真把我愁得头发一把把掉��\n\t\n直到在B站挖到这5位神仙老师，搭配我给每个孩子做的专属规划，班里好几个娃直接从70分翻身到95分，家长会上家长都追着问是不是偷偷请了一对一！\n\t\n---\n\t\n一、计算救星——傲德老师\n\t\n这哪是上课啊，简直像看动画片！他把计算题设计成“闯关游戏”，25×4这种题，孩子现在张嘴就是“凑整巧算100”。有个小姑娘以前算题掰手指，现在每天抢着做口算，正确率从60%蹦到90%，她妈跟我说孩子写作业都在哼老师教的“巧算口诀”��\n\t\n---\n\t\n二、应用题克星——数学吴老师\n\t\n最怕读题的娃看过来！吴老师把应用题变成“侦探破案”，比如植树问题，他就讲“小树苗排队做操”，孩子边听边拿笔画线段图。上次有个男生做“鸡兔同笼”，突然冒出一句“这是给小动物抬脚的游戏”，把我都逗乐了——这不就是真懂了嘛！��️\n\t\n---\n\t\n三、图形魔法师——七七老师\n\t\n几何恐惧症有救了！“图形变换法”绝了，讲长方体表面积直接拿礼物盒拆给孩子看。有个学生回家拿鞋盒拆了装、装了拆，第二天来上课说“老师我懂了，就是算六个面的包装纸”！现在他几何作业全是红勾勾，上课抢着上台画图��\n\t\n---\n\t\n四、思维大神——清华潘老师\n\t\n他的“思维三步法”我必须吹爆：读题先问“已知什么”“想求什么”“怎么搭桥”，三步打通任督二脉！一个五年级男生跟着练了半个月，现在看到难题就兴奋：“这题画线段图最好使！”上次月考最后一道思维题，全班就他做对了，数学老师专门给我发微信表扬��\n\t\n---\n\t\n五、基础守护神——小兔老师\n\t\n记不住公式的娃有福了！她把所有口诀编成手势操，“周长公式拍拍手，面积公式跺跺脚”。孩子边跳绳边背乘法口诀，上次计算小测拿了人生第一个100分，举着卷子满教室跑，那嘚瑟劲儿别提多可爱了��\n\t\n---\n\t\n✅【晶晶老师定制版20分钟计划】\n\t\n周一周三周五：计算+应用题\n\t\n周二周四周六：图形+思维\n\t\n周末：趣味数学+错题大扫除\n\t\n小学数学真的不用焦虑！找对老师+跟对规划，孩子越学越上头，咱们当老师的也能早点睡个踏实觉��\n\t\n如果孩子还在数学坑里扑腾，不知道从哪下手，可以来找老师聊聊。约个免费的30分钟学情诊断，我帮你看看是计算有漏洞、还是思维没打通，再给一套专属的“看视频+练能力”方案。方向对了，进步就是水到渠成的事～\n\t\n#数学思维[话题]# #数学学习[话题]#', 'video_url': '', 'time': 1771687483000, 'last_update_time': 1771687484000, 'user_id': '67ed4e22000000000d00b853', 'nickname': '代老师', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31ibe1ndd026g5pvd9oh39e2jipp93no', 'liked_count': '38', 'collected_count': '66', 'comment_count': '9', 'share_count': '16', 'ip_location': '吉林', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603092012/a6675ecb3b629c970dbceb44f5a9b410/1040g2sg31srskomj5kk05pvd9oh39e2j2aln42g!nd_dft_wlteh_webp_3', 'tag_list': '数学思维,数学学习', 'last_modify_ts': 1773058431107, 'note_url': 'https://www.xiaohongshu.com/explore/6999ce3b000000001a01c8c1?xsec_token=ABYfmKSqlC06C2n5M8pgX-IpuZGdv8zozQ_LrRzCMGg8o=&xsec_source=pc_search', 'source_keyword': '#小学数学   #小学计算 #数学网课 #陪读经验   #提前学 #数学超前学', 'xsec_token': 'ABYfmKSqlC06C2n5M8pgX-IpuZGdv8zozQ_LrRzCMGg8o='}
