/sns-video-al.xhscdn.com/stream/79/110/114/01e970a4bb9d4f8a4f0370019be006afe2_114.mp4', 'format': 'mp4', 'avg_bitrate': 851836}, {'audio_duration': 165580, 'hdr_type': 0, 'duration': 165581, 'size': 19038264, 'fps': 30, 'width': 1080, 'video_bitrate': 785155, 'audio_codec': 'aac', 'format': 'mp4', 'volume': 0, 'video_codec': 'hevc', 'audio_channels': 2, 'quality_type': 'HD', 'master_url': 'http://sns-video-al.xhscdn.com/stream/1/110/115/01e970a4bb9d4f8a010370019be00851cf_115.mp4', 'ssim': 0, 'vmaf': -1, 'stream_desc': 'X265_MP4_WEB_115', 'audio_bitrate': 128090, 'rotate': 0, 'backup_urls': ['http://sns-bak-v1.xhscdn.com/stream/1/110/115/01e970a4bb9d4f8a010370019be00851cf_115.mp4', 'http://sns-bak-v6.xhscdn.com/stream/1/110/115/01e970a4bb9d4f8a010370019be00851cf_115.mp4'], 'psnr': 40.362998962402344, 'weight': 70, 'stream_type': 115, 'default_stream': 0, 'height': 1920, 'avg_bitrate': 919828, 'video_duration': 165566}]}}, 'image': {'thumbnail_fileid': 'frame/110/0/01e970a4bb9d4f8a0010000000019be004fe59_0.webp'}, 'capa': {'duration': 165}}, 'tag_list': [{'type': 'topic', 'id': '693a40a000000000240127bf', 'name': '洋葱超前学'}, {'id': '610160dd000000000100b9d9', 'name': '小学数学', 'type': 'topic'}, {'type': 'topic', 'id': '5eec2c7a00000000010031d2', 'name': '家长必读'}, {'id': '5c851312000000000f00a3bf', 'name': '学习规划', 'type': 'topic'}], 'xsec_token': 'AByFGiJdqH3SQ5VcN62194HqymMZOtTys-urzD3k8isMU=', 'xsec_source': None}, {'title': '庆幸自己的坚持：带孩子超前学数学，真香', 'user': {'user_id': '67288ad9000000001d02c712', 'nickname': '禹妈爱学习', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31aukr3me7g005pp8hbcndhoita547q8', 'xsec_token': 'ABviOPx5M6UzJGESxGvCRvJj6JmOCHA7h6oPcbP40z39k='}, 'time': 1733393409000, 'note_id': '67516b3f000000000201a34b', 'desc': '我们是在三升四的暑假，开始决定在家自行安排数学超前学，之前学过一年奥数，效果不好，果断放弃。我们在那个暑假，提前学完了四上的内容，开学后，孩子自己感觉数学上了个大台阶，即便是学校里再学一遍感觉也很爽，之前自学又模棱两可的地方，还有一些他没发现的漏洞，上课跟着老师的思路，也都补上了。后来期中考试的成绩，孩子数学考了全班第一，也算是验证了我们的决定，于是之后我们继续安排进度，现在6上超前学到了初中八年级。\n[彩虹R]我们在家超前学主要用的就是课本+网课+练习册。然后根据学期内容制定周进度。\n[一R]具体的超前学流程就是：先让孩子自己学习课本，新课改之后我发现网上有言论是课本不适合自学，我看过课本发现确实有变化，但是并不影响学习，课本作为学校老师、学生最基础的教学工具，不可能差到哪里去，刷课本是我们的第一步。\n[二R]第二步就是搭配网课视频，我们对比了市面上各种免费的、付费的，最后选择了洋葱，主要有2个因素，之前学奥数孩子被打击的厉害，对数学逐渐失去兴趣，洋葱动画形式，和IP的场景，孩子看的下去，也有兴趣继续学，不会太抵触。一节视频比较短小，对于孩子来说，不会有太大负担。\n[三R]之后就是同步练习，我们家买过53、一遍过、实验班、学霸等等，这些比较热门的教辅，最后小学阶段主要用的是53+学霸。开始准备选实验班，但是超前学本来就有难度跨度，不希望打击孩子的信息，所以果断放弃，选择了简单的五三。\n[有R]一套练习册分2遍来刷：\n[草莓R]第一遍：自学新知识当天，只做每个章节的内容，目的是检验孩子自学的效果。\n[草莓R]第二遍：集中在周末的时候，先把错题过一遍，再做本单元测试卷，对本单元内容进行查漏补缺。\n定期还会穿插月考、期中、期末测试卷，对知识进行巩固，以上做完都没有问题，就可以继续往后推进。\n[爱心R]后面学到初中阶段，教辅有变化，初中知识更注重深耕，同步练习册上选择的是一遍过。\n[四R]越到高年级学习，就越发现错题本真的太重要了，我们家考前或者校内学到同进步的时候，就会把之前自学时候的错题本拿出来看看，记住自己是在哪里出错的，然后带着去听校内老师的课，这样才能知道还有没有遗漏的\n[两颗心R]感悟：超前学的这两年多，感觉我和孩子都成长了不少，对于儿子来说，他已经逐步开始变得独立，自主，而对我来说，我开始逐渐找准自己的位置，超前学的本质是自学，关键点在“自”，这条路的尽头注定只有孩子自己，我只是辅助。#数学超前学[话题]##小学数学[话题]#', 'interact_info': {'liked': False, 'liked_count': '459', 'collected': False, 'collected_count': '856', 'comment_count': '80', 'share_count': '156', 'followed': False, 'relation': 'none'}, 'image_list': [{'height': 2062, 'width': 1170, 'trace_id': '', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092004/7a3665f27b52c68adc8b0d9937855e47/1040g00831b16io4gna005pp8hbcndhoi4nhq8s0!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092004/122ae3d2cc7668be3a30f66c7507cc08/1040g00831b16io4gna005pp8hbcndhoi4nhq8s0!nd_dft_wlteh_webp_3'}], 'live_photo': False, 'file_id': '', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092004/122ae3d2cc7668be3a30f66c7507cc08/1040g00831b16io4gna005pp8hbcndhoi4nhq8s0!nd_dft_wlteh_webp_3', 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092004/7a3665f27b52c68adc8b0d9937855e47/1040g00831b16io4gna005pp8hbcndhoi4nhq8s0!nd_prv_wlteh_webp_3', 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092004/122ae3d2cc7668be3a30f66c7507cc08/1040g00831b16io4gna005pp8hbcndhoi4nhq8s0!nd_dft_wlteh_webp_3', 'stream': {}}], 'tag_list': [{'name': '数学超前学', 'type': 'topic', 'id': '6551