2026-03-09 18:24:43 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '68a052d8000000001d018cf5', 'type': 'video', 'title': '听劝！小学吃透数学，只学了一个画图建模！', 'desc': '孩子在上小学的家长们！听我一句劝！想要学好学好小学数学！一定要试试新加坡数学CPA画图建模法！\n我怕他学完直接把小学 「八大数学思维能力」全吃透！到时候数学秒开窍，\n在班里疯狂抢C位！这谁顶得住啊！🤯\n\t\n🔥 说的就是这套海淀家长圈 「偷偷传阅」 的 Mathplore新加坡数学！\n我冒着被「卷王家长」拉黑的风险，必须曝光它！\n\t\n为啥这么「可怕」？\n👉 独家CPA教学法，专治“不开窍”：\n1️⃣ 实物轰炸（C）：用一堆生活实物图，让娃秒懂数学是啥！\n2️⃣ 画图破局（P）：图形代替数字，关系理得门儿清，思路瞬间通透！\n3️⃣ 抽象秒杀（A）：最后才上公式！数理思维刻进DNA，做题直接降维打击！💥\n\t\n效果有多「吓人」？\n✨ 每周只跟2节直播课！ 一二年级娃做题像开了挂！\n→ 别人吭哧吭哧 掰手指、列竖式...\n→ 你家娃 唰唰写完+检查3遍！还能托腮发呆等收卷！😎\n这哪是做题？这是考场表演秀啊！\nMathplore新加坡数学小班直播课，致力于提升小学数学思维：\n✅课程分为：G0—G6，7 个阶段，涵盖校内数学重难点巩固+课外拓展竞赛培优，对标国际数学竞赛AMC8和袋鼠数学体系！\n✅教学方法：CPA 教学法，从具象化到形象化再到抽象化，一步步引导孩子构建数学思维模型\n✅优质师资：国内外名校毕业师资，80%+为理工科或教育类硕士及以上学历，平均5年+数学教学经验\n✅上课时长：一周2节，40-50分钟/节\n✅上课形式：在线直播课，2-6人精品小班\n\t\n不管是给孩子数学思维提升，还是助力提升数学成绩，都超合适！\n🔥快快点击头像进入直播间，领取试听名额～\n课程领取活动时间：即日起至2026年12月31日\n*课程面向海外18+人群\n\ufeff#我在小红书上课[话题]#\ufeff \ufeff#数学开窍[话题]#\ufeff \ufeff#mathplore新加坡数学[话题]#\ufeff \ufeff#数学思维[话题]#\ufeff \ufeff#小学数学[话题]#\ufeff \ufeff#小学数学怎么学[话题]#\ufeff \ufeff\ufeff#小学数学思维训练方法[话题]#\ufeff', 'video_url': 'http://sns-video-bd.xhscdn.com/stream/1/110/258/01e8a052a2b84d400103700198b243ded0_258.mp4', 'time': 1755389102000, 'last_update_time': 1770530457000, 'user_id': '65fea988000000000600d7df', 'nickname': '新加坡数学直播课', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31l5nb3hnku6g5pful641hluvnpkhvgg', 'liked_count': '1.5万', 'collected_count': '1.4万', 'comment_count': '40', 'share_count': '1320', 'ip_location': '四川', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603091822/a274a44e9ccb83b103d5fbf6b0d5f152/spectrum/1040g0k031lbnitqll0005pful641hluvrl6mcgo!nd_dft_wlteh_jpg_3', 'tag_list': '我在小红书上课,数学开窍,mathplore新加坡数学,数学思维,小学数学,小学数学怎么学,小学数学思维训练方法', 'last_modify_ts': 1773051883097, 'note_url': 'https://www.xiaohongshu.com/explore/68a052d8000000001d018cf5?xsec_token=ABffDE8D_JgGIHJWDQutnusCQJs39Xq_h7JtBtNgbK5ZA=&xsec_source=pc_search', 'source_keyword': '#小学数学', 'xsec_token': 'ABffDE8D_JgGIHJWDQutnusCQJs39Xq_h7JtBtNgbK5ZA='}
