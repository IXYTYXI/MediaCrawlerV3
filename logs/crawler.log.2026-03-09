2026-03-09 20:18:15 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '67aab95b000000001902cacd', 'type': 'normal', 'title': '家人们谁懂！小学数学计算终于有救了', 'desc': '辅导孩子小学数学计算是不是让你头大？孩子抓耳挠腮、错误百出，家长干着急😫 别慌，陈慧老师 40 课时计算专题视频课来救场！1 - 6 年级孩子家长闭眼入！\n-\n计算是数学的根基，基础不牢，后面学习步步艰难。陈慧老师 20 年一线教学经验，还是杭州教育精英讲师 10 强，独创清北学霸数学开窍法，实力杠杠的👍\n她教学风格独特，讲计算原理爱用生活实例，像分糖果讲除法，孩子一听就懂。课堂上还鼓励孩子自主探索，培养创新思维，学了就能举一反三。\n-\n这门课覆盖 1 - 6 年级计算知识点，难度循序渐进，还有趣味闯关游戏，让孩子边玩边学。而且是视频课，在家就能上，随时能回看，跟请了私教一样方便。\n我家孩子学了后，计算又快又准，主动学数学。想让自家娃轻松学数学，提升计算能力，就别犹豫，赶紧安排上！\n-\n#小学数学[话题]# #计算课程[话题]# #陈慧老师[话题]# #数学启蒙[话题]# #陈慧数学[话题]# #名师亲授[话题]# #普娃开窍[话题]# #普娃逆袭[话题]# #计算能力[话题]# #小学数学[话题]# #名师推荐[话题]#', 'video_url': '', 'time': 1739241819000, 'last_update_time': 1739241820000, 'user_id': '67a5c6ad000000000e012707', 'nickname': '育儿师柠檬', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31dn4hkffgu6g5pt5oqmji9o7em0fplg', 'liked_count': '', 'collected_count': '1', 'comment_count': '2', 'share_count': '', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603092017/2d527f7f01fdb44ed5e21abe841b5747/1040g2sg31dodbmavh0dg5pt5oqmji9o75iqgj0g!nd_dft_wlteh_webp_3', 'tag_list': '小学数学,计算课程,陈慧老师,数学启蒙,陈慧数学,名师亲授,普娃开窍,普娃逆袭,计算能力,名师推荐', 'last_modify_ts': 1773058695002, 'note_url': 'https://www.xiaohongshu.com/explore/67aab95b000000001902cacd?xsec_token=AB551EFaQlJRotupcDDVUANSAE2zUb6osEHHY73Sn34Es=&xsec_source=pc_search', 'source_keyword': '#小学数学   #小学计算 #数学网课 #陪读经验   #提前学 #数学超前学', 'xsec_token': 'AB551EFaQlJRotupcDDVUANSAE2zUb6osEHHY73Sn34Es='}
