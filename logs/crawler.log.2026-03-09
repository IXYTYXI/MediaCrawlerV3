2026-03-09 15:44:36 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69aa93eb000000001b016799', 'type': 'normal', 'title': '后悔才换！新加坡数学小班直播课太🐂了！', 'desc': '新加坡数学怎么样？很多妈妈问我为什么选SparkMath\n其实之前也试过几家，孩子坐不住、听不懂，我也跟着焦虑。直到换成sparkmath新加坡数学（火花新加坡数学），才发现不是孩子不行，是方法没对上！\n💥sparkmath新加坡数学（火花新加坡数学）限时特惠，0元试听，点击【立即咨询】抢占名额\n---\n✨8人封顶小班，老师能关注到每个孩子，回答问题机会多，课堂氛围也轻松\n✨CPA教学法真的太香了！从具体实物到图画模型再到抽象符号，孩子理解得透，应用题再也不怕\n✨清北老师领衔授课，思路清晰、表达有趣，孩子主动跟我说“妈妈我喜欢上数学课”\n✨K2-P6分阶教学，根据孩子水平精准匹配，不拔高不压底，每一步都走得稳\n现在每周两节课，孩子自己记时间、主动预习，老母亲终于可以放手了！\n刚好赶上活动，给大家划个重点👇\n💥限时优惠价3800/季\n-\n👇点击【立即咨询】，或戳@Spark Math线上教育回【领取】， 立即锁定试听名额\n• 1节在线思维直播课\n• 1V1定制学习规划方案\n• 价值3422元228课时学习大礼包\n⏰ 活动有效期：即日起至2026年12月31日\n*面向家长群体\n#sparkmath新加坡数学[话题]# #新加坡数学[话题]# #数学思维[话题]# #小学数学[话题]# #小学数学怎么学[话题]# #小学数学思维训练[话题]# #数学网课[话题]# #sparkmath[话题]# #火花新加坡数学[话题]# #幼小衔接数学[话题]#', 'video_url': '', 'time': 1772786667000, 'last_update_time': 1772786668000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '', 'collected_count': '', 'comment_count': '5', 'share_count': '2', 'ip_location': '北京', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603091544/869d1331cc33f49d875d03c34aeb94da/spectrum/1040g0k031tc8o2c6le005olhcu8lbcmaca59bu8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603091544/44e4d85b039d5b23e54d1f63f5801068/spectrum/1040g0k031tc8o2c6le0g5olhcu8lbcmafoggl5g!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603091544/4bc51efb061029b088d70bafb7e19f2c/spectrum/1040g0k031tc8o2c6le105olhcu8lbcmaqfda4og!nd_dft_wlteh_webp_3', 'tag_list': 'sparkmath新加坡数学,新加坡数学,数学思维,小学数学,小学数学怎么学,小学数学思维训练,数学网课,sparkmath,火花新加坡数学,幼小衔接数学', 'last_modify_ts': 1773042276593, 'note_url': 'https://www.xiaohongshu.com/explore/69aa93eb000000001b016799?xsec_token=ABEY8sU4xINMp3qbyKnY2hi-kAOqeAfKGOo4qGcnGhTuA=&xsec_source=pc_search', 'source_keyword': '', 'xsec_token': 'ABEY8sU4xINMp3qbyKnY2hi-kAOqeA