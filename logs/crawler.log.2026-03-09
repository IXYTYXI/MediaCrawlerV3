5md0400bbg4t15tdee5vmc8!nd_dft_wlteh_webp_3'}], 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092011/53908c152b425a9bc9bed7e0d67602ee/notes_pre_post/1040g3k831o0t2af55md0400bbg4t15tdee5vmc8!nd_prv_wlteh_webp_3', 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092011/6d1855dc98bcc7ef07883abefc2b4d14/notes_pre_post/1040g3k831o0t2af55md0400bbg4t15tdee5vmc8!nd_dft_wlteh_webp_3', 'live_photo': False}, {'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092011/ddae00366c58e689183c011581088099/notes_pre_post/1040g3k831o0t2af55mdg400bbg4t15tdjlr60j8!nd_dft_wlteh_webp_3', 'stream': {}, 'live_photo': False, 'file_id': '', 'height': 4032, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092011/ddae00366c58e689183c011581088099/notes_pre_post/1040g3k831o0t2af55mdg400bbg4t15tdjlr60j8!nd_dft_wlteh_webp_3', 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092011/e125b9de37fa7f250abf51b37341af2d/notes_pre_post/1040g3k831o0t2af55mdg400bbg4t15tdjlr60j8!nd_prv_wlteh_webp_3', 'width': 3024, 'trace_id': '', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092011/e125b9de37fa7f250abf51b37341af2d/notes_pre_post/1040g3k831o0t2af55mdg400bbg4t15tdjlr60j8!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092011/ddae00366c58e689183c011581088099/notes_pre_post/1040g3k831o0t2af55mdg400bbg4t15tdjlr60j8!nd_dft_wlteh_webp_3'}]}, {'width': 3024, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092011/2aed54bed74441535532fd8939d0ffa3/notes_pre_post/1040g3k831o11i7ld6m70400bbg4t15td001hbao!nd_dft_wlteh_webp_3', 'trace_id': '', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092011/61d99a3273c89a8cf45ff5faf96fc793/notes_pre_post/1040g3k831o11i7ld6m70400bbg4t15td001hbao!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092011/2aed54bed74441535532fd8939d0ffa3/notes_pre_post/1040g3k831o11i7ld6m70400bbg4t15td001hbao!nd_dft_wlteh_webp_3'}], 'stream': {}, 'live_photo': False, 'file_id': '', 'height': 4032, 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092011/61d99a3273c89a8cf45ff5faf96fc793/notes_pre_post/1040g3k831o11i7ld6m70400bbg4t15td001hbao!nd_prv_wlteh_webp_3', 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092011/2aed54bed74441535532fd8939d0ffa3/notes_pre_post/1040g3k831o11i7ld6m70400bbg4t15td001hbao!nd_dft_wlteh_webp_3'}, {'height': 2796, 'url': 'http://sns-webpic-qc.xhscdn.com/202603092011/e083e28be74f97a4cee77158e0eb9aff/notes_pre_post/1040g3k831o11i7ld6m7g400bbg4t15tdl4ptvag!nd_dft_wlteh_webp_3', 'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092011/e083e28be74f97a4cee77158e0eb9aff/notes_pre_post/1040g3k831o11i7ld6m7g400bbg4t15tdl4ptvag!nd_dft_wlteh_webp_3', 'stream': {}, 'live_photo': False, 'file_id': '', 'width': 1290, 'trace_id': '', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092011/cfc02ce6bd0183aa9169f524beb61f4b/notes_pre_post/1040g3k831o11i7ld6m7g400bbg4t15tdl4ptvag!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092011/e083e28be74f97a4cee77158e0eb9aff/notes_pre_post/1040g3k831o11i7ld6m7g400bbg4t15tdl4ptvag!nd_dft_wlteh_webp_3'}], 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092011/cfc02ce6bd0183aa9169f524beb61f4b/notes_pre_post/1040g3k831o11i7ld6m7g400bbg4t15tdl4ptvag!nd_prv_wlteh_webp_3'}], 'tag_list': [{'id': '61c027d80000000001005cff', 'name': '乐读', 'type': 'topic'}, {'id': '6864c6a60000000017038c25', 'name': '乐读小班课效果好', 'type': 'topic'}, {'id': '62e0df8f000000000101d59d', 'name': '原学而思培优', 'type': 'topic'}, {'id': '5be433a68356e50001a94dea', 'name': '期中考试', 'type': 'topic'}, {'id': '5c0b2348b6fef90001496421', 'name': '学习日常', 'type': 'topic'}, {'id': '5bf95e4e9c1d820001fa0b6c', 'name': '学习方法', 'type': 'topic'}, {'id': '5c851312000000000f00a3bf', 'name': '学习规划', 'type': 'topic'}, {'id': '5be306b36c820600012c53d7', 'name': '小学生', 'type': 'topic'}], 'note_id': '68fb3e5d00000000030230bb', 'type': 'normal', 'interact_info': {'liked': False, 'liked_count': '229', 'collected': False, 'collected_count': '249', 'comment_count': '24', 'share_count': '12', 'followed': False, 'relation': 'none'}, 'last_update_time': 1761295965000, 'share_info': {'un_share': False}, 'xsec_token': 'ABLbq8q24tYUjJ81MXw0wu60hQmu3RRZnXxpudJQ-Lglc=', 'xsec_source': None}, {'time': 1761716312000, 'note_id': '6901a85800000000070233ce', 'desc': '作为陪读多年的麻麻，之前辅导Nini小学数学那阵儿，我真是愁得头大！乘法口诀总记混、长方形周长算错、应用题读完半天找不到数量关系…\u200b\n\t\n直到在B站找到了这5位神仙老师，这些老师不仅幽默而且讲课也是通俗易懂，当然视频中搞不懂难题Nini也会去请教伴学老师，伴学老师还会给他制定了科学学习计划，美国几个月孩子数学居然从 58 分冲到 98 分，连学校老师都惊讶：这娃是不是偷偷报班了！哈哈哈～真实成本超低～\u200b\u200b\n\t\n[一R]基础题型狂魔→朱韬\u200b\n计算易错点、乘法口诀记混这些,Nini总踩的坑，全被老师做成了趣味动画！“进位要记牢，个位满十进一位”“周长计算先找边，长加宽和再乘二”，现在做基础计算题又快又准，上次期末考试，基础题型几乎拿满了分，太欣慰了！\u200b\u200b\n\t\n[二R]算术救星→亮亮巧解小学数学\u200b\n老师讲题言简意赅，专啃小学算术难题！普娃也能轻松听懂，把复杂的四则混合运算拆成 “步骤闯关指南”，Nini听得眼睛都亮了，再也不犯困，现在还主动跟我讲 “先算括号里，再算乘除后加减”，算术题正确率直线飙升，真是拯救Nini的宝藏老师！\n\t\n\u200b\u200b[三R]几何大神→疯哥\u200b\n家有怕几何题的娃，选这位准没错！他把长方形面积讲成 “数格子的进阶游戏”，说找对应边是 “几何题的关键钥匙”，Nini边听边画图形示意图，现在做 “长方形面积计算” 题，还会念叨 “先找长和宽，再用长乘宽”，步骤写得又规范又完整\u200b！\n\t\n\u200b[四R]压轴题大杀器→赵礼显数学\n老师的 “小学压轴题破题三步法” 绝了！拿到题先 “找条件”“想公式”“梳步骤”，三步就能突破难点！Nini学了一个多月，看到复杂几何题就会说 “这题考组合图形面积呀”，上次模考压轴题只扣了 2 分，连数学老师都在班级群里夸他开窍啦\u200b\n\t\n[五R]应用题提分王→郭化楠老师\u200b\n应用题没思路？这位老师的 “题干拆解法” 超管用，能把复杂题干变清晰！老师还总结了各类小学应用题模型，教怎么把 “购物找零问题” 转化成 “减法计算”，现在Nini做应用题终于有自己的思路了，再也不盯着题目发呆耗时间\u200b\n\t\n✅ 【计划表】\n\u200b每天 30 分钟雷打不动，伴学老师还会随时给方法、帮答疑！\u200b\u200b\n周一周三周五：算术基础 + 几何图形\u200b\n周二周四周六：基础应用题 + 压轴题\u200b周末：刷基础题 + 复习解题模型\n\t\n其实小学数学的学习不用紧张，\u200b\u200b找对方法+伴学辅助，孩子轻松，家长也省心不少~\n#小学数学[话题]# #数学学习[话题]# #让孩子爱上数学[话题]# #学习经验[话题]# #数学其实很简单[话题]#', 'user': {'user_id': '67ad4c3b000000000d00ae55', 'nickname': 'Nini麻麻育儿经🌷', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31dquh8nf0k6g5ptd9gtj9bilmo57f20', 'xsec_token': 'ABcZMiRCebYOmuWsLcuEhtVNuY9V_Nogkq0tw-6v1PDkM='}, 'interact_info': {'collected_count': '353', 'comment_count': '17', 'share_count': '55', 'followed': False, 'relation': 'none', 'liked': False, 'liked_count': '228', 'collected': False}, 'image_list': [{'url_default': 'http://sns-webpic-qc.xhscdn.com/202603092011/f2800b6fa8b544f91277279ec3ba4971/spectrum/1040g34o31o79n7ie52105ptd9gtj9bilqe60umg!nd_dft_wlteh_webp_3', 'stream': {}, 'live_photo': False, 'height': 1443, 'width': 1080, 'trace_id': '', 'info_list': [{'image_scene': 'WB_PRV', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092011/2f462d7f77b984ad80bdffad735d6e7d/spectrum/1040g34o31o79n7ie52105ptd9gtj9bilqe60umg!nd_prv_wlteh_webp_3'}, {'image_scene': 'WB_DFT', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092011/f2800b6fa8b544f91277279ec3ba4971/spectrum/1040g34o31o79n7ie52105ptd9gtj9bilqe60umg!nd_dft_wlteh_webp_3'}], 'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092011/2f462d7f77b984ad80bdffad735d6e7d/spectrum/1040g34o31o79n7ie52105ptd9gtj9bilqe60umg!nd_prv_wlteh_webp_3', 'file_id': '', 'url': 'http://sns-webpic-qc.xhscdn.com/202603092011/f2800b6fa8b544f91277279ec3ba4971/spectrum/1040g34o31o79n7ie52105ptd9gtj9bilqe60umg!nd_dft_wlteh_webp_3'}], 'tag_list': [{'name': '小学数学', 'type': 'topic', 'id': '610160dd000000000100b9d9'}, {'id': '5befd462ffd6080001c984a2', 'name': '数学学习', 'type': 'topic'}, {'id': '623d83f30000000001002ed8', 'name': '让孩子爱上数学', 'type': 'topic'}, {'id': '5c01257b23cdb50001572c0c', 'name': '学习经验', 'type': 'topic'}, {'id': '6109577c000000000101e7f4', 'name': '数学其实很简单', 'type': 'topic'}], 'at_user_list': [], 'type': 'normal', 'title': '真心建议大家去b站学小学数学，半个月速通', 'last_update_time': 1761716312000, 'share_info': {'un_share': False}, 'xsec_token': 'ABsgiwHSzjzJ94qPdLa5HZdKgxdYluR3JNsi94g58rQis=', 'xsec_source': None}, {'interact_info': {'relation': 'none', 'liked': False, 'liked_count': '189', 'collected': False, 'collected_count': '291', 'comment_count': '13', 'share_count': '25', 'followed': False}, 'image_list': [{'url_pre': 'http://sns-webpic-qc.xhscdn.com/202603092011/cd47b58592ae95e51cb1ce4670ff2cfa/notes_pre_post/1040g3k031on0ddppg6005q2ac