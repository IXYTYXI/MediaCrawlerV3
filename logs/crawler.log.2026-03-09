2026-03-09 16:13:54 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '66c82730000000001d019530', 'type': 'video', 'title': '新加坡数学到底有什么好学的！火爆鸡🐔圈', 'desc': '学数学，有4不做\n1️⃣不上课开小差\n因为会错过老师讲述的重点内容，课下再自学，即耽误时间，又效果不佳，导致跟不上进度\n2️⃣不做快题\n做题求快不求质量，不去思考，总觉得做得多就会的多，其实不及别人的精做10道\n3️⃣不自大\n总感觉听得都懂，结果，一做就错\n4️⃣不学东学西\n搞懂一个知识点，再去接触下一个知识点，否则样样通样样松，最后知识混乱，做题自然难\n-\n想要学好数学，推荐家长们试试Spark Math\n用CPA教学法，通过直观动画图像，帮助娃理解抽象的数学概念，还有更多解题技巧等你挖掘，孩子爱学，更省妈\n💡课程采用在线小班直播课\n💡同时提供中英、双语、全中文三种班型\n💡教师团队都是10-20年深耕教育行业专家组成\n💡教学采用主流的CPA教学理念，以计算为基础穿插几何、逻辑推理和应用\n💡采用大量游戏化交互方式，结合UDSCSE六步教学法，攻克数学难关\n💡课后大量的学具和练习题，让娃玩中学\n-\n现在点击下方⬇ 【立即领取】还可以免费获得纯正新加坡数学试听课~\n🎈 1节在线思维直播课\n🎈 12节数独趣味课\n🎈 小学速算巧算训练营课\n·\n现在点击下方⬇ 【立即领取】就可以免费体验哦\n⏰ 截止时间：2024年12月31日\n*课程面向海外人群（18岁以上）\n#开学季[话题]#\xa0\xa0#开学好物[话题]#\xa0\xa0#开学好物分享[话题]#\xa0\xa0#新加坡数学[话题]#\xa0\xa0#新加坡数学网课[话题]#\xa0\xa0#新加坡数学建模[话题]#\xa0\xa0#新加坡数学补习[话题]#\xa0\xa0#新加坡数学竞赛[话题]#\xa0\xa0#新加坡数学应用题[话题]#\xa0\xa0#新加坡数学思维[话题]#\xa0\xa0#新加坡数学课[话题]#\xa0\xa0#新加坡数学课程[话题]#\xa0\xa0#新加坡数学老师[话题]#\xa0\xa0#新加坡数学教材[话题]#\xa0\xa0#新加坡数学cpa[话题]#\xa0\xa0#新加坡数学英文[话题]#\xa0\xa0#sparkmath新加坡数学[话题]#\xa0\xa0#小学数学[话题]#\xa0\xa0#小学数学怎么学[话题]#\xa0\xa0#思维训练[话题]#', 'video_url': 'http://sns-video-hw.xhscdn.com/stream/110/259/01e6c8265c071e4701037103917dda4728_259.mp4', 'time': 1724393264000, 'last_update_time': 1724393265000, 'user_id': '62b16791000000001501b2ca', 'nickname': 'Spark Math线上教育', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31s4adu35m85g5olhcu8lbcmaatr2eeo', 'liked_count': '102', 'collected_count': '92', 'comment_count': '', 'share_count': '26', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603091613/cad18759bc7e7244fbe275ec328e6f6d/spectrum/1040g0k0316r4u5s40s005olhcu8lbcmarkjrnu8!nd_dft_wlteh_webp_3', 'tag_list': '开学季,开学好物,开学好物分享,新加坡数学,新加坡数学网课,新加坡数学建模,新加坡数学补习,新加坡数学竞赛,新加坡数学应用题,新加坡数学思维,新加坡数学课,新加坡数学课程,新加坡数学老师,新加坡数学教材,新加坡数学cpa,新加坡数学英文,sparkmath新加坡数学,小学数学,小学数学怎么学,思维训练', 'last_modify_ts': 1773044034336, 'note_url': 'https://www.xiaohongshu.co