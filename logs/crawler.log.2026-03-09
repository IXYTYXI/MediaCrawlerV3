2026-03-09 20:55:08 MediaCrawler INFO (__init__.py:169) - [store.xhs.update_xhs_note] xhs note: {'note_id': '69661960000000001a02fc22', 'type': 'normal', 'title': '数学突然变好，很多时候并不是因为刷的多', 'desc': '通过调整方法，我家孩子在计算大赛中显著提升。关键在于先思考再动手，避免低级错误。这个简单策略帮助她在考试中表现更佳。#数学[话题]# #数学学习[话题]# #数学老师[话题]#', 'video_url': '', 'time': 1768298848000, 'last_update_time': 1768298848000, 'user_id': '6403376f000000001f033a9b', 'nickname': '是朵朵妈呀', 'avatar': 'https://sns-avatar-qc.xhscdn.com/avatar/1040g2jo31n76pq516g605p036tnnuekrc0035do', 'liked_count': '297', 'collected_count': '534', 'comment_count': '18', 'share_count': '252', 'ip_location': '', 'image_list': 'http://sns-webpic-qc.xhscdn.com/202603092053/557ab4bfa14690d503cc56ff03593c18/1040g2sg31r9cpk6t00bg5p036tnnuekrpkaggjg!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603092053/a9ba9e1a12f6c012dfa621f9b8998d7c/1040g2sg31r9cpk6t008g5p036tnnuekrk70gah8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603092053/7d23f3fed462feb4d8ce8eac7130e6d8/1040g2sg31r9cpk6t00b05p036tnnuekrahfcci8!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603092053/263521986e5ebda48738120f007184c5/1040g2sg31r9cpk6t00a05p036tnnuekrsf9ng78!nd_dft_wlteh_webp_3,http://sns-webpic-qc.xhscdn.com/202603092053/b28ef6f8340f7dcee7047178a7352ab6/1040g2sg31r9cpk6t00ag5p036tnnuekrr347ge8!nd_dft_wlteh_webp_3', 'tag_list': '数学,数学学习,数学老师', 'last_modify_ts': 1773060908944, 'note_url': 'https://www.xiaohongshu.com/explore/69661960000000001a02fc22?xsec_token=ABhAgrBERbIPkmkwdpkwmrvScdZebCBRiFe7m5vxiPLOE=&xsec_source=pc_search', 'source_keyword': '#小学数学   #小学计算 #数学网课 #陪读经验   #提前学 #数学超前学', 'xsec_token': 'ABhAgrBERbIPkmkwdpkwmrvScdZebCBRiFe7m5vxiPLOE='}
